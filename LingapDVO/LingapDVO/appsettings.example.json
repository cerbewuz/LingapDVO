{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "Session": {
      "IdleTimeoutMinutes": 6,
      "WarningTimeoutMinutes": 5,
      "KeepAliveIntervalMinutes": 5,
      "CookieName": ".LingapDVO.Session",
      "Description": "Session management: Warning at 5 min, Force logout at 6 min of inactivity, Keep-alive every 5 min"
    },
    "AesEncryption": {
      "Key": "YOUR_64_CHARACTER_HEX_AES_256_KEY_HERE"
    }
  }
}
