                                label.classList.add('active');
                            }
                        } else {
                            if (label && label.classList.contains('floating-label')) {
                                label.classList.remove('active', 'success', 'error');
                            }
                        }
                    });

                    input.addEventListener('blur', function() {
                        if (this.value.trim() !== '' && label && label.classList.contains('floating-label')) {
                            label.classList.add('active');
                        }
                    });

                    if (input.value.trim() !== '' && label && label.classList.contains('floating-label')) {
                        label.classList.add('active');
                    }
                }
            });

            // Debounce function
            function debounce(func, wait) {
                let timeout;
                return function executedFunction(...args) {
                    const later = () => {
                        clearTimeout(timeout);
                        func(...args);
                    };
                    clearTimeout(timeout);
                    timeout = setTimeout(later, wait);
                };
            }

            // Check if email exists
            async function checkEmailExists(email) {
                if (!email || email.trim() === '') return;
                try {
                    const response = await fetch(`/Login/CheckEmailExists?email=${encodeURIComponent(email)}`);
                    const data = await response.json();
                    const emailInput = document.getElementById('email');
                    const emailValidation = emailInput.parentElement.parentElement.querySelector('.text-red-500');

                    if (data.exists) {
                        emailInput.classList.add('border-red-500');
                        emailInput.classList.remove('border-green-500');
                        if (emailValidation) {
                            emailValidation.textContent = 'This email is already registered.';
                            emailValidation.classList.remove('hidden');
                        }
                        return false;
                    } else {
                        emailInput.classList.remove('border-red-500');
                        emailInput.classList.add('border-green-500');
                        if (emailValidation) {
                            emailValidation.textContent = '';
                            emailValidation.classList.add('hidden');
                        }
                        return true;
                    }
                } catch (error) {
                                        return true;
                }
            }

            // Check if username exists
            async function checkUsernameExists(username) {
                if (!username || username.trim() === '') return;
                try {
                    const response = await fetch(`/Login/CheckUsernameExists?username=${encodeURIComponent(username)}`);
                    const data = await response.json();
                    const usernameInput = document.getElementById('username');
                    const usernameValidation = usernameInput.parentElement.parentElement.querySelector('.text-red-500');

                    if (data.exists) {
                        usernameInput.classList.add('border-red-500');
                        usernameInput.classList.remove('border-green-500');
                        if (usernameValidation) {
                            usernameValidation.textContent = 'This username is already taken.';
                            usernameValidation.classList.remove('hidden');
                        }
                        return false;
                    } else {
                        usernameInput.classList.remove('border-red-500');
                        usernameInput.classList.add('border-green-500');
                        if (usernameValidation) {
                            usernameValidation.textContent = '';
                            usernameValidation.classList.add('hidden');
                        }
                        return true;
                    }
                } catch (error) {
                                        return true;
                }
            }

            // Check if name exists
            async function checkNameExists() {
                const firstName = document.getElementById('firstName')?.value?.trim();
                const middleName = document.getElementById('middleName')?.value?.trim();
                const lastName = document.getElementById('lastName')?.value?.trim();
                const suffix = document.getElementById('suffix')?.value?.trim();

                if (!firstName || !lastName) {
                    return true;
                }

                try {
                    const url = `/Login/CheckNameExists?firstName=${encodeURIComponent(firstName)}&middleName=${encodeURIComponent(middleName)}&lastName=${encodeURIComponent(lastName)}&suffix=${encodeURIComponent(suffix)}`;
                    const response = await fetch(url);
                    const data = await response.json();

                    let nameWarningContainer = document.getElementById('nameWarningContainer');
                    if (!nameWarningContainer) {
                        const form = document.getElementById('registerForm');
                        const firstField = document.getElementById('firstName').closest('.grid');
                        nameWarningContainer = document.createElement('div');
                        nameWarningContainer.id = 'nameWarningContainer';
                        firstField.parentElement.insertBefore(nameWarningContainer, firstField);
                    }

                    if (data.exists) {
                        nameWarningContainer.innerHTML = `
                            <div class="bg-red-50 border border-red-200 rounded-lg sm:rounded-xl p-3 sm:p-4 mb-3 sm:mb-4">
                                <div class="flex items-start gap-2 sm:gap-3">
                                    <i class="fas fa-exclamation-circle text-red-600 text-base sm:text-lg mt-0.5"></i>
                                    <div class="flex-1">
                                        <p class="text-red-800 font-semibold text-sm sm:text-base">Duplicate Account Detected</p>
                                        <p class="text-red-700 text-xs sm:text-sm mt-1">${data.message}</p>
                                    </div>
                                </div>
                            </div>
                        `;
                        return false;
                    } else if (data.warning) {
                        nameWarningContainer.innerHTML = `
                            <div class="bg-yellow-50 border border-yellow-200 rounded-lg sm:rounded-xl p-3 sm:p-4 mb-3 sm:mb-4">
                                <div class="flex items-start gap-2 sm:gap-3">
                                    <i class="fas fa-exclamation-triangle text-yellow-600 text-base sm:text-lg mt-0.5"></i>
                                    <div class="flex-1">
                                        <p class="text-yellow-800 font-semibold text-sm sm:text-base">Similar Name Found</p>
                                        <p class="text-yellow-700 text-xs sm:text-sm mt-1">${data.message}</p>
                                    </div>
                                </div>
                            </div>
                        `;
                        return true;
                    } else {
                        nameWarningContainer.innerHTML = '';
                        return true;
                    }
                } catch (error) {
                                        return true;
                }
            }

            // Debounced validation
            const debouncedEmailCheck = debounce(checkEmailExists, 500);
            const debouncedUsernameCheck = debounce(checkUsernameExists, 500);
            const debouncedNameCheck = debounce(checkNameExists, 800);

            const emailInput = document.getElementById('email');
            const usernameInput = document.getElementById('username');

            if (emailInput) {
                emailInput.addEventListener('input', function() {
                    debouncedEmailCheck(this.value);
                });
                emailInput.addEventListener('blur', function() {
                    checkEmailExists(this.value);
                });
            }

            if (usernameInput) {
                usernameInput.addEventListener('input', function() {
                    debouncedUsernameCheck(this.value);
                });
                usernameInput.addEventListener('blur', function() {
                    checkUsernameExists(this.value);
                });
            }

            const firstNameInput = document.getElementById('firstName');
            const middleNameInput = document.getElementById('middleName');
            const lastNameInput = document.getElementById('lastName');
            const suffixInput = document.getElementById('suffix');

            [firstNameInput, middleNameInput, lastNameInput, suffixInput].forEach(input => {
                if (input) {
                    input.addEventListener('input', function() {
                        debouncedNameCheck();
                    });
                    input.addEventListener('blur', function() {
                        checkNameExists();
                    });
                }
            });

            // ═══════════════════════════════════════════════════════════════
            // Ñ/ñ CHARACTER SUPPORT - FRONTEND VALIDATION
            // ═══════════════════════════════════════════════════════════════
            // Allow Ñ/ñ input in name fields (no restrictions)
            // Common Philippine Spanish names: Peña, Niño, Muñoz, Nuñez, etc.
            // ═══════════════════════════════════════════════════════════════

            // Helper function to detect Ñ/ñ characters
            function containsEnye(text) {
                return /[Ññ]/.test(text);
            }

            // Helper function to validate Ñ/ñ usage (prevent abuse)
            function isValidEnyeUsage(text) {
                if (!text || !containsEnye(text)) return true;

                // Ñ/ñ should not be at the start or standalone
                const lowerText = text.toLowerCase();
                if (lowerText.startsWith('ñ')) return false;
                if (/\s+ñ\s+/.test(lowerText)) return false;

                return true;
            }

            // Add Ñ/ñ validation to name fields
            [firstNameInput, middleNameInput, lastNameInput].forEach(input => {
                if (input) {
                    input.addEventListener('input', function() {
                        const value = this.value;

                        // Allow Ñ/ñ characters
                        if (containsEnye(value)) {
                                                        // Validate usage
                            if (!isValidEnyeUsage(value)) {
                                                            }
                        }
                    });
                }
            });

                        // Form submission
            const registerForm = document.getElementById('registerForm');
            if (registerForm) {
                registerForm.addEventListener('submit', async function(event) {
                    event.preventDefault();

                    if (typeof grecaptcha !== 'undefined') {
                        const recaptchaResponse = grecaptcha.getResponse();
                        if (!recaptchaResponse) {
                            alert('Please complete the reCAPTCHA verification.');
                            return false;
                        }
                    }

                    const passwordRequirementsMet = areAllPasswordRequirementsMet();
                    if (!passwordRequirementsMet) {
                        passwordTooltip.classList.remove('hidden');
                        passwordRequirementError.classList.remove('hidden');
                        alert('Please meet all password requirements before submitting.');
                        return false;
                    }

                    const passwordsMatch = await validatePasswordMatch();
                    if (!passwordsMatch) {
                        alert('Please ensure both passwords match before submitting.');
                        return false;
                    }

                    const emailValue = emailInput?.value;
                    const usernameValue = usernameInput?.value;

                    if (emailValue) {
                        const emailAvailable = await checkEmailExists(emailValue);
                        if (emailAvailable === false) {
                            alert('This email is already registered. Please use a different email.');
                            emailInput.focus();
                            return false;
                        }
                    }

                    if (usernameValue) {
                        const usernameAvailable = await checkUsernameExists(usernameValue);
                        if (usernameAvailable === false) {
                            alert('This username is already taken. Please choose a different username.');
                            usernameInput.focus();
                            return false;
                        }
                    }

                    const nameIsUnique = await checkNameExists();
                    if (nameIsUnique === false) {
                        alert('A user with this exact name already exists in our system. Each person is allowed only one account. If you believe this is an error, please contact support.');
                        firstNameInput?.focus();
                        return false;
                    }

                    const termsCheckbox = document.getElementById('terms');
                    if (!termsCheckbox?.checked) {
                        alert('Please agree to the Terms and Conditions');
                        return false;
                    }

                    const registerButton = document.getElementById('registerButton');
                    const originalButtonText = registerButton.innerHTML;
                    if (registerButton) {
                        registerButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Creating Account...';
                        registerButton.disabled = true;
                    }

                    try {
                        const formData = new FormData(registerForm);
                        const response = await fetch(registerForm.action, {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        const result = await response.json();

                        if (result.success) {
                            showSuccessModal();
                        } else {
                            if (result.errors) {
                                alert('Registration failed: ' + Array.from(result.errors).join('\n'));
                            } else {
                                alert('Registration failed. Please try again.');
                            }
                            registerButton.innerHTML = originalButtonText;
                            registerButton.disabled = false;
                        }
                    } catch (error) {
                                                alert('An error occurred during registration. Please try again.');
                        registerButton.innerHTML = originalButtonText;
                        registerButton.disabled = false;
                    }
                });
            }
        });

        function showSuccessModal() {
            const successModal = document.getElementById('successModal');
            const progressBar = document.getElementById('progressBar');

            successModal.classList.add('show');

            let progress = 0;
            const interval = setInterval(() => {
                progress += 20;
                progressBar.style.width = progress + '%';

                if (progress >= 100) {
                    clearInterval(interval);
                    window.location.href = '/Login';
                }
            }, 150);
        }

        function showGoogleConfirmation() {
            const modal = document.getElementById('googleConfirmationModal');
            if (modal) {
                modal.style.display = 'flex';
                // Trigger reflow to ensure transition works
                modal.offsetHeight;
                modal.classList.add('show');
            }
        }

        function closeGoogleConfirmation() {
            const modal = document.getElementById('googleConfirmationModal');
            if (modal) {
                modal.classList.remove('show');
                modal.classList.add('hide');
                setTimeout(() => {
                    modal.style.display = 'none';
                    modal.classList.remove('hide');
                }, 300);
            }
        }

        function proceedToGoogle() {
            // Redirect to Google Sign-In
            window.location.href = '/GoogleLogin';
        }

        // Close modal on escape key
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                const modal = document.getElementById('googleConfirmationModal');
                if (modal && modal.style.display === 'flex') {
                    closeGoogleConfirmation();
                }
            }
        });

        // Close modal on overlay click
        document.getElementById('googleConfirmationModal')?.addEventListener('click', function(event) {
            if (event.target === this) {
                closeGoogleConfirmation();
            }
        });
    </script>
</body>
</html>