@model RegisterAccDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - LINGAPDVO</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        :root {
            --primary: #10b981;
            --primary-dark: #0d9c6e;
            --accent: #DC143C;
            --text: #1f2937;
            --text-light: #6b7280;
            --border: #e5e7eb;
            --background: #f8fafc;
        }

        body {
            background: #ffffff; /* Antique White */
            font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
        }

        .register-container {
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        .form-input {
            transition: all 0.3s ease;
            border: 2px solid var(--border);
            background: #ffffff;
        }

            .form-input:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
                transform: translateY(-1px);
            }

            .form-input:hover {
                border-color: #cbd5e1;
            }

        .password-strength {
            height: 6px;
            border-radius: 3px;
            background: #e5e7eb;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .strength-fill {
            height: 100%;
            width: 0%;
            transition: all 0.3s ease;
            border-radius: 3px;
        }

        .requirement-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 4px 0;
            font-size: 0.75rem;
            transition: all 0.3s ease;
        }

        .requirement-icon {
            width: 16px;
            height: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.6rem;
            border-radius: 50%;
            background: #e5e7eb;
            color: #6b7280;
            transition: all 0.3s ease;
        }

        .requirement-valid .requirement-icon {
            background: var(--primary);
            color: white;
        }

        .requirement-valid {
            color: var(--primary);
        }

        .requirement-invalid {
            color: var(--text-light);
        }

        .btn-register {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            color: white;
            border: none;
            padding: 12px 24px;
            font-weight: 600;
            border-radius: 12px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 6px -1px rgba(16, 185, 129, 0.2);
        }

            .btn-register:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 15px -3px rgba(16, 185, 129, 0.3);
            }

            .btn-register:active {
                transform: translateY(0);
            }

        .phone-input-group {
            position: relative;
        }

        .phone-prefix {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            z-index: 10;
            color: var(--text-light);
            font-weight: 500;
            background: #f8fafc;
            padding: 2px 6px;
            border-radius: 4px;
        }

        .phone-input {
            padding-left: 60px !important;
        }

        .terms-checkbox {
            accent-color: var(--accent); /* Changed to crimson */
            transform: scale(1.1);
        }

        .password-match {
            font-size: 0.75rem;
            padding: 8px 12px;
            border-radius: 6px;
            margin-top: 8px;
            display: none;
            align-items: center;
            gap: 6px;
            transition: all 0.3s ease;
        }

        .match-valid {
            background: #f0fdf4;
            color: var(--primary);
            border: 1px solid #bbf7d0;
        }

        .match-invalid {
            background: #fef2f2;
            color: #ef4444;
            border: 1px solid #fecaca;
        }

        .floating-label {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-light);
            transition: all 0.3s ease;
            pointer-events: none;
            background: white;
            padding: 0 4px;
        }

        .input-group {
            position: relative;
        }

            .input-group input:focus + .floating-label,
            .input-group input:not(:placeholder-shown) + .floating-label {
                top: 0;
                font-size: 0.75rem;
                color: var(--primary);
                background: white;
            }

        .header-gradient {
            background: linear-gradient(135deg, var(--text) 0%, #374151 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .go-back-top {
            position: fixed;
            left: 24px;
            top: 24px;
            z-index: 1000;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 12px 20px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.95);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
            border: 1px solid rgba(220, 20, 60, 0.2);
            color: var(--accent);
            text-decoration: none;
            font-weight: 600;
        }

            .go-back-top:hover {
                background: var(--accent);
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 8px 15px -3px rgba(220, 20, 60, 0.3);
            }

        .section-divider {
            height: 1px;
            background: linear-gradient(90deg, transparent 0%, var(--border) 50%, transparent 100%);
            margin: 24px 0;
        }

        /* Crimson accent styles */
        .lock-icon {
            color: #262626;
        }

        .terms-link {
            color: #262626;
        }

            .terms-link:hover {
                color: #b01030; /* Darker crimson on hover */
            }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4 lg:p-8">
    <!-- Go Back Button -->
    <a href="javascript:void(0)" class="go-back-top" id="goBackBtn">
        <i class="fas fa-arrow-left"></i> Back
    </a>

    <div class="w-full max-w-2xl">
        <div class="register-container rounded-2xl p-8 lg:p-12">
            <!-- Header Section -->
            <article class="text-center mb-8 lg:mb-12">
                <h1 class="header-gradient font-bold text-3xl lg:text-4xl xl:text-5xl mb-3 lg:mb-4">
                    Create Your Account
                </h1>
            </article>

            <form asp-action="Register" enctype="multipart/form-data" method="post" class="space-y-6 lg:space-y-8">
                <!-- Contact Information -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 lg:gap-6">
                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-gray-700">Email Address *</label>
                        <div class="input-group">
                            <input asp-for="Email" type="email" id="email"
                                   class="form-input w-full px-4 py-3 rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500/20"
                                   placeholder=" " required>
                            <span class="floating-label">you@example.com</span>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-gray-700">Phone Number *</label>
                        <div class="phone-input-group">
                            <span class="phone-prefix">+63</span>
                            <input asp-for="Phonenumber" type="tel" id="phone"
                                   class="form-input w-full px-4 py-3 rounded-xl phone-input focus:outline-none focus:ring-2 focus:ring-green-500/20"
                                   placeholder="9123456789" pattern="[9]\d{9}"
                                   title="Please enter a valid Philippine phone number (e.g. 9123456789)" required>
                        </div>
                    </div>
                </div>

                <!-- Password Section -->
                <div class="space-y-4 lg:space-y-6">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 lg:gap-6">
                        <!-- Password Field -->
                        <div class="space-y-3">
                            <label class="block text-sm font-semibold text-gray-700 flex items-center gap-2">
                                <i class="fas fa-lock lock-icon"></i>
                                Password
                            </label>
                            <input asp-for="Password" type="password" id="password"
                                   class="form-input w-full px-4 py-3 rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500/20"
                                   placeholder="Enter your password" required>
                            <span asp-validation-for="Password" class="text-red-500 text-xs"></span>

                            <!-- Password Strength -->
                            <div class="password-strength mt-2">
                                <div class="strength-fill" id="passwordStrength"></div>
                            </div>

                            <!-- Password Requirements -->
                            <div class="password-requirements space-y-1 mt-3 hidden" id="passwordRequirements">
                                <div class="requirement-item requirement-invalid" id="length">
                                    <span class="requirement-icon"><i class="fas fa-circle"></i></span>
                                    <span>At least 8 characters</span>
                                </div>
                                <div class="requirement-item requirement-invalid" id="uppercase">
                                    <span class="requirement-icon"><i class="fas fa-circle"></i></span>
                                    <span>1 uppercase letter</span>
                                </div>
                                <div class="requirement-item requirement-invalid" id="lowercase">
                                    <span class="requirement-icon"><i class="fas fa-circle"></i></span>
                                    <span>1 lowercase letter</span>
                                </div>
                                <div class="requirement-item requirement-invalid" id="number">
                                    <span class="requirement-icon"><i class="fas fa-circle"></i></span>
                                    <span>1 number</span>
                                </div>
                                <div class="requirement-item requirement-invalid" id="special">
                                    <span class="requirement-icon"><i class="fas fa-circle"></i></span>
                                    <span>1 special character</span>
                                </div>
                            </div>
                        </div>

                        <!-- Confirm Password Field -->
                        <div class="space-y-3">
                            <label class="block text-sm font-semibold text-gray-700 flex items-center gap-2">
                                <i class="fas fa-lock lock-icon"></i>
                                Confirm Password
                            </label>
                            <input type="password" id="confirmPassword"
                                   class="form-input w-full px-4 py-3 rounded-xl focus:outline-none focus:ring-2 focus:ring-green-500/20"
                                   placeholder="Confirm your password" required>

                            <!-- Password Match Indicator -->
                            <div id="passwordMatch" class="password-match">
                                <i class="fas fa-check-circle"></i>
                                <span>Passwords match</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Terms and Conditions -->
                <div class="section-divider"></div>

                <div class="flex items-start space-x-3 p-4 bg-red-50 rounded-xl border border-red-200">
                    <input type="checkbox" id="terms" class="terms-checkbox mt-1" required>
                    <label class="text-sm text-gray-700 flex-1" for="terms">
                        I agree to the <a href="#" class="terms-link font-semibold transition-colors" data-bs-toggle="modal" data-bs-target="#termsModal">terms and conditions</a>
                    </label>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn-register w-full text-lg font-semibold">
                    Sign Up
                    <i class="fas ml-2"></i>
                </button>

                <!-- Login Redirect -->
                <div class="text-center pt-4">
                    <p class="text-gray-600 text-sm">
                        Already have an account?
                        <a href="/Login" class="terms-link font-semibold transition-colors">Login</a>
                    </p>
                </div>
            </form>
        </div>
    </div>

    <!-- Terms Modal -->
    <div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-red-600 text-white">
                    <h5 class="modal-title" id="termsModalLabel">Lingap Terms & Privacy Policy</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <h6 class="fw-bold text-cobalt">1. Acceptance of Terms</h6>
                    <p>By signing up for Lingap, you confirm that all information provided is accurate and that you have read, understood, and agreed to these Terms and our Privacy Policy.</p>

                    <h6 class="fw-bold text-cobalt">2. Data Privacy & Protection</h6>
                    <p>Lingap is committed to safeguarding your personal data. We comply with the <strong>Data Privacy Act of 2012 (RA 10173)</strong>. Your information will only be used to verify eligibility and for program coordination. We will never sell or misuse your data.</p>

                    <h6 class="fw-bold text-cobalt">3. Purpose of Data Collection</h6>
                    <ul>
                        <li>Eligibility verification for Lingap programs</li>
                        <li>Contact and follow-up regarding assistance</li>
                        <li>Government or partner validation (as needed)</li>
                    </ul>

                    <h6 class="fw-bold text-cobalt">4. Account Integrity</h6>
                    <p>Each individual is allowed <strong>one account only</strong>. Creating multiple accounts or submitting false documents may result in permanent disqualification.</p>

                    <h6 class="fw-bold text-cobalt">5. Changes to Terms</h6>
                    <p>Lingap reserves the right to update this policy at any time. All changes will be posted publicly, and continued use of the service implies agreement with updated terms.</p>

                    <h6 class="fw-bold text-cobalt">6. Questions or Concerns</h6>
                    <p>If you have any questions regarding your privacy, you may contact our support team at <a href="mailto:support@lingap.org">support@lingap.org</a>.</p>
                </div>
                <div class="modal-footer">
                    <small class="text-muted me-auto">Last updated: May 2025</small>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const password = document.getElementById('password');
            const confirmPassword = document.getElementById('confirmPassword');
            const passwordStrength = document.getElementById('passwordStrength');
            const phoneInput = document.getElementById('phone');
            const goBackBtn = document.getElementById('goBackBtn');
            const passwordRequirements = document.getElementById('passwordRequirements');
            const passwordMatch = document.getElementById('passwordMatch');

            // Go Back button functionality
            goBackBtn.addEventListener('click', function() {
                window.history.back();
            });

            // Password strength checker
            password.addEventListener('input', function() {
                const value = password.value;
                const requirements = {
                    length: value.length >= 8,
                    uppercase: /[A-Z]/.test(value),
                    lowercase: /[a-z]/.test(value),
                    number: /[0-9]/.test(value),
                    special: /[^A-Za-z0-9]/.test(value)
                };

                // Update requirement indicators
                for (const [key, met] of Object.entries(requirements)) {
                    const element = document.getElementById(key);
                    if (met) {
                        element.classList.remove('requirement-invalid');
                        element.classList.add('requirement-valid');
                        element.querySelector('.requirement-icon').innerHTML = '<i class="fas fa-check"></i>';
                    } else {
                        element.classList.remove('requirement-valid');
                        element.classList.add('requirement-invalid');
                        element.querySelector('.requirement-icon').innerHTML = '<i class="fas fa-circle"></i>';
                    }
                }

                // Update strength meter
                const strength = Object.values(requirements).filter(met => met).length;
                const strengthPercent = (strength * 20);
                passwordStrength.style.width = strengthPercent + '%';

                if (strength < 2) {
                    passwordStrength.style.backgroundColor = '#ef4444';
                } else if (strength < 4) {
                    passwordStrength.style.backgroundColor = '#f59e0b';
                } else {
                    passwordStrength.style.backgroundColor = '#10b981';
                }
            });

            // Confirm password checker
            confirmPassword.addEventListener('input', function() {
                if (confirmPassword.value === password.value && password.value.length > 0) {
                    passwordMatch.innerHTML = '<i class="fas fa-check-circle"></i><span>Passwords match</span>';
                    passwordMatch.className = 'password-match match-valid flex';
                    passwordMatch.style.display = 'flex';
                } else if (password.value.length > 0 && confirmPassword.value.length > 0) {
                    passwordMatch.innerHTML = '<i class="fas fa-times-circle"></i><span>Passwords do not match</span>';
                    passwordMatch.className = 'password-match match-invalid flex';
                    passwordMatch.style.display = 'flex';
                } else {
                    passwordMatch.style.display = 'none';
                }
            });

            // Philippine phone number validation
            phoneInput.addEventListener('input', function() {
                let phoneNumber = this.value.replace(/\D/g, '');
                if (phoneNumber.length > 0 && !phoneNumber.startsWith('9')) {
                    phoneNumber = '9' + phoneNumber;
                }
                phoneNumber = phoneNumber.substring(0, 10);
                this.value = phoneNumber;
            });

            // Show/hide password requirements
            password.addEventListener('focus', function() {
                passwordRequirements.classList.remove('hidden');
            });

            password.addEventListener('input', function() {
                if (password.value.length > 0) {
                    passwordRequirements.classList.remove('hidden');
                    passwordRequirements.style.display = 'block';
                    passwordRequirements.style.opacity = '1';
                    passwordRequirements.style.transform = 'translateY(0)';
                    passwordRequirements.style.maxHeight = '200px';
                    passwordRequirements.style.overflow = 'hidden';
                    passwordRequirements.style.transition = 'all 0.3s ease';
                    passwordRequirements.classList.add('block');
                    passwordRequirements.classList.remove('hidden');
                    passwordRequirements.style.display = 'block';
                } else {
                    passwordRequirements.style.opacity = '0';
                    passwordRequirements.style.transform = 'translateY(-10px)';
                    passwordRequirements.style.maxHeight = '0';
                    setTimeout(() => {
                        passwordRequirements.classList.add('hidden');
                    }, 300);
                }
            });

            password.addEventListener('blur', function() {
                if (password.value.length === 0) {
                    passwordRequirements.style.opacity = '0';
                    passwordRequirements.style.transform = 'translateY(-10px)';
                    passwordRequirements.style.maxHeight = '0';
                    setTimeout(() => {
                        passwordRequirements.classList.add('hidden');
                    }, 300);
                }
            });

            // Form submission
            document.querySelector('form').addEventListener('submit', function(e) {
                const value = password.value;
                const requirements = {
                    length: value.length >= 8,
                    uppercase: /[A-Z]/.test(value),
                    lowercase: /[a-z]/.test(value),
                    number: /[0-9]/.test(value),
                    special: /[^A-Za-z0-9]/.test(value)
                };

                const strength = Object.values(requirements).filter(met => met).length;
                if (strength < 3) {
                    alert('Please ensure your password meets all requirements (at least 3 of 5 requirements).');
                    e.preventDefault();
                    return;
                }

                if (confirmPassword.value !== password.value) {
                    alert('Passwords do not match.');
                    e.preventDefault();
                    return;
                }

                const phoneNumber = phoneInput.value;
                if (!/^9\d{9}$/.test(phoneNumber)) {
                    alert('Please enter a valid Philippine phone number (10 digits starting with 9, e.g. 9123456789)');
                    e.preventDefault();
                    return;
                }

                if (!document.getElementById('terms').checked) {
                    alert('You must agree to the terms and conditions.');
                    e.preventDefault();
                    return;
                }

                alert('Form submitted successfully!');
                e.preventDefault();
            });
        });
    </script>
</body>
</html>