@model RegisterAccDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
</head>
<body class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-100 p-4">
    <!-- Go Back Button -->
    <a href="/" class="fixed left-4 top-4 z-50 flex items-center gap-2 px-4 py-2 bg-white rounded-xl shadow-lg border border-gray-200 text-crimson-600 hover:bg-crimson-600 hover:text-white transition-all duration-300 hover:shadow-xl hover:-translate-y-0.5 font-semibold text-sm">
        <i class="fas fa-arrow-left text-xs"></i>
        <span>Home</span>
    </a>

    <div class="w-full max-w-sm lg:max-w-md">
        <div class="bg-white rounded-2xl shadow-2xl p-6 lg:p-8 border border-white/20 backdrop-blur-sm">
            <!-- Compact Header -->
            <div class="text-center mb-6 lg:mb-8">
                <h1 class="text-2xl lg:text-3xl font-bold bg-gradient-to-r from-gray-800 to-gray-600 bg-clip-text text-transparent mb-2">
                    Create Account
                </h1>
                <p class="text-gray-500 text-sm">Join our community today</p>
            </div>

            <form asp-action="Register" method="post" enctype="multipart/form-data" id="registerForm" class="space-y-4">


                <!-- Username & Email in Horizontal Layout -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                    <!-- Username Field -->
                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-gray-700">
                            Username
                        </label>
                        <div class="relative">
                            <input asp-for="Username"
                                   type="text"
                                   class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:border-green-500 focus:ring-1 focus:ring-green-200 transition-all duration-200 bg-white text-sm"
                                   placeholder="Enter username"
                                   required
                                   autocomplete="username"
                                   id="username">
                        </div>
                        <span asp-validation-for="Username" class="text-red-500 text-xs"></span>
                    </div>

                    <!-- Email Field -->
                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-gray-700">
                            Email
                        </label>
                        <div class="relative">
                            <input asp-for="Email"
                                   type="email"
                                   class="w-full px-3 py-2.5 border border-gray-300 rounded-lg focus:outline-none focus:border-green-500 focus:ring-1 focus:ring-green-200 transition-all duration-200 bg-white text-sm"
                                   placeholder="Enter email"
                                   required
                                   autocomplete="email"
                                   id="email">
                        </div>
                        <span asp-validation-for="Email" class="text-red-500 text-xs"></span>
                    </div>
                </div>

                <!-- Password & Confirm Password in Horizontal Layout -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                    <!-- Password Field -->
                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-gray-700">
                            Password
                        </label>
                        <div class="relative flex">
                            <input asp-for="Password"
                                   type="password"
                                   class="w-full px-3 py-2.5 border border-gray-300 rounded-l-lg focus:outline-none focus:border-green-500 focus:ring-1 focus:ring-green-200 transition-all duration-200 bg-white text-sm border-r-0"
                                   placeholder="Enter password"
                                   required
                                   autocomplete="new-password"
                                   id="password">
                        </div>
                        <span asp-validation-for="Password" class="text-red-500 text-xs"></span>
                    </div>

                    <!-- Confirm Password Field -->
                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-gray-700">
                            Confirm Password
                        </label>
                        <div class="relative flex">
                            <input type="password"
                                   name="ConfirmPassword"
                                   class="w-full px-3 py-2.5 border border-gray-300 rounded-l-lg focus:outline-none focus:border-green-500 focus:ring-1 focus:ring-green-200 transition-all duration-200 bg-white text-sm border-r-0"
                                   placeholder="Confirm password"
                                   required
                                   autocomplete="new-password"
                                   id="confirmPassword">
                        </div>
                        <div id="passwordMatch" class="text-xs mt-1 hidden transition-all duration-300"></div>
                    </div>
                </div>

                <!-- Password Requirements Tooltip -->
                <div id="passwordTooltip" class="hidden bg-blue-50 border border-blue-200 rounded-lg p-3 text-xs text-blue-700 transition-all duration-300">
                    <p class="font-semibold mb-2">Password Requirements:</p>
                    <ul class="space-y-1">
                        <li id="rule-length" class="flex items-center gap-2">
                            <i class="fas fa-circle text-red-500 text-xs"></i>
                            <span>At least 8 characters</span>
                        </li>
                        <li id="rule-uppercase" class="flex items-center gap-2">
                            <i class="fas fa-circle text-red-500 text-xs"></i>
                            <span>One uppercase letter</span>
                        </li>
                        <li id="rule-lowercase" class="flex items-center gap-2">
                            <i class="fas fa-circle text-red-500 text-xs"></i>
                            <span>One lowercase letter</span>
                        </li>
                        <li id="rule-number" class="flex items-center gap-2">
                            <i class="fas fa-circle text-red-500 text-xs"></i>
                            <span>One number</span>
                        </li>
                        <li id="rule-symbol" class="flex items-center gap-2">
                            <i class="fas fa-circle text-red-500 text-xs"></i>
                            <span>One special character</span>
                        </li>
                    </ul>
                </div>

                <!-- Social Login -->
                <div class="pt-2">
                    <div class="flex items-center my-3">
                        <div class="flex-1 h-px bg-gray-300"></div>
                        <span class="px-3 text-xs text-gray-500 bg-white font-medium">or continue with</span>
                        <div class="flex-1 h-px bg-gray-300"></div>
                    </div>

                    <div class="grid grid-cols-2 gap-2">
                        <a href="/Login/GoogleLogin" class="flex items-center justify-center gap-2 px-3 py-2 border border-gray-300 rounded-lg hover:border-green-500 hover:bg-green-50 transition-all duration-200 group">
                            <img src="https://www.gstatic.com/images/branding/product/2x/googleg_64dp.png" alt="Google" class="w-4 h-4">
                            <span class="text-xs font-medium text-gray-600 group-hover:text-green-700">Google</span>
                        </a>

                        <a href="/Login/FacebookLogin" class="flex items-center justify-center gap-2 px-3 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-all duration-200 group">
                            <i class="fab fa-facebook-f text-xs"></i>
                            <span class="text-xs font-medium">Facebook</span>
                        </a>
                    </div>
                </div>

                <!-- reCAPTCHA -->
                <div class="bg-gray-50 rounded-lg p-3 border border-gray-200">
                    <div class="g-recaptcha mx-auto scale-90" data-sitekey="6Lfdj1orAAAAAGDqwcRDBkTCHoXYx9mLDeCn7kwV"></div>
                </div>

                <!-- Terms Agreement -->
                <div class="flex items-start space-x-3 p-3 bg-gray-50 rounded-lg border border-gray-200 hover:bg-blue-50 hover:border-blue-200 transition-all duration-200">
                    <input type="checkbox" id="terms" name="terms" class="mt-0.5 accent-green-600" required>
                    <label for="terms" class="text-xs text-gray-700 flex-1 leading-relaxed cursor-pointer">
                        I agree to the
                        <a href="#" class="text-blue-600 hover:text-blue-800 font-semibold transition-colors duration-200" data-bs-toggle="modal" data-bs-target="#termsModal">terms and conditions</a>
                    </label>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="w-full bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white py-3 rounded-lg font-semibold text-sm shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-300 group" id="registerButton">
                    <span class="flex items-center justify-center gap-2">
                        <span>Sign Up</span>
                        <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform duration-200"></i>
                    </span>
                </button>

                <!-- Links -->
                <div class="text-center space-y-2 pt-2">
                    <p class="text-gray-500 text-xs">
                        Already have an account?
                        <a href="/Login" class="text-blue-600 hover:text-blue-800 font-semibold transition-colors duration-200 ml-1">Sign in</a>
                    </p>
                    <p class="text-gray-500 text-xs">
                        <a href="/" class="text-blue-600 hover:text-blue-800 font-semibold transition-colors duration-200">Back to Home</a>
                    </p>
                </div>
            </form>
        </div>
    </div>

    <!-- Terms Modal -->
    <div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-3xl shadow-2xl overflow-hidden bg-gradient-to-br from-white to-gray-50">
                <!-- Header -->
                <div class="modal-header bg-gradient-to-r from-green-500 to-green-600 text-white py-4 px-6 border-b-0">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center">
                            <i class="fas fa-file-contract text-white text-lg"></i>
                        </div>
                        <div>
                            <h5 class="modal-title font-bold text-lg tracking-wide" id="termsModalLabel">
                                Terms & Privacy Policy
                            </h5>
                            <p class="text-green-100 text-sm font-normal">Last updated: 2024</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <!-- Body -->
                <div class="modal-body p-6 space-y-6 max-h-96 overflow-y-auto">
                    <!-- Acceptance of Terms -->
                    <div class="bg-white rounded-xl p-4 border border-green-100 shadow-sm">
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-handshake text-green-600 text-sm"></i>
                            </div>
                            <h6 class="font-bold text-green-700 text-base">1. Acceptance of Terms</h6>
                        </div>
                        <p class="text-gray-700 text-sm leading-relaxed">
                            By signing up for our service, you confirm that all information provided is accurate and that you have read, understood, and agreed to these Terms and our Privacy Policy.
                        </p>
                    </div>

                    <!-- Data Privacy -->
                    <div class="bg-white rounded-xl p-4 border border-blue-100 shadow-sm">
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-shield-alt text-blue-600 text-sm"></i>
                            </div>
                            <h6 class="font-bold text-blue-700 text-base">2. Data Privacy & Protection</h6>
                        </div>
                        <p class="text-gray-700 text-sm leading-relaxed">
                            We comply with the <strong class="text-blue-600">Data Privacy Act of 2012 (RA 10173)</strong> and ensure responsible handling of your personal data with the highest level of security and care.
                        </p>
                    </div>

                    <!-- Data Collection -->
                    <div class="bg-white rounded-xl p-4 border border-purple-100 shadow-sm">
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-database text-purple-600 text-sm"></i>
                            </div>
                            <h6 class="font-bold text-purple-700 text-base">3. Purpose of Data Collection</h6>
                        </div>
                        <ul class="text-gray-700 text-sm space-y-2 ps-4">
                            <li class="flex items-start gap-2">
                                <i class="fas fa-check-circle text-green-500 text-xs mt-1"></i>
                                <span>Eligibility verification for assistance programs</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <i class="fas fa-check-circle text-green-500 text-xs mt-1"></i>
                                <span>Contact and follow-up regarding your application</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <i class="fas fa-check-circle text-green-500 text-xs mt-1"></i>
                                <span>Partner validation as necessary for service delivery</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Account Integrity -->
                    <div class="bg-white rounded-xl p-4 border border-orange-100 shadow-sm">
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-8 h-8 bg-orange-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-user-check text-orange-600 text-sm"></i>
                            </div>
                            <h6 class="font-bold text-orange-700 text-base">4. Account Integrity</h6>
                        </div>
                        <p class="text-gray-700 text-sm leading-relaxed">
                            Each individual is allowed <strong class="text-orange-600">only one account</strong>. Creating multiple or falsified accounts may result in disqualification and suspension of access to our services.
                        </p>
                    </div>

                    <!-- Changes to Terms -->
                    <div class="bg-white rounded-xl p-4 border border-red-100 shadow-sm">
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-8 h-8 bg-red-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-sync text-red-600 text-sm"></i>
                            </div>
                            <h6 class="font-bold text-red-700 text-base">5. Changes to Terms</h6>
                        </div>
                        <p class="text-gray-700 text-sm leading-relaxed">
                            We reserve the right to modify these Terms at any time. All updates will be posted publicly, and continued use of our services signifies acceptance of the latest terms.
                        </p>
                    </div>
                </div>

                <!-- Footer -->
                <div class="modal-footer bg-gray-50 py-4 px-6 border-t-0">
                    <div class="w-full flex flex-col sm:flex-row items-center justify-between gap-3">
                        <div class="flex items-center gap-2 text-gray-600 text-sm">
                            <i class="fas fa-info-circle text-blue-500"></i>
                            <span>Questions? Contact us at <a href="mailto:support@lingap.org" class="text-blue-600 font-semibold hover:underline">support@lingap.org</a></span>
                        </div>
                        <button type="button" class="w-full sm:w-auto bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded-xl font-semibold transition-all duration-200 shadow-sm hover:shadow-md" data-bs-dismiss="modal">
                            I Understand
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Success Modal -->
    <div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-3xl shadow-2xl overflow-hidden bg-gradient-to-br from-white to-green-50">
                <div class="modal-body p-6 text-center">
                    <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-check text-green-600 text-3xl"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-800 mb-2">Registration Successful!</h3>
                    <p class="text-gray-600 mb-6">Welcome to our community! You'll be redirected shortly.</p>
                    <div class="bg-gray-50 rounded-xl p-4 border border-gray-200">
                        <p class="text-sm text-gray-600 mb-2">Redirecting to login page in:</p>
                        <div class="text-2xl font-bold text-green-600" id="countdown">5</div>
                        <div class="w-full bg-gray-200 rounded-full h-2 mt-2">
                            <div id="countdownBar" class="bg-green-600 h-2 rounded-full transition-all duration-1000" style="width: 100%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Password validation rules
            const rules = {
                length: /.{8,}/,
                uppercase: /[A-Z]/,
                lowercase: /[a-z]/,
                number: /[0-9]/,
                symbol: /[^A-Za-z0-9]/
            };

            // Password requirements validation
            const passwordInput = document.getElementById('password');
            const passwordTooltip = document.getElementById('passwordTooltip');

            function validatePasswordRequirements() {
                if (!passwordInput) return;
                const val = passwordInput.value;

                Object.entries(rules).forEach(([key, regex]) => {
                    const el = document.getElementById(`rule-${key}`);
                    if (!el) return;
                    const icon = el.querySelector("i");
                    if (regex.test(val)) {
                        icon.classList.replace("text-red-500", "text-green-500");
                        el.classList.add("text-green-600", "font-medium");
                    } else {
                        icon.classList.replace("text-green-500", "text-red-500");
                        el.classList.remove("text-green-600", "font-medium");
                    }
                });

                if (document.activeElement === passwordInput && val.length > 0) {
                    passwordTooltip?.classList.remove('hidden');
                }
            }

            // Password match validation
            const confirmInput = document.getElementById('confirmPassword');
            const matchIndicator = document.getElementById('passwordMatch');

            function validatePasswordMatch() {
                if (!matchIndicator || !passwordInput || !confirmInput) return true;

                const password = passwordInput.value;
                const confirmPassword = confirmInput.value;

                if (confirmPassword === '') {
                    matchIndicator.classList.add('hidden');
                    confirmInput.classList.remove('border-red-500', 'border-green-500');
                    return true;
                }

                if (password === confirmPassword) {
                    confirmInput.classList.remove('border-red-500');
                    confirmInput.classList.add('border-green-500');
                    matchIndicator.classList.remove('hidden');
                    matchIndicator.innerHTML = '<i class="fas fa-check-circle text-green-600"></i> <span class="text-green-600 font-medium">Passwords match</span>';
                    return true;
                } else {
                    confirmInput.classList.remove('border-green-500');
                    confirmInput.classList.add('border-red-500');
                    matchIndicator.classList.remove('hidden');
                    matchIndicator.innerHTML = '<i class="fas fa-times-circle text-red-500"></i> <span class="text-red-500 font-medium">Passwords do not match</span>';
                    return false;
                }
            }

            // Event listeners
            if (passwordInput) {
                passwordInput.addEventListener('input', validatePasswordRequirements);
                passwordInput.addEventListener('focus', () => {
                    if (passwordInput.value.length > 0) {
                        passwordTooltip?.classList.remove('hidden');
                    }
                });
                passwordInput.addEventListener('blur', () => {
                    setTimeout(() => passwordTooltip?.classList.add('hidden'), 200);
                });
            }

            if (confirmInput) {
                confirmInput.addEventListener('input', validatePasswordMatch);
            }

            // Show validation errors on page load if they exist
            function showExistingErrors() {
                const validationSummary = document.getElementById('validationSummary');

                // Check if there are any visible validation error messages
                const hasValidationErrors = document.querySelector('.field-validation-error') ||
                                          document.querySelector('[class*="text-danger"]') ||
                                          (validationSummary && validationSummary.innerHTML.trim() !== '');

                if (validationSummary && hasValidationErrors) {
                    validationSummary.classList.remove('hidden');

                    // Scroll to errors if they exist
                    setTimeout(() => {
                        validationSummary.scrollIntoView({
                            behavior: 'smooth',
                            block: 'center'
                        });
                    }, 100);
                }
            }

            // Call this on page load
            showExistingErrors();

            // Form submission handler
            document.getElementById('registerForm').addEventListener('submit', function(event) {
                const recaptchaResponse = grecaptcha.getResponse();

                if (!recaptchaResponse) {
                    event.preventDefault();
                    alert('Please complete the reCAPTCHA verification.');
                    return false;
                }

                if (!validatePasswordMatch()) {
                    event.preventDefault();
                    alert('Please ensure both passwords match before submitting.');
                    return false;
                }

                const termsCheckbox = document.getElementById('terms');
                if (!termsCheckbox?.checked) {
                    event.preventDefault();
                    alert('Please agree to the terms and conditions');
                    return false;
                }

                // Show loading state but allow form to submit normally
                const registerButton = document.getElementById('registerButton');
                if (registerButton) {
                    registerButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Creating Account...';
                    registerButton.disabled = true;
                }
            });

            // Auto-show success modal if redirected with success parameter
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('success') === 'true') {
                showSuccessModal();
            }

            // Auto-focus on first input only if no errors
            const firstInput = document.getElementById('username');
            const hasErrors = document.getElementById('validationSummary') &&
                             !document.getElementById('validationSummary').classList.contains('hidden');

            if (firstInput && firstInput.value === '' && !hasErrors) {
                setTimeout(() => firstInput.focus(), 100);
            }
        });

        // Success modal functionality
        function showSuccessModal() {
            const successModalElement = document.getElementById('successModal');
            if (!successModalElement) return;

            const successModal = new bootstrap.Modal(successModalElement);

            // Reset countdown to initial state
            const countdownElement = document.getElementById('countdown');
            const countdownBar = document.getElementById('countdownBar');

            if (countdownElement) countdownElement.textContent = '5';
            if (countdownBar) countdownBar.style.width = '100%';

            successModal.show();

            let seconds = 5;
            const countdown = setInterval(function() {
                seconds--;
                if (countdownElement) countdownElement.textContent = seconds;
                if (countdownBar) countdownBar.style.width = (seconds * 20) + '%';

                if (seconds <= 0) {
                    clearInterval(countdown);
                    successModal.hide();
                    window.location.href = '/Login';
                }
            }, 1000);
        }
    </script>

    <style>
        .crimson-500 {
            color: #DC143C;
        }

        .crimson-600 {
            color: #b01030;
        }

        .bg-crimson-500 {
            background-color: #DC143C;
        }

        .bg-crimson-600 {
            background-color: #b01030;
        }

        /* Custom gradient for text */
        .text-crimson-600 {
            color: #DC143C;
        }

        .hover\:text-crimson-700:hover {
            color: #b01030;
        }

        /* Ensure proper focus states */
        input:focus + span {
            top: 0 !important;
            font-size: 0.75rem !important;
            color: #10b981 !important;
            transform: translateY(-50%) !important;
        }

        /* Custom scrollbar for modal */
        .modal-body::-webkit-scrollbar {
            width: 6px;
        }

        .modal-body::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        .modal-body::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 10px;
        }

            .modal-body::-webkit-scrollbar-thumb:hover {
                background: #a8a8a8;
            }
    </style>
</body>
</html>