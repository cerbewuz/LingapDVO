@model RegisterAccDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - LINGAPDVO</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- reCAPTCHA v2 Script -->
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
</head>
<body class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-100 p-4">
    <!-- Go Back Button -->
    <a href="/" class="fixed left-4 top-4 lg:left-6 lg:top-6 z-50 flex items-center gap-2 px-4 py-2 bg-white rounded-xl shadow-lg border border-gray-200 text-crimson-600 hover:bg-crimson-600 hover:text-white transition-all duration-300 hover:shadow-xl hover:-translate-y-0.5 font-semibold text-sm">
        <i class="fas fa-arrow-left text-xs"></i>
        <span>Home</span>
    </a>

    <div class="w-full max-w-sm lg:max-w-md">
        <div class="bg-white rounded-2xl shadow-2xl p-6 lg:p-8 border border-white/20 backdrop-blur-sm">
            <!-- Compact Header -->
            <div class="text-center mb-6 lg:mb-8">
                <div class="w-12 h-12 lg:w-14 lg:h-14 bg-gradient-to-br from-crimson-500 to-crimson-600 rounded-2xl flex items-center justify-center mx-auto mb-3 lg:mb-4 shadow-lg">
                    <i class="fas fa-user-plus text-white text-lg lg:text-xl"></i>
                </div>
                <h1 class="text-2xl lg:text-3xl font-bold bg-gradient-to-r from-gray-800 to-gray-600 bg-clip-text text-transparent mb-2">
                    Create an Account
                </h1>
                <p class="text-gray-500 text-sm lg:text-base">
                    Join LINGAPDVO today
                </p>
            </div>

            <form asp-action="Register" enctype="multipart/form-data" method="post" class="space-y-4 lg:space-y-5">
                <!-- Compact Validation Summary -->
                <div asp-validation-summary="All" class="bg-red-50 border border-red-200 rounded-xl p-3 text-red-600 text-xs lg:text-sm"></div>

                <!-- Username and Email in Column -->
                <div class="space-y-4">
                    <!-- Username Field -->
                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-gray-700">
                            Username
                        </label>
                        <div class="relative">
                            <input asp-for="Username" type="text" id="username"
                                   class="w-full px-4 py-3 lg:py-3.5 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-green-500 focus:ring-2 focus:ring-green-200 transition-all duration-200 bg-white placeholder-transparent"
                                   placeholder=" "
                                   required>
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 transition-all duration-200 pointer-events-none bg-white px-1">
                                <i class="fas fa-user mr-2 text-crimson-500"></i>Enter your username
                            </span>
                        </div>
                        <span asp-validation-for="Username" class="text-red-500 text-xs"></span>
                    </div>

                    <!-- Email Field -->
                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-gray-700">
                            Email Address
                        </label>
                        <div class="relative">
                            <input asp-for="Email" type="email" id="email"
                                   class="w-full px-4 py-3 lg:py-3.5 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-green-500 focus:ring-2 focus:ring-green-200 transition-all duration-200 bg-white placeholder-transparent"
                                   placeholder=" "
                                   required>
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 transition-all duration-200 pointer-events-none bg-white px-1">
                                <i class="fas fa-envelope mr-2 text-crimson-500"></i>you@example.com
                            </span>
                        </div>
                        <span asp-validation-for="Email" class="text-red-500 text-xs"></span>
                    </div>
                </div>

                <!-- Password and Confirm Password in Column -->
                <div class="space-y-4">
                    <!-- Password Field -->
                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-gray-700">
                            Password
                        </label>
                        <div class="relative flex">
                            <input asp-for="Password" type="password" id="password"
                                   class="w-full px-4 py-3 lg:py-3.5 border-2 border-gray-200 rounded-l-xl focus:outline-none focus:border-green-500 focus:ring-2 focus:ring-green-200 transition-all duration-200 bg-white placeholder-gray-400 border-r-0"
                                   placeholder="Enter your password"
                                   required>
                            <button type="button" class="px-4 border-2 border-gray-200 border-l-0 rounded-r-xl bg-gray-50 hover:bg-gray-100 text-gray-500 hover:text-green-600 transition-all duration-200" id="togglePassword">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-red-500 text-xs"></span>

                        <!-- Compact Password Strength -->
                        <div class="password-strength mt-2">
                            <div class="strength-fill" id="passwordStrength"></div>
                        </div>
                    </div>

                    <!-- Confirm Password Field -->
                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-gray-700">
                            Confirm Password
                        </label>
                        <input type="password" id="confirmPassword"
                               class="w-full px-4 py-3 lg:py-3.5 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-green-500 focus:ring-2 focus:ring-green-200 transition-all duration-200 bg-white placeholder-gray-400"
                               placeholder="Confirm your password"
                               required>

                        <!-- Compact Password Match Indicator -->
                        <div id="passwordMatch" class="password-match text-xs mt-1 hidden">
                            <i class="fas fa-check-circle mr-1"></i>
                            <span>Passwords match</span>
                        </div>
                    </div>
                </div>

                <!-- Compact Password Requirements -->
                <div class="password-requirements space-y-1 hidden bg-gray-50 rounded-xl p-3 border border-gray-200" id="passwordRequirements">
                    <div class="requirement-item requirement-invalid text-xs" id="length">
                        <span class="requirement-icon w-3 h-3 flex items-center justify-center text-xs bg-gray-300 text-gray-600 rounded-full mr-2"><i class="fas fa-circle"></i></span>
                        <span>At least 8 characters</span>
                    </div>
                    <div class="requirement-item requirement-invalid text-xs" id="uppercase">
                        <span class="requirement-icon w-3 h-3 flex items-center justify-center text-xs bg-gray-300 text-gray-600 rounded-full mr-2"><i class="fas fa-circle"></i></span>
                        <span>1 uppercase letter</span>
                    </div>
                    <div class="requirement-item requirement-invalid text-xs" id="lowercase">
                        <span class="requirement-icon w-3 h-3 flex items-center justify-center text-xs bg-gray-300 text-gray-600 rounded-full mr-2"><i class="fas fa-circle"></i></span>
                        <span>1 lowercase letter</span>
                    </div>
                    <div class="requirement-item requirement-invalid text-xs" id="number">
                        <span class="requirement-icon w-3 h-3 flex items-center justify-center text-xs bg-gray-300 text-gray-600 rounded-full mr-2"><i class="fas fa-circle"></i></span>
                        <span>1 number</span>
                    </div>
                    <div class="requirement-item requirement-invalid text-xs" id="special">
                        <span class="requirement-icon w-3 h-3 flex items-center justify-center text-xs bg-gray-300 text-gray-600 rounded-full mr-2"><i class="fas fa-circle"></i></span>
                        <span>1 special character</span>
                    </div>
                </div>

                <!-- Social Login Section -->
                <div class="pt-2">
                    <div class="flex items-center my-4">
                        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-gray-300 to-transparent"></div>
                        <span class="px-3 text-xs text-gray-500 bg-white font-medium">or continue with</span>
                        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-gray-300 to-transparent"></div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <a href="/Login/GoogleLogin" class="flex items-center justify-center gap-2 px-3 py-2.5 border-2 border-gray-200 rounded-xl hover:border-green-500 hover:bg-green-50 transition-all duration-200 group">
                            <img src="https://www.gstatic.com/images/branding/product/2x/googleg_64dp.png" alt="Google" class="w-4 h-4">
                            <span class="text-xs font-medium text-gray-600 group-hover:text-green-700">Google</span>
                        </a>

                        <a href="/Login/FacebookLogin" class="flex items-center justify-center gap-2 px-3 py-2.5 bg-blue-600 text-white rounded-xl hover:bg-blue-700 transition-all duration-200 group shadow-sm">
                            <i class="fab fa-facebook-f text-xs"></i>
                            <span class="text-xs font-medium">Facebook</span>
                        </a>
                    </div>
                </div>

                <!-- Compact reCAPTCHA -->
                <div class="bg-gray-50 rounded-xl p-3 border border-gray-200">
                    <div class="g-recaptcha mx-auto scale-90 lg:scale-100" data-sitekey="6Lfdj1orAAAAAGDqwcRDBkTCHoXYx9mLDeCn7kwV"></div>
                </div>

                <!-- Compact Terms and Conditions -->
                <div class="flex items-start space-x-3 p-3 bg-gray-50 rounded-xl border border-gray-200">
                    <input type="checkbox" id="terms" class="mt-1 accent-crimson-600 scale-110" required>
                    <label class="text-xs lg:text-sm text-gray-700 flex-1" for="terms">
                        I agree to the <a href="#" class="text-crimson-600 hover:text-crimson-700 font-semibold transition-colors duration-200" data-bs-toggle="modal" data-bs-target="#termsModal">terms and conditions</a>
                    </label>
                </div>

                <!-- Compact Submit Button -->
                <button type="submit" class="w-full bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white py-3 lg:py-3.5 rounded-xl font-semibold text-sm lg:text-base shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-300 group" id="registerButton">
                    <span class="flex items-center justify-center gap-2">
                        <span>Sign Up</span>
                        <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform duration-200"></i>
                    </span>
                </button>

                <!-- Compact Login Redirect -->
                <div class="text-center space-y-2 pt-2">
                    <p class="text-gray-500 text-xs lg:text-sm">
                        Already have an account?
                        <a href="/Login" class="text-crimson-600 hover:text-crimson-700 font-semibold transition-colors duration-200 ml-1">Sign in</a>
                    </p>
                </div>
            </form>
        </div>
    </div>

    <!-- Terms Modal -->
    <div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-red-600 text-white">
                    <h5 class="modal-title" id="termsModalLabel">Lingap Terms & Privacy Policy</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <h6 class="fw-bold text-cobalt">1. Acceptance of Terms</h6>
                    <p>By signing up for Lingap, you confirm that all information provided is accurate and that you have read, understood, and agreed to these Terms and our Privacy Policy.</p>

                    <h6 class="fw-bold text-cobalt">2. Data Privacy & Protection</h6>
                    <p>Lingap is committed to safeguarding your personal data. We comply with the <strong>Data Privacy Act of 2012 (RA 10173)</strong>. Your information will only be used to verify eligibility and for program coordination. We will never sell or misuse your data.</p>

                    <h6 class="fw-bold text-cobalt">3. Purpose of Data Collection</h6>
                    <ul>
                        <li>Eligibility verification for Lingap programs</li>
                        <li>Contact and follow-up regarding assistance</li>
                        <li>Government or partner validation (as needed)</li>
                    </ul>

                    <h6 class="fw-bold text-cobalt">4. Account Integrity</h6>
                    <p>Each individual is allowed <strong>one account only</strong>. Creating multiple accounts or submitting false documents may result in permanent disqualification.</p>

                    <h6 class="fw-bold text-cobalt">5. Changes to Terms</h6>
                    <p>Lingap reserves the right to update this policy at any time. All changes will be posted publicly, and continued use of the service implies agreement with updated terms.</p>

                    <h6 class="fw-bold text-cobalt">6. Questions or Concerns</h6>
                    <p>If you have any questions regarding your privacy, you may contact our support team at <a href="mailto:support@lingap.org">support@lingap.org</a>.</p>
                </div>
                <div class="modal-footer">
                    <small class="text-muted me-auto">Last updated: May 2025</small>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const password = document.getElementById('password');
            const confirmPassword = document.getElementById('confirmPassword');
            const passwordStrength = document.getElementById('passwordStrength');
            const passwordRequirements = document.getElementById('passwordRequirements');
            const passwordMatch = document.getElementById('passwordMatch');
            const togglePassword = document.getElementById('togglePassword');
            const emailInput = document.getElementById('email');
            const emailLabel = emailInput.nextElementSibling;
            const usernameInput = document.getElementById('username');
            const usernameLabel = usernameInput.nextElementSibling;

            // Password visibility toggle
            if (togglePassword && password) {
                const eyeIcon = togglePassword.querySelector('i');
                togglePassword.addEventListener('click', function() {
                    const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
                    password.setAttribute('type', type);

                    if (type === 'text') {
                        eyeIcon.classList.remove('fa-eye');
                        eyeIcon.classList.add('fa-eye-slash');
                        togglePassword.setAttribute('title', 'Hide password');
                    } else {
                        eyeIcon.classList.remove('fa-eye-slash');
                        eyeIcon.classList.add('fa-eye');
                        togglePassword.setAttribute('title', 'Show password');
                    }
                });
            }

            // Floating label for email
            if (emailInput && emailLabel) {
                emailInput.addEventListener('focus', function() {
                    emailLabel.style.top = '0';
                    emailLabel.style.fontSize = '0.75rem';
                    emailLabel.style.color = '#10b981';
                    emailLabel.style.transform = 'translateY(-50%)';
                });

                emailInput.addEventListener('blur', function() {
                    if (this.value.trim() === '') {
                        emailLabel.style.top = '50%';
                        emailLabel.style.fontSize = '0.875rem';
                        emailLabel.style.color = '#9ca3af';
                        emailLabel.style.transform = 'translateY(-50%)';
                    }
                });

                // Initialize label position
                if (emailInput.value.trim() !== '') {
                    emailLabel.style.top = '0';
                    emailLabel.style.fontSize = '0.75rem';
                    emailLabel.style.color = '#10b981';
                    emailLabel.style.transform = 'translateY(-50%)';
                }
            }

            // Floating label for username
            if (usernameInput && usernameLabel) {
                usernameInput.addEventListener('focus', function() {
                    usernameLabel.style.top = '0';
                    usernameLabel.style.fontSize = '0.75rem';
                    usernameLabel.style.color = '#10b981';
                    usernameLabel.style.transform = 'translateY(-50%)';
                });

                usernameInput.addEventListener('blur', function() {
                    if (this.value.trim() === '') {
                        usernameLabel.style.top = '50%';
                        usernameLabel.style.fontSize = '0.875rem';
                        usernameLabel.style.color = '#9ca3af';
                        usernameLabel.style.transform = 'translateY(-50%)';
                    }
                });

                // Initialize label position
                if (usernameInput.value.trim() !== '') {
                    usernameLabel.style.top = '0';
                    usernameLabel.style.fontSize = '0.75rem';
                    usernameLabel.style.color = '#10b981';
                    usernameLabel.style.transform = 'translateY(-50%)';
                }
            }

            // Password strength checker
            password.addEventListener('input', function() {
                const value = password.value;
                const requirements = {
                    length: value.length >= 8,
                    uppercase: /[A-Z]/.test(value),
                    lowercase: /[a-z]/.test(value),
                    number: /[0-9]/.test(value),
                    special: /[^A-Za-z0-9]/.test(value)
                };

                // Update requirement indicators
                for (const [key, met] of Object.entries(requirements)) {
                    const element = document.getElementById(key);
                    if (element) {
                        if (met) {
                            element.classList.remove('requirement-invalid');
                            element.classList.add('requirement-valid');
                            element.querySelector('.requirement-icon').innerHTML = '<i class="fas fa-check text-white text-xs"></i>';
                            element.querySelector('.requirement-icon').classList.remove('bg-gray-300', 'text-gray-600');
                            element.querySelector('.requirement-icon').classList.add('bg-green-500');
                        } else {
                            element.classList.remove('requirement-valid');
                            element.classList.add('requirement-invalid');
                            element.querySelector('.requirement-icon').innerHTML = '<i class="fas fa-circle text-xs"></i>';
                            element.querySelector('.requirement-icon').classList.remove('bg-green-500');
                            element.querySelector('.requirement-icon').classList.add('bg-gray-300', 'text-gray-600');
                        }
                    }
                }

                // Update strength meter
                const strength = Object.values(requirements).filter(met => met).length;
                const strengthPercent = (strength * 20);
                if (passwordStrength) {
                    passwordStrength.style.width = strengthPercent + '%';

                    if (strength < 2) {
                        passwordStrength.style.backgroundColor = '#ef4444';
                    } else if (strength < 4) {
                        passwordStrength.style.backgroundColor = '#f59e0b';
                    } else {
                        passwordStrength.style.backgroundColor = '#10b981';
                    }
                }
            });

            // Confirm password checker
            confirmPassword.addEventListener('input', function() {
                if (confirmPassword.value === password.value && password.value.length > 0) {
                    passwordMatch.innerHTML = '<i class="fas fa-check-circle text-green-500 mr-1"></i><span class="text-green-600">Passwords match</span>';
                    passwordMatch.className = 'password-match text-xs mt-1 flex items-center';
                    passwordMatch.style.display = 'flex';
                } else if (password.value.length > 0 && confirmPassword.value.length > 0) {
                    passwordMatch.innerHTML = '<i class="fas fa-times-circle text-red-500 mr-1"></i><span class="text-red-600">Passwords do not match</span>';
                    passwordMatch.className = 'password-match text-xs mt-1 flex items-center';
                    passwordMatch.style.display = 'flex';
                } else {
                    passwordMatch.style.display = 'none';
                }
            });

            // Show/hide password requirements
            password.addEventListener('focus', function() {
                passwordRequirements.classList.remove('hidden');
            });

            password.addEventListener('input', function() {
                if (password.value.length > 0) {
                    passwordRequirements.classList.remove('hidden');
                    passwordRequirements.style.display = 'block';
                } else {
                    passwordRequirements.classList.add('hidden');
                }
            });

            password.addEventListener('blur', function() {
                if (password.value.length === 0) {
                    setTimeout(() => {
                        passwordRequirements.classList.add('hidden');
                    }, 300);
                }
            });

            // Form submission
            document.querySelector('form').addEventListener('submit', function(e) {
                const value = password.value;
                const requirements = {
                    length: value.length >= 8,
                    uppercase: /[A-Z]/.test(value),
                    lowercase: /[a-z]/.test(value),
                    number: /[0-9]/.test(value),
                    special: /[^A-Za-z0-9]/.test(value)
                };

                const strength = Object.values(requirements).filter(met => met).length;
                if (strength < 3) {
                    alert('Please ensure your password meets all requirements (at least 3 of 5 requirements).');
                    e.preventDefault();
                    return;
                }

                if (confirmPassword.value !== password.value) {
                    alert('Passwords do not match.');
                    e.preventDefault();
                    return;
                }

                if (!document.getElementById('terms').checked) {
                    alert('You must agree to the terms and conditions.');
                    e.preventDefault();
                    return;
                }

                // Show loading state
                const registerButton = document.getElementById('registerButton');
                const originalContent = registerButton.innerHTML;
                registerButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Creating account...';
                registerButton.disabled = true;

                setTimeout(() => {
                    if (registerButton.disabled) {
                        registerButton.innerHTML = originalContent;
                        registerButton.disabled = false;
                    }
                }, 5000);
            });
        });
    </script>

    <style>
        .crimson-500 {
            color: #DC143C;
        }

        .crimson-600 {
            color: #b01030;
        }

        .bg-crimson-500 {
            background-color: #DC143C;
        }

        .bg-crimson-600 {
            background-color: #b01030;
        }

        .text-crimson-600 {
            color: #DC143C;
        }

        .hover\:text-crimson-700:hover {
            color: #b01030;
        }

        .accent-crimson-600 {
            accent-color: #DC143C;
        }

        .password-strength {
            height: 4px;
            border-radius: 2px;
            background: #e5e7eb;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .strength-fill {
            height: 100%;
            width: 0%;
            transition: all 0.3s ease;
            border-radius: 2px;
        }

        .requirement-item {
            display: flex;
            align-items: center;
            transition: all 0.3s ease;
        }

        .requirement-valid {
            color: #10b981;
        }

        .requirement-invalid {
            color: #6b7280;
        }

        /* Ensure proper focus states */
        input:focus + span {
            top: 0 !important;
            font-size: 0.75rem !important;
            color: #10b981 !important;
            transform: translateY(-50%) !important;
        }
    </style>
</body>
</html>