@model UseraccountDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Register</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Tesseract.js for OCR -->
    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@4/dist/tesseract.min.js"></script>

    <style>
        /* Your existing CSS styles here */
        body {
            background-color: #f8f9fa;
        }

        .register-form {
            background: white;
            border-radius: 10px;
            padding: 30px;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
        }

        .cobalt-text {
            color: black !important;
        }

        .btn-cobalt {
            background-color: #DC143C;
            color: white;
            border: none;
        }

            .btn-cobalt:hover {
                background-color: #b01030;
                color: white;
            }

        .password-strength {
            height: 5px;
            margin-top: 5px;
            margin-bottom: 15px;
            display: none;
            border-radius: 5px;
            transition: width 0.3s, background-color 0.3s;
        }

        .password-requirements {
            font-size: 0.8rem;
            color: #6c757d;
            margin-top: 5px;
        }

        .requirement {
            margin-bottom: 3px;
            transition: color 0.3s;
        }

        .valid {
            color: #28a745;
        }

        .invalid {
            color: #dc3545;
        }

        .form-control:focus {
            border-color: #DC143C;
            box-shadow: 0 0 0 0.25rem rgba(220, 20, 60, 0.25);
        }

        #imagePreview {
            width: 200px;
            height: 200px;
            object-fit: cover;
            border-radius: 50%;
            margin-top: 10px;
            display: none;
            border: 2px solid #DC143C;
        }

        .phone-input-group {
            position: relative;
        }

        .phone-prefix {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            z-index: 5;
            color: #6c757d;
        }

        .phone-input {
            padding-left: 40px !important;
        }

        /* ID Upload Styles */
        .id-upload-container {
            display: flex;
            gap: 20px;
            margin-bottom: 15px;
        }

        .id-upload-section {
            flex: 1;
            border: 2px dashed #ddd;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
            transition: all 0.3s;
        }

            .id-upload-section:hover {
                border-color: #DC143C;
            }

            .id-upload-section.active {
                border-color: #DC143C;
                background-color: rgba(220, 20, 60, 0.05);
            }

        .id-preview {
            max-width: 100%;
            max-height: 150px;
            margin-top: 10px;
            display: none;
            border-radius: 5px;
        }

        .id-upload-label {
            cursor: pointer;
            display: block;
        }

        .id-upload-icon {
            font-size: 2rem;
            color: #DC143C;
            margin-bottom: 10px;
        }

        .id-upload-text {
            font-weight: bold;
            margin-bottom: 5px;
        }

        .id-upload-hint {
            font-size: 0.8rem;
            color: #6c757d;
        }

        .id-type-selector {
            margin-bottom: 15px;
        }

        .extracted-text {
            margin-top: 10px;
            padding: 8px;
            background-color: #f8f9fa;
            border-radius: 5px;
            font-size: 0.8rem;
            max-height: 100px;
            overflow-y: auto;
            border: 1px solid #ddd;
        }

        /* OCR Status Styles */
        #ocr-status {
            margin-top: 10px;
            font-size: 0.9rem;
        }

        .progress {
            height: 10px;
            margin-top: 5px;
            display: none;
        }

        #ocr-result {
            display: none;
            margin-top: 15px;
            padding: 10px;
            background-color: #f8f9fa;
            border-radius: 5px;
            border: 1px solid #ddd;
        }

        .disabled {
            opacity: 0.5;
            pointer-events: none;
        }

        #document-warning {
            display: none;
            color: #dc3545;
            font-size: 0.9rem;
            margin-top: 5px;
        }
    </style>
</head>
<body>
    <section class="register container-fluid">
        <div class="row min-vh-100 d-flex justify-content-center align-items-center">
            <div class="col-md-8 col-lg-6">
                <div class="register-form text-center text-dark">
                    <article class="mb-4">
                        <h1 class="cobalt-text fw-bold">Create Your Account</h1>
                        <p class="text-muted">Join LINGAPDVO</p>
                    </article>

                    <form asp-action="Register" method="post" enctype="multipart/form-data" id="registrationForm">
                        <div class="mb-3 text-start">
                            <label class="form-label fw-bold"><i class="fa-solid fa-image fa-lg me-2 cobalt-text"></i>Profile Picture</label>
                            <input asp-for="ValidProfilepicture" type="file" id="imageUpload" class="form-control" accept="image/*">
                            <img id="imagePreview" src="#" alt="Profile Preview" class="img-thumbnail">
                            <span asp-validation-for="ValidProfilepicture" class="text-danger"></span>
                        </div>

                        <!-- ID Upload Section -->
                        <div class="mb-3 text-start">
                            <label class="form-label fw-bold"><i class="fa-solid fa-id-card fa-lg me-2 cobalt-text"></i>Valid ID Verification</label>

                            <div class="mb-3">
                                <label class="form-label">ID Type</label>
                                <select asp-for="IDtype" class="form-control" id="document-type" required>
                                    <option value="">Select Valid ID</option>
                                    <option value="phil-id">Philippine Identification Card / National ID</option>
                                    <option value="driver-license">Driver's License</option>
                                </select>
                                <span asp-validation-for="IDtype" class="text-danger"></span>
                                <div id="document-warning">OCR is not available for the selected document type</div>
                            </div>
                        </div>

                        <div class="id-upload-container">
                            <div class="id-upload-section" id="upload-area-front">
                                <label class="id-upload-label">
                                    <div class="id-upload-icon">
                                        <i class="fas fa-id-card"></i>
                                    </div>
                                    <div class="id-upload-text">Front of ID</div>
                                    <div class="id-upload-hint">Click to upload or drag and drop</div>
                                    <input asp-for="ValidFrontID" type="file" id="file-input-front" class="d-none" accept="image/*">
                                    <img id="image-preview" class="id-preview" alt="Front ID Preview">
                                    <span asp-validation-for="ValidFrontID" class="text-danger"></span>
                                </label>
                            </div>

                            <div class="id-upload-section" id="upload-area-back">
                                <label class="id-upload-label">
                                    <div class="id-upload-icon">
                                        <i class="fas fa-id-card"></i>
                                    </div>
                                    <div class="id-upload-text">Back of ID</div>
                                    <div class="id-upload-hint">Click to upload or drag and drop</div>
                                    <input asp-for="ValidBackID" type="file" id="file-input-back" class="d-none" accept="image/*">
                                    <img id="image-preview-back" class="id-preview" alt="Back ID Preview">
                                    <span asp-validation-for="ValidBackID" class="text-danger"></span>
                                </label>
                            </div>
                        </div>

                        <!-- OCR Status -->
                        <div id="ocr-status">Select a document to begin</div>
                        <div class="progress" id="progress-bar">
                            <div class="progress-bar progress-bar-striped progress-bar-animated"
                                 role="progressbar" id="progress" style="width: 0%"></div>
                        </div>
                        <div id="ocr-result"></div>

                        <small class="text-muted">Upload clear images of your valid ID (JPEG, PNG). Max file size: 5MB each.</small>
                        <br />
                        <br />

                        <div class="mb-3 text-start">
                            <label class="form-label">ID Number</label>
                            <input asp-for="IDnumber" type="text" id="idnumber"
                                   class="form-control"
                                   placeholder="Enter your ID number"
                                   required
                                   inputmode="numeric"
                                   pattern="[0-9]*"
                                   oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                            <span asp-validation-for="IDnumber" class="text-danger"></span>
                            <small class="text-muted">Enter the number exactly as it appears on your ID</small>
                        </div>

                        <div class="row mb-3 text-start">
                            <label class="form-label fw-bold"><i class="fa-solid fa-list-check fa-lg me-2 cobalt-text"></i>User Information</label>
                            <br />
                            <br />
                            <div class="col-md-6">
                                <label><i></i>Last Name *</label>
                                <input asp-for="Lastname" type="text" id="lastname" class="form-control" placeholder="Enter your last name" required>
                                <span asp-validation-for="Lastname" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label><i></i>First Name *</label>
                                <input asp-for="Firstname" type="text" id="firstname" class="form-control" placeholder="Enter your first name" required>
                                <span asp-validation-for="Firstname" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3 text-start">
                            <div class="col-md-6">
                                <label><i></i>Middle Name</label>
                                <input asp-for="Middlename" type="text" id="middlename" class="form-control" placeholder="Enter your middle name">
                                <span asp-validation-for="Middlename" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label><i></i>Suffix</label>
                                <select asp-for="Suffix" class="form-control">
                                    <option value="None">None</option>
                                    <option value="Jr.">Jr</option>
                                    <option value="Sr.">Sr</option>
                                    <option value="II">II</option>
                                    <option value="III">III</option>
                                    <option value="IV">IV</option>
                                </select>
                                <span asp-validation-for="Suffix" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3 text-start">
                            <label class="form-label fw-bold"><i class="fa-solid fa-venus-mars fa-lg me-2 cobalt-text"></i>Gender</label>
                            <select asp-for="Gender" class="form-control" id="sex">
                                <option value="">Select</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger"></span>
                        </div>

                        <div class="mb-3 text-start">
                            <label class="form-label fw-bold"><i class="fa-solid fa-calendar fa-lg me-2 cobalt-text"></i>Date of Birth</label>
                            <input asp-for="Dateofbirth" type="date" id="birthdate" class="form-control" required>
                            <span asp-validation-for="Dateofbirth" class="text-danger"></span>
                        </div>

                        <!-- Replace the existing Address field with this detailed version -->
                        <div class="mb-3 text-start">
                            <br />
                            <label class="form-label fw-bold"><i class="fa-solid fa-home fa-lg me-2 cobalt-text"></i>Address</label>
                            <br />
                            <div class="row mb-2">
                                <div class="col-md-8">
                                    <label class="form-label">Blk / Lot / Street *</label>
                                    <input asp-for="BlkLotStreet" type="text" class="form-control" placeholder="Enter block, lot, or street" required>
                                    <span asp-validation-for="BlkLotStreet" class="text-danger"></span>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Sub / Vill.</label>
                                    <input asp-for="SubVill" type="text" class="form-control" placeholder="Enter subdivision or village">
                                    <span asp-validation-for="SubVill" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <label class="form-label">Barangay *</label>
                                    <select asp-for="Barangay" class="form-control" required>
                                        <option value="">Select Barangay</option>
                                        <option value="Acacia">Acacia</option>
                                        <option value="Agdao">Agdao</option>
                                        <option value="Alambre">Alambre</option>
                                        <option value="Alejandro Navarro">Alejandro Navarro (Lasang)</option>
                                        <option value="Alfonso Angliongto Sr.">Alfonso Angliongto Sr.</option>
                                        <option value="Angalan">Angalan</option>
                                        <!-- Add all 182 barangays here -->
                                        <option value="Baguio Proper">Baguio Proper</option>
                                        <option value="Baliok">Baliok</option>
                                        <option value="Bangkas Heights">Bangkas Heights</option>
                                        <option value="Baracatan">Baracatan</option>
                                        <option value="Bato">Bato</option>
                                        <option value="Bayabas">Bayabas</option>
                                        <option value="Biao Escuela">Biao Escuela</option>
                                        <option value="Biao Guianga">Biao Guianga</option>
                                        <option value="Binugao">Binugao</option>
                                        <option value="Bucana">Bucana</option>
                                        <option value="Buhangin Proper">Buhangin Proper</option>
                                        <option value="Cabantian">Cabantian</option>
                                        <option value="Cadalian">Cadalian</option>
                                        <option value="Calinan Proper">Calinan Proper</option>
                                        <option value="Callawa">Callawa</option>
                                        <option value="Camansi">Camansi</option>
                                        <option value="Carmen">Carmen</option>
                                        <option value="Catalunan Grande">Catalunan Grande</option>
                                        <option value="Catalunan Pequeño">Catalunan Pequeño</option>
                                        <option value="Catigan">Catigan</option>
                                        <option value="Cawayan">Cawayan</option>
                                        <option value="Centro (San Juan)">Centro (San Juan)</option>
                                        <option value="Colosas">Colosas</option>
                                        <option value="Communal">Communal</option>
                                        <option value="Crossing Bayabas">Crossing Bayabas</option>
                                        <option value="Dacudao">Dacudao</option>
                                        <option value="Dalagdag">Dalagdag</option>
                                        <option value="Daliao">Daliao</option>
                                        <option value="Dalican">Dalican</option>
                                        <option value="Datu Salumay">Datu Salumay</option>
                                        <option value="Dominga">Dominga</option>
                                        <option value="Eden">Eden</option>
                                        <option value="Fatima (Benowang)">Fatima (Benowang)</option>
                                        <option value="Gatungan">Gatungan</option>
                                        <option value="Gov. Paciano Bangoy">Gov. Paciano Bangoy</option>
                                        <option value="Gov. Vicente Duterte">Gov. Vicente Duterte</option>
                                        <option value="Gumalang">Gumalang</option>
                                        <option value="Gumitan">Gumitan</option>
                                        <option value="Indangan">Indangan</option>
                                        <option value="Kap. Tomas Monteverde Sr.">Kap. Tomas Monteverde Sr.</option>
                                        <option value="Kilate">Kilate</option>
                                        <option value="Lamanan">Lamanan</option>
                                        <option value="Lampianao">Lampianao</option>
                                        <option value="Langub">Langub</option>
                                        <option value="Lapu-lapu">Lapu-lapu</option>
                                        <option value="Leon Garcia Sr.">Leon Garcia Sr.</option>
                                        <option value="Los Amigos">Los Amigos</option>
                                        <option value="Lubogan">Lubogan</option>
                                        <option value="Lumiad">Lumiad</option>
                                        <option value="Ma-a">Ma-a</option>
                                        <option value="Mabuhay">Mabuhay</option>
                                        <option value="Mabuhay">Mabuhay</option>
                                        <option value="Madapo">Madapo</option>
                                        <option value="Magtuod">Magtuod</option>
                                        <option value="Mahayag">Mahayag</option>
                                        <option value="Malabog">Malabog</option>
                                        <option value="Malagos">Malagos</option>
                                        <option value="Malamba">Malamba</option>
                                        <option value="Malandog">Malandog</option>
                                        <option value="Mampising">Mampising</option>
                                        <option value="Manambulan">Manambulan</option>
                                        <option value="Mandug">Mandug</option>
                                        <option value="Manuel Guianga">Manuel Guianga</option>
                                        <option value="Mapula">Mapula</option>
                                        <option value="Marapangi">Marapangi</option>
                                        <option value="Marilog Proper">Marilog Proper</option>
                                        <option value="Matina Aplaya">Matina Aplaya</option>
                                        <option value="Matina Crossing">Matina Crossing</option>
                                        <option value="Matina Pangi">Matina Pangi</option>
                                        <option value="Mintal">Mintal</option>
                                        <option value="Mudiang">Mudiang</option>
                                        <option value="Mulig">Mulig</option>
                                        <option value="New Carmen">New Carmen</option>
                                        <option value="New Valencia">New Valencia</option>
                                        <option value="Pampanga">Pampanga</option>
                                        <option value="Panacan">Panacan</option>
                                        <option value="Pandaitan">Pandaitan</option>
                                        <option value="Panorama">Panorama</option>
                                        <option value="Paquibato Proper">Paquibato Proper</option>
                                        <option value="Paradise Embak">Paradise Embak</option>
                                        <option value="Rafael Castillo">Rafael Castillo</option>
                                        <option value="Salapawan">Salapawan</option>
                                        <option value="Salaysay">Salaysay</option>
                                        <option value="Saloy">Saloy</option>
                                        <option value="San Antonio">San Antonio</option>
                                        <option value="San Isidro">San Isidro</option>
                                        <option value="Sasa">Sasa</option>
                                        <option value="Sirib">Sirib</option>
                                        <option value="Suawan">Suawan</option>
                                        <option value="Tacunan">Tacunan</option>
                                        <option value="Tagakpan">Tagakpan</option>
                                        <option value="Tagluno">Tagluno</option>
                                        <option value="Tagurano">Tagurano</option>
                                        <option value="Talomo Proper">Talomo Proper</option>
                                        <option value="Talomo River">Talomo River</option>
                                        <option value="Tamurayan">Tamurayan</option>
                                        <option value="Tibungco">Tibungco</option>
                                        <option value="Tigatto">Tigatto</option>
                                        <option value="Tungkalan">Tungkalan</option>
                                        <option value="Ubalde">Ubalde</option>
                                        <option value="Ugac">Ugac</option>
                                        <option value="Ula">Ula</option>
                                        <option value="Vicente Hizon Sr.">Vicente Hizon Sr.</option>
                                        <option value="Waan">Waan</option>
                                        <option value="Wangan">Wangan</option>
                                        <option value="Wilfredo Aquino">Wilfredo Aquino</option>
                                        <option value="Wines">Wines</option>
                                    </select>
                                    <span asp-validation-for="Barangay" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">District *</label>
                                    <select asp-for="District" class="form-control" required>
                                        <option value="" disabled selected>Select district</option>
                                        <option value="1">District 1 </option>
                                        <option value="2">District 2 </option>
                                        <option value="3">District 3 </option>
                                        <option value="4">District 4 </option>
                                        <option value="5">District 5 </option>
                                        <option value="6">District 6 </option>
                                        <option value="7">District 7 </option>
                                        <option value="8">District 8 </option>
                                        <option value="9">District 9 </option>
                                        <option value="10">District 10 </option>
                                        <option value="10">District 11 </option>
                                    </select>
                                    <span asp-validation-for="District" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3 text-start">
                            <label class="form-label fw-bold"><i class="fa-solid fa-user fa-lg me-2 cobalt-text"></i>Username</label>
                            <input asp-for="Username" type="text" class="form-control" placeholder="Choose a username">
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <div class="mb-3 text-start">
                            <label class="form-label fw-bold"><i class="fa-solid fa-envelope fa-lg me-2 cobalt-text"></i>Email</label>
                            <input asp-for="Email" type="email" id="email" class="form-control" placeholder="Enter your email" required>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3 text-start">
                            <label class="form-label fw-bold"><i class="fa-solid fa-phone fa-lg me-2 cobalt-text"></i>Phone Number</label>
                            <div class="phone-input-group">
                                <span class="phone-prefix">+63</span>
                                <input asp-for="Phonenumber" type="tel" id="phone" class="form-control phone-input"
                                       placeholder="9123456789" pattern="[9]\d{9}" title="Please enter a valid Philippine phone number (e.g. 9123456789)" required>
                            </div>
                            <small class="text-muted">Format: 9123456789 (10 digits starting with 9)</small>
                            <span asp-validation-for="Phonenumber" class="text-danger"></span>
                        </div>

                        <div class="mb-3 text-start">
                            <label class="form-label fw-bold"><i class="fa-solid fa-lock fa-lg me-2 cobalt-text"></i>Password</label>
                            <input asp-for="Password" type="password" id="password" class="form-control" placeholder="Enter your password" required>
                            <span asp-validation-for="Password" class="text-danger"></span>
                            <div class="password-strength" id="passwordStrength"></div>
                            <div class="password-requirements">
                                <div class="requirement" id="length"><i class="fas fa-circle"></i> At least 8 characters</div>
                                <div class="requirement" id="uppercase"><i class="fas fa-circle"></i> At least 1 uppercase letter</div>
                                <div class="requirement" id="lowercase"><i class="fas fa-circle"></i> At least 1 lowercase letter</div>
                                <div class="requirement" id="number"><i class="fas fa-circle"></i> At least 1 number</div>
                                <div class="requirement" id="special"><i class="fas fa-circle"></i> At least 1 special character</div>
                            </div>
                        </div>

                        <div class="mb-3 text-start">
                            <label class="form-label fw-bold"><i class="fa-solid fa-lock fa-lg me-2 cobalt-text"></i>Confirm Password</label>
                            <input type="password" id="confirmPassword" class="form-control" placeholder="Confirm your password" required>
                            <div id="passwordMatch" class="password-requirements"></div>
                        </div>


                        <div class="mb-3 text-start">
                            <label class="form-label fw-bold"><i class="fa-solid fa-shield-alt fa-lg me-2 cobalt-text"></i>Security Question</label>
                            <select asp-for="SecurityQuestions" class="form-control" required>
                                <option value="">Select a question</option>
                                <option value="What is your first pet's name?">What is your first pet's name?</option>
                                <option value="What is your mother's maiden name?">What is your mother's maiden name?</option>
                                <option value="What was your first school?">What was your first school?</option>
                            </select>
                            <span asp-validation-for="SecurityQuestions" class="text-danger"></span>
                        </div>

                        <div class="mb-3 text-start">
                            <label class="form-label fw-bold"><i class="fa-solid fa-key fa-lg me-2 cobalt-text"></i>Security Answer</label>
                            <input asp-for="Securityanswer" type="text" class="form-control" placeholder="Enter your answer" required>
                            <span asp-validation-for="Securityanswer" class="text-danger"></span>
                        </div>

                        <div class="mb-3 text-start">
                            <input type="checkbox" id="terms" required> I agree to the <a href="#" class="text-decoration-none cobalt-text" data-bs-toggle="modal" data-bs-target="#termsModal">terms and conditions</a>
                        </div>
                        <button type="submit" class="btn btn-cobalt w-100 py-2 fw-bold">Register</button>

