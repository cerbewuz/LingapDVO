        // Password strength checker
        document.getElementById('password').addEventListener('input', function() {
            const password = this.value;
            const strengthBar = document.getElementById('password-strength');
            const requirements = {
                length: document.getElementById('length'),
                uppercase: document.getElementById('uppercase'),
                lowercase: document.getElementById('lowercase'),
                number: document.getElementById('number'),
                special: document.getElementById('special')
            };

            let strength = 0;
            let messages = [];

            // Check length
            if (password.length >= 8) {
                strength += 20;
                requirements.length.classList.add('valid');
                requirements.length.classList.remove('invalid');
            } else {
                requirements.length.classList.add('invalid');
                requirements.length.classList.remove('valid');
            }

            // Check uppercase
            if (/[A-Z]/.test(password)) {
                strength += 20;
                requirements.uppercase.classList.add('valid');
                requirements.uppercase.classList.remove('invalid');
            } else {
                requirements.uppercase.classList.add('invalid');
                requirements.uppercase.classList.remove('valid');
            }

            // Check lowercase
            if (/[a-z]/.test(password)) {
                strength += 20;
                requirements.lowercase.classList.add('valid');
                requirements.lowercase.classList.remove('invalid');
            } else {
                requirements.lowercase.classList.add('invalid');
                requirements.lowercase.classList.remove('valid');
            }

            // Check number
            if (/[0-9]/.test(password)) {
                strength += 20;
                requirements.number.classList.add('valid');
                requirements.number.classList.remove('invalid');
            } else {
                requirements.number.classList.add('invalid');
                requirements.number.classList.remove('valid');
            }

            // Check special character
            if (/[^A-Za-z0-9]/.test(password)) {
                strength += 20;
                requirements.special.classList.add('valid');
                requirements.special.classList.remove('invalid');
            } else {
                requirements.special.classList.add('invalid');
                requirements.special.classList.remove('valid');
            }

            // Update strength bar
            strengthBar.style.display = 'block';
            strengthBar.style.width = strength + '%';

            if (strength < 40) {
                strengthBar.style.backgroundColor = '#dc3545';
            } else if (strength < 80) {
                strengthBar.style.backgroundColor = '#ffc107';
            } else {
                strengthBar.style.backgroundColor = '#28a745';
            }
        });

        // OCR Integration
        document.addEventListener('DOMContentLoaded', function() {
            // Get DOM elements for OCR
            const documentType = document.getElementById('document-type');
            const documentWarning = document.getElementById('document-warning');
            const uploadFront = document.getElementById('upload-area-front');
            const uploadBack = document.getElementById('upload-area-back');
            const fileFront = document.getElementById('file-input-front');
            const fileBack = document.getElementById('file-input-back');
            const imagePreview = document.getElementById('image-preview');
            const imagePreviewBack = document.getElementById('image-preview-back');
            const status = document.getElementById('ocr-status');
            const resultBox = document.getElementById('ocr-result');
            const progressBar = document.getElementById('progress-bar');
            const progress = document.getElementById('progress');

            // Track if OCR is enabled
            let ocrEnabled = false;

            // Handle document type selection
            documentType.addEventListener('change', function() {
                const selectedValue = this.value;

                if (selectedValue === 'phil-id' || selectedValue === 'driver-license') {
                    ocrEnabled = true;
                    uploadFront.classList.remove('disabled');
                    uploadBack.classList.remove('disabled');
                    documentWarning.style.display = 'none';
                    status.textContent = 'You can now upload ID images';
                } else {
                    ocrEnabled = false;
                    uploadFront.classList.add('disabled');
                    uploadBack.classList.add('disabled');
                    if (selectedValue) {
                        documentWarning.style.display = 'block';
                        status.textContent = 'OCR not available for selected document type';
                    } else {
                        documentWarning.style.display = 'none';
                        status.textContent = 'Select a document to begin';
                    }
                    resultBox.style.display = 'none';
                    imagePreview.style.display = 'none';
                    imagePreviewBack.style.display = 'none';
                }
            });

            // Setup drag & drop for uploaders
            function setupUploader(uploadArea, fileInput, preview, isBack = false) {
                uploadArea.addEventListener('dragover', e => {
                    if (!ocrEnabled) return;
                    e.preventDefault();
                    uploadArea.style.background = '#e1f0ff';
                });

                uploadArea.addEventListener('dragleave', () => {
                    if (!ocrEnabled) return;
                    uploadArea.style.background = '#f8f9fa';
                });

                uploadArea.addEventListener('drop', e => {
                    if (!ocrEnabled) return;
                    e.preventDefault();
                    uploadArea.style.background = '#f8f9fa';
                    if (e.dataTransfer.files.length) {
                        fileInput.files = e.dataTransfer.files;
                        handleFile(e.dataTransfer.files[0], preview, isBack);
                    }
                });

                uploadArea.addEventListener('click', () => {
                    if (!ocrEnabled) return;
                    fileInput.click();
                });

                fileInput.addEventListener('change', () => {
                    if (!ocrEnabled) return;
                    if (fileInput.files.length) handleFile(fileInput.files[0], preview, isBack);
                });
            }

            setupUploader(uploadFront, fileFront, imagePreview, false);
            setupUploader(uploadBack, fileBack, imagePreviewBack, true);

            // Handle file selection
            function handleFile(file, preview, isBack) {
                const reader = new FileReader();
                reader.onload = e => {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                    processImage(preview, isBack);
                };
                reader.readAsDataURL(file);
            }

            // Process image with OCR
            function processImage(preview, isBack) {
                if (!ocrEnabled) {
                    status.textContent = "OCR not enabled for selected document type";
                    return;
                }
                status.textContent = "Processing...";
                progressBar.style.display = 'block';
                progress.style.width = '0%';

                Tesseract.recognize(preview.src, 'eng', {
                    logger: m => {
                        if (m.status === 'recognizing text') {
                            progress.style.width = `${Math.round(m.progress * 100)}%`;
                        }
                    }
                }).then(({ data: { text } }) => {
                    status.textContent = "OCR completed!";
                    progressBar.style.display = 'none';

                    if (documentType.value === "driver-license") {
                        // Driver’s License → sex is on the front
                        if (!isBack) {
                            parseNameAndBirthdate(text);
                        }
                    } else if (documentType.value === "phil-id") {
                        // PhilSys ID → sex is on the back
                        if (isBack) {
                            parseSex(text);
                        } else {
                            parseNameAndBirthdate(text);
                        }
                    }

                }).catch(err => {
                    status.textContent = "Error: " + err.message;
                    progressBar.style.display = 'none';
                });
            }

            // ===== cleaning helpers =====
            function cleanName(text) {
                if (!text) return "";
                return text
                    .replace(/[^a-z\s]/gi, "")   // keep only letters + spaces
                    .replace(/\s+/g, " ")        // normalize spaces
                    .trim()
                    .replace(/^[a-z]\s+/, "")    // remove stray single letter at start
                    .replace(/\s+[a-z]$/, "")    // remove stray single letter at end
                    .replace(/^\s*[a-z]\s*$/, ""); // if only a single letter, remove it
            }

            // Always return MM/DD/YY
            function cleanBirthdate(text) {
                if (!text) return "";
                let cleaned = text.replace(/[^0-9]/g, "");

                // Case: YYYYMMDD (20011018)
                if (/^\d{8}$/.test(cleaned)) {
                    let yyyy = cleaned.slice(0, 4);
                    let mm = parseInt(cleaned.slice(4, 6));
                    let dd = parseInt(cleaned.slice(6, 8));
                    if (mm > 12) [mm, dd] = [dd, mm];
                    if (mm > 12) mm = 10;
                    return `${String(mm).padStart(2, "0")}/${String(dd).padStart(2, "0")}/${yyyy.slice(-2)}`;
                }

                // Case: MMDDYY (101801)
                if (/^\d{6}$/.test(cleaned)) {
                    let mm = parseInt(cleaned.slice(0, 2));
                    let dd = parseInt(cleaned.slice(2, 4));
                    let yy = cleaned.slice(4);
                    if (mm > 12) [mm, dd] = [dd, mm];
                    if (mm > 12) mm = 10;
                    return `${String(mm).padStart(2, "0")}/${String(dd).padStart(2, "0")}/${yy}`;
                }

                // Case: With slashes/dashes like 18/10/2001 or 10-18-01
                let parts = text.split(/[^0-9]/).filter(Boolean);
                if (parts.length === 3) {
                    let mm = parseInt(parts[0]);
                    let dd = parseInt(parts[1]);
                    let yy = parts[2].slice(-2);
                    if (mm > 12) [mm, dd] = [dd, mm];
                    if (mm > 12) mm = 10;
                    return `${String(mm).padStart(2, "0")}/${String(dd).padStart(2, "0")}/${yy}`;
                }

                return "";
            }

            function cleanSex(text) {
                if (!text) return "";
                const upper = text.toUpperCase();
                if (/MALE/.test(upper) || /\bM\b/.test(upper) || /SEX[:\s-]*M\b/.test(upper)) return "Male";
                if (/FEMALE/.test(upper) || /\bF\b/.test(upper) || /SEX[:\s-]*F\b/.test(upper)) return "Female";
                if (/LALAKI/.test(upper)) return "Male";
                if (/BABAE/.test(upper)) return "Female";
                return "";
            }

            // ===== Parse (front) =====
            function parseNameAndBirthdate(text) {
                const rawLines = text.split(/\n/).map(l => l.trim()).filter(l => l);
                const linesUpper = rawLines.map(l => l.toUpperCase());

                let idNumber = "", lastName = "", firstName = "", middleName = "", birthdate = "", sex = "";

                if (documentType.value === "driver-license") {
                    // ========== DRIVER'S LICENSE ==========

                    // Find license number
                    for (const line of rawLines) {
                        const licenseMatch = line.match(/[A-Z0-9]{1,3}-[A-Z0-9]{2}-\d{6}/);
                        if (licenseMatch) {
                            idNumber = licenseMatch[0];   // reflect license no. as ID number
                            break;
                        }
                    }

                    // Find name (Lastname,Firstname MiddleName format)
                    for (let i = 0; i < linesUpper.length; i++) {
                        if (linesUpper[i].includes(',')) {
                            const nameParts = rawLines[i].split(',');
                            if (nameParts.length >= 2) {
                                lastName = cleanName(nameParts[0]);
                                const firstMiddleParts = nameParts[1].trim().split(' ');
                                if (firstMiddleParts.length > 0) firstName = cleanName(firstMiddleParts[0]);
                                if (firstMiddleParts.length > 1) middleName = cleanName(firstMiddleParts.slice(1).join(' '));
                            }
                            break;
                        }
                    }

                    // Find birthdate
                    for (const line of rawLines) {
                        const dateMatch = line.match(/\b\d{4}\/\d{2}\/\d{2}\b/);
                        if (dateMatch) {
                            const [year, month, day] = dateMatch[0].split('/');
                            birthdate = `${month}/${day}/${year.slice(-2)}`;
                            break;
                        }
                        const altDateMatch = line.match(/\b\d{2}\/\d{2}\/\d{4}\b/);
                        if (altDateMatch) {
                            const [month, day, year] = altDateMatch[0].split('/');
                            birthdate = `${month}/${day}/${year.slice(-2)}`;
                            break;
                        }
                    }

                    // Find gender/sex (driver’s license → front)
                    for (const line of rawLines) {
                        const candidate = cleanSex(line);
                        if (candidate) {
                            sex = candidate;
                            break;
                        }
                    }

                } else {
                    // ========== PHILSYS ID ==========
                    for (let i = 0; i < linesUpper.length; i++) {
                        const line = linesUpper[i];
                        const idMatch = line.match(/\d{4}[-\s]?\d{4}[-\s]?\d{4}[-\s]?\d{4}/);
                        if (idMatch) idNumber = idMatch[0].replace(/\s+/g, "").trim();
                        if (line.includes("APELYIDO") && !line.includes("GITNANG")) lastName = cleanName(rawLines[i+1] || "");
                        if (line.includes("MGA PANGALAN") || line.includes("GIVEN NAMES")) firstName = cleanName(rawLines[i+1] || "");
                        if (line.includes("GITNANG") || line.includes("MIDDLE NAME")) middleName = cleanName(rawLines[i+1] || "");
                        if (line.includes("KAPANGANAKAN") || line.includes("PETSA") || line.includes("BIRTHDATE") || line.includes("DATE OF BIRTH")) {
                            birthdate = cleanBirthdate(rawLines[i+1] || "");
                        }
                    }
                    if (!birthdate) {
                        const dateLine = rawLines.find(l => /\b\d{1,2}[\/\-.]\d{1,2}[\/\-.]\d{2,4}\b/.test(l));
                        if (dateLine) birthdate = cleanBirthdate(dateLine);
                    }
                }

                // Update the form fields
                document.getElementById('idnumber').value = idNumber;
                document.getElementById('firstname').value = firstName.toUpperCase();
                document.getElementById('middlename').value = middleName.toUpperCase();
                document.getElementById('lastname').value = lastName.toUpperCase();

                // Convert MM/DD/YY to YYYY-MM-DD format for date input
                if (birthdate) {
                    const [month, day, year] = birthdate.split('/');
                    const fullYear = parseInt(year) < 50 ? `20${year}` : `19${year}`;
                    document.getElementById('birthdate').value = `${fullYear}-${month}-${day}`;
                }

                if (sex) {
                    document.getElementById('sex').value = sex;
                }

                resultBox.style.display = "block";
                resultBox.textContent = "Information extracted from ID. Please verify the details.";
            }

            // ===== Parse (back) =====
            function parseSex(text) {
                const rawLines = text.split(/\n/).map(l => l.trim()).filter(l => l);
                let sex = "";
                for (const line of rawLines) {
                    const candidate = cleanSex(line);
                    if (candidate) {
                        sex = candidate;
                        break;
                    }
                }
                document.getElementById('sex').value = sex;
                resultBox.style.display = "block";
                resultBox.textContent = "Gender information extracted from ID. Please verify.";
            }
        });
    </script>
</body>
</html>
