@model UseraccountDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - Lingap</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .password-strength {
            height: 5px;
            margin-top: 5px;
            margin-bottom: 15px;
            display: none;
            border-radius: 5px;
            transition: width 0.3s, background-color 0.3s;
        }

        .form-control:focus {
            border-color: #DC143C;
            box-shadow: 0 0 0 0.25rem rgba(220, 20, 60, 0.25);
        }

        .phone-input-group {
            position: relative;
            display: inline-block;
            width: 100%;
        }

        .phone-prefix {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #555;
            font-weight: 600;
            pointer-events: none;
        }

        .phone-input {
            width: 100%;
            padding: 12px 16px 12px 50px; /* add left padding for prefix */
            border: 1px solid #ccc;
            border-radius: 10px;
            transition: all 0.3s ease;
        }

            .phone-input:focus {
                border-color: #DC143C;
                box-shadow: 0 0 0 2px rgba(220, 20, 60, 0.2);
                outline: none;
            }

    </style>
</head>
<body class="bg-gray-50 min-h-screen flex items-center justify-center p-4">
    <!-- Go Back Button -->
    <a href="javascript:void(0)" class="fixed left-4 top-4 md:left-8 md:top-8 z-50 flex items-center gap-2 px-4 py-2 rounded-full bg-white/90 shadow-lg border border-red-600 text-red-600 font-bold no-underline transition-all duration-300 hover:bg-red-600 hover:text-white hover:-translate-y-0.5 hover:shadow-xl"
       id="goBackBtn">
        <i class="fas fa-arrow-left"></i> Go Back
    </a>

    <div class="w-full max-w-2xl">
        <div class="bg-white rounded-2xl shadow-xl p-6 md:p-8 mx-auto">
            <!-- Header -->
            <div class="text-center mb-8">
                <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">Create Your Account</h1>
            </div>

            <form id="registrationForm" class="space-y-6">
                <!-- Email & Phone Row -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Email *</label>
                        <input type="email" id="email" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all duration-300"
                               placeholder="Enter your email" required>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Phone Number *</label>
                        <div class="phone-input-group">
                            <span class="phone-prefix">+63</span>
                            <input type="tel"
                                   id="phone"
                                   class="phone-input"
                                   placeholder="9123456789"
                                   pattern="[9]\d{9}"
                                   title="Please enter a valid Philippine phone number (e.g. 9123456789)"
                                   required>
                        </div>
                    </div>
                </div>

                <!-- Password Row -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Password *</label>
                        <input type="password" id="password" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all duration-300"
                               placeholder="Enter your password" required>
                        <div class="password-strength" id="passwordStrength"></div>
                        <div class="password-requirements mt-3 space-y-1 hidden" id="passwordRequirements">
                            <div class="requirement flex items-center gap-2 text-sm" id="length">
                                <i class="fas fa-circle text-xs"></i>
                                <span>At least 8 characters</span>
                            </div>
                            <div class="requirement flex items-center gap-2 text-sm" id="uppercase">
                                <i class="fas fa-circle text-xs"></i>
                                <span>At least 1 uppercase letter</span>
                            </div>
                            <div class="requirement flex items-center gap-2 text-sm" id="lowercase">
                                <i class="fas fa-circle text-xs"></i>
                                <span>At least 1 lowercase letter</span>
                            </div>
                            <div class="requirement flex items-center gap-2 text-sm" id="number">
                                <i class="fas fa-circle text-xs"></i>
                                <span>At least 1 number</span>
                            </div>
                            <div class="requirement flex items-center gap-2 text-sm" id="special">
                                <i class="fas fa-circle text-xs"></i>
                                <span>At least 1 special character</span>
                            </div>
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Confirm Password *</label>
                        <input type="password" id="confirmPassword" class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500 transition-all duration-300"
                               placeholder="Confirm your password" required>
                        <div id="passwordMatch" class="password-requirements mt-2"></div>
                    </div>
                </div>

                <!-- Terms & Conditions -->
                <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
                    <input type="checkbox" id="terms" class="mt-1 w-4 h-4 text-red-600 border-gray-300 rounded focus:ring-red-500" required>
                    <label class="text-sm text-gray-700">
                        I agree to the
                        <a href="#" class="text-red-600 font-semibold hover:text-red-700 transition-colors duration-300 no-underline"
                           data-bs-toggle="modal" data-bs-target="#termsModal">
                            terms and conditions
                        </a>
                    </label>
                </div>

                <!-- Submit Button -->
                <div class="text-center pt-4">
                    <button type="submit"
                            class="w-full md:w-auto px-8 py-4 bg-green-500 hover:bg-green-600 text-white font-semibold rounded-xl transition-all duration-300 transform hover:scale-105 hover:shadow-lg focus:ring-2 focus:ring-green-500 focus:ring-opacity-50">
                        Create Account
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Terms Modal -->
    <div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content rounded-2xl overflow-hidden">
                <div class="modal-header bg-red-600 text-white py-4 px-6">
                    <h5 class="modal-title text-xl font-bold">Lingap Terms & Privacy Policy</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-6 space-y-4">
                    <div>
                        <h6 class="font-bold text-red-600 text-lg mb-2">1. Acceptance of Terms</h6>
                        <p class="text-gray-700">By signing up for Lingap, you confirm that all information provided is accurate and that you have read, understood, and agreed to these Terms and our Privacy Policy.</p>
                    </div>

                    <div>
                        <h6 class="font-bold text-red-600 text-lg mb-2">2. Data Privacy & Protection</h6>
                        <p class="text-gray-700">Lingap is committed to safeguarding your personal data. We comply with the <strong>Data Privacy Act of 2012 (RA 10173)</strong>. Your information will only be used to verify eligibility and for program coordination. We will never sell or misuse your data.</p>
                    </div>

                    <div>
                        <h6 class="font-bold text-red-600 text-lg mb-2">3. Purpose of Data Collection</h6>
                        <ul class="list-disc list-inside text-gray-700 space-y-1">
                            <li>Eligibility verification for Lingap programs</li>
                            <li>Contact and follow-up regarding assistance</li>
                            <li>Government or partner validation (as needed)</li>
                        </ul>
                    </div>

                    <div>
                        <h6 class="font-bold text-red-600 text-lg mb-2">4. Account Integrity</h6>
                        <p class="text-gray-700">Each individual is allowed <strong>one account only</strong>. Creating multiple accounts or submitting false documents may result in permanent disqualification.</p>
                    </div>

                    <div>
                        <h6 class="font-bold text-red-600 text-lg mb-2">5. Changes to Terms</h6>
                        <p class="text-gray-700">Lingap reserves the right to update this policy at any time. All changes will be posted publicly, and continued use of the service implies agreement with updated terms.</p>
                    </div>

                    <div>
                        <h6 class="font-bold text-red-600 text-lg mb-2">6. Questions or Concerns</h6>
                        <p class="text-gray-700">If you have any questions regarding your privacy, you may contact our support team at <a href="mailto:support@lingap.org" class="text-red-600 hover:text-red-700">support@lingap.org</a>.</p>
                    </div>
                </div>
                <div class="modal-footer bg-gray-50 py-4 px-6">
                    <small class="text-gray-500 me-auto">Last updated: May 2025</small>
                    <button type="button" class="px-6 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-xl transition-colors duration-300" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const password = document.getElementById('password');
            const confirmPassword = document.getElementById('confirmPassword');
            const passwordStrength = document.getElementById('passwordStrength');
            const registrationForm = document.getElementById('registrationForm');
            const phoneInput = document.getElementById('phone');
            const goBackBtn = document.getElementById('goBackBtn');
            const passwordRequirements = document.getElementById('passwordRequirements');

            // Go Back button functionality
            goBackBtn.addEventListener('click', function() {
                window.history.back();
            });

            // Password strength checker
            password.addEventListener('input', function() {
                const value = password.value;
                const requirements = {
                    length: value.length >= 8,
                    uppercase: /[A-Z]/.test(value),
                    lowercase: /[a-z]/.test(value),
                    number: /[0-9]/.test(value),
                    special: /[^A-Za-z0-9]/.test(value)
                };

                // Update requirement indicators
                for (const [key, met] of Object.entries(requirements)) {
                    const element = document.getElementById(key);
                    const icon = element.querySelector('i');
                    if (met) {
                        element.classList.add('text-green-600');
                        element.classList.remove('text-red-600', 'text-gray-400');
                        icon.className = 'fas fa-check-circle text-green-600';
                    } else {
                        element.classList.add('text-red-600');
                        element.classList.remove('text-green-600', 'text-gray-400');
                        icon.className = 'fas fa-times-circle text-red-600';
                    }
                }

                // Update strength meter
                const strength = Object.values(requirements).filter(met => met).length;
                passwordStrength.style.display = 'block';
                passwordStrength.style.width = (strength * 20) + '%';

                if (strength < 2) {
                    passwordStrength.style.backgroundColor = '#dc3545';
                } else if (strength < 4) {
                    passwordStrength.style.backgroundColor = '#ffc107';
                } else {
                    passwordStrength.style.backgroundColor = '#28a745';
                }
            });

            // Confirm password checker
            confirmPassword.addEventListener('input', function() {
                const matchElement = document.getElementById('passwordMatch');
                if (confirmPassword.value === password.value && password.value.length > 0) {
                    matchElement.innerHTML = '<div class="flex items-center gap-2 text-green-600 text-sm"><i class="fas fa-check-circle"></i> Passwords match</div>';
                } else if (password.value.length > 0) {
                    matchElement.innerHTML = '<div class="flex items-center gap-2 text-red-600 text-sm"><i class="fas fa-times-circle"></i> Passwords do not match</div>';
                } else {
                    matchElement.innerHTML = '';
                }
            });

            // Philippine phone number validation
            phoneInput.addEventListener('input', function() {
                let phoneNumber = this.value.replace(/\D/g, '');
                if (phoneNumber.length > 0 && !phoneNumber.startsWith('9')) {
                    phoneNumber = '9' + phoneNumber;
                }
                phoneNumber = phoneNumber.substring(0, 10);
                this.value = phoneNumber;
            });

            // Show/hide password requirements
            password.addEventListener('focus', function() {
                passwordRequirements.classList.remove('hidden');
            });
            password.addEventListener('input', function() {
                passwordRequirements.classList.toggle('hidden', password.value.length === 0);
            });
            password.addEventListener('blur', function() {
                if (password.value.length === 0) {
                    passwordRequirements.classList.add('hidden');
                }
            });

            // Form submission
            registrationForm.addEventListener('submit', function(e) {
                const value = password.value;
                const requirements = {
                    length: value.length >= 8,
                    uppercase: /[A-Z]/.test(value),
                    lowercase: /[a-z]/.test(value),
                    number: /[0-9]/.test(value),
                    special: /[^A-Za-z0-9]/.test(value)
                };

                const strength = Object.values(requirements).filter(met => met).length;
                if (strength < 3) {
                    alert('Please ensure your password meets all requirements (at least 3 of 5 requirements).');
                    e.preventDefault();
                    return;
                }

                if (confirmPassword.value !== password.value) {
                    alert('Passwords do not match.');
                    e.preventDefault();
                    return;
                }

                const phoneNumber = phoneInput.value;
                if (!/^9\d{9}$/.test(phoneNumber)) {
                    alert('Please enter a valid Philippine phone number (10 digits starting with 9, e.g. 9123456789)');
                    e.preventDefault();
                    return;
                }

                if (!document.getElementById('terms').checked) {
                    alert('You must agree to the terms and conditions.');
                    e.preventDefault();
                    return;
                }

                alert('Form submitted successfully!');
            });
        });
    </script>
</body>
</html>