@model RegisterAccDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up</title>
    <link rel="icon" type="image/x-icon" href="~/lingaplogo.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
</head>

<body class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-100 p-4">

    <div class="w-full max-w-md lg:max-w-2xl">
        <div class="bg-white rounded-2xl shadow-2xl p-4 lg:p-6 border border-white/20 backdrop-blur-sm">
            <!-- Compact Header -->
            <div class="text-center mb-4">
                <h1 class="text-2xl lg:text-3xl font-bold bg-gradient-to-r from-gray-800 to-gray-600 bg-clip-text text-transparent mb-2">
                    Create an Account
                </h1>
            </div>

            <!-- Success Message -->
            @if (ViewBag.SuccessMessage != null)
            {
                <div class="bg-green-50 border border-green-200 rounded-xl p-4 text-green-600 text-sm mb-6 flex items-center">
                    <i class="fas fa-check-circle mr-2"></i>
                    <span>@ViewBag.SuccessMessage</span>
                </div>
            }

            <form asp-action="Register" method="post" enctype="multipart/form-data" id="registerForm" class="space-y-4">
                <!-- Username & Email in Horizontal Layout -->
                <div class="space-y-3">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                        <!-- Username Field -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">
                                Username
                            </label>
                            <div class="relative">
                                <input asp-for="Username"
                                       type="text"
                                       class="w-full px-3 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-green-500 focus:ring-2 focus:ring-green-200 bg-white placeholder-transparent"
                                       placeholder=" "
                                       required
                                       autocomplete="username"
                                       id="username">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none bg-white px-1">
                                    <i class="fas fa-user mr-2 text-crimson-500"></i>Enter username
                                </span>
                            </div>
                            <span asp-validation-for="Username" class="text-red-500 text-xs"></span>
                        </div>

                        <!-- Email Field -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">
                                Email
                            </label>
                            <div class="relative">
                                <input asp-for="Email" type="email"
                                       class="w-full px-3 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-green-500 focus:ring-2 focus:ring-green-200 bg-white placeholder-transparent"
                                       placeholder=" "
                                       required
                                       autocomplete="email"
                                       id="email">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none bg-white px-1">
                                    <i class="fas fa-envelope mr-2 text-crimson-500"></i>Enter email
                                </span>
                            </div>
                            <span asp-validation-for="Email" class="text-red-500 text-xs"></span>
                        </div>
                    </div>
                </div>

                <!-- Password & Confirm Password in Horizontal Layout -->
                <div class="space-y-3">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                        <!-- Password Field -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">
                                Password
                            </label>
                            <div class="relative">
                                <input asp-for="Password"
                                       type="password"
                                       class="w-full px-3 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-green-500 focus:ring-2 focus:ring-green-200 bg-white pr-12"
                                       placeholder="Enter password"
                                       required
                                       autocomplete="new-password"
                                       id="password">
                                <button type="button" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none" id="togglePassword">
                                    <i class="fas fa-eye text-sm"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-red-500 text-xs"></span>
                        </div>

                        <!-- Confirm Password Field -->
                        <div class="space-y-2">
                            <label class="block text-sm font-semibold text-gray-700">
                                Confirm Password
                            </label>
                            <div class="relative">
                                <input type="password"
                                       name="ConfirmPassword"
                                       class="w-full px-3 py-3 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-green-500 focus:ring-2 focus:ring-green-200 bg-white pr-12"
                                       placeholder="Confirm password"
                                       required
                                       autocomplete="new-password"
                                       id="confirmPassword">
                                <button type="button" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none" id="toggleConfirmPassword">
                                    <i class="fas fa-eye text-sm"></i>
                                </button>
                            </div>
                            <div id="passwordMatch" class="text-xs mt-2"></div>
                        </div>
                    </div>
                </div>

                <!-- Password Requirements Tooltip -->
                <div id="passwordTooltip" class="hidden bg-blue-50 border border-blue-200 rounded-xl p-4 text-xs text-blue-700">
                    <p class="font-semibold mb-2">Password Requirements:</p>
                    <ul class="space-y-2">
                        <li id="rule-length" class="flex items-center gap-2">
                            <i class="fas fa-circle text-red-500 text-xs"></i>
                            <span>At least 8 characters</span>
                        </li>
                        <li id="rule-uppercase" class="flex items-center gap-2">
                            <i class="fas fa-circle text-red-500 text-xs"></i>
                            <span>One uppercase letter</span>
                        </li>
                        <li id="rule-lowercase" class="flex items-center gap-2">
                            <i class="fas fa-circle text-red-500 text-xs"></i>
                            <span>One lowercase letter</span>
                        </li>
                        <li id="rule-number" class="flex items-center gap-2">
                            <i class="fas fa-circle text-red-500 text-xs"></i>
                            <span>One number</span>
                        </li>
                        <li id="rule-symbol" class="flex items-center gap-2">
                            <i class="fas fa-circle text-red-500 text-xs"></i>
                            <span>One special character</span>
                        </li>
                    </ul>
                </div>

                <!-- Password Strength Indicator -->
                <div id="passwordStrength" class="hidden">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="text-xs text-gray-600">Password strength:</span>
                        <span id="strengthText" class="text-xs font-semibold"></span>
                    </div>
                    <div class="w-full bg-gray-200 rounded-full h-2">
                        <div id="strengthBar" class="h-2 rounded-full" style="width: 0%"></div>
                    </div>
                </div>

                <!-- Social Login -->
                <div class="pt-2">
                    <div class="flex items-center my-4">
                        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-gray-300 to-transparent"></div>
                        <span class="px-3 text-xs text-gray-500 bg-white font-medium">or continue with</span>
                        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-gray-300 to-transparent"></div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <a href="/Login/GoogleLogin" class="flex items-center justify-center gap-2 px-3 py-2 border-2 border-gray-200 rounded-xl hover:border-green-500 hover:bg-green-50 group">
                            <img src="https://www.gstatic.com/images/branding/product/2x/googleg_64dp.png" alt="Google" class="w-4 h-4">
                            <span class="text-xs font-medium text-gray-600 group-hover:text-green-700">Google</span>
                        </a>

                        <a href="/Login/FacebookLogin" class="flex items-center justify-center gap-2 px-3 py-2 bg-blue-600 text-white rounded-xl hover:bg-blue-700 group shadow-sm">
                            <i class="fab fa-facebook-f text-xs"></i>
                            <span class="text-xs font-medium">Facebook</span>
                        </a>
                    </div>
                </div>

                <!-- reCAPTCHA -->
                <div class="bg-gray-50 rounded-xl p-3 border border-gray-200">
                    <div class="g-recaptcha mx-auto scale-90 lg:scale-100" data-sitekey="6Lfdj1orAAAAAGDqwcRDBkTCHoXYx9mLDeCn7kwV"></div>
                    <div id="recaptchaError" class="text-red-500 text-xs mt-2 hidden">Please complete the reCAPTCHA</div>
                </div>

                <!-- Terms Agreement -->
                <div class="flex items-start space-x-3 p-3 bg-gray-50 rounded-xl border border-gray-200 hover:bg-blue-50 hover:border-blue-200">
                    <input type="checkbox" id="terms" name="terms" class="mt-0.5 accent-green-600 focus:ring-2 focus:ring-green-500 focus:ring-offset-1" required>
                    <label for="terms" class="text-xs text-gray-700 flex-1 leading-relaxed cursor-pointer">
                        I agree to the
                        <a href="#" class="text-blue-600 hover:text-blue-800 font-semibold" data-bs-toggle="modal" data-bs-target="#termsModal">Terms and Conditions</a>
                    </label>
                </div>
                <div id="termsError" class="text-red-500 text-xs mt-2 hidden">You must agree to the terms and conditions</div>

                <!-- Submit Button -->
                <button type="submit" class="w-full bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white py-3 rounded-xl font-semibold text-sm lg:text-base shadow-lg hover:shadow-xl group disabled:opacity-50 disabled:cursor-not-allowed" id="registerButton">
                    <span class="flex items-center justify-center gap-2">
                        <span>Sign Up</span>
                        <i class="fas fa-arrow-right group-hover:translate-x-1"></i>
                    </span>
                </button>

                <!-- Links -->
                <div class="text-center space-y-2 pt-2">
                    <p class="text-gray-500 text-xs lg:text-sm">
                        Already have an account?
                        <a href="/Login" class="text-blue-600 hover:text-blue-800 font-semibold ml-1">Sign in</a>
                    </p>
                    <p class="text-gray-500 text-xs lg:text-sm">
                        <a href="/" class="text-blue-600 hover:text-blue-800 font-semibold">Back to Home</a>
                    </p>
                </div>
            </form>
        </div>
    </div>

    <!-- Terms Modal -->
    <div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-3xl shadow-2xl overflow-hidden bg-gradient-to-br from-white to-gray-50">
                <!-- Header -->
                <div class="modal-header bg-gradient-to-r from-green-500 to-green-600 text-white py-4 px-6 border-b-0">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center">
                            <i class="fas fa-file-contract text-white text-lg"></i>
                        </div>
                        <div>
                            <h5 class="modal-title font-bold text-lg tracking-wide" id="termsModalLabel">
                                Terms & Privacy Policy
                            </h5>
                            <p class="text-green-100 text-sm font-normal">Last updated: 2024</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <!-- Body -->
                <div class="modal-body p-6 space-y-6 max-h-96 overflow-y-auto">
                    <!-- Acceptance of Terms -->
                    <div class="bg-white rounded-xl p-4 border border-green-100 shadow-sm">
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-handshake text-green-600 text-sm"></i>
                            </div>
                            <h6 class="font-bold text-green-700 text-base">1. Acceptance of Terms</h6>
                        </div>
                        <p class="text-gray-700 text-sm leading-relaxed">
                            By signing up for our service, you confirm that all information provided is accurate and that you have read, understood, and agreed to these Terms and our Privacy Policy.
                        </p>
                    </div>

                    <!-- Data Privacy -->
                    <div class="bg-white rounded-xl p-4 border border-blue-100 shadow-sm">
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-shield-alt text-blue-600 text-sm"></i>
                            </div>
                            <h6 class="font-bold text-blue-700 text-base">2. Data Privacy & Protection</h6>
                        </div>
                        <p class="text-gray-700 text-sm leading-relaxed">
                            We comply with the <strong class="text-blue-600">Data Privacy Act of 2012 (RA 10173)</strong> and ensure responsible handling of your personal data with the highest level of security and care.
                        </p>
                    </div>

                    <!-- Data Collection -->
                    <div class="bg-white rounded-xl p-4 border border-purple-100 shadow-sm">
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-database text-purple-600 text-sm"></i>
                            </div>
                            <h6 class="font-bold text-purple-700 text-base">3. Purpose of Data Collection</h6>
                        </div>
                        <ul class="text-gray-700 text-sm space-y-2 ps-4">
                            <li class="flex items-start gap-2">
                                <i class="fas fa-check-circle text-green-500 text-xs mt-1"></i>
                                <span>Eligibility verification for assistance programs</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <i class="fas fa-check-circle text-green-500 text-xs mt-1"></i>
                                <span>Contact and follow-up regarding your application</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <i class="fas fa-check-circle text-green-500 text-xs mt-1"></i>
                                <span>Partner validation as necessary for service delivery</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Account Integrity -->
                    <div class="bg-white rounded-xl p-4 border border-orange-100 shadow-sm">
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-8 h-8 bg-orange-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-user-check text-orange-600 text-sm"></i>
                            </div>
                            <h6 class="font-bold text-orange-700 text-base">4. Account Integrity</h6>
                        </div>
                        <p class="text-gray-700 text-sm leading-relaxed">
                            Each individual is allowed <strong class="text-orange-600">only one account</strong>. Creating multiple or falsified accounts may result in disqualification and suspension of access to our services.
                        </p>
                    </div>

                    <!-- Changes to Terms -->
                    <div class="bg-white rounded-xl p-4 border border-red-100 shadow-sm">
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-8 h-8 bg-red-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-sync text-red-600 text-sm"></i>
                            </div>
                            <h6 class="font-bold text-red-700 text-base">5. Changes to Terms</h6>
                        </div>
                        <p class="text-gray-700 text-sm leading-relaxed">
                            We reserve the right to modify these Terms at any time. All updates will be posted publicly, and continued use of our services signifies acceptance of the latest terms.
                        </p>
                    </div>
                </div>

                <!-- Footer -->
                <div class="modal-footer bg-gray-50 py-4 px-6 border-t-0">
                    <div class="w-full flex flex-col sm:flex-row items-center justify-between gap-3">
                        <div class="flex items-center gap-2 text-gray-600 text-sm">
                            <i class="fas fa-info-circle text-blue-500"></i>
                            <span>Questions? Contact us at <a href="mailto:support@lingap.org" class="text-blue-600 font-semibold hover:underline">support@lingap.org</a></span>
                        </div>
                        <button type="button" class="w-full sm:w-auto bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded-xl font-semibold shadow-sm hover:shadow-md" data-bs-dismiss="modal">
                            I Understand
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Success Modal -->
    <div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-3xl shadow-2xl overflow-hidden bg-gradient-to-br from-white to-green-50">
                <!-- Close Button - Top Right -->
                <button type="button" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 transition-colors z-10" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fas fa-times text-xl"></i>
                </button>

                <div class="modal-body p-6 text-center pt-12">
                    <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-check text-green-600 text-3xl"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-800 mb-2">Registration Successful!</h3>

                    <!-- Back to Login Button -->
                    <div class="space-y-4">
                        <a href="/Login" class="w-full bg-green-600 hover:bg-green-700 text-white py-3 px-6 rounded-xl font-semibold shadow-sm hover:shadow-md transition-all duration-200 inline-block">
                            Back to Login
                        </a>
                        <button type="button" class="w-full bg-gray-200 hover:bg-gray-300 text-gray-700 py-3 px-6 rounded-xl font-semibold shadow-sm hover:shadow-md transition-all duration-200" data-bs-dismiss="modal">
                            Close
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Password validation rules
            const rules = {
                length: /.{8,}/,
                uppercase: /[A-Z]/,
                lowercase: /[a-z]/,
                number: /[0-9]/,
                symbol: /[^A-Za-z0-9]/
            };

            // Elements
            const passwordInput = document.getElementById('password');
            const confirmInput = document.getElementById('confirmPassword');
            const passwordTooltip = document.getElementById('passwordTooltip');
            const matchIndicator = document.getElementById('passwordMatch');
            const togglePassword = document.getElementById('togglePassword');
            const toggleConfirmPassword = document.getElementById('toggleConfirmPassword');
            const passwordStrength = document.getElementById('passwordStrength');
            const strengthBar = document.getElementById('strengthBar');
            const strengthText = document.getElementById('strengthText');
            const termsCheckbox = document.getElementById('terms');
            const termsError = document.getElementById('termsError');
            const recaptchaError = document.getElementById('recaptchaError');
            const registerButton = document.getElementById('registerButton');

            // Floating label functionality for username and email
            function initializeFloatingLabel(inputId) {
                const input = document.getElementById(inputId);
                const label = input.nextElementSibling;

                input.addEventListener('focus', function() {
                    label.style.top = '0';
                    label.style.fontSize = '0.75rem';
                    label.style.color = '#10b981';
                    label.style.transform = 'translateY(-50%)';
                });

                input.addEventListener('blur', function() {
                    if (this.value.trim() === '') {
                        label.style.top = '50%';
                        label.style.fontSize = '0.875rem';
                        label.style.color = '#9ca3af';
                        label.style.transform = 'translateY(-50%)';
                    }
                });

                // Initialize label position
                if (input.value.trim() !== '') {
                    label.style.top = '0';
                    label.style.fontSize = '0.75rem';
                    label.style.color = '#10b981';
                    label.style.transform = 'translateY(-50%)';
                }
            }

            // Initialize floating labels
            initializeFloatingLabel('username');
            initializeFloatingLabel('email');

            // Manual spinner rotation using JavaScript
            let spinnerRotation = 0;
            function rotateSpinner() {
                if (registerButton && registerButton.querySelector('.fa-spinner')) {
                    spinnerRotation += 30;
                    registerButton.querySelector('.fa-spinner').style.transform = `rotate(${spinnerRotation}deg)`;
                    requestAnimationFrame(rotateSpinner);
                }
            }

            // Toggle password visibility
            function togglePasswordVisibility(input, button) {
                const type = input.getAttribute('type') === 'password' ? 'text' : 'password';
                input.setAttribute('type', type);
                button.innerHTML = type === 'password' ? '<i class="fas fa-eye text-sm"></i>' : '<i class="fas fa-eye-slash text-sm"></i>';
            }

            if (togglePassword) {
                togglePassword.addEventListener('click', () => togglePasswordVisibility(passwordInput, togglePassword));
            }

            if (toggleConfirmPassword) {
                toggleConfirmPassword.addEventListener('click', () => togglePasswordVisibility(confirmInput, toggleConfirmPassword));
            }

            // Password strength calculation
            function calculatePasswordStrength(password) {
                let strength = 0;

                if (password.length >= 8) strength += 20;
                if (/[A-Z]/.test(password)) strength += 20;
                if (/[a-z]/.test(password)) strength += 20;
                if (/[0-9]/.test(password)) strength += 20;
                if (/[^A-Za-z0-9]/.test(password)) strength += 20;

                return Math.min(strength, 100);
            }

            function updatePasswordStrength(password) {
                const strength = calculatePasswordStrength(password);

                if (password.length === 0) {
                    passwordStrength.classList.add('hidden');
                    return;
                }

                passwordStrength.classList.remove('hidden');
                strengthBar.style.width = strength + '%';

                if (strength < 40) {
                    strengthBar.className = 'h-2 rounded-full bg-red-500';
                    strengthText.textContent = 'Weak';
                    strengthText.className = 'text-xs font-semibold text-red-600';
                } else if (strength < 80) {
                    strengthBar.className = 'h-2 rounded-full bg-yellow-500';
                    strengthText.textContent = 'Medium';
                    strengthText.className = 'text-xs font-semibold text-yellow-600';
                } else {
                    strengthBar.className = 'h-2 rounded-full bg-green-500';
                    strengthText.textContent = 'Strong';
                    strengthText.className = 'text-xs font-semibold text-green-600';
                }
            }

            // Password requirements validation
            function validatePasswordRequirements() {
                if (!passwordInput) return;
                const val = passwordInput.value;

                Object.entries(rules).forEach(([key, regex]) => {
                    const el = document.getElementById(`rule-${key}`);
                    if (!el) return;
                    const icon = el.querySelector("i");
                    if (regex.test(val)) {
                        icon.classList.replace("text-red-500", "text-green-500");
                        el.classList.add("text-green-600", "font-medium");
                    } else {
                        icon.classList.replace("text-green-500", "text-red-500");
                        el.classList.remove("text-green-600", "font-medium");
                    }
                });

                updatePasswordStrength(val);

                if (document.activeElement === passwordInput && val.length > 0) {
                    passwordTooltip?.classList.remove('hidden');
                }
            }

            // Password match validation
            function validatePasswordMatch() {
                if (!matchIndicator || !passwordInput || !confirmInput) return true;

                const password = passwordInput.value;
                const confirmPassword = confirmInput.value;

                if (confirmPassword === '') {
                    matchIndicator.textContent = '';
                    confirmInput.classList.remove('border-red-500', 'border-green-500');
                    return true;
                }

                if (password === confirmPassword) {
                    confirmInput.classList.remove('border-red-500');
                    confirmInput.classList.add('border-green-500');
                    matchIndicator.innerHTML = '<i class="fas fa-check-circle text-green-600"></i> <span class="text-green-600 font-medium">Passwords match</span>';
                    return true;
                } else {
                    confirmInput.classList.remove('border-green-500');
                    confirmInput.classList.add('border-red-500');
                    matchIndicator.innerHTML = '<i class="fas fa-times-circle text-red-500"></i> <span class="text-red-500 font-medium">Passwords do not match</span>';
                    return false;
                }
            }

            // Form validation
            function validateForm() {
                let isValid = true;

                // Validate terms
                if (!termsCheckbox.checked) {
                    termsError.classList.remove('hidden');
                    isValid = false;
                } else {
                    termsError.classList.add('hidden');
                }

                // Validate reCAPTCHA
                const recaptchaResponse = grecaptcha.getResponse();
                if (!recaptchaResponse) {
                    recaptchaError.classList.remove('hidden');
                    isValid = false;
                } else {
                    recaptchaError.classList.add('hidden');
                }

                // Validate password match
                if (!validatePasswordMatch()) {
                    isValid = false;
                }

                return isValid;
            }

            // Event listeners
            if (passwordInput) {
                passwordInput.addEventListener('input', validatePasswordRequirements);
                passwordInput.addEventListener('focus', () => {
                    if (passwordInput.value.length > 0) {
                        passwordTooltip?.classList.remove('hidden');
                    }
                });
                passwordInput.addEventListener('blur', () => {
                    setTimeout(() => passwordTooltip?.classList.add('hidden'), 200);
                });
            }

            if (confirmInput) {
                confirmInput.addEventListener('input', validatePasswordMatch);
            }

            if (termsCheckbox) {
                termsCheckbox.addEventListener('change', () => {
                    if (termsCheckbox.checked) {
                        termsError.classList.add('hidden');
                    }
                });
            }

            // Form submission handler
            document.getElementById('registerForm').addEventListener('submit', function(event) {
                if (!validateForm()) {
                    event.preventDefault();
                    return false;
                }

                // Show loading state with manual spinner
                if (registerButton) {
                    registerButton.innerHTML = '<i class="fas fa-spinner"></i> Creating Account...';
                    registerButton.disabled = true;
                    rotateSpinner();
                }
            });

            // Auto-show success modal if we have success message
            if (document.querySelector('.bg-green-50')) {
                setTimeout(() => {
                    showSuccessModal();
                }, 500);
            }

            // Auto-focus on first input
            const firstInput = document.getElementById('username');
            if (firstInput && firstInput.value === '') {
                setTimeout(() => firstInput.focus(), 100);
            }
        });

        // Success modal functionality
        function showSuccessModal() {
            const successModalElement = document.getElementById('successModal');
            if (!successModalElement) return;

            const successModal = new bootstrap.Modal(successModalElement);
            successModal.show();
        }
    </script>

