@model RegisterAccDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up</title>
    <link rel="icon" type="image/x-icon" href="~/Icon/lingaplogo.ico">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="~/css/login-styles.css" asp-append-version="true">
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <style>
        /* Custom styles for improved form layout */
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        @@media (max-width: 768px) {
            .form-row {
                grid-template-columns: 1fr;
                gap: 0.75rem;
            }
        }

        .floating-input {
            transition: all 0.2s ease;
            padding: 0.75rem 1rem;
            border: 2px solid #e2e8f0;
            border-radius: 0.75rem;
            background-color: white;
            font-size: 0.95rem;
            width: 100%;
        }

            .floating-input:focus {
                border-color: #10b981;
                box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
                outline: none;
            }

        .floating-label {
            position: absolute;
            top: 50%;
            left: 1rem;
            transform: translateY(-50%);
            transition: all 0.2s ease;
            pointer-events: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #6b7280;
            font-size: 0.95rem;
        }

        .floating-input:focus + .floating-label,
        .floating-input:not(:placeholder-shown) + .floating-label,
        .floating-label.active {
            top: 0;
            left: 0.75rem;
            font-size: 0.75rem;
            background-color: white;
            padding: 0 0.25rem;
            color: #10b981;
        }

        /* Prevent select from always showing active state */
        select.floating-input:not(:focus) + .floating-label {
            top: 50%;
            left: 1rem;
            transform: translateY(-50%);
            font-size: 0.95rem;
            padding: 0;
            color: #6b7280;
        }

        /* Only activate select label when focused or has non-empty value */
        select.floating-input:focus + .floating-label,
        select.floating-input.has-value + .floating-label {
            top: 0;
            left: 0.75rem;
            font-size: 0.75rem;
            background-color: white;
            padding: 0 0.25rem;
            color: #10b981;
            transform: translateY(0);
        }

        .input-container {
            position: relative;
            margin-bottom: 1.5rem;
        }

        .form-container {
            max-width: 800px;
            width: 100%;
            margin: 0 auto;
        }

        /* Terms Modal Centering and Responsiveness */
        #termsModal .modal-dialog {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            min-height: calc(100vh - 1rem) !important;
            margin: 0.5rem auto !important;
            max-width: 800px !important;
            width: calc(100% - 1rem) !important;
        }

        #termsModal .modal-content {
            max-height: 90vh;
            display: flex;
            flex-direction: column;
        }

        #termsModal .modal-body {
            overflow-y: auto;
            flex: 1;
        }

        @@media (max-width: 576px) {
            #termsModal .modal-dialog {
                max-width: calc(100% - 1rem) !important;
                margin: 0.5rem !important;
            }

            #termsModal .modal-content {
                max-height: 85vh;
            }

            #termsModal .modal-body {
                padding: 1rem !important;
            }
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-100 p-2 sm:p-4 md:p-6">
    <div class="form-container">
        <div class="bg-white rounded-xl sm:rounded-2xl shadow-lg sm:shadow-2xl p-4 sm:p-6 md:p-7 lg:p-8 border border-white/20 backdrop-blur-sm">
            <!-- Compact Header -->
            <div class="text-center mb-4 sm:mb-6 md:mb-7 lg:mb-8">
                <h1 class="text-xl sm:text-2xl md:text-2xl lg:text-3xl font-bold bg-gradient-to-r from-gray-800 to-gray-600 bg-clip-text text-transparent mb-1 sm:mb-2">
                    Create Account
                </h1>
            </div>

            <form asp-action="Register" method="post" enctype="multipart/form-data" id="registerForm" class="space-y-3 sm:space-y-4 md:space-y-4 lg:space-y-5">

                @* Hidden Security Token *@
                <input type="hidden" asp-for="RegistrationToken" value="@ViewBag.RegistrationToken" id="registrationToken" />

                <!-- Name Warning Container (will be inserted dynamically) -->

                <!-- Name Fields Grid -->
                <div class="grid grid-cols-2 gap-3 sm:gap-4">
                    <!-- First Name -->
                    <div class="space-y-1.5 sm:space-y-2">
                        <div class="relative">
                            <input asp-for="FirstName"
                                   type="text"
                                   class="floating-input w-full px-3 sm:px-4 py-2.5 sm:py-3 md:py-3 lg:py-3.5 text-sm sm:text-base border-2 border-gray-200 rounded-lg sm:rounded-xl bg-white"
                                   placeholder=" "
                                   required
                                   autocomplete="given-name"
                                   id="firstName">
                            <label for="firstName" class="floating-label">
                                <i class="fas fa-user"></i>
                                <span>First Name</span>
                            </label>
                        </div>
                        <span asp-validation-for="FirstName" class="text-red-500 text-xs"></span>
                    </div>

                    <!-- Middle Name -->
                    <div class="space-y-1.5 sm:space-y-2">
                        <div class="relative">
                            <input asp-for="MiddleName"
                                   type="text"
                                   class="floating-input w-full px-3 sm:px-4 py-2.5 sm:py-3 md:py-3 lg:py-3.5 text-sm sm:text-base border-2 border-gray-200 rounded-lg sm:rounded-xl bg-white"
                                   placeholder=" "
                                   required
                                   autocomplete="additional-name"
                                   id="middleName">
                            <label for="middleName" class="floating-label">
                                <i class="fas fa-user"></i>
                                <span>Middle Name</span>
                            </label>
                        </div>
                        <span asp-validation-for="MiddleName" class="text-red-500 text-xs"></span>
                    </div>

                    <!-- Last Name -->
                    <div class="space-y-1.5 sm:space-y-2">
                        <div class="relative">
                            <input asp-for="LastName"
                                   type="text"
                                   class="floating-input w-full px-3 sm:px-4 py-2.5 sm:py-3 md:py-3 lg:py-3.5 text-sm sm:text-base border-2 border-gray-200 rounded-lg sm:rounded-xl bg-white"
                                   placeholder=" "
                                   required
                                   autocomplete="family-name"
                                   id="lastName">
                            <label for="lastName" class="floating-label">
                                <i class="fas fa-user"></i>
                                <span>Last Name</span>
                            </label>
                        </div>
                        <span asp-validation-for="LastName" class="text-red-500 text-xs"></span>
                    </div>

                    <!-- Suffix (Optional) -->
                    <div class="space-y-1.5 sm:space-y-2">
                        <div class="relative">
                            <select asp-for="Suffix"
                                    class="floating-input w-full px-3 sm:px-4 py-2.5 sm:py-3 md:py-3 lg:py-3.5 text-sm sm:text-base border-2 border-gray-200 rounded-lg sm:rounded-xl bg-white appearance-none cursor-pointer"
                                    autocomplete="honorific-suffix"
                                    id="suffix">
                                <option value="">None</option>
                                <option value="Jr.">Jr.</option>
                                <option value="Sr.">Sr.</option>
                                <option value="II">II</option>
                                <option value="III">III</option>
                                <option value="IV">IV</option>
                                <option value="V">V</option>
                            </select>
                            <label for="suffix" class="floating-label">
                                <i class="fas fa-id-badge"></i>
                                <span>Suffix (Optional)</span>
                            </label>
                            @* <div class="pointer-events-none absolute inset-y-0 right-3 sm:right-4 flex items-center" style="z-index: 5;">
                                <i class="fas fa-chevron-down text-gray-400 text-xs sm:text-sm"></i>
                            </div> *@
                        </div>
                        <span asp-validation-for="Suffix" class="text-red-500 text-xs"></span>
                    </div>
                </div>

                <!-- Username and Email in a row -->
                <div class="form-row">
                    <!-- Username -->
                    <div class="space-y-1.5 sm:space-y-2">
                        <div class="relative">
                            <input asp-for="Username"
                                   type="text"
                                   class="floating-input w-full px-3 sm:px-4 py-2.5 sm:py-3 md:py-3 lg:py-3.5 text-sm sm:text-base border-2 border-gray-200 rounded-lg sm:rounded-xl bg-white"
                                   placeholder=" "
                                   required
                                   autocomplete="username"
                                   id="username">
                            <label for="username" class="floating-label">
                                <i class="fas fa-user-circle"></i>
                                <span>Username</span>
                            </label>
                        </div>
                        <span asp-validation-for="Username" class="text-red-500 text-xs"></span>
                    </div>

                    <!-- Email -->
                    <div class="space-y-1.5 sm:space-y-2">
                        <div class="relative">
                            <input asp-for="Email"
                                   type="email"
                                   class="floating-input w-full px-3 sm:px-4 py-2.5 sm:py-3 md:py-3 lg:py-3.5 text-sm sm:text-base border-2 border-gray-200 rounded-lg sm:rounded-xl bg-white"
                                   placeholder=" "
                                   required
                                   autocomplete="email"
                                   id="email">
                            <label for="email" class="floating-label">
                                <i class="fas fa-envelope"></i>
                                <span>Email Address</span>
                            </label>
                        </div>
                        <span asp-validation-for="Email" class="text-red-500 text-xs"></span>
                    </div>
                </div>

                <!-- Password and Confirm Password in a row -->
                <div class="form-row">
                    <!-- Password -->
                    <div class="space-y-1.5 sm:space-y-2">
                        <div class="relative">
                            <input asp-for="Password"
                                   type="password"
                                   class="floating-input w-full px-3 sm:px-4 py-2.5 sm:py-3 md:py-3 lg:py-3.5 text-sm sm:text-base border-2 border-gray-200 rounded-lg sm:rounded-xl bg-white pr-10 sm:pr-12"
                                   placeholder=" "
                                   required
                                   autocomplete="new-password"
                                   id="password">
                            <label for="password" class="floating-label">
                                <i class="fas fa-lock"></i>
                                <span>Password</span>
                            </label>
                            <button type="button" class="absolute right-3 sm:right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none border-0 bg-transparent z-10" id="togglePassword">
                                <i class="fas fa-eye text-xs sm:text-sm"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-red-500 text-xs"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="space-y-1.5 sm:space-y-2">
                        <div class="relative">
                            <input type="password"
                                   name="ConfirmPassword"
                                   class="floating-input w-full px-3 sm:px-4 py-2.5 sm:py-3 md:py-3 lg:py-3.5 text-sm sm:text-base border-2 border-gray-200 rounded-lg sm:rounded-xl bg-white pr-10 sm:pr-12"
                                   placeholder=" "
                                   required
                                   autocomplete="new-password"
                                   id="confirmPassword">
                            <label for="confirmPassword" class="floating-label">
                                <i class="fas fa-lock"></i>
                                <span>Confirm Password</span>
                            </label>
                            <button type="button" class="absolute right-3 sm:right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none border-0 bg-transparent z-10" id="toggleConfirmPassword">
                                <i class="fas fa-eye text-xs sm:text-sm"></i>
                            </button>
                        </div>
                        <div id="passwordMatch" class="text-xs mt-1 hidden transition-all duration-300"></div>
                    </div>
                </div>

                <!-- Password Requirements -->
                <div id="passwordTooltip" class="hidden bg-blue-50 border border-blue-200 rounded-lg sm:rounded-xl p-2.5 sm:p-3 text-xs sm:text-xs text-blue-700 transition-all duration-300">
                    <p class="font-semibold mb-1.5 sm:mb-2 text-xs sm:text-sm">Password Requirements:</p>
                    <ul class="space-y-0.5 sm:space-y-1">
                        <li id="rule-length" class="flex items-center gap-1.5 sm:gap-2">
                            <i class="fas fa-circle text-red-500 text-xs"></i>
                            <span class="text-xs">At least 8 characters</span>
                        </li>
                        <li id="rule-uppercase" class="flex items-center gap-1.5 sm:gap-2">
                            <i class="fas fa-circle text-red-500 text-xs"></i>
                            <span class="text-xs">One uppercase letter</span>
                        </li>
                        <li id="rule-lowercase" class="flex items-center gap-1.5 sm:gap-2">
                            <i class="fas fa-circle text-red-500 text-xs"></i>
                            <span class="text-xs">One lowercase letter</span>
                        </li>
                        <li id="rule-number" class="flex items-center gap-1.5 sm:gap-2">
                            <i class="fas fa-circle text-red-500 text-xs"></i>
                            <span class="text-xs">One number</span>
                        </li>
                        <li id="rule-symbol" class="flex items-center gap-1.5 sm:gap-2">
                            <i class="fas fa-circle text-red-500 text-xs"></i>
                            <span class="text-xs">One special character</span>
                        </li>
                    </ul>
                    <div id="passwordRequirementError" class="hidden mt-2 sm:mt-3 p-1.5 sm:p-2 bg-red-50 border border-red-200 rounded-lg text-red-700">
                        <i class="fas fa-exclamation-triangle mr-1 sm:mr-2 text-xs"></i>
                        <span class="font-medium text-xs">Please meet all password requirements above</span>
                    </div>
                </div>

                <!-- Compact Social Login -->
                <div class="pt-1 sm:pt-2">
                    <div class="flex items-center my-3 sm:my-4">
                        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-gray-300 to-transparent"></div>
                        <span class="px-2 sm:px-3 text-xs sm:text-xs text-gray-500 bg-white font-medium">or sign up with</span>
                        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-gray-300 to-transparent"></div>
                    </div>

                    <div class="flex justify-center">
                        <button type="button" onclick="showGoogleConfirmation()"
                                class="flex items-center justify-center gap-1.5 sm:gap-2 px-2 sm:px-3 py-2 sm:py-2.5 border-2 border-gray-200 rounded-lg sm:rounded-xl hover:border-green-500 hover:bg-green-50 transition-all duration-200 group"
                                style="width: 300px;">
                            <img src="https://www.gstatic.com/images/branding/product/2x/googleg_64dp.png" alt="Google"
                                 class="w-3.5 h-3.5 sm:w-4 sm:h-4">
                            <span class="text-xs sm:text-xs font-medium text-gray-600 group-hover:text-green-700">Google</span>
                        </button>
                    </div>
                </div>

                <!-- reCAPTCHA -->
                    <div class="g-recaptcha mx-auto scale-75 sm:scale-90 md:scale-95 lg:scale-100 flex justify-center" data-sitekey="@ViewBag.ReCaptchaSiteKey"></div>
               
                <!-- Terms Agreement -->
                <div class="flex items-start gap-2 sm:gap-3 p-2.5 sm:p-3 bg-gray-50 rounded-lg sm:rounded-xl  border-gray-200 hover:bg-blue-50 hover:border-blue-200 transition-all duration-200">
                    <input type="checkbox" id="terms" name="terms" class="mt-0.5 ml-1 accent-green-600 flex-shrink-0" required>
                    <label for="terms" class="text-xs sm:text-xs text-gray-700 flex-1 leading-relaxed cursor-pointer">
                        I agree to the
                        <a href="#" class="text-blue-600 hover:text-blue-800 font-semibold transition-colors duration-200" data-bs-toggle="modal" data-bs-target="#termsModal">Terms and Conditions</a>
                    </label>
                </div>

                <!-- Submit Button -->
                <div class="flex justify-center">
                    <button type="submit" class="bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white px-6 sm:px-8 md:px-10 py-2.5 sm:py-3 md:py-3 lg:py-3.5 rounded-lg sm:rounded-xl font-semibold text-sm sm:text-sm md:text-base lg:text-base shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-300 group border-0" id="registerButton">
                        <span class="flex items-center justify-center gap-1.5 sm:gap-2">
                            <span>Sign Up</span>
                            <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform duration-200 text-xs sm:text-sm"></i>
                        </span>
                    </button>
                </div>

                <!-- Links -->
                <div class="text-center space-y-1.5 sm:space-y-2 pt-1 sm:pt-2">
                    <p class="text-gray-500 text-xs sm:text-xs md:text-sm lg:text-sm">
                        Already have an account?
                        <a href="/Login" class="text-blue-600 hover:text-blue-800 font-semibold transition-colors duration-200 ml-1">Sign in</a>
                    </p>
                    <p class="text-gray-500 text-xs sm:text-xs md:text-sm lg:text-sm">
                        <a href="/" class="text-blue-600 hover:text-blue-800 font-semibold transition-colors duration-200">Back to Home</a>
                    </p>
                </div>
            </form>
        </div>
    </div>

    <!-- Google Sign-In Confirmation Modal -->
    <div class="modal-overlay-enhanced" id="googleConfirmationModal" style="display: none;">
        <div class="modal-content-enhanced modal-info">

            <!-- BIG WARNING ICON (Heroicons Outline) -->
            <div class="modal-icon-wrapper info-icon-wrapper flex items-center justify-center py-4">
                <svg xmlns="http://www.w3.org/2000/svg"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke-width="2.5"
                     stroke="currentColor"
                     class="text-red-600 w-32 h-32 sm:w-40 sm:h-40">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M12 9v4m0 4h.01M10.478 3.332c.777-1.34 2.768-1.34
                         3.545 0l8.163 14.086c.75 1.296-.195 2.914-1.773
                         2.914H4.089c-1.578 0-2.523-1.618-1.773-2.914L10.478 3.332z" />
                </svg>
            </div>

            <h3 class="modal-title text-lg sm:text-xl mb-3 sm:mb-4">
                Important: Google Account Name Verification
            </h3>

            <div class="modal-content-scrollable">
                <p class="modal-subtitle">
                    <i class="fas fa-info-circle text-blue-500 mr-2"></i>
                    Before proceeding, please confirm:
                </p>

                <ul class="modal-list">
                    <li class="modal-list-item">
                        <i class="fas fa-check-circle text-green-500"></i>
                        <span>The name in your Google account must be your <strong>real, legal name</strong></span>
                    </li>
                    <li class="modal-list-item">
                        <i class="fas fa-id-card text-blue-500"></i>
                        <span>Your name will be <strong>verified against a valid ID</strong> during Account Verification</span>
                    </li>
                    <li class="modal-list-item">
                        <i class="fas fa-times-circle text-red-500"></i>
                        <span>You <strong>cannot complete verification</strong> if your Google name doesn't match your valid ID</span>
                    </li>
                    <li class="modal-list-item">
                        <i class="fas fa-ban text-red-500"></i>
                        <span>Accounts with fake or invalid names may be <strong>suspended</strong></span>
                    </li>
                </ul>
            </div>

            <div class="modal-actions">
                <button onclick="closeGoogleConfirmation()" class="modal-button modal-button-secondary">
                    <i class="fas fa-times mr-2"></i>Cancel
                </button>
                <button onclick="proceedToGoogle()" class="modal-button modal-button-success">
                    <i class="fas fa-check mr-2"></i>I Understand, Continue
                </button>
            </div>
        </div>
    </div>

    <!-- Google Credentials Input Modal -->
    @if (TempData["RequireGoogleCredentials"] != null && (bool)TempData["RequireGoogleCredentials"])
    {
        <div class="modal-overlay-enhanced show" id="googleCredentialsModal">
            <div class="modal-content-enhanced modal-info" style="max-width: 700px; max-height: 90vh; overflow-y: auto;">
                <h3 class="modal-title text-lg sm:text-xl mb-3 sm:mb-4">
                    <i class="fas fa-user-edit text-blue-600 mr-2"></i>
                    Complete Your Profile
                </h3>

                <p class="modal-subtitle mb-4">
                    Please provide your full legal name and create a password for your account.
                </p>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="bg-red-50 border border-red-200 rounded-lg p-3 mb-3 text-red-600 text-sm">
                        <i class="fas fa-exclamation-circle mr-2"></i>
                        @TempData["ErrorMessage"]
                    </div>
                }

                <form id="googleCredentialsForm" action="/Login/CompleteGoogleRegistration" method="post" class="space-y-3 sm:space-y-4">
                    <input type="hidden" name="GoogleEmail" value="@TempData.Peek("GoogleEmail")" />
                    <input type="hidden" name="GoogleName" value="@TempData.Peek("GoogleName")" />

                    <!-- Name Fields Grid -->
                    <div class="grid grid-cols-2 gap-3 sm:gap-4">
                        <!-- First Name -->
                        <div class="space-y-1.5 sm:space-y-2">
                            <div class="relative">
                                <input type="text" 
                                       name="FirstName" 
                                       id="googleFirstName"
                                       class="floating-input w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm sm:text-base border-2 border-gray-200 rounded-lg sm:rounded-xl bg-white"
                                       placeholder=" "
                                       required
                                       autocomplete="given-name" />
                                <label for="googleFirstName" class="floating-label">
                                    <i class="fas fa-user"></i>
                                    <span>First Name</span>
                                </label>
                            </div>
                        </div>

                        <!-- Middle Name -->
                        <div class="space-y-1.5 sm:space-y-2">
                            <div class="relative">
                                <input type="text" 
                                       name="MiddleName" 
                                       id="googleMiddleName"
                                       class="floating-input w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm sm:text-base border-2 border-gray-200 rounded-lg sm:rounded-xl bg-white"
                                       placeholder=" "
                                       required
                                       autocomplete="additional-name" />
                                <label for="googleMiddleName" class="floating-label">
                                    <i class="fas fa-user"></i>
                                    <span>Middle Name</span>
                                </label>
                            </div>
                        </div>

                        <!-- Last Name -->
                        <div class="space-y-1.5 sm:space-y-2">
                            <div class="relative">
                                <input type="text" 
                                       name="LastName" 
                                       id="googleLastName"
                                       class="floating-input w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm sm:text-base border-2 border-gray-200 rounded-lg sm:rounded-xl bg-white"
                                       placeholder=" "
                                       required
                                       autocomplete="family-name" />
                                <label for="googleLastName" class="floating-label">
                                    <i class="fas fa-user"></i>
                                    <span>Last Name</span>
                                </label>
                            </div>
                        </div>

                        <!-- Suffix -->
                        <div class="space-y-1.5 sm:space-y-2">
                            <div class="relative">
                                <select name="Suffix" 
                                        id="googleSuffix"
                                        class="floating-input w-full px-3 sm:px-4 py-2.5 sm:py-3 text-sm sm:text-base border-2 border-gray-200 rounded-lg sm:rounded-xl bg-white appearance-none cursor-pointer"
                                        autocomplete="honorific-suffix">
                                    <option value="">None</option>
