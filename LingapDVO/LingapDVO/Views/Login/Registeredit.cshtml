@model UserAccountDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Account</title>
    <link rel="icon" type="image/x-icon" href="~/Icon/lingaplogo.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
</head>
<body class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-100 p-4">
    <div class="w-full max-w-2xl">
        <div class="bg-white rounded-2xl shadow-2xl p-6 lg:p-8 border border-white/20 backdrop-blur-sm">
            <!-- Updated Header -->
            <div class="text-center mb-6 lg:mb-8">
                <h1 class="text-2xl lg:text-3xl font-bold bg-gradient-to-r from-gray-800 to-gray-600 bg-clip-text text-transparent mb-2">
                    Edit Account
                </h1>
                <p class="text-gray-600 text-sm">Update your account information</p>
            </div>

            <form asp-action="Registeredit" method="post" enctype="multipart/form-data" id="editForm" class="space-y-4 lg:space-y-5">

                <!-- Hidden field for user ID -->
                <input type="hidden" name="Id" value="@ViewBag.Id" />

                <!-- Username & Email in Horizontal Layout -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 lg:gap-6">
                    <!-- Username Field -->
                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-gray-700">
                            Username
                        </label>
                        <div class="relative">
                            <input asp-for="Username"
                                   type="text"
                                   class="w-full px-4 py-3 lg:py-3.5 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-green-500 focus:ring-2 focus:ring-green-200 transition-all duration-200 bg-white"
                                   placeholder="Enter username"
                                   required
                                   autocomplete="username"
                                   id="username"
                                   value="@ViewBag.Username">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 transition-all duration-200 pointer-events-none bg-white px-1 hidden">
                                <i class="fas fa-user mr-2 text-crimson-500"></i>Enter username
                            </span>
                        </div>
                        <span asp-validation-for="Username" class="text-red-500 text-xs"></span>
                    </div>

                    <!-- Email Field -->
                    <div class="space-y-2">
                        <label class="block text-sm font-semibold text-gray-700">
                            Email
                        </label>
                        <div class="relative">
                            <input asp-for="Email"
                                   type="email"
                                   class="w-full px-4 py-3 lg:py-3.5 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-green-500 focus:ring-2 focus:ring-green-200 transition-all duration-200 bg-white"
                                   placeholder="Enter email"
                                   required
                                   autocomplete="email"
                                   id="email"
                                   value="@ViewBag.Email">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 transition-all duration-200 pointer-events-none bg-white px-1 hidden">
                                <i class="fas fa-envelope mr-2 text-crimson-500"></i>Enter email
                            </span>
                        </div>
                        <span asp-validation-for="Email" class="text-red-500 text-xs"></span>
                    </div>
                </div>

                <!-- Change Password Section (Optional) -->
                <div class="bg-gray-50 rounded-xl p-4 border border-gray-200">
                    <div class="flex items-center justify-between mb-3">
                        <h3 class="text-sm font-semibold text-gray-700">Change Password (Optional)</h3>
                        <button type="button" id="togglePasswordSection" class="text-blue-600 hover:text-blue-800 text-sm font-medium">
                            <i class="fas fa-edit mr-1"></i>Change Password
                        </button>
                    </div>

                    <div id="passwordSection" class="hidden space-y-4">
                        <!-- New Password & Confirm Password in Horizontal Layout -->
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 lg:gap-6">
                            <!-- New Password Field -->
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">
                                    New Password
                                </label>
                                <div class="relative">
                                    <input asp-for="Password"
                                           type="password"
                                           class="w-full px-4 py-3 lg:py-3.5 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-green-500 focus:ring-2 focus:ring-green-200 transition-all duration-200 bg-white pr-12"
                                           placeholder="Enter new password"
                                           autocomplete="new-password"
                                           id="newPassword">
                                    <button type="button" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none" id="toggleNewPassword">
                                        <i class="fas fa-eye text-sm"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="text-red-500 text-xs"></span>
                            </div>

                            <!-- Confirm New Password Field -->
                            <div class="space-y-2">
                                <label class="block text-sm font-semibold text-gray-700">
                                    Confirm New Password
                                </label>
                                <div class="relative">
                                    <input type="password"
                                           name="ConfirmNewPassword"
                                           class="w-full px-4 py-3 lg:py-3.5 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-green-500 focus:ring-2 focus:ring-green-200 transition-all duration-200 bg-white pr-12"
                                           placeholder="Confirm new password"
                                           autocomplete="new-password"
                                           id="confirmNewPassword">
                                    <button type="button" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none" id="toggleConfirmNewPassword">
                                        <i class="fas fa-eye text-sm"></i>
                                    </button>
                                </div>
                                <div id="passwordMatch" class="text-xs mt-1 hidden transition-all duration-300"></div>
                            </div>
                        </div>

                        <!-- Password Requirements Tooltip -->
                        <div id="passwordTooltip" class="hidden bg-blue-50 border border-blue-200 rounded-xl p-3 text-xs text-blue-700 transition-all duration-300">
                            <p class="font-semibold mb-2">Password Requirements:</p>
                            <ul class="space-y-1">
                                <li id="rule-length" class="flex items-center gap-2">
                                    <i class="fas fa-circle text-red-500 text-xs"></i>
                                    <span>At least 8 characters</span>
                                </li>
                                <li id="rule-uppercase" class="flex items-center gap-2">
                                    <i class="fas fa-circle text-red-500 text-xs"></i>
                                    <span>One uppercase letter</span>
                                </li>
                                <li id="rule-lowercase" class="flex items-center gap-2">
                                    <i class="fas fa-circle text-red-500 text-xs"></i>
                                    <span>One lowercase letter</span>
                                </li>
                                <li id="rule-number" class="flex items-center gap-2">
                                    <i class="fas fa-circle text-red-500 text-xs"></i>
                                    <span>One number</span>
                                </li>
                                <li id="rule-symbol" class="flex items-center gap-2">
                                    <i class="fas fa-circle text-red-500 text-xs"></i>
                                    <span>One special character</span>
                                </li>
                            </ul>
                            <div id="passwordRequirementError" class="hidden mt-3 p-2 bg-red-50 border border-red-200 rounded-lg text-red-700">
                                <i class="fas fa-exclamation-triangle mr-2"></i>
                                <span class="font-medium">Please meet all password requirements above</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- reCAPTCHA -->
                <div class="bg-gray-50 rounded-xl p-3 border border-gray-200 flex justify-center">
                    <div class="g-recaptcha mx-auto" data-sitekey="6Lfdj1orAAAAAGDqwcRDBkTCHoXYx9mLDeCn7kwV"></div>
                </div>

                <!-- Submit & Action Buttons -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                    <button type="button" id="cancelButton" class="w-full bg-gray-500 hover:bg-gray-600 text-white py-3 lg:py-3.5 rounded-xl font-semibold text-sm lg:text-base shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-300">
                        <i class="fas fa-times mr-2"></i>Cancel
                    </button>
                    <button type="submit" class="w-full bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white py-3 lg:py-3.5 rounded-xl font-semibold text-sm lg:text-base shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-300 group" id="updateButton">
                        <span class="flex items-center justify-center gap-2">
                            <span>Update Account</span>
                            <i class="fas fa-save group-hover:scale-110 transition-transform duration-200"></i>
                        </span>
                    </button>
                </div>

                <!-- Links -->
                <div class="text-center space-y-2 pt-2">
                    <p class="text-gray-500 text-xs lg:text-sm">
                        <a href="/Dashboard" class="text-blue-600 hover:text-blue-800 font-semibold transition-colors duration-200">Back to Dashboard</a>
                    </p>
                </div>
            </form>
        </div>
    </div>

    <!-- Success Modal -->
    <div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-3xl shadow-2xl overflow-hidden bg-gradient-to-br from-white to-green-50">
                <div class="modal-body p-6 text-center">
                    <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-check text-green-600 text-3xl"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-800 mb-2">Update Successful!</h3>
                    <p class="text-gray-600 mb-6">Your account information has been updated successfully.</p>
                    <div class="bg-gray-50 rounded-xl p-4 border border-gray-200">
                        <button id="proceedToDashboard" class="w-full bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white py-3 rounded-xl font-semibold text-base shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-300">
                            Back to Dashboard
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        let successModal = null;
        let isPasswordSectionVisible = false;

        document.addEventListener('DOMContentLoaded', function() {
            // Initialize Bootstrap modal
            const successModalElement = document.getElementById('successModal');
            if (successModalElement) {
                successModal = new bootstrap.Modal(successModalElement, {
                    backdrop: 'static',
                    keyboard: false
                });
            }

            // Auto-show success modal if redirected with success parameter
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('success') === 'true') {
                setTimeout(() => {
                    showSuccessModal();
                }, 500);
            }

            // Toggle password section visibility
            const togglePasswordSection = document.getElementById('togglePasswordSection');
            const passwordSection = document.getElementById('passwordSection');

            if (togglePasswordSection && passwordSection) {
                togglePasswordSection.addEventListener('click', function() {
                    isPasswordSectionVisible = !isPasswordSectionVisible;
                    if (isPasswordSectionVisible) {
                        passwordSection.classList.remove('hidden');
                        togglePasswordSection.innerHTML = '<i class="fas fa-times mr-1"></i>Cancel Password Change';
                        togglePasswordSection.classList.remove('text-blue-600');
                        togglePasswordSection.classList.add('text-red-600');
                    } else {
                        passwordSection.classList.add('hidden');
                        togglePasswordSection.innerHTML = '<i class="fas fa-edit mr-1"></i>Change Password';
                        togglePasswordSection.classList.remove('text-red-600');
                        togglePasswordSection.classList.add('text-blue-600');
                        // Clear password fields when hiding
                        document.getElementById('newPassword').value = '';
                        document.getElementById('confirmNewPassword').value = '';
                    }
                });
            }

            // Password toggle functionality for password fields
            setupPasswordToggle('toggleNewPassword', 'newPassword');
            setupPasswordToggle('toggleConfirmNewPassword', 'confirmNewPassword');

            function setupPasswordToggle(toggleId, inputId) {
                const toggle = document.getElementById(toggleId);
                const input = document.getElementById(inputId);

                if (toggle && input) {
                    toggle.addEventListener('click', function() {
                        const type = input.getAttribute('type') === 'password' ? 'text' : 'password';
                        input.setAttribute('type', type);
                        this.innerHTML = type === 'password' ? '<i class="fas fa-eye text-sm"></i>' : '<i class="fas fa-eye-slash text-sm"></i>';
                    });
                }
            }

            // Password validation rules
            const rules = {
                length: /.{8,}/,
                uppercase: /[A-Z]/,
                lowercase: /[a-z]/,
                number: /[0-9]/,
                symbol: /[^A-Za-z0-9]/
            };

            // Password requirements validation
            const passwordTooltip = document.getElementById('passwordTooltip');
            const passwordRequirementError = document.getElementById('passwordRequirementError');
            const newPasswordInput = document.getElementById('newPassword');

            function validatePasswordRequirements() {
                if (!newPasswordInput) return false;
                const val = newPasswordInput.value;

                let allRequirementsMet = true;

                Object.entries(rules).forEach(([key, regex]) => {
                    const el = document.getElementById(`rule-${key}`);
                    if (!el) return;
                    const icon = el.querySelector("i");
                    if (regex.test(val)) {
                        icon.classList.replace("text-red-500", "text-green-500");
                        el.classList.add("text-green-600", "font-medium");
                    } else {
                        icon.classList.replace("text-green-500", "text-red-500");
                        el.classList.remove("text-green-600", "font-medium");
                        allRequirementsMet = false;
                    }
                });

                // Show/hide requirement error
                if (val.length > 0 && !allRequirementsMet) {
                    passwordRequirementError.classList.remove('hidden');
                } else {
                    passwordRequirementError.classList.add('hidden');
                }

                if (document.activeElement === newPasswordInput && val.length > 0) {
                    passwordTooltip?.classList.remove('hidden');
                }

                return allRequirementsMet;
            }

            function areAllPasswordRequirementsMet() {
                if (!newPasswordInput) return true; // Return true if not changing password
                const val = newPasswordInput.value;

                // If password field is empty, requirements are met (not changing password)
                if (val === '') return true;

                return Object.values(rules).every(regex => regex.test(val));
            }

            // Password match validation
            const matchIndicator = document.getElementById('passwordMatch');
            const confirmNewPasswordInput = document.getElementById('confirmNewPassword');

            async function validatePasswordMatch() {
                if (!matchIndicator || !newPasswordInput || !confirmNewPasswordInput) return true;

                const password = newPasswordInput.value;
                const confirmPassword = confirmNewPasswordInput.value;

                await new Promise(resolve => setTimeout(resolve, 10));

                // If both fields are empty, no error
                if (password === '' && confirmPassword === '') {
                    matchIndicator.classList.add('hidden');
                    confirmNewPasswordInput.classList.remove('border-red-500', 'border-green-500');
                    return true;
                }

                // If only one field is filled, show error
                if ((password === '' && confirmPassword !== '') || (password !== '' && confirmPassword === '')) {
                    confirmNewPasswordInput.classList.remove('border-green-500');
                    confirmNewPasswordInput.classList.add('border-red-500');
                    matchIndicator.classList.remove('hidden');
                    matchIndicator.innerHTML = '<i class="fas fa-times-circle text-red-500"></i> <span class="text-red-500 font-medium">Please fill both password fields</span>';
                    return false;
                }

                if (password === confirmPassword) {
                    confirmNewPasswordInput.classList.remove('border-red-500');
                    confirmNewPasswordInput.classList.add('border-green-500');
                    matchIndicator.classList.remove('hidden');
                    matchIndicator.innerHTML = '<i class="fas fa-check-circle text-green-600"></i> <span class="text-green-600 font-medium">Passwords match</span>';
                    return true;
                } else {
                    confirmNewPasswordInput.classList.remove('border-green-500');
                    confirmNewPasswordInput.classList.add('border-red-500');
                    matchIndicator.classList.remove('hidden');
                    matchIndicator.innerHTML = '<i class="fas fa-times-circle text-red-500"></i> <span class="text-red-500 font-medium">Passwords do not match</span>';
                    return false;
                }
            }

            // Event listeners for password validation
            if (newPasswordInput) {
                newPasswordInput.addEventListener('input', function() {
                    validatePasswordRequirements();
                    if (confirmNewPasswordInput && confirmNewPasswordInput.value) {
                        validatePasswordMatch();
                    }
                });
                newPasswordInput.addEventListener('focus', () => {
                    if (newPasswordInput.value.length > 0) {
                        passwordTooltip?.classList.remove('hidden');
                    }
                });
                newPasswordInput.addEventListener('blur', () => {
                    setTimeout(() => {
                        if (!newPasswordInput.matches(':focus')) {
                            passwordTooltip?.classList.add('hidden');
                        }
                    }, 200);
                });
            }

            if (confirmNewPasswordInput) {
                confirmNewPasswordInput.addEventListener('input', function() {
                    validatePasswordMatch();
                });
            }

            // Cancel button
            const cancelButton = document.getElementById('cancelButton');
            if (cancelButton) {
                cancelButton.addEventListener('click', function() {
                    if (confirm('Are you sure you want to cancel? Any unsaved changes will be lost.')) {
                        window.location.href = '/Dashboard';
                    }
                });
            }

            // Form submission handler
            const editForm = document.getElementById('editForm');
            if (editForm) {
                editForm.addEventListener('submit', async function(event) {
                    event.preventDefault();

                    // Check if reCAPTCHA is available
                    if (typeof grecaptcha !== 'undefined') {
                        const recaptchaResponse = grecaptcha.getResponse();
                        if (!recaptchaResponse) {
                            alert('Please complete the reCAPTCHA verification.');
                            return false;
                        }
                    }

                    // Validate password requirements if changing password
                    const isChangingPassword = newPasswordInput && newPasswordInput.value !== '';
                    if (isChangingPassword) {
                        const passwordRequirementsMet = areAllPasswordRequirementsMet();
                        if (!passwordRequirementsMet) {
                            passwordTooltip.classList.remove('hidden');
                            passwordRequirementError.classList.remove('hidden');
                            alert('Please meet all password requirements before submitting.');
                            return false;
                        }

                        const passwordsMatch = await validatePasswordMatch();
                        if (!passwordsMatch) {
                            alert('Please ensure both new passwords match before submitting.');
                            return false;
                        }
                    }

                    // Show loading state
                    const updateButton = document.getElementById('updateButton');
                    const originalButtonText = updateButton.innerHTML;
                    if (updateButton) {
                        updateButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating...';
                        updateButton.disabled = true;
                    }

                    try {
                        const formData = new FormData(editForm);

                        const response = await fetch(editForm.action, {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        const result = await response.json();

                        if (result.success) {
                            showSuccessModal();
                        } else {
                            if (result.errors) {
                                alert('Update failed: ' + Array.from(result.errors).join('\n'));
                            } else if (result.message) {
                                alert('Update failed: ' + result.message);
                            } else {
                                alert('Update failed. Please try again.');
                            }

                            updateButton.innerHTML = originalButtonText;
                            updateButton.disabled = false;
                        }
                    } catch (error) {
                                                alert('An error occurred during update. Please try again.');
                        updateButton.innerHTML = originalButtonText;
                        updateButton.disabled = false;
                    }
                });
            }

            // Success modal buttons
            const proceedToDashboardBtn = document.getElementById('proceedToDashboard');
            if (proceedToDashboardBtn) {
                proceedToDashboardBtn.addEventListener('click', function() {
                    if (successModal) {
                        successModal.hide();
                    }
                    window.location.href = '/Dashboard';
                });
            }
        });

        function showSuccessModal() {
            if (!successModal) {
                const successModalElement = document.getElementById('successModal');
                if (successModalElement) {
                    successModal = new bootstrap.Modal(successModalElement, {
                        backdrop: 'static',
                        keyboard: false
                    });
                } else {
                                        return;
                }
            }
            successModal.show();
        }
        window.showSuccessModal = showSuccessModal;
    </script>

    <style>
        .crimson-500 {
            color: #DC143C;
        }

        .crimson-600 {
            color: #b01030;
        }

        .bg-crimson-500 {
            background-color: #DC143C;
        }

        .bg-crimson-600 {
            background-color: #b01030;
        }

        .text-crimson-600 {
            color: #DC143C;
        }

        .hover\:text-crimson-700:hover {
            color: #b01030;
        }

        /* Password toggle button styles */
        #toggleNewPassword, #toggleConfirmNewPassword {
            background: none;
            border: none;
            cursor: pointer;
            padding: 0;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Custom scrollbar for modal */
        .modal-body::-webkit-scrollbar {
            width: 6px;
        }

        .modal-body::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        .modal-body::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 10px;
        }

            .modal-body::-webkit-scrollbar-thumb:hover {
                background: #a8a8a8;
            }

        /* Smooth transitions */
        .transition-all {
            transition: all 0.3s ease;
        }
    </style>
</body>
</html>