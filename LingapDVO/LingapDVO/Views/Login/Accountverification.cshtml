            // Parse PhilSys ID Front - Extract everything EXCEPT gender
            function parsePhilSysFront(text) {
                const lines = text.split('\n').map(line => line.trim()).filter(line => line);
                const linesUpper = lines.map(line => line.toUpperCase());

                let idNumber = "", lastName = "", firstName = "", middleName = "", suffix = "None", birthdate = "", city = "";

                // 🔄 USING NEW PRECISE ID NUMBER EXTRACTION
                console.log('🔍 Looking for ID number...');
                idNumber = extractIDNumber(lines, 'phil-id');

                // Validate the extracted ID number
                if (idNumber && !validateExtractedID(idNumber, 'phil-id')) {
