            if (!file) return;
            
            if (!this.validateFile(file)) return;
            
            // Store reference to file for use in reader callback
            const uploadedFile = file;
            this.frontIdFile = file;  // Store raw file object
            
            const reader = new FileReader();
            reader.onload = (e) => {
                this.frontIdImage = e.target.result;
                
                // Update preview
                document.getElementById('modal-preview-front').src = e.target.result;
                document.getElementById('front-upload-content').classList.add('hidden');
                document.getElementById('front-preview-content').classList.remove('hidden');
                document.getElementById('front-next-btn').disabled = false;
                
                // Also update the main form's file input
                const mainInput = document.getElementById('file-input-front');
                if (mainInput) {
                    const dt = new DataTransfer();
                    dt.items.add(uploadedFile);
                    mainInput.files = dt.files;
                }
                
                // Store in VerificationState - PASS BOTH base64 (preview) AND File object (API submission)
                // CRITICAL: File object is sent to API without any modification to preserve EXIF metadata
                if (typeof VerificationState !== 'undefined') {
                    VerificationState.setFrontId(e.target.result, uploadedFile);
                    console.log('✅ Front ID stored in VerificationState with RAW FILE:', uploadedFile.name, uploadedFile.size, 'bytes');
                }
            };
            reader.readAsDataURL(file);
