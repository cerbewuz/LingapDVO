                <!-- Footer -->
                <div class="modal-footer bg-gray-50 py-3 sm:py-4 px-4 sm:px-6 border-t-0 flex flex-col sm:flex-row gap-2 sm:gap-3">
                    <button type="button" class="w-full sm:w-auto order-2 sm:order-1 text-gray-600 hover:text-gray-800 px-4 sm:px-6 py-2 sm:py-2.5 rounded-xl font-medium text-sm sm:text-base transition-colors" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="button" id="retry-submit-btn" class="w-full sm:w-auto order-1 sm:order-2 bg-amber-500 hover:bg-amber-600 disabled:bg-gray-300 disabled:cursor-not-allowed text-white px-6 sm:px-8 py-2 sm:py-2.5 rounded-xl font-semibold text-sm sm:text-base shadow-md hover:shadow-lg transition-all duration-200" disabled onclick="RetryVerification.submitRetry()">
                        <i class="fas fa-shield-alt mr-2"></i> Verify Again
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Selfie Capture Modal for Retry -->
    <div class="modal fade" id="retrySelfieModal" tabindex="-1" aria-labelledby="retrySelfieModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
