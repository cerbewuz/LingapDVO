                        <div class="mb-3 text-start">
                            <label class="form-label fw-bold"><i class="fa-solid fa-shield-alt fa-lg me-2 cobalt-text"></i>Security Question</label>
                            <select asp-for="SecurityQuestions" class="form-control" required>
                                <option value="">Select a question</option>
                                <option value="What is your first pet's name?">What is your first pet's name?</option>
                                <option value="What is your mother's maiden name?">What is your mother's maiden name?</option>
                                <option value="What was your first school?">What was your first school?</option>
                            </select>
                            <span asp-validation-for="SecurityQuestions" class="text-danger"></span>
                        </div>

                        <div class="mb-3 text-start">
                            <label class="form-label fw-bold"><i class="fa-solid fa-key fa-lg me-2 cobalt-text"></i>Security Answer</label>
                            <input asp-for="Securityanswer" type="text" class="form-control" placeholder="Enter your answer" required>
                            <span asp-validation-for="Securityanswer" class="text-danger"></span>
                        </div>

                        <div class="mb-3 text-start">
                            <input type="checkbox" id="terms" required> I agree to the <a href="#" class="text-decoration-none cobalt-text" data-bs-toggle="modal" data-bs-target="#termsModal">terms and conditions</a>
                        </div>
                        <button type="submit" class="btn btn-cobalt w-100 py-2 fw-bold">Verify</button>

                        <!-- Modal -->
                        <div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                                <div class="modal-content shadow-lg rounded-4">
                                    <div class="modal-header bg-cobalt text-white rounded-top-4">
                                        <h5 class="modal-title fw-bold" id="termsModalLabel">Lingap Terms & Privacy Policy</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body p-4">

                                        <h6 class="fw-bold text-cobalt">1. Acceptance of Terms</h6>
                                        <p>By signing up for Lingap, you confirm that all information provided is accurate and that you have read, understood, and agreed to these Terms and our Privacy Policy.</p>

                                        <h6 class="fw-bold text-cobalt">2. Data Privacy & Protection</h6>
                                        <p>Lingap is committed to safeguarding your personal data. We comply with the <strong>Data Privacy Act of 2012 (RA 10173)</strong>. Your information will only be used to verify eligibility and for program coordination. We will never sell or misuse your data.</p>

                                        <h6 class="fw-bold text-cobalt">3. Purpose of Data Collection</h6>
                                        <ul>
                                            <li>Eligibility verification for Lingap programs</li>
                                            <li>Contact and follow-up regarding assistance</li>
                                            <li>Government or partner validation (as needed)</li>
                                        </ul>

                                        <h6 class="fw-bold text-cobalt">4. Account Integrity</h6>
                                        <p>Each individual is allowed <strong>one account only</strong>. Creating multiple accounts or submitting false documents may result in permanent disqualification.</p>


                                        <h6 class="fw-bold text-cobalt">5. Changes to Terms</h6>
                                        <p>Lingap reserves the right to update this policy at any time. All changes will be posted publicly, and continued use of the service implies agreement with updated terms.</p>

                                        <h6 class="fw-bold text-cobalt">6. Questions or Concerns</h6>
                                        <p>If you have any questions regarding your privacy, you may contact our support team at <a href="mailto:support@lingap.org">support@lingap.org</a>.</p>

                                    </div>
                                    <div class="modal-footer justify-content-between">
                                        <small class="text-muted">Last updated: May 2025</small>
                                        <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Close</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <style>
                            .text-cobalt {
                                color: #DC143C;
                            }

                            .bg-cobalt {
                                background-color: #DC143C;
                            }

                            .btn-cobalt {
                                background-color: #DC143C;
                                color: white;
                            }

                                .btn-cobalt:hover {
                                    background-color: #DC143C;
                                    color: white;
                                }

                            .rounded-top-4 {
                                border-top-left-radius: 1rem;
                                border-top-right-radius: 1rem;
                            }

                            .rounded-4 {
                                border-radius: 1rem;
                            }
                        </style>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Add this to your head section -->
    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@4/dist/tesseract.min.js"></script>
    <script>
        // Combined OCR and File Upload Functionality
        document.addEventListener('DOMContentLoaded', function() {
            // Get DOM elements
            const documentType = document.getElementById('document-type');
            const documentWarning = document.getElementById('document-warning');
            const uploadFront = document.getElementById('upload-area-front');
            const uploadBack = document.getElementById('upload-area-back');
            const fileFront = document.getElementById('file-input-front');
            const fileBack = document.getElementById('file-input-back');
            const imagePreview = document.getElementById('image-preview');
            const imagePreviewBack = document.getElementById('image-preview-back');
            const status = document.getElementById('ocr-status');
            const resultBox = document.getElementById('ocr-result');
            const progressBar = document.getElementById('progress-bar');
            const progress = document.getElementById('progress');
            const terms = document.getElementById('terms');

            // Track if OCR is enabled
            let ocrEnabled = false;

            // Handle document type selection
            documentType.addEventListener('change', function() {
                const selectedValue = this.value;

                if (selectedValue === 'phil-id' || selectedValue === 'driver-license') {
                    ocrEnabled = true;
                    uploadFront.classList.remove('disabled');
                    uploadBack.classList.remove('disabled');
                    documentWarning.style.display = 'none';
                    status.textContent = 'You can now upload ID images';
                } else {
                    ocrEnabled = false;
                    uploadFront.classList.add('disabled');
                    uploadBack.classList.add('disabled');
                    if (selectedValue) {
                        documentWarning.style.display = 'block';
                        status.textContent = 'OCR not available for selected document type';
                    } else {
                        documentWarning.style.display = 'none';
                        status.textContent = 'Select a document to begin';
                    }
                    resultBox.style.display = 'none';
                }
            });

            // Setup uploaders for both front and back
            setupUploader(uploadFront, fileFront, imagePreview, false);
            setupUploader(uploadBack, fileBack, imagePreviewBack, true);

            function setupUploader(uploadArea, fileInput, preview, isBack = false) {
                // Click handler
                uploadArea.addEventListener('click', () => {
                    if (!ocrEnabled) return;
                    fileInput.click();
                });

                // File input change handler
                fileInput.addEventListener('change', (event) => {
                    if (!ocrEnabled) return;
                    if (event.target.files.length) {
                        handleFileUpload(event.target.files[0], preview, uploadArea, isBack);
                    }
                });

                // Drag and drop handlers
                uploadArea.addEventListener('dragover', (e) => {
                    if (!ocrEnabled) return;
                    e.preventDefault();
                    uploadArea.classList.add('active');
                });

                uploadArea.addEventListener('dragleave', () => {
                    if (!ocrEnabled) return;
                    uploadArea.classList.remove('active');
                });

                uploadArea.addEventListener('drop', (e) => {
                    if (!ocrEnabled) return;
                    e.preventDefault();
                    uploadArea.classList.remove('active');

                    if (e.dataTransfer.files.length) {
                        fileInput.files = e.dataTransfer.files;
                        handleFileUpload(e.dataTransfer.files[0], preview, uploadArea, isBack);
                    }
                });
            }

            // Handle file upload and processing
            function handleFileUpload(file, preview, section, isBack) {
                if (!validateFile(file)) return;

                const reader = new FileReader();
                reader.onload = function(e) {
                    // Show image preview
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                    section.classList.add('active');

                    // Process with OCR if enabled
                    if (ocrEnabled) {
                        processImageWithOCR(preview, isBack);
                    }
                };
                reader.readAsDataURL(file);
            }

                    // Go Back button functionality
        goBackBtn.addEventListener('click', function() {
            window.history.back();
        });

            // Process image with OCR
            function processImageWithOCR(preview, isBack) {
                status.textContent = "Processing...";
                progressBar.style.display = 'block';
                progress.style.width = '0%';

                Tesseract.recognize(preview.src, 'eng', {
                    logger: m => {
                        if (m.status === 'recognizing text') {
                            progress.style.width = `${Math.round(m.progress * 100)}%`;
                        }
                    }
                }).then(({ data: { text } }) => {
                    status.textContent = "OCR completed!";
                    progressBar.style.display = 'none';

                    // Parse information based on document type
                    if (documentType.value === "driver-license") {
                        if (!isBack) {
                            parseDriverLicenseFront(text);
                        }
                    } else if (documentType.value === "phil-id") {
                        if (isBack) {
                            parsePhilSysBack(text);
                        } else {
                            parsePhilSysFront(text);
                        }
                    }

                }).catch(err => {
                    status.textContent = "Error: " + err.message;
                    progressBar.style.display = 'none';
                    console.error('OCR Error:', err);
                });
            }

            // Parse Driver's License Front
            function parseDriverLicenseFront(text) {
                const lines = text.split('\n').map(line => line.trim()).filter(line => line);

                let idNumber = "", lastName = "", firstName = "", middleName = "", birthdate = "", sex = "";

                // Find license number (format: X00-00-000000)
                for (const line of lines) {
                    const licenseMatch = line.match(/[A-Z0-9]{1,3}-[A-Z0-9]{2}-\d{6}/);
                    if (licenseMatch) {
                        idNumber = licenseMatch[0];
                        break;
                    }
                }

                // Find name (Lastname, Firstname MiddleName format)
                for (let i = 0; i < lines.length; i++) {
                    if (lines[i].includes(',')) {
                        const nameParts = lines[i].split(',');
                        if (nameParts.length >= 2) {
                            lastName = cleanName(nameParts[0]);
                            const firstMiddleParts = nameParts[1].trim().split(' ');
                            if (firstMiddleParts.length > 0) firstName = cleanName(firstMiddleParts[0]);
                            if (firstMiddleParts.length > 1) middleName = cleanName(firstMiddleParts.slice(1).join(' '));
                        }
                        break;
                    }
                }

                // Find birthdate
                for (const line of lines) {
                    const dateMatch = line.match(/\b\d{4}\/\d{2}\/\d{2}\b/);
                    if (dateMatch) {
                        const [year, month, day] = dateMatch[0].split('/');
                        birthdate = `${year}-${month}-${day}`;
                        break;
                    }
                }

                // Find gender
                for (const line of lines) {
                    const candidate = cleanSex(line);
                    if (candidate) {
                        sex = candidate;
                        break;
                    }
                }

                updateFormFields(idNumber, firstName, middleName, lastName, birthdate, sex);
            }

            // Parse PhilSys ID Front
            function parsePhilSysFront(text) {
                const lines = text.split('\n').map(line => line.trim()).filter(line => line);
                const linesUpper = lines.map(line => line.toUpperCase());

                let idNumber = "", lastName = "", firstName = "", middleName = "", birthdate = "";

                // Find ID number (format: 1234-5678-9012-3456)
                for (const line of lines) {
                    const idMatch = line.match(/\d{4}[-\s]?\d{4}[-\s]?\d{4}[-\s]?\d{4}/);
                    if (idMatch) {
                        idNumber = idMatch[0].replace(/\s+/g, "").replace(/-/g, "");
                        break;
                    }
                }

                // Find names
                for (let i = 0; i < linesUpper.length; i++) {
                    const line = linesUpper[i];
                    if (line.includes("APELYIDO") && !line.includes("GITNANG")) {
                        lastName = cleanName(lines[i + 1] || "");
                    }
                    if (line.includes("MGA PANGALAN") || line.includes("GIVEN NAMES")) {
                        firstName = cleanName(lines[i + 1] || "");
                    }
                    if (line.includes("GITNANG") || line.includes("MIDDLE NAME")) {
                        middleName = cleanName(lines[i + 1] || "");
                    }
                    if (line.includes("KAPANGANAKAN") || line.includes("PETSA") || line.includes("BIRTHDATE")) {
                        birthdate = cleanBirthdate(lines[i + 1] || "");
                    }
                }

                updateFormFields(idNumber, firstName, middleName, lastName, birthdate, "");
            }

            // Parse PhilSys ID Back (for gender)
            function parsePhilSysBack(text) {
                const lines = text.split('\n').map(line => line.trim()).filter(line => line);
                let sex = "";

                for (const line of lines) {
                    const candidate = cleanSex(line);
                    if (candidate) {
                        sex = candidate;
                        break;
                    }
                }

                if (sex) {
                    document.getElementById('sex').value = sex;
                    resultBox.style.display = "block";
                    resultBox.textContent = "Gender information extracted from ID back. Please verify.";
                }
            }

            // Helper functions
                 function cleanName(text) {
          if (!text) return "";
          return text
            .replace(/[^a-z\s]/gi, "")   // keep only letters + spaces
            .replace(/\s+/g, " ")        // normalize spaces
            .trim()
            .replace(/^[a-z]\s+/, "")    // remove stray single letter at start
            .replace(/\s+[a-z]$/, "")    // remove stray single letter at end
            .replace(/^\s*[a-z]\s*$/, ""); // if only a single letter, remove it
        }


            function cleanBirthdate(text) {
                if (!text) return "";
                // Try various date formats
                const dateMatch = text.match(/(\d{1,2})[\/\-\.](\d{1,2})[\/\-\.](\d{4})/);
                if (dateMatch) {
                    const [, month, day, year] = dateMatch;
                    return `${year}-${month.padStart(2, '0')}-${day.padStart(2, '0')}`;
                }
                return "";
            }

            function cleanSex(text) {
                const upper = text.toUpperCase();
                if (/MALE/.test(upper) || /\bM\b/.test(upper)) return "Male";
                if (/FEMALE/.test(upper) || /\bF\b/.test(upper)) return "Female";
                if (/LALAKI/.test(upper)) return "Male";
                if (/BABAE/.test(upper)) return "Female";
                return "";
            }

            function updateFormFields(idNumber, firstName, middleName, lastName, birthdate, sex) {
                if (idNumber) document.getElementById('idnumber').value = idNumber;
                if (firstName) document.getElementById('firstname').value = firstName.toUpperCase();
                if (middleName) document.getElementById('middlename').value = middleName.toUpperCase();
                if (lastName) document.getElementById('lastname').value = lastName.toUpperCase();
                if (birthdate) document.getElementById('birthdate').value = birthdate;
                if (sex) document.getElementById('sex').value = sex;

                // Show success message
                resultBox.style.display = "block";
                resultBox.textContent = "Information extracted from ID. Please verify the details.";
            }

            function validateFile(file) {
                const validTypes = ['image/jpeg', 'image/png', 'image/jpg'];
                const maxSize = 5 * 1024 * 1024; // 5MB

                if (!validTypes.includes(file.type)) {
                    alert('Please upload a valid image file (JPEG or PNG).');
                    return false;
                }

                if (file.size > maxSize) {
                    alert('File size exceeds 5MB limit.');
                    return false;
                }

                return true;
            }

            // Form validation
            document.getElementById('registrationForm').addEventListener('submit', function(e) {
                if (!terms.checked) {
                    alert('You must agree to the terms and conditions.');
                    e.preventDefault();
                    return;
                }
            });
        });
    </script>

    <script>
        // Profile picture preview
        document.getElementById('imageUpload').addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('imagePreview').src = e.target.result;
                    document.getElementById('imagePreview').style.display = 'block';
                }
                reader.readAsDataURL(file);
            }
        });



        // ID Upload functionality
        document.addEventListener('DOMContentLoaded', function() {
            const frontIdUpload = document.getElementById('file-input-front');
            const backIdUpload = document.getElementById('file-input-back');
            const frontIdPreview = document.getElementById('image-preview');
            const backIdPreview = document.getElementById('image-preview-back');
            const frontIdSection = document.getElementById('upload-area-front');
            const backIdSection = document.getElementById('upload-area-back');

            // Front ID upload
            frontIdUpload.addEventListener('change', function(event) {
                handleFileUpload(event.target.files[0], frontIdPreview, frontIdSection);
            });

            // Back ID upload
            backIdUpload.addEventListener('change', function(event) {
                handleFileUpload(event.target.files[0], backIdPreview, backIdSection);
            });

            // Drag and drop functionality
            setupDragAndDrop(frontIdSection, frontIdUpload, frontIdPreview);
            setupDragAndDrop(backIdSection, backIdUpload, backIdPreview);

            function handleFileUpload(file, previewElement, section) {
                if (file) {
                    if (!validateFile(file)) return;

                    section.classList.add('active');
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        previewElement.src = e.target.result;
                        previewElement.style.display = 'block';
                    }
                    reader.readAsDataURL(file);
                }
            }

            function setupDragAndDrop(section, fileInput, preview) {
                section.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    section.classList.add('active');
                });

                section.addEventListener('dragleave', () => {
                    section.classList.remove('active');
                });

                section.addEventListener('drop', (e) => {
                    e.preventDefault();
                    section.classList.remove('active');

                    if (e.dataTransfer.files.length) {
                        fileInput.files = e.dataTransfer.files;
                        handleFileUpload(e.dataTransfer.files[0], preview, section);
                    }
                });
            }

            function validateFile(file) {
                const validTypes = ['image/jpeg', 'image/png', 'image/jpg'];
                const maxSize = 5 * 1024 * 1024; // 5MB

                if (!validTypes.includes(file.type)) {
                    alert('Please upload a valid image file (JPEG or PNG).');
                    return false;
                }

                if (file.size > maxSize) {
                    alert('File size exceeds 5MB limit.');
                    return false;
                }

                return true;
            }
        });

        // Form validation
        document.getElementById('registrationForm').addEventListener('submit', function(e) {
            const password = document.getElementById('password');
            const confirmPassword = document.getElementById('confirmPassword');
            const terms = document.getElementById('terms');

            // Check password match
            if (password.value !== confirmPassword.value) {
                alert('Passwords do not match.');
                e.preventDefault();
                return;
            }

            // Check terms agreement
            if (!terms.checked) {
                alert('You must agree to the terms and conditions.');
                e.preventDefault();
                return;
            }
        });
    </script>
</body>
