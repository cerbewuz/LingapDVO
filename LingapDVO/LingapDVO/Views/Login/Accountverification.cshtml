    <script>
        // ═══════════════════════════════════════════════════════════════
        // 🔐 REGISTERED USER INFORMATION FROM SERVER
        // ═══════════════════════════════════════════════════════════════
        const registeredUserInfo = {
            firstName: '@ViewBag.RegisteredFirstName',
            middleName: '@ViewBag.RegisteredMiddleName',
            lastName: '@ViewBag.RegisteredLastName',
            suffix: '@ViewBag.RegisteredSuffix'
        };

        document.addEventListener('DOMContentLoaded', function() {
            console.log('Registered User Info:', registeredUserInfo);

            // Initialize animations
            setTimeout(() => {
                document.querySelectorAll('.fade-in').forEach(el => {
                    el.classList.add('loaded');
                });
                document.querySelectorAll('.scale-in').forEach(el => {
                    el.classList.add('visible');
                });
                document.querySelectorAll('.slide-down').forEach(el => {
                    el.classList.add('visible');
                });
            }, 100);

            // Get DOM elements
            const documentType = document.getElementById('document-type');
            const documentWarning = document.getElementById('document-warning');
            const uploadFront = document.getElementById('upload-area-front');
            const uploadBack = document.getElementById('upload-area-back');
            const fileFront = document.getElementById('file-input-front');
            const fileBack = document.getElementById('file-input-back');
            const imagePreview = document.getElementById('image-preview');
            const imagePreviewBack = document.getElementById('image-preview-back');
            const status = document.getElementById('ocr-status');
            const resultBox = document.getElementById('ocr-result');
            const progressBar = document.getElementById('progress-bar');
            const progress = document.getElementById('progress');
            const terms = document.getElementById('terms');

            // Davao City Verification Elements
            const davaoVerification = document.getElementById('davao-verification');
            const davaoResultIcon = document.getElementById('davao-result-icon');
            const davaoResultTitle = document.getElementById('davao-result-title');
            const davaoResultMessage = document.getElementById('davao-result-message');
            const davaoStatusBadge = document.getElementById('davao-status-badge');

            // Wrong ID Type Warning Element
            let wrongIdTypeWarning = document.getElementById('wrong-id-warning');

            // Form fields to disable when license is invalid
            const formFields = [
                'idnumber', 'phonenumber', 'lastname', 'firstname', 'middlename',
                'sex', 'birthdate', 'BlkLotStreet', 'SubVill', 'Barangay', 'District',
                'SecurityQuestions', 'Securityanswer'
            ];

            // Track if OCR is enabled
            let ocrEnabled = false;

            // Go Back button functionality
            const goBackBtn = document.getElementById('goBackBtn');
            goBackBtn.addEventListener('click', function() {
                window.history.back();
            });

            // Hide wrong ID type warning
            function hideWrongIdTypeWarning() {
                if (wrongIdTypeWarning) {
                    wrongIdTypeWarning.classList.add('hidden');
                }
            }

            // ═══════════════════════════════════════════════════════════════
            // 🔢 PRECISE ID NUMBER EXTRACTION FUNCTIONS
            // ═══════════════════════════════════════════════════════════════

            // Enhanced Driver's License Number Extraction
            function extractDriverLicenseNumber(lines) {
                console.log('🔍 Starting precise Driver\'s License number extraction...');

                const patterns = [
                    // Standard format: X00-00-000000 (most common)
                    /[A-Z][0-9]{2}-[0-9]{2}-[0-9]{6}/,
                    // With optional spaces: X00 00 000000
                    /[A-Z][0-9]{2}\s+[0-9]{2}\s+[0-9]{6}/,
                    // Extended format with letters in middle part
                    /[A-Z0-9]{1,3}-[A-Z0-9]{2}-[0-9]{6}/,
                    // Without dashes: X0000000000
                    /[A-Z][0-9]{10}/,
                    // License number with "NO" prefix
                    /NO[:\-\s]*([A-Z0-9\-]+)/i,
                    // License number near "LICENSE" keyword
                    /LICENSE[:\-\s]*([A-Z0-9\-]+)/i
                ];

                let bestMatch = "";
                let highestConfidence = 0;

                for (let i = 0; i < lines.length; i++) {
                    const line = lines[i].trim();
                    const upperLine = line.toUpperCase();

                    // Skip lines that are too short or obviously not license numbers
                    if (line.length < 8 || line.length > 20) continue;

                    // Check if line contains license-related keywords
                    const hasLicenseContext = upperLine.includes('LICENSE') ||
                                            upperLine.includes('NO.') ||
                                            upperLine.includes('NUMBER') ||
                                            upperLine.includes('DRIVER');

                    for (const pattern of patterns) {
                        const matches = line.match(pattern);
                        if (matches) {
                            let candidate = matches[0];
                            let confidence = 0;

                            // Calculate confidence score
                            if (pattern === patterns[0]) confidence = 100; // Standard format
                            else if (pattern === patterns[1]) confidence = 90; // With spaces
                            else if (pattern === patterns[2]) confidence = 85; // Extended format
                            else confidence = 70; // Other patterns

                            // Boost confidence if near license context
                            if (hasLicenseContext) confidence += 15;

                            // Boost confidence if on a line by itself or with minimal other text
                            const otherTextRatio = (line.replace(candidate, '').trim().length / line.length);
                            if (otherTextRatio < 0.3) confidence += 10;

                            console.log(`  ✓ Pattern match: "${candidate}" (confidence: ${confidence}%)`);

                            if (confidence > highestConfidence) {
                                highestConfidence = confidence;
                                bestMatch = candidate;
                            }
                        }
                    }
                }

                // Post-process the best match
                if (bestMatch) {
                    // Standardize format: ensure dashes and proper case
                    let processed = bestMatch.toUpperCase();

                    // Remove spaces and convert to standard dash format
                    processed = processed.replace(/\s+/g, '');

                    // If it's a continuous string without dashes, insert them
                    if (/^[A-Z][0-9]{10}$/.test(processed)) {
                        processed = processed.substring(0, 3) + '-' +
                                   processed.substring(3, 5) + '-' +
                                   processed.substring(5);
                    }

                    // Ensure proper dash placement for other formats
                    processed = processed.replace(/([A-Z0-9]{3})([A-Z0-9]{2})([A-Z0-9]{6})/, '$1-$2-$3');

                    console.log(`✅ Final Driver's License Number: "${processed}" (confidence: ${highestConfidence}%)`);
                    return processed;
                }

                console.log('❌ No valid Driver\'s License number found');
                return "";
            }

            // Enhanced PhilSys (National ID) Number Extraction
            function extractPhilSysNumber(lines) {
                console.log('🔍 Starting precise PhilSys number extraction...');

                const patterns = [
                    // Standard 16-digit with dashes: 0000-0000-0000-0000
                    /\b\d{4}-\d{4}-\d{4}-\d{4}\b/,
                    // Standard 16-digit with spaces: 0000 0000 0000 0000
                    /\b\d{4}\s\d{4}\s\d{4}\s\d{4}\b/,
                    // Continuous 16 digits
                    /\b\d{16}\b/,
                    // With PSN prefix
                    /PSN[:\-\s]*(\d{4}[-\s]?\d{4}[-\s]?\d{4}[-\s]?\d{4})/i,
                    // With PhilSys prefix
                    /PHILSYS[:\-\s]*(\d{4}[-\s]?\d{4}[-\s]?\d{4}[-\s]?\d{4})/i,
                    // Near "ID NUMBER" or similar labels
                    /(?:ID|IDENTIFICATION|NUMBER|NO\.?)[:\-\s]*(\d{4}[-\s]?\d{4}[-\s]?\d{4}[-\s]?\d{4})/i,
                    // 12-digit variants (some older IDs)
                    /\b\d{4}[-\s]?\d{4}[-\s]?\d{4}\b/,
                    // Any sequence of 12-16 digits (fallback)
                    /\b\d{12,16}\b/
                ];

                let bestMatch = "";
                let highestConfidence = 0;

                for (let i = 0; i < lines.length; i++) {
                    const line = lines[i].trim();
                    const upperLine = line.toUpperCase();

                    // Skip lines that are obviously not ID numbers
                    if (line.length < 10) continue;

                    // Check for PhilSys context
                    const hasPhilSysContext = upperLine.includes('PHILSYS') ||
                                            upperLine.includes('NATIONAL ID') ||
                                            upperLine.includes('IDENTIFICATION') ||
                                            upperLine.includes('PSN') ||
                                            upperLine.includes('UNIQUE REFERENCE');

                    for (const pattern of patterns) {
                        const matches = line.match(pattern);
                        if (matches) {
                            let candidate = matches[1] || matches[0]; // Use captured group if available
                            let confidence = 0;

                            // Calculate confidence based on pattern
                            if (pattern === patterns[0]) confidence = 100; // Standard dashed format
                            else if (pattern === patterns[1]) confidence = 95; // Standard spaced format
                            else if (pattern === patterns[2]) confidence = 90; // Continuous 16 digits
                            else if (pattern === patterns[3] || pattern === patterns[4]) confidence = 85; // With prefix
                            else if (pattern === patterns[5]) confidence = 80; // Near ID label
                            else if (pattern === patterns[6]) confidence = 70; // 12-digit variant
                            else confidence = 60; // Fallback pattern

                            // Boost confidence if near PhilSys context
                            if (hasPhilSysContext) confidence += 20;

                            // Penalize if line contains obvious non-ID text
                            const cleanLine = line.replace(candidate, '').toUpperCase();
                            if (cleanLine.includes('DATE') || cleanLine.includes('BIRTH') ||
                                cleanLine.includes('NAME') || cleanLine.includes('ADDRESS')) {
                                confidence -= 15;
                            }

                            console.log(`  ✓ Pattern match: "${candidate}" (confidence: ${confidence}%)`);

                            if (confidence > highestConfidence && confidence >= 70) {
                                highestConfidence = confidence;
                                bestMatch = candidate;
                            }
                        }
                    }
                }

                // Post-process and validate the best match
                if (bestMatch) {
                    let processed = bestMatch.replace(/\s+/g, ''); // Remove all spaces

                    // Standardize to 16-digit format with dashes
                    if (/^\d{16}$/.test(processed)) {
                        processed = processed.substring(0, 4) + '-' +
                                   processed.substring(4, 8) + '-' +
                                   processed.substring(8, 12) + '-' +
                                   processed.substring(12, 16);
                    } else if (/^\d{12}$/.test(processed)) {
                        // Handle 12-digit format (some older IDs)
                        processed = processed.substring(0, 4) + '-' +
                                   processed.substring(4, 8) + '-' +
                                   processed.substring(8, 12);
                    }

                    // Additional validation: Check digit patterns
                    const isValidFormat = /^\d{4}-\d{4}-\d{4}-\d{4}$/.test(processed) ||
                                        /^\d{4}-\d{4}-\d{4}$/.test(processed);

                    if (isValidFormat) {
                        console.log(`✅ Final PhilSys Number: "${processed}" (confidence: ${highestConfidence}%)`);
                        return processed;
                    }
                }

                console.log('❌ No valid PhilSys number found');
                return "";
            }

            // OCR Error Correction for ID Numbers
            function correctOCRIdErrors(idNumber) {
                if (!idNumber) return "";

                let corrected = idNumber.toUpperCase();

                // Common OCR errors in ID numbers
                const corrections = [
                    // Number to letter corrections (context-specific)
                    { pattern: /(?<=[A-Z])0(?=\d)/g, replacement: 'O' }, // O → 0 between letter and number
                    { pattern: /(?<=\d)0(?=[A-Z])/g, replacement: 'O' }, // O → 0 between number and letter
                    { pattern: /^0(?=\d)/g, replacement: 'O' }, // O → 0 at start before number
                    { pattern: /1(?=[A-Z])/g, replacement: 'I' }, // 1 → I before letter
                    { pattern: /(?<=[A-Z])1/g, replacement: 'I' }, // 1 → I after letter
                    { pattern: /5/g, replacement: 'S' }, // 5 → S (common in license numbers)
                    { pattern: /8/g, replacement: 'B' }, // 8 → B
                    { pattern: /6/g, replacement: 'G' }, // 6 → G

                    // Letter to number corrections
                    { pattern: /O(?=\d\d-)/g, replacement: '0' }, // O → 0 at start of license
                    { pattern: /(?<=-\d\d)O/g, replacement: '0' }, // O → 0 in middle of license
                    { pattern: /I(?=\d)/g, replacement: '1' }, // I → 1 before number
                    { pattern: /(?<=\d)I/g, replacement: '1' }, // I → 1 after number
                    { pattern: /S(?=\d)/g, replacement: '5' }, // S → 5 before number
                    { pattern: /B(?=\d)/g, replacement: '8' }, // B → 8 before number

                    // Format normalization
                    { pattern: /\s+/g, replacement: '' }, // Remove spaces
                    { pattern: /[^\w\-]/g, replacement: '' }, // Remove invalid characters
                ];

                corrections.forEach(({ pattern, replacement }) => {
                    corrected = corrected.replace(pattern, replacement);
                });

                return corrected;
            }

            // Main ID Number Extraction Function (called from OCR processing)
            function extractIDNumber(lines, idType) {
                console.log(`🎯 Extracting ${idType} number...`);

                let idNumber = "";

                if (idType === 'driver-license') {
                    idNumber = extractDriverLicenseNumber(lines);
                } else if (idType === 'phil-id') {
                    idNumber = extractPhilSysNumber(lines);
                }

                // Apply OCR error correction
                if (idNumber) {
                    const corrected = correctOCRIdErrors(idNumber);
                    if (corrected !== idNumber) {
                        console.log(`🔄 OCR Correction: "${idNumber}" → "${corrected}"`);
                        idNumber = corrected;
                    }
                }

                return idNumber;
            }

            // Enhanced validation for extracted ID numbers
            function validateExtractedID(idNumber, idType) {
                if (!idNumber) return false;

                if (idType === 'driver-license') {
                    // Validate Driver's License format: X00-00-000000
                    return /^[A-Z0-9]{1,3}-[A-Z0-9]{2}-\d{6}$/.test(idNumber);
                } else if (idType === 'phil-id') {
                    // Validate PhilSys format: 0000-0000-0000-0000 or 0000-0000-0000
                    return /^\d{4}-\d{4}-\d{4}(-\d{4})?$/.test(idNumber);
                }

                return false;
            }

            // ═══════════════════════════════════════════════════════════════
            // 🔍 NAME MATCHING VALIDATION FUNCTIONS
            // ═══════════════════════════════════════════════════════════════

            // Normalize name for comparison (handles Philippine naming conventions)
            function normalizeName(name) {
                if (!name) return "";

                return name.toLowerCase()
                    .trim()
                    .replace(/\./g, '') // Remove periods
                    .replace(/\s+/g, ' ') // Normalize spaces
                    // Handle Filipino compound names
                    .replace(/dela cruz/g, 'delacruz')
                    .replace(/de la cruz/g, 'delacruz')
                    .replace(/delos santos/g, 'delossantos')
                    .replace(/de los santos/g, 'delossantos')
                    .replace(/delos reyes/g, 'delosreyes')
                    .replace(/de los reyes/g, 'delosreyes')
                    .replace(/dela rosa/g, 'delarosa')
                    .replace(/de la rosa/g, 'delarosa')
                    .replace(/dela paz/g, 'delapaz')
                    .replace(/de la paz/g, 'delapaz')
                    .replace(/del rosario/g, 'delrosario')
                    .replace(/de guzman/g, 'deguzman')
                    .replace(/san jose/g, 'sanjose')
                    .replace(/san juan/g, 'sanjuan')
                    .replace(/santa maria/g, 'santamaria')
                    .replace(/santa cruz/g, 'santacruz');
            }

            // Check if extracted name matches registered name
            function validateNameMatch(extractedFirstName, extractedMiddleName, extractedLastName, extractedSuffix) {
                // Normalize all names for comparison
                const regFirst = normalizeName(registeredUserInfo.firstName);
                const regMiddle = normalizeName(registeredUserInfo.middleName);
                const regLast = normalizeName(registeredUserInfo.lastName);
                const regSuffix = normalizeName(registeredUserInfo.suffix === 'None' ? '' : registeredUserInfo.suffix);

                const extFirst = normalizeName(extractedFirstName);
                const extMiddle = normalizeName(extractedMiddleName);
                const extLast = normalizeName(extractedLastName);
                const extSuffix = normalizeName(extractedSuffix === 'None' ? '' : extractedSuffix);

                console.log('Name Validation:');
                console.log('Registered:', { regFirst, regMiddle, regLast, regSuffix });
                console.log('Extracted:', { extFirst, extMiddle, extLast, extSuffix });

                // ═══════════════════════════════════════════════════════════════
                // 🇵🇭 PHILIPPINE ID NAME MATCHING LOGIC
                // ═══════════════════════════════════════════════════════════════
                // Handle different name arrangements in Philippine IDs
                // - Driver's License: "LastName, FirstName(s) MiddleName"
                // - National ID: Separate fields for each component
                // - Multiple given names: "Jetlance Marshall" could be in firstName or split

                // Last name must always match (required)
                const lastNameMatch = regLast === extLast;

                // Combine all given names from both registration and extraction
                const regFullGivenNames = [regFirst, regMiddle].filter(n => n).join(' ');
                const extFullGivenNames = [extFirst, extMiddle].filter(n => n).join(' ');

                // Strategy 1: Exact match on combined given names
                let givenNamesMatch = regFullGivenNames === extFullGivenNames;

                // Strategy 2: Check if all registered name parts exist in extracted name
                if (!givenNamesMatch && regFullGivenNames && extFullGivenNames) {
                    const regParts = regFullGivenNames.split(/\s+/);
                    const extParts = extFullGivenNames.split(/\s+/);

                    // Check if all registered name parts are found in extracted parts
                    givenNamesMatch = regParts.every(regPart =>
                        extParts.some(extPart => extPart === regPart || extPart.startsWith(regPart.charAt(0)))
                    );
                }

                // Strategy 3: Reverse check - extracted parts in registered
                if (!givenNamesMatch && regFullGivenNames && extFullGivenNames) {
                    const regParts = regFullGivenNames.split(/\s+/);
                    const extParts = extFullGivenNames.split(/\s+/);

                    givenNamesMatch = extParts.every(extPart =>
                        regParts.some(regPart => regPart === extPart || regPart.startsWith(extPart.charAt(0)))
                    );
                }

                // Strategy 4: First name exact match + flexible middle name
                if (!givenNamesMatch) {
                    const firstNameMatch = regFirst === extFirst;
                    const middleNameMatch = !regMiddle || !extMiddle || regMiddle === extMiddle ||
                                            regMiddle.startsWith(extMiddle.charAt(0)) ||
                                            extMiddle.startsWith(regMiddle.charAt(0));
                    givenNamesMatch = firstNameMatch && middleNameMatch;
                }

                // Suffix matching (optional)
                const suffixMatch = regSuffix === extSuffix || (!regSuffix && !extSuffix);

                const isMatch = lastNameMatch && givenNamesMatch;

                console.log('Match Results:', {
                    lastNameMatch,
                    givenNamesMatch,
                    regFullGivenNames,
                    extFullGivenNames,
                    suffixMatch,
                    overallMatch: isMatch
                });

                return {
                    isMatch: isMatch,
                    details: {
                        firstName: givenNamesMatch,
                        middleName: givenNamesMatch,
                        lastName: lastNameMatch,
                        suffix: suffixMatch
                    }
                };
            }

            // Show name mismatch modal
            function showNameMismatchModal(extractedFirstName, extractedMiddleName, extractedLastName, extractedSuffix) {
                // Format registered name
                const registeredName = [
                    registeredUserInfo.firstName,
                    registeredUserInfo.middleName,
                    registeredUserInfo.lastName,
                    registeredUserInfo.suffix !== 'None' ? registeredUserInfo.suffix : ''
                ].filter(n => n).join(' ');

                // Format extracted name
                const extractedName = [
                    extractedFirstName,
                    extractedMiddleName,
                    extractedLastName,
                    extractedSuffix !== 'None' ? extractedSuffix : ''
                ].filter(n => n).join(' ');

                // Update modal content
                document.getElementById('registered-name-display').textContent = registeredName.toUpperCase();
                document.getElementById('extracted-name-display').textContent = extractedName.toUpperCase();

                // Show modal using Bootstrap
                const modal = new bootstrap.Modal(document.getElementById('nameMismatchModal'));
                modal.show();

                // Disable form submission
                disableFormFields();
            }

            // Clear uploaded files after mismatch (called from modal button)
            function clearUploadedFilesAfterMismatch() {
                clearUploadedFiles();
                enableFormFields();
                resultBox.classList.add('hidden');
                davaoVerification.classList.add('hidden');
                status.innerHTML = '<i class="fas fa-info-circle mr-2"></i>Please upload your valid ID that matches your registered name';
            }

            // Show wrong ID type warning
            function showWrongIdTypeWarning(expectedType, detectedType) {
                if (wrongIdTypeWarning) {
                    const message = document.getElementById('wrong-id-message');
                    message.textContent = `You selected ${expectedType} but uploaded a ${detectedType}. Please upload the correct document type.`;
                    wrongIdTypeWarning.classList.remove('hidden');
                }

                // Clear uploaded files and reset
                clearUploadedFiles();
                resultBox.classList.add('hidden');
                davaoVerification.classList.add('hidden');
                status.innerHTML = '<i class="fas fa-exclamation-triangle mr-2"></i>Wrong document type detected. Please upload the correct document.';
            }

            // Handle document type selection
            documentType.addEventListener('change', function() {
                const selectedValue = this.value;

                // Hide any existing wrong ID warning when changing document type
                hideWrongIdTypeWarning();

                if (selectedValue === 'phil-id' || selectedValue === 'driver-license') {
                    ocrEnabled = true;
                    uploadFront.classList.remove('disabled');
                    uploadBack.classList.remove('disabled');
                    documentWarning.classList.add('hidden');
                    status.innerHTML = '<i class="fas fa-info-circle mr-2"></i>You can now upload ID images';

                    // Show Davao verification for both driver's license and national ID
                    davaoVerification.classList.add('hidden');
                    enableFormFields();
                } else {
                    ocrEnabled = false;
                    uploadFront.classList.add('disabled');
                    uploadBack.classList.add('disabled');
                    if (selectedValue) {
                        documentWarning.classList.remove('hidden');
                        status.innerHTML = '<i class="fas fa-info-circle mr-2"></i>OCR not available for selected document type';
                    } else {
                        documentWarning.classList.add('hidden');
                        status.innerHTML = '<i class="fas fa-info-circle mr-2"></i>Select a document to begin';
                    }
                    resultBox.classList.add('hidden');
                    davaoVerification.classList.add('hidden');
                    enableFormFields();
                }
            });

            // Setup uploaders for both front and back
            setupUploader(uploadFront, fileFront, imagePreview, false);
            setupUploader(uploadBack, fileBack, imagePreviewBack, true);

            function setupUploader(uploadArea, fileInput, preview, isBack = false) {
                // Click handler
                uploadArea.addEventListener('click', () => {
                    if (!ocrEnabled) return;
                    fileInput.click();
                });

                // File input change handler
                fileInput.addEventListener('change', (event) => {
                    if (!ocrEnabled) return;
                    if (event.target.files.length) {
                        handleFileUpload(event.target.files[0], preview, uploadArea, isBack);
                    }
                });

                // Drag and drop handlers
                uploadArea.addEventListener('dragover', (e) => {
                    if (!ocrEnabled) return;
                    e.preventDefault();
                    uploadArea.classList.add('dragover');
                });

                uploadArea.addEventListener('dragleave', () => {
                    if (!ocrEnabled) return;
                    uploadArea.classList.remove('dragover');
                });

                uploadArea.addEventListener('drop', (e) => {
                    if (!ocrEnabled) return;
                    e.preventDefault();
                    uploadArea.classList.remove('dragover');

                    if (e.dataTransfer.files.length) {
                        fileInput.files = e.dataTransfer.files;
                        handleFileUpload(e.dataTransfer.files[0], preview, uploadArea, isBack);
                    }
                });
            }

            // Handle file upload and processing
            function handleFileUpload(file, preview, section, isBack) {
                if (!validateFile(file)) return;

                const reader = new FileReader();
                reader.onload = function(e) {
                    // Show image preview
                    preview.src = e.target.result;
                    preview.classList.remove('hidden');
                    section.classList.add('active');

                    // Wait for image to load before processing with OCR
                    if (ocrEnabled) {
                        // Ensure the preview image is fully loaded
                        if (preview.complete && preview.naturalHeight !== 0) {
                            // Already loaded
                            processImageWithOCR(preview, isBack);
                        } else {
                            // Wait for load event
                            preview.onload = function() {
                                // Small delay to ensure DOM is fully updated
                                setTimeout(() => {
                                    processImageWithOCR(preview, isBack);
                                }, 100);
                            };
                            preview.onerror = function() {
                                console.error('Failed to load preview image');
                                status.innerHTML = '<i class="fas fa-exclamation-triangle mr-2 text-red-600"></i><span class="font-semibold">Failed to load the image. Please try again.</span>';
                            };
                        }
                    }
                };
                reader.readAsDataURL(file);
            }

            // Optimized image preprocessing - Simple, Fast, Effective
            function preprocessImage(imageElement) {
                return new Promise((resolve, reject) => {
                    function processImage() {
                        try {
                            // Validate image
                            const width = imageElement.naturalWidth || imageElement.width;
                            const height = imageElement.naturalHeight || imageElement.height;

                            if (!width || !height || width === 0 || height === 0) {
                                reject(new Error('Invalid image dimensions'));
                                return;
                            }

                            console.log('Processing image:', width, 'x', height);

                            // Create canvas with optimal size for OCR (1500-2000px on longest side)
                            const maxDim = Math.max(width, height);
                            let scale = 1;

                            if (maxDim < 1000) {
                                scale = 1500 / maxDim; // Upscale small images
                            } else if (maxDim > 2500) {
                                scale = 2000 / maxDim; // Downscale large images
                            }

                            const canvas = document.createElement('canvas');
                            canvas.width = Math.round(width * scale);
                            canvas.height = Math.round(height * scale);

                            const ctx = canvas.getContext('2d', {
                                willReadFrequently: true,
                                alpha: false
                            });

                            // Use high-quality scaling
                            ctx.imageSmoothingEnabled = true;
                            ctx.imageSmoothingQuality = 'high';

                            // Draw scaled image
                            ctx.drawImage(imageElement, 0, 0, canvas.width, canvas.height);

                            // Get image data
                            const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                            const pixels = imageData.data;

                            // Simple and effective: Grayscale + Contrast boost
                            for (let i = 0; i < pixels.length; i += 4) {
                                // Convert to grayscale using luminosity method
                                const gray = 0.299 * pixels[i] + 0.587 * pixels[i + 1] + 0.114 * pixels[i + 2];

                                // Apply contrast enhancement (simple S-curve)
                                let enhanced = gray;
                                if (gray < 128) {
                                    enhanced = gray * 0.8; // Darken dark areas slightly
                                } else {
                                    enhanced = gray + (255 - gray) * 0.2; // Brighten light areas
                                }

                                // Clamp to valid range
                                enhanced = Math.max(0, Math.min(255, enhanced));

                                pixels[i] = pixels[i + 1] = pixels[i + 2] = enhanced;
                            }

                            // Put processed data back
                            ctx.putImageData(imageData, 0, 0);

                            // Return as high-quality data URL
                            const result = canvas.toDataURL('image/jpeg', 0.92);
                            console.log('Preprocessing complete');
                            resolve(result);

                        } catch (error) {
                            console.error('Preprocessing error:', error);
                            reject(error);
                        }
                    }

                    // Wait for image load
                    if (imageElement.complete && imageElement.naturalHeight !== 0) {
                        processImage();
                    } else {
                        imageElement.onload = processImage;
                        imageElement.onerror = () => reject(new Error('Failed to load image'));
                    }
                });
            }

            // Process image with OCR
            async function processImageWithOCR(preview, isBack) {
                status.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Preprocessing image...';
                progressBar.classList.remove('hidden');
                progress.style.width = '15%';

                // Hide any previous wrong ID warning
                hideWrongIdTypeWarning();

                try {
                    // Preprocess image for better OCR
                    const processedImage = await preprocessImage(preview);

                    status.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Extracting text...';
                    progress.style.width = '30%';

                    const { data: { text } } = await Tesseract.recognize(processedImage, 'eng', {
                        logger: m => {
                            if (m.status === 'recognizing text') {
                                const ocrProgress = 30 + (m.progress * 60);
                                progress.style.width = `${Math.round(ocrProgress)}%`;
                            }
                        },
                        tessedit_pageseg_mode: Tesseract.PSM.SPARSE_TEXT,
                        tessedit_ocr_engine_mode: Tesseract.OEM.LSTM_ONLY,
                        tessedit_char_whitelist: 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzÑñ0123456789-/., '
                    });

                    console.log('OCR Text extracted:', text.substring(0, 200));

                    status.innerHTML = '<i class="fas fa-check-circle mr-2"></i>OCR completed!';
                    progress.style.width = '100%';
                    setTimeout(() => progressBar.classList.add('hidden'), 1000);

                    // First, detect what type of ID was actually uploaded
                    const detectedIdType = detectIdType(text);
                    const selectedIdType = documentType.value;

                    // Check if the uploaded ID matches the selected type
                    if (detectedIdType && detectedIdType !== selectedIdType) {
                        const expectedName = selectedIdType === 'driver-license' ? 'Driver\'s License' : 'National ID';
                        const detectedName = detectedIdType === 'driver-license' ? 'Driver\'s License' : 'National ID';
                        showWrongIdTypeWarning(expectedName, detectedName);
                        return;
                    }

                    // If ID type matches or couldn't be detected, proceed with parsing
                    if (selectedIdType === "driver-license") {
                        if (!isBack) {
                            parseDriverLicenseFront(text);
                        }
                    } else if (selectedIdType === "phil-id") {
                        if (isBack) {
                            parsePhilSysBack(text);
                        } else {
                            parsePhilSysFront(text);
                        }
                    }

                } catch (err) {
                    console.error('OCR Error:', err);
                    progressBar.classList.add('hidden');

                    let errorMessage = 'An error occurred while processing the ID. Please try again.';

                    // Provide more specific error messages
                    if (err.message && err.message.includes('Invalid image dimensions')) {
                        errorMessage = 'Unable to read the image. Please ensure the image is valid and try again.';
                    } else if (err.message && err.message.includes('Failed to load image')) {
                        errorMessage = 'Failed to load the image. Please try uploading a different image.';
                    } else if (err.name === 'IndexSizeError') {
                        errorMessage = 'Image processing error. Please try uploading a different image.';
                    }

                    status.innerHTML = `<i class="fas fa-exclamation-triangle mr-2 text-red-600"></i><span class="font-semibold">${errorMessage}</span>`;
                }
            }

            // Detect what type of ID was uploaded based on text content
            function detectIdType(text) {
                const upperText = text.toUpperCase();

                // Driver's License indicators
                const driverLicenseIndicators = [
                    'DRIVER\'S LICENSE',
                    'DRIVER LICENSE',
                    'LICENSE TO DRIVE',
                    'NON-PROFESSIONAL',
                    'PROFESSIONAL',
                    'LAND TRANSPORTATION OFFICE',
                    'LTO',
                    'RESTRICTION',
                    'CONDITIONS'
                ];

                // National ID indicators
                const nationalIdIndicators = [
                    'PHILSYS',
                    'PHILIPPINE IDENTIFICATION',
                    'NATIONAL ID',
                    'PAG-ASA',
                    'PHILIPPINE ID',
                    'PSA',
                    'PHILSYS NUMBER',
                    'UNIQUE REFERENCE NUMBER'
                ];

                let driverLicenseScore = 0;
                let nationalIdScore = 0;

                // Score for Driver's License
                driverLicenseIndicators.forEach(indicator => {
                    if (upperText.includes(indicator)) {
                        driverLicenseScore++;
                    }
                });

                // Score for National ID
                nationalIdIndicators.forEach(indicator => {
                    if (upperText.includes(indicator)) {
                        nationalIdScore++;
                    }
                });

                // Determine the type based on scores
                if (driverLicenseScore > nationalIdScore && driverLicenseScore >= 2) {
                    return 'driver-license';
                } else if (nationalIdScore > driverLicenseScore && nationalIdScore >= 2) {
                    return 'phil-id';
                }

                // If scores are equal or unclear, try additional heuristics
                if (driverLicenseScore === nationalIdScore) {
                    // Check for specific patterns unique to each type
                    if (upperText.includes('LICENSE NO') || upperText.includes('EXPIRY') || upperText.includes('RESTRICTION')) {
                        return 'driver-license';
                    } else if (upperText.includes('PHILSYS') || upperText.includes('UNIQUE REFERENCE') || upperText.includes('PSA')) {
                        return 'phil-id';
                    }
                }

                // If still unclear, return null
                return null;
            }

            // Extract suffix from name text
            function extractSuffix(nameText) {
                if (!nameText) return { cleanedName: "", suffix: "None" };

                const suffixPatterns = [
                    { pattern: /\b(JR\.?|JUNIOR)\b/i, value: "Jr." },
                    { pattern: /\b(SR\.?|SENIOR)\b/i, value: "Sr." },
                    { pattern: /\bII\b/, value: "II" },
                    { pattern: /\bIII\b/, value: "III" },
                    { pattern: /\bIV\b/, value: "IV" },
                    { pattern: /\bV\b/, value: "V" }
                ];

                for (const { pattern, value } of suffixPatterns) {
                    const match = nameText.match(pattern);
                    if (match) {
                        // Remove the suffix from the name
                        const cleanedName = nameText.replace(pattern, '').trim();
                        return { cleanedName, suffix: value };
                    }
                }

                return { cleanedName: nameText, suffix: "None" };
            }

            // Parse Driver's License Front
            function parseDriverLicenseFront(text) {
                console.log('🔍 Starting Driver\'s License extraction...');
                const lines = text.split('\n').map(line => line.trim()).filter(line => line);
                console.log('Total lines:', lines.length);
                console.log('OCR Text:', text);

                let idNumber = "", lastName = "", firstName = "", middleName = "", suffix = "None", birthdate = "", sex = "", city = "";

                // 🔄 USING NEW PRECISE ID NUMBER EXTRACTION
                console.log('🔍 Looking for license number...');
                idNumber = extractIDNumber(lines, 'driver-license');

                // Validate the extracted license number
                if (idNumber && !validateExtractedID(idNumber, 'driver-license')) {
                    console.log('⚠️ Extracted license number failed validation, trying fallback...');
                    idNumber = "";
                }

                // If still no ID number, use fallback method
                if (!idNumber) {
                    console.log('🔄 Using fallback license number extraction...');
                    for (const line of lines) {
                        const licenseMatch = line.match(/[A-Z0-9]{1,3}-[A-Z0-9]{2}-\d{6}/);
                        if (licenseMatch) {
                            idNumber = licenseMatch[0];
                            console.log(`✅ License number found (fallback): "${idNumber}"`);
                            break;
                        }
                    }
                }

                // Find name (Lastname, Firstname MiddleName format)
                // Driver's License format: "DELA CRUZ, JUAN CARLOS JR"
                console.log('🔍 Looking for name (format: LastName, FirstName(s) MiddleName)...');
                for (let i = 0; i < lines.length; i++) {
                    if (lines[i].includes(',')) {
                        console.log(`✓ Found comma at line ${i}: "${lines[i]}"`);
                        const nameParts = lines[i].split(',');
                        if (nameParts.length >= 2) {
                            console.log(`  - Part 1 (Last Name): "${nameParts[0]}"`);
                            console.log(`  - Part 2 (First/Middle): "${nameParts[1]}"`);

                            // Extract suffix from last name
                            const lastNameResult = extractSuffix(nameParts[0]);
