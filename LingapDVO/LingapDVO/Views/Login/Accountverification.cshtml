    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // User's name will be read from Tab 1 form fields (Personal Info) for name matching validation
        // This function gets the current values from the form fields
        window.getUserEnteredName = function() {
            return {
                firstName: (document.getElementById('firstname')?.value || '').trim(),
                middleName: (document.getElementById('middlename')?.value || '').trim(),
                lastName: (document.getElementById('lastname')?.value || '').trim(),
                suffix: (document.getElementById('suffix')?.value || '').trim()
            };
        };

        // ═══════════════════════════════════════════════════════════════
        // BIRTHDATE VALIDATION - Must be at least 16 years old
        // ═══════════════════════════════════════════════════════════════
        window.validateBirthdate = function(input) {
            const errorDiv = document.getElementById('birthdate-error');
            const birthdate = new Date(input.value);
            const today = new Date();
            
            // Calculate age
            let age = today.getFullYear() - birthdate.getFullYear();
            const monthDiff = today.getMonth() - birthdate.getMonth();
            const dayDiff = today.getDate() - birthdate.getDate();
            
            // Adjust age if birthday hasn't occurred this year
            if (monthDiff < 0 || (monthDiff === 0 && dayDiff < 0)) {
                age--;
            }
            
            if (age < 16) {
                if (errorDiv) {
                    errorDiv.textContent = 'You must be at least 16 years old to register.';
                    errorDiv.classList.remove('hidden');
                }
                input.classList.add('border-red-500');
                input.classList.remove('border-gray-200', 'border-green-500');
                input.setCustomValidity('You must be at least 16 years old');
                return false;
            } else {
                if (errorDiv) {
                    errorDiv.classList.add('hidden');
                }
                input.classList.remove('border-red-500');
                input.classList.add('border-green-500');
                input.setCustomValidity('');
                return true;
            }
        };

        // ═══════════════════════════════════════════════════════════════
        // PHONE NUMBER VALIDATION - Must be exactly 11 digits
        // ═══════════════════════════════════════════════════════════════
        window.validatePhoneNumber = function(input) {
            const errorDiv = document.getElementById('phonenumber-error');
            const value = input.value.replace(/[^0-9]/g, ''); // Remove non-digits
            
            input.value = value; // Update input with only digits
            
            if (value.length !== 11) {
                if (errorDiv) {
                    errorDiv.textContent = 'Phone number must be exactly 11 digits.';
                    errorDiv.classList.remove('hidden');
                }
                input.classList.add('border-red-500');
                input.classList.remove('border-gray-200', 'border-green-500');
                input.setCustomValidity('Phone number must be exactly 11 digits');
                return false;
            } else if (!value.startsWith('09')) {
                if (errorDiv) {
                    errorDiv.textContent = 'Phone number must start with 09.';
                    errorDiv.classList.remove('hidden');
                }
                input.classList.add('border-red-500');
                input.classList.remove('border-gray-200', 'border-green-500');
                input.setCustomValidity('Phone number must start with 09');
                return false;
            } else {
                if (errorDiv) {
                    errorDiv.classList.add('hidden');
                }
                input.classList.remove('border-red-500');
                input.classList.add('border-green-500');
                input.setCustomValidity('');
                return true;
            }
        };

        // ═══════════════════════════════════════════════════════════════
        // GENDER VALIDATION - Compare with API response
        // ═══════════════════════════════════════════════════════════════
        window.validateGenderMatch = function(userGender, apiGender) {
            if (!userGender || !apiGender) return { isValid: true, message: '' };
            
            // Normalize gender values
            const normalizedUserGender = userGender.toUpperCase().trim();
            const normalizedApiGender = apiGender.toUpperCase().trim();
            
            // Map variations to standard values
            const maleVariants = ['MALE', 'M', 'LALAKI'];
            const femaleVariants = ['FEMALE', 'F', 'BABAE'];
            
            const userIsMale = maleVariants.includes(normalizedUserGender);
            const userIsFemale = femaleVariants.includes(normalizedUserGender);
            const apiIsMale = maleVariants.includes(normalizedApiGender);
            const apiIsFemale = femaleVariants.includes(normalizedApiGender);
            
            if ((userIsMale && apiIsMale) || (userIsFemale && apiIsFemale)) {
                return { isValid: true, message: 'Gender matches ID document.' };
            } else if ((userIsMale && apiIsFemale) || (userIsFemale && apiIsMale)) {
                return { 
                    isValid: false, 
                    message: `Gender mismatch: You selected "${userGender}" but your ID shows "${apiGender}". Please correct your gender selection.`
                };
            }
            
            return { isValid: true, message: '' }; // Unable to determine, allow to proceed
        };

        // Store API-extracted gender for validation
        window.apiExtractedGender = '';

        // Pass user ID for verification status polling
        window.currentUserId = @(ViewBag.UserId ?? "null");

        // ID Analyzer API v2 is handled server-side via /api/IdAnalyzer endpoints
        // No client-side API keys needed - all requests go through the backend

        // ═══════════════════════════════════════════════════════════════
        // TAB 1 VALIDATION - Ensure all required fields are filled
        // ═══════════════════════════════════════════════════════════════
        window.validateTab1AndProceed = function() {
            const requiredFields = [
                { id: 'lastname', label: 'Last Name' },
                { id: 'firstname', label: 'First Name' },
                { id: 'gender', label: 'Gender' },
                { id: 'civil-status', label: 'Civil Status' },
                { id: 'phonenumber', label: 'Phone Number' },
                { id: 'birthdate', label: 'Date of Birth' },
                { id: 'blklotstreet', label: 'Block/Lot/Street' },
                { id: 'barangay', label: 'Barangay' }
                // Note: Suffix is optional, not included in validation
            ];

            const missingFields = [];
            const validationErrors = [];

            for (const field of requiredFields) {
                const element = document.getElementById(field.id);
                if (!element || !element.value || element.value.trim() === '') {
                    missingFields.push(field.label);
                }
            }

            // Validate phone number (must be exactly 11 digits starting with 09)
            const phoneInput = document.getElementById('phonenumber');
            if (phoneInput && phoneInput.value) {
                const phoneValue = phoneInput.value.replace(/[^0-9]/g, '');
                if (phoneValue.length !== 11) {
                    validationErrors.push('Phone number must be exactly 11 digits');
                } else if (!phoneValue.startsWith('09')) {
                    validationErrors.push('Phone number must start with 09');
                }
            }

            // Validate birthdate (must be at least 16 years old)
            const birthdateInput = document.getElementById('birthdate');
            if (birthdateInput && birthdateInput.value) {
                const birthdate = new Date(birthdateInput.value);
                const today = new Date();
                let age = today.getFullYear() - birthdate.getFullYear();
                const monthDiff = today.getMonth() - birthdate.getMonth();
                const dayDiff = today.getDate() - birthdate.getDate();
                
                if (monthDiff < 0 || (monthDiff === 0 && dayDiff < 0)) {
                    age--;
                }
                
                if (age < 16) {
                    validationErrors.push('You must be at least 16 years old to register');
                }
            }

            // Check Terms and Conditions checkbox
            const termsCheckbox = document.getElementById('terms');
            if (!termsCheckbox || !termsCheckbox.checked) {
                missingFields.push('Terms and Conditions (must be accepted)');
            }

            // Combine all errors
            let errorMessage = '';
            if (missingFields.length > 0) {
                errorMessage += 'Please complete the following required fields:\n• ' + missingFields.join('\n• ');
            }
            if (validationErrors.length > 0) {
                if (errorMessage) errorMessage += '\n\n';
                errorMessage += 'Validation errors:\n• ' + validationErrors.join('\n• ');
            }

            if (errorMessage) {
                alert(errorMessage);
                return;
            }

            // All validations passed - proceed to Tab 2
            WizardNav.goToTab(2);
        }

        // ═══════════════════════════════════════════════════════════════
        // Ñ/ñ CHARACTER SUPPORT - ACCOUNT VERIFICATION
        // ═══════════════════════════════════════════════════════════════
        // Frontend validation for Ñ/ñ in name fields during verification
        // ═══════════════════════════════════════════════════════════════

        document.addEventListener('DOMContentLoaded', function() {
            const firstnameInput = document.getElementById('firstname');
            const middlenameInput = document.getElementById('middlename');
            const lastnameInput = document.getElementById('lastname');

            // Helper function to detect Ñ/ñ characters
            function containsEnye(text) {
                return /[Ññ]/.test(text);
            }

            // Add Ñ/ñ detection to name fields
            [firstnameInput, middlenameInput, lastnameInput].forEach(input => {
                if (input) {
                    input.addEventListener('input', function() {
                        const value = this.value;
                        // Ñ/ñ characters are supported
                    });
                }
            });

            // ═══════════════════════════════════════════════════════════════════════════
            // PHONE NUMBER - Real-time validation (11 digits, numbers only)
            // ═══════════════════════════════════════════════════════════════════════════
            const phoneInput = document.getElementById('phonenumber');
            if (phoneInput) {
                // Prevent non-numeric input
                phoneInput.addEventListener('keypress', function(e) {
                    if (e.charCode < 48 || e.charCode > 57) {
                        e.preventDefault();
                    }
                });

                // Clean input on paste
                phoneInput.addEventListener('paste', function(e) {
                    e.preventDefault();
                    const pastedText = (e.clipboardData || window.clipboardData).getData('text');
                    const cleanedText = pastedText.replace(/[^0-9]/g, '').slice(0, 11);
                    this.value = cleanedText;
                    validatePhoneNumber(this);
                });

                // Validate on input
                phoneInput.addEventListener('input', function() {
                    this.value = this.value.replace(/[^0-9]/g, '').slice(0, 11);
                    validatePhoneNumber(this);
                });

                // Validate on blur
                phoneInput.addEventListener('blur', function() {
                    validatePhoneNumber(this);
                });
            }

            // ═══════════════════════════════════════════════════════════════════════════
            // BIRTHDATE - Set max date (must be at least 16 years old)
            // ═══════════════════════════════════════════════════════════════════════════
            const birthdateInput = document.getElementById('birthdate');
            if (birthdateInput) {
                // Set max date to 16 years ago
                const today = new Date();
                const maxDate = new Date(today.getFullYear() - 16, today.getMonth(), today.getDate());
                birthdateInput.max = maxDate.toISOString().split('T')[0];

                // Validate on change
                birthdateInput.addEventListener('change', function() {
                    validateBirthdate(this);
                });
            }

            // ═══════════════════════════════════════════════════════════════════════════
            // NOTE: Form submission validation is now consolidated in validateFinalSubmission()
            // which is called via onsubmit="return validateFinalSubmission()" on the form.
            // The duplicate addEventListener validation has been removed to avoid conflicts.
            // ═══════════════════════════════════════════════════════════════════════════
            
            // ═══════════════════════════════════════════════════════════════════════════
            // MODAL: Show verification requirements error
            // ═══════════════════════════════════════════════════════════════════════════
            window.showVerificationRequirementsModal = function(errors) {
                // Create modal if it doesn't exist
                let modal = document.getElementById('verificationRequirementsModal');
                if (!modal) {
                    modal = document.createElement('div');
                    modal.id = 'verificationRequirementsModal';
                    modal.className = 'modal fade';
                    modal.setAttribute('tabindex', '-1');
                    modal.setAttribute('aria-labelledby', 'verificationRequirementsModalLabel');
                    modal.setAttribute('aria-hidden', 'true');
                    modal.innerHTML = `
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content border-0 rounded-2xl shadow-2xl overflow-hidden">
                                <div class="modal-header bg-gradient-to-r from-red-500 to-red-600 text-white py-4 px-6 border-b-0">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 bg-white/30 rounded-full flex items-center justify-center">
                                            <i class="fas fa-exclamation-triangle text-white text-lg"></i>
                                        </div>
                                        <div>
                                            <h5 class="modal-title font-bold text-lg" id="verificationRequirementsModalLabel">Things You Need to Complete</h5>
                                            <p class="text-red-100 text-sm">Please complete all requirements</p>
                                        </div>
                                    </div>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body p-6">
                                    <div class="mb-4">
                                        <p class="text-gray-700 text-sm mb-4">Please complete these steps before submitting your information:</p>
                                        <ul id="requirements-error-list" class="space-y-2"></ul>
                                    </div>
                                    <div class="bg-blue-50 border border-blue-200 rounded-xl p-4">
                                        <div class="flex items-start gap-3">
                                            <i class="fas fa-info-circle text-blue-500 text-lg mt-0.5"></i>
                                            <div>
                                                <p class="text-blue-800 font-semibold text-sm mb-1">How to complete these steps:</p>
                                                <ol class="text-blue-700 text-xs space-y-1 list-decimal list-inside">
                                                    <li>Fill in all required information in the form</li>
                                                    <li>Click "Upload My ID" to upload photos of your ID (front & back)</li>
                                                    <li>Take a photo of yourself</li>
                                                    <li>Agree to Terms and Conditions</li>
                                                    <li>Click "Submit My Information" when done</li>
                                                </ol>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer bg-gray-50 py-4 px-6 border-t-0">
                                    <button type="button" class="w-full bg-gradient-to-r from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 text-white px-6 py-3 rounded-xl font-semibold shadow-md hover:shadow-lg transition-all duration-200" data-bs-dismiss="modal">
                                        I Understand
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                    document.body.appendChild(modal);
                }
                
                // Populate error list
                const errorList = modal.querySelector('#requirements-error-list');
                errorList.innerHTML = errors.map(error => `
                    <li class="flex items-start gap-2 text-red-700 text-sm">
                        <i class="fas fa-times-circle text-red-500 mt-0.5"></i>
                        <span>${error}</span>
                    </li>
                `).join('');
                
                // Show modal
                const bsModal = new bootstrap.Modal(modal);
                bsModal.show();
            };
            
            // ═══════════════════════════════════════════════════════════════════════════
            // REAL-TIME CHECKLIST UPDATE & BUTTON ENABLE/DISABLE
            // ═══════════════════════════════════════════════════════════════════════════
            // Updates the checklist UI and enables/disables the submit button in real-time
            // ═══════════════════════════════════════════════════════════════════════════
            
            window.updateVerificationChecklist = function() {
                const verifyBtn = document.getElementById('verify-account-btn');
                let allRequirementsMet = true;
                
                // Helper function to update checklist item
                function updateCheckItem(elementId, isComplete) {
                    const element = document.getElementById(elementId);
                    if (element) {
                        const icon = element.querySelector('i');
                        if (isComplete) {
                            element.classList.remove('text-gray-500');
                            element.classList.add('text-green-600');
                            if (icon) {
                                icon.classList.remove('fa-circle');
                                icon.classList.add('fa-check-circle');
                            }
                        } else {
                            element.classList.remove('text-green-600');
                            element.classList.add('text-gray-500');
                            if (icon) {
                                icon.classList.remove('fa-check-circle');
                                icon.classList.add('fa-circle');
                            }
                            allRequirementsMet = false;
                        }
                    }
                    return isComplete;
                }
                
                // Check 1: All required fields filled (ID Number excluded - auto-filled from API)
                const requiredFieldIds = ['lastname', 'firstname', 'gender', 'civil-status', 'phonenumber', 'birthdate', 'blklotstreet', 'barangay'];
                let allFieldsFilled = true;
                for (const fieldId of requiredFieldIds) {
                    const field = document.getElementById(fieldId);
                    if (!field || !field.value || field.value.trim() === '') {
                        allFieldsFilled = false;
                        break;
                    }
                }
                updateCheckItem('check-fields', allFieldsFilled);
                
                // Check 2: Front ID uploaded
                const frontIdInput = document.getElementById('file-input-front');
                const hasFrontId = (frontIdInput && frontIdInput.files && frontIdInput.files.length > 0) || 
                                   (typeof VerificationState !== 'undefined' && VerificationState.frontIdUploaded);
                updateCheckItem('check-front-id', hasFrontId);
                
                // Check 3: Back ID uploaded
                const backIdInput = document.getElementById('file-input-back');
                const hasBackId = (backIdInput && backIdInput.files && backIdInput.files.length > 0) || 
                                  (typeof VerificationState !== 'undefined' && VerificationState.backIdUploaded);
                updateCheckItem('check-back-id', hasBackId);
                
                // Check 4: Selfie captured
                const hasSelfie = (typeof VerificationState !== 'undefined' && VerificationState.selfieUploaded) ||
                                  (typeof IDUploadModal !== 'undefined' && IDUploadModal.selfieImage);
                updateCheckItem('check-selfie', hasSelfie);
                
                // Check 5: Terms accepted
                const termsCheckbox = document.getElementById('terms');
                const termsAccepted = termsCheckbox && termsCheckbox.checked;
                updateCheckItem('check-terms', termsAccepted);
                
                // Enable/disable submit button based on all requirements
                if (verifyBtn) {
                    if (allRequirementsMet) {
                        verifyBtn.disabled = false;
                        verifyBtn.classList.remove('disabled:opacity-50', 'disabled:cursor-not-allowed');
                    } else {
                        verifyBtn.disabled = true;
                        verifyBtn.classList.add('disabled:opacity-50', 'disabled:cursor-not-allowed');
                    }
                }
                
                return allRequirementsMet;
            };
            
            // ═══════════════════════════════════════════════════════════════════════════
            // EVENT LISTENERS FOR REAL-TIME UPDATES
            // ═══════════════════════════════════════════════════════════════════════════
            
            // Listen to form field changes (ID Number excluded - readonly, auto-filled from API)
            const formFields = ['lastname', 'firstname', 'middlename', 'gender', 'civil-status', 'phonenumber', 'birthdate', 'blklotstreet', 'subdivision', 'barangay'];
            formFields.forEach(fieldId => {
                const field = document.getElementById(fieldId);
                if (field) {
                    field.addEventListener('input', window.updateVerificationChecklist);
                    field.addEventListener('change', window.updateVerificationChecklist);
                }
            });
            
            // Listen to terms checkbox
            const termsCheckbox = document.getElementById('terms');
            if (termsCheckbox) {
                termsCheckbox.addEventListener('change', window.updateVerificationChecklist);
            }
            
            // Listen to file input changes
            const frontIdInput = document.getElementById('file-input-front');
            const backIdInput = document.getElementById('file-input-back');
            if (frontIdInput) {
                frontIdInput.addEventListener('change', window.updateVerificationChecklist);
            }
            if (backIdInput) {
                backIdInput.addEventListener('change', window.updateVerificationChecklist);
            }
            
            // Initial checklist update
            setTimeout(window.updateVerificationChecklist, 500);

            // Set up interval to periodically check (catches updates from modal flows)
            setInterval(window.updateVerificationChecklist, 1000);
        });

        // ═══════════════════════════════════════════════════════════════════════════
        // WIZARD TAB NAVIGATION - 3-Tab Account Verification Flow
        // ═══════════════════════════════════════════════════════════════════════════

        const WizardNav = {
            currentTab: 1,

            // Navigate to a specific tab
            goToTab: function(tabNumber) {
                if (tabNumber < 1 || tabNumber > 3) {
                    console.error('Invalid tab number:', tabNumber);
                    return;
                }

                console.log(`🔄 Navigating from Tab ${this.currentTab} to Tab ${tabNumber}`);

                // Hide all tabs
                document.getElementById('tab-1').classList.add('hidden');
                document.getElementById('tab-2').classList.add('hidden');
                document.getElementById('tab-3').classList.add('hidden');

                // Show the requested tab
                document.getElementById(`tab-${tabNumber}`).classList.remove('hidden');

                // Update tab indicators
                this.updateIndicators(tabNumber);

                // If navigating to Tab 3, populate the review page
                if (tabNumber === 3) {
                    this.populateReviewPage();
                }

                // Update current tab
                this.currentTab = tabNumber;

                // Scroll to top
                window.scrollTo({ top: 0, behavior: 'smooth' });

                console.log(`✅ Now on Tab ${tabNumber}`);
            },

            // Update tab indicator styles
            updateIndicators: function(activeTab) {
                for (let i = 1; i <= 3; i++) {
                    const indicator = document.getElementById(`tab-indicator-${i}`);
                    const label = document.getElementById(`tab-label-${i}`);

                    if (i < activeTab) {
                        // Completed tab - green with checkmark
                        indicator.classList.remove('bg-gray-300', 'text-gray-500', 'bg-blue-500');
                        indicator.classList.add('bg-green-500', 'text-white');
                        indicator.innerHTML = '<i class="fas fa-check text-sm sm:text-base md:text-lg"></i>';
                        label.classList.remove('text-gray-500', 'font-medium', 'text-blue-500');
                        label.classList.add('text-green-500', 'font-semibold');
                    } else if (i === activeTab) {
                        // Active tab - blue with number
                        indicator.classList.remove('bg-gray-300', 'text-gray-500', 'bg-green-500');
                        indicator.classList.add('bg-blue-500', 'text-white');
                        indicator.innerHTML = i.toString();
                        label.classList.remove('text-gray-500', 'font-medium', 'text-green-500');
                        label.classList.add('text-blue-500', 'font-semibold');
                    } else {
                        // Future tab - gray with number
                        indicator.classList.remove('bg-blue-500', 'text-white', 'bg-green-500');
                        indicator.classList.add('bg-gray-300', 'text-gray-500');
                        indicator.innerHTML = i.toString();
                        label.classList.remove('text-blue-500', 'font-semibold', 'text-green-500');
                        label.classList.add('text-gray-500', 'font-medium');
                    }
                }

                // Update connector lines
                const connector1_2 = document.getElementById('connector-1-2');
                const connector2_3 = document.getElementById('connector-2-3');

                // Connector 1-2: Green if Tab 1 is completed (activeTab >= 2)
                if (activeTab >= 2) {
                    connector1_2.classList.remove('bg-gray-300');
                    connector1_2.classList.add('bg-green-500');
                } else {
                    connector1_2.classList.remove('bg-green-500');
                    connector1_2.classList.add('bg-gray-300');
                }

                // Connector 2-3: Green if Tab 2 is completed (activeTab >= 3)
                if (activeTab >= 3) {
                    connector2_3.classList.remove('bg-gray-300');
                    connector2_3.classList.add('bg-green-500');
                } else {
                    connector2_3.classList.remove('bg-green-500');
                    connector2_3.classList.add('bg-gray-300');
                }
            },

            // Populate Tab 3 review page with form data
            populateReviewPage: function() {
                console.log('📋 Populating review page with form data...');

                // Personal Information
                this.setReviewValue('lastname', 'review-lastname');
                this.setReviewValue('firstname', 'review-firstname');
                this.setReviewValue('middlename', 'review-middlename');
                this.setReviewValue('suffix', 'review-suffix');
                this.setReviewValue('gender', 'review-gender');
                this.setReviewValue('civil-status', 'review-civilstatus');
                this.setReviewValue('phonenumber', 'review-phonenumber');
                this.setReviewValue('birthdate', 'review-birthdate');

                // Address Information
                this.setReviewValue('blklotstreet', 'review-blklotstreet');
                this.setReviewValue('subdivision', 'review-subdivision');
                this.setReviewValue('barangay', 'review-barangay');

                // ID Verification Information
                this.setReviewValue('idnumber', 'review-idnumber');
                this.setReviewValue('document-type', 'review-idtype');

                // Terms and Conditions
                const termsCheckbox = document.getElementById('terms');
                const termsReview = document.getElementById('review-terms-status');
                if (termsReview) {
                    termsReview.textContent = termsCheckbox && termsCheckbox.checked ? 'Accepted' : 'Not accepted';
                    termsReview.classList.toggle('text-green-700', termsCheckbox && termsCheckbox.checked);
                    termsReview.classList.toggle('text-blue-700', !termsCheckbox || !termsCheckbox.checked);
