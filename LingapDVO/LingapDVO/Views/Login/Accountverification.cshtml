    <!-- ID Upload Modal Controller Script -->
    <script>
    // Retry Verification Controller
    const RetryVerification = {
        // State
        frontIdImage: null,
        backIdImage: null,
        frontIdFile: null,   // RAW FILE OBJECT for API submission
        backIdFile: null,    // RAW FILE OBJECT for API submission
        selfieImage: null,
        selfieFileName: null,
        videoStream: null,
        countdownInterval: null,
        
        // Retry tracking
        maxAttempts: 3,
        storageKey: 'verificationRetryData',
        
        // Modal instances
        modals: {},
        
        // Initialize
        init() {
            // Only create modal instances if they don't exist
            if (!this.modals.retry) {
                this.modals.retry = new bootstrap.Modal(document.getElementById('retryVerificationModal'));
            }
            if (!this.modals.selfie) {
                this.modals.selfie = new bootstrap.Modal(document.getElementById('retrySelfieModal'));
            }
            if (!this.modals.cooldown) {
                this.modals.cooldown = new bootstrap.Modal(document.getElementById('cooldownModal'));
            }
        },
        
        // Get retry data from localStorage
        getRetryData() {
            const data = localStorage.getItem(this.storageKey);
            if (data) {
                return JSON.parse(data);
            }
            return { attempts: 0, cooldownUntil: null };
        },
        
        // Save retry data to localStorage
        saveRetryData(data) {
            localStorage.setItem(this.storageKey, JSON.stringify(data));
        },
        
        // Check if in cooldown period
        isInCooldown() {
            const data = this.getRetryData();
            if (data.cooldownUntil) {
                const now = new Date().getTime();
                return now < data.cooldownUntil;
            }
            return false;
        },
        
        // Get remaining cooldown time in seconds
        getRemainingCooldown() {
            const data = this.getRetryData();
            if (data.cooldownUntil) {
                const now = new Date().getTime();
                return Math.max(0, Math.floor((data.cooldownUntil - now) / 1000));
            }
            return 0;
        },
        
        // Start retry flow
        startRetryFlow(reason = null) {
            this.init();
            
            // Check cooldown first
            if (this.isInCooldown()) {
                this.showCooldownModal();
                return;
            }
            
            // Reset state
            this.frontIdImage = null;
            this.backIdImage = null;
            this.selfieImage = null;
            this.selfieFileName = null;
            
            // Reset UI
            this.resetUploadUI();
            
            // Update attempt counter display
            const data = this.getRetryData();
            const currentAttempt = data.attempts + 1;
            document.getElementById('retry-attempts-badge').textContent = `Attempt ${currentAttempt} of ${this.maxAttempts}`;
            
            // Show warning if low on attempts
            if (currentAttempt >= 2) {
                const remaining = this.maxAttempts - currentAttempt + 1;
                document.getElementById('retry-attempts-warning').classList.remove('hidden');
                document.getElementById('retry-attempts-warning-text').textContent = 
                    remaining === 1 ? 'This is your last attempt!' : `You have ${remaining} attempts remaining.`;
            } else {
                document.getElementById('retry-attempts-warning').classList.add('hidden');
            }
            
            // Set reason text if provided
            if (reason) {
                document.getElementById('retry-reason-text').textContent = reason;
            }
            
            // Show modal
            this.modals.retry.show();
        },
        
        // Reset upload UI
        resetUploadUI() {
            // Clear file objects
            this.frontIdImage = null;
            this.backIdImage = null;
            this.frontIdFile = null;
            this.backIdFile = null;
            this.selfieImage = null;
            this.selfieFileName = null;
            
            document.getElementById('retry-front-upload-content').classList.remove('hidden');
            document.getElementById('retry-front-preview-content').classList.add('hidden');
            document.getElementById('retry-back-upload-content').classList.remove('hidden');
            document.getElementById('retry-back-preview-content').classList.add('hidden');
            document.getElementById('retry-selfie-upload-content').classList.remove('hidden');
            document.getElementById('retry-selfie-preview-content').classList.add('hidden');
            document.getElementById('retry-submit-btn').disabled = true;
            document.getElementById('retry-file-input-front').value = '';
            document.getElementById('retry-file-input-back').value = '';
        },
        
        // Handle front upload - STORES RAW FILE OBJECT for API submission
        handleFrontUpload(event) {
            const file = event.target.files[0];
            if (!file || !this.validateFile(file)) return;
            
            // Store reference to file for use in reader callback
            const uploadedFile = file;
            this.frontIdFile = file;  // Store raw file object
            
            const reader = new FileReader();
            reader.onload = (e) => {
                this.frontIdImage = e.target.result;
                document.getElementById('retry-preview-front').src = e.target.result;
                document.getElementById('retry-front-upload-content').classList.add('hidden');
                document.getElementById('retry-front-preview-content').classList.remove('hidden');
                
                // Update main form
                const mainInput = document.getElementById('file-input-front');
                if (mainInput) {
                    const dt = new DataTransfer();
                    dt.items.add(uploadedFile);
                    mainInput.files = dt.files;
                }
                
                // Store in VerificationState with RAW FILE for API submission
                if (typeof VerificationState !== 'undefined') {
                    VerificationState.setFrontId(e.target.result, uploadedFile);
                    console.log('✅ Retry: Front ID stored with RAW FILE:', uploadedFile.name, uploadedFile.size, 'bytes');
                }
                
                this.updateSubmitButton();
            };
            reader.readAsDataURL(file);
        },
        
        // Handle back upload - STORES RAW FILE OBJECT for API submission
        handleBackUpload(event) {
            const file = event.target.files[0];
            if (!file || !this.validateFile(file)) return;
            
            // Store reference to file for use in reader callback
            const uploadedFile = file;
            this.backIdFile = file;  // Store raw file object
            
            const reader = new FileReader();
            reader.onload = (e) => {
                this.backIdImage = e.target.result;
                document.getElementById('retry-preview-back').src = e.target.result;
                document.getElementById('retry-back-upload-content').classList.add('hidden');
                document.getElementById('retry-back-preview-content').classList.remove('hidden');
                
                // Update main form
                const mainInput = document.getElementById('file-input-back');
                if (mainInput) {
                    const dt = new DataTransfer();
                    dt.items.add(uploadedFile);
                    mainInput.files = dt.files;
                }
                
                // Store in VerificationState with RAW FILE for API submission
                if (typeof VerificationState !== 'undefined') {
                    VerificationState.setBackId(e.target.result, uploadedFile);
                    console.log('✅ Retry: Back ID stored with RAW FILE:', uploadedFile.name, uploadedFile.size, 'bytes');
                }
            };
            reader.readAsDataURL(file);
        },
        
        // Clear front
        clearFront(event) {
            event.stopPropagation();
            this.frontIdImage = null;
            this.frontIdFile = null;  // Clear raw file object
            document.getElementById('retry-file-input-front').value = '';
            document.getElementById('retry-front-upload-content').classList.remove('hidden');
            document.getElementById('retry-front-preview-content').classList.add('hidden');
            this.updateSubmitButton();
        },
        
        // Clear back
        clearBack(event) {
            event.stopPropagation();
            this.backIdImage = null;
            this.backIdFile = null;  // Clear raw file object
            document.getElementById('retry-file-input-back').value = '';
            document.getElementById('retry-back-upload-content').classList.remove('hidden');
            document.getElementById('retry-back-preview-content').classList.add('hidden');
        },
        
        // Clear selfie
        clearSelfie(event) {
            event.stopPropagation();
            this.selfieImage = null;
            this.selfieFileName = null;
            document.getElementById('retry-selfie-upload-content').classList.remove('hidden');
            document.getElementById('retry-selfie-preview-content').classList.add('hidden');
            this.updateSubmitButton();
        },
        
        // Open selfie capture modal
        openSelfieCapture() {
            // Ensure modals are initialized
            if (!this.modals.selfie) {
                this.modals.selfie = new bootstrap.Modal(document.getElementById('retrySelfieModal'));
            }
            
            // Reset all views to initial state
            document.getElementById('retry-selfie-start-view').classList.remove('hidden');
            document.getElementById('retry-selfie-camera-view').classList.add('hidden');
            
            // Hide countdown overlay (in case it was left visible from a previous attempt)
            const countdown = document.getElementById('retry-selfie-countdown');
            if (countdown) {
                countdown.classList.add('hidden');
            }
            
            // Enable capture button
            const captureBtn = document.getElementById('retry-capture-btn');
            if (captureBtn) {
                captureBtn.disabled = false;
            }
            
            // Clear any existing countdown interval
            if (this.countdownInterval) {
                clearInterval(this.countdownInterval);
                this.countdownInterval = null;
            }
            
            this.modals.selfie.show();
        },
        
        // Close selfie capture
        closeSelfieCapture() {
            this.stopCamera();
            if (this.modals.selfie) {
                this.modals.selfie.hide();
            }
        },
        
        // Start selfie camera
        async startSelfieCamera() {
            try {
                const video = document.getElementById('retry-selfie-video');
                
                // Use responsive constraints - optimized for mobile devices
                const isMobile = window.innerWidth < 640;
                const constraints = {
                    video: {
                        width: { ideal: isMobile ? 480 : 640, min: 280 },
                        height: { ideal: isMobile ? 640 : 480, min: 380 },
                        facingMode: 'user'
                    },
                    audio: false
                };
                
                this.videoStream = await navigator.mediaDevices.getUserMedia(constraints);
                video.srcObject = this.videoStream;
                
                // Ensure video element is visible and plays
                video.style.visibility = 'visible';
                video.style.opacity = '1';
                
                // Wait for video to load and play
                await video.play();
                
                document.getElementById('retry-selfie-start-view').classList.add('hidden');
                document.getElementById('retry-selfie-camera-view').classList.remove('hidden');
                
                // Enable capture button
                document.getElementById('retry-capture-btn').disabled = false;
                
                console.log('✅ Retry selfie camera started successfully');
            } catch (error) {
                console.error('❌ Retry camera access failed:', error);
                alert('Could not access camera. Please ensure camera permissions are enabled.');
            }
        },
        
        // Capture selfie with countdown
        captureSelfie() {
            // Verify video stream is active before capturing
            const video = document.getElementById('retry-selfie-video');
            if (!this.videoStream || !video.srcObject) {
                console.error('❌ No active video stream for retry capture');
                alert('Camera is not active. Please start the camera first.');
                return;
            }
            
            // Verify video is actually playing
            if (video.paused || video.ended || video.readyState < 2) {
                console.error('❌ Video is not ready for retry capture');
                alert('Camera is not ready. Please wait a moment and try again.');
                return;
            }
            
            let count = 3;
            const overlay = document.getElementById('retry-selfie-countdown');
            const number = document.getElementById('retry-countdown-number');
            
            overlay.classList.remove('hidden');
            number.textContent = count;
            document.getElementById('retry-capture-btn').disabled = true;
            
            this.countdownInterval = setInterval(() => {
                count--;
                if (count > 0) {
                    number.textContent = count;
                } else {
                    clearInterval(this.countdownInterval);
                    overlay.classList.add('hidden');
                    this.takeSelfiePhoto();
                }
            }, 1000);
        },
        
        // Take selfie photo - Captures and mirrors the image properly
        async takeSelfiePhoto() {
            const video = document.getElementById('retry-selfie-video');
            const canvas = document.getElementById('retry-selfie-canvas');
            
            // Verify video has valid dimensions
            const videoWidth = video.videoWidth || 640;
            const videoHeight = video.videoHeight || 480;
            
            if (videoWidth === 0 || videoHeight === 0) {
                console.error('❌ Video dimensions are zero');
                alert('Camera capture failed. Please try again.');
                document.getElementById('retry-capture-btn').disabled = false;
                return;
            }
            
            // Set canvas dimensions
            canvas.width = videoWidth;
            canvas.height = videoHeight;
            
            const ctx = canvas.getContext('2d');
            ctx.imageSmoothingEnabled = true;
            ctx.imageSmoothingQuality = 'high';
            
            // Mirror the image horizontally to match the preview (selfie camera is mirrored)
            ctx.translate(videoWidth, 0);
            ctx.scale(-1, 1);
            
            // Draw the video frame to canvas
            ctx.drawImage(video, 0, 0, videoWidth, videoHeight);
            
            // Get image data - Use high JPEG quality (0.95) for API
            this.selfieImage = canvas.toDataURL('image/jpeg', 0.95);
            
            console.log('✅ Retry selfie captured successfully');
            
            // Save to server
            try {
                const response = await fetch('/api/IdAnalyzer/saveSelfie', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ imageData: this.selfieImage })
                });
                const result = await response.json();
                if (result.success) {
                    this.selfieFileName = result.fileName;
                    console.log('✅ Retry selfie saved to server:', this.selfieFileName);
                }
            } catch (e) {
                console.error('Failed to save selfie:', e);
            }
            
            this.stopCamera();
            if (this.modals.selfie) {
                this.modals.selfie.hide();
            }
            
            // Update preview in retry modal
            document.getElementById('retry-preview-selfie').src = this.selfieImage;
            document.getElementById('retry-selfie-upload-content').classList.add('hidden');
            document.getElementById('retry-selfie-preview-content').classList.remove('hidden');
            
            this.updateSubmitButton();
        },
        
        // Stop camera
        stopCamera() {
            if (this.videoStream) {
                this.videoStream.getTracks().forEach(track => track.stop());
                this.videoStream = null;
            }
            if (this.countdownInterval) {
                clearInterval(this.countdownInterval);
                this.countdownInterval = null;
            }
            
            // Reset capture button state
            const captureBtn = document.getElementById('retry-capture-btn');
            if (captureBtn) {
                captureBtn.disabled = false;
            }
            
            // Hide countdown overlay
            const countdown = document.getElementById('retry-selfie-countdown');
            if (countdown) {
                countdown.classList.add('hidden');
            }
        },
        
        // Update submit button state
        updateSubmitButton() {
            const canSubmit = this.frontIdImage && this.selfieImage;
            document.getElementById('retry-submit-btn').disabled = !canSubmit;
        },
        
        // Submit retry verification
        async submitRetry() {
            // Increment attempt counter
            const data = this.getRetryData();
            data.attempts++;
            
            // Check if max attempts reached
            if (data.attempts >= this.maxAttempts) {
                // Set cooldown for 1 hour
                data.cooldownUntil = new Date().getTime() + (60 * 60 * 1000);
            }
            
            this.saveRetryData(data);
            
            // Close retry modal
            this.modals.retry.hide();
            
            // Update main page previews and state
            IDUploadModal.frontIdImage = this.frontIdImage;
            IDUploadModal.backIdImage = this.backIdImage;
            IDUploadModal.selfieImage = this.selfieImage;
            IDUploadModal.selfieFileName = this.selfieFileName;
            IDUploadModal.updateMainPagePreviews();
            
            // Update VerificationState
            if (typeof VerificationState !== 'undefined') {
                VerificationState.setFrontId(this.frontIdImage);
                if (this.backIdImage) {
                    VerificationState.setBackId(this.backIdImage);
                }
                VerificationState.setSelfie(this.selfieImage, this.selfieFileName);
                VerificationState.updateVerifyButtonState();
            }
            
            // Update verification checklist
            if (typeof window.updateVerificationChecklist === 'function') {
                window.updateVerificationChecklist();
            }

            // AUTO-EXTRACT DATA: Call API to extract ID data and populate fields
            // This does NOT save to database - only extracts data for user review
            if (typeof submitVerification === 'function') {
                console.log('🔄 Auto-extracting ID data for user review...');
                submitVerification();
            }
        },
        
        // Show cooldown modal
        showCooldownModal() {
            this.modals.cooldown.show();
            this.startCooldownTimer();
        },
        
        // Start cooldown timer
        startCooldownTimer() {
            const timerEl = document.getElementById('cooldown-timer');
            
            const updateTimer = () => {
                const remaining = this.getRemainingCooldown();
                if (remaining <= 0) {
                    // Cooldown finished, reset attempts
                    this.saveRetryData({ attempts: 0, cooldownUntil: null });
                    timerEl.textContent = '00:00';
                    this.modals.cooldown.hide();
                    return;
                }
                
                const minutes = Math.floor(remaining / 60);
                const seconds = remaining % 60;
                timerEl.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
                
                setTimeout(updateTimer, 1000);
            };
            
            updateTimer();
        },
        
        // Validate file
        validateFile(file) {
            const validTypes = ['image/jpeg', 'image/jpg', 'image/png'];
            const maxSize = 5 * 1024 * 1024;
            
            if (!validTypes.includes(file.type)) {
                alert('Please upload a JPG, JPEG, or PNG file.');
                return false;
            }
            
            if (file.size > maxSize) {
                alert('File size must be less than 5MB.');
                return false;
            }
            
            return true;
        },
        
        // Reset attempts (for testing or admin use)
        resetAttempts() {
            this.saveRetryData({ attempts: 0, cooldownUntil: null });
        }
    };
    
    // Global function to trigger retry flow
    function showRetryVerification(reason) {
        RetryVerification.startRetryFlow(reason);
    }
    
    const IDUploadModal = {
        // State
        frontIdImage: null,
        backIdImage: null,
        frontIdFile: null,   // RAW FILE OBJECT for API submission
        backIdFile: null,    // RAW FILE OBJECT for API submission
        selfieImage: null,
        selfieFileName: null,
        videoStream: null,
        countdownInterval: null,
        
        // Modal instances
        modals: {},
        
        // Initialize
        init() {
            // Cache modal instances
            this.modals.front = new bootstrap.Modal(document.getElementById('frontIdModal'));
            this.modals.back = new bootstrap.Modal(document.getElementById('backIdModal'));
            this.modals.selfie = new bootstrap.Modal(document.getElementById('selfieModal'));
        },
        
        // Start the upload flow
