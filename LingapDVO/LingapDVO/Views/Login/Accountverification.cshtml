                                // Only one name: treat as first name
                                firstName = cleanName(cleanedParts[0]);
                                console.log(`  ✅ Single name -> First: "${firstName}"`);
                            } else if (cleanedParts.length === 2) {
                                // Two names: could be "FirstName MiddleName" or "FirstName1 FirstName2"
                                // Common Philippine pattern: treat last word as middle name
                                firstName = cleanName(cleanedParts[0]);
                                middleName = cleanName(cleanedParts[1]);
                                console.log(`  ✅ Two names -> First: "${firstName}", Middle: "${middleName}"`);
                            } else if (cleanedParts.length >= 3) {
