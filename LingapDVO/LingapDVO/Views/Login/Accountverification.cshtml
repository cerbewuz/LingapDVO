@model VerifiedAccountDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Verification</title>
    <link rel="icon" type="image/x-icon" href="~/Icon/lingaplogo.ico">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Minimalist Aesthetic Design -->
    <link rel="stylesheet" href="~/css/account-verification-minimal.css">

    <!-- Go Back Button Styles -->
    <link rel="stylesheet" href="~/css/go-back-button.css">

    <!-- Facial Recognition Styles -->
    <link rel="stylesheet" href="~/css/facial-recognition.css">

    <!-- NOTE: Face-API.js library removed - using ID Analyzer server-side API instead -->

    <!-- Disabled Upload Area Style for UMID/Driver's License -->
    <style>
        .upload-area.disabled-upload {
            background: linear-gradient(135deg, #f0f9f0 0%, #e8f5e8 100%) !important;
            border: 2px dashed #22c55e !important;
            cursor: not-allowed !important;
        }
        .upload-area.disabled-upload .id-upload-content {
            opacity: 0.8;
        }
        .upload-area.disabled-upload .w-16.h-16 {
            background: #dcfce7 !important;
        }
        .upload-area.disabled-upload i.fa-id-card {
            color: #22c55e !important;
        }

        /* Responsive Camera Guide Styles */
        /* Selfie Camera SVG Guide - Works on all devices including Android */
        .selfie-oval-svg {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
        }

        /* Selfie Camera Video */
        #selfie-modal-video {
            visibility: visible !important;
            opacity: 1 !important;
        }

        /* Ensure selfie camera container shows video properly */
        #selfie-camera-view:not(.hidden) {
            display: block !important;
        }

        #selfie-camera-view:not(.hidden) #selfie-modal-video {
            visibility: visible !important;
            opacity: 1 !important;
            display: block !important;
        }

        /* CRITICAL: Hide camera view completely when .hidden class is present */
        #selfie-camera-view.hidden {
            display: none !important;
            visibility: hidden !important;
            opacity: 0 !important;
            height: 0 !important;
            overflow: hidden !important;
        }

        /* Hide start view when .hidden class is present */
        #selfie-start-view.hidden {
            display: none !important;
            visibility: hidden !important;
        }

        /* Ensure preview view is visible and takes full space when shown */
        #selfie-preview-view:not(.hidden) {
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
            width: 100% !important;
            min-height: 280px;
        }

        /* Hide preview view when .hidden class is present */
        #selfie-preview-view.hidden {
            display: none !important;
            visibility: hidden !important;
        }

        /* Responsive selfie camera container */
        .selfie-camera-container {
            max-width: 280px;
        }

        @@media (min-width: 400px) {
            .selfie-camera-container {
                max-width: 300px;
            }
        }

        @@media (min-width: 640px) {
            .selfie-camera-container {
                max-width: 320px;
            }
        }

        /* Mirror effect for selfie camera */
        .mirror-video {
            transform: scaleX(-1);
            -webkit-transform: scaleX(-1);
        }

        /* SVG oval guide - ensure visibility on all devices */
        .selfie-oval-svg {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
        }

        /* Hide guide text after a few seconds via JS */
        #selfie-guide-text.fade-out {
            opacity: 0;
            transition: opacity 0.5s ease-out;
        }

        /* ═══════════════════════════════════════════════════════════════════════════ */
        /* RESPONSIVE ENHANCEMENTS FOR MOBILE DEVICES */
        /* ═══════════════════════════════════════════════════════════════════════════ */

        /* Ensure text doesn't overflow on mobile */
        .break-words {
            word-wrap: break-word;
            overflow-wrap: break-word;
            hyphens: auto;
        }

        /* Better touch targets for mobile */
        @@media (max-width: 640px) {
            /* Larger touch targets for buttons */
            button, .btn, [role="button"] {
                min-height: 44px;
            }

            /* Better spacing for form fields */
            input, select, textarea {
                font-size: 16px !important; /* Prevents zoom on iOS */
            }

            /* Compact modal headers on mobile */
            .modal-header {
                padding-top: 0.75rem !important;
                padding-bottom: 0.75rem !important;
            }

            /* Stack modal footer buttons vertically on very small screens */
            .modal-footer {
                flex-direction: column-reverse !important;
            }

            .modal-footer button {
                width: 100% !important;
            }

            /* Ensure modals don't have horizontal overflow */
            .modal-content {
                max-width: 100vw;
                overflow-x: hidden;
            }

            /* Better padding for small screens */
            .modal-body {
                padding: 1rem !important;
            }

            /* Compact validation messages */
            #validation-results-container .rounded-xl {
                padding: 0.75rem !important;
            }
        }

        /* Extra small screens (below 400px) */
        @@media (max-width: 400px) {
            /* Even more compact spacing */
            .modal-body {
                padding: 0.75rem !important;
            }

            /* Smaller icons */
            .modal-header .w-10.h-10 {
                width: 2rem !important;
                height: 2rem !important;
            }

            /* Compact tab indicators */
            #tab-indicator-1, #tab-indicator-2, #tab-indicator-3 {
                width: 2rem !important;
                height: 2rem !important;
                font-size: 0.875rem !important;
            }

            /* Shorter connector lines */
            #connector-1-2, #connector-2-3 {
                width: 1.5rem !important;
            }
        }

        /* Prevent horizontal scroll on body */
        body {
            overflow-x: hidden;
        }

        /* Ensure images don't overflow */
        img {
            max-width: 100%;
            height: auto;
        }
    </style>

    <!-- Session Timeout -->
    @await Html.PartialAsync("_SessionTimeout")
</head>

<body>
    <!-- Go Back Button (Uniform) - Redirects to Login page -->
    <button class="go-back-btn" data-url="/Login">
        <i class="fas fa-arrow-left"></i>
        <span>Go Back</span>
    </button>

    <div class="container mx-auto px-3 sm:px-4 py-4 sm:py-6 md:py-8">
        <div class="max-w-4xl mx-auto">
            <!-- Header -->
            @* <div class="text-center mb-8 fade-in">
                <h1 class="text-4xl font-bold text-gray-800 mb-2">Verify Your Account</h1>
            </div> *@

            <!-- Main Form Card -->
            <div class="bg-white rounded-xl sm:rounded-2xl shadow-xl overflow-hidden glass-effect scale-in w-full max-w-full lg:max-w-4xl mx-auto">
                <div class="p-4 sm:p-6 md:p-8">

                    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
                    <!-- SERVER-SIDE ERROR DISPLAY -->
                    <!-- ═══════════════════════════════════════════════════════════════════════════ -->
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-xl mb-6 flex items-start gap-3">
                            <i class="fas fa-exclamation-circle text-red-500 mt-0.5"></i>
                            <div>
                                <strong class="font-semibold">Error:</strong>
                                <span>@TempData["ErrorMessage"]</span>
                            </div>
                        </div>
                    }
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-xl mb-6">
                            <div class="flex items-start gap-3 mb-2">
                                <i class="fas fa-exclamation-triangle text-red-500 mt-0.5"></i>
                                <strong class="font-semibold">Please fix the following issues:</strong>
                            </div>
                            <ul class="list-disc ml-8 mt-2 space-y-1 text-sm">
                                @foreach (var modelState in ViewData.ModelState.Values)
                                {
                                    @foreach (var error in modelState.Errors)
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                }
                            </ul>
                        </div>
                    }

                    <form asp-action="Accountverification" method="post" enctype="multipart/form-data" id="registrationForm" class="space-y-8" onsubmit="return validateFinalSubmission()">

                        <!-- ═══════════════════════════════════════════════════════════════════════════ -->
                        <!-- STEP 1: PERSONAL INFORMATION (Fill First) -->
                        <!-- ═══════════════════════════════════════════════════════════════════════════ -->

                        <!-- ═══════════════════════════════════════════════════════════════════════════ -->
                        <!-- HIDDEN FIELDS (Form Structure) -->
                        <!-- ═══════════════════════════════════════════════════════════════════════════ -->

                        <!-- Auto-Detected ID Type (Hidden - populated by API) -->
                        <input type="hidden" asp-for="IDtype" id="document-type" />



                        <!-- Verification Decision (Hidden - populated by ID Analyzer API) -->
                        <input type="hidden" name="VerificationDecision" id="verification-decision" value="" />

                        <!-- Transaction ID (Hidden - populated by ID Analyzer API) -->
                        <input type="hidden" name="TransactionId" id="transaction-id" value="" />

                        <!-- Hidden File Inputs (for form submission) -->
                        <input asp-for="ValidFrontID" type="file" id="file-input-front" class="hidden" accept="image/jpeg,image/jpg,image/png">
                        <input asp-for="ValidBackID" type="file" id="file-input-back" class="hidden" accept="image/jpeg,image/jpg,image/png">

                        <!-- Legacy/Support Elements (hidden for JS compatibility) -->
                        <div class="hidden">
                            <div id="id-type-display"></div>
                            <div id="uploaded-photos-container"></div>
                            <div id="face-verify-container"></div>
                            <img id="frontIDImg" />
                            <img id="backIDImg" />
                            <canvas id="captured-selfie"></canvas>
                        </div>

                        <!-- ═══════════════════════════════════════════════════════════════════════════ -->
                        <!-- MULTI-STEP WIZARD NAVIGATION -->
                        <!-- ═══════════════════════════════════════════════════════════════════════════ -->

                        <!-- Tab Indicators - Fully Responsive -->
                        <div class="flex justify-center mb-6 sm:mb-8 px-2">
                            <div class="flex items-center gap-2 sm:gap-4 md:gap-6">
                                <!-- Tab 1 Indicator -->
                                <div class="flex flex-col items-center">
                                    <div id="tab-indicator-1" class="w-10 h-10 sm:w-12 sm:h-12 md:w-14 md:h-14 rounded-full bg-blue-500 text-white flex items-center justify-center font-bold text-base sm:text-lg md:text-xl mb-1 sm:mb-2 transition-all duration-300 shadow-md">
                                        1
                                    </div>
                                    <span id="tab-label-1" class="text-xs sm:text-sm md:text-base font-semibold text-blue-500 text-center">Personal<br class="sm:hidden"> Info</span>
                                </div>

                                <!-- Connector Line 1-2 -->
                                <div id="connector-1-2" class="w-8 sm:w-12 md:w-16 lg:w-20 h-0.5 sm:h-1 bg-gray-300 transition-all duration-300"></div>

                                <!-- Tab 2 Indicator -->
                                <div class="flex flex-col items-center">
                                    <div id="tab-indicator-2" class="w-10 h-10 sm:w-12 sm:h-12 md:w-14 md:h-14 rounded-full bg-gray-300 text-gray-500 flex items-center justify-center font-bold text-base sm:text-lg md:text-xl mb-1 sm:mb-2 transition-all duration-300 shadow-md">
                                        2
                                    </div>
                                    <span id="tab-label-2" class="text-xs sm:text-sm md:text-base font-medium text-gray-500 text-center">ID<br class="sm:hidden"> Verification</span>
                                </div>

                                <!-- Connector Line 2-3 -->
                                <div id="connector-2-3" class="w-8 sm:w-12 md:w-16 lg:w-20 h-0.5 sm:h-1 bg-gray-300 transition-all duration-300"></div>

                                <!-- Tab 3 Indicator -->
                                <div class="flex flex-col items-center">
                                    <div id="tab-indicator-3" class="w-10 h-10 sm:w-12 sm:h-12 md:w-14 md:h-14 rounded-full bg-gray-300 text-gray-500 flex items-center justify-center font-bold text-base sm:text-lg md:text-xl mb-1 sm:mb-2 transition-all duration-300 shadow-md">
                                        3
                                    </div>
                                    <span id="tab-label-3" class="text-xs sm:text-sm md:text-base font-medium text-gray-500 text-center">Review &<br class="sm:hidden"> Submit</span>
                                </div>
                            </div>
                        </div>

                        <!-- ═══════════════════════════════════════════════════════════════════════════ -->
                        <!-- TAB 1: PERSONAL INFORMATION & ADDRESS -->
                        <!-- ═══════════════════════════════════════════════════════════════════════════ -->

                        <div id="tab-1" class="tab-content">
                            <!-- Personal Information Section -->
                        <div class="space-y-4 sm:space-y-6">
                            <div class="flex items-center gap-2 sm:gap-3 mb-2">
                                <div class="w-8 h-8 sm:w-10 sm:h-10 bg-green-50 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-user text-base sm:text-lg text-green-500"></i>
                                </div>
                                <h2 class="text-xl sm:text-2xl font-bold text-gray-800">Personal Information</h2>
                            </div>

                            <!-- Name Fields -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Last Name</label>
                                    <input asp-for="Lastname" type="text" id="lastname"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                                           placeholder="Enter your last name" required>
                                    <span asp-validation-for="Lastname" class="text-red-500 text-sm mt-1"></span>
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">First Name</label>
                                    <input asp-for="Firstname" type="text" id="firstname"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                                           placeholder="Enter your first name" required>
                                    <span asp-validation-for="Firstname" class="text-red-500 text-sm mt-1"></span>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Middle Name</label>
                                    <input asp-for="Middlename" type="text" id="middlename"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                                           placeholder="Enter your middle name">
                                    <span asp-validation-for="Middlename" class="text-red-500 text-sm mt-1"></span>
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Suffix</label>
                                    <select asp-for="Suffix" id="suffix" name="Suffix"
                                            class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300">
                                        <option value="None">None</option>
                                        <option value="JR">Jr.</option>
                                        <option value="SR">Sr.</option>
                                        <option value="I">I</option>
                                        <option value="II">II</option>
                                        <option value="III">III</option>
                                        <option value="IV">IV</option>
                                        <option value="V">V</option>
                                        <option value="VI">VI</option>
                                        <option value="VII">VII</option>
                                        <option value="VIII">VIII</option>
                                        <option value="IX">IX</option>
                                        <option value="X">X</option>
                                    </select>
                                    <span asp-validation-for="Suffix" class="text-red-500 text-sm mt-1"></span>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
                                <div>
                                    <label for="gender" class="block text-sm font-semibold text-gray-700 mb-2">Gender</label>
                                    <select id="gender" name="Gender" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-colors">
                                        <option value="">Select Gender</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                    </select>
                                    <div class="error-message hidden" id="gender-error"></div>
                                </div>

                                <div>
                                    <label for="civil-status" class="block text-sm font-semibold text-gray-700 mb-2">Civil Status</label>
                                    <select id="civil-status" name="CivilStatus" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-colors">
                                        <option value="">Select Civil Status</option>
                                        <option value="Single">Single</option>
                                        <option value="Married">Married</option>
                                        <option value="Widowed">Widowed</option>
                                        <option value="Separated">Separated</option>
                                        <option value="Divorced">Divorced</option>
                                    </select>
                                    <div class="error-message hidden" id="civilstatus-error"></div>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Phone Number</label>
                                    <input asp-for="Phonenumber" type="text" id="phonenumber"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                                           placeholder="09123456789"
                                           required
                                           inputmode="numeric"
                                           pattern="[0-9]{11}"
                                           maxlength="11"
                                           oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 11)"
                                           onkeypress="return event.charCode >= 48 && event.charCode <= 57">
                                    <span asp-validation-for="Phonenumber" class="text-red-500 text-sm mt-1"></span>
                                    <div id="phonenumber-error" class="text-red-500 text-sm mt-1 hidden"></div>
                                    <div class="text-xs text-gray-500 mt-1">
                                        <i class="fas fa-info-circle"></i> Enter 11-digit Philippine mobile number (e.g., 09123456789)
                                    </div>
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Date of Birth</label>
                                    <input asp-for="Dateofbirth" type="date" id="birthdate"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                                           required
                                           max=""
                                           onchange="validateBirthdate(this)">
                                    <span asp-validation-for="Dateofbirth" class="text-red-500 text-sm mt-1"></span>
                                    <div id="birthdate-error" class="text-red-500 text-sm mt-1 hidden"></div>
                                    <div class="text-xs text-gray-500 mt-1">
                                        <i class="fas fa-info-circle"></i> You must be at least 16 years old
                                    </div>
                                </div>
                            </div>
                        </div>
                        <br />
                        <!-- Address Section -->
                        <div class="space-y-6">
                            <div class="flex items-center gap-3 mb-2">
                                <div class="w-10 h-10 bg-purple-50 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-home text-lg text-purple-500"></i>
                                
                                </div>
                                <h2 class="text-2xl font-bold text-gray-800">Address Information</h2>
                            </div>

                            <div class="grid grid-cols-1 gap-6">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Block/Lot/Street</label>
                                    <input asp-for="BlkLotStreet" type="text" id="blklotstreet"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                                           placeholder="e.g., Block 5 Lot 12 Main Street" required>
                                    <span asp-validation-for="BlkLotStreet" class="text-red-500 text-sm mt-1"></span>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Subdivision/Village</label>
                                    <input asp-for="SubVill" type="text" id="subdivision"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                                           placeholder="Enter Subdivision or Village name">
                                    <span asp-validation-for="SubVill" class="text-red-500 text-sm mt-1"></span>
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Barangay</label>
                                    <select asp-for="Barangay" id="barangay" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300" required>
                                        <option value="" disabled selected>--Select Barangay--</option>
                                        <option value="Acacia">Acacia</option>
                                        <option value="Agdao">Agdao</option>
                                        <option value="Alambre">Alambre</option>
                                        <option value="Alejandro Navarro">Alejandro Navarro (Lasang)</option>
                                        <option value="Alfonso Angliongto Sr.">Alfonso Angliongto Sr.</option>
                                        <option value="Angalan">Angalan</option>
                                        <option value="Baguio Proper">Baguio Proper</option>
                                        <option value="Baliok">Baliok</option>
                                        <option value="Bangkas Heights">Bangkas Heights</option>
                                        <option value="Baracatan">Baracatan</option>
                                        <option value="Bato">Bato</option>
                                        <option value="Bayabas">Bayabas</option>
                                        <option value="Biao Escuela">Biao Escuela</option>
                                        <option value="Biao Guianga">Biao Guianga</option>
                                        <option value="Binugao">Binugao</option>
                                        <option value="Bucana">Bucana</option>
                                        <option value="Buhangin">Buhangin</option>
                                        <option value="Buhangin (Pob.)">Buhangin (Pob.)</option>
                                        <option value="Buhangin Proper">Buhangin Proper</option>
                                        <option value="Cabantian">Cabantian</option>
                                        <option value="Cadalian">Cadalian</option>
                                        <option value="Calinan Proper">Calinan Proper</option>
                                        <option value="Callawa">Callawa</option>
                                        <option value="Camansi">Camansi</option>
                                        <option value="Carmen">Carmen</option>
                                        <option value="Catalunan Grande">Catalunan Grande</option>
                                        <option value="Catalunan Pequeño">Catalunan Pequeño</option>
                                        <option value="Catigan">Catigan</option>
                                        <option value="Cawayan">Cawayan</option>
                                        <option value="Centro (San Juan)">Centro (San Juan)</option>
                                        <option value="Colosas">Colosas</option>
                                        <option value="Communal">Communal</option>
                                        <option value="Crossing Bayabas">Crossing Bayabas</option>
                                        <option value="Dacudao">Dacudao</option>
                                        <option value="Dalagdag">Dalagdag</option>
                                        <option value="Daliao">Daliao</option>
                                        <option value="Dalican">Dalican</option>
                                        <option value="Datu Salumay">Datu Salumay</option>
                                        <option value="Dominga">Dominga</option>
                                        <option value="Eden">Eden</option>
                                        <option value="Fatima (Benowang)">Fatima (Benowang)</option>
                                        <option value="Gatungan">Gatungan</option>
                                        <option value="Gov. Paciano Bangoy">Gov. Paciano Bangoy</option>
                                        <option value="Gov. Vicente Duterte">Gov. Vicente Duterte</option>
