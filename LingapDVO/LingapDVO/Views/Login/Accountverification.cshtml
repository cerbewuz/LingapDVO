                    .replace(/[\x00-\x1F\x7F-\x9F]/g, "")
                    // Remove multiple dots/periods that aren't part of names
                    .replace(/\.{2,}/g, ".")
                    // Normalize dashes and hyphens
                    .replace(/[—–]/g, "-")
                    // Remove underscores, tildes, backticks
                    .replace(/[_~`]/g, "")
                    // Fix common OCR misreads of letters
                    .replace(/\b0(?=[A-Za-z])/g, "O") // 0 followed by letter -> O
                    .replace(/\b1(?=[A-Za-z]{2,})/g, "I") // 1 at start of word -> I
                    .replace(/5(?=[A-Za-z]{2,})/g, "S") // 5 in middle of text -> S
                    // Normalize whitespace
                    .replace(/\s+/g, " ")
                    .trim();

                return cleaned;
            }

            // Pre-process OCR lines with context-aware cleaning
            function preprocessOCRLines(text) {
                const sanitized = sanitizeOCRText(text);
                const lines = sanitized.split('\n')
                    .map(line => line.trim())
                    .filter(line => line.length > 0);

                // Remove likely header/footer garbage
                const filtered = lines.filter(line => {
                    const upper = line.toUpperCase();
                    // Skip lines that are pure numbers or single characters
                    if (line.length < 2) return false;
                    // Skip common header/footer text
                    if (upper.includes('REPUBLIC') && upper.includes('PHILIPPINES')) return false;
                    if (upper.match(/^PAGE\s*\d+/)) return false;
                    return true;
                });

                return filtered;
            }

            // ═══════════════════════════════════════════════════════════════
            // 👤 ADVANCED NAME EXTRACTION & CLEANING
            // ═══════════════════════════════════════════════════════════════

            // Enhanced name cleaning with multi-pass filtering
            function cleanName(text) {
                if (!text) return "";

                // Pass 1: Aggressive sanitization
                let cleaned = sanitizeOCRText(text);

                // Pass 2: Remove numbers and special chars (keep only letters, spaces, hyphens, apostrophes, ñ)
                cleaned = cleaned.replace(/[^a-zA-ZñÑ\s\-'.]/g, " ");

                // Pass 3: Remove OCR artifacts
                cleaned = cleaned
                    // Remove standalone single letters (except initials pattern like "A. ")
                    .replace(/\b[a-z](?!\.\s)/gi, "")
                    // Remove multiple consecutive special chars
                    .replace(/[-'.]{2,}/g, "")
                    // Normalize spaces
                    .replace(/\s{2,}/g, " ")
                    // Trim edges
                    .replace(/^[\s\-'.]+|[\s\-'.]+$/g, "");

                // Pass 4: Handle compound Filipino surnames (de la, del, san, etc.)
                cleaned = cleaned
                    .replace(/\bDe\s+La\s+/gi, "Dela ")
                    .replace(/\bDe\s+Los\s+/gi, "Delos ")
                    .replace(/\bDel\s+(?=\w)/gi, "Del")
                    .replace(/\bSan\s+(?=\w)/gi, "San")
                    .replace(/\bSanta\s+(?=\w)/gi, "Santa");

                // Validation: Skip if too short or contains too many special chars
                if (cleaned.length < 2) return "";
                if ((cleaned.match(/[-']/g) || []).length > 2) return ""; // Too many hyphens/apostrophes

                // Pass 5: Proper case formatting
                return cleaned
                    .toLowerCase()
                    .trim()
                    .split(/\s+/)
                    .filter(word => word.length > 0)
                    .map(word => {
                        // Handle special cases
                        if (word === 'ii' || word === 'iii' || word === 'iv') {
                            return word.toUpperCase();
                        }
                        if (word === 'jr' || word === 'sr') {
                            return word.charAt(0).toUpperCase() + word.slice(1);
                        }
                        // Capitalize first letter
                        return word.charAt(0).toUpperCase() + word.slice(1);
                    })
                    .join(' ');
            }

            // Extract suffix from name string (Jr, Sr, II, III, IV)
            function extractSuffixFromName(nameText) {
                const suffixPatterns = /\b(Jr\.?|Sr\.?|II|III|IV|2nd|3rd|4th)\b/gi;
                const match = nameText.match(suffixPatterns);
                if (match) {
                    const suffix = match[0].replace(/\./g, '');
                    return {
                        suffix: suffix.toUpperCase() === 'JR' || suffix === 'Jr' ? 'Jr.' :
                                suffix.toUpperCase() === 'SR' || suffix === 'Sr' ? 'Sr.' :
                                suffix.toUpperCase(),
                        cleanedName: nameText.replace(suffixPatterns, '').trim()
                    };
                }
                return { suffix: '', cleanedName: nameText };
            }

            // Clean gender field with optimized matching
            function cleanGender(text) {
                if (!text) return "";

                // Sanitize and normalize
                const cleaned = sanitizeOCRText(text)
                    .replace(/[^a-zA-Z]/g, "")
                    .toUpperCase();

                // Skip if too short
                if (cleaned.length === 0) return "";

                // Optimized pattern matching using regex for better performance
                if (/^(M|MALE|LALAKI|MAN)$/i.test(cleaned) || cleaned.includes("MALE")) {
                    return "Male";
                }
                if (/^(F|FEMALE|BABAE|WOMAN)$/i.test(cleaned) || cleaned.includes("FEMALE")) {
                    return "Female";
                }

                return "";
            }

            // Clean barangay field with improved precision
            function cleanBarangay(text) {
                if (!text) return "";

                // Sanitize first
                let cleaned = sanitizeOCRText(text);

                // Keep only valid barangay characters
                cleaned = cleaned.replace(/[^a-zA-Z0-9\s\-().ñÑ]/g, "");

                // Remove OCR artifacts
                cleaned = cleaned
                    .replace(/\b[a-z0-9]\b/gi, "")     // Remove standalone single chars
                    .replace(/\s{2,}/g, " ")           // Normalize spaces
                    .replace(/^[\s\-().]+|[\s\-().]+$/g, ""); // Trim special chars

                // Skip if too short
                if (cleaned.length < 3) return "";

                // Proper case formatting
                return cleaned
                    .toLowerCase()
                    .split(/\s+/)
                    .filter(word => word.length > 0)
                    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
                    .join(' ');
            }

            // Clean civil status field with optimized matching
            function cleanCivilStatus(text) {
                if (!text) return "";

                // Sanitize and normalize
                const cleaned = sanitizeOCRText(text)
                    .replace(/[^a-zA-Z]/g, "")
                    .toLowerCase();

                // Skip if too short
                if (cleaned.length < 4) return "";

                // Optimized pattern matching with regex
                if (/^(single|solo|unmarried)$/.test(cleaned) || cleaned.includes("single")) {
                    return "Single";
                }
                if (/^(married|kasal)$/.test(cleaned) || cleaned.includes("married")) {
                    return "Married";
                }
                if (/^(widow|widowed|balo)$/.test(cleaned) || cleaned.includes("widow")) {
                    return "Widowed";
                }
                if (/^(separated|hiwalay)$/.test(cleaned) || cleaned.includes("separated")) {
                    return "Separated";
                }
                if (/^(divorced|diborsyado)$/.test(cleaned) || cleaned.includes("divorc")) {
                    return "Divorced";
                }

                return "";
            }

            // General text cleaner for addresses and misc fields
            function cleanText(text) {
                if (!text) return "";

                return sanitizeOCRText(text)
                    .replace(/[^a-zA-Z0-9\s\-,.]/g, '')
                    .replace(/\s{2,}/g, ' ')
                    .trim();
            }

            // Alias for compatibility
            function cleanSex(text) {
                return cleanGender(text);
            }

            function updateFormFields(idNumber, firstName, middleName, lastName, birthdate, sex) {
                // Debug logging
                console.log('=== UPDATING FORM FIELDS ===');
                console.log('Raw First Name:', firstName);
                console.log('Raw Middle Name:', middleName);
                console.log('Raw Last Name:', lastName);
                console.log('Raw Gender:', sex);

                // Apply cleaning functions before populating fields
                const cleanedFirstName = firstName ? cleanName(firstName) : '';
                const cleanedMiddleName = middleName ? cleanName(middleName) : '';
                const cleanedLastName = lastName ? cleanName(lastName) : '';
                const cleanedGender = sex ? cleanGender(sex) : '';

                console.log('Cleaned First Name:', cleanedFirstName);
                console.log('Cleaned Middle Name:', cleanedMiddleName);
                console.log('Cleaned Last Name:', cleanedLastName);
                console.log('Cleaned Gender:', cleanedGender);

                const idnumberField = document.getElementById('idnumber');
                const firstnameField = document.getElementById('firstname');
                const middlenameField = document.getElementById('middlename');
                const lastnameField = document.getElementById('lastname');
                const birthdateField = document.getElementById('birthdate');
                const sexField = document.getElementById('sex');

                if (idNumber && idnumberField) idnumberField.value = idNumber;
                if (cleanedFirstName && firstnameField) firstnameField.value = cleanedFirstName;
                if (cleanedMiddleName && middlenameField) middlenameField.value = cleanedMiddleName;
                if (cleanedLastName && lastnameField) lastnameField.value = cleanedLastName;
                if (birthdate && birthdateField) birthdateField.value = birthdate;
                if (cleanedGender && sexField) sexField.value = cleanedGender;

                // Show success message
                if (resultBox) {
                    resultBox.classList.remove('hidden');
                    resultBox.textContent = "Information extracted from ID. Please verify the details.";
                }
            }

            function validateFile(file) {
                const validTypes = ['image/jpeg', 'image/png', 'image/jpg'];
                const maxSize = 5 * 1024 * 1024; // 5MB

                if (!validTypes.includes(file.type)) {
                    alert('Please upload a valid image file (JPEG or PNG).');
                    return false;
                }

                if (file.size > maxSize) {
                    alert('File size exceeds 5MB limit.');
                    return false;
                }

                return true;
            }

            // ═══════════════════════════════════════════════════════════════
            // 🔍 NAME VALIDATION BEFORE FORM SUBMISSION
            // ═══════════════════════════════════════════════════════════════

            // Normalize name for comparison (same as backend)
                   function normalizePhilippineName(name) {
            if (!name) return "";

            let normalized = name.toLowerCase().trim();

            // Remove periods and extra spaces (EXACTLY like server-side)
            normalized = normalized.replace(/\./g, "").replace(/\s+/g, " ").trim();

            // Normalize Filipino compound name particles (EXACTLY like server-side)
            const normalizationMap = {
                'dela cruz': 'delacruz',
                'de la cruz': 'delacruz',
                'delos santos': 'delossantos',
                'de los santos': 'delossantos',
                'delos reyes': 'delosreyes',
                'de los reyes': 'delosreyes',
                'dela rosa': 'delarosa',
                'de la rosa': 'delarosa',
                'dela paz': 'delapaz',
                'de la paz': 'delapaz',
                'del rosario': 'delrosario',
                'de guzman': 'deguzman',
                'san jose': 'sanjose',
                'san juan': 'sanjuan',
                'santa maria': 'santamaria',
                'santa cruz': 'santacruz'
            };

            // Apply normalization (EXACTLY like server-side)
            Object.keys(normalizationMap).forEach(key => {
                const regex = new RegExp(key, 'gi');
                normalized = normalized.replace(regex, normalizationMap[key]);
            });

            return normalized;
        }

        // Show name mismatch modal
        function showNameMismatchModal(registeredName, idName) {
            // Update modal content
            document.getElementById('registeredNameDisplay').textContent = registeredName;
            document.getElementById('idNameDisplay').textContent = idName;

            // Show the modal
            const modal = new bootstrap.Modal(document.getElementById('nameMismatchModal'));
            modal.show();

            // Highlight the name fields in red
            const firstnameField = document.getElementById('firstname');
            const lastnameField = document.getElementById('lastname');

            if (firstnameField) {
                firstnameField.classList.add('border-red-500', 'bg-red-50');
                firstnameField.focus();
            }
            if (lastnameField) {
                lastnameField.classList.add('border-red-500', 'bg-red-50');
            }
        }

        // Clear uploaded files and reset form
        function clearUploadedFilesAndReset() {
            // Clear file inputs
            if (fileFront) fileFront.value = '';
            if (fileBack) fileBack.value = '';

            // Hide preview images
            if (imagePreview) imagePreview.classList.add('hidden');
            if (imagePreviewBack) imagePreviewBack.classList.add('hidden');

            // Remove active class from upload areas
            if (uploadFront) uploadFront.classList.remove('active');
            if (uploadBack) uploadBack.classList.remove('active');

            // Clear extracted data from form fields
            const fieldsToClear = ['idnumber', 'firstname', 'middlename', 'lastname', 'birthdate', 'sex'];
            fieldsToClear.forEach(fieldId => {
                const field = document.getElementById(fieldId);
                if (field) {
                    field.value = '';
                    field.classList.remove('border-red-500', 'bg-red-50');
                }
            });

            // Reset name fields styling
            const firstnameField = document.getElementById('firstname');
            const lastnameField = document.getElementById('lastname');
            if (firstnameField) firstnameField.classList.remove('border-red-500', 'bg-red-50');
            if (lastnameField) lastnameField.classList.remove('border-red-500', 'bg-red-50');

            // Reset OCR status
            if (status) {
                status.innerHTML = '<i class="fas fa-info-circle mr-2"></i>Select a document to begin';
            }
            if (resultBox) resultBox.classList.add('hidden');
            if (davaoVerification) davaoVerification.classList.add('hidden');

            // Hide wrong ID warning
            hideWrongIdTypeWarning();
        }

        // Helper function to check if string is null or empty (like C# String.IsNullOrEmpty)
        function stringIsNullOrEmpty(str) {
            return str === null || str === undefined || str === '' || str.trim() === '';
        }

        // Enhanced name validation function (EXACTLY like server-side logic)
        function validateNameMatch() {
            if (!registeredFirstName || !registeredLastName) {
                console.warn('Registered name information not available');
                return true; // Allow submission if registered names aren't available
            }

            const firstnameField = document.getElementById('firstname');
            const lastnameField = document.getElementById('lastname');
            const middlenameField = document.getElementById('middlename');

            if (!firstnameField || !lastnameField) {
                console.error('Name fields not found');
                return true; // Allow submission if fields don't exist
            }

            const idFirstName = firstnameField.value.trim();
            const idLastName = lastnameField.value.trim();
            const idMiddleName = middlenameField ? middlenameField.value.trim() : '';

            // Check if name fields are empty (EXACTLY like server-side logic)
            if (stringIsNullOrEmpty(idFirstName) || stringIsNullOrEmpty(idLastName)) {
                console.log('Name fields are empty - validation skipped');
                return true; // Allow empty fields (they might be required separately)
            }

            // Normalize names for comparison (EXACTLY like server-side)
            const normalizedIdFirstName = normalizePhilippineName(idFirstName);
            const normalizedIdLastName = normalizePhilippineName(idLastName);
            const normalizedRegFirstName = normalizePhilippineName(registeredFirstName);
            const normalizedRegLastName = normalizePhilippineName(registeredLastName);

            // Debug logging
            console.log('=== ENHANCED NAME VALIDATION (SERVER-SIDE MATCH) ===');
            console.log('ID First Name:', idFirstName, '(normalized:', normalizedIdFirstName + ')');
            console.log('ID Last Name:', idLastName, '(normalized:', normalizedIdLastName + ')');
            console.log('Registered First Name:', registeredFirstName, '(normalized:', normalizedRegFirstName + ')');
            console.log('Registered Last Name:', registeredLastName, '(normalized:', normalizedRegLastName + ')');
            console.log('First Name Match:', normalizedIdFirstName === normalizedRegFirstName);
            console.log('Last Name Match:', normalizedIdLastName === normalizedRegLastName);

            // Check for exact match (EXACTLY like server-side logic)
            const firstNameMatches = !stringIsNullOrEmpty(registeredFirstName) &&
                                    !stringIsNullOrEmpty(idFirstName) &&
                                    normalizedRegFirstName === normalizedIdFirstName;

            const lastNameMatches = !stringIsNullOrEmpty(registeredLastName) &&
                                   !stringIsNullOrEmpty(idLastName) &&
                                   normalizedRegLastName === normalizedIdLastName;

            // Validation fails if either first name or last name doesn't match (EXACTLY like server-side)
            if (!firstNameMatches || !lastNameMatches) {
                // Prepare display names
                const registeredDisplayName = `${registeredFirstName} ${registeredMiddleName || ''} ${registeredLastName} ${registeredSuffix || ''}`.replace(/\s+/g, ' ').trim();
                const idDisplayName = `${idFirstName} ${idMiddleName || ''} ${idLastName}`.replace(/\s+/g, ' ').trim();

                console.log('❌ NAME VALIDATION FAILED');
                console.log('Registered:', registeredDisplayName);
                console.log('ID Name:', idDisplayName);

                // Show the modal
                showNameMismatchModal(registeredDisplayName, idDisplayName);
                return false;
            }

            console.log('✅ NAME VALIDATION PASSED');
            return true;
        }

        // Form validation
        const registrationForm = document.getElementById('registrationForm');
        if (registrationForm) {
            registrationForm.addEventListener('submit', function(e) {
                console.log('=== FORM SUBMISSION VALIDATION STARTED ===');

                // Check terms and conditions
                if (!terms || !terms.checked) {
                    alert('You must agree to the terms and conditions.');
                    e.preventDefault();
                    return;
                }

                // Validate name matching (EXACTLY like server-side)
                const isNameValid = validateNameMatch();
                if (!isNameValid) {
                    e.preventDefault();
                    console.log('❌ FORM SUBMISSION BLOCKED - Name validation failed');

                    // Scroll to top to show the name fields
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                    return false;
                }

                console.log('✅ FORM VALIDATION PASSED - Submitting form');
            });
        }

        // Real-time name validation (optional - for better UX)
        function setupRealTimeValidation() {
            const firstnameField = document.getElementById('firstname');
            const lastnameField = document.getElementById('lastname');

            if (firstnameField && lastnameField) {
                // Validate on blur (when user leaves the field)
                firstnameField.addEventListener('blur', function() {
                    validateNameMatch();
                });
                lastnameField.addEventListener('blur', function() {
                    validateNameMatch();
                });

                // Remove error styling when user starts typing
                firstnameField.addEventListener('input', function() {
                    this.classList.remove('border-red-500', 'bg-red-50');
                });
                lastnameField.addEventListener('input', function() {
                    this.classList.remove('border-red-500', 'bg-red-50');
                });
            }
        }
        });
    </script>

    <!-- Name Mismatch Modal -->
    <div class="modal fade" id="nameMismatchModal" tabindex="-1" aria-labelledby="nameMismatchModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-3xl shadow-2xl overflow-hidden bg-gradient-to-br from-white to-red-50">
                <!-- Header -->
                <div class="modal-header bg-gradient-to-r from-red-500 to-red-600 text-white py-4 px-6 border-b-0">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center">
                            <i class="fas fa-exclamation-triangle text-white text-lg"></i>
                        </div>
                        <div>
                            <h5 class="modal-title font-bold text-lg tracking-wide" id="nameMismatchModalLabel">
                                Name Verification Failed
                            </h5>
                            <p class="text-red-100 text-sm font-normal">ID doesn't match registered account</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <!-- Body -->
                <div class="modal-body p-6">
                    <div class="text-center mb-4">
                        <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-3">
                            <i class="fas fa-times text-red-500 text-2xl"></i>
                        </div>
                        <h4 class="text-xl font-bold text-red-800 mb-2">Name Doesn't Match</h4>
                        <p class="text-gray-700 mb-4">
                            The name on your ID doesn't match your registered account information.
                            <strong>First name and last name must match exactly</strong> (excluding middle name variations).
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-4 border border-red-200 mb-4">
                        <div class="grid grid-cols-2 gap-4 text-sm">
                            <div>
                                <h6 class="font-semibold text-red-700 mb-2">Your Registered Name</h6>
                                <div class="bg-gray-50 rounded-lg p-3">
                                    <p class="font-medium text-gray-800" id="registeredNameDisplay"></p>
                                </div>
                            </div>
                            <div>
                                <h6 class="font-semibold text-red-700 mb-2">Name on Your ID</h6>
                                <div class="bg-gray-50 rounded-lg p-3">
                                    <p class="font-medium text-gray-800" id="idNameDisplay"></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="bg-amber-50 border-l-4 border-amber-400 rounded-xl p-4">
                        <div class="flex items-start gap-3">
                            <i class="fas fa-lightbulb text-amber-500 text-lg mt-0.5"></i>
                            <div>
                                <h6 class="font-semibold text-amber-800 mb-1">Important Notice</h6>
                                <p class="text-amber-700 text-sm">
                                    For security purposes, you must use your own valid ID that matches your registered account name exactly.
                                    <strong>First name and last name must be identical</strong> to your registered information.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer -->
                <div class="modal-footer bg-gray-50 py-4 px-6 border-t-0">
                    <div class="w-full flex flex-col sm:flex-row gap-3">
                        <button type="button" class="w-full bg-red-600 hover:bg-red-700 text-white px-6 py-3 rounded-xl font-semibold shadow-sm hover:shadow-md transition-all duration-300 flex items-center justify-center gap-2" data-bs-dismiss="modal">
                            <i class="fas fa-times"></i>
                            Close
                        </button>
                        <button type="button" class="w-full bg-gray-600 hover:bg-gray-700 text-white px-6 py-3 rounded-xl font-semibold shadow-sm hover:shadow-md transition-all duration-300 flex items-center justify-center gap-2" onclick="clearUploadedFilesAndReset()">
                            <i class="fas fa-redo"></i>
                            Try Again
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
