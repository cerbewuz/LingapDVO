@model VerifyaccountDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Register</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Tesseract.js for OCR -->
    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@4/dist/tesseract.min.js"></script>

    <style>
        /* Your existing CSS styles here */
        body {
            background-color: #f8f9fa;
        }

        /* Go Back button styling for upper left */
        .go-back-top {
            position: fixed;
            left: 30px;
            top: 30px;
            z-index: 1000;
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 8px 16px;
            border-radius: 30px;
            background: rgba(255, 255, 255, 0.9);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            transition: all 0.2s;
            cursor: pointer;
            border: 1px solid #DC143C;
            color: #DC143C;
            text-decoration: none;
            font-weight: bold;
        }

            .go-back-top:hover, .go-back-top:focus {
                background: #DC143C;
                color: #fff !important;
                box-shadow: 0 4px 16px rgba(220, 20, 60, 0.15);
                transform: translateY(-2px);
                text-decoration: none;
            }

        .register-form {
            background: white;
            border-radius: 10px;
            padding: 30px;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
        }

        .cobalt-text {
            color: black !important;
        }

        .btn-cobalt {
            background-color: #DC143C;
            color: white;
            border: none;
        }

            .btn-cobalt:hover {
                background-color: #b01030;
                color: white;
            }

        .password-strength {
            height: 5px;
            margin-top: 5px;
            margin-bottom: 15px;
            display: none;
            border-radius: 5px;
            transition: width 0.3s, background-color 0.3s;
        }

        .password-requirements {
            font-size: 0.8rem;
            color: #6c757d;
            margin-top: 5px;
        }

        .requirement {
            margin-bottom: 3px;
            transition: color 0.3s;
        }

        .valid {
            color: #28a745;
        }

        .invalid {
            color: #dc3545;
        }

        .form-control:focus {
            border-color: #DC143C;
            box-shadow: 0 0 0 0.25rem rgba(220, 20, 60, 0.25);
        }

        #imagePreview {
            width: 200px;
            height: 200px;
            object-fit: cover;
            border-radius: 50%;
            margin-top: 10px;
            display: none;
            border: 2px solid #DC143C;
        }

        .phone-input-group {
            position: relative;
        }

        .phone-prefix {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            z-index: 5;
            color: #6c757d;
        }

        .phone-input {
            padding-left: 40px !important;
        }

        /* ID Upload Styles */
        .id-upload-container {
            display: flex;
            gap: 20px;
            margin-bottom: 15px;
        }

        .id-upload-section {
            flex: 1;
            border: 2px dashed #ddd;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
            transition: all 0.3s;
        }

            .id-upload-section:hover {
                border-color: #DC143C;
            }

            .id-upload-section.active {
                border-color: #DC143C;
                background-color: rgba(220, 20, 60, 0.05);
            }

        .id-preview {
            max-width: 100%;
            max-height: 150px;
            margin-top: 10px;
            display: none;
            border-radius: 5px;
        }

        .id-upload-label {
            cursor: pointer;
            display: block;
        }

        .id-upload-icon {
            font-size: 2rem;
            color: #DC143C;
            margin-bottom: 10px;
        }

        .id-upload-text {
            font-weight: bold;
            margin-bottom: 5px;
        }

        .id-upload-hint {
            font-size: 0.8rem;
            color: #6c757d;
        }

        .id-type-selector {
            margin-bottom: 15px;
        }

        .extracted-text {
            margin-top: 10px;
            padding: 8px;
            background-color: #f8f9fa;
            border-radius: 5px;
            font-size: 0.8rem;
            max-height: 100px;
            overflow-y: auto;
            border: 1px solid #ddd;
        }

        /* OCR Status Styles */
        #ocr-status {
            margin-top: 10px;
            font-size: 0.9rem;
        }

        .progress {
            height: 10px;
            margin-top: 5px;
            display: none;
        }

        #ocr-result {
            display: none;
            margin-top: 15px;
            padding: 10px;
            background-color: #f8f9fa;
            border-radius: 5px;
            border: 1px solid #ddd;
        }

        .disabled {
            opacity: 0.5;
            pointer-events: none;
        }

        #document-warning {
            display: none;
            color: #dc3545;
            font-size: 0.9rem;
            margin-top: 5px;
        }
    </style>
</head>
<body>
    <div>
    <!-- Go Back Button -->
    <a href="javascript:void(0)" class="go-back-top" id="goBackBtn">
        <i class="fas"></i> Go Back
    </a>
    </div>

    <section class="register container-fluid">
        <div class="row min-vh-100 d-flex justify-content-center align-items-center">
            <div class="col-md-8 col-lg-6">
                <div class="register-form text-center text-dark">
                    <article class="mb-4">
                        <h1 class="cobalt-text fw-bold">Verify Your Account</h1>
           
                    </article>

                    <form asp-action="Accountverification" method="post" enctype="multipart/form-data" id="registrationForm">

                        <!-- ID Upload Section -->
                        <div class="mb-3 text-start">
                            <label class="form-label fw-bold"><i class="fa-solid fa-id-card fa-lg me-2 cobalt-text"></i>Valid ID Verification</label>

                            <div class="mb-3">
                                <label class="form-label">ID Type</label>
                                <select asp-for="IDtype" class="form-control" id="document-type" required>
                                    <option value="">Select Valid ID</option>
                                    <option value="phil-id">Philippine Identification Card / National ID</option>
                                    <option value="driver-license">Driver's License</option>
                                </select>
                                <span asp-validation-for="IDtype" class="text-danger"></span>
                                <div id="document-warning">OCR is not available for the selected document type</div>
                            </div>
                        </div>

                        <div class="id-upload-container">
                            <div class="id-upload-section" id="upload-area-front">
                                <label class="id-upload-label">
                                    <div class="id-upload-icon">
                                        <i class="fas fa-id-card"></i>
                                    </div>
                                    <div class="id-upload-text">Front of ID</div>
                                    <div class="id-upload-hint">Click to upload or drag and drop</div>
                                    <input asp-for="ValidFrontID" type="file" id="file-input-front" class="d-none" accept="image/*">
                                    <img id="image-preview" class="id-preview" alt="Front ID Preview">
                                    <span asp-validation-for="ValidFrontID" class="text-danger"></span>
                                </label>
                            </div>

                            <div class="id-upload-section" id="upload-area-back">
                                <label class="id-upload-label">
                                    <div class="id-upload-icon">
                                        <i class="fas fa-id-card"></i>
                                    </div>
                                    <div class="id-upload-text">Back of ID</div>
                                    <div class="id-upload-hint">Click to upload or drag and drop</div>
                                    <input asp-for="ValidBackID" type="file" id="file-input-back" class="d-none" accept="image/*">
                                    <img id="image-preview-back" class="id-preview" alt="Back ID Preview">
                                    <span asp-validation-for="ValidBackID" class="text-danger"></span>
                                </label>
                            </div>
                        </div>

                        <!-- OCR Status -->
                        <div id="ocr-status">Select a document to begin</div>
                        <div class="progress" id="progress-bar">
                            <div class="progress-bar progress-bar-striped progress-bar-animated"
                                 role="progressbar" id="progress" style="width: 0%"></div>
                        </div>
                        <div id="ocr-result"></div>

                        <small class="text-muted">Upload clear images of your valid ID (JPEG, PNG). Max file size: 5MB each.</small>
                        <br />
                        <br />

                        <div class="mb-3 text-start">
                            <label class="form-label">Phone Number</label>
                            <input asp-for="Phonenumber" type="text" id="phonenumber"
                                   class="form-control"
                                   placeholder="Enter your phone number"
                                   required
                                   inputmode="numeric"
                                   pattern="[0-9]{10,11}"
                                   oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                            <span asp-validation-for="Phonenumber" class="text-danger"></span>
                            <small class="text-muted">Enter a valid 10-11 digit phone number</small>
                        </div>


                        <div class="row mb-3 text-start">
                            <label class="form-label fw-bold"><i class="fa-solid fa-list-check fa-lg me-2 cobalt-text"></i>User Information</label>
                            <br />
                            <br />
                            <div class="col-md-6">
                                <label><i></i>Last Name *</label>
                                <input asp-for="Lastname" type="text" id="lastname" class="form-control" placeholder="Enter your last name" required>
                                <span asp-validation-for="Lastname" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label><i></i>First Name *</label>
                                <input asp-for="Firstname" type="text" id="firstname" class="form-control" placeholder="Enter your first name" required>
                                <span asp-validation-for="Firstname" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3 text-start">
                            <div class="col-md-6">
                                <label><i></i>Middle Name</label>
                                <input asp-for="Middlename" type="text" id="middlename" class="form-control" placeholder="Enter your middle name">
                                <span asp-validation-for="Middlename" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label><i></i>Suffix</label>
                                <select asp-for="Suffix" class="form-control">
                                    <option value="None">None</option>
                                    <option value="Jr.">Jr</option>
                                    <option value="Sr.">Sr</option>
                                    <option value="II">II</option>
                                    <option value="III">III</option>
                                    <option value="IV">IV</option>
                                </select>
                                <span asp-validation-for="Suffix" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3 text-start">
                            <label class="form-label fw-bold"><i class="fa-solid fa-venus-mars fa-lg me-2 cobalt-text"></i>Gender</label>
                            <select asp-for="Gender" class="form-control" id="sex">
                                <option value="">Select</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger"></span>
                        </div>

                        <div class="mb-3 text-start">
                            <label class="form-label fw-bold"><i class="fa-solid fa-calendar fa-lg me-2 cobalt-text"></i>Date of Birth</label>
                            <input asp-for="Dateofbirth" type="date" id="birthdate" class="form-control" required>
                            <span asp-validation-for="Dateofbirth" class="text-danger"></span>
                        </div>

                        <!-- Replace the existing Address field with this detailed version -->
                        <div class="mb-3 text-start">
                            <br />
                            <label class="form-label fw-bold"><i class="fa-solid fa-home fa-lg me-2 cobalt-text"></i>Address</label>
                            <br />
                            <div class="row mb-2">
                                <div class="col-md-8">
                                    <label class="form-label">Blk / Lot / Street *</label>
                                    <input asp-for="BlkLotStreet" type="text" class="form-control" placeholder="Enter block, lot, or street" required>
                                    <span asp-validation-for="BlkLotStreet" class="text-danger"></span>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Sub / Vill.</label>
                                    <input asp-for="SubVill" type="text" class="form-control" placeholder="Enter subdivision or village">
                                    <span asp-validation-for="SubVill" class="text-danger"></span>
                                </div>
                            </div>

