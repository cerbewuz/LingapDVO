            // Populate uploaded images in review page
            populateImages: function() {
                // Front ID
                const frontImg = document.getElementById('preview-front-img');
                const reviewFrontImg = document.getElementById('review-front-img');
                const reviewFrontPlaceholder = document.getElementById('review-front-placeholder');

                if (frontImg && !frontImg.classList.contains('hidden') && frontImg.src) {
                    if (reviewFrontImg) {
                        reviewFrontImg.src = frontImg.src;
                        reviewFrontImg.classList.remove('hidden');
                    }
                    if (reviewFrontPlaceholder) {
                        reviewFrontPlaceholder.classList.add('hidden');
                    }
                } else {
                    if (reviewFrontImg) reviewFrontImg.classList.add('hidden');
                    if (reviewFrontPlaceholder) reviewFrontPlaceholder.classList.remove('hidden');
                }

                // Back ID
                const backImg = document.getElementById('preview-back-img');
                const reviewBackImg = document.getElementById('review-back-img');
                const reviewBackPlaceholder = document.getElementById('review-back-placeholder');

                if (backImg && !backImg.classList.contains('hidden') && backImg.src) {
                    if (reviewBackImg) {
                        reviewBackImg.src = backImg.src;
                        reviewBackImg.classList.remove('hidden');
                    }
                    if (reviewBackPlaceholder) {
                        reviewBackPlaceholder.classList.add('hidden');
                    }
                } else {
                    if (reviewBackImg) reviewBackImg.classList.add('hidden');
                    if (reviewBackPlaceholder) reviewBackPlaceholder.classList.remove('hidden');
                }

                // Selfie
                const selfieImg = document.getElementById('preview-selfie-img');
                const reviewSelfieImg = document.getElementById('review-selfie-img');
                const reviewSelfiePlaceholder = document.getElementById('review-selfie-placeholder');

                if (selfieImg && !selfieImg.classList.contains('hidden') && selfieImg.src) {
                    if (reviewSelfieImg) {
                        reviewSelfieImg.src = selfieImg.src;
                        reviewSelfieImg.classList.remove('hidden');
                    }
                    if (reviewSelfiePlaceholder) {
                        reviewSelfiePlaceholder.classList.add('hidden');
                    }
                } else {
                    if (reviewSelfieImg) reviewSelfieImg.classList.add('hidden');
                    if (reviewSelfiePlaceholder) reviewSelfiePlaceholder.classList.remove('hidden');
                }
            },

            // Display validation results with visual indicators
            displayValidationResults: function(results) {
                const container = document.getElementById('validation-results-container');
                if (!container) return;

                if (!results.hasData) {
                    container.innerHTML = `
                        <div class="bg-red-50 border-2 border-red-200 rounded-xl p-3 sm:p-4">
                            <div class="flex items-center gap-2 sm:gap-3">
                                <i class="fas fa-exclamation-triangle text-red-500 text-base sm:text-xl"></i>
                                <div>
                                    <p class="font-semibold text-red-800 text-sm sm:text-base">Verification Required</p>
                                    <p class="text-xs sm:text-sm text-red-600">Please complete ID verification in Tab 2 before proceeding.</p>
                                </div>
                            </div>
                        </div>
                    `;
                    return;
                }

                const { nameValidation, barangayValidation, davaoCityValidation } = results.validations;

                container.innerHTML = `
                    <div class="space-y-2 sm:space-y-3">
                        ${this.renderValidationItem('Name Verification', nameValidation)}
                        ${this.renderValidationItem('Barangay Verification', barangayValidation)}
                        ${this.renderValidationItem('Davao City Residency', davaoCityValidation)}
                    </div>
                `;
            },

            // Render individual validation item
            renderValidationItem: function(title, validation) {
                const isValid = validation.valid;
                const isWarning = validation.warning || false;

                const bgColor = isValid ? (isWarning ? 'bg-yellow-50' : 'bg-green-50') : 'bg-red-50';
                const borderColor = isValid ? (isWarning ? 'border-yellow-200' : 'border-green-200') : 'border-red-200';
                const iconColor = isValid ? (isWarning ? 'text-yellow-500' : 'text-green-500') : 'text-red-500';
                const textColor = isValid ? (isWarning ? 'text-yellow-800' : 'text-green-800') : 'text-red-800';
                const icon = isValid ? (isWarning ? 'fa-exclamation-circle' : 'fa-check-circle') : 'fa-times-circle';

                let detailsHtml = '';
                if (validation.errors && validation.errors.length > 0) {
                    detailsHtml = `
                        <ul class="mt-1 sm:mt-2 text-xs sm:text-sm ${textColor} space-y-1">
                            ${validation.errors.map(err => `<li class="flex items-start gap-1.5 sm:gap-2">
                                <i class="fas fa-circle text-[6px] sm:text-xs mt-1.5 sm:mt-1"></i>
                                <span>${err}</span>
                            </li>`).join('')}
                        </ul>
                    `;
                }

                return `
                    <div class="${bgColor} border-2 ${borderColor} rounded-xl p-3 sm:p-4">
                        <div class="flex items-start gap-2 sm:gap-3">
                            <i class="fas ${icon} ${iconColor} text-base sm:text-xl mt-0.5"></i>
                            <div class="flex-1 min-w-0">
                                <p class="font-semibold ${textColor} text-sm sm:text-base">${title}</p>
                                <p class="text-xs sm:text-sm ${textColor} mt-0.5 sm:mt-1 break-words">${validation.message}</p>
                                ${detailsHtml}
                            </div>
                        </div>
                    </div>
                `;
            },

            // Enable/disable submit button based on validation
            updateSubmitButton: function(isValid) {
                const submitButton = document.getElementById('verify-account-btn');
                if (!submitButton) return;

                if (isValid) {
                    submitButton.disabled = false;
                    submitButton.classList.remove('opacity-50', 'cursor-not-allowed', 'bg-gray-400');
                    submitButton.classList.add('submitbtn-color', 'hover:shadow-xl', 'transform', 'hover:scale-105');
                    submitButton.title = '';
                } else {
                    submitButton.disabled = true;
                    submitButton.classList.add('opacity-50', 'cursor-not-allowed', 'bg-gray-400');
                    submitButton.classList.remove('submitbtn-color', 'hover:shadow-xl', 'transform', 'hover:scale-105');
                    submitButton.title = 'Please resolve validation errors before submitting';
                }
            }
        };

        // Initialize wizard on page load
        document.addEventListener('DOMContentLoaded', function() {
            console.log('🧙‍♂️ Wizard navigation initialized');
            WizardNav.goToTab(1); // Start on Tab 1
        });

        // ═══════════════════════════════════════════════════════════════════════════
        // FINAL FORM VALIDATION - Validates Everything Before Submission
        // ═══════════════════════════════════════════════════════════════════════════

        function validateFinalSubmission() {
            console.log('🔍 Starting final form validation...');

            // ═══════════════════════════════════════════════════════════════════════════
            // SYNC ID TYPE AND ID NUMBER FROM TAB 2 TO HIDDEN FORM FIELDS
            // ═══════════════════════════════════════════════════════════════════════════
            // ID Type is auto-detected by the OCR system in Tab 2 (ID Verification Tab)
            // We need to copy the values to the hidden form fields before submission
            // ═══════════════════════════════════════════════════════════════════════════

            const idTypeDisplay = document.getElementById('idtype-display');
            const idTypeHidden = document.getElementById('document-type');
            const idTypeHiddenAlt = document.getElementById('idtype-hidden');
            if (idTypeDisplay && idTypeDisplay.value) {
                if (idTypeHidden) idTypeHidden.value = idTypeDisplay.value;
                if (idTypeHiddenAlt) idTypeHiddenAlt.value = idTypeDisplay.value;
                console.log('✅ Synced Auto-detected ID Type:', idTypeDisplay.value);
            }

            const idNumberField = document.getElementById('idnumber');
            if (idNumberField && idNumberField.value) {
                console.log('✅ ID Number already populated:', idNumberField.value);
            }

            let errors = [];

            // ═══════════════════════════════════════════════════════════════════════════
            // STEP 1: Validate Personal Information
            // ═══════════════════════════════════════════════════════════════════════════

            const requiredPersonalFields = [
                { id: 'lastname', label: 'Last Name' },
                { id: 'firstname', label: 'First Name' },
                { id: 'gender', label: 'Gender' },
                { id: 'civil-status', label: 'Civil Status' },
                { id: 'phonenumber', label: 'Phone Number' },
                { id: 'birthdate', label: 'Date of Birth' }
            ];

            for (let field of requiredPersonalFields) {
                const element = document.getElementById(field.id);
                if (!element || !element.value || element.value.trim() === '') {
                    errors.push(`${field.label} is required`);
                }
            }

            // ═══════════════════════════════════════════════════════════════════════════
            // STEP 2: Validate Address Information
            // ═══════════════════════════════════════════════════════════════════════════

            const requiredAddressFields = [
                { id: 'blklotstreet', label: 'Block/Lot/Street' },
                { id: 'barangay', label: 'Barangay' }
            ];

            for (let field of requiredAddressFields) {
                const element = document.getElementById(field.id);
                if (!element || !element.value || element.value.trim() === '') {
                    errors.push(`${field.label} is required`);
                }
            }

            // ═══════════════════════════════════════════════════════════════════════════
            // STEP 2.5: Validate Phone Number (11 digits) and Birthdate (16+ years)
            // ═══════════════════════════════════════════════════════════════════════════

            // Phone number validation
            const phoneInput = document.getElementById('phonenumber');
            if (phoneInput && phoneInput.value) {
                const phoneValue = phoneInput.value.replace(/[^0-9]/g, '');
                if (phoneValue.length !== 11) {
                    errors.push('Phone number must be exactly 11 digits');
                } else if (!phoneValue.startsWith('09')) {
                    errors.push('Phone number must start with 09');
                }
            }

            // Birthdate validation (must be at least 16 years old)
            const birthdateInput = document.getElementById('birthdate');
            if (birthdateInput && birthdateInput.value) {
                const birthdate = new Date(birthdateInput.value);
                const today = new Date();
                let age = today.getFullYear() - birthdate.getFullYear();
                const monthDiff = today.getMonth() - birthdate.getMonth();
                const dayDiff = today.getDate() - birthdate.getDate();
                
                if (monthDiff < 0 || (monthDiff === 0 && dayDiff < 0)) {
                    age--;
                }
                
                if (age < 16) {
                    errors.push('You must be at least 16 years old to register');
                }
            }

            // ═══════════════════════════════════════════════════════════════════════════
            // STEP 2.6: Validate Gender (compare with API-extracted gender if available)
            // ═══════════════════════════════════════════════════════════════════════════

            const genderField = document.getElementById('gender');
            const userGender = genderField?.value || '';
            const apiGender = window.apiExtractedGender || '';

            if (userGender && apiGender && window.validateGenderMatch) {
                const genderValidation = window.validateGenderMatch(userGender, apiGender);
                if (!genderValidation.isValid) {
                    errors.push(genderValidation.message);
                }
            }

            // ═══════════════════════════════════════════════════════════════════════════
            // STEP 3: Validate Terms and Conditions
            // ═══════════════════════════════════════════════════════════════════════════

            const termsCheckbox = document.getElementById('terms');
            if (!termsCheckbox || !termsCheckbox.checked) {
                errors.push('You must agree to the Terms and Conditions');
            }

            // ═══════════════════════════════════════════════════════════════════════════
            // STEP 4: Validate ID Type (Auto-detected from ID verification)
            // ═══════════════════════════════════════════════════════════════════════════

            const idTypeField = document.getElementById('idtype-display');
            if (!idTypeField || !idTypeField.value) {
                errors.push('ID Type could not be detected. Please complete ID verification first.');
            }

            // ═══════════════════════════════════════════════════════════════════════════
            // STEP 5: Validate ID Document Uploads - Uses VerificationState
            // ═══════════════════════════════════════════════════════════════════════════

            // Check Front ID - use VerificationState (images are converted to Base64 and stored there)
            const hasFrontId = (typeof VerificationState !== 'undefined' && VerificationState.frontIdUploaded);
            if (!hasFrontId) {
                errors.push('Front ID photo is required');
            }

            // Check Back ID - use VerificationState
            const hasBackId = (typeof VerificationState !== 'undefined' && VerificationState.backIdUploaded);
            if (!hasBackId) {
                errors.push('Back ID photo is required');
            }

            // Check Selfie/Face Picture - Now checks VerificationState instead of hidden field
            const hasSelfie = (typeof VerificationState !== 'undefined' && VerificationState.selfieUploaded);
            if (!hasSelfie) {
                errors.push('Selfie/Face photo is required');
            }

            // NOTE: ID Number is NOT validated here as it's auto-populated by the ID Analyzer API
            // after the user uploads their ID documents. It will be filled automatically.

            // ═══════════════════════════════════════════════════════════════════════════
            // Display Validation Results
            // ═══════════════════════════════════════════════════════════════════════════

            if (errors.length > 0) {
                console.error('❌ Validation failed:', errors);

                // Create error message
                let errorMessage = '<div class="text-left"><strong>Please correct the following errors:</strong><ul class="mt-2 ml-4 list-disc">';
                errors.forEach(error => {
                    errorMessage += `<li>${error}</li>`;
                });
                errorMessage += '</ul></div>';

                // Show error modal
                Swal.fire({
                    icon: 'error',
                    title: 'Validation Failed',
                    html: errorMessage,
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#dc2626',
                    customClass: {
                        popup: 'rounded-2xl',
                        title: 'text-2xl font-bold',
                        htmlContainer: 'text-sm'
                    }
                });

                return false; // Prevent form submission
            }

            console.log('✅ All validations passed - submitting form');
            return true; // Allow form submission
        }

        // ═══════════════════════════════════════════════════════════════════════════
        // TAB 2: MONITOR API PROCESSING & ENABLE NEXT BUTTON
        // ═══════════════════════════════════════════════════════════════════════════

        const Tab2Controller = {
            apiProcessing: false,
            apiCompleted: false,
            progressBarVisible: false,

            // Show progress bar when API processing starts
            showProgressBar: function() {
                const progressContainer = document.getElementById('api-processing-status');
                if (progressContainer && !this.progressBarVisible) {
                    progressContainer.classList.remove('hidden');
                    this.progressBarVisible = true;
                    console.log('📊 Progress bar shown - API processing started');
                    console.log('📊 Progress will be driven by real API calls via ProgressTracker');
                }
            },

            // Hide progress bar when API processing completes
            hideProgressBar: function() {
                // The ProgressTracker will handle setting everything to 100%
                // Just hide the container after a delay
                const progressContainer = document.getElementById('api-processing-status');
                if (progressContainer && this.progressBarVisible) {
                    setTimeout(() => {
                        progressContainer.classList.add('hidden');
                        this.progressBarVisible = false;
                        console.log('✅ Progress bar hidden - API processing complete');
                    }, 2000);
                }
            },

            // Called when API processing starts (from finishAndVerify)
            onAPIStart: function() {
                console.log('🚀 API processing started');
                this.apiProcessing = true;
                this.apiCompleted = false;
                this.showProgressBar();
                // Progress will be updated by ProgressTracker.updateProgress() in verification-idanalyzer.js
            },

            // Called when API processing completes successfully
            onAPIComplete: function() {
                console.log(' API processing completed successfully');
                this.apiProcessing = false;
                this.apiCompleted = true;
                this.hideProgressBar();

                // Check if ID number is populated
                const idNumber = document.getElementById('idnumber');
                if (idNumber && idNumber.value && idNumber.value.trim() !== '') {
                    this.enableNextButton();
                } else {
                    console.warn('⚠️ API completed but ID number not populated yet - waiting...');
                    // Keep checking for ID number (max 5 seconds)
                    let attempts = 0;
                    const checkInterval = setInterval(() => {
                        attempts++;
                        const idNum = document.getElementById('idnumber');
                        if (idNum && idNum.value && idNum.value.trim() !== '') {
                            this.enableNextButton();
                            clearInterval(checkInterval);
                        } else if (attempts >= 10) {
                            console.error('❌ ID number not populated after 5 seconds');
                            clearInterval(checkInterval);
                            // Enable button anyway if verification was successful
                            if (typeof VerificationState !== 'undefined' && VerificationState.verificationComplete) {
                                this.enableNextButton();
                            }
                        }
                    }, 500);
                }
            },

            // Enable the "Next" button
            enableNextButton: function() {
                const nextBtn = document.getElementById('next-to-review-btn');
                const btnText = document.getElementById('next-btn-text');
                const btnIcon = nextBtn ? nextBtn.querySelector('i') : null;

                if (nextBtn) {
                    nextBtn.disabled = false;
                    nextBtn.classList.remove('bg-gray-300', 'text-gray-500', 'cursor-not-allowed');
                    nextBtn.classList.add('bg-gradient-to-r', 'from-green-500', 'to-green-600', 'hover:from-green-600', 'hover:to-green-700', 'text-white', 'shadow-lg', 'hover:shadow-xl', 'transform', 'hover:scale-105');

                    if (btnIcon) {
                        btnIcon.classList.remove('fa-lock');
                        btnIcon.classList.add('fa-arrow-right');
                    }

                    if (btnText) {
                        btnText.textContent = 'Next';
                    }

                    console.log('Next button enabled - user can proceed to Tab 3');
                }
            }
        };

        // Expose Tab2Controller globally for callbacks
        window.Tab2Controller = Tab2Controller;

        // Expose callback functions for API
