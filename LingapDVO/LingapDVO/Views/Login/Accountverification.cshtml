@model VerifyaccountDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Verification</title>
    <link rel="icon" type="image/x-icon" href="~/lingaplogo.ico">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

        <!-- Go Back Button (Uniform) -->
    <button id="goBackBtn">
        <i class="fas fa-arrow-left"></i>
        <span>Go Back</span>
    </button>

    <div class="container mx-auto px-4 py-8">
        <div class="max-w-4xl mx-auto">
            <!-- Header -->
            <div class="text-center mb-8 fade-in">
                <h1 class="text-4xl font-bold text-gray-800 mb-2">Verify Your Account</h1>
            </div>

            <!-- Main Form Card -->
            <div class="bg-white rounded-2xl shadow-xl overflow-hidden glass-effect scale-in w-full max-w-full lg:max-w-4xl mx-auto">
                <div class="p-6 md:p-8">
                    <form asp-action="Accountverification" method="post" enctype="multipart/form-data" id="registrationForm" class="space-y-8">

                        <!-- ID Verification Section -->
                        <div class="space-y-6">
                            <div class="flex items-center gap-3 mb-2">
                                <div class="w-10 h-10 bg-red-50 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-id-card text-lg crimson-500"></i>
                                </div>
                                <h2 class="text-2xl font-bold text-gray-800">ID Verification</h2>
                            </div>

                            <!-- Auto-Detected ID Type (Hidden) -->
                            <input type="hidden" asp-for="IDtype" id="document-type" />

                            <!-- ID Type Display (Hidden - shown in console only) -->
                            <div id="id-type-display" class="hidden"></div>

                            <!-- ID Type Info -->
                            <div class="grid grid-cols-1 gap-6">
                                <div>
                                    <div class="text-sm text-gray-600 mb-4">
                                        <i class="fas fa-check-circle text-green-500 mr-1"></i>
                                        <strong>Accepted IDs:</strong> National ID, Driver's License, SSS ID, UMID
                                        <br>
                                        <i class="fas fa-info-circle text-blue-500 mr-1"></i>
                                        <em>The system will automatically detect your ID type</em>
                                    </div>
                                    <span asp-validation-for="IDtype" class="text-red-500 text-sm mt-1 block"></span>
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">ID Number</label>
                                    <input asp-for="IDnumber" type="text" id="idnumber"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                                           placeholder="Enter your ID number (letters, numbers, dashes allowed)"
                                           required
                                           maxlength="100"
                                           pattern="[A-Za-z0-9\-\/\s]+"
                                           title="ID Number can contain letters, numbers, dashes, slashes, and spaces">
                                    <span asp-validation-for="IDnumber" class="text-red-500 text-sm mt-1"></span>
                                </div>
                            </div>

                            <!-- ID Upload Sections -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <!-- Front ID Upload -->
                                <div class="upload-area rounded-xl p-6 text-center cursor-pointer" id="upload-area-front">
                                    <div class="id-upload-content">
                                        <div class="w-16 h-16 bg-red-50 rounded-full flex items-center justify-center mx-auto mb-4">
                                            <i class="fas fa-id-card text-2xl crimson-500"></i>
                                        </div>
                                        <div class="font-semibold text-gray-800 mb-2">Front of ID</div>
                                        <div class="text-gray-500 text-sm mb-4">Click to upload or drag and drop</div>
                                        <div class="text-xs text-gray-400 mb-2">Accepted formats: JPG, JPEG, PNG only</div>
                                        <input asp-for="ValidFrontID" type="file" id="file-input-front" class="hidden" accept="image/jpeg,image/jpg,image/png">
                                        <img id="image-preview" class="id-preview w-full max-w-xs mx-auto hidden" alt="Front ID Preview">
                                        <span asp-validation-for="ValidFrontID" class="text-red-500 text-sm mt-2 block"></span>
                                    </div>
                                </div>

                                <!-- Back ID Upload -->
                                <div class="upload-area rounded-xl p-6 text-center cursor-pointer" id="upload-area-back">
                                    <div class="id-upload-content">
                                        <div class="w-16 h-16 bg-red-50 rounded-full flex items-center justify-center mx-auto mb-4">
                                            <i class="fas fa-id-card text-2xl crimson-500"></i>
                                        </div>
                                        <div class="font-semibold text-gray-800 mb-2">Back of ID</div>
                                        <div class="text-gray-500 text-sm mb-4">Click to upload or drag and drop</div>
                                        <div class="text-xs text-gray-400 mb-2">Accepted formats: JPG, JPEG, PNG only</div>
                                        <input asp-for="ValidBackID" type="file" id="file-input-back" class="hidden" accept="image/jpeg,image/jpg,image/png">
                                        <img id="image-preview-back" class="id-preview w-full max-w-xs mx-auto hidden" alt="Back ID Preview">
                                        <span asp-validation-for="ValidBackID" class="text-red-500 text-sm mt-2 block"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- OCR Status -->
                            <div class="space-y-4">
                                <div id="ocr-status" class="text-gray-600 text-sm">
                                    <i class="fas fa-info-circle mr-2"></i>Select a document to begin
                                </div>

                                <div class="progress-bar-container hidden" id="progress-bar">
                                    <div class="w-full bg-gray-200 rounded-full h-2">
                                        <div class="bg-crimson-500 h-2 rounded-full transition-all duration-300"
                                             id="progress" style="width: 0%"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Davao Verification Result -->
                            <div id="davao-verification" class="hidden p-6 rounded-xl border-l-4 slide-down">
                                <div class="flex items-start gap-4">
                                    <i id="davao-result-icon" class="fas fa-check-circle text-2xl mt-1"></i>
                                    <div class="flex-1">
                                        <div class="flex items-center gap-3 mb-2">
                                            <h4 id="davao-result-title" class="font-semibold text-lg"></h4>
                                            <span id="davao-status-badge" class="px-3 py-1 rounded-full text-sm font-semibold"></span>
                                        </div>
                                        <p id="davao-result-message" class="text-gray-700"></p>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-sm">
                                <div class="flex items-start gap-3">
                                    <i class="fas fa-lightbulb text-blue-500 mt-0.5"></i>
                                    <div class="text-gray-700">
                                        <p class="font-semibold text-blue-700 mb-2">Tips for best results:</p>
                                        <ul class="space-y-1 list-disc list-inside">
                                            <li>Upload clear, well-lit images (JPEG or PNG format)</li>
                                            <li>Ensure all text on the ID is readable</li>
                                            <li>Avoid glare, shadows, or reflections</li>
                                            <li>Maximum file size: 5MB per image</li>
                                            <li>Supported IDs: National ID, Driver's License, SSS ID, UMID</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Personal Information Section -->
                        <div class="space-y-6">
                            <div class="flex items-center gap-3 mb-2">
                                <div class="w-10 h-10 bg-green-50 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-user text-lg text-green-500"></i>
                                </div>
                                <h2 class="text-2xl font-bold text-gray-800">Personal Information</h2>
                            </div>

                            <!-- Name Fields -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Last Name</label>
                                    <input asp-for="Lastname" type="text" id="lastname"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                                           placeholder="Enter your last name" required>
                                    <span asp-validation-for="Lastname" class="text-red-500 text-sm mt-1"></span>
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">First Name</label>
                                    <input asp-for="Firstname" type="text" id="firstname"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                                           placeholder="Enter your first name" required>
                                    <span asp-validation-for="Firstname" class="text-red-500 text-sm mt-1"></span>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Middle Name</label>
                                    <input asp-for="Middlename" type="text" id="middlename"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                                           placeholder="Enter your middle name">
                                    <span asp-validation-for="Middlename" class="text-red-500 text-sm mt-1"></span>
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Suffix</label>
                                    <select asp-for="Suffix" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300">
                                        <option value="None">None</option>
                                        <option value="Jr.">Jr</option>
                                        <option value="Sr.">Sr</option>
                                        <option value="II">II</option>
                                        <option value="III">III</option>
                                        <option value="IV">IV</option>
                                    </select>
                                    <span asp-validation-for="Suffix" class="text-red-500 text-sm mt-1"></span>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
                                <div>
                                    <label for="gender" class="block text-sm font-semibold text-gray-700 mb-2">Gender</label>
                                    <select id="gender" name="Gender" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-colors">
                                        <option value="">Select Gender</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                    </select>
                                    <div class="error-message hidden" id="gender-error"></div>
                                </div>

                                <div>
                                    <label for="civil-status" class="block text-sm font-semibold text-gray-700 mb-2">Civil Status</label>
                                    <select id="civil-status" name="CivilStatus" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-colors">
                                        <option value="">Select Civil Status</option>
                                        <option value="Single">Single</option>
                                        <option value="Married">Married</option>
                                        <option value="Widowed">Widowed</option>
                                        <option value="Separated">Separated</option>
                                        <option value="Divorced">Divorced</option>
                                    </select>
                                    <div class="error-message hidden" id="civilstatus-error"></div>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Phone Number</label>
                                    <input asp-for="Phonenumber" type="text" id="phonenumber"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                                           placeholder="Enter your phone number"
                                           required
                                           inputmode="numeric"
                                           pattern="[0-9]{10,11}"
                                           oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                                    <span asp-validation-for="Phonenumber" class="text-red-500 text-sm mt-1"></span>
                                    <small class="text-gray-500 text-sm">Enter a valid 10-11 digit phone number</small>
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Date of Birth</label>
                                    <input asp-for="Dateofbirth" type="date" id="birthdate"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                                           required>
                                    <span asp-validation-for="Dateofbirth" class="text-red-500 text-sm mt-1"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Address Section -->
                        <div class="space-y-6">
                            <div class="flex items-center gap-3 mb-2">
                                <div class="w-10 h-10 bg-purple-50 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-home text-lg text-purple-500"></i>
                                </div>
                                <h2 class="text-2xl font-bold text-gray-800">Address Information</h2>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Blk / Lot / Street</label>
                                    <input asp-for="BlkLotStreet" type="text"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                                           placeholder="Enter block, lot, or street" required>
                                    <span asp-validation-for="BlkLotStreet" class="text-red-500 text-sm mt-1"></span>
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Sub / Vill.</label>
                                    <input asp-for="SubVill" type="text"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                                           placeholder="Enter subdivision or village">
                                    <span asp-validation-for="SubVill" class="text-red-500 text-sm mt-1"></span>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Barangay</label>
                                    <select asp-for="Barangay" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300" required>
                                        <option value="" disabled selected>--Select Barangay--</option>
                                        <option value="Acacia">Acacia</option>
                                        <option value="Agdao">Agdao</option>
                                        <option value="Alambre">Alambre</option>
                                        <option value="Alejandro Navarro">Alejandro Navarro (Lasang)</option>
                                        <option value="Alfonso Angliongto Sr.">Alfonso Angliongto Sr.</option>
                                        <option value="Angalan">Angalan</option>
                                        <option value="Baguio Proper">Baguio Proper</option>
                                        <option value="Baliok">Baliok</option>
                                        <option value="Bangkas Heights">Bangkas Heights</option>
                                        <option value="Baracatan">Baracatan</option>
                                        <option value="Bato">Bato</option>
                                        <option value="Bayabas">Bayabas</option>
                                        <option value="Biao Escuela">Biao Escuela</option>
                                        <option value="Biao Guianga">Biao Guianga</option>
                                        <option value="Binugao">Binugao</option>
                                        <option value="Bucana">Bucana</option>
                                        <option value="Buhangin">Buhangin</option>
                                        <option value="Buhangin (Pob.)">Buhangin (Pob.)</option>
                                        <option value="Buhangin Proper">Buhangin Proper</option>
                                        <option value="Cabantian">Cabantian</option>
                                        <option value="Cadalian">Cadalian</option>
                                        <option value="Calinan Proper">Calinan Proper</option>
                                        <option value="Callawa">Callawa</option>
                                        <option value="Camansi">Camansi</option>
                                        <option value="Carmen">Carmen</option>
                                        <option value="Catalunan Grande">Catalunan Grande</option>
                                        <option value="Catalunan Pequeño">Catalunan Pequeño</option>
                                        <option value="Catigan">Catigan</option>
                                        <option value="Cawayan">Cawayan</option>
                                        <option value="Centro (San Juan)">Centro (San Juan)</option>
                                        <option value="Colosas">Colosas</option>
                                        <option value="Communal">Communal</option>
                                        <option value="Crossing Bayabas">Crossing Bayabas</option>
                                        <option value="Dacudao">Dacudao</option>
                                        <option value="Dalagdag">Dalagdag</option>
                                        <option value="Daliao">Daliao</option>
                                        <option value="Dalican">Dalican</option>
                                        <option value="Datu Salumay">Datu Salumay</option>
                                        <option value="Dominga">Dominga</option>
                                        <option value="Eden">Eden</option>
                                        <option value="Fatima (Benowang)">Fatima (Benowang)</option>
                                        <option value="Gatungan">Gatungan</option>
                                        <option value="Gov. Paciano Bangoy">Gov. Paciano Bangoy</option>
                                        <option value="Gov. Vicente Duterte">Gov. Vicente Duterte</option>
                                        <option value="Gumalang">Gumalang</option>
                                        <option value="Gumitan">Gumitan</option>
                                        <option value="Indangan">Indangan</option>
                                        <option value="Kap. Tomas Monteverde Sr.">Kap. Tomas Monteverde Sr.</option>
                                        <option value="Kilate">Kilate</option>
                                        <option value="Lamanan">Lamanan</option>
                                        <option value="Lampianao">Lampianao</option>
                                        <option value="Langub">Langub</option>
                                        <option value="Lapu-lapu">Lapu-lapu</option>
                                        <option value="Leon Garcia Sr.">Leon Garcia Sr.</option>
                                        <option value="Los Amigos">Los Amigos</option>
                                        <option value="Lubogan">Lubogan</option>
                                        <option value="Lumiad">Lumiad</option>
                                        <option value="Ma-a">Ma-a</option>
                                        <option value="Mabuhay">Mabuhay</option>
                                        <option value="Mabuhay">Mabuhay</option>
                                        <option value="Madapo">Madapo</option>
                                        <option value="Magtuod">Magtuod</option>
                                        <option value="Mahayag">Mahayag</option>
                                        <option value="Malabog">Malabog</option>
                                        <option value="Malagos">Malagos</option>
                                        <option value="Malamba">Malamba</option>
                                        <option value="Malandog">Malandog</option>
                                        <option value="Mampising">Mampising</option>
                                        <option value="Manambulan">Manambulan</option>
                                        <option value="Mandug">Mandug</option>
                                        <option value="Manuel Guianga">Manuel Guianga</option>
                                        <option value="Mapula">Mapula</option>
                                        <option value="Marapangi">Marapangi</option>
                                        <option value="Marilog Proper">Marilog Proper</option>
                                        <option value="Matina Aplaya">Matina Aplaya</option>
                                        <option value="Matina Crossing">Matina Crossing</option>
                                        <option value="Matina Pangi">Matina Pangi</option>
                                        <option value="Mintal">Mintal</option>
                                        <option value="Mudiang">Mudiang</option>
                                        <option value="Mulig">Mulig</option>
                                        <option value="New Carmen">New Carmen</option>
                                        <option value="New Valencia">New Valencia</option>
                                        <option value="Pampanga">Pampanga</option>
                                        <option value="Panacan">Panacan</option>
                                        <option value="Pandaitan">Pandaitan</option>
                                        <option value="Panorama">Panorama</option>
                                        <option value="Paquibato Proper">Paquibato Proper</option>
                                        <option value="Paradise Embak">Paradise Embak</option>
                                        <option value="Rafael Castillo">Rafael Castillo</option>
                                        <option value="Salapawan">Salapawan</option>
                                        <option value="Salaysay">Salaysay</option>
                                        <option value="Saloy">Saloy</option>
                                        <option value="San Antonio">San Antonio</option>
                                        <option value="San Isidro">San Isidro</option>
                                        <option value="Sasa">Sasa</option>
                                        <option value="Sirib">Sirib</option>
                                        <option value="Suawan">Suawan</option>
                                        <option value="Tacunan">Tacunan</option>
                                        <option value="Tagakpan">Tagakpan</option>
                                        <option value="Tagluno">Tagluno</option>
                                        <option value="Tagurano">Tagurano</option>
                                        <option value="Talomo Proper">Talomo Proper</option>
                                        <option value="Talomo River">Talomo River</option>
                                        <option value="Tamurayan">Tamurayan</option>
                                        <option value="Tibungco">Tibungco</option>
                                        <option value="Tigatto">Tigatto</option>
                                        <option value="Tungkalan">Tungkalan</option>
                                        <option value="Ubalde">Ubalde</option>
                                        <option value="Ugac">Ugac</option>
                                        <option value="Ula">Ula</option>
                                        <option value="Vicente Hizon Sr.">Vicente Hizon Sr.</option>
                                        <option value="Waan">Waan</option>
                                        <option value="Wangan">Wangan</option>
                                        <option value="Wilfredo Aquino">Wilfredo Aquino</option>
                                        <option value="Wines">Wines</option>
                                    </select>
                                    <span asp-validation-for="Barangay" class="text-red-500 text-sm mt-1"></span>
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">District</label>
                                    <select asp-for="District" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300" required>
                                        <option value="" disabled selected>--Select district--</option>
                                        <option value="1">District 1</option>
                                        <option value="2">District 2</option>
                                        <option value="3">District 3</option>
                                        <option value="4">District 4</option>
                                        <option value="5">District 5</option>
                                        <option value="6">District 6</option>
                                        <option value="7">District 7</option>
                                        <option value="8">District 8</option>
                                        <option value="9">District 9</option>
                                        <option value="10">District 10</option>
                                        <option value="11">District 11</option>
                                    </select>
                                    <span asp-validation-for="District" class="text-red-500 text-sm mt-1"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Terms and Submit -->
                        <div class="space-y-6 pt-6 border-t border-gray-200">
                            <div class="flex items-start gap-3 p-4 bg-gray-50 rounded-xl">
                                <input type="checkbox" id="terms" required class="mt-1 w-4 h-4 text-crimson-500 border-gray-300 rounded focus:ring-crimson-500">
                                <label for="terms" class="text-sm text-gray-700">
                                    I agree to the <a href="#" class="text-blue-500 font-semibold hover:text-blue-800 hover:underline" data-bs-toggle="modal" data-bs-target="#termsModal">Terms and Conditions</a>
                                </label>
                            </div>

                            <button type="submit"
                                    class="w-full submitbtn-color text-white py-4 px-6 rounded-xl font-semibold text-lg shadow-lg hover:shadow-xl transform hover:scale-105 transition-all duration-300">
                                <i class="fas fa-check-circle mr-2"></i>Verify Account
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Wrong ID Type Warning -->
    <div id="wrong-id-warning" class="fixed top-4 right-4 max-w-md hidden">
        <div class="bg-red-50 border border-red-200 rounded-xl p-4 shadow-lg slide-down">
            <div class="flex items-start gap-3">
