@model VerifyaccountDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Verification</title>
    <link rel="icon" type="image/x-icon" href="~/lingaplogo.ico">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Tesseract.js -->
    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@4/dist/tesseract.min.js"></script>

    <style>
        .crimson-500 {
            color: #DC143C;
        }

        .crimson-600 {
            color: #b01030;
        }

        .bg-crimson-500 {
            background-color: #DC143C;
        }

        .bg-crimson-600 {
            background-color: #b01030;
        }

        .border-crimson-500 {
            border-color: #DC143C;
        }

        .submitbtn-color {
            background: #32cd32;
        }
      
        .glass-effect {
            backdrop-filter: blur(10px);
            background: rgba(255, 255, 255, 0.95);
        }

        .upload-area {
            transition: all 0.3s ease;
            border: 2px dashed #d1d5db;
        }

            .upload-area:hover {
                border-color: #DC143C;
                background-color: rgba(220, 20, 60, 0.02);
            }

            .upload-area.active {
                border-color: #DC143C;
                background-color: rgba(220, 20, 60, 0.05);
            }

            .upload-area.dragover {
                border-color: #DC143C;
                background-color: rgba(220, 20, 60, 0.1);
            }

        .id-preview {
            transition: all 0.3s ease;
            border-radius: 8px;
        }

        .progress-bar {
            transition: width 0.3s ease;
        }

        .disabled-field {
            background-color: #f8f9fa;
            cursor: not-allowed;
            opacity: 0.6;
            border-color: #dee2e6;
        }

            .disabled-field:focus {
                outline: none;
                box-shadow: none;
                border-color: #dee2e6;
            }

        /* Smooth entrance animations using transforms and opacity */
        .fade-in {
            opacity: 0;
            transition: opacity 0.5s ease-in;
        }

            .fade-in.loaded {
                opacity: 1;
            }

        .slide-down {
            opacity: 0;
            transform: translateY(-10px);
            transition: all 0.3s ease-out;
        }

            .slide-down.visible {
                opacity: 1;
                transform: translateY(0);
            }

        .scale-in {
            opacity: 0;
            transform: scale(0.95);
            transition: all 0.3s ease-out;
        }

            .scale-in.visible {
                opacity: 1;
                transform: scale(1);
            }

        /* Fix modal positioning */
        .modal-backdrop {
            z-index: 1040;
        }

        .modal {
            z-index: 1050;
        }

            /* Ensure modal content is hidden by default */
            .modal:not(.show) {
                display: none;
            }

        /* Enhanced modal styling */
        .modal-content {
            border-radius: 16px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            border: none;
        }

        .modal-header {
            border-radius: 16px 16px 0 0;
            padding: 1.5rem 2rem;
        }

        .modal-body {
            max-height: 60vh;
            overflow-y: auto;
            padding: 2rem;
        }

        .modal-footer {
            border-radius: 0 0 16px 16px;
            padding: 1.5rem 2rem;
        }

        .terms-section {
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1rem;
            border-left: 4px solid;
        }

            .terms-section:nth-child(odd) {
                background-color: rgba(220, 20, 60, 0.05);
                border-left-color: #DC143C;
            }

            .terms-section:nth-child(even) {
                background-color: rgba(59, 130, 246, 0.05);
                border-left-color: #3b82f6;
            }

            .terms-section h6 {
                font-size: 1.1rem;
                margin-bottom: 0.75rem;
            }

        .border-red-500 {
            border-color: #DC143C !important;
        }

        .bg-red-50 {
            background-color: #fef2f2 !important;
        }

        /* Enhanced error states for name fields */
        input.error-field {
            border-color: #DC143C !important;
            background-color: #fef2f2 !important;
            box-shadow: 0 0 0 3px rgba(220, 20, 60, 0.1) !important;
        }

        /* Smooth transition for error states */
        #firstname, #lastname {
            transition: all 0.3s ease;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-gray-50 to-blue-50 min-h-screen">
    <!-- Go Back Button -->
    <div class="fixed top-6 left-6 z-50 fade-in">
        <button id="goBackBtn" class="flex items-center gap-2 px-4 py-2 bg-white rounded-full shadow-lg border border-gray-200 hover:border-crimson-500 hover:bg-crimson-500 hover:text-black transition-all duration-300 group">
            <i class="fas fa-arrow-left group-hover:transform group-hover:-translate-x-1 transition-transform"></i>
            <span class="font-semibold">Go Back</span>
        </button>
    </div>

    <div class="container mx-auto px-4 py-8">
        <div class="max-w-4xl mx-auto">
            <!-- Header -->
            <div class="text-center mb-8 fade-in">
                <div class="w-20 h-20 bg-white rounded-2xl shadow-lg flex items-center justify-center mx-auto mb-4 shadow-md">
                    <i class="fas fa-id-card-alt text-3xl crimson-500"></i>
                </div>
                <h1 class="text-4xl font-bold text-gray-800 mb-2">Verify Your Account</h1>
            </div>

            <!-- Registered Name Info Card -->
            @if (!string.IsNullOrEmpty(ViewBag.RegisteredFirstName) && !string.IsNullOrEmpty(ViewBag.RegisteredLastName))
            {
                <div class="bg-blue-50 border-l-4 border-blue-500 rounded-xl p-6 mb-6 slide-down">
                    <div class="flex items-start gap-4">
                        <div class="flex-shrink-0">
                            <i class="fas fa-info-circle text-2xl text-blue-500"></i>
                        </div>
                        <div class="flex-1">
                            <h3 class="text-lg font-semibold text-blue-800 mb-2">Registered Account Information</h3>
                            <p class="text-blue-700 mb-2">
                                Your ID must match the following registered name:
                            </p>
                            <div class="bg-white rounded-lg p-4 border border-blue-200">
                                <p class="text-gray-800 font-bold text-lg">
                                    @ViewBag.RegisteredFirstName @ViewBag.RegisteredMiddleName @ViewBag.RegisteredLastName @ViewBag.RegisteredSuffix
                                </p>
                            </div>
                            <p class="text-sm text-blue-600 mt-2">
                                <i class="fas fa-exclamation-triangle mr-1"></i>
                                <strong>Important:</strong> The name on your ID must match this registered name exactly.
                            </p>
                        </div>
                    </div>
                </div>
            }

            <!-- Main Form Card -->
            <div class="bg-white rounded-2xl shadow-xl overflow-hidden glass-effect scale-in w-full max-w-full lg:max-w-4xl mx-auto">
                <div class="p-6 md:p-8">
                    <form asp-action="Accountverification" method="post" enctype="multipart/form-data" id="registrationForm" class="space-y-8">

                        <!-- Validation Summary for Errors -->
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="bg-red-50 border-l-4 border-red-500 rounded-xl p-6 mb-6 slide-down">
                                <div class="flex items-start gap-4">
                                    <div class="flex-shrink-0">
                                        <i class="fas fa-exclamation-triangle text-2xl text-red-500"></i>
                                    </div>
                                    <div class="flex-1">
                                        <h3 class="text-lg font-semibold text-red-800 mb-2">Verification Error</h3>
                                        <div asp-validation-summary="All" class="text-red-700 space-y-1"></div>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- ID Verification Section -->
                        <div class="space-y-6">
                            <div class="flex items-center gap-3 mb-2">
                                <div class="w-10 h-10 bg-red-50 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-id-card text-lg crimson-500"></i>
                                </div>
                                <h2 class="text-2xl font-bold text-gray-800">ID Verification</h2>
                            </div>

                            <!-- ID Type Selection -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">ID Type</label>
                                    <select asp-for="IDtype" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300" id="document-type" required>
                                        <option value="">Select Valid ID</option>
                                        <option value="phil-id">Philippine Identification Card / National ID</option>
                                        <option value="driver-license">Driver's License</option>
                                    </select>
                                    <span asp-validation-for="IDtype" class="text-red-500 text-sm mt-1"></span>
                                    <div id="document-warning" class="text-amber-600 text-sm mt-2 hidden">
                                        <i class="fas fa-info-circle mr-1"></i>OCR is not available for the selected document type
                                    </div>
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">ID Number</label>
                                    <input asp-for="IDnumber" type="text" id="idnumber"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                                           placeholder="Enter your ID number"
                                           required
                                           inputmode="numeric"
                                           pattern="[0-9]*"
                                           oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                                    <span asp-validation-for="IDnumber" class="text-red-500 text-sm mt-1"></span>
                                </div>
                            </div>

                            <!-- ID Upload Sections -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <!-- Front ID Upload -->
                                <div class="upload-area rounded-xl p-6 text-center cursor-pointer" id="upload-area-front">
                                    <div class="id-upload-content">
                                        <div class="w-16 h-16 bg-red-50 rounded-full flex items-center justify-center mx-auto mb-4">
                                            <i class="fas fa-id-card text-2xl crimson-500"></i>
                                        </div>
                                        <div class="font-semibold text-gray-800 mb-2">Front of ID</div>
                                        <div class="text-gray-500 text-sm mb-4">Click to upload or drag and drop</div>
                                        <input asp-for="ValidFrontID" type="file" id="file-input-front" class="hidden" accept="image/*">
                                        <img id="image-preview" class="id-preview w-full max-w-xs mx-auto hidden" alt="Front ID Preview">
                                        <span asp-validation-for="ValidFrontID" class="text-red-500 text-sm mt-2 block"></span>
                                    </div>
                                </div>

                                <!-- Back ID Upload -->
                                <div class="upload-area rounded-xl p-6 text-center cursor-pointer" id="upload-area-back">
                                    <div class="id-upload-content">
                                        <div class="w-16 h-16 bg-red-50 rounded-full flex items-center justify-center mx-auto mb-4">
                                            <i class="fas fa-id-card text-2xl crimson-500"></i>
                                        </div>
                                        <div class="font-semibold text-gray-800 mb-2">Back of ID</div>
                                        <div class="text-gray-500 text-sm mb-4">Click to upload or drag and drop</div>
                                        <input asp-for="ValidBackID" type="file" id="file-input-back" class="hidden" accept="image/*">
                                        <img id="image-preview-back" class="id-preview w-full max-w-xs mx-auto hidden" alt="Back ID Preview">
                                        <span asp-validation-for="ValidBackID" class="text-red-500 text-sm mt-2 block"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- OCR Status -->
                            <div class="space-y-4">
                                <div id="ocr-status" class="text-gray-600 text-sm">
                                    <i class="fas fa-info-circle mr-2"></i>Select a document to begin
                                </div>

                                <div class="progress-bar-container hidden" id="progress-bar">
                                    <div class="w-full bg-gray-200 rounded-full h-2">
                                        <div class="bg-crimson-500 h-2 rounded-full transition-all duration-300"
                                             id="progress" style="width: 0%"></div>
                                    </div>
                                </div>

                                <div id="ocr-result" class="hidden p-4 bg-blue-50 border border-blue-200 rounded-xl text-sm text-blue-700 slide-down"></div>
                            </div>

                            <!-- Davao Verification Result -->
                            <div id="davao-verification" class="hidden p-6 rounded-xl border-l-4 slide-down">
                                <div class="flex items-start gap-4">
                                    <i id="davao-result-icon" class="fas fa-check-circle text-2xl mt-1"></i>
                                    <div class="flex-1">
                                        <div class="flex items-center gap-3 mb-2">
                                            <h4 id="davao-result-title" class="font-semibold text-lg"></h4>
                                            <span id="davao-status-badge" class="px-3 py-1 rounded-full text-sm font-semibold"></span>
                                        </div>
                                        <p id="davao-result-message" class="text-gray-700"></p>
                                    </div>
                                </div>
                            </div>

                            <div class="text-center">
                                <small class="text-gray-500 text-sm">
                                    <i class="fas fa-info-circle mr-1"></i>
                                    Upload clear images of your valid ID (JPEG, PNG). Max file size: 5MB each.
                                </small>
                            </div>
                        </div>

                        <!-- Personal Information Section -->
                        <div class="space-y-6">
                            <div class="flex items-center gap-3 mb-2">
                                <div class="w-10 h-10 bg-green-50 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-user text-lg text-green-500"></i>
                                </div>
                                <h2 class="text-2xl font-bold text-gray-800">Personal Information</h2>
                            </div>

                            <!-- Name Fields -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Last Name</label>
                                    <input asp-for="Lastname" type="text" id="lastname"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                                           placeholder="Enter your last name" required>
                                    <span asp-validation-for="Lastname" class="text-red-500 text-sm mt-1"></span>
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">First Name</label>
                                    <input asp-for="Firstname" type="text" id="firstname"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                                           placeholder="Enter your first name" required>
                                    <span asp-validation-for="Firstname" class="text-red-500 text-sm mt-1"></span>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Middle Name</label>
                                    <input asp-for="Middlename" type="text" id="middlename"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                                           placeholder="Enter your middle name">
                                    <span asp-validation-for="Middlename" class="text-red-500 text-sm mt-1"></span>
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Suffix</label>
                                    <select asp-for="Suffix" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300">
                                        <option value="None">None</option>
                                        <option value="Jr.">Jr</option>
                                        <option value="Sr.">Sr</option>
                                        <option value="II">II</option>
                                        <option value="III">III</option>
                                        <option value="IV">IV</option>
                                    </select>
                                    <span asp-validation-for="Suffix" class="text-red-500 text-sm mt-1"></span>
                                </div>
                            </div>

                            <!-- Gender and Civil Status -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Gender</label>
                                    <select asp-for="Gender" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300" id="sex" required>
                                        <option value="">Select Gender</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                    </select>
                                    <span asp-validation-for="Gender" class="text-red-500 text-sm mt-1"></span>
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Civil Status</label>
                                    <select asp-for="CivilStatus" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300" required>
                                        <option value="">Select Civil Status</option>
                                        <option value="Single">Single</option>
                                        <option value="Married">Married</option>
                                        <option value="Widowed">Widowed</option>
                                        <option value="Separated">Separated</option>
                                        <option value="Divorced">Divorced</option>
                                    </select>
                                    <span asp-validation-for="CivilStatus" class="text-red-500 text-sm mt-1"></span>
                                </div>
                            </div>
                        </div>

                         <!-- Contact Information -->
                        <div class="space-y-6">
                            <div class="flex items-center gap-3 mb-2">
                                <div class="w-10 h-10 bg-blue-50 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-phone text-lg text-blue-500"></i>
                                </div>
                                <h2 class="text-2xl font-bold text-gray-800">Contact Information</h2>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Phone Number</label>
                                    <input asp-for="Phonenumber" type="text" id="phonenumber"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                                           placeholder="Enter your phone number (e.g., 09171234567)"
                                           required
                                           inputmode="numeric"
                                           minlength="10"
                                           maxlength="11"
                                           pattern="[0-9]{10,11}"
                                           oninput="this.value = this.value.replace(/[^0-9]/g, '').substring(0, 11)">
                                    <span asp-validation-for="Phonenumber" class="text-red-500 text-sm mt-1"></span>
                                    <small class="text-gray-500 text-sm">Enter a valid 10-11 digit Philippine phone number</small>
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Date of Birth</label>
                                    <input asp-for="Dateofbirth" type="date" id="birthdate"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                                           required>
                                    <span asp-validation-for="Dateofbirth" class="text-red-500 text-sm mt-1"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Address Section -->
                        <div class="space-y-6">
                            <div class="flex items-center gap-3 mb-2">
                                <div class="w-10 h-10 bg-purple-50 rounded-lg flex items-center justify-center">
                                    <i class="fas fa-home text-lg text-purple-500"></i>
                                </div>
                                <h2 class="text-2xl font-bold text-gray-800">Address Information</h2>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Blk / Lot / Street</label>
                                    <input asp-for="BlkLotStreet" type="text"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                                           placeholder="Enter block, lot, or street" required>
                                    <span asp-validation-for="BlkLotStreet" class="text-red-500 text-sm mt-1"></span>
                                </div>

                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Sub / Vill.</label>
                                    <input asp-for="SubVill" type="text"
                                           class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300"
                                           placeholder="Enter subdivision or village">
                                    <span asp-validation-for="SubVill" class="text-red-500 text-sm mt-1"></span>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">Barangay</label>
                                    <select asp-for="Barangay" class="w-full px-4 py-3 border-2 border-gray-200 rounded-xl focus:border-crimson-500 focus:ring-2 focus:ring-red-200 transition-all duration-300" required>
                                        <option value="">Select Barangay</option>
                                        <option value="Acacia">Acacia</option>
        <option value="Agdao">Agdao</option>
        <option value="Alambre">Alambre</option>
        <option value="Alejandro Navarro">Alejandro Navarro (Lasang)</option>
        <option value="Alfonso Angliongto Sr.">Alfonso Angliongto Sr.</option>
        <option value="Angalan">Angalan</option>
        <option value="Baguio Proper">Baguio Proper</option>
        <option value="Baliok">Baliok</option>
        <option value="Bangkas Heights">Bangkas Heights</option>
        <option value="Baracatan">Baracatan</option>
        <option value="Bato">Bato</option>
        <option value="Bayabas">Bayabas</option>
        <option value="Biao Escuela">Biao Escuela</option>
        <option value="Biao Guianga">Biao Guianga</option>
        <option value="Binugao">Binugao</option>
        <option value="Bucana">Bucana</option>
        <option value="Buhangin Proper">Buhangin Proper</option>
        <option value="Cabantian">Cabantian</option>
        <option value="Cadalian">Cadalian</option>
        <option value="Calinan Proper">Calinan Proper</option>
        <option value="Callawa">Callawa</option>
        <option value="Camansi">Camansi</option>
        <option value="Carmen">Carmen</option>
        <option value="Catalunan Grande">Catalunan Grande</option>
        <option value="Catalunan Pequeño">Catalunan Pequeño</option>
        <option value="Catigan">Catigan</option>
        <option value="Cawayan">Cawayan</option>
        <option value="Centro (San Juan)">Centro (San Juan)</option>
        <option value="Colosas">Colosas</option>
        <option value="Communal">Communal</option>
        <option value="Crossing Bayabas">Crossing Bayabas</option>
        <option value="Dacudao">Dacudao</option>
        <option value="Dalagdag">Dalagdag</option>
        <option value="Daliao">Daliao</option>
        <option value="Dalican">Dalican</option>
        <option value="Datu Salumay">Datu Salumay</option>
        <option value="Dominga">Dominga</option>
        <option value="Eden">Eden</option>
