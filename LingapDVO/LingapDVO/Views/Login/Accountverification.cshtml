                    idNumber = "";
                }

                // If still no ID number, use fallback method
                if (!idNumber) {
                    console.log('🔄 Using fallback PhilSys number extraction...');
                    for (const line of lines) {
                        // Try standard 16-digit format with dashes or spaces
                        let idMatch = line.match(/\d{4}[-\s]?\d{4}[-\s]?\d{4}[-\s]?\d{4}/);
                        if (idMatch) {
                            idNumber = idMatch[0].replace(/\s+/g, "").replace(/-/g, "");
