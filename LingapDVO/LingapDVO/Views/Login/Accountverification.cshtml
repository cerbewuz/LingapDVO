            // Comprehensive OCR garbage removal and text normalization
            function sanitizeOCRText(text) {
                if (!text) return "";

                let cleaned = text
                    // Remove common OCR garbage symbols
                    .replace(/[|¦\[\]{}©®™°«»¬§¶†‡]/g, "")
