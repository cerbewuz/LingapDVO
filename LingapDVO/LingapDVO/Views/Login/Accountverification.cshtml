                // ═══════════════════════════════════════════════════════════════
                // 🇵🇭 COMPREHENSIVE PHILIPPINE ID NAME INDICATORS
                // ═══════════════════════════════════════════════════════════════
                const lastNameIndicators = [
                    'APELYIDO', 'LAST NAME', 'LASTNAME', 'SURNAME', 'FAMILY NAME',
                    'HULING PANGALAN', 'PANGALAN NG PAMILYA'
                ];

                const firstNameIndicators = [
                    // Most specific first (for faster matching)
                    'GIVEN NAME/S', 'GIVEN NAME(S)', 'GIVEN NAMES', 'GIVEN NAME',
                    'MGA PANGALAN', 'UNANG PANGALAN',
                    'FIRST NAME', 'FIRSTNAME',
                    'GIVENNAMES', 'GIVENNAME',
                    // Less specific (only if above not found)
                    'GIVEN', 'FIRST'
                ];

                const middleNameIndicators = [
                    'GITNANG PANGALAN', 'GITNANG', 'MIDDLE NAME', 'MIDDLENAME',
                    'IKALAWANG PANGALAN', 'SECOND NAME', 'MIDDLE', 'MN', 'MI'
                ];

                console.log('🔍 Starting PhilSys ID extraction...');
                console.log('Total lines:', lines.length);
                console.log('OCR Text:', text);

                // Helper to check if value is a valid name (not a label or ID type)
                function isValidName(value) {
                    if (!value || value.length < 2) return false;
                    const cleaned = value.replace(/[^A-Za-zÑñ\s]/g, '');
                    if (cleaned.length < 2) return false;

                    const upper = value.toUpperCase();

                    // Exclude all labels and ID types
                    const excludeWords = [
                        // Field labels
                        'NAME', 'PANGALAN', 'APELYIDO', 'GITNANG', 'SURNAME',
                        'FAMILY', 'LAST', 'FIRST', 'MIDDLE', 'GIVEN', 'MGA',
                        // ID labels and types
                        'REPUBLIC', 'PHILIPPINES', 'NATIONAL', 'PHILSYS', 'PHILIPPINE',
                        'IDENTIFICATION', 'SYSTEM', 'CARD', 'ID', 'NUMBER',
                        'DRIVER', 'LICENSE', 'DRIVERS', 'LAND', 'TRANSPORTATION',
                        'OFFICE', 'LTO', 'PSN', 'PCN',
                        // Date/Address labels
                        'PETSA', 'DATE', 'BIRTH', 'KAPANGANAKAN', 'ADDRESS',
                        'TIRAHAN', 'KASARIAN', 'SEX', 'GENDER',
                        // Other
                        'VALID', 'UNTIL', 'EXPIRES', 'ISSUED'
                    ];

                    for (const word of excludeWords) {
                        if (upper.includes(word)) return false;
                    }

                    // Must have at least 50% letters
                    const letterCount = (value.match(/[A-Za-zÑñ]/g) || []).length;
                    if (letterCount / value.length < 0.5) return false;

                    return true;
                }

                // Extract Last Name
                for (let i = 0; i < linesUpper.length && !lastName; i++) {
                    const line = linesUpper[i];

                    for (const indicator of lastNameIndicators) {
                        if (line.includes(indicator) && !line.includes("GITNANG")) {
                            // Try same line first
                            const afterIndicator = lines[i].substring(lines[i].toUpperCase().indexOf(indicator) + indicator.length).trim();
                            if (afterIndicator && isValidName(afterIndicator)) {
                                const lastNameResult = extractSuffix(afterIndicator);
                                lastName = cleanName(lastNameResult.cleanedName);
                                suffix = lastNameResult.suffix;
                                break;
                            }
                            // Try next line
                            if (i + 1 < lines.length) {
                                const nextValue = lines[i + 1];
                                if (isValidName(nextValue)) {
                                    const lastNameResult = extractSuffix(nextValue);
                                    lastName = cleanName(lastNameResult.cleanedName);
                                    suffix = lastNameResult.suffix;
                                    break;
                                }
                            }
                        }
                    }
                }

                // Extract First Name (with multi-line support)
                console.log('🔍 Extracting First Name...');
                console.log(`  - Last Name already extracted: "${lastName}"`);
                for (let i = 0; i < linesUpper.length && !firstName; i++) {
                    const line = linesUpper[i];

                    for (const indicator of firstNameIndicators) {
                        if (line.includes(indicator)) {
                            console.log(`✓ Found indicator "${indicator}" at line ${i}: "${lines[i]}"`);

                            // Try same line first
                            const afterIndicator = lines[i].substring(lines[i].toUpperCase().indexOf(indicator) + indicator.length).trim();
                            console.log(`  - After indicator: "${afterIndicator}"`);

                            if (afterIndicator && isValidName(afterIndicator)) {
                                const candidateName = cleanName(afterIndicator);
                                // Make sure it's not the last name
                                if (normalizeName(candidateName) !== normalizeName(lastName)) {
                                    firstName = candidateName;
                                    console.log(`  ✅ Extracted from same line: "${firstName}"`);
                                } else {
                                    console.log(`  ⚠️ Skipped: matches last name "${lastName}"`);
                                }
                            }

                            // Try next line
                            if (!firstName && i + 1 < lines.length) {
                                const nextValue = cleanName(lines[i + 1]);
                                console.log(`  - Next line value: "${nextValue}"`);

                                if (isValidName(nextValue)) {
                                    // Make sure it's not the last name
                                    if (normalizeName(nextValue) !== normalizeName(lastName)) {
                                        firstName = nextValue;
                                        console.log(`  ✅ Extracted from next line: "${firstName}"`);

                                        // Check for multiple given names on subsequent lines
                                        console.log('  🔍 Checking for additional given names...');
                                        for (let j = i + 2; j <= Math.min(i + 4, lines.length - 1); j++) {
                                            const additionalName = cleanName(lines[j]);
                                            console.log(`    - Line ${j}: "${lines[j]}" -> cleaned: "${additionalName}"`);

                                            if (isValidName(additionalName) && additionalName.length > 1 && additionalName.length < 20) {
                                                // Check if it's not a middle name indicator or last name
                                                let isMiddleIndicator = false;
                                                for (const midInd of middleNameIndicators) {
                                                    if (lines[j].toUpperCase().includes(midInd)) {
                                                        isMiddleIndicator = true;
                                                        console.log(`    ⚠️ Found middle name indicator: "${midInd}"`);
                                                        break;
                                                    }
                                                }

                                                const isLastName = normalizeName(additionalName) === normalizeName(lastName);
                                                if (isLastName) {
                                                    console.log(`    ⚠️ Skipped: matches last name "${lastName}"`);
                                                }

                                                if (!isMiddleIndicator && !isLastName) {
                                                    firstName += " " + additionalName;
                                                    console.log(`    ✅ Added to firstName: "${firstName}"`);
                                                } else {
                                                    console.log(`    🛑 Stopped: middle indicator or last name found`);
                                                    break;
                                                }
                                            } else {
                                                console.log(`    🛑 Stopped: invalid name`);
                                                break;
                                            }
                                        }
                                    } else {
                                        console.log(`  ⚠️ Skipped next line: matches last name "${lastName}"`);
                                    }
                                }
                            }
                            if (firstName) {
                                console.log(`✅ Final firstName: "${firstName}"`);
                                break;
                            }
                        }
                    }
                }

                // ═══════════════════════════════════════════════════════════════
                // PRECISE FALLBACK: Only when indicators not found
                // ═══════════════════════════════════════════════════════════════
                if (!firstName && lastName) {
                    console.log('⚠️ No first name found with indicators. Trying precise fallback...');

                    // Strategy: In PhilSys IDs, names appear in order: Last Name, First Name(s), Middle Name
                    // Find the line containing last name, then extract the next valid name(s)
                    let lastNameLineIndex = -1;

                    // Find exact line where last name appears
                    for (let i = 0; i < lines.length; i++) {
                        const cleanedLine = cleanName(lines[i]);
                        if (normalizeName(cleanedLine) === normalizeName(lastName)) {
                            lastNameLineIndex = i;
                            console.log(`  - Found last name at line ${i}: "${lines[i]}"`);
                            break;
                        }
                    }

                    // Extract name immediately after last name
                    if (lastNameLineIndex >= 0) {
                        // Look at next 3 lines max for first name(s)
                        for (let j = lastNameLineIndex + 1; j < Math.min(lastNameLineIndex + 4, lines.length); j++) {
                            const candidate = cleanName(lines[j]);

                            // Very strict validation
                            if (candidate &&
                                candidate.length >= 2 &&
                                candidate.length <= 25 &&
                                isValidName(candidate) &&
                                normalizeName(candidate) !== normalizeName(lastName)) {

                                firstName = candidate;
                                console.log(`  ✅ Precise fallback: Found firstName "${firstName}" at line ${j}`);

                                // Check ONLY the next line for additional first name
                                if (j + 1 < lines.length) {
                                    const nextCandidate = cleanName(lines[j + 1]);
                                    if (nextCandidate &&
                                        nextCandidate.length >= 2 &&
                                        nextCandidate.length <= 20 &&
                                        isValidName(nextCandidate) &&
                                        normalizeName(nextCandidate) !== normalizeName(lastName) &&
                                        !lines[j + 1].toUpperCase().includes('GITNANG') &&
                                        !lines[j + 1].toUpperCase().includes('MIDDLE')) {
                                        firstName += " " + nextCandidate;
                                        console.log(`  ✅ Added second given name: "${nextCandidate}"`);
                                    }
                                }
                                break;
                            }
                        }
                    }
                }

                if (!firstName) {
                    console.log('❌ ERROR: Could not extract first name from ID!');
                } else {
                    console.log(`✅ Final firstName: "${firstName}"`);
                }

                // Extract Middle Name
                for (let i = 0; i < linesUpper.length && !middleName; i++) {
                    const line = linesUpper[i];

                    for (const indicator of middleNameIndicators) {
                        if (line.includes(indicator)) {
                            // Try same line first
                            const afterIndicator = lines[i].substring(lines[i].toUpperCase().indexOf(indicator) + indicator.length).trim();
                            if (afterIndicator && isValidName(afterIndicator)) {
                                middleName = cleanName(afterIndicator);
                                break;
                            }
                            // Try next line
                            if (i + 1 < lines.length) {
                                const nextValue = cleanName(lines[i + 1]);
                                if (isValidName(nextValue)) {
                                    middleName = nextValue;
                                    break;
                                }
                            }
                        }
                    }
                }

                // Extract Birthdate
                for (let i = 0; i < linesUpper.length && !birthdate; i++) {
                    const line = linesUpper[i];

                    // Look for birthdate indicators in various formats
                    if (line.includes("KAPANGANAKAN") || line.includes("PETSA") ||
                        line.includes("BIRTHDATE") || line.includes("DATE OF BIRTH")) {
                        // Try to extract birthdate from current line or next line
                        let dateText = lines[i];
                        if (!containsDate(lines[i]) && i + 1 < lines.length) {
                            dateText = lines[i + 1];
                        }
                        birthdate = extractBirthdateFromText(dateText);
                    }
                }

                // If birthdate not found with indicators, search all lines for date patterns
                if (!birthdate) {
                    birthdate = findBirthdateInText(lines);
                }

                // ═══════════════════════════════════════════════════════════════
                // 📊 EXTRACTION SUMMARY
                // ═══════════════════════════════════════════════════════════════
                console.log('\n📊 === NATIONAL ID EXTRACTION SUMMARY ===');
                console.log(`ID Number: "${idNumber}"`);
                console.log(`Last Name: "${lastName}"`);
                console.log(`First Name: "${firstName}"`);
                console.log(`Middle Name: "${middleName}"`);
                console.log(`Suffix: "${suffix}"`);
                console.log(`Birthdate: "${birthdate}"`);
                console.log('========================================\n');

                // Extract comprehensive address from National ID
                const addressComponents = extractAddressComponents(lines);
                city = addressComponents.city;

                // ═══════════════════════════════════════════════════════════════
                // 🔍 VALIDATE NAME MATCH BEFORE PROCEEDING
                // ═══════════════════════════════════════════════════════════════
                const nameValidation = validateNameMatch(firstName, middleName, lastName, suffix);

                if (!nameValidation.isMatch) {
                    console.log('❌ Name mismatch detected!');
                    showNameMismatchModal(firstName, middleName, lastName, suffix);
                    return; // Stop processing
                }

                console.log('✅ Name matches registered information');

                // Show success message for matched ID
                status.innerHTML = '<i class="fas fa-check-circle mr-2 text-green-600"></i><span class="text-green-700 font-semibold">ID matched with Registered Details</span>';
                status.className = 'text-sm mt-2 text-green-700';

                // Auto-fill address fields if extracted
                if (addressComponents.street) {
                    const streetField = document.querySelector('input[name="BlkLotStreet"]');
                    if (streetField) streetField.value = addressComponents.street;
                }
                if (addressComponents.subdivision) {
                    const subdivField = document.querySelector('input[name="SubVill"]');
                    if (subdivField) subdivField.value = addressComponents.subdivision;
                }

                updateFormFields(idNumber, firstName, middleName, lastName, birthdate, "", suffix);

                // Check if it's Davao City for National ID
                const isDavaoCity = checkIfDavaoCity(city);

                // Show Davao verification result for National ID
                showDavaoVerificationResult(isDavaoCity, city, 'national-id');
            }

            // Parse PhilSys ID Back - Extract gender ONLY
            function parsePhilSysBack(text) {
                const lines = text.split('\n').map(line => line.trim()).filter(line => line);
                let sex = "";

                // Look for gender indicators on the back only
                sex = findGenderInText(lines);

                if (sex) {
                    document.getElementById('sex').value = sex;
                    resultBox.classList.remove('hidden');
                    resultBox.textContent = "Gender information extracted from ID back. Please verify.";
                }
            }

            // Extract comprehensive address information from Philippine IDs
            function extractAddressComponents(lines) {
                console.log('\n🏠 === ADDRESS EXTRACTION ===');
                console.log(`Analyzing ${lines.length} lines for address information...`);

                const address = {
                    street: "",
                    subdivision: "",
                    city: ""
                };

                const addressIndicators = ['TIRAHAN', 'ADDRESS', 'TIRAHAN/ADDRESS', 'RESIDENCE'];

                // STRATEGY 1: Look for address indicators
                for (let i = 0; i < lines.length; i++) {
                    const lineUpper = lines[i].toUpperCase();

                    if (addressIndicators.some(ind => lineUpper.includes(ind))) {
                        console.log(`  - Found address indicator at line ${i}: "${lines[i]}"`);

                        // Extract address from next several lines
                        let addressLines = [];
                        for (let j = i + 1; j < Math.min(i + 8, lines.length); j++) {
                            const addrLine = lines[j].trim();
                            const addrUpper = addrLine.toUpperCase();

                            // Skip non-address lines
                            if (addrLine.length > 2 &&
                                !addrUpper.includes('PETSA') &&
                                !addrUpper.includes('DATE') &&
                                !addrUpper.includes('KAPANGANAKAN') &&
                                !addrUpper.includes('BIRTH') &&
                                !addrUpper.includes('KASARIAN') &&
                                !addrUpper.includes('SEX') &&
                                !addrUpper.includes('GENDER')) {
                                addressLines.push(addrLine);
                                console.log(`    - Address line ${j - i}: "${addrLine}"`);
                            }
                        }

                        // Parse address components
                        if (addressLines.length > 0) {
                            console.log(`  - Processing ${addressLines.length} potential address lines...`);

                            // STREET: First line typically contains street/block/lot
                            const firstLine = addressLines[0];
                            const firstUpper = firstLine.toUpperCase();

                            if (firstLine.match(/\d+/) ||
                                firstUpper.includes('BLK') || firstUpper.includes('BLOCK') ||
                                firstUpper.includes('LOT') ||
                                firstUpper.includes('ST') || firstUpper.includes('STREET') ||
                                firstUpper.includes('AVE') || firstUpper.includes('AVENUE') ||
                                firstUpper.includes('RD') || firstUpper.includes('ROAD') ||
                                firstUpper.includes('PHASE') || firstUpper.includes('PUROK')) {
                                address.street = firstLine;
                                console.log(`  ✅ Street extracted: "${address.street}"`);
                            } else if (!firstUpper.includes('DAVAO') && !firstUpper.includes('CITY')) {
                                // If first line doesn't match patterns but isn't a city, use it as street
                                address.street = firstLine;
                                console.log(`  ✅ Street (fallback): "${address.street}"`);
                            }

                            // SUBDIVISION: Look for subdivision/village patterns
                            for (const line of addressLines) {
                                const upperLine = line.toUpperCase();
                                if ((upperLine.includes('SUBD') || upperLine.includes('SUBDIVISION') ||
                                     upperLine.includes('VILLAGE') || upperLine.includes('VILL') ||
                                     upperLine.includes('HILLS') || upperLine.includes('HOMES') ||
                                     upperLine.includes('GARDENS') || upperLine.includes('ESTATE') ||
                                     upperLine.includes('PARK') || upperLine.includes('HEIGHTS')) &&
                                    !upperLine.includes('DAVAO') && !upperLine.includes('CITY')) {
                                    address.subdivision = line;
                                    console.log(`  ✅ Subdivision extracted: "${address.subdivision}"`);
                                    break;
                                }
                            }

                            // CITY: Extract city information
                            for (const line of addressLines) {
                                const upperLine = line.toUpperCase();

                                if (upperLine.includes('DAVAO CITY') || upperLine.includes('CITY OF DAVAO')) {
                                    address.city = "Davao City";
                                    console.log(`  ✅ City extracted: "${address.city}"`);
                                    break;
                                } else if (upperLine.includes('DAVAO')) {
                                    address.city = "Davao City";
                                    console.log(`  ✅ City extracted (Davao pattern): "${address.city}"`);
                                    break;
                                } else if (upperLine.includes('MANILA') || upperLine.includes('CEBU') ||
                                           upperLine.includes('QUEZON') || upperLine.includes('TAGUM') ||
                                           upperLine.includes('DIGOS') || upperLine.includes('PANABO')) {
                                    address.city = line;
                                    console.log(`  ✅ City extracted: "${address.city}"`);
                                    break;
                                }
                            }
                        }
                        break;
                    }
                }

                // FALLBACK: Look for city in all lines if not found with indicators
                if (!address.city) {
                    console.log('  - City not found with address indicators, using fallback...');
                    address.city = extractCity(lines);
                    if (address.city !== "Not detected") {
                        console.log(`  ✅ City found via fallback: "${address.city}"`);
                    }
                }

                // FALLBACK: If no street found but we have address lines, try to extract something
                if (!address.street) {
                    console.log('  ⚠️ No street found with standard patterns, trying fallback...');

                    // Look for any line with numbers that isn't a date or ID number
                    for (const line of lines) {
                        if (line.match(/\d+/) &&
                            !line.match(/\d{4}[\/\-]\d{2}[\/\-]\d{2}/) && // Not a date
                            !line.match(/\d{4}[-\s]?\d{4}[-\s]?\d{4}[-\s]?\d{4}/) && // Not ID number
                            line.length > 5 && line.length < 50 &&
                            !line.toUpperCase().includes('PETSA') &&
                            !line.toUpperCase().includes('BIRTH')) {
                            address.street = line;
                            console.log(`  ✅ Street (fallback pattern): "${address.street}"`);
                            break;
                        }
                    }
                }

                console.log('\n📊 Address Extraction Summary:');
                console.log(`  Street: "${address.street || 'Not found'}"`);
                console.log(`  Subdivision: "${address.subdivision || 'Not found'}"`);
                console.log(`  City: "${address.city || 'Not found'}"`);

                return address;
            }

            // Extract city from address for National ID (legacy function - now calls extractAddressComponents)
            function extractCityFromAddress(lines) {
                return extractAddressComponents(lines).city;
            }

            // Enhanced birthdate extraction for PhilSys
            function extractBirthdateFromText(text) {
                if (!text) return "";

                // Try various date formats commonly found in PhilSys
                const datePatterns = [
                    /\b(\d{1,2})[\/\-\.](\d{1,2})[\/\-\.](\d{4})\b/, // DD/MM/YYYY or DD-MM-YYYY
                    /\b(\d{4})[\/\-\.](\d{1,2})[\/\-\.](\d{1,2})\b/, // YYYY/MM/DD or YYYY-MM-DD
                    /\b(\d{1,2})\s+(January|February|March|April|May|June|July|August|September|October|November|December)\s+(\d{4})\b/i, // DD Month YYYY
                    /\b(January|February|March|April|May|June|July|August|September|October|November|December)\s+(\d{1,2}),?\s+(\d{4})\b/i // Month DD, YYYY
                ];

                for (const pattern of datePatterns) {
                    const match = text.match(pattern);
                    if (match) {
                        if (pattern === datePatterns[0]) {
                            // DD/MM/YYYY format
                            const [, day, month, year] = match;
                            return `${year}-${month.padStart(2, '0')}-${day.padStart(2, '0')}`;
                        } else if (pattern === datePatterns[1]) {
                            // YYYY/MM/DD format
                            const [, year, month, day] = match;
                            return `${year}-${month.padStart(2, '0')}-${day.padStart(2, '0')}`;
                        } else if (pattern === datePatterns[2] || pattern === datePatterns[3]) {
                            // Text month format
                            const monthNames = {
                                'january': '01', 'february': '02', 'march': '03', 'april': '04',
                                'may': '05', 'june': '06', 'july': '07', 'august': '08',
                                'september': '09', 'october': '10', 'november': '11', 'december': '12'
                            };
                            const month = match[1] || match[2];
                            const day = match[2] || match[3];
                            const year = match[3] || match[4];
                            const monthNum = monthNames[month.toLowerCase()];
                            if (monthNum) {
                                return `${year}-${monthNum}-${day.padStart(2, '0')}`;
                            }
                        }
                    }
                }

                return "";
            }

            // Search all lines for birthdate patterns
            function findBirthdateInText(lines) {
                for (const line of lines) {
                    const birthdate = extractBirthdateFromText(line);
                    if (birthdate) {
                        return birthdate;
                    }
                }
                return "";
            }

            // Check if text contains a date pattern
            function containsDate(text) {
                const datePatterns = [
                    /\b\d{1,2}[\/\-\.]\d{1,2}[\/\-\.]\d{4}\b/,
                    /\b\d{4}[\/\-\.]\d{1,2}[\/\-\.]\d{1,2}\b/,
                    /\b\d{1,2}\s+(January|February|March|April|May|June|July|August|September|October|November|December)\s+\d{4}\b/i,
                    /\b(January|February|March|April|May|June|July|August|September|October|November|December)\s+\d{1,2},?\s+\d{4}\b/i
                ];

                return datePatterns.some(pattern => pattern.test(text));
            }

            // Enhanced gender detection for PhilSys (back only)
            function findGenderInText(lines) {
                console.log('\n🔍 === GENDER EXTRACTION ===');
                console.log(`Analyzing ${lines.length} lines for gender information...`);

                const genderIndicators = ['KASARIAN', 'SEX', 'GENDER', 'KASARIAN/SEX'];
                const malePatterns = ['MALE', 'LALAKI', 'M'];
                const femalePatterns = ['FEMALE', 'BABAE', 'F'];

                // STRATEGY 1: Look for gender indicators followed by value
                for (let i = 0; i < lines.length; i++) {
                    const line = lines[i];
                    const upper = line.toUpperCase();

                    for (const indicator of genderIndicators) {
                        if (upper.includes(indicator)) {
                            console.log(`  - Found gender indicator "${indicator}" at line ${i}: "${line}"`);

                            // Check same line after indicator
                            const afterIndicator = line.substring(line.toUpperCase().indexOf(indicator) + indicator.length).trim();
                            if (afterIndicator) {
                                const afterUpper = afterIndicator.toUpperCase();

                                // Check for male patterns
                                for (const pattern of malePatterns) {
                                    if (afterUpper === pattern || afterUpper.startsWith(pattern + ' ') || afterUpper.includes(' ' + pattern)) {
                                        console.log(`  ✅ Found MALE on same line: "${afterIndicator}"`);
                                        return "Male";
                                    }
                                }

                                // Check for female patterns
                                for (const pattern of femalePatterns) {
                                    if (afterUpper === pattern || afterUpper.startsWith(pattern + ' ') || afterUpper.includes(' ' + pattern)) {
                                        console.log(`  ✅ Found FEMALE on same line: "${afterIndicator}"`);
                                        return "Female";
                                    }
                                }
                            }

                            // Check next line
                            if (i + 1 < lines.length) {
                                const nextLine = lines[i + 1].trim();
                                const nextUpper = nextLine.toUpperCase();
                                console.log(`  - Checking next line: "${nextLine}"`);

                                for (const pattern of malePatterns) {
                                    if (nextUpper === pattern || nextUpper.startsWith(pattern + ' ')) {
                                        console.log(`  ✅ Found MALE on next line`);
                                        return "Male";
                                    }
                                }

                                for (const pattern of femalePatterns) {
                                    if (nextUpper === pattern || nextUpper.startsWith(pattern + ' ')) {
                                        console.log(`  ✅ Found FEMALE on next line`);
                                        return "Female";
                                    }
                                }
                            }
                        }
                    }
                }

                console.log('  - Gender indicator not found, trying fallback methods...');

                // FALLBACK STRATEGY 2: Look for standalone gender keywords (be more strict to avoid false positives)
                for (let i = 0; i < lines.length; i++) {
                    const line = lines[i].trim();
                    const upper = line.toUpperCase();

                    // Only match if line is short (likely to be a gender value)
                    if (line.length >= 1 && line.length <= 10) {
                        // Check for male
                        if (upper === 'MALE' || upper === 'LALAKI' || upper === 'M') {
                            console.log(`  ✅ Fallback: Found standalone MALE at line ${i}: "${line}"`);
                            return "Male";
                        }

                        // Check for female (be careful with 'F' - must be exact match)
                        if (upper === 'FEMALE' || upper === 'BABAE' || upper === 'F') {
                            console.log(`  ✅ Fallback: Found standalone FEMALE at line ${i}: "${line}"`);
                            return "Female";
                        }
                    }
                }

                // FALLBACK STRATEGY 3: Look for gender words anywhere in text (last resort)
                for (let i = 0; i < lines.length; i++) {
                    const line = lines[i].trim();
                    const upper = line.toUpperCase();

                    // Must contain MALE or FEMALE as whole word
                    if (/\bMALE\b/.test(upper) && !/\bFEMALE\b/.test(upper)) {
                        console.log(`  ✅ Pattern match: Found MALE in line ${i}: "${line}"`);
                        return "Male";
                    }

                    if (/\bFEMALE\b/.test(upper)) {
                        console.log(`  ✅ Pattern match: Found FEMALE in line ${i}: "${line}"`);
                        return "Female";
                    }

                    if (/\bLALAKI\b/.test(upper)) {
                        console.log(`  ✅ Pattern match: Found LALAKI in line ${i}: "${line}"`);
                        return "Male";
                    }

                    if (/\bBABAE\b/.test(upper)) {
                        console.log(`  ✅ Pattern match: Found BABAE in line ${i}: "${line}"`);
                        return "Female";
                    }
                }

                console.log('  ❌ ERROR: Could not extract gender from ID!');
                return "";
            }

            // Extract city from driver's license text
            function extractCity(lines) {
                // Look for city patterns
                const cityIndicators = ['DAVAO', 'CAGAYAN', 'CEBU', 'MANILA', 'QUEZON', 'MAKATI', 'TAGUM', 'DIGOS', 'PANABO'];

                for (const line of lines) {
                    for (const indicator of cityIndicators) {
                        if (line.toUpperCase().includes(indicator)) {
                            // Check if it's specifically Davao City
                            if (line.toUpperCase().includes('DAVAO')) {
                                if (line.toUpperCase().includes('CITY') || line.toUpperCase().includes('DAVAO CITY')) {
                                    return "Davao City";
                                }
                            }
                            return cleanText(line);
                        }
                    }
                }

                // Alternative: Look for text that might be a city
                for (const line of lines) {
                    if (line.length > 3 && line.length < 30 &&
                        /^[A-Z][a-zA-Z\s]+$/.test(line) &&
                        !line.includes('REPUBLIC') && !line.includes('PHILIPPINES') &&
                        !line.includes('LICENSE') && !line.includes('DRIVER')) {
                        return cleanText(line);
                    }
                }

                return "Not detected";
            }

            // Check if city is Davao City
            function checkIfDavaoCity(city) {
                if (!city || city === "Not detected") return false;

                const davaoPatterns = [
                    'DAVAO CITY',
                    'CITY OF DAVAO',
                    'DAVAO',
                    'DVO CITY',
                    'D.C.'
                ];

                const normalizedCity = city.toUpperCase().trim();

                for (const pattern of davaoPatterns) {
                    if (normalizedCity.includes(pattern) || pattern.includes(normalizedCity)) {
                        return true;
                    }
                }

                return false;
            }

            // Show Davao City verification result
            function showDavaoVerificationResult(isDavaoCity, detectedCity, idType) {
                // Show for both driver's license and national ID
                davaoVerification.classList.remove('hidden');

                if (isDavaoCity) {
                    // Valid Davao City ID
                    davaoVerification.className = 'p-6 rounded-xl border-l-4 bg-green-50 border-green-200 slide-down';
                    davaoResultIcon.className = 'fas fa-check-circle text-2xl mt-1 text-green-500';
                    davaoResultTitle.textContent = idType === 'driver-license' ? 'Valid Davao City License' : 'Valid Davao City National ID';
                    davaoResultMessage.textContent = idType === 'driver-license'
                        ? 'Your driver\'s license has been verified as issued in Davao City.'
                        : 'Your National ID has been verified as registered in Davao City.';
                    davaoStatusBadge.className = 'px-3 py-1 rounded-full text-sm font-semibold bg-green-500 text-white';
                    davaoStatusBadge.textContent = 'Valid';

                    // Enable form fields for valid ID
                    enableFormFields();
                } else {
                    // Invalid (not Davao City) ID
                    davaoVerification.className = 'p-6 rounded-xl border-l-4 bg-red-50 border-red-200 slide-down';
                    davaoResultIcon.className = 'fas fa-times-circle text-2xl mt-1 text-red-500';
                    davaoResultTitle.textContent = idType === 'driver-license' ? 'License Not From Davao City' : 'National ID Not From Davao City';
                    davaoResultMessage.textContent = `This service is only available for Davao City residents, or your picture may be blurry. Please try again.`;
                    davaoStatusBadge.className = 'px-3 py-1 rounded-full text-sm font-semibold bg-red-500 text-white';
                    davaoStatusBadge.textContent = 'Invalid';

                    // Disable form fields and clear uploaded files for invalid ID
                    disableFormFields();
                    clearUploadedFiles();
                }
            }

            // Disable all form fields
            function disableFormFields() {
                formFields.forEach(fieldId => {
                    const field = document.getElementById(fieldId);
                    if (field) {
                        field.disabled = true;
                        field.classList.add('disabled-field');
                    }
                });

                // Also disable the submit button
                const submitButton = document.querySelector('button[type="submit"]');
                if (submitButton) {
                    submitButton.disabled = true;
                    submitButton.classList.add('opacity-50', 'cursor-not-allowed');
                }
            }

            // Enable all form fields
            function enableFormFields() {
                formFields.forEach(fieldId => {
                    const field = document.getElementById(fieldId);
                    if (field) {
                        field.disabled = false;
                        field.classList.remove('disabled-field');
                    }
                });

                // Also enable the submit button
                const submitButton = document.querySelector('button[type="submit"]');
                if (submitButton) {
                    submitButton.disabled = false;
                    submitButton.classList.remove('opacity-50', 'cursor-not-allowed');
                }
            }

            // Clear uploaded files and reset upload areas
            function clearUploadedFiles() {
                // Clear file inputs
                fileFront.value = '';
                fileBack.value = '';

                // Hide preview images
                imagePreview.classList.add('hidden');
                imagePreviewBack.classList.add('hidden');

                // Remove active class from upload areas
                uploadFront.classList.remove('active');
                uploadBack.classList.remove('active');

                // Clear any extracted data from form fields
                document.getElementById('idnumber').value = '';
                document.getElementById('firstname').value = '';
                document.getElementById('middlename').value = '';
                document.getElementById('lastname').value = '';
                document.getElementById('birthdate').value = '';
                document.getElementById('sex').value = '';
            }

            // Enhanced name cleaning with OCR error correction
            function cleanName(text) {
                if (!text) return "";

                let cleaned = text.trim();

                // OCR error corrections - number to letter
                cleaned = cleaned
                    .replace(/\b0([A-Za-z])/g, 'O$1')       // 0 → O at start
                    .replace(/([A-Za-z])0\b/g, '$1O')       // 0 → O at end
                    .replace(/([A-Za-z])0([A-Za-z])/g, '$1O$2')  // 0 → O in middle
                    .replace(/\b1([A-Za-z])/g, 'I$1')       // 1 → I at start
                    .replace(/([A-Za-z])1([A-Za-z])/g, '$1I$2')  // 1 → I in middle
                    .replace(/\b5([A-Za-z])/g, 'S$1')       // 5 → S at start
                    .replace(/([A-Za-z])5\b/g, '$1S')       // 5 → S at end
                    .replace(/\b8([A-Za-z])/g, 'B$1')       // 8 → B at start
                    .replace(/\bRN\b/gi, 'M')               // RN → M
                    .replace(/VV/g, 'W')                    // VV → W
                    .replace(/\|/g, 'I');                   // | → I

                // Filipino name particles
                cleaned = cleaned
                    .replace(/\bDe\s+La\b/gi, 'Dela')
                    .replace(/\bDe\s+Los\b/gi, 'Delos')
                    .replace(/\bDel\s+/gi, 'Del ');

                // Keep only valid characters
                cleaned = cleaned.replace(/[^a-zA-ZñÑáéíóúÁÉÍÓÚ\s\-\.]/g, "");

                // Normalize spaces
                cleaned = cleaned.replace(/\s+/g, " ");

                // Remove leading/trailing punctuation
                cleaned = cleaned.replace(/^[\-\.\s]+|[\-\.\s]+$/g, "");

                // Remove standalone single characters (likely OCR errors)
                cleaned = cleaned.replace(/\b[a-z]\b/gi, '').replace(/\s+/g, ' ');

                // Capitalize properly
                cleaned = cleaned.split(' ')
                    .filter(word => word.length > 0)
                    .map(word => {
                        const upper = word.toUpperCase();
                        if (upper === 'II' || upper === 'III' || upper === 'IV' ||
                            upper === 'JR' || upper === 'SR') {
                            return upper;
                        }
                        if (word.toLowerCase().startsWith('mc') && word.length > 2) {
                            return 'Mc' + word.charAt(2).toUpperCase() + word.slice(3).toLowerCase();
                        }
                        return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();
                    })
                    .join(' ');

                cleaned = cleaned.trim();

                // Validation
                if (cleaned.length < 2) return "";
                if (/^(.)\1+$/.test(cleaned.replace(/\s/g, ''))) return "";

                return cleaned;
            }

            function cleanText(text) {
                return text
                    .replace(/[^a-zA-Z0-9\s\-,\.]/g, '')
                    .replace(/\s+/g, ' ')
                    .trim();
            }

            function cleanBirthdate(text) {
                if (!text) return "";
                const dateMatch = text.match(/(\d{1,2})[\/\-\.](\d{1,2})[\/\-\.](\d{4})/);
                if (dateMatch) {
                    const [, month, day, year] = dateMatch;
                    return `${year}-${month.padStart(2, '0')}-${day.padStart(2, '0')}`;
                }
                return "";
            }

            function cleanSex(text) {
                const upper = text.toUpperCase();
                if (/MALE/.test(upper) || /\bM\b/.test(upper)) return "Male";
                if (/FEMALE/.test(upper) || /\bF\b/.test(upper)) return "Female";
                if (/LALAKI/.test(upper)) return "Male";
                if (/BABAE/.test(upper)) return "Female";
                return "";
            }

            function updateFormFields(idNumber, firstName, middleName, lastName, birthdate, sex, suffix) {
                if (idNumber) document.getElementById('idnumber').value = idNumber;
                if (firstName) document.getElementById('firstname').value = firstName.toUpperCase();
                if (middleName) document.getElementById('middlename').value = middleName.toUpperCase();
                if (lastName) document.getElementById('lastname').value = lastName.toUpperCase();
                if (birthdate) document.getElementById('birthdate').value = birthdate;
                if (sex) document.getElementById('sex').value = sex;

                // Set suffix in dropdown
                const suffixField = document.querySelector('select[name="Suffix"]');
                if (suffixField && suffix) {
                    // Match the suffix value to the dropdown options
                    const options = Array.from(suffixField.options);
                    const matchingOption = options.find(opt => opt.value === suffix);
                    if (matchingOption) {
                        suffixField.value = suffix;
                    }
                }

                // Show success message
                resultBox.classList.remove('hidden');
                resultBox.textContent = "Information extracted from ID. Please verify the details.";
            }

            function validateFile(file) {
                const validTypes = ['image/jpeg', 'image/png', 'image/jpg'];
                const maxSize = 5 * 1024 * 1024; // 5MB

                if (!validTypes.includes(file.type)) {
                    alert('Please upload a valid image file (JPEG or PNG).');
                    return false;
                }

                if (file.size > maxSize) {
                    alert('File size exceeds 5MB limit.');
                    return false;
                }

                return true;
            }

            // Form validation
            document.getElementById('registrationForm').addEventListener('submit', function(e) {
                if (!terms.checked) {
                    alert('You must agree to the terms and conditions.');
                    e.preventDefault();
                    return;
                }
            });
        });
    </script>
