        // Start selfie camera
        async startSelfieCamera() {
            try {
                const video = document.getElementById('selfie-modal-video');
                const cameraView = document.getElementById('selfie-camera-view');
                const startView = document.getElementById('selfie-start-view');
                const previewView = document.getElementById('selfie-preview-view');
                
                // Use responsive constraints - optimized for mobile devices
                const isMobile = window.innerWidth < 640;
                const isSmallMobile = window.innerWidth < 400;
                const constraints = {
                    video: {
                        width: { ideal: isSmallMobile ? 360 : (isMobile ? 480 : 640), min: 280 },
                        height: { ideal: isSmallMobile ? 480 : (isMobile ? 640 : 854), min: 380 },
                        facingMode: 'user',
                        aspectRatio: { ideal: 3/4 } // Portrait aspect for selfie
                    },
                    audio: false
                };

                this.videoStream = await navigator.mediaDevices.getUserMedia(constraints);
                video.srcObject = this.videoStream;

                // Ensure video element is visible
                video.style.visibility = 'visible';
                video.style.opacity = '1';

                // Wait for video to load and then play
                await video.play();

                // CRITICAL: Hide start view and preview view, only show camera view
                startView.classList.add('hidden');
                startView.style.display = 'none';
                
                previewView.classList.add('hidden');
                previewView.style.display = 'none';
                
                cameraView.classList.remove('hidden');
                cameraView.style.display = 'block';
                
                document.getElementById('capture-selfie-btn').classList.remove('hidden');

                // Fade out the guide text after 3 seconds
                setTimeout(() => {
                    const guideText = document.getElementById('selfie-guide-text');
                    if (guideText) {
                        guideText.classList.add('fade-out');
                    }
                }, 3000);

            } catch (error) {
                console.error('Camera access failed:', error);
                alert('Could not access camera. Please ensure camera permissions are enabled.');
            }
        },
        
        // Capture selfie
        captureSelfie() {
            // Start countdown
            let count = 3;
            const countdownOverlay = document.getElementById('selfie-countdown-overlay');
            const countdownNumber = document.getElementById('selfie-countdown-number');
            
            countdownOverlay.classList.remove('hidden');
            countdownNumber.textContent = count;
            
            document.getElementById('capture-selfie-btn').disabled = true;
            
            this.countdownInterval = setInterval(() => {
                count--;
                if (count > 0) {
                    countdownNumber.textContent = count;
                } else {
                    clearInterval(this.countdownInterval);
                    countdownOverlay.classList.add('hidden');
                    this.takeSelfiePhoto();
                }
            }, 1000);
