        // Take the actual selfie photo - Captures EXACTLY what's visible in the oval frame
        async takeSelfiePhoto() {
            const video = document.getElementById('selfie-modal-video');
            const canvas = document.getElementById('selfie-modal-canvas');

            // Get actual video dimensions
            const videoWidth = video.videoWidth || 640;
            const videoHeight = video.videoHeight || 480;

            // The SVG oval guide uses:
            // - ellipse cx="50%" cy="48%" rx="32%" ry="38%"
            // This means the oval center is at 50% width, 48% height
            // And the oval size is 64% of width and 76% of height

            // Get the video container's display dimensions
            const videoWrapper = video.closest('.selfie-video-wrapper');
            const containerWidth = videoWrapper ? videoWrapper.clientWidth : video.clientWidth;
            const containerHeight = videoWrapper ? videoWrapper.clientHeight : video.clientHeight;

            // Calculate scale from display to video coordinates
            const videoAspect = videoWidth / videoHeight;
            const containerAspect = containerWidth / containerHeight;
            
            let scaleX, scaleY, offsetX = 0, offsetY = 0;
            
            // Handle object-fit: cover scaling
            if (videoAspect > containerAspect) {
                // Video is wider - sides are cropped
                scaleY = videoHeight / containerHeight;
                scaleX = scaleY;
                offsetX = (videoWidth - containerWidth * scaleX) / 2;
            } else {
                // Video is taller - top/bottom are cropped
                scaleX = videoWidth / containerWidth;
                scaleY = scaleX;
                offsetY = (videoHeight - containerHeight * scaleY) / 2;
            }

            // Calculate the oval guide area in video coordinates
            // SVG oval: cx=50%, cy=48%, rx=32%, ry=38%
            const ovalCenterX = containerWidth * 0.50;
            const ovalCenterY = containerHeight * 0.48;
            const ovalRadiusX = containerWidth * 0.32;
            const ovalRadiusY = containerHeight * 0.38;

            // Convert to bounding box
            const guideLeft = ovalCenterX - ovalRadiusX;
            const guideTop = ovalCenterY - ovalRadiusY;
            const guideWidth = ovalRadiusX * 2;
            const guideHeight = ovalRadiusY * 2;

            // Scale to video coordinates
            const guideSourceX = offsetX + guideLeft * scaleX;
            const guideSourceY = offsetY + guideTop * scaleY;
            const guideSourceWidth = guideWidth * scaleX;
            const guideSourceHeight = guideHeight * scaleY;

            // Set canvas output size (maintain aspect ratio, minimum 600px for face recognition)
            const outputWidth = Math.max(Math.round(guideSourceWidth), 600);
            const outputHeight = Math.round(outputWidth * (guideSourceHeight / guideSourceWidth));
            canvas.width = outputWidth;
            canvas.height = outputHeight;

            const ctx = canvas.getContext('2d');
            ctx.imageSmoothingEnabled = true;
            ctx.imageSmoothingQuality = 'high';

            // Mirror the image horizontally to match the preview (selfie camera is mirrored)
            ctx.translate(outputWidth, 0);
            ctx.scale(-1, 1);

            // Draw the oval guide area from video to canvas
            ctx.drawImage(
                video,
                guideSourceX, guideSourceY, guideSourceWidth, guideSourceHeight,
                0, 0, outputWidth, outputHeight
            );

            // Get image data - Use high JPEG quality (0.95) for API
            this.selfieImage = canvas.toDataURL('image/jpeg', 0.95);
            
            // Stop camera
            this.stopCamera();
            
            // Save selfie to server
            try {
                const response = await fetch('/api/IdAnalyzer/saveSelfie', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ imageData: this.selfieImage })
                });
                const result = await response.json();
                if (result.success) {
                    this.selfieFileName = result.fileName;
                }
            } catch (e) {
                console.error('Failed to save selfie:', e);
            }
            
            // Update preview - CRITICAL: Completely hide camera view and start view when showing preview
            document.getElementById('modal-preview-selfie').src = this.selfieImage;
            
            // Hide camera view completely
            const cameraView = document.getElementById('selfie-camera-view');
            cameraView.classList.add('hidden');
            cameraView.style.display = 'none';
            
            // Also hide start view to ensure only preview is visible
            const startView = document.getElementById('selfie-start-view');
            startView.classList.add('hidden');
            startView.style.display = 'none';
            
            // Show preview view
            const previewView = document.getElementById('selfie-preview-view');
            previewView.classList.remove('hidden');
            previewView.style.display = 'flex';
            
            document.getElementById('capture-selfie-btn').classList.add('hidden');
            document.getElementById('finish-upload-btn').disabled = false;
            
            // Store in VerificationState
            if (typeof VerificationState !== 'undefined') {
                VerificationState.setSelfie(this.selfieImage, this.selfieFileName);
            }
        },
        
        // Retake selfie - directly restart camera without showing start view
        retakeSelfie() {
            this.selfieImage = null;
            this.selfieFileName = null;
            
            // Hide preview view
            const previewView = document.getElementById('selfie-preview-view');
