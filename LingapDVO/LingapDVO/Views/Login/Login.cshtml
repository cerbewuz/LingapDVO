@model LoginDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In</title>
    <link rel="icon" type="image/x-icon" href="~/Icon/lingaplogo.ico">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>

    <!-- Inline Critical CSS (replaces Tailwind CDN for production) -->
    <link rel="stylesheet" href="~/css/login-styles.css" asp-append-version="true">
</head>
<body class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-100 p-2 sm:p-4 md:p-6">
    <div class="w-full max-w-xs sm:max-w-sm md:max-w-md lg:max-w-lg xl:max-w-xl">
        <div class="bg-white rounded-xl sm:rounded-2xl shadow-lg sm:shadow-2xl p-4 sm:p-6 md:p-7 lg:p-8 border border-white/20 backdrop-blur-sm">
            <!-- Compact Header -->
            <div class="text-center mb-4 sm:mb-6 md:mb-7 lg:mb-8">
                <h1 class="text-xl sm:text-2xl md:text-2xl lg:text-3xl font-bold bg-gradient-to-r from-gray-800 to-gray-600 bg-clip-text text-transparent mb-1 sm:mb-2">
                    Sign In
                </h1>
            </div>

            <form method="post" id="loginForm" class="space-y-3 sm:space-y-4 md:space-y-4 lg:space-y-5">
                <!-- Success Message -->
                @if (ViewBag.SuccessMessage != null)
                {
                    <div class="bg-green-50 border-l-4 border-green-500 rounded-lg p-4 mb-4 animate-fade-in">
                        <div class="flex items-start">
                            <div class="flex-shrink-0">
                                <i class="fas fa-check-circle text-green-500 text-xl"></i>
                            </div>
                            <div class="ml-3">
                                <p class="text-sm font-medium text-green-800">
                                    @ViewBag.SuccessMessage
                                </p>
                            </div>
                        </div>
                    </div>
                }

                <!-- Validation Summary -->
                <div asp-validation-summary="All"
                     id="validationSummary"
                     class="hidden bg-red-50 border border-red-200 rounded-xl p-4 text-red-600 text-sm transition-opacity duration-300 ease-in-out">
                </div>

                <!-- Username/Email Field - Compact -->
                <div class="space-y-1.5 sm:space-y-2">
                    <div class="relative">
                        <input asp-for="Username"
                               type="text"
                               class="floating-input w-full px-3 sm:px-4 py-2.5 sm:py-3 md:py-3 lg:py-3.5 text-sm sm:text-base border-2 border-gray-200 rounded-lg sm:rounded-xl bg-white"
                               placeholder=" "
                               required
                               autocomplete="username"
                               id="usernameOrEmail">
                        <label for="usernameOrEmail" class="floating-label">
                            <i class="fas fa-user"></i>
                            <span>Enter your username or email</span>
                        </label>
                    </div>
                    <span asp-validation-for="Username" class="text-red-500 text-xs"></span>
                </div>

                <!-- Password Field - Compact -->
                <div class="space-y-1.5 sm:space-y-2">
                    <div class="relative">
                        <input asp-for="Password"
                               type="password"
                               class="floating-input w-full px-3 sm:px-4 py-2.5 sm:py-3 md:py-3 lg:py-3.5 text-sm sm:text-base border-2 border-gray-200 rounded-lg sm:rounded-xl bg-white pr-10 sm:pr-12"
                               placeholder=" "
                               required
                               autocomplete="current-password"
                               id="password">
                        <label for="password" class="floating-label">
                            <i class="fas fa-lock"></i>
                            <span>Enter your password</span>
                        </label>
                        <button type="button" class="absolute right-3 sm:right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none" id="togglePassword">
                            <i class="fas fa-eye text-xs sm:text-sm"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-red-500 text-xs"></span>
                </div>

                <!-- Compact Social Login -->
                <div class="pt-1 sm:pt-2">
                    <div class="flex items-center my-3 sm:my-4">
                        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-gray-300 to-transparent"></div>
                        <span class="px-2 sm:px-3 text-xs sm:text-xs text-gray-500 bg-white font-medium">or continue with</span>
                        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-gray-300 to-transparent"></div>
                    </div>

                    <div class="grid grid-cols-2 gap-2 sm:gap-3">
                        <button type="button" onclick="showGoogleConfirmation()" class="flex items-center justify-center gap-1.5 sm:gap-2 px-2 sm:px-3 py-2 sm:py-2.5 border-2 border-gray-200 rounded-lg sm:rounded-xl hover:border-green-500 hover:bg-green-50 transition-all duration-200 group">
                            <img src="https://www.gstatic.com/images/branding/product/2x/googleg_64dp.png" alt="Google" class="w-3.5 h-3.5 sm:w-4 sm:h-4">
                            <span class="text-xs sm:text-xs font-medium text-gray-600 group-hover:text-green-700">Google</span>
                        </button>

                        <a href="/FacebookLogin" class="flex items-center justify-center gap-1.5 sm:gap-2 px-2 sm:px-3 py-2 sm:py-2.5 bg-blue-600 text-white rounded-lg sm:rounded-xl hover:bg-blue-700 transition-all duration-200 group shadow-sm">
                            <i class="fab fa-facebook-f text-xs sm:text-xs"></i>
                            <span class="text-xs sm:text-xs font-medium">Facebook</span>
                        </a>
                    </div>
                </div>

                <!-- Compact reCAPTCHA -->
                <div class="bg-gray-50 rounded-lg sm:rounded-xl p-2 sm:p-3 border border-gray-200 flex justify-center">
                    <div class="g-recaptcha mx-auto scale-75 sm:scale-90 md:scale-95 lg:scale-100" data-sitekey="@ViewBag.ReCaptchaSiteKey"></div>
                </div>

                <!-- Compact Submit Button -->
                <div class="flex justify-center">
                    <button type="submit" class="bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white px-6 sm:px-8 md:px-10 py-2.5 sm:py-3 md:py-3 lg:py-3.5 rounded-lg sm:rounded-xl font-semibold text-sm sm:text-sm md:text-base lg:text-base shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-300 group border-0 outline-none" id="loginButton" style="border: none;">
                        <span class="flex items-center justify-center gap-1.5 sm:gap-2">
                            <span>Sign In</span>
                            <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform duration-200 text-xs sm:text-sm"></i>
                        </span>
                    </button>
                </div>

                <!-- Compact Links -->
                <div class="text-center space-y-1.5 sm:space-y-2 pt-1 sm:pt-2">
                    <p class="text-gray-500 text-xs sm:text-xs md:text-sm lg:text-sm">
                        Don't have an account?
                        <a href="/Register" class="text-blue-600 hover:text-blue-800 font-semibold transition-colors duration-200 ml-1">Sign up</a>
                    </p>
                    <p class="text-gray-500 text-xs sm:text-xs md:text-sm lg:text-sm">
                        <a href="/" class="text-blue-600 hover:text-blue-800 font-semibold transition-colors duration-200">Back to Home</a>
                    </p>
                </div>
            </form>
        </div>
    </div>

    <!-- Success Animation Modal -->
    <div id="successModal" class="modal-overlay-enhanced">
        <div class="modal-content-enhanced modal-success">
            <div class="modal-icon-wrapper success-icon-wrapper" id="successIconWrapper">
                <div class="success-checkmark">
                    <div class="check-icon">
                        <span class="icon-line line-tip"></span>
                        <span class="icon-line line-long"></span>
                        <div class="icon-circle"></div>
                        <div class="icon-fix"></div>
                    </div>
                </div>
            </div>
            <h3 class="modal-title">Login Successful!</h3>
            <p class="modal-message" id="redirectMessage">Redirecting...</p>
            <div class="progress-container">
                <div id="progressBar" class="progress-bar"></div>
            </div>
        </div>
    </div>

    <!-- Error Modal -->
    <div id="errorModal" class="modal-overlay-enhanced">
        <div class="modal-content-enhanced modal-error">
            <div class="modal-icon-wrapper error-icon-wrapper">
                <div class="error-x-mark">
                    <span class="error-line error-line-left"></span>
                    <span class="error-line error-line-right"></span>
                    <div class="error-circle"></div>
                </div>
            </div>
            <h3 class="modal-title" id="errorModalTitle">Login Failed</h3>
            <p class="modal-message" id="errorModalMessage">An error occurred during login.</p>
            <button type="button" class="modal-button modal-button-error" id="errorModalButton">
                <i class="fas fa-redo-alt mr-2"></i>Try Again
            </button>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Password toggle functionality
            const togglePassword = document.getElementById('togglePassword');
            const passwordInput = document.getElementById('password');

            if (togglePassword && passwordInput) {
                togglePassword.addEventListener('click', function() {
                    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                    passwordInput.setAttribute('type', type);
                    this.innerHTML = type === 'password' ? '<i class="fas fa-eye text-sm"></i>' : '<i class="fas fa-eye-slash text-sm"></i>';
                });
            }

            // Manual spinner rotation using JavaScript
            let spinnerRotation = 0;
            function rotateSpinner() {
                const loginButton = document.getElementById('loginButton');
                if (loginButton && loginButton.querySelector('.fa-spinner')) {
                    spinnerRotation += 30;
                    loginButton.querySelector('.fa-spinner').style.transform = `rotate(${spinnerRotation}deg)`;
                    requestAnimationFrame(rotateSpinner);
                }
            }

            // Show success modal and redirect
            function showSuccessAndRedirect(redirectUrl, userType) {
                const successModal = document.getElementById('successModal');
                const redirectMessage = document.getElementById('redirectMessage');
                const progressBar = document.getElementById('progressBar');

                // Set appropriate message based on user type
                let message = "Redirecting to Homepage...";
                if (userType === 'Admin') {
                    message = "Redirecting to Admin Dashboard...";
                } else if (userType === 'Superadmin') {
                    message = "Redirecting to Superadmin Panel...";
                }

                redirectMessage.textContent = message;

                // Show modal with enhanced animation
                successModal.classList.add('show');

                // Animate progress bar
                let progress = 0;
                const interval = setInterval(() => {
                    progress += 20;
                    progressBar.style.width = progress + '%';

                    if (progress >= 100) {
                        clearInterval(interval);
                        window.location.href = redirectUrl;
                    }
                }, 100); // Total animation: 500ms
            }

            // Show error modal
            function showErrorModal(title, message) {
                const errorModal = document.getElementById('errorModal');
                const errorModalTitle = document.getElementById('errorModalTitle');
                const errorModalMessage = document.getElementById('errorModalMessage');

                errorModalTitle.textContent = title;
                errorModalMessage.textContent = message;

                // Show modal with enhanced animation
                errorModal.classList.add('show');

                // Reset reCAPTCHA when error modal is shown
                grecaptcha.reset();
            }

            // Close error modal when button is clicked
            document.getElementById('errorModalButton').addEventListener('click', function() {
                const errorModal = document.getElementById('errorModal');
                errorModal.classList.remove('show');
                setTimeout(() => {
                    errorModal.classList.add('hide');
                }, 300);
            });

            // Close error modal when clicking outside
            document.getElementById('errorModal').addEventListener('click', function(e) {
                if (e.target === this) {
                    this.classList.remove('show');
                    setTimeout(() => {
                        this.classList.add('hide');
                    }, 300);
                }
            });

            // Form submission handler with AJAX
            document.getElementById('loginForm').addEventListener('submit', async function(event) {
                event.preventDefault();

                const recaptchaResponse = grecaptcha.getResponse();
                if (!recaptchaResponse) {
                    showErrorModal('reCAPTCHA Required', 'Please complete the reCAPTCHA verification to continue.');
                    return false;
                }

                const usernameOrEmail = document.getElementById('usernameOrEmail').value.trim();
                const password = document.getElementById('password').value;

                if (!usernameOrEmail) {
                    showErrorModal('Username Required', 'Please enter your username or email address.');
                    return false;
                }

                if (!password) {
                    showErrorModal('Password Required', 'Please enter your password.');
                    return false;
                }

                // Show loading state with manual spinner
                const loginButton = document.getElementById('loginButton');
                const originalContent = loginButton.innerHTML;
                loginButton.innerHTML = '<i class="fas fa-spinner"></i> Signing in...';
                loginButton.disabled = true;
                rotateSpinner();

                // Prepare form data for AJAX submission
                const formData = new FormData();
                formData.append('Username', usernameOrEmail);
                formData.append('Password', password);
                formData.append('g-recaptcha-response', recaptchaResponse);

                try {
                    const response = await fetch('/Login/Login', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    const result = await response.json();

                    if (result.success) {
                        // SUCCESS: Show success modal and redirect
                        showSuccessAndRedirect(result.redirectUrl, result.userType);
                    } else {
                        // ERROR: Reset button state and show error modal
                        loginButton.innerHTML = originalContent;
                        loginButton.disabled = false;

                        // Show appropriate error modal based on error type
                        if (result.errorType === 'recaptcha') {
                            showErrorModal(result.title || 'reCAPTCHA Error', result.message || 'reCAPTCHA verification failed.');
                        } else if (result.errorType === 'cooldown') {
                            showErrorModal(result.title || 'Login Temporarily Disabled', result.message || 'Too many failed attempts. Please try again later.');
                        } else if (result.errorType === 'credentials') {
                            showErrorModal(result.title || 'Login Failed', result.message || 'Invalid username or password. Please try again.');
                        } else if (result.errorType === 'account') {
                            showErrorModal(result.title || 'Account Issue', result.message || 'There is an issue with your account. Please contact support.');
                        } else if (result.errorType === 'validation') {
                            showErrorModal(result.title || 'Validation Error', result.message || 'Please check your input and try again.');
                        } else {
                            showErrorModal(result.title || 'Login Failed', result.message || 'An error occurred during login. Please try again.');
                        }
                    }
                } catch (error) {
                    console.error('Login error:', error);

                    // Reset button state
                    loginButton.innerHTML = originalContent;
                    loginButton.disabled = false;

                    showErrorModal('Network Error', 'An error occurred while processing your request. Please check your connection and try again.');
                }
            });

            // Enhanced input validation with color state management
            const inputs = document.querySelectorAll('.floating-input');

            inputs.forEach(input => {
                const label = input.nextElementSibling;

                // On input - show success state when typing valid content
                input.addEventListener('input', function() {
                    if (this.value.trim() !== '') {
                        // User is typing - show success state
                        this.classList.remove('error');
                        this.classList.add('success');

                        if (label && label.classList.contains('floating-label')) {
                            label.classList.remove('error');
                            label.classList.add('success', 'active');
                        }
                    } else {
                        // Field is empty - remove all states
                        this.classList.remove('error', 'success');

                        if (label && label.classList.contains('floating-label')) {
                            label.classList.remove('error', 'success', 'active');
                        }
                    }
                });

                // On blur - validate and show error if empty
                input.addEventListener('blur', function() {
                    if (this.value.trim() === '') {
                        // Show error state for empty field
                        this.classList.remove('success');
                        this.classList.add('error');

                        if (label && label.classList.contains('floating-label')) {
                            label.classList.remove('success', 'active');
                            label.classList.add('error');
                        }
                    } else {
                        // Keep success state for filled field
                        this.classList.remove('error');
                        this.classList.add('success');

                        if (label && label.classList.contains('floating-label')) {
                            label.classList.remove('error');
                            label.classList.add('success', 'active');
                        }
                    }
                });

                // On focus - remove error state and show focus styling
                input.addEventListener('focus', function() {
                    if (this.classList.contains('error')) {
                        this.classList.remove('error');

                        if (label && label.classList.contains('floating-label')) {
                            label.classList.remove('error');
                            label.classList.add('active');
                        }
                    }
                });
            });

            // Initialize floating labels for fields with values
            document.querySelectorAll('.floating-input').forEach(input => {
                const label = input.nextElementSibling;
                if (input.value.trim() !== '' && label && label.classList.contains('floating-label')) {
                    label.classList.add('active', 'success');
                    input.classList.add('success');
                }
            });

            // Auto-focus on first input
            const firstInput = document.getElementById('usernameOrEmail');
            if (firstInput && firstInput.value === '') {
                setTimeout(() => firstInput.focus(), 100);
            }
        });

        // Handle reCAPTCHA callback
        function onRecaptchaSuccess(token) {
            console.log('reCAPTCHA verified successfully');
        }

        function onRecaptchaError() {
            console.error('reCAPTCHA verification failed');
        }

        function onRecaptchaExpired() {
            console.log('reCAPTCHA token expired');
        }

        // Suppress Google reCAPTCHA storage warnings (expected behavior with tracking prevention)
        // This is a known issue when browsers block third-party cookies
        window.addEventListener('error', function(e) {
            // Suppress reCAPTCHA storage access errors (privacy feature, not a bug)
            if (e.message && e.message.includes('storage') && e.message.includes('google.com')) {
                e.preventDefault();
                return false;
            }
        }, true);

        // Suppress console warnings about storage access (informational only)
        const originalConsoleWarn = console.warn;
        console.warn = function(...args) {
            const message = args[0];
            if (typeof message === 'string' && message.includes('storage') && message.includes('google.com')) {
                // Silently ignore storage warnings from Google domains
                return;
            }
            originalConsoleWarn.apply(console, args);
        };
    </script>

    <!-- Session Timeout Toast Notification -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Check if there's a session timeout message
            const timeoutMessage = '@ViewBag.TimeoutMessage';

            // If session timeout occurred, show toast notification
            if (timeoutMessage && timeoutMessage.trim() !== '') {
                showSessionTimeoutToast();
            }
        });

        function showSessionTimeoutToast() {
            // Create toast container if it doesn't exist
            let toastContainer = document.getElementById('sessionToastContainer');
            if (!toastContainer) {
                toastContainer = document.createElement('div');
                toastContainer.id = 'sessionToastContainer';
                toastContainer.style.cssText = `
                    position: fixed;
                    top: 20px;
                    right: 20px;
                    z-index: 10000;
                    max-width: 400px;
                `;
                document.body.appendChild(toastContainer);
            }

            // Create toast element
            const toast = document.createElement('div');
            toast.className = 'session-timeout-toast';
            toast.innerHTML = `
                <div style="
                    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
                    border-radius: 12px;
                    padding: 20px;
                    box-shadow: 0 10px 40px rgba(102, 126, 234, 0.4);
                    color: white;
                    animation: slideInRight 0.5s ease-out, fadeOut 0.5s ease-in 4.5s;
                    min-width: 350px;
                ">
                    <div style="display: flex; align-items: start; gap: 15px;">
                        <div style="
                            background: rgba(255, 255, 255, 0.2);
                            border-radius: 50%;
                            width: 48px;
                            height: 48px;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            flex-shrink: 0;
                        ">
                            <i class="fas fa-clock" style="font-size: 24px;"></i>
                        </div>
                        <div style="flex: 1;">
                            <div style="font-weight: 700; font-size: 16px; margin-bottom: 5px;">
                                <strong>Session Stopped due to Inactivity</strong>
                            </div>
                            <div style="font-size: 14px; opacity: 0.95; line-height: 1.4;">
                                You have been signed out due to inactivity.
                            </div>
                        </div>
                        <button onclick="this.closest('.session-timeout-toast').remove()"
                                style="
                                    background: rgba(255, 255, 255, 0.2);
                                    border: none;
                                    color: white;
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 50%;
                                    cursor: pointer;
                                    display: flex;
                                    align-items: center;
                                    justify-content: center;
                                    transition: background 0.2s;
                                    flex-shrink: 0;
                                "
                                onmouseover="this.style.background='rgba(255, 255, 255, 0.3)'"
                                onmouseout="this.style.background='rgba(255, 255, 255, 0.2)'">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <div style="
                        margin-top: 15px;
                        height: 4px;
                        background: rgba(255, 255, 255, 0.2);
                        border-radius: 2px;
                        overflow: hidden;
                    ">
                        <div style="
                            height: 100%;
                            background: rgba(255, 255, 255, 0.8);
                            width: 100%;
                            animation: shrinkProgress 5s linear;
                        "></div>
                    </div>
                </div>
            `;

            toastContainer.appendChild(toast);

            // Auto-remove toast after 5 seconds
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 500);
            }, 5000);
        }
    </script>

    <!-- Google Credential Conflict Modal -->
    @if (TempData["GoogleCredentialConflict"] != null)
    {
        <div class="modal-overlay-enhanced show" id="googleConflictModal">
            <div class="modal-content-enhanced modal-warning">
                <div class="modal-icon-wrapper warning-icon-wrapper">
                    <div class="warning-icon-animated">
                        <span class="warning-exclamation">!</span>
                        <div class="warning-circle"></div>
                    </div>
                </div>
                <h3 class="modal-title text-xl sm:text-2xl">
                    @TempData["GoogleConflictType"]
                </h3>
                <p class="modal-message mb-5 sm:mb-6">
                    @Html.Raw(TempData["GoogleConflictMessage"])
                </p>
                <div class="modal-actions">
                    <button onclick="closeConflictModal()" class="modal-button modal-button-secondary">
                        <i class="fas fa-times mr-2"></i>Close
                    </button>
                    <a href="mailto:support@lingapdvo.com" class="modal-button modal-button-primary">
                        <i class="fas fa-envelope mr-2"></i>Contact Support
                    </a>
                </div>
            </div>
        </div>

        <script>
            function closeConflictModal() {
                const modal = document.getElementById('googleConflictModal');
                if (modal) {
                    modal.classList.remove('show');
                    modal.classList.add('hide');
                    setTimeout(() => {
                        modal.remove();
                    }, 300);
                }
            }

            // Close modal on escape key
            document.addEventListener('keydown', function(event) {
                if (event.key === 'Escape') {
                    closeConflictModal();
                }
            });

            // Close modal on overlay click
            document.getElementById('googleConflictModal')?.addEventListener('click', function(event) {
                if (event.target === this) {
                    closeConflictModal();
                }
            });
        </script>
    }

    <!-- Google Sign-In Confirmation Modal -->
    <div class="modal-overlay-enhanced" id="googleConfirmationModal" style="display: none;">
        <div class="modal-content-enhanced modal-info">
            <div class="modal-icon-wrapper info-icon-wrapper">
                <div class="info-icon-animated">
                    <i class="fas fa-exclamation-triangle"></i>
                    <div class="info-circle"></div>
                </div>
            </div>
            <h3 class="modal-title text-lg sm:text-xl mb-3 sm:mb-4">
                Important: Google Account Name Verification
            </h3>
            <div class="modal-content-scrollable">
                <p class="modal-subtitle">
                    <i class="fas fa-info-circle text-blue-500 mr-2"></i>
                    Before proceeding, please confirm:
                </p>
                <ul class="modal-list">
                    <li class="modal-list-item">
                        <i class="fas fa-check-circle text-green-500"></i>
                        <span>The name in your Google account must be your <strong>real, legal name</strong></span>
                    </li>
                    <li class="modal-list-item">
                        <i class="fas fa-id-card text-blue-500"></i>
                        <span>Your name will be <strong>verified against a valid ID</strong> during Account Verification</span>
                    </li>
                    <li class="modal-list-item">
                        <i class="fas fa-times-circle text-red-500"></i>
                        <span>You <strong>cannot complete verification</strong> if your Google name doesn't match your valid ID</span>
                    </li>
                    <li class="modal-list-item">
                        <i class="fas fa-ban text-red-500"></i>
                        <span>Accounts with fake or invalid names may be <strong>suspended</strong></span>
                    </li>
                </ul>
            </div>
            <div class="modal-actions">
                <button onclick="closeGoogleConfirmation()" class="modal-button modal-button-secondary">
                    <i class="fas fa-times mr-2"></i>Cancel
                </button>
                <button onclick="proceedToGoogle()" class="modal-button modal-button-success">
                    <i class="fas fa-check mr-2"></i>I Understand, Continue
                </button>
            </div>
        </div>
    </div>

    <script>
        function showGoogleConfirmation() {
            const modal = document.getElementById('googleConfirmationModal');
            if (modal) {
                modal.style.display = 'flex';
                // Trigger reflow to ensure transition works
                modal.offsetHeight;
                modal.classList.add('show');
            }
        }

        function closeGoogleConfirmation() {
            const modal = document.getElementById('googleConfirmationModal');
            if (modal) {
                modal.classList.remove('show');
                modal.classList.add('hide');
                setTimeout(() => {
                    modal.style.display = 'none';
                    modal.classList.remove('hide');
                }, 300);
            }
        }

        function proceedToGoogle() {
            // Redirect to Google Sign-In
            window.location.href = '/GoogleLogin';
        }

        // Close modal on escape key
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                const modal = document.getElementById('googleConfirmationModal');
                if (modal && modal.style.display === 'flex') {
                    closeGoogleConfirmation();
                }
            }
        });

        // Close modal on overlay click
        document.getElementById('googleConfirmationModal')?.addEventListener('click', function(event) {
            if (event.target === this) {
                closeGoogleConfirmation();
            }
        });
    </script>
</body>
</html>