@model LoginDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign In</title>
    <link rel="icon" type="image/x-icon" href="~/lingaplogo.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
</head>
<body class="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 to-indigo-100 p-4">
    <div class="w-full max-w-sm lg:max-w-md">
        <div class="bg-white rounded-2xl shadow-2xl p-6 lg:p-8 border border-white/20 backdrop-blur-sm">
            <!-- Compact Header -->
            <div class="text-center mb-6 lg:mb-8">
                <h1 class="text-2xl lg:text-3xl font-bold bg-gradient-to-r from-gray-800 to-gray-600 bg-clip-text text-transparent mb-2">
                    Sign In
                </h1>
            </div>

            <form method="post" id="loginForm" class="space-y-4 lg:space-y-5">
                <!-- Validation Summary -->
                <div asp-validation-summary="All"
                     id="validationSummary"
                     class="hidden bg-red-50 border border-red-200 rounded-xl p-4 text-red-600 text-sm transition-opacity duration-300 ease-in-out">
                </div>

                <!-- Username/Email Field - Compact -->
                <div class="space-y-2">
                    <label class="block text-sm font-semibold text-gray-700">
                        Username or Email
                    </label>
                    <div class="relative">
                        <input asp-for="Username"
                               type="text"
                               class="w-full px-4 py-3 lg:py-3.5 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-green-500 focus:ring-2 focus:ring-green-200 transition-all duration-200 bg-white placeholder-transparent"
                               placeholder=" "
                               required
                               autocomplete="username"
                               id="usernameOrEmail">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 transition-all duration-200 pointer-events-none bg-white px-1">
                            <i class="fas fa-user mr-2 text-crimson-500"></i>Enter your username or email
                        </span>
                    </div>
                    <span asp-validation-for="Username" class="text-red-500 text-xs"></span>
                </div>

                <!-- Password Field - Compact -->
                <div class="space-y-2">
                    <label class="block text-sm font-semibold text-gray-700">
                        Password
                    </label>
                    <div class="relative">
                        <input asp-for="Password"
                               type="password"
                               class="w-full px-4 py-3 lg:py-3.5 border-2 border-gray-200 rounded-xl focus:outline-none focus:border-green-500 focus:ring-2 focus:ring-green-200 transition-all duration-200 bg-white pr-12"
                               placeholder="Enter your password"
                               required
                               autocomplete="current-password"
                               id="password">
                        <button type="button" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none" id="togglePassword">
                            <i class="fas fa-eye text-sm"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-red-500 text-xs"></span>
                </div>

                <!-- Compact Social Login -->
                <div class="pt-2">
                    <div class="flex items-center my-4">
                        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-gray-300 to-transparent"></div>
                        <span class="px-3 text-xs text-gray-500 bg-white font-medium">or continue with</span>
                        <div class="flex-1 h-px bg-gradient-to-r from-transparent via-gray-300 to-transparent"></div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <a href="/Login/GoogleLogin" class="flex items-center justify-center gap-2 px-3 py-2.5 border-2 border-gray-200 rounded-xl hover:border-green-500 hover:bg-green-50 transition-all duration-200 group">
                            <img src="https://www.gstatic.com/images/branding/product/2x/googleg_64dp.png" alt="Google" class="w-4 h-4">
                            <span class="text-xs font-medium text-gray-600 group-hover:text-green-700">Google</span>
                        </a>

                        <a href="/Login/FacebookLogin" class="flex items-center justify-center gap-2 px-3 py-2.5 bg-blue-600 text-white rounded-xl hover:bg-blue-700 transition-all duration-200 group shadow-sm">
                            <i class="fab fa-facebook-f text-xs"></i>
                            <span class="text-xs font-medium">Facebook</span>
                        </a>
                    </div>
                </div>

                <!-- Compact reCAPTCHA -->
                <div class="bg-gray-50 rounded-xl p-3 border border-gray-200">
                    <div class="g-recaptcha mx-auto scale-90 lg:scale-100" data-sitekey="6Lfdj1orAAAAAGDqwcRDBkTCHoXYx9mLDeCn7kwV"></div>
                </div>

                <!-- Compact Submit Button -->
                <button type="submit" class="w-full bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white py-3 lg:py-3.5 rounded-xl font-semibold text-sm lg:text-base shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-300 group" id="loginButton">
                    <span class="flex items-center justify-center gap-2">
                        <span>Sign In</span>
                        <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform duration-200"></i>
                    </span>
                </button>

                <!-- Compact Links -->
                <div class="text-center space-y-2 pt-2">
                    <p class="text-gray-500 text-xs lg:text-sm">
                        Don't have an account?
                        <a href="/Register" class="text-blue-600 hover:text-blue-800 font-semibold transition-colors duration-200 ml-1">Sign up</a>
                    </p>
                    <p class="text-gray-500 text-xs lg:text-sm">
                        <a href="/" class="text-blue-600 hover:text-blue-800 font-semibold transition-colors duration-200">Back to Home</a>
                    </p>
                </div>
            </form>
        </div>
    </div>

    <!-- Success Animation Modal -->
    <div id="successModal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 z-50 hidden">
        <div class="bg-white rounded-2xl p-8 text-center shadow-2xl max-w-sm mx-4">
            <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4" id="successIcon">
                <i class="fas fa-check text-green-600 text-2xl"></i>
            </div>
            <h3 class="text-xl font-bold text-gray-800 mb-2">Login Successful!</h3>
            <p class="text-gray-600 mb-4" id="redirectMessage">Redirecting...</p>
            <div class="w-full bg-gray-200 rounded-full h-2">
                <div id="progressBar" class="h-2 rounded-full bg-green-500 transition-all duration-500 ease-out" style="width: 0%"></div>
            </div>
        </div>
    </div>

    <!-- Error Modal -->
    <div id="errorModal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 z-50 hidden">
        <div class="bg-white rounded-2xl p-8 text-center shadow-2xl max-w-sm mx-4">
            <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fas fa-exclamation-triangle text-red-600 text-2xl"></i>
            </div>
            <h3 class="text-xl font-bold text-gray-800 mb-2" id="errorModalTitle">Login Failed</h3>
            <p class="text-gray-600 mb-6" id="errorModalMessage">An error occurred during login.</p>
            <button type="button" class="w-full bg-red-600 hover:bg-red-700 text-white py-3 px-6 rounded-xl font-semibold shadow-sm hover:shadow-md transition-all duration-200" id="errorModalButton">
                Try Again
            </button>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Password toggle functionality
            const togglePassword = document.getElementById('togglePassword');
            const passwordInput = document.getElementById('password');

            if (togglePassword && passwordInput) {
                togglePassword.addEventListener('click', function() {
                    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                    passwordInput.setAttribute('type', type);
                    this.innerHTML = type === 'password' ? '<i class="fas fa-eye text-sm"></i>' : '<i class="fas fa-eye-slash text-sm"></i>';
                });
            }

            // Manual spinner rotation using JavaScript
            let spinnerRotation = 0;
            function rotateSpinner() {
                const loginButton = document.getElementById('loginButton');
                if (loginButton && loginButton.querySelector('.fa-spinner')) {
                    spinnerRotation += 30;
                    loginButton.querySelector('.fa-spinner').style.transform = `rotate(${spinnerRotation}deg)`;
                    requestAnimationFrame(rotateSpinner);
                }
            }

            // Create pulsing animation using JavaScript
            function startPulseAnimation() {
                const successIcon = document.getElementById('successIcon');
                let opacity = 1;
                let direction = -1;

                function pulse() {
                    opacity += direction * 0.03;
                    if (opacity <= 0.7 || opacity >= 1) {
                        direction *= -1;
                    }
                    successIcon.style.opacity = opacity;
                    requestAnimationFrame(pulse);
                }
                pulse();
            }

            // Show success modal and redirect
            function showSuccessAndRedirect(redirectUrl, userType) {
                const successModal = document.getElementById('successModal');
                const redirectMessage = document.getElementById('redirectMessage');
                const progressBar = document.getElementById('progressBar');

                // Set appropriate message based on user type
                let message = "Redirecting to Homepage...";
                if (userType === 'Admin') {
                    message = "Redirecting to Admin Dashboard...";
                } else if (userType === 'Superadmin') {
                    message = "Redirecting to Superadmin Panel...";
                }

                redirectMessage.textContent = message;

                // Show modal
                successModal.classList.remove('hidden');

                // Start pulsing animation
                startPulseAnimation();

                // Animate progress bar
                let progress = 0;
                const interval = setInterval(() => {
                    progress += 20;
                    progressBar.style.width = progress + '%';

                    if (progress >= 100) {
                        clearInterval(interval);
                        window.location.href = redirectUrl;
                    }
                }, 100); // Total animation: 500ms
            }

            // Show error modal
            function showErrorModal(title, message) {
                const errorModal = document.getElementById('errorModal');
                const errorModalTitle = document.getElementById('errorModalTitle');
                const errorModalMessage = document.getElementById('errorModalMessage');

                errorModalTitle.textContent = title;
                errorModalMessage.textContent = message;

                // Show modal
                errorModal.classList.remove('hidden');

                // Reset reCAPTCHA when error modal is shown
                grecaptcha.reset();
            }

            // Close error modal when button is clicked
            document.getElementById('errorModalButton').addEventListener('click', function() {
                document.getElementById('errorModal').classList.add('hidden');
            });

            // Close error modal when clicking outside
            document.getElementById('errorModal').addEventListener('click', function(e) {
                if (e.target === this) {
                    this.classList.add('hidden');
                }
            });

            // Form submission handler with AJAX
            document.getElementById('loginForm').addEventListener('submit', async function(event) {
                event.preventDefault();

                const recaptchaResponse = grecaptcha.getResponse();
                if (!recaptchaResponse) {
                    showErrorModal('reCAPTCHA Required', 'Please complete the reCAPTCHA verification to continue.');
                    return false;
                }

                const usernameOrEmail = document.getElementById('usernameOrEmail').value.trim();
                const password = document.getElementById('password').value;

                if (!usernameOrEmail) {
                    showErrorModal('Username Required', 'Please enter your username or email address.');
                    return false;
                }

                if (!password) {
                    showErrorModal('Password Required', 'Please enter your password.');
                    return false;
                }

                // Show loading state with manual spinner
                const loginButton = document.getElementById('loginButton');
                const originalContent = loginButton.innerHTML;
                loginButton.innerHTML = '<i class="fas fa-spinner"></i> Signing in...';
                loginButton.disabled = true;
                rotateSpinner();

                // Prepare form data for AJAX submission
                const formData = new FormData();
                formData.append('Username', usernameOrEmail);
                formData.append('Password', password);
                formData.append('g-recaptcha-response', recaptchaResponse);

                try {
                    const response = await fetch('/Login/Login', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    const result = await response.json();

                    if (result.success) {
                        // SUCCESS: Show success modal and redirect
                        showSuccessAndRedirect(result.redirectUrl, result.userType);
                    } else {
                        // ERROR: Reset button state and show error modal
                        loginButton.innerHTML = originalContent;
                        loginButton.disabled = false;

                        // Show appropriate error modal based on error type
                        if (result.errorType === 'recaptcha') {
                            showErrorModal(result.title || 'reCAPTCHA Error', result.message || 'reCAPTCHA verification failed.');
                        } else if (result.errorType === 'cooldown') {
                            showErrorModal(result.title || 'Login Temporarily Disabled', result.message || 'Too many failed attempts. Please try again later.');
                        } else if (result.errorType === 'credentials') {
                            showErrorModal(result.title || 'Login Failed', result.message || 'Invalid username or password. Please try again.');
                        } else if (result.errorType === 'account') {
                            showErrorModal(result.title || 'Account Issue', result.message || 'There is an issue with your account. Please contact support.');
                        } else if (result.errorType === 'validation') {
                            showErrorModal(result.title || 'Validation Error', result.message || 'Please check your input and try again.');
                        } else {
                            showErrorModal(result.title || 'Login Failed', result.message || 'An error occurred during login. Please try again.');
                        }
                    }
                } catch (error) {
                    console.error('Login error:', error);

                    // Reset button state
                    loginButton.innerHTML = originalContent;
                    loginButton.disabled = false;

                    showErrorModal('Network Error', 'An error occurred while processing your request. Please check your connection and try again.');
                }
            });

            // Enhanced input validation
            const inputs = document.querySelectorAll('input[required]');

            inputs.forEach(input => {
                input.addEventListener('blur', function() {
                    if (this.value.trim() === '') {
                        this.style.borderColor = '#ef4444';
                    } else {
                        this.style.borderColor = '#10b981';
                    }
                });

                input.addEventListener('input', function() {
                    if (this.checkValidity() && this.value.trim() !== '') {
                        this.style.borderColor = '#10b981';
                    } else {
                        this.style.borderColor = '';
                    }
                });
            });

            // Auto-focus on first input
            const firstInput = document.getElementById('usernameOrEmail');
            if (firstInput && firstInput.value === '') {
                setTimeout(() => firstInput.focus(), 100);
            }

            // Floating label functionality
            const usernameInput = document.getElementById('usernameOrEmail');
            const usernameLabel = usernameInput.nextElementSibling;

            usernameInput.addEventListener('focus', function() {
                usernameLabel.style.top = '0';
                usernameLabel.style.fontSize = '0.75rem';
                usernameLabel.style.color = '#10b981';
                usernameLabel.style.transform = 'translateY(-50%)';
            });

            usernameInput.addEventListener('blur', function() {
                if (this.value.trim() === '') {
                    usernameLabel.style.top = '50%';
                    usernameLabel.style.fontSize = '0.875rem';
                    usernameLabel.style.color = '#9ca3af';
                    usernameLabel.style.transform = 'translateY(-50%)';
                }
            });

            // Initialize label position
            if (usernameInput.value.trim() !== '') {
                usernameLabel.style.top = '0';
                usernameLabel.style.fontSize = '0.75rem';
                usernameLabel.style.color = '#10b981';
                usernameLabel.style.transform = 'translateY(-50%)';
            }
        });

        // Handle reCAPTCHA callback
        function onRecaptchaSuccess(token) {
            console.log('reCAPTCHA verified successfully');
        }

        function onRecaptchaError() {
            console.error('reCAPTCHA verification failed');
        }

        function onRecaptchaExpired() {
            console.log('reCAPTCHA token expired');
        }
    </script>

    <!--New Script for Notifications-->
    <script>
        // Initialize tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        });

        // Notification functionality
        document.addEventListener('DOMContentLoaded', function() {
            const notificationButton = document.getElementById('notificationButton');
            const notificationDropdown = document.getElementById('notificationDropdown');
            const notificationBadge = document.getElementById('notificationBadge');
            const notificationList = document.getElementById('notificationList');
            const markAllRead = document.getElementById('markAllRead');

            let isDropdownOpen = false;
            let notificationCheckInterval;

            // Toggle notification dropdown
            notificationButton.addEventListener('click', function(e) {
                e.stopPropagation();
                isDropdownOpen = !isDropdownOpen;
                notificationDropdown.style.display = isDropdownOpen ? 'block' : 'none';

                if (isDropdownOpen) {
                    loadNotifications();
                    startRealTimeUpdates();
                } else {
                    stopRealTimeUpdates();
                }
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', function() {
                if (isDropdownOpen) {
                    notificationDropdown.style.display = 'none';
                    isDropdownOpen = false;
                    stopRealTimeUpdates();
                }
            });

            // Mark all as read
            markAllRead.addEventListener('click', function(e) {
                e.stopPropagation();
                markAllNotificationsAsRead();
            });

            // Real-time update functions
            function startRealTimeUpdates() {
                // Check for new notifications every 10 seconds when dropdown is open
                notificationCheckInterval = setInterval(loadNotifications, 10000);
            }

            function stopRealTimeUpdates() {
                if (notificationCheckInterval) {
                    clearInterval(notificationCheckInterval);
                }
            }

            // Load notifications from server asynchronously
            async function loadNotifications() {
                try {
                    const response = await fetch('/api/notifications/user-notifications', {
                        method: 'GET',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        credentials: 'include' // Important for session cookies
                    });

                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }

                    const notifications = await response.json();
                    updateNotificationUI(notifications);

                    // Also update the badge count
                    updateUnreadCount();
                } catch (error) {
                    console.error('Error loading notifications:', error);
                    // Show offline or error state
                    showErrorState();
                }
            }

            // Update unread count asynchronously
            async function updateUnreadCount() {
                try {
                    const response = await fetch('/api/notifications/unread-count', {
                        method: 'GET',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        credentials: 'include'
                    });

                    if (response.ok) {
                        const result = await response.json();
                        const unreadCount = result.count;

                        if (unreadCount > 0) {
                            notificationBadge.textContent = unreadCount > 99 ? '99+' : unreadCount;
                            notificationBadge.style.display = 'flex';
                        } else {
                            notificationBadge.style.display = 'none';
                        }
                    }
                } catch (error) {
                    console.error('Error updating unread count:', error);
                }
            }

            // Mark notification as read asynchronously
            async function markNotificationAsRead(notificationId) {
                try {
                    const response = await fetch(`/api/notifications/mark-as-read/${notificationId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        credentials: 'include'
                    });

                    if (response.ok) {
                        // Reload notifications to reflect the change
                        await loadNotifications();
                    }
                } catch (error) {
                    console.error('Error marking notification as read:', error);
                }
            }

            // Mark all notifications as read asynchronously
            async function markAllNotificationsAsRead() {
                try {
                    const response = await fetch('/api/notifications/mark-all-read', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        credentials: 'include'
                    });

                    if (response.ok) {
                        // Reload notifications and update badge
                        await loadNotifications();
                        await updateUnreadCount();

                        // Show success feedback
                        showTempMessage('All notifications marked as read');
                    }
                } catch (error) {
                    console.error('Error marking all notifications as read:', error);
                    showTempMessage('Error marking notifications as read', true);
                }
            }

            function updateNotificationUI(notifications) {
                notificationList.innerHTML = '';

                if (!notifications || notifications.length === 0) {
                    notificationList.innerHTML = `
                        <div class="notification-empty">
                            <i class="fas fa-bell-slash fa-2x mb-2"></i>
                            <p>No notifications</p>
                        </div>
                    `;
                    return;
                }

                notifications.forEach(notification => {
                    const notificationItem = document.createElement('div');
                    notificationItem.className = `notification-item ${notification.isRead ? '' : 'unread'}`;
                    notificationItem.innerHTML = `
                        <div class="notification-title">${escapeHtml(notification.title)}</div>
                        <div class="notification-message">${escapeHtml(notification.message)}</div>
                        <div class="notification-time">${formatTime(notification.createdAt)}</div>
                    `;

                    notificationItem.addEventListener('click', async function() {
                        if (!notification.isRead) {
                            await markNotificationAsRead(notification.id);
                        }

                        // Navigate to relevant page if needed
                        if (notification.link) {
                            window.location.href = notification.link;
                        }
                    });

                    notificationList.appendChild(notificationItem);
                });
            }

            function showErrorState() {
                notificationList.innerHTML = `
                    <div class="notification-empty">
                        <i class="fas fa-wifi-slash fa-2x mb-2"></i>
                        <p>Unable to load notifications</p>
                        <button class="btn btn-sm btn-primary mt-2" onclick="loadNotifications()">Retry</button>
                    </div>
                `;
            }

            function showTempMessage(message, isError = false) {
                const tempDiv = document.createElement('div');
                tempDiv.className = `notification-item ${isError ? 'bg-danger text-white' : 'bg-success text-white'}`;
                tempDiv.innerHTML = `
                    <div class="notification-message">${message}</div>
                `;

                notificationList.prepend(tempDiv);

                setTimeout(() => {
                    tempDiv.remove();
                }, 3000);
            }

            function formatTime(dateString) {
                const date = new Date(dateString);
                const now = new Date();
                const diffInMinutes = Math.floor((now - date) / (1000 * 60));

                if (diffInMinutes < 1) return 'Just now';
                if (diffInMinutes < 60) return `${diffInMinutes}m ago`;
                if (diffInMinutes < 1440) return `${Math.floor(diffInMinutes / 60)}h ago`;
                return `${Math.floor(diffInMinutes / 1440)}d ago`;
            }

            function escapeHtml(unsafe) {
                return unsafe
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            // Initialize notification system
            updateUnreadCount(); // Load badge count on page load

            // Poll for new notifications every 30 seconds (even when dropdown is closed)
            setInterval(updateUnreadCount, 30000);
        });
    </script>

    <style>
        .crimson-500 {
            color: #DC143C;
        }

        .crimson-600 {
            color: #b01030;
        }

        .bg-crimson-500 {
            background-color: #DC143C;
        }

        .bg-crimson-600 {
            background-color: #b01030;
        }

        /* Custom gradient for text */
        .text-crimson-600 {
            color: #DC143C;
        }

        .hover\:text-crimson-700:hover {
            color: #b01030;
        }

        /* Ensure proper focus states */
        input:focus + span {
            top: 0 !important;
            font-size: 0.75rem !important;
            color: #10b981 !important;
            transform: translateY(-50%) !important;
        }

        /* Password toggle button styles */
        #togglePassword {
            background: none;
            border: none;
            cursor: pointer;
            padding: 0;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            #togglePassword:hover {
                color: #4b5563;
            }
    </style>
</body>
</html>