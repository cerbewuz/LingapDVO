@model FuneralAssistanceDto
@{
    Layout = "_AdminPendingLayout";
    ViewData["Title"] = "Application View";
}

<style>
    :root {
        --primary-color: #DC143C;
        --primary-light: #FFE6EA;
        --primary-dark: #B01030;
        --secondary-color: #2c3e50;
        --light-gray: #f8f9fa;
        --border-color: #dee2e6;
    }

    .receipt-container {
        max-width: 800px;
        margin: 2rem auto;
        background: white;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
        border-radius: 8px;
        overflow: hidden;
    }

    .receipt-header {
        background: var(--primary-color);
        color: white;
        padding: 1.5rem;
        text-align: center;
    }

    .receipt-body {
        padding: 2rem;
    }

    .receipt-section {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
    }

    .section-title {
        color: var(--primary-color);
        font-weight: 600;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--primary-light);
    }

    .info-row {
        display: flex;
        margin-bottom: 0.5rem;
    }

    .info-label {
        flex: 0 0 30%;
        font-weight: 500;
        color: var(--secondary-color);
    }

    .info-value {
        flex: 1;
        color: #555;
    }

    .status-badge {
        display: inline-block;
        padding: 0.35rem 0.75rem;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .status-pending {
        background-color: #fff3cd;
        color: #856404;
    }

    .status-approved {
        background-color: #d4edda;
        color: #155724;
    }

    .status-disapproved {
        background-color: #f8d7da;
        color: #721c24;
    }

    .status-processing {
        background-color: #cce5ff;
        color: #004085;
    }

    .status-claimed {
        background-color: #d1ecf1;
        color: #0c5460;
    }

    .btn-receipt {
        background-color: var(--primary-color);
        border-color: var(--primary-color);
        color: white;
        padding: 0.5rem 1.5rem;
        font-weight: 500;
        border-radius: 5px;
    }

        .btn-receipt:hover {
            background-color: var(--primary-dark);
            border-color: var(--primary-dark);
            color: white;
        }

    .btn-approved {
        background-color: #28a745;
        border-color: #28a745;
        color: white;
        padding: 0.75rem 2rem;
        font-weight: 600;
        border-radius: 5px;
        margin: 0 0.5rem;
    }

        .btn-approved:hover {
            background-color: #218838;
            border-color: #1e7e34;
            color: white;
        }

    .btn-disapproved {
        background-color: #dc3545;
        border-color: #dc3545;
        color: white;
        padding: 0.75rem 2rem;
        font-weight: 600;
        border-radius: 5px;
        margin: 0 0.5rem;
    }

        .btn-disapproved:hover {
            background-color: #c82333;
            border-color: #bd2130;
            color: white;
        }

    .zoom-modal {
        display: none;
        position: fixed;
        z-index: 1000;
        padding-top: 50px;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.9);
    }

    .zoom-modal-content {
        margin: auto;
        display: block;
        max-width: 90%;
        max-height: 90%;
    }

    .close-zoom {
        position: absolute;
        top: 15px;
        right: 35px;
        color: #fff;
        font-size: 40px;
        font-weight: bold;
        cursor: pointer;
    }

    .id-image-container {
        cursor: pointer;
        transition: transform 0.2s;
    }

        .id-image-container:hover {
            transform: scale(1.02);
        }

    .id-image {
        width: 100%;
        height: 200px;
        object-fit: contain;
        background-color: #f8f9fa;
        border: 1px solid var(--border-color);
        border-radius: 5px;
    }

    .pdf-container {
        cursor: pointer;
        transition: transform 0.2s;
    }

    .pdf-preview {
        display: flex;
        align-items: center;
        padding: 1rem;
        border: 2px dashed var(--border-color);
        border-radius: 8px;
        background-color: var(--light-gray);
        transition: all 0.3s ease;
    }

        .pdf-preview:hover {
            border-color: var(--primary-color);
            background-color: var(--primary-light);
            transform: translateY(-2px);
        }

    .pdf-icon {
        font-size: 3rem;
        color: #dc143c;
        margin-right: 1rem;
    }

    .pdf-info {
        display: flex;
        flex-direction: column;
    }

    .pdf-filename {
        font-weight: 600;
        color: var(--secondary-color);
        margin-bottom: 0.25rem;
    }

    .pdf-label {
        font-size: 0.9rem;
        color: #6c757d;
    }

    .pdf-viewer-modal {
        display: none;
        position: fixed;
        z-index: 2000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.95);
    }

    .pdf-viewer-content {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .pdf-viewer-header {
        background-color: #333;
        color: white;
        padding: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .pdf-viewer-title {
        font-size: 1.1rem;
        font-weight: 500;
    }

    .pdf-viewer-close {
        background: none;
        border: none;
        color: white;
        font-size: 2rem;
        cursor: pointer;
        padding: 0 0.5rem;
        line-height: 1;
    }

        .pdf-viewer-close:hover {
            color: var(--primary-color);
        }

    .pdf-viewer-body {
        flex: 1;
        background-color: #525659;
        position: relative;
        overflow: auto;
    }

    .pdf-container {
        display: flex;
        justify-content: center;
        padding: 20px;
        min-height: 100%;
    }

    #pdfCanvas {
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
        background-color: white;
    }

    .pdf-controls {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-left: auto;
        flex-wrap: wrap;
    }

    .page-info {
        color: white;
        font-size: 0.9rem;
        margin: 0 10px;
    }

    .zoom-level {
        color: white;
        font-size: 0.9rem;
        min-width: 40px;
        text-align: center;
    }

    .pdf-loading {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: white;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }

    .pdf-error {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        color: white;
        display: none;
    }

        .pdf-error i {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

    .btn-light {
        background-color: rgba(255, 255, 255, 0.9);
        border: none;
    }

        .btn-light:hover {
            background-color: white;
        }

        .btn-light:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .comments-required {
        border: 2px solid #dc3545 !important;
        background-color: #fff5f5;
    }

    .status-buttons {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-top: 1rem;
        flex-wrap: wrap;
    }

    .comments-modal {
        display: none;
        position: fixed;
        z-index: 3000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.5);
    }

    .comments-modal-content {
        background-color: white;
        margin: 10% auto;
        padding: 2rem;
        border-radius: 8px;
        width: 90%;
        max-width: 500px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .comments-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
    }

    .comments-modal-title {
        color: var(--primary-color);
        font-weight: 600;
        margin: 0;
    }

    .comments-modal-close {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: #6c757d;
    }

        .comments-modal-close:hover {
            color: var(--primary-color);
        }
</style>

<div class="receipt-container">
        <form asp-action="FuneralAssistancePendingStatus" method="post">
            <div class="receipt-header">
                <h3>Hospital Bill Application Details</h3>
            </div>

            <div class="receipt-body">
                <!-- Patient Information -->
                <div class="receipt-section">
                    <div class="info-row">
                        <div class="info-label">Application ID:</div>
                        <div class="info-value">@ViewData["Id"]</div>
                    </div>

                    <h5 class="section-header">Patient Information</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="info-row">
                                <div class="info-label">Name:</div>
                                <div class="info-value">
                                    @ViewData["Firstname"] @ViewData["Middlename"] @ViewData["Lastname"]
                                    @(ViewData["Suffix"]?.ToString() == "None" ? "" : " " + ViewData["Suffix"])
                                </div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">Address:</div>
                                <div class="info-value">@ViewData["BlkLotStreet"], @ViewData["SubVill"], @ViewData["Brgy"], @ViewData["District"]</div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">Sex:</div>
                                <div class="info-value">@ViewData["Sex"]</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-row">
                                <div class="info-label">Date of Birth:</div>
                                <div class="info-value">@ViewData["Dateofbirth"]</div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">Age:</div>
                                <div class="info-value">@ViewData["Age"]</div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">PhilHealth:</div>
                                <div class="info-value">@ViewData["PhilHealth"]</div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">PhilHealth No:</div>
                                <div class="info-value">@ViewData["PhilHealthNo"]</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Requestor Details -->
                <div class="receipt-section">
                    <h5 class="section-header">Requestor's Details</h5>
                    <div class="info-row">
                        <div class="info-label">Full Name:</div>
                        <div class="info-value">@ViewData["RLastname"], @ViewData["RFirstname"] @ViewData["RMiddlename"] @ViewData["RSuffix"]</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Address:</div>
                        <div class="info-value">@ViewData["RBlkLotStreet"], @ViewData["RSubVill"], @ViewData["RBrgy"], @ViewData["RDistrict"]</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Relationship to Patient:</div>
                        <div class="info-value">@ViewData["RelationshipPatient"]</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Contact No:</div>
                        <div class="info-value">@ViewData["ContactNo"]</div>
                    </div>
                </div>

                <!-- Assistance Requested -->
                <div class="receipt-section">
                    <h5 class="section-header">Assistance Requested</h5>
                    <div class="info-value">@ViewData["Typeassistance"]</div>
                </div>

                <!-- Valid ID and Submitted Documents Section -->
                <div class="receipt-section">
                    <h5 class="section-header">Valid ID and Submitted Documents</h5>
                    <div class="row">
                        <!-- Valid ID (Front and Back) -->
                        <div class="col-lg-6 mb-3">
                            <h6>Valid ID - Front</h6>
                            @if (ViewData["ValidfrontimageBase64"] != null)
                            {
                                <div class="id-image-container mb-3" onclick="zoomImage('data:image/jpeg;base64,@ViewData["ValidfrontimageBase64"]')">
                                    <img src="data:image/jpeg;base64,@ViewData["ValidfrontimageBase64"]" alt="Front ID" class="id-image" />
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No front ID image available</p>
                            }

                            <h6>Valid ID - Back</h6>
                            @if (ViewData["ValidBackimageBase64"] != null)
                            {
                                <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["ValidBackimageBase64"]')">
                                    <img src="data:image/jpeg;base64,@ViewData["ValidBackimageBase64"]" alt="Back ID" class="id-image" />
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No back ID image available</p>
                            }
                        </div>

                        <!-- PDF Documents (Death Certificate) -->
                        <div class="col-lg-6 mb-3">
                            @if (ViewData["DeathCertificateBase64"] != null)
                            {
                                <h6>Death Certificate</h6>
                                @if (ViewData["IsDeathCertificatePdf"] != null && (bool)ViewData["IsDeathCertificatePdf"])
                                {
                                    <div class="pdf-preview" onclick="viewPDFInModal('@ViewData["DeathCertificate"]', 'deathcertificate', 'Death Certificate')">
                                        <div class="pdf-icon"><i class="bi bi-file-earmark-pdf"></i></div>
                                        <div class="pdf-info">
                                            <span class="pdf-filename">@ViewData["DeathCertificate"]</span>
                                            <span class="pdf-label">Click to view PDF</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["DeathCertificateBase64"]')">
                                        <img src="data:image/jpeg;base64,@ViewData["DeathCertificateBase64"]" alt="Death Certificate" class="id-image" />
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <!-- Status Section -->
                <div class="receipt-section">
                    <h5 class="section-header">Request Status</h5>
                    <div class="info-row">
                        <div class="info-label">Current Status:</div>
                        <div class="info-value">
                            <span class="status-badge status-@(ViewData["Status"]?.ToString()?.ToLower())">
                                @ViewData["Status"]
                            </span>
                        </div>
                    </div>
                    <input type="hidden" name="status2" value="Processing" />
                </div>
            </div>

            <div class="receipt-footer">
                <button type="submit" class="btn btn-process">
                    <i class="bi bi-gear-fill"></i>Process Application
                </button>
                <button type="button" class="btn btn-receipt" onclick="window.print()">
                    <i class="bi bi-printer"></i> Print Receipt
                </button>
            </div>
        </form>
    </div>
