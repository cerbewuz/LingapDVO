@model HospitalAssistanceDto
@{
    Layout = "_ViewFormsLayout";
    ViewData["Title"] = "Hospital Assistance View";
    var selectedSex = ViewData["Sex"]?.ToString();
    var checkedAssistance = ViewData["CheckedAssistance"] as Dictionary<string, string> ?? new();
    var checkedCMO = ViewData["CheckedCMOPERSONNEL"] as Dictionary<string, string> ?? new Dictionary<string, string>();
}

<style>
    /* Remove borders since layout already has them */
    .receipt-container {
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
    }

    .receipt-header {
        border: none !important;
    }

    .receipt-body {
        padding: 1rem !important;
    }

    .zoom-modal {
        display: none;
        position: fixed;
        z-index: 1000;
        padding-top: 50px;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.9);
    }

    .zoom-modal-content {
        margin: auto;
        display: block;
        max-width: 90%;
        max-height: 90%;
    }

    .close-zoom {
        position: absolute;
        top: 15px;
        right: 35px;
        color: #fff;
        font-size: 40px;
        font-weight: bold;
        cursor: pointer;
    }

    .id-image-container {
        cursor: pointer;
        transition: transform 0.2s;
    }

        .id-image-container:hover {
            transform: scale(1.02);
        }

    .id-image {
        width: 100%;
        height: 200px;
        object-fit: contain;
        background-color: #f8f9fa;
        border: 1px solid var(--border-color);
        border-radius: 5px;
    }

    .pdf-container {
        cursor: pointer;
        transition: transform 0.2s;
    }

    .pdf-preview {
        display: flex;
        align-items: center;
        padding: 1rem;
        border: 2px dashed var(--border-color);
        border-radius: 8px;
        background-color: var(--light-gray);
        transition: all 0.3s ease;
    }

        .pdf-preview:hover {
            border-color: var(--primary-color);
            background-color: var(--primary-light);
            transform: translateY(-2px);
        }

    .pdf-icon {
        font-size: 3rem;
        color: #dc143c;
        margin-right: 1rem;
    }

    .pdf-info {
        display: flex;
        flex-direction: column;
    }

    .pdf-filename {
        font-weight: 600;
        color: var(--secondary-color);
        margin-bottom: 0.25rem;
    }

    .pdf-label {
        font-size: 0.9rem;
        color: #6c757d;
    }

    .pdf-viewer-modal {
        display: none;
        position: fixed;
        z-index: 2000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.95);
    }

    .pdf-viewer-content {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .pdf-viewer-header {
        background-color: #333;
        color: white;
        padding: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .pdf-viewer-title {
        font-size: 1.1rem;
        font-weight: 500;
    }

    .pdf-viewer-close {
        background: none;
        border: none;
        color: white;
        font-size: 2rem;
        cursor: pointer;
        padding: 0 0.5rem;
        line-height: 1;
    }

        .pdf-viewer-close:hover {
            color: var(--primary-color);
        }

    .pdf-viewer-body {
        flex: 1;
        background-color: #525659;
        position: relative;
        overflow: auto;
    }

    .pdf-container {
        display: flex;
        justify-content: center;
        padding: 20px;
        min-height: 100%;
    }

    #pdfCanvas {
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
        background-color: white;
    }

    .pdf-controls {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-left: auto;
        flex-wrap: wrap;
    }

    .page-info {
        color: white;
        font-size: 0.9rem;
        margin: 0 10px;
    }

    .zoom-level {
        color: white;
        font-size: 0.9rem;
        min-width: 40px;
        text-align: center;
    }

    .pdf-loading {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: white;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }

    .pdf-error {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        color: white;
        display: none;
    }

        .pdf-error i {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

    /* Status Buttons Styling */
    .status-buttons {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-top: 1rem;
        flex-wrap: wrap;
    }

    .btn-approved {
        background-color: #28a745;
        border-color: #28a745;
        color: white;
        padding: 0.75rem 2rem;
        font-weight: 600;
        border-radius: 5px;
        margin: 0 0.5rem;
        transition: all 0.3s ease;
    }

        .btn-approved:hover {
            background-color: #218838;
            border-color: #1e7e34;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }

    .btn-disapproved {
        background-color: #dc3545;
        border-color: #dc3545;
        color: white;
        padding: 0.75rem 2rem;
        font-weight: 600;
        border-radius: 5px;
        margin: 0 0.5rem;
        transition: all 0.3s ease;
    }

        .btn-disapproved:hover {
            background-color: #c82333;
            border-color: #bd2130;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }

    /* Claimed Button Styling - Same design as approve/disapprove */
    .btn-claimed {
        background-color: #17a2b8;
        border-color: #17a2b8;
        color: white;
        padding: 0.75rem 2rem;
        font-weight: 600;
        border-radius: 5px;
        margin: 0 0.5rem;
        transition: all 0.3s ease;
    }

        .btn-claimed:hover {
            background-color: #138496;
            border-color: #117a8b;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }

    /* Comments Modal Styling */
    .comments-modal {
        display: none;
        position: fixed;
        z-index: 3000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.5);
    }

    .comments-modal-content {
        background-color: white;
        margin: 10% auto;
        padding: 2rem;
        border-radius: 8px;
        width: 90%;
        max-width: 500px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .comments-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
    }

    .comments-modal-title {
        color: var(--primary-color);
        font-weight: 600;
        margin: 0;
    }

    .comments-modal-close {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: #6c757d;
    }

        .comments-modal-close:hover {
            color: var(--primary-color);
        }

    .comments-required {
        border: 2px solid #dc3545 !important;
        background-color: #fff5f5;
    }

    /* Form Validation */
    .invalid-feedback {
        display: none;
        width: 100%;
        margin-top: 0.25rem;
        font-size: 0.875em;
        color: #dc3545;
    }

    .is-invalid {
        border-color: #dc3545;
        padding-right: calc(1.5em + 0.75rem);
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath d='m5.8 3.6.4.4.4-.4'/%3e%3cpath d='M6 7v1'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(0.375em + 0.1875rem) center;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
    }

        .is-invalid ~ .invalid-feedback {
            display: block;
        }

    /* Status Badges */
    .status-badge {
        display: inline-block;
        padding: 0.35rem 0.75rem;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .status-pending {
        background-color: #fff3cd;
        color: #856404;
    }

    .status-approve {
        background-color: #d4edda;
        color: #155724;
    }

    .status-disapprove {
        background-color: #f8d7da;
        color: #721c24;
    }

    .status-processing {
        background-color: #cce5ff;
        color: #004085;
    }

    .status-claimed {
        background-color: #d1ecf1;
        color: #0c5460;
    }

    /* Receipt Sections */
    .receipt-section {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
    }

    .section-header {
        color: var(--primary-color);
        font-weight: 600;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--primary-light);
    }

    .info-row {
        display: flex;
        margin-bottom: 0.5rem;
    }

    .info-label {
        flex: 0 0 30%;
        font-weight: 500;
        color: var(--secondary-color);
    }

    .info-value {
        flex: 1;
        color: #555;
    }

    /* Success Modal */
    .success-modal {
        display: none;
        position: fixed;
        z-index: 4000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.7);
    }

    .success-modal-content {
        background-color: white;
        margin: 15% auto;
        padding: 2rem;
        border-radius: 10px;
        width: 90%;
        max-width: 400px;
        text-align: center;
        box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    }

    .success-icon {
        font-size: 3rem;
        color: #28a745;
        margin-bottom: 1rem;
    }
</style>

<!-- Image Zoom Modal -->
<div id="zoomModal" class="zoom-modal">
    <span class="close-zoom">&times;</span>
    <img class="zoom-modal-content" id="zoomedImage">
</div>

<!-- PDF Viewer Modal -->
<div id="pdfViewerModal" class="pdf-viewer-modal">
    <div class="pdf-viewer-content">
        <div class="pdf-viewer-header">
            <span class="pdf-viewer-title" id="pdfViewerTitle">PDF Document</span>
            <div class="pdf-controls">
                <button class="btn btn-sm btn-light" onclick="prevPage()" id="prevBtn">
                    <i class="bi bi-chevron-left"></i> Previous
                </button>
                <span class="page-info" id="pageInfo">Page: <span id="currentPage">1</span> / <span id="totalPages">1</span></span>
                <button class="btn btn-sm btn-light" onclick="nextPage()" id="nextBtn">
                    Next <i class="bi bi-chevron-right"></i>
                </button>
                <button class="btn btn-sm btn-light" onclick="zoomOut()">
                    <i class="bi bi-zoom-out"></i>
                </button>
                <span class="zoom-level" id="zoomLevel">100%</span>
                <button class="btn btn-sm btn-light" onclick="zoomIn()">
                    <i class="bi bi-zoom-in"></i>
                </button>
            </div>
            <button class="pdf-viewer-close" onclick="closePDFViewer()">&times;</button>
        </div>
        <div class="pdf-viewer-body">
            <div id="pdfLoading" class="pdf-loading">
                <div class="spinner-border text-light" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p>Loading PDF document...</p>
            </div>
            <div id="pdfError" class="pdf-error">
                <i class="bi bi-exclamation-triangle"></i>
                <p>Error loading PDF. Please try again.</p>
            </div>
            <div class="pdf-container">
                <canvas id="pdfCanvas"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Comments Modal -->
<div id="commentsModal" class="comments-modal">
    <div class="comments-modal-content">
        <div class="comments-modal-header">
            <h5 class="comments-modal-title">Comments Required</h5>
            <button class="comments-modal-close" onclick="closeCommentsModal()">&times;</button>
        </div>
        <div class="mb-3">
            <label for="commentsTextarea" class="form-label">Please provide comments for disapproval:</label>
            <textarea class="form-control" id="commentsTextarea" rows="4" placeholder="Enter comments explaining why the application is disapproved..." required></textarea>
            <div class="invalid-feedback">Comments are required when disapproving an application.</div>
        </div>
        <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-secondary" onclick="closeCommentsModal()">Cancel</button>
            <button type="button" class="btn btn-disapproved" onclick="submitDisapprove()">Submit Disapproval</button>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div id="successModal" class="success-modal">
    <div class="success-modal-content">
        <div class="success-icon">
            <i class="bi bi-check-circle-fill"></i>
        </div>
        <h4>Status Updated Successfully!</h4>
        <p>Application marked as <strong>Claimed</strong></p>
        <p>Redirecting to Admin page...</p>
        <div class="mt-3">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </div>
</div>

<div class="receipt-container">
    <form asp-action="HospitalAssistanceApproveStatus" asp-route-id="@ViewData["Id"]" method="post" id="statusForm">
        @Html.AntiForgeryToken()

        <!-- Hidden fields for form submission -->
        <input type="hidden" name="id" value="@ViewData["Id"]" />
        <input type="hidden" id="statusInput" name="status3" value="@ViewData["Status3"]">
        <input type="hidden" id="commentsInput" name="Comments" value="" />
        <input type="hidden" id="forCMOPersonnelInput" name="ForCMOPERSONNEL" value="@ViewData["ForCMOPERSONNEL"]" />
        <input type="hidden" id="processByInput" name="Processby" value="@Context.Session.GetString("AdminFullname")" />

        <div class="receipt-body">
            <!-- Patient Information -->
            <div class="receipt-section">
                <h5 class="section-header">Patient Information</h5>
                <div class="row">
                    <div class="col-md-6">
                        <div class="info-row">
                            <div class="info-label">Name:</div>
                            <div class="info-value">
                                @ViewData["Firstname"] @ViewData["Middlename"] @ViewData["Lastname"]
                                @(ViewData["Suffix"]?.ToString() == "None" ? "" : " " + ViewData["Suffix"])
                            </div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Address:</div>
                            <div class="info-value">@ViewData["BlkLotStreet"], @ViewData["SubVill"], @ViewData["Brgy"], @ViewData["District"]</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Sex:</div>
                            <div class="info-value">@ViewData["Sex"]</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-row">
                            <div class="info-label">Date of Birth:</div>
                            <div class="info-value">@ViewData["Dateofbirth"]</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Age:</div>
                            <div class="info-value">@ViewData["Age"]</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">PhilHealth:</div>
                            <div class="info-value">@ViewData["PhilHealth"]</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">PhilHealth No:</div>
                            <div class="info-value">@ViewData["PhilHealthNo"]</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Requestor Details -->
            <div class="receipt-section">
                <h5 class="section-header">Requestor's Details</h5>
                <div class="info-row">
                    <div class="info-label">Full Name:</div>
                    <div class="info-value">@ViewData["RLastname"], @ViewData["RFirstname"] @ViewData["RMiddlename"] @ViewData["RSuffix"]</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Address:</div>
                    <div class="info-value">@ViewData["RBlkLotStreet"], @ViewData["RSubVill"], @ViewData["RBrgy"], @ViewData["RDistrict"]</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Relationship to Patient:</div>
                    <div class="info-value">@ViewData["RelationshipPatient"]</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Contact No:</div>
                    <div class="info-value">@ViewData["ContactNo"]</div>
                </div>
            </div>

            <!-- Assistance Requested -->
            <div class="receipt-section">
                <h5 class="section-header">Assistance Requested</h5>
                <div class="info-value">@ViewData["Typeassistance"]</div>
            </div>

            <!-- CMO Section -->
            <div class="receipt-section">
                <h5 class="section-header">CMO Details</h5>
                <div class="mt-3">
                    <div class="row g-3 mt-2">
                        <div class="col-md-6">
                            <label class="form-label">Bill Amount:</label>
                            <input type="text" class="form-control" id="billAmountInput" name="BillAmount" value="@(checkedCMO.ContainsKey("Bill") ? checkedCMO["Bill"] : "")">
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label">Supporting Documents Attached:</label>
                        <div class="row g-3 mt-1">
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input supporting-doc" type="checkbox" id="barangayClearance" name="SupportingDocs" value="Barangay Clearance" @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Barangay Clearance") ? "checked" : "")>
                                    <label class="form-check-label" for="barangayClearance">Barangay Clearance</label>
                                </div>
                                <div class="form-check mt-2">
                                    <input class="form-check-input supporting-doc" type="checkbox" id="hospitalBill" name="SupportingDocs" value="Hospital Bill" @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Hospital Bill") ? "checked" : "")>
                                    <label class="form-check-label" for="hospitalBill">Hospital Bill</label>
                                </div>
                                <div class="form-check mt-2">
                                    <input class="form-check-input supporting-doc" type="checkbox" id="medicalCertificate" name="SupportingDocs" value="Medical Certificate" @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Medical Certificate") ? "checked" : "")>
                                    <label class="form-check-label" for="medicalCertificate">Medical Certificate</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input supporting-doc" type="checkbox" id="funeralBill" name="SupportingDocs" value="Funeral Bill" @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Funeral Bill") ? "checked" : "")>
                                    <label class="form-check-label" for="funeralBill">Funeral Bill</label>
                                </div>
                                <div class="form-check mt-2">
                                    <input class="form-check-input supporting-doc" type="checkbox" id="deathCertificate" name="SupportingDocs" value="Death Certificate" @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Death Certificate") ? "checked" : "")>
                                    <label class="form-check-label" for="deathCertificate">Death Certificate</label>
                                </div>
                                <div class="form-check mt-2">
                                    <input class="form-check-input supporting-doc" type="checkbox" id="laboratoryRequest" name="SupportingDocs" value="Laboratory Request" @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Laboratory Request") ? "checked" : "")>
                                    <label class="form-check-label" for="laboratoryRequest">Laboratory Request</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 mt-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Others:</label>
                                <input type="text" class="form-control" id="cmoNotesInput" name="CmoNotes" placeholder="Enter notes..." value="@(checkedCMO.ContainsKey("Others") ? checkedCMO["Others"] : "")">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating position-relative" style="height: 100px;">
                                <input type="text" class="form-control border rounded p-3 h-100 d-flex align-items-center justify-content-center text-center" id="processedBy" value="@(Context.Session.GetString("AdminFullname") ?? "Admin Name Not Found")" readonly style="font-size: 1.2rem;">
                                <label class="form-label text-center w-100 position-absolute bottom-0 start-0">Processed by:</label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">CMO Reflection info:</label>
                        <input type="text" class="form-control" id="cmoReflectionField" name="ForCMOPERSONNEL" placeholder="Auto-generated info..." value="@ViewData["ForCMOPERSONNEL"]">
                    </div>
                </div>
            </div>

            <!-- Valid ID and Submitted Documents Section -->
            <div class="receipt-section">
                <!-- Valid ID Section -->
                <div class="receipt-section">
                    <h5 class="section-header">Valid ID</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <h6>Front ID</h6>
                            @if (ViewData["ValidfrontimageBase64"] != null)
                            {
                                <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["ValidfrontimageBase64"]')">
                                    <img src="data:image/jpeg;base64,@ViewData["ValidfrontimageBase64"]" alt="Front ID" class="id-image" />
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No front ID image available</p>
                            }
                        </div>
                        <div class="col-md-6 mb-3">
                            <h6>Back ID</h6>
                            @if (ViewData["ValidBackimageBase64"] != null)
                            {
                                <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["ValidBackimageBase64"]')">
                                    <img src="data:image/jpeg;base64,@ViewData["ValidBackimageBase64"]" alt="Back ID" class="id-image" />
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No back ID image available</p>
                            }
                        </div>
                    </div>
                </div>

                <!-- Doctor Prescription -->
                @if (ViewData["DoctorPrescriptionBase64"] != null)
                {
                    <div class="receipt-section">
                        <h5 class="section-header">Doctor Prescription</h5>
                        @if (ViewData["IsDoctorPrescriptionPdf"] != null && (bool)ViewData["IsDoctorPrescriptionPdf"])
                        {
                            <div class="pdf-container">
                                <div class="pdf-preview" onclick="viewPDFInModal('@ViewData["DoctorPrescription"]', 'doctorprescription', 'Doctor Prescription')">
                                    <div class="pdf-icon"><i class="bi bi-file-earmark-pdf"></i></div>
                                    <div class="pdf-info">
                                        <span class="pdf-filename">@ViewData["DoctorPrescription"]</span>
                                        <span class="pdf-label">Click to view PDF</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["DoctorPrescriptionBase64"]')">
                                <img src="data:image/jpeg;base64,@ViewData["DoctorPrescriptionBase64"]" alt="Doctor Prescription" class="id-image" />
                            </div>
                        }
                    </div>
                }

                <!-- Medical Certificate -->
                @if (ViewData["MedicalCertificateBase64"] != null)
                {
                    <div class="receipt-section">
                        <h5 class="section-header">Medical Certificate</h5>
                        @if (ViewData["IsMedicalCertificatePdf"] != null && (bool)ViewData["IsMedicalCertificatePdf"])
                        {
                            <div class="pdf-container">
                                <div class="pdf-preview" onclick="viewPDFInModal('@ViewData["MedicalCertificate"]', 'medicalcertificate', 'Medical Certificate')">
                                    <div class="pdf-icon"><i class="bi bi-file-earmark-pdf"></i></div>
                                    <div class="pdf-info">
                                        <span class="pdf-filename">@ViewData["MedicalCertificate"]</span>
                                        <span class="pdf-label">Click to view PDF</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["MedicalCertificateBase64"]')">
                                <img src="data:image/jpeg;base64,@ViewData["MedicalCertificateBase64"]" alt="Medical Certificate" class="id-image" />
                            </div>
                        }
                    </div>
                }

                <!-- Death Certificate -->
                @if (ViewData["DeathCertificateBase64"] != null)
                {
                    <div class="receipt-section">
                        <h5 class="section-header">Death Certificate</h5>
                        @if (ViewData["IsDeathCertificatePdf"] != null && (bool)ViewData["IsDeathCertificatePdf"])
                        {
                            <div class="pdf-container">
                                <div class="pdf-preview" onclick="viewPDFInModal('@ViewData["DeathCertificate"]', 'deathcertificate', 'Death Certificate')">
                                    <div class="pdf-icon"><i class="bi bi-file-earmark-pdf"></i></div>
                                    <div class="pdf-info">
                                        <span class="pdf-filename">@ViewData["DeathCertificate"]</span>
                                        <span class="pdf-label">Click to view PDF</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["DeathCertificateBase64"]')">
                                <img src="data:image/jpeg;base64,@ViewData["DeathCertificateBase64"]" alt="Death Certificate" class="id-image" />
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Status Section -->
            <div class="receipt-section">
                <h5 class="section-header">Request Status</h5>
                <div class="info-row">
                    <div class="info-label">Current Status:</div>
                    <div class="info-value">
                        <span class="status-badge status-@(ViewData["Status2"]?.ToString()?.ToLower())">
                            @ViewData["Status2"]
                        </span>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="status-buttons">
                    <button type="button" class="btn btn-claimed" onclick="markAsClaimed()">
                        <i class="bi bi-check-circle"></i> Mark as Claimed
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        // Configure PDF.js worker
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

        // PDF Viewer Variables
        let currentPDF = null;
        let currentPage = 1;
        let totalPages = 1;
        let currentScale = 1.2;

        // Image Zoom Functionality
        function zoomImage(src) {
            const modal = document.getElementById("zoomModal");
            const modalImg = document.getElementById("zoomedImage");
            modal.style.display = "block";
            modalImg.src = src;
        }

        // Close zoom modal
        document.querySelector(".close-zoom").onclick = function() {
            document.getElementById("zoomModal").style.display = "none";
        }

        // PDF Viewer Function
        async function viewPDFInModal(fileName, fileType, displayName) {
            const modal = document.getElementById('pdfViewerModal');
            const title = document.getElementById('pdfViewerTitle');
            const loading = document.getElementById('pdfLoading');
            const errorDiv = document.getElementById('pdfError');
            const canvas = document.getElementById('pdfCanvas');
            const context = canvas.getContext('2d');
            const currentPageSpan = document.getElementById('currentPage');
            const totalPagesSpan = document.getElementById('totalPages');
            const zoomLevelSpan = document.getElementById('zoomLevel');
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');

            title.textContent = displayName || 'PDF Document';
            modal.style.display = 'block';
            loading.style.display = 'flex';
            errorDiv.style.display = 'none';
            canvas.style.display = 'none';

            currentPDF = null;
            currentPage = 1;
            currentScale = 1.2;

            try {
                const encodedFileName = encodeURIComponent(fileName);
                const url = '@Url.Action("ViewPDF", "Dashboard")?fileName=' + encodedFileName + '&fileType=' + fileType + '&t=' + Date.now();

                const response = await fetch(url);
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const pdfData = await response.arrayBuffer();
                if (!pdfData || pdfData.byteLength === 0) {
                    throw new Error('PDF data is empty');
                }

                const loadingTask = pdfjsLib.getDocument({ data: pdfData });
                currentPDF = await loadingTask.promise;

                totalPages = currentPDF.numPages;
                totalPagesSpan.textContent = totalPages;
                currentPageSpan.textContent = currentPage;

                updateNavigationButtons();
                await renderPage(currentPage);

                loading.style.display = 'none';
                canvas.style.display = 'block';
                zoomLevelSpan.textContent = Math.round(currentScale * 100) + '%';

            } catch (error) {
                console.error('Error loading PDF:', error);
                loading.style.display = 'none';
                errorDiv.style.display = 'block';
                errorDiv.querySelector('p').textContent = `Error loading PDF: ${error.message}`;
            }
        }

        // Render specific page
        async function renderPage(pageNum) {
            if (!currentPDF) return;

            const canvas = document.getElementById('pdfCanvas');
            const context = canvas.getContext('2d');
            const currentPageSpan = document.getElementById('currentPage');

            try {
                const page = await currentPDF.getPage(pageNum);
                const viewport = page.getViewport({ scale: currentScale });

                canvas.height = viewport.height;
                canvas.width = viewport.width;

                const renderContext = {
                    canvasContext: context,
                    viewport: viewport
                };

                await page.render(renderContext).promise;
                currentPageSpan.textContent = pageNum;

            } catch (error) {
                console.error('Error rendering page:', error);
            }
        }

        // Navigation functions
        function nextPage() {
            if (currentPage < totalPages) {
                currentPage++;
                renderPage(currentPage);
                updateNavigationButtons();
            }
        }

        function prevPage() {
            if (currentPage > 1) {
                currentPage--;
                renderPage(currentPage);
                updateNavigationButtons();
            }
        }

        function zoomIn() {
            currentScale += 0.2;
            renderPage(currentPage);
            document.getElementById('zoomLevel').textContent = Math.round(currentScale * 100) + '%';
        }

        function zoomOut() {
            if (currentScale > 0.5) {
                currentScale -= 0.2;
                renderPage(currentPage);
                document.getElementById('zoomLevel').textContent = Math.round(currentScale * 100) + '%';
            }
        }

        function updateNavigationButtons() {
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');

            prevBtn.disabled = currentPage <= 1;
            nextBtn.disabled = currentPage >= totalPages;
        }

        // Close PDF Viewer
        function closePDFViewer() {
            const modal = document.getElementById('pdfViewerModal');
            modal.style.display = 'none';

            if (currentPDF) {
                currentPDF.destroy();
                currentPDF = null;
            }
        }

        // Status Submission Functions
        function submitApprove() {
            console.log('Submitting approve...');

            // Set the status and comments
            document.getElementById('statusInput').value = 'Approve';
            document.getElementById('commentsInput').value = ''; // Empty comments for approval
            document.getElementById('forCMOPersonnelInput').value = document.getElementById('cmoReflectionField').value;
            document.getElementById('processByInput').value = document.getElementById('processedBy').value;

            // Show loading modal
            showSuccessModal();

            // Submit the form
            setTimeout(() => {
                console.log('Final form submission - Approve');
                console.log('Status:', document.getElementById('statusInput').value);
                console.log('Comments:', document.getElementById('commentsInput').value);
                console.log('CMO Reflection:', document.getElementById('forCMOPersonnelInput').value);

                document.getElementById('statusForm').submit();
            }, 500);
        }

        function showCommentsModal() {
            document.getElementById('commentsModal').style.display = 'block';
            document.getElementById('commentsTextarea').focus();
        }

        function closeCommentsModal() {
            document.getElementById('commentsModal').style.display = 'none';
            document.getElementById('commentsTextarea').value = '';
            document.getElementById('commentsTextarea').classList.remove('is-invalid');
        }

        function submitDisapprove() {
            const commentsTextarea = document.getElementById('commentsTextarea');
            const comments = commentsTextarea.value.trim();

            if (comments === '') {
                commentsTextarea.classList.add('is-invalid');
                commentsTextarea.focus();
                return;
            }

            console.log('Submitting disapprove...');

            document.getElementById('statusInput').value = 'Disapprove';
            document.getElementById('commentsInput').value = comments;
            document.getElementById('forCMOPersonnelInput').value = document.getElementById('cmoReflectionField').value;
            document.getElementById('processByInput').value = document.getElementById('processedBy').value;

            // Show loading modal
            showSuccessModal();

            // Submit the form
            setTimeout(() => {
                console.log('Final form submission - Disapprove');
                console.log('Status:', document.getElementById('statusInput').value);
                console.log('Comments:', document.getElementById('commentsInput').value);

                document.getElementById('statusForm').submit();
            }, 500);
        }

        // Mark as Claimed Function
        function markAsClaimed() {
            console.log('Marking as claimed...');

            // Set the status to "Claimed"
            document.getElementById('statusInput').value = 'Claimed';
            document.getElementById('commentsInput').value = 'Application marked as claimed by user';
            document.getElementById('forCMOPersonnelInput').value = document.getElementById('cmoReflectionField').value;
            document.getElementById('processByInput').value = document.getElementById('processedBy').value;

            // Show success modal
            showSuccessModal();

            // Submit the form after a short delay to show the modal
            setTimeout(() => {
                console.log('Final form submission - Claimed');
                console.log('Status:', document.getElementById('statusInput').value);
                console.log('Comments:', document.getElementById('commentsInput').value);
                console.log('CMO Reflection:', document.getElementById('forCMOPersonnelInput').value);

                document.getElementById('statusForm').submit();
            }, 2000); // Show modal for 2 seconds before redirecting
        }

        function showSuccessModal() {
            document.getElementById('successModal').style.display = 'block';
        }

        // CMO Reflection Auto-generation
        document.addEventListener('DOMContentLoaded', function() {
            const cmoCheckboxes = document.querySelectorAll('.supporting-doc');
            cmoCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    if (this.checked) {
                        cmoCheckboxes.forEach(cb => {
                            if (cb !== this) cb.checked = false;
                        });
                    }
                    updateReflection();
                });
            });

            function updateReflection() {
                const billInput = document.getElementById('billAmountInput');
                const cmoNotes = document.getElementById('cmoNotesInput');
                const reflectionField = document.getElementById('cmoReflectionField');
                const docCheckboxes = document.querySelectorAll('.supporting-doc');

                let parts = [];
                if (billInput.value.trim()) {
                    parts.push(`Bill: ${billInput.value.trim()}`);
                }
                const checkedDocs = [];
                docCheckboxes.forEach(cb => {
                    if (cb.checked) checkedDocs.push(cb.value);
                });
                if (checkedDocs.length) {
                    parts.push(`Docs: ${checkedDocs.join(', ')}`);
                }
                if (cmoNotes.value.trim()) {
                    parts.push(`Others: ${cmoNotes.value.trim()}`);
                }
                reflectionField.value = parts.join(' , ');

                // Update the hidden field as well
                document.getElementById('forCMOPersonnelInput').value = reflectionField.value;
            }

            const billInput = document.getElementById('billAmountInput');
            const cmoNotes = document.getElementById('cmoNotesInput');
            if (billInput) billInput.addEventListener('input', updateReflection);
            if (cmoNotes) cmoNotes.addEventListener('input', updateReflection);

            // Initialize reflection field
            updateReflection();
        });

        // Enhanced form submission debugging
        document.getElementById('statusForm').addEventListener('submit', function(e) {
            console.log('=== FORM SUBMISSION DEBUG INFO ===');
            console.log('Form action:', this.action);
            console.log('Form method:', this.method);
            console.log('Status:', document.getElementById('statusInput').value);
            console.log('Comments:', document.getElementById('commentsInput').value);
            console.log('CMO Reflection:', document.getElementById('forCMOPersonnelInput').value);
            console.log('Processed By:', document.getElementById('processByInput').value);
            console.log('==============================');
        });

        // Keyboard shortcuts and navigation
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.getElementById("zoomModal").style.display = "none";
                closePDFViewer();
                closeCommentsModal();
            }

            const pdfModal = document.getElementById('pdfViewerModal');
            if (pdfModal.style.display === 'block') {
                switch(e.key) {
                    case 'ArrowLeft':
                        e.preventDefault();
                        prevPage();
                        break;
                    case 'ArrowRight':
                        e.preventDefault();
                        nextPage();
                        break;
                    case '+':
                    case '=':
                        e.preventDefault();
                        zoomIn();
                        break;
                    case '-':
                        e.preventDefault();
                        zoomOut();
                        break;
                }
            }
        });

        // Close modal when clicking outside
        window.onclick = function(event) {
            const zoomModal = document.getElementById("zoomModal");
            const pdfModal = document.getElementById("pdfViewerModal");
            const commentsModal = document.getElementById("commentsModal");
            const successModal = document.getElementById("successModal");

            if (event.target == zoomModal) {
                zoomModal.style.display = "none";
            }
            if (event.target == pdfModal) {
                closePDFViewer();
            }
            if (event.target == commentsModal) {
                closeCommentsModal();
            }
            if (event.target == successModal) {
                successModal.style.display = "none";
            }
        }
    </script>
}