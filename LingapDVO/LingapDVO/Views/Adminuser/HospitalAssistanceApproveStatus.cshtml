@model HospitalAssistanceDto
@{
    Layout = "_AdminApprovedLayout";
    ViewData["Title"] = "Application View";
    var checkedCMO = ViewData["CheckedCMOPERSONNEL"] as Dictionary<string, string> ?? new Dictionary<string, string>();
}

    <div class="receipt-container">
        <form asp-action="HospitalAssistanceApproveStatus" enctype="multipart/form-data" method="post">
            <div class="receipt-header">
                <h3>Hospital Bill Application Details</h3>
            </div>

            <div class="receipt-body">

                <!-- Patient Information -->
                <div class="receipt-section">
                    <div class="info-row">
                        <div class="info-label">Application ID:@ViewData["Id"]</div>
                    </div>
                    <br />
                    <h5 class="section-title">Patient Information</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="info-row">
                                <div class="info-label">Name:</div>
                                <div class="info-value">
                                    @ViewData["Firstname"] @ViewData["Middlename"] @ViewData["Lastname"]
                                    @(ViewData["Suffix"]?.ToString() == "None" ? "" : " " + ViewData["Suffix"])
                                </div>
                            </div>

                            <div class="info-row">
                                <div class="info-label">Address:</div>
                                <div class="info-value">@ViewData["BlkLotStreet"], @ViewData["SubVill"], @ViewData["Brgy"], @ViewData["District"]</div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">Sex:</div>
                                <div class="info-value">@ViewData["Sex"]</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-row">
                                <div class="info-label">Date of Birth:</div>
                                <div class="info-value">@ViewData["Dateofbirth"]</div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">Age:</div>
                                <div class="info-value">@ViewData["Age"]</div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">PhilHealth:</div>
                                <div class="info-value">@ViewData["PhilHealth"]</div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">PhilHealth No:</div>
                                <div class="info-value">@ViewData["PhilHealthNo"]</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Requestor Details -->
                <div class="receipt-section">
                    <h5 class="section-title">Requestor's Details</h5>
                    <div class="info-row">
                        <div class="info-label">Full Name:</div>
                        <div class="info-value">@ViewData["RLastname"], @ViewData["RFirstname"] @ViewData["RMiddlename"] @ViewData["RSuffix"]</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Address:</div>
                        <div class="info-value">@ViewData["RBlkLotStreet"], @ViewData["RSubVill"], @ViewData["RBrgy"], @ViewData["RDistrict"]</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Relationship to Patient:</div>
                        <div class="info-value">@ViewData["RelationshipPatient"]</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Contact No:</div>
                        <div class="info-value">@ViewData["ContactNo"]</div>
                    </div>
                </div>

                <!-- Assistance Requested -->
                <div class="receipt-section">
                    <h5 class="section-title">Assistance Requested</h5>
                    <div class="info-value">@ViewData["Typeassistance"]</div>
                </div>

                <!-- CMO Section -->
                <div class="receipt-section">
                    <h5 class="section-title">CMO Details</h5>
                    <div class="mt-3">
                        <div class="row g-3 mt-2">
                            <div class="col-md-6">
                                <label class="form-label">Bill Amount:</label>
                                <input type="text" class="form-control" id="billAmountInput" name="BillAmount" value="@(checkedCMO.ContainsKey("Bill") ? checkedCMO["Bill"] : "")">
                            </div>
                        </div>
                        <div class="mt-3">
                            <label class="form-label">Supporting Documents Attached:</label>
                            <div class="row g-3 mt-1">
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input supporting-doc" type="checkbox" id="barangayClearance" name="SupportingDocs" value="Barangay Clearance" @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Barangay Clearance") ? "checked" : "")>
                                        <label class="form-check-label" for="barangayClearance">Barangay Clearance</label>
                                    </div>
                                    <div class="form-check mt-2">
                                        <input class="form-check-input supporting-doc" type="checkbox" id="hospitalBill" name="SupportingDocs" value="Hospital Bill" @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Hospital Bill") ? "checked" : "")>
                                        <label class="form-check-label" for="hospitalBill">Hospital Bill</label>
                                    </div>
                                    <div class="form-check mt-2">
                                        <input class="form-check-input supporting-doc" type="checkbox" id="medicalCertificate" name="SupportingDocs" value="Medical Certificate" @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Medical Certificate") ? "checked" : "")>
                                        <label class="form-check-label" for="medicalCertificate">Medical Certificate</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input supporting-doc" type="checkbox" id="funeralBill" name="SupportingDocs" value="Funeral Bill" @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Funeral Bill") ? "checked" : "")>
                                        <label class="form-check-label" for="funeralBill">Funeral Bill</label>
                                    </div>
                                    <div class="form-check mt-2">
                                        <input class="form-check-input supporting-doc" type="checkbox" id="deathCertificate" name="SupportingDocs" value="Death Certificate" @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Death Certificate") ? "checked" : "")>
                                        <label class="form-check-label" for="deathCertificate">Death Certificate</label>
                                    </div>
                                    <div class="form-check mt-2">
                                        <input class="form-check-input supporting-doc" type="checkbox" id="laboratoryRequest" name="SupportingDocs" value="Laboratory Request" @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Laboratory Request") ? "checked" : "")>
                                        <label class="form-check-label" for="laboratoryRequest">Laboratory Request</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row g-3 mt-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Others:</label>
                                    <input type="text" class="form-control" id="cmoNotesInput" placeholder="Enter notes..." value="@(checkedCMO.ContainsKey("Others") ? checkedCMO["Others"] : "")">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating position-relative" style="height: 100px;">
                                    <input asp-for="Processby" type="text" class="form-control border rounded p-3 h-100 d-flex align-items-center justify-content-center text-center" id="processedBy" value="@(Context.Session.GetString("AdminFullname") ?? "Admin Name Not Found")" readonly style="font-size: 1.2rem;">
                                    <span asp-validation-for="Processby" class="text-danger"></span>
                                    <label class="form-label text-center w-100 position-absolute bottom-0 start-0">Processed by:</label>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label asp-for="ForCMOPERSONNEL" class="form-label">CMO Reflection info:</label>
                            <input asp-for="ForCMOPERSONNEL" type="text" class="form-control" id="cmoReflectionField" name="ForCMOPERSONNEL" placeholder="Auto-generated info..." value="@ViewData["ForCMOPERSONNEL"]">
                            <span asp-validation-for="ForCMOPERSONNEL" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Comments Section -->
                <div class="receipt-section">
                    <label for="idFrontDescription" class="form-label">Description / Comments</label>
                    <textarea asp-for="Comments" class="form-control" id="idFrontDescription" rows="4" placeholder="Add any notes or comments about this application...">@ViewData["Comments"]</textarea>
                    <span asp-validation-for="Comments" class="text-danger"></span>
                </div>

                <!-- Valid ID and Submitted Documents Section -->
                <div class="receipt-section">
                    <h5 class="section-title">Valid ID and Submitted Documents</h5>
                    <div class="row">
                        <!-- Valid ID (Front and Back) -->
                        <div class="col-lg-6 mb-3">
                            <h6>Valid ID - Front</h6>
                            @if (ViewData["ValidfrontimageBase64"] != null)
                            {
                                <div class="id-image-container mb-3" onclick="zoomImage('data:image/jpeg;base64,@ViewData["ValidfrontimageBase64"]')">
                                    <img src="data:image/jpeg;base64,@ViewData["ValidfrontimageBase64"]" alt="Front ID" class="id-image" />
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No front ID image available</p>
                            }

                            <h6>Valid ID - Back</h6>
                            @if (ViewData["ValidBackimageBase64"] != null)
                            {
                                <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["ValidBackimageBase64"]')">
                                    <img src="data:image/jpeg;base64,@ViewData["ValidBackimageBase64"]" alt="Back ID" class="id-image" />
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No back ID image available</p>
                            }
                        </div>

                        <!-- PDF Documents (Doctor Prescription / Medical Certificate) -->
                        <div class="col-lg-6 mb-3">
                            @if (ViewData["DoctorPrescriptionBase64"] != null)
                            {
                                <h6>Doctor Prescription</h6>
                                @if (ViewData["IsDoctorPrescriptionPdf"] != null && (bool)ViewData["IsDoctorPrescriptionPdf"])
                                {
                                    <div class="pdf-preview mb-3" onclick="viewPDFInModal('@ViewData["DoctorPrescription"]', 'doctorprescription', 'Doctor Prescription')">
                                        <div class="pdf-icon"><i class="bi bi-file-earmark-pdf"></i></div>
                                        <div class="pdf-info">
                                            <span class="pdf-filename">@ViewData["DoctorPrescription"]</span>
                                            <span class="pdf-label">Click to view PDF</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="id-image-container mb-3" onclick="zoomImage('data:image/jpeg;base64,@ViewData["DoctorPrescriptionBase64"]')">
                                        <img src="data:image/jpeg;base64,@ViewData["DoctorPrescriptionBase64"]" alt="Doctor Prescription" class="id-image" />
                                    </div>
                                }
                            }

                            @if (ViewData["MedicalCertificateBase64"] != null)
                            {
                                <h6>Medical Certificate</h6>
                                @if (ViewData["IsMedicalCertificatePdf"] != null && (bool)ViewData["IsMedicalCertificatePdf"])
                                {
                                    <div class="pdf-preview" onclick="viewPDFInModal('@ViewData["MedicalCertificate"]', 'medicalcertificate', 'Medical Certificate')">
                                        <div class="pdf-icon"><i class="bi bi-file-earmark-pdf"></i></div>
                                        <div class="pdf-info">
                                            <span class="pdf-filename">@ViewData["MedicalCertificate"]</span>
                                            <span class="pdf-label">Click to view PDF</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["MedicalCertificateBase64"]')">
                                        <img src="data:image/jpeg;base64,@ViewData["MedicalCertificateBase64"]" alt="Medical Certificate" class="id-image" />
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <!-- Status Section -->
                <div class="receipt-section">
                    <h5 class="section-title">Request Status</h5>
                    <div class="info-row">
                        <div class="info-label">Current Status:</div>
                        <div class="info-value">
                            <span class="status-badge status-@(ViewData["Status2"]?.ToString()?.ToLower())">
                                @ViewData["Status2"]
                            </span>
                        </div>
                    </div>

                    <!-- Mark as Claimed Button -->
                    <div class="mt-3">
                        <button type="button" class="btn btn-mark-claimed" onclick="markAsClaimed()">
                            <i class="bi bi-check-circle me-2"></i>Mark as Claimed
                        </button>
                    </div>
                </div>
            </div>

            <div class="receipt-footer">
                <button type="button" class="btn btn-receipt" onclick="window.print()">Print Receipt</button>
                <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>
            </div>
        </form>
    </div>
@section Scripts {
    <script>
        // CMO Reflection Auto-generation
        document.addEventListener('DOMContentLoaded', function() {
            const cmoCheckboxes = document.querySelectorAll('.supporting-doc');
            cmoCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    if (this.checked) {
                        cmoCheckboxes.forEach(cb => {
                            if (cb !== this) cb.checked = false;
                        });
                    }
                    updateReflection();
                });
            });

            function updateReflection() {
                const billInput = document.getElementById('billAmountInput');
                const cmoNotes = document.getElementById('cmoNotesInput');
                const reflectionField = document.getElementById('cmoReflectionField');
                const docCheckboxes = document.querySelectorAll('.supporting-doc');

                let parts = [];
                if (billInput && billInput.value.trim()) {
                    parts.push(`Bill: ${billInput.value.trim()}`);
                }
                const checkedDocs = [];
                docCheckboxes.forEach(cb => {
                    if (cb.checked) checkedDocs.push(cb.value);
                });
                if (checkedDocs.length) {
                    parts.push(`Docs: ${checkedDocs.join(', ')}`);
                }
                if (cmoNotes && cmoNotes.value.trim()) {
                    parts.push(`Others: ${cmoNotes.value.trim()}`);
                }
                if (reflectionField) {
                    reflectionField.value = parts.join(' , ');
                }
            }

            const billInput = document.getElementById('billAmountInput');
            const cmoNotes = document.getElementById('cmoNotesInput');
            if (billInput) billInput.addEventListener('input', updateReflection);
            if (cmoNotes) cmoNotes.addEventListener('input', updateReflection);
            updateReflection();
        });
    </script>
}