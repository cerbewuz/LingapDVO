@model FillupformHospitalBillDto
@{
    Layout = null;
    var selectedSex = ViewData["Sex"]?.ToString();
    var checkedAssistance = ViewData["CheckedAssistance"] as Dictionary<string, string> ?? new();
    var checkedCMO = ViewData["CheckedCMOPERSONNEL"] as Dictionary<string, string> ?? new Dictionary<string, string>();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hospital Bill Application - Receipt View</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        :root {
            --primary-color: #DC143C;
            --primary-light: #FFE6EA;
            --primary-dark: #B01030;
            --secondary-color: #2c3e50;
            --light-gray: #f8f9fa;
            --border-color: #dee2e6;
        }

        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #333;
        }

        .receipt-container {
            max-width: 800px;
            margin: 2rem auto;
            background: white;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
            overflow: hidden;
        }

        .receipt-header {
            background: var(--primary-color);
            color: white;
            padding: 1.5rem;
            text-align: center;
        }

        .receipt-body {
            padding: 2rem;
        }

        .receipt-section {
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--border-color);
        }

        .section-title {
            color: var(--primary-color);
            font-weight: 600;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid var(--primary-light);
        }

        .info-row {
            display: flex;
            margin-bottom: 0.5rem;
        }

        .info-label {
            flex: 0 0 30%;
            font-weight: 500;
            color: var(--secondary-color);
        }

        .info-value {
            flex: 1;
            color: #555;
        }

        .status-badge {
            display: inline-block;
            padding: 0.35rem 0.75rem;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.85rem;
        }

        .status-pending {
            background-color: #fff3cd;
            color: #856404;
        }

        .status-approved {
            background-color: #d4edda;
            color: #155724;
        }

        .status-unapproved {
            background-color: #f8d7da;
            color: #721c24;
        }

        .status-processing {
            background-color: #cce5ff;
            color: #004085;
        }

        .status-claimed {
            background-color: #d1ecf1;
            color: #0c5460;
        }

        .edit-toggle {
            cursor: pointer;
            color: var(--primary-color);
            font-size: 1.1rem;
            margin-left: 0.5rem;
        }

        .edit-mode .info-value {
            padding: 0.25rem;
            border: 1px dashed #ccc;
            border-radius: 4px;
        }

        .receipt-footer {
            background: var(--light-gray);
            padding: 1.5rem;
            text-align: center;
            border-top: 1px solid var(--border-color);
        }

        .btn-receipt {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            color: white;
            padding: 0.5rem 1.5rem;
            font-weight: 500;
            border-radius: 5px;
        }

            .btn-receipt:hover {
                background-color: var(--primary-dark);
                border-color: var(--primary-dark);
                color: white;
            }

        .alert-danger {
            background-color: #f8d7da;
            border-color: #f5c6cb;
            color: #721c24;
            padding: 0.75rem 1.25rem;
            margin-bottom: 1rem;
            border: 1px solid transparent;
            border-radius: 0.25rem;
        }

        .alert-info {
            background-color: #d1ecf1;
            border-color: #bee5eb;
            color: #0c5460;
            padding: 0.75rem 1.25rem;
            margin-bottom: 1rem;
            border: 1px solid transparent;
            border-radius: 0.25rem;
        }

        .zoom-modal {
            display: none;
            position: fixed;
            z-index: 1000;
            padding-top: 50px;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.9);
        }

        .zoom-modal-content {
            margin: auto;
            display: block;
            max-width: 90%;
            max-height: 90%;
        }

        .close-zoom {
            position: absolute;
            top: 15px;
            right: 35px;
            color: #fff;
            font-size: 40px;
            font-weight: bold;
            cursor: pointer;
        }

        .id-image-container {
            cursor: pointer;
            transition: transform 0.2s;
        }

            .id-image-container:hover {
                transform: scale(1.02);
            }

        .id-image {
            width: 100%;
            height: 200px;
            object-fit: contain;
            background-color: #f8f9fa;
            border: 1px solid var(--border-color);
            border-radius: 5px;
        }

        .pdf-container {
            cursor: pointer;
            transition: transform 0.2s;
        }

        .pdf-preview {
            display: flex;
            align-items: center;
            padding: 1rem;
            border: 2px dashed var(--border-color);
            border-radius: 8px;
            background-color: var(--light-gray);
            transition: all 0.3s ease;
        }

            .pdf-preview:hover {
                border-color: var(--primary-color);
                background-color: var(--primary-light);
                transform: translateY(-2px);
            }

        .pdf-icon {
            font-size: 3rem;
            color: #dc143c;
            margin-right: 1rem;
        }

        .pdf-info {
            display: flex;
            flex-direction: column;
        }

        .pdf-filename {
            font-weight: 600;
            color: var(--secondary-color);
            margin-bottom: 0.25rem;
        }

        .pdf-label {
            font-size: 0.9rem;
            color: #6c757d;
        }
    </style>
</head>
<body>
    <div id="zoomModal" class="zoom-modal">
        <span class="close-zoom">&times;</span>
        <img class="zoom-modal-content" id="zoomedImage">
    </div>

    <div class="receipt-container">
        <form asp-action="FillupformHospitalBillUpdateprocessingstatus" enctype="multipart/form-data" method="post">
            <div class="receipt-header">
                <h3>Hospital Bill Application Details</h3>
                <p class="mb-0">Application ID: <strong>@ViewData["Id"]</strong></p>
            </div>

            <div class="receipt-body">
                @if (ViewData["DecryptionError"] != null)
                {
                    <div class="alert alert-danger">
                        @ViewData["DecryptionError"]
                    </div>
                }

                <!-- DEBUG SECTION - Remove this after testing -->
                @if (ViewData["DebugMessages"] != null)
                {
                    <div class="alert alert-info">
                        <strong>🔍 Debug Information:</strong>
                        <ul style="margin-bottom: 0; margin-top: 10px;">
                            @foreach (var message in (List<string>)ViewData["DebugMessages"])
                            {
                                <li>@message</li>
                            }
                        </ul>
                    </div>
                }

                <!-- Status Section -->
                <div class="receipt-section">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="section-title mb-0">Request Status</h5>
                        <span class="edit-toggle" onclick="toggleEditMode()"><i class="bi bi-pencil-square"></i></span>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Current Status:</div>
                        <div class="info-value">
                            <span class="status-badge status-@(ViewData["Status"]?.ToString()?.ToLower())">
                                @ViewData["Status"]
                            </span>
                        </div>
                    </div>
                    <div class="edit-field mt-2" style="display: none;">
                        <label class="form-label">Update Status:</label>
                        <select class="form-select" id="statusDropdown" name="status2" value="@ViewData["Status"]">
                            <option value="Processing" selected="@(ViewData["Status"]?.ToString() == "Processing")">Processing</option>
                            <option value="Approved" selected="@(ViewData["Status"]?.ToString() == "Approved")">Approved</option>
                            <option value="Unapproved" selected="@(ViewData["Status"]?.ToString() == "Unapproved")">Unapproved</option>
                        </select>
                    </div>
                </div>

                <!-- Patient Information -->
                <div class="receipt-section">
                    <h5 class="section-title">Patient Information</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="info-row">
                                <div class="info-label">Name:</div>
                                <div class="info-value">@ViewData["Firstname"] @ViewData["Middlename"] @ViewData["Lastname"] @ViewData["Suffix"]</div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">Address:</div>
                                <div class="info-value">@ViewData["BlkLotStreet"], @ViewData["SubVill"], @ViewData["Brgy"], @ViewData["District"]</div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">Sex:</div>
                                <div class="info-value">@ViewData["Sex"]</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-row">
                                <div class="info-label">Date of Birth:</div>
                                <div class="info-value">@ViewData["Dateofbirth"]</div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">Age:</div>
                                <div class="info-value">@ViewData["Age"]</div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">PhilHealth:</div>
                                <div class="info-value">@ViewData["PhilHealth"]</div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">PhilHealth No:</div>
                                <div class="info-value">@ViewData["PhilHealthNo"]</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Valid ID Section -->
                <div class="receipt-section">
                    <h5 class="section-title">Valid ID</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <h6>Front ID</h6>
                            @if (ViewData["ValidfrontimageBase64"] != null)
                            {
                                <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["ValidfrontimageBase64"]')">
                                    <img src="data:image/jpeg;base64,@ViewData["ValidfrontimageBase64"]" alt="Front ID" class="id-image" />
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No front ID image available</p>
                            }
                        </div>
                        <div class="col-md-6 mb-3">
                            <h6>Back ID</h6>
                            @if (ViewData["ValidBackimageBase64"] != null)
                            {
                                <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["ValidBackimageBase64"]')">
                                    <img src="data:image/jpeg;base64,@ViewData["ValidBackimageBase64"]" alt="Back ID" class="id-image" />
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No back ID image available</p>
                            }
                        </div>
                    </div>
                </div>

                <!-- Doctor Prescription -->
                @if (ViewData["DoctorPrescriptionBase64"] != null)
                {
                    <div class="receipt-section">
                        <h5 class="section-title">Doctor Prescription</h5>
                        @if (ViewData["IsDoctorPrescriptionPdf"] != null && (bool)ViewData["IsDoctorPrescriptionPdf"])
                        {
                            <div class="pdf-container">
                                <div class="pdf-preview" onclick="viewPDF('@ViewData["DoctorPrescription"]', 'doctorprescription')">
                                    <div class="pdf-icon"><i class="bi bi-file-earmark-pdf"></i></div>
                                    <div class="pdf-info">
                                        <span class="pdf-filename">@ViewData["DoctorPrescription"]</span>
                                        <span class="pdf-label">Click to view PDF in new tab</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["DoctorPrescriptionBase64"]')">
                                <img src="data:image/jpeg;base64,@ViewData["DoctorPrescriptionBase64"]" alt="Doctor Prescription" class="id-image" />
                            </div>
                        }
                    </div>
                }

                <!-- Death Certificate - Single Section -->
                @if (ViewData["DeathCertificateBase64"] != null)
                {
                    <div class="receipt-section">
                        <h5 class="section-title">Death Certificate</h5>
                        @if (ViewData["IsDeathCertificatePdf"] != null && (bool)ViewData["IsDeathCertificatePdf"])
                        {
                            <div class="pdf-container">
                                <div class="pdf-preview" onclick="viewPDF('@ViewData["DeathCertificate"]', 'deathcertificate')">
                                    <div class="pdf-icon"><i class="bi bi-file-earmark-pdf"></i></div>
                                    <div class="pdf-info">
                                        <span class="pdf-filename">@ViewData["DeathCertificate"]</span>
                                        <span class="pdf-label">Click to view PDF in new tab</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["DeathCertificateBase64"]')">
                                <img src="data:image/jpeg;base64,@ViewData["DeathCertificateBase64"]" alt="Death Certificate" class="id-image" />
                            </div>
                        }
                    </div>
                }

                <!-- Requestor Details -->
                <div class="receipt-section">
                    <h5 class="section-title">Requestor's Details</h5>
                    <div class="info-row">
                        <div class="info-label">Full Name:</div>
                        <div class="info-value">@ViewData["RLastname"], @ViewData["RFirstname"] @ViewData["RMiddlename"] @ViewData["RSuffix"]</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Address:</div>
                        <div class="info-value">@ViewData["RBlkLotStreet"], @ViewData["RSubVill"], @ViewData["RBrgy"], @ViewData["RDistrict"]</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Relationship to Patient:</div>
                        <div class="info-value">@ViewData["RelationshipPatient"]</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Contact No:</div>
                        <div class="info-value">@ViewData["ContactNo"]</div>
                    </div>
                </div>

                <!-- Assistance Requested -->
                <div class="receipt-section">
                    <h5 class="section-title">Assistance Requested</h5>
                    <div class="info-value">@ViewData["Typeassistance"]</div>
                </div>

                <!-- CMO Section -->
                <div class="receipt-section">
                    <h5 class="section-title">CMO Details</h5>
                    <div class="info-row">
                        <div class="info-label">Processed By:</div>
                        <div class="info-value">@(Context.Session.GetString("AdminFullname") ?? "Admin")</div>
                    </div>
                    <div class="mt-3">
                        <h6 class="section-title">FOR CMO PERSONNEL USE ONLY</h6>
                        <div class="row g-3 mt-2">
                            <div class="col-md-6">
                                <label class="form-label">Bill Amount:</label>
                                <input type="text" class="form-control" id="billAmountInput" name="BillAmount" value="@(checkedCMO.ContainsKey("Bill") ? checkedCMO["Bill"] : "")">
                            </div>
                        </div>
                        <div class="mt-3">
                            <label class="form-label">Supporting Documents Attached:</label>
                            <div class="row g-3 mt-1">
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input supporting-doc" type="checkbox" id="barangayClearance" name="SupportingDocs" value="Barangay Clearance" @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Barangay Clearance") ? "checked" : "")>
                                        <label class="form-check-label" for="barangayClearance">Barangay Clearance</label>
                                    </div>
                                    <div class="form-check mt-2">
                                        <input class="form-check-input supporting-doc" type="checkbox" id="hospitalBill" name="SupportingDocs" value="Hospital Bill" @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Hospital Bill") ? "checked" : "")>
                                        <label class="form-check-label" for="hospitalBill">Hospital Bill</label>
                                    </div>
                                    <div class="form-check mt-2">
                                        <input class="form-check-input supporting-doc" type="checkbox" id="medicalCertificate" name="SupportingDocs" value="Medical Certificate" @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Medical Certificate") ? "checked" : "")>
                                        <label class="form-check-label" for="medicalCertificate">Medical Certificate</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input supporting-doc" type="checkbox" id="funeralBill" name="SupportingDocs" value="Funeral Bill" @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Funeral Bill") ? "checked" : "")>
                                        <label class="form-check-label" for="funeralBill">Funeral Bill</label>
                                    </div>
                                    <div class="form-check mt-2">
                                        <input class="form-check-input supporting-doc" type="checkbox" id="deathCertificate" name="SupportingDocs" value="Death Certificate" @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Death Certificate") ? "checked" : "")>
                                        <label class="form-check-label" for="deathCertificate">Death Certificate</label>
                                    </div>
                                    <div class="form-check mt-2">
                                        <input class="form-check-input supporting-doc" type="checkbox" id="laboratoryRequest" name="SupportingDocs" value="Laboratory Request" @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Laboratory Request") ? "checked" : "")>
                                        <label class="form-check-label" for="laboratoryRequest">Laboratory Request</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row g-3 mt-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Others:</label>
                                    <input type="text" class="form-control" id="cmoNotesInput" placeholder="Enter notes..." value="@(checkedCMO.ContainsKey("Others") ? checkedCMO["Others"] : "")">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating position-relative" style="height: 100px;">
                                    <input asp-for="Processby" type="text" class="form-control border rounded p-3 h-100 d-flex align-items-center justify-content-center text-center" id="processedBy" value="@(Context.Session.GetString("AdminFullname") ?? "Admin Name Not Found")" readonly style="font-size: 1.2rem;">
                                    <span asp-validation-for="Processby" class="text-danger"></span>
                                    <label class="form-label text-center w-100 position-absolute bottom-0 start-0">Processed by:</label>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label asp-for="ForCMOPERSONNEL" class="form-label">CMO Reflection info:</label>
                            <input asp-for="ForCMOPERSONNEL" type="text" class="form-control" id="cmoReflectionField" name="ForCMOPERSONNEL" placeholder="Auto-generated info..." value="@ViewData["ForCMOPERSONNEL"]">
                            <span asp-validation-for="ForCMOPERSONNEL" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Comments Section -->
                <div class="receipt-section">
                    <label for="idFrontDescription" class="form-label">Description / Comments</label>
                    <textarea asp-for="Comments" class="form-control" id="idFrontDescription" rows="4" placeholder="Add any notes or comments about this application...">@ViewData["Comments"]</textarea>
                    <span asp-validation-for="Comments" class="text-danger"></span>
                </div>
            </div>

            <div class="receipt-footer">
                <div class="edit-field mb-3" style="display: none;">
                    <button type="submit" class="btn btn-receipt">Save Changes</button>
                    <button type="button" class="btn btn-secondary" onclick="toggleEditMode()">Cancel</button>
                </div>
                <div class="view-mode">
                    <button type="button" class="btn btn-receipt" onclick="window.print()">Print Receipt</button>
                    <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>
                </div>
            </div>
        </form>
    </div>

    <script>
        // Image Zoom Functionality
        function zoomImage(src) {
            const modal = document.getElementById("zoomModal");
            const modalImg = document.getElementById("zoomedImage");
            modal.style.display = "block";
            modalImg.src = src;
        }

        // Close zoom modal
        document.querySelector(".close-zoom").onclick = function() {
            document.getElementById("zoomModal").style.display = "none";
        }

        // PDF Viewing Function
        function viewPDF(fileName, fileType) {
            // Properly encode the filename for URL
            const encodedFileName = encodeURIComponent(fileName);
            const url = '@Url.Action("ViewPDF", "Adminuser")?fileName=' + encodedFileName + '&fileType=' + fileType;
            console.log('Opening PDF URL:', url); // For debugging
            window.open(url, '_blank');
        }

        // Close modal when clicking outside
        window.onclick = function(event) {
            const modal = document.getElementById("zoomModal");
            if (event.target == modal) modal.style.display = "none";
        }

        // Edit Mode Toggle
        function toggleEditMode() {
            const receiptBody = document.querySelector('.receipt-body');
            const editFields = document.querySelectorAll('.edit-field');
            const viewMode = document.querySelector('.view-mode');
            if (receiptBody.classList.contains('edit-mode')) {
                receiptBody.classList.remove('edit-mode');
                editFields.forEach(field => field.style.display = 'none');
                viewMode.style.display = 'block';
            } else {
                receiptBody.classList.add('edit-mode');
                editFields.forEach(field => field.style.display = 'block');
                viewMode.style.display = 'none';
            }
        }

        // CMO Reflection Auto-generation
        document.addEventListener('DOMContentLoaded', function() {
            const cmoCheckboxes = document.querySelectorAll('.supporting-doc');
            cmoCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    if (this.checked) {
                        cmoCheckboxes.forEach(cb => {
                            if (cb !== this) cb.checked = false;
                        });
                    }
                    updateReflection();
                });
            });

            function updateReflection() {
                const billInput = document.getElementById('billAmountInput');
                const cmoNotes = document.getElementById('cmoNotesInput');
                const reflectionField = document.getElementById('cmoReflectionField');
                const docCheckboxes = document.querySelectorAll('.supporting-doc');

                let parts = [];
                if (billInput.value.trim()) {
                    parts.push(`Bill: ${billInput.value.trim()}`);
                }
                const checkedDocs = [];
                docCheckboxes.forEach(cb => {
                    if (cb.checked) checkedDocs.push(cb.value);
                });
                if (checkedDocs.length) {
                    parts.push(`Docs: ${checkedDocs.join(', ')}`);
                }
                if (cmoNotes.value.trim()) {
                    parts.push(`Others: ${cmoNotes.value.trim()}`);
                }
                reflectionField.value = parts.join(' , ');
            }

            const billInput = document.getElementById('billAmountInput');
            const cmoNotes = document.getElementById('cmoNotesInput');
            if (billInput) billInput.addEventListener('input', updateReflection);
            if (cmoNotes) cmoNotes.addEventListener('input', updateReflection);
            updateReflection();
        });
    </script>
</body>
</html>