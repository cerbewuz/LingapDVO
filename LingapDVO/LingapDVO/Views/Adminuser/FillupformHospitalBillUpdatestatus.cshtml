@model FillupformHospitalBillDto
@{
    Layout = null;
    var selectedSex = ViewData["Sex"]?.ToString();
    var checkedAssistance = ViewData["CheckedAssistance"] as Dictionary<string, string> ?? new();
    var checkedCMO = ViewData["CheckedCMOPERSONNEL"] as Dictionary<string, string> ?? new Dictionary<string, string>();

}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Request Assistance - Receipt View</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        :root {
            --primary-color: #DC143C;
            --primary-light: #FFE6EA;
            --primary-dark: #B01030;
            --secondary-color: #2c3e50;
            --light-gray: #f8f9fa;
            --border-color: #dee2e6;
        }
        
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #333;
        }
        
        .receipt-container {
            max-width: 800px;
            margin: 2rem auto;
            background: white;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
            overflow: hidden;
        }
        
        .receipt-header {
            background: var(--primary-color);
            color: white;
            padding: 1.5rem;
            text-align: center;
        }
        
        .receipt-body {
            padding: 2rem;
        }
        
        .receipt-section {
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--border-color);
        }
        
        .section-title {
            color: var(--primary-color);
            font-weight: 600;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid var(--primary-light);
        }
        
        .info-row {
            display: flex;
            margin-bottom: 0.5rem;
        }
        
        .info-label {
            flex: 0 0 30%;
            font-weight: 500;
            color: var(--secondary-color);
        }
        
        .info-value {
            flex: 1;
            color: #555;
        }
        
        .status-badge {
            display: inline-block;
            padding: 0.35rem 0.75rem;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.85rem;
        }
        
        .status-pending {
            background-color: #fff3cd;
            color: #856404;
        }
        
        .status-approved {
            background-color: #d4edda;
            color: #155724;
        }
        
        .status-unapproved {
            background-color: #f8d7da;
            color: #721c24;
        }
        
        .status-processing {
            background-color: #cce5ff;
            color: #004085;
        }
        
        .status-claimed {
            background-color: #d1ecf1;
            color: #0c5460;
        }
        
        .edit-toggle {
            cursor: pointer;
            color: var(--primary-color);
            font-size: 1.1rem;
            margin-left: 0.5rem;
        }
        
        .edit-mode .info-value {
            padding: 0.25rem;
            border: 1px dashed #ccc;
            border-radius: 4px;
        }
        
        .receipt-footer {
            background: var(--light-gray);
            padding: 1.5rem;
            text-align: center;
            border-top: 1px solid var(--border-color);
        }
        
        .btn-receipt {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            color: white;
            padding: 0.5rem 1.5rem;
            font-weight: 500;
            border-radius: 5px;
        }
        
        .btn-receipt:hover {
            background-color: var(--primary-dark);
            border-color: var(--primary-dark);
            color: white;
        }
        
        .document-previews {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            margin-top: 1rem;
        }
        
        .document-preview {
            width: 150px;
            border: 1px solid var(--border-color);
            border-radius: 5px;
            overflow: hidden;
            cursor: pointer;
        }
        
        .document-preview img {
            width: 100%;
            height: 100px;
            object-fit: cover;
        }
        
        .document-name {
            padding: 0.5rem;
            text-align: center;
            font-size: 0.8rem;
            background: var(--light-gray);
        }
        
        .crm-notes {
            background-color: #f8f9fa;
            border-left: 4px solid var(--primary-color);
            padding: 1rem;
            margin-top: 1rem;
            font-style: italic;
        }
    </style>
</head>
<body>
    <div class="receipt-container">
        <form asp-action="FillupformHospitalBillUpdatestatus" enctype="multipart/form-data" method="post">
        <div class="receipt-header">
            <h3>Request Assistance Receipt</h3>
            <p class="mb-0">RAF No: <strong>@ViewData["Id"]</strong></p>
        </div>
        
        <div class="receipt-body">
            <!-- Status Section -->
            <div class="receipt-section">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="section-title mb-0">Request Status</h5>
                    <span class="edit-toggle" onclick="toggleEditMode()"><i class="bi bi-pencil-square"></i></span>
                </div>
                <div class="info-row">
                    <div class="info-label">Current Status:</div>
                    <div class="info-value">
                        <span class="status-badge status-@(ViewData["Status"]?.ToString()?.ToLower())">
                            @ViewData["Status"]
                        </span>
                    </div>
                </div>
                <div class="edit-field mt-2" style="display: none;">
                    <label class="form-label">Update Status:</label>
                    <select class="form-select" id="statusDropdown" name="status" value="@ViewData["Status"]">
                        <option value="Pending" selected="@(ViewData["Status"]?.ToString() == "Pending")">Pending</option>
                        <option value="Approved" selected="@(ViewData["Status"]?.ToString() == "Approved")">Approved</option>
                        <option value="Unapproved" selected="@(ViewData["Status"]?.ToString() == "Unapproved")">Unapproved</option>
                        <option value="Processing" selected="@(ViewData["Status"]?.ToString() == "Processing")">Processing</option>
                        <option value="Claimed" selected="@(ViewData["Status"]?.ToString() == "Claimed")">Claimed</option>
                    </select>
                </div>
            </div>
            
            <!-- Patient Details -->
            <div class="receipt-section">
                <h5 class="section-title">Patient's Details</h5>
                <div class="info-row">
                    <div class="info-label">Full Name:</div>
                    <div class="info-value">@ViewData["Lastname"], @ViewData["Firstname"] @ViewData["Middlename"] @ViewData["Suffix"]</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Address:</div>
                    <div class="info-value">@ViewData["BlkLotStreet"], @ViewData["SubVill"], @ViewData["Brgy"], @ViewData["District"]</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Sex:</div>
                    <div class="info-value">@ViewData["Sex"]</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Date of Birth:</div>
                    <div class="info-value">@ViewData["Dateofbirth"] (Age: @ViewData["Age"])</div>
                </div>
                <div class="info-row">
                    <div class="info-label">PhilHealth:</div>
                    <div class="info-value">@ViewData["PhilHealth"] @(ViewData["PhilHealthNo"] != null ? $"({ViewData["PhilHealthNo"]})" : "")</div>
                </div>
            </div>
            
            <!-- Requestor Details -->
            <div class="receipt-section">
                <h5 class="section-title">Requestor's Details</h5>
                <div class="info-row">
                    <div class="info-label">Full Name:</div>
                    <div class="info-value">@ViewData["RLastname"], @ViewData["RFirstname"] @ViewData["RMiddlename"] @ViewData["RSuffix"]</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Address:</div>
                    <div class="info-value">@ViewData["RBlkLotStreet"], @ViewData["RSubVill"], @ViewData["RBrgy"], @ViewData["RDistrict"]</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Relationship to Patient:</div>
                    <div class="info-value">@ViewData["RelationshipPatient"]</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Contact No:</div>
                    <div class="info-value">@ViewData["ContactNo"]</div>
                </div>
            </div>
            
            <!-- Assistance Requested -->
            <div class="receipt-section">
                <h5 class="section-title">Assistance Requested</h5>
                <div class="info-value">@ViewData["Typeassistance"]</div>
            </div>
            
            <!-- CMO Section -->
            <div class="receipt-section">
                <h5 class="section-title">CMO Details</h5>
                <div class="info-row">
                    <div class="info-label">Processed By:</div>
                    <div class="info-value">@(Context.Session.GetString("AdminFullname") ?? "Admin")</div>
                </div>            
                <!-- CRM Notes Section -->
                <div class="mt-5">
                    <h5 class="section-header">FOR CMO PERSONNEL USE ONLY</h5>

                    <div class="row g-3 mt-2">
                        <div class="col-md-6">
                            <label class="form-label">Bill Amount:</label>
                            <input type="text" class="form-control" id="billAmountInput" name="BillAmount"
                                   value="@(checkedCMO.ContainsKey("Bill") ? checkedCMO["Bill"] : "")" >
                        </div>
                    </div>



                    <div class="mt-3">
                        <label class="form-label">Supporting Documents Attached:</label>
                        <div class="row g-3 mt-1">

                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input supporting-doc" type="checkbox"
                                           id="barangayClearance" name="SupportingDocs" value="Barangay Clearance"
                                           @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Barangay Clearance") ? "checked" : "") >
                                    <label class="form-check-label" for="barangayClearance">Barangay Clearance</label>
                                </div>
                                <div class="form-check mt-2">
                                    <input class="form-check-input supporting-doc" type="checkbox"
                                           id="hospitalBill" name="SupportingDocs" value="Hospital Bill"
                                           @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Hospital Bill") ? "checked" : "") >
                                    <label class="form-check-label" for="hospitalBill">Hospital Bill</label>
                                </div>
                                <div class="form-check mt-2">
                                    <input class="form-check-input supporting-doc" type="checkbox"
                                           id="medicalCertificate" name="SupportingDocs" value="Medical Certificate"
                                           @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Medical Certificate") ? "checked" : "") >
                                    <label class="form-check-label" for="medicalCertificate">Medical Certificate</label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-check">
                                    <input class="form-check-input supporting-doc" type="checkbox"
                                           id="funeralBill" name="SupportingDocs" value="Funeral Bill"
                                           @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Funeral Bill") ? "checked" : "") >
                                    <label class="form-check-label" for="funeralBill">Funeral Bill</label>
                                </div>
                                <div class="form-check mt-2">
                                    <input class="form-check-input supporting-doc" type="checkbox"
                                           id="deathCertificate" name="SupportingDocs" value="Death Certificate"
                                           @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Death Certificate") ? "checked" : "") >
                                    <label class="form-check-label" for="deathCertificate">Death Certificate</label>
                                </div>
                                <div class="form-check mt-2">
                                    <input class="form-check-input supporting-doc" type="checkbox"
                                           id="laboratoryRequest" name="SupportingDocs" value="Laboratory Request"
                                           @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Laboratory Request") ? "checked" : "") >
                                    <label class="form-check-label" for="laboratoryRequest">Laboratory Request</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mt-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-label">Others:</label>
                                <input type="text" class="form-control" id="cmoNotesInput"
                                       placeholder="Enter notes..."
                                       value="@(checkedCMO.ContainsKey("Others") ? checkedCMO["Others"] : "")" >
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating position-relative" style="height: 100px;">
                                <input asp-for="Processby" type="text"
                                       class="form-control border rounded p-3 h-100 d-flex align-items-center justify-content-center text-center"
                                       id="processedBy"
                                       value="@(Context.Session.GetString("AdminFullname") ?? "Admin Name Not Found")"
                                       readonly
                                       style="font-size: 1.2rem;">
                                <span asp-validation-for="Processby" class="text-danger"></span>
                                <label class="form-label text-center w-100 position-absolute bottom-0 start-0">Processed by:</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="ForCMOPERSONNEL" class="form-label">CMO Reflection info:</label>
                        <input asp-for="ForCMOPERSONNEL" type="text" class="form-control" id="cmoReflectionField"
                               name="ForCMOPERSONNEL" placeholder="Auto-generated info..."
                               value="@ViewData["ForCMOPERSONNEL"]">
                        <span asp-validation-for="ForCMOPERSONNEL" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <!-- Documents -->
            <div class="receipt-section">
                <h5 class="section-title">Attached Documents</h5>
                <div class="document-previews">
                    @if (ViewData["Validfrontimage"] != null) {
                        <div class="document-preview">
                            <img src="@Url.Content("~/Validimg/" + ViewData["Validfrontimage"])" alt="ID Front">
                            <div class="document-name">ID Front</div>
                        </div>
                    }
                    
                    @if (ViewData["ValidBackimage"] != null) {
                        <div class="document-preview">
                            <img src="@Url.Content("~/Validimg/" + ViewData["ValidBackimage"])" alt="ID Back">
                            <div class="document-name">ID Back</div>
                        </div>
                    }
                    
                    @if (ViewData["DoctorPrescription"] != null) {
                        <div class="document-preview">
                            <img src="@Url.Content("~/DoctorPrescriptionimage/" + ViewData["DoctorPrescription"])" alt="Doctor Prescription">
                            <div class="document-name">Prescription/Receipt</div>
                        </div>
                    }
                    
                    @if (ViewData["DeathCertificate"] != null) {
                        <div class="document-preview">
                            <img src="@Url.Content("~/Funeralimg/" + ViewData["DeathCertificate"])" alt="Funeral Document">
                            <div class="document-name">Funeral Document</div>
                        </div>
                    }
                </div>
            </div>
                <!-- Description / Comment Section -->
                <label for="idFrontDescription" class="form-label mt-2">Description / Comments</label>
                <textarea asp-for="Comments" class="form-control" id="idFrontDescription" rows="8" cols="100" placeholder="Add any notes or comments about this document..."></textarea>
                <span asp-validation-for="Comments" class="text-danger"></span>
        </div>
        
        <div class="receipt-footer">
            <div class="edit-field mb-3" style="display: none;">
                <button class="btn btn-receipt" onclick="saveChanges()">Save Changes</button>
                <button class="btn btn-secondary" onclick="toggleEditMode()">Cancel</button>
            </div>
            <div class="view-mode">
                <button class="btn btn-receipt" onclick="window.print()">Print Receipt</button>
                <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>
            </div>
        </div>
   </form>
    </div>

    <script>
        function toggleEditMode() {
            const receiptBody = document.querySelector('.receipt-body');
            const editFields = document.querySelectorAll('.edit-field');
            const viewMode = document.querySelector('.view-mode');
            
            if (receiptBody.classList.contains('edit-mode')) {
                // Exit edit mode
                receiptBody.classList.remove('edit-mode');
                editFields.forEach(field => field.style.display = 'none');
                viewMode.style.display = 'block';
            } else {
                // Enter edit mode
                receiptBody.classList.add('edit-mode');
                editFields.forEach(field => field.style.display = 'block');
                viewMode.style.display = 'none';
            }
        }
        
        function saveChanges() {
            // Get updated values
            const newStatus = document.getElementById('statusUpdate').value;
            const newNotes = document.getElementById('crmNotesUpdate').value;
            
            // Here you would typically send these updates to the server via AJAX
            // For demonstration, we'll just show an alert and update the display
            
            // Update status display
            const statusBadge = document.querySelector('.status-badge');
            statusBadge.className = `status-badge status-${newStatus.toLowerCase()}`;
            statusBadge.textContent = newStatus;
            
            // Update CRM notes display
            const notesDisplay = document.querySelector('.crm-notes .info-value');
            notesDisplay.textContent = newNotes;
            
            // Show success message
            alert('Changes saved successfully!');
            
            // Exit edit mode
            toggleEditMode();
            
            // In a real implementation, you would send the data to the server:
            /*
            fetch('/your-update-endpoint', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    status: newStatus,
                    comments: newNotes,
                    id: '@ViewData["Id"]'
                })
            })
            .then(response => response.json())
            .then(data => {
                // Handle response
                alert('Changes saved successfully!');
                toggleEditMode();
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error saving changes.');
            });
            */
        }
        
        // Make document previews clickable to view larger
        document.querySelectorAll('.document-preview').forEach(preview => {
            preview.addEventListener('click', function() {
                const imgSrc = this.querySelector('img').src;
                window.open(imgSrc, '_blank');
            });
        });
    </script>

    <script>


                 document.addEventListener('DOMContentLoaded', function() {
            // CMO Single Checkbox Selection
            const cmoCheckboxes = document.querySelectorAll('.supporting-doc');

            cmoCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    if (this.checked) {
                        // Uncheck all other checkboxes
                        cmoCheckboxes.forEach(cb => {
                            if (cb !== this) cb.checked = false;
                        });
                    }
                    updateReflection(); // Update the reflection field
                });
            });
        });
        //1 box only

            document.addEventListener('DOMContentLoaded', function() {
            // Get all elements
            const billInput = document.getElementById('billAmountInput');
            const cmoNotes = document.getElementById('cmoNotesInput');
            const reflectionField = document.getElementById('cmoReflectionField');
            const docCheckboxes = document.querySelectorAll('.supporting-doc');

            // Update reflection function
            function updateReflection() {
                let parts = [];

                // Add bill amount if exists
                if (billInput.value.trim()) {
                    parts.push(`Bill: ${billInput.value.trim()}`);
                }

                // Add checked documents
                const checkedDocs = [];
                docCheckboxes.forEach(cb => {
                    if (cb.checked) checkedDocs.push(cb.value);
                });
                if (checkedDocs.length) {
                    parts.push(`Docs: ${checkedDocs.join(', ')}`);
                }

                // Add CMO notes if exists
                if (cmoNotes.value.trim()) {
                    parts.push(`Others: ${cmoNotes.value.trim()}`);
                }

                // Update reflection field
                reflectionField.value = parts.join(' , ');
            }

            // Set up event listeners
            billInput.addEventListener('input', updateReflection);
            cmoNotes.addEventListener('input', updateReflection);
            docCheckboxes.forEach(cb => {
                cb.addEventListener('change', updateReflection);
            });

            // Initial update (to reflect any pre-loaded data)
            updateReflection();
        });
    </script>


</body>
</html>