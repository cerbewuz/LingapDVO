@model OtherAssistanceDto
@{
    Layout = "_AdminPendingLayout";
    ViewData["Title"] = "Application View";
}

@section Styles {
    <style>
        .btn-submit {
            background-color: #28a745;
            color: white;
            font-weight: 600;
            padding: 10px 25px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.3s ease, transform 0.2s ease;
        }
        .btn-submit:hover {
            background-color: #20c997;
            transform: scale(1.05);
        }
        .form-label {
            font-weight: 500;
            color: #2c3e50;
            margin-bottom: 0.25rem;
        }
        .form-value {
            padding: 0.5rem 0.75rem;
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            min-height: 38px;
            display: flex;
            align-items: center;
        }
        .img-preview {
            width: 100%;
            max-width: 100%;
            height: auto;
            max-height: 300px;
            margin-top: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            object-fit: contain;
            cursor: pointer;
            transition: transform 0.2s;
        }
        .img-preview:hover {
            transform: scale(1.02);
        }
        .status-badge {
            display: inline-block;
            padding: 0.35rem 0.75rem;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.85rem;
        }
        .status-pending { background-color: #fff3cd; color: #856404; }
        .status-processing { background-color: #cce5ff; color: #004085; }
        .status-approve { background-color: #d4edda; color: #155724; }
        .status-disapprove { background-color: #f8d7da; color: #721c24; }
        .status-claimed { background-color: #d1ecf1; color: #0c5460; }
        .zoom-modal { display: none; position: fixed; z-index: 9999; padding-top: 50px; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(0, 0, 0, 0.9); }
        .zoom-modal-content { margin: auto; display: block; max-width: 90%; max-height: 90%; }
        .close-zoom { position: absolute; top: 15px; right: 35px; color: #f1f1f1; font-size: 40px; font-weight: bold; cursor: pointer; }
        .close-zoom:hover, .close-zoom:focus { color: #bbb; }
        .pdf-preview { border: 2px dashed #ddd; border-radius: 8px; padding: 1.5rem; text-align: center; background-color: #fafafa; cursor: pointer; transition: all 0.3s; }
        .pdf-preview:hover { border-color: var(--primary-color); background-color: var(--primary-light); }
        .pdf-icon { font-size: 3rem; color: #dc143c; margin-bottom: 0.5rem; }
    </style>
}

<div id="zoomModal" class="zoom-modal">
    <span class="close-zoom">&times;</span>
    <img class="zoom-modal-content" id="zoomedImage">
</div>

<form asp-action="OtherAssistancePendingStatus" method="post">
    <div class="row g-3 mb-3">
        <div class="col-md-12">
            <label class="form-label">Application ID</label>
            <div class="form-value">@ViewData["Id"]</div>
        </div>
    </div>
    <h5 class="section-header">Patient's Details</h5>
    <div class="row g-3">
        <div class="col-md-3"><label class="form-label">Last Name</label><div class="form-value">@ViewData["Lastname"]</div></div>
        <div class="col-md-3"><label class="form-label">First Name</label><div class="form-value">@ViewData["Firstname"]</div></div>
        <div class="col-md-3"><label class="form-label">Middle Name</label><div class="form-value">@ViewData["Middlename"]</div></div>
        <div class="col-md-3"><label class="form-label">Suffix</label><div class="form-value">@(ViewData["Suffix"]?.ToString() == "None" ? "" : ViewData["Suffix"])</div></div>
    </div>
    <div class="row g-3 mt-2">
        <div class="col-md-3"><label class="form-label">Blk / Lot / Street</label><div class="form-value">@ViewData["BlkLotStreet"]</div></div>
        <div class="col-md-3"><label class="form-label">Sub / Vill.</label><div class="form-value">@ViewData["SubVill"]</div></div>
        <div class="col-md-3"><label class="form-label">Brgy.</label><div class="form-value">@ViewData["Brgy"]</div></div>
        <div class="col-md-3"><label class="form-label">District</label><div class="form-value">@ViewData["District"]</div></div>
    </div>
    <div class="row g-3 mt-2">
        <div class="col-md-2"><label class="form-label">Sex</label><div class="form-value">@ViewData["Sex"]</div></div>
        <div class="col-md-3"><label class="form-label">PhilHealth</label><div class="form-value">@ViewData["PhilHealth"]</div></div>
        <div class="col-md-3"><label class="form-label">PhilHealth No.</label><div class="form-value">@ViewData["PhilHealthNo"]</div></div>
        <div class="col-md-2"><label class="form-label">Date of Birth</label><div class="form-value">@ViewData["Dateofbirth"]</div></div>
        <div class="col-md-2"><label class="form-label">Age</label><div class="form-value">@ViewData["Age"]</div></div>
    </div>
    <h5 class="section-header mt-4">Requestor's Details</h5>
    <div class="row g-3">
        <div class="col-md-3"><label class="form-label">Last Name</label><div class="form-value">@ViewData["RLastname"]</div></div>
        <div class="col-md-3"><label class="form-label">First Name</label><div class="form-value">@ViewData["RFirstname"]</div></div>
        <div class="col-md-3"><label class="form-label">Middle Name</label><div class="form-value">@ViewData["RMiddlename"]</div></div>
        <div class="col-md-3"><label class="form-label">Suffix</label><div class="form-value">@ViewData["RSuffix"]</div></div>
    </div>
    <div class="row g-3 mt-2">
        <div class="col-md-3"><label class="form-label">Blk / Lot / Street</label><div class="form-value">@ViewData["RBlkLotStreet"]</div></div>
        <div class="col-md-3"><label class="form-label">Sub / Vill.</label><div class="form-value">@ViewData["RSubVill"]</div></div>
        <div class="col-md-3"><label class="form-label">Brgy.</label><div class="form-value">@ViewData["RBrgy"]</div></div>
        <div class="col-md-3"><label class="form-label">District</label><div class="form-value">@ViewData["RDistrict"]</div></div>
    </div>
    <div class="row g-3 mt-2">
        <div class="col-md-6"><label class="form-label">Relationship to Patient</label><div class="form-value">@ViewData["RelationshipPatient"]</div></div>
        <div class="col-md-6"><label class="form-label">Contact No.</label><div class="form-value">@ViewData["ContactNo"]</div></div>
    </div>
    <h5 class="section-header mt-4">Assistance Requested</h5>
    <div class="row g-3"><div class="col-md-12"><div class="form-value">@ViewData["Typeassistance"]</div></div></div>
    <h5 class="section-header mt-4">Submitted Documents</h5>
    <div class="row g-3">
        <div class="col-md-6 mb-3">
            @if (ViewData["DoctorPrescriptionBase64"] != null) {
                <label class="form-label">Doctor Prescription</label>
                @if (ViewData["IsDoctorPrescriptionPdf"] != null && (bool)ViewData["IsDoctorPrescriptionPdf"]) {
                    <div class="pdf-preview" onclick="viewPDFInModal('@ViewData["DoctorPrescription"]', 'doctorprescription', 'Doctor Prescription')">
                        <div class="pdf-icon"><i class="bi bi-file-earmark-pdf"></i></div>
                        <div class="pdf-info"><span class="pdf-filename">@ViewData["DoctorPrescription"]</span><span class="pdf-label">Click to view PDF</span></div>
                    </div>
                } else {
                    <img src="data:image/jpeg;base64,@ViewData["DoctorPrescriptionBase64"]" alt="Doctor Prescription" class="img-preview mb-3" onclick="zoomImage('data:image/jpeg;base64,@ViewData["DoctorPrescriptionBase64"]')">
                }
            }
            @if (ViewData["MedicalCertificateBase64"] != null) {
                <label class="form-label mt-3">Medical Certificate</label>
                @if (ViewData["IsMedicalCertificatePdf"] != null && (bool)ViewData["IsMedicalCertificatePdf"]) {
                    <div class="pdf-preview" onclick="viewPDFInModal('@ViewData["MedicalCertificate"]', 'medicalcertificate', 'Medical Certificate')">
                        <div class="pdf-icon"><i class="bi bi-file-earmark-pdf"></i></div>
                        <div class="pdf-info"><span class="pdf-filename">@ViewData["MedicalCertificate"]</span><span class="pdf-label">Click to view PDF</span></div>
                    </div>
                } else {
                    <img src="data:image/jpeg;base64,@ViewData["MedicalCertificateBase64"]" alt="Medical Certificate" class="img-preview" onclick="zoomImage('data:image/jpeg;base64,@ViewData["MedicalCertificateBase64"]')">
                }
            }
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Valid ID - Front</label>
            @if (ViewData["ValidfrontimageBase64"] != null) { <img src="data:image/jpeg;base64,@ViewData["ValidfrontimageBase64"]" alt="Front ID" class="img-preview mb-3" onclick="zoomImage('data:image/jpeg;base64,@ViewData["ValidfrontimageBase64"]')"> } else { <p class="text-muted">No front ID image available</p> }
            <label class="form-label mt-3">Valid ID - Back</label>
            @if (ViewData["ValidBackimageBase64"] != null) { <img src="data:image/jpeg;base64,@ViewData["ValidBackimageBase64"]" alt="Back ID" class="img-preview" onclick="zoomImage('data:image/jpeg;base64,@ViewData["ValidBackimageBase64"]')"> } else { <p class="text-muted">No back ID image available</p> }
        </div>
    </div>
    <h5 class="section-header mt-4">Request Status</h5>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">Current Status</label><div class="form-value"><span class="status-badge status-@(ViewData["Status"]?.ToString()?.ToLower())">@ViewData["Status"]</span></div></div>
    </div>
    <input type="hidden" name="status2" value="Processing" />
    <div class="text-center mt-4">
        <button type="submit" class="btn-submit"><i class="bi bi-gear-fill"></i> Process Application</button>
        <button type="button" class="btn btn-secondary ms-2" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>
        <a href="javascript:history.back()" class="btn btn-secondary ms-2"><i class="bi bi-arrow-left"></i> Go Back</a>
    </div>
    <br /><br />
</form>

@section Scripts {
    <script>
        function zoomImage(imageSrc) { const modal = document.getElementById('zoomModal'); const modalImg = document.getElementById('zoomedImage'); modal.style.display = 'block'; modalImg.src = imageSrc; }
        document.querySelector('.close-zoom')?.addEventListener('click', function() { document.getElementById('zoomModal').style.display = 'none'; });
        document.getElementById('zoomModal')?.addEventListener('click', function(e) { if (e.target === this) { this.style.display = 'none'; } });
        function viewPDFInModal(filename, folder, title) { console.log('Loading PDF:', `/uploads/${folder}/${filename}`); }
    </script>
}
