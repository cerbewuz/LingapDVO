@model FuneralburialformDto
@{
    Layout = null;
    var selectedSex = ViewData["Sex"]?.ToString();
    var checkedAssistance = ViewData["CheckedAssistance"] as Dictionary<string, string> ?? new();
    var checkedCMO = ViewData["CheckedCMOPERSONNEL"] as Dictionary<string, string> ?? new Dictionary<string, string>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- PDF.js Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <title>Hospital Bill Application - Receipt View</title>
    <link rel="icon" type="image/x-icon" href="~/lingaplogo.ico">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        :root {
            --primary-color: #DC143C;
            --primary-light: #FFE6EA;
            --primary-dark: #B01030;
            --secondary-color: #2c3e50;
            --light-gray: #f8f9fa;
            --border-color: #dee2e6;
        }


        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #333;
        }

        /* Go Back Button */
        .go-back-btn {
            position: fixed;
            left: 16px;
            top: 16px;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 8px 14px;
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            border: 1px solid rgba(220, 20, 60, 0.15);
            color: #333333;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            white-space: nowrap;
            min-height: 36px;
            min-width: 36px;
            transform: scale(var(--btn-scale, 1));
            transform-origin: left top;
            -webkit-tap-highlight-color: transparent;
            touch-action: manipulation;
            user-select: none;
        }

            .go-back-btn:hover,
            .go-back-btn:focus {
                background: #DC143C;
                color: #ffffff;
                box-shadow: 0 4px 20px rgba(220, 20, 60, 0.3);
                transform: translateY(-1px) scale(calc(var(--btn-scale, 1) * 1.02));
                border-color: #DC143C;
            }

            .go-back-btn i {
                font-size: 13px;
                transition: transform 0.3s ease;
                width: 14px;
                text-align: center;
            }

            .go-back-btn:hover i {
                transform: translateX(-2px);
            }

            .go-back-btn:active {
                transform: scale(calc(var(--btn-scale, 1) * 0.96));
                background: #b01030;
                transition: transform 0.1s ease;
            }

            .go-back-btn:focus-visible {
                outline: 2px solid #DC143C;
                outline-offset: 2px;
            }

            .go-back-btn.compact span {
                display: none;
            }

            .go-back-btn.compact {
                padding: 8px;
                border-radius: 50%;
            }

        .receipt-container {
            max-width: 800px;
            margin: 2rem auto;
            background: white;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
            overflow: hidden;
        }

        .receipt-header {
            background: var(--primary-color);
            color: white;
            padding: 1.5rem;
            text-align: center;
        }

        .receipt-body {
            padding: 2rem;
        }

        .receipt-section {
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--border-color);
        }

        .section-title {
            color: var(--primary-color);
            font-weight: 600;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid var(--primary-light);
        }

        .info-row {
            display: flex;
            margin-bottom: 0.5rem;
        }

        .info-label {
            flex: 0 0 30%;
            font-weight: 500;
            color: var(--secondary-color);
        }

        .info-value {
            flex: 1;
            color: #555;
        }

        .status-badge {
            display: inline-block;
            padding: 0.35rem 0.75rem;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.85rem;
        }

        .status-pending {
            background-color: #fff3cd;
            color: #856404;
        }

        .status-approved {
            background-color: #d4edda;
            color: #155724;
        }

        .status-unapproved {
            background-color: #f8d7da;
            color: #721c24;
        }

        .status-processing {
            background-color: #cce5ff;
            color: #004085;
        }

        .status-claimed {
            background-color: #d1ecf1;
            color: #0c5460;
        }

        .edit-toggle {
            cursor: pointer;
            color: var(--primary-color);
            font-size: 1.1rem;
            margin-left: 0.5rem;
        }

        .edit-mode .info-value {
            padding: 0.25rem;
            border: 1px dashed #ccc;
            border-radius: 4px;
        }

        .receipt-footer {
            background: var(--light-gray);
            padding: 1.5rem;
            text-align: center;
            border-top: 1px solid var(--border-color);
        }

        .btn-receipt {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            color: white;
            padding: 0.5rem 1.5rem;
            font-weight: 500;
            border-radius: 5px;
        }

            .btn-receipt:hover {
                background-color: var(--primary-dark);
                border-color: var(--primary-dark);
                color: white;
            }

        .zoom-modal {
            display: none;
            position: fixed;
            z-index: 1000;
            padding-top: 50px;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.9);
        }

        .zoom-modal-content {
            margin: auto;
            display: block;
            max-width: 90%;
            max-height: 90%;
        }

        .close-zoom {
            position: absolute;
            top: 15px;
            right: 35px;
            color: #fff;
            font-size: 40px;
            font-weight: bold;
            cursor: pointer;
        }

        .id-image-container {
            cursor: pointer;
            transition: transform 0.2s;
        }

            .id-image-container:hover {
                transform: scale(1.02);
            }

        .id-image {
            width: 100%;
            height: 200px;
            object-fit: contain;
            background-color: #f8f9fa;
            border: 1px solid var(--border-color);
            border-radius: 5px;
        }

        .pdf-container {
            cursor: pointer;
            transition: transform 0.2s;
        }

        .pdf-preview {
            display: flex;
            align-items: center;
            padding: 1rem;
            border: 2px dashed var(--border-color);
            border-radius: 8px;
            background-color: var(--light-gray);
            transition: all 0.3s ease;
        }

            .pdf-preview:hover {
                border-color: var(--primary-color);
                background-color: var(--primary-light);
                transform: translateY(-2px);
            }

        .pdf-icon {
            font-size: 3rem;
            color: #dc143c;
            margin-right: 1rem;
        }

        .pdf-info {
            display: flex;
            flex-direction: column;
        }

        .pdf-filename {
            font-weight: 600;
            color: var(--secondary-color);
            margin-bottom: 0.25rem;
        }

        .pdf-label {
            font-size: 0.9rem;
            color: #6c757d;
        }

        /* PDF Viewer Modal Styles */
        .pdf-viewer-modal {
            display: none;
            position: fixed;
            z-index: 2000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.95);
        }

        .pdf-viewer-content {
            position: relative;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .pdf-viewer-header {
            background-color: #333;
            color: white;
            padding: 1rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .pdf-viewer-title {
            font-size: 1.1rem;
            font-weight: 500;
        }

        .pdf-viewer-close {
            background: none;
            border: none;
            color: white;
            font-size: 2rem;
            cursor: pointer;
            padding: 0 0.5rem;
            line-height: 1;
        }

            .pdf-viewer-close:hover {
                color: var(--primary-color);
            }

        .pdf-viewer-body {
            flex: 1;
            background-color: #525659;
            position: relative;
            overflow: auto;
        }

        .pdf-container {
            display: flex;
            justify-content: center;
            padding: 20px;
            min-height: 100%;
        }

        #pdfCanvas {
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
            background-color: white;
        }

        .pdf-controls {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-left: auto;
            flex-wrap: wrap;
        }

        .page-info {
            color: white;
            font-size: 0.9rem;
            margin: 0 10px;
        }

        .zoom-level {
            color: white;
            font-size: 0.9rem;
            min-width: 40px;
            text-align: center;
        }

        .pdf-loading {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: white;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }

        .pdf-error {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            color: white;
            display: none;
        }

            .pdf-error i {
                font-size: 3rem;
                margin-bottom: 1rem;
            }

        .btn-light {
            background-color: rgba(255, 255, 255, 0.9);
            border: none;
        }

            .btn-light:hover {
                background-color: white;
            }

            .btn-light:disabled {
                opacity: 0.5;
                cursor: not-allowed;
            }




        .status-radio-group {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

            .status-radio-group .form-check {
                margin-bottom: 0;
            }

            .status-radio-group .form-check-input {
                margin-top: 0.3rem;
            }

            .status-radio-group .form-check-label {
                padding-left: 0.5rem;
            }
    </style>
</head>
<body>
    <!-- Go Back Button -->
    <a href="#" class="go-back-btn" id="goBackBtn" role="button" aria-label="Go back to previous page" title="Go back">
        <i class="fas fa-arrow-left" aria-hidden="true"></i>
        <span>Back</span>
    </a>

    <!-- Image Zoom Modal -->
    <div id="zoomModal" class="zoom-modal">
        <span class="close-zoom">&times;</span>
        <img class="zoom-modal-content" id="zoomedImage">
    </div>

    <!-- PDF Viewer Modal -->
    <div id="pdfViewerModal" class="pdf-viewer-modal">
        <div class="pdf-viewer-content">
            <div class="pdf-viewer-header">
                <span class="pdf-viewer-title" id="pdfViewerTitle">PDF Document</span>
                <div class="pdf-controls">
                    <button class="btn btn-sm btn-light" onclick="prevPage()" id="prevBtn">
                        <i class="bi bi-chevron-left"></i> Previous
                    </button>
                    <span class="page-info" id="pageInfo">Page: <span id="currentPage">1</span> / <span id="totalPages">1</span></span>
                    <button class="btn btn-sm btn-light" onclick="nextPage()" id="nextBtn">
                        Next <i class="bi bi-chevron-right"></i>
                    </button>
                    <button class="btn btn-sm btn-light" onclick="zoomOut()">
                        <i class="bi bi-zoom-out"></i>
                    </button>
                    <span class="zoom-level" id="zoomLevel">100%</span>
                    <button class="btn btn-sm btn-light" onclick="zoomIn()">
                        <i class="bi bi-zoom-in"></i>
                    </button>
                </div>
                <button class="pdf-viewer-close" onclick="closePDFViewer()">&times;</button>
            </div>
            <div class="pdf-viewer-body">
                <div id="pdfLoading" class="pdf-loading">
                    <div class="spinner-border text-light" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p>Loading PDF document...</p>
                </div>
                <div id="pdfError" class="pdf-error">
                    <i class="bi bi-exclamation-triangle"></i>
                    <p>Error loading PDF. Please try again.</p>
                </div>
                <div class="pdf-container">
                    <canvas id="pdfCanvas"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="receipt-container">
        <form asp-action="FuneralburialformUpdateprocessingstatus" enctype="multipart/form-data" method="post">
            <div class="receipt-header">
                <h3>Hospital Bill Application Details</h3>

            </div>

            <div class="receipt-body">

                <!-- Patient Information -->
                <div class="receipt-section">
                    <div class="info-row">
                        <div class="info-label">Application ID:@ViewData["Id"]</div>
                    </div>
                    <br />
                    <h5 class="section-title">Patient Information</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="info-row">
                                <div class="info-label">Name:</div>
                                <div class="info-value">
                                    @ViewData["Firstname"] @ViewData["Middlename"] @ViewData["Lastname"]
                                    @(ViewData["Suffix"]?.ToString() == "None" ? "" : " " + ViewData["Suffix"])
                                </div>
                            </div>

                            <div class="info-row">
                                <div class="info-label">Address:</div>
                                <div class="info-value">@ViewData["BlkLotStreet"], @ViewData["SubVill"], @ViewData["Brgy"], @ViewData["District"]</div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">Sex:</div>
                                <div class="info-value">@ViewData["Sex"]</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-row">
                                <div class="info-label">Date of Birth:</div>
                                <div class="info-value">@ViewData["Dateofbirth"]</div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">Age:</div>
                                <div class="info-value">@ViewData["Age"]</div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">PhilHealth:</div>
                                <div class="info-value">@ViewData["PhilHealth"]</div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">PhilHealth No:</div>
                                <div class="info-value">@ViewData["PhilHealthNo"]</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Requestor Details -->
                <div class="receipt-section">
                    <h5 class="section-title">Requestor's Details</h5>
                    <div class="info-row">
                        <div class="info-label">Full Name:</div>
                        <div class="info-value">@ViewData["RLastname"], @ViewData["RFirstname"] @ViewData["RMiddlename"] @ViewData["RSuffix"]</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Address:</div>
                        <div class="info-value">@ViewData["RBlkLotStreet"], @ViewData["RSubVill"], @ViewData["RBrgy"], @ViewData["RDistrict"]</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Relationship to Patient:</div>
                        <div class="info-value">@ViewData["RelationshipPatient"]</div>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Contact No:</div>
                        <div class="info-value">@ViewData["ContactNo"]</div>
                    </div>
                </div>

                <!-- Assistance Requested -->
                <div class="receipt-section">
                    <h5 class="section-title">Assistance Requested</h5>
                    <div class="info-value">@ViewData["Typeassistance"]</div>
                </div>

                <!-- CMO Section -->
                <div class="receipt-section">
                    <h5 class="section-title">CMO Details</h5>
                    <div class="mt-3">
                        <div class="row g-3 mt-2">
                            <div class="col-md-6">
                                <label class="form-label">Bill Amount:</label>
                                <input type="text" class="form-control" id="billAmountInput" name="BillAmount" value="@(checkedCMO.ContainsKey("Bill") ? checkedCMO["Bill"] : "")">
                            </div>
                        </div>
                        <div class="mt-3">
                            <label class="form-label">Supporting Documents Attached:</label>
                            <div class="row g-3 mt-1">
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input supporting-doc" type="checkbox" id="barangayClearance" name="SupportingDocs" value="Barangay Clearance" @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Barangay Clearance") ? "checked" : "")>
                                        <label class="form-check-label" for="barangayClearance">Barangay Clearance</label>
                                    </div>
                                    <div class="form-check mt-2">
                                        <input class="form-check-input supporting-doc" type="checkbox" id="hospitalBill" name="SupportingDocs" value="Hospital Bill" @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Hospital Bill") ? "checked" : "")>
                                        <label class="form-check-label" for="hospitalBill">Hospital Bill</label>
                                    </div>
                                    <div class="form-check mt-2">
                                        <input class="form-check-input supporting-doc" type="checkbox" id="medicalCertificate" name="SupportingDocs" value="Medical Certificate" @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Medical Certificate") ? "checked" : "")>
                                        <label class="form-check-label" for="medicalCertificate">Medical Certificate</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input class="form-check-input supporting-doc" type="checkbox" id="funeralBill" name="SupportingDocs" value="Funeral Bill" @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Funeral Bill") ? "checked" : "")>
                                        <label class="form-check-label" for="funeralBill">Funeral Bill</label>
                                    </div>
                                    <div class="form-check mt-2">
                                        <input class="form-check-input supporting-doc" type="checkbox" id="deathCertificate" name="SupportingDocs" value="Death Certificate" @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Death Certificate") ? "checked" : "")>
                                        <label class="form-check-label" for="deathCertificate">Death Certificate</label>
                                    </div>
                                    <div class="form-check mt-2">
                                        <input class="form-check-input supporting-doc" type="checkbox" id="laboratoryRequest" name="SupportingDocs" value="Laboratory Request" @(checkedCMO.ContainsKey("Docs") && checkedCMO["Docs"].Contains("Laboratory Request") ? "checked" : "")>
                                        <label class="form-check-label" for="laboratoryRequest">Laboratory Request</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row g-3 mt-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label">Others:</label>
                                    <input type="text" class="form-control" id="cmoNotesInput" placeholder="Enter notes..." value="@(checkedCMO.ContainsKey("Others") ? checkedCMO["Others"] : "")">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating position-relative" style="height: 100px;">
                                    <input asp-for="Processby" type="text" class="form-control border rounded p-3 h-100 d-flex align-items-center justify-content-center text-center" id="processedBy" value="@(Context.Session.GetString("AdminFullname") ?? "Admin Name Not Found")" readonly style="font-size: 1.2rem;">
                                    <span asp-validation-for="Processby" class="text-danger"></span>
                                    <label class="form-label text-center w-100 position-absolute bottom-0 start-0">Processed by:</label>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label asp-for="ForCMOPERSONNEL" class="form-label">CMO Reflection info:</label>
                            <input asp-for="ForCMOPERSONNEL" type="text" class="form-control" id="cmoReflectionField" name="ForCMOPERSONNEL" placeholder="Auto-generated info..." value="@ViewData["ForCMOPERSONNEL"]">
                            <span asp-validation-for="ForCMOPERSONNEL" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Comments Section -->
                <div class="receipt-section">
                    <label for="idFrontDescription" class="form-label">Description / Comments</label>
                    <textarea asp-for="Comments" class="form-control" id="idFrontDescription" rows="4" placeholder="Add any notes or comments about this application...">@ViewData["Comments"]</textarea>
                    <span asp-validation-for="Comments" class="text-danger"></span>
                </div>


                <!-- Valid ID Section -->
                <div class="receipt-section">
                    <h5 class="section-title">Valid ID</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <h6>Front ID</h6>
                            @if (ViewData["ValidfrontimageBase64"] != null)
                            {
                                <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["ValidfrontimageBase64"]')">
                                    <img src="data:image/jpeg;base64,@ViewData["ValidfrontimageBase64"]" alt="Front ID" class="id-image" />
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No front ID image available</p>
                            }
                        </div>
                        <div class="col-md-6 mb-3">
                            <h6>Back ID</h6>
                            @if (ViewData["ValidBackimageBase64"] != null)
                            {
                                <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["ValidBackimageBase64"]')">
                                    <img src="data:image/jpeg;base64,@ViewData["ValidBackimageBase64"]" alt="Back ID" class="id-image" />
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No back ID image available</p>
                            }
                        </div>
                    </div>
                </div>

                <!-- Doctor Prescription -->
                @if (ViewData["DoctorPrescriptionBase64"] != null)
                {
                    <div class="receipt-section">
                        <h5 class="section-title">Doctor Prescription</h5>
                        @if (ViewData["IsDoctorPrescriptionPdf"] != null && (bool)ViewData["IsDoctorPrescriptionPdf"])
                        {
                            <div class="pdf-container">
                                <div class="pdf-preview" onclick="viewPDFInModal('@ViewData["DoctorPrescription"]', 'doctorprescription', 'Doctor Prescription')">
                                    <div class="pdf-icon"><i class="bi bi-file-earmark-pdf"></i></div>
                                    <div class="pdf-info">
                                        <span class="pdf-filename">@ViewData["DoctorPrescription"]</span>
                                        <span class="pdf-label">Click to view PDF</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["DoctorPrescriptionBase64"]')">
                                <img src="data:image/jpeg;base64,@ViewData["DoctorPrescriptionBase64"]" alt="Doctor Prescription" class="id-image" />
                            </div>
                        }
                    </div>
                }

                <!-- Medical Certificate -->
                @if (ViewData["MedicalCertificateBase64"] != null)
                {
                    <div class="receipt-section">
                        <h5 class="section-title">Medical Certificate</h5>
                        @if (ViewData["IsMedicalCertificatePdf"] != null && (bool)ViewData["IsMedicalCertificatePdf"])
                        {
                            <div class="pdf-container">
                                <div class="pdf-preview" onclick="viewPDFInModal('@ViewData["MedicalCertificate"]', 'medicalcertificate', 'Medical Certificate')">
                                    <div class="pdf-icon"><i class="bi bi-file-earmark-pdf"></i></div>
                                    <div class="pdf-info">
                                        <span class="pdf-filename">@ViewData["MedicalCertificate"]</span>
                                        <span class="pdf-label">Click to view PDF</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["MedicalCertificateBase64"]')">
                                <img src="data:image/jpeg;base64,@ViewData["MedicalCertificateBase64"]" alt="Medical Certificate" class="id-image" />
                            </div>
                        }
                    </div>
                }


                <!-- Death Certificate -->
                @if (ViewData["DeathCertificateBase64"] != null)
                {
                    <div class="receipt-section">
                        <h5 class="section-title">Death Certificate</h5>
                        @if (ViewData["IsDeathCertificatePdf"] != null && (bool)ViewData["IsDeathCertificatePdf"])
                        {
                            <div class="pdf-container">
                                <div class="pdf-preview" onclick="viewPDFInModal('@ViewData["DeathCertificate"]', 'deathcertificate', 'Death Certificate')">
                                    <div class="pdf-icon"><i class="bi bi-file-earmark-pdf"></i></div>
                                    <div class="pdf-info">
                                        <span class="pdf-filename">@ViewData["DeathCertificate"]</span>
                                        <span class="pdf-label">Click to view PDF</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["DeathCertificateBase64"]')">
                                <img src="data:image/jpeg;base64,@ViewData["DeathCertificateBase64"]" alt="Death Certificate" class="id-image" />
                            </div>
                        }
                    </div>
                }


                <!-- Status Section -->
                <div class="receipt-section">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="section-title mb-0">Request Status</h5>
                        <span class="edit-toggle" onclick="toggleEditMode()"><i class="bi bi-pencil-square"></i></span>
                    </div>
                    <div class="info-row">
                        <div class="info-label">Current Status:</div>
                        <div class="info-value">
                            <span class="status-badge status-@(ViewData["Status"]?.ToString()?.ToLower())">
                                @ViewData["Status"]
                            </span>
                        </div>
                    </div>
                    <div class="edit-field mt-2" style="display: none;">
                        <label class="form-label">Update Status:</label>
                        <div class="status-radio-group">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="status2" id="statusApproved"
                                       value="Approved" @(ViewData["Status"]?.ToString() == "Approved" ? "checked" : "")>
                                <label class="form-check-label" for="statusApproved">
                                    Approved
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="status2" id="statusUnapproved"
                                       value="Unapproved" @(ViewData["Status"]?.ToString() == "Unapproved" ? "checked" : "")>
                                <label class="form-check-label" for="statusUnapproved">
                                    Unapproved
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>



            <div class="receipt-footer">
                <div class="edit-field mb-3" style="display: none;">
                    <button href="/Admin" type="submit" class="btn btn-receipt">Save Changes</button>
                    <button type="button" class="btn btn-secondary" onclick="toggleEditMode()">Cancel</button>
                </div>
                <div class="view-mode">
                    <button type="button" class="btn btn-receipt" onclick="window.print()">Print Receipt</button>
                    <a href="javascript:history.back()" class="btn btn-secondary">Go Back</a>
                </div>
            </div>
        </form>
    </div>

    <script>
          // Go Back Button Script
        document.addEventListener('DOMContentLoaded', function() {
            const goBackBtn = document.getElementById('goBackBtn');

            if (goBackBtn) {
                // Responsive compact mode
                function updateButton() {
                    const viewportWidth = window.innerWidth;

                    // Switch to compact mode on smaller screens
                    if (viewportWidth < 480) {
                        goBackBtn.classList.add('compact');
                    } else {
                        goBackBtn.classList.remove('compact');
                    }
                }

                // Update on viewport changes
                function handleViewportChange() {
                    updateButton();
                }

                // Initial setup
                updateButton();

                // Listen to viewport changes
                window.addEventListener('resize', handleViewportChange);
                window.addEventListener('orientationchange', handleViewportChange);

                // Click functionality
                goBackBtn.addEventListener('click', function(e) {
                    e.preventDefault();

                    // Add press animation
                    this.style.transition = 'transform 0.1s ease';
                    this.style.transform = 'scale(0.95)';

                    setTimeout(() => {
                        this.style.transition = 'all 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
                        this.style.transform = '';

                        // Navigate back or to home page
                        if (window.history.length > 1) {
                            window.history.back();
                        } else {
                            window.location.href = '/';
                        }
                    }, 100);
                });
            }
        });

        // PDF Viewer Variables
        let currentPDF = null;
        let currentPage = 1;
        let totalPages = 1;
        let currentScale = 1.2;

        // Image Zoom Functionality
        function zoomImage(src) {
            const modal = document.getElementById("zoomModal");
            const modalImg = document.getElementById("zoomedImage");
            modal.style.display = "block";
            modalImg.src = src;
        }

        // Close zoom modal
        document.querySelector(".close-zoom").onclick = function() {
            document.getElementById("zoomModal").style.display = "none";
        }

        // PDF Viewer Function
        async function viewPDFInModal(fileName, fileType, displayName) {
            const modal = document.getElementById('pdfViewerModal');
            const title = document.getElementById('pdfViewerTitle');
            const loading = document.getElementById('pdfLoading');
            const errorDiv = document.getElementById('pdfError');
            const canvas = document.getElementById('pdfCanvas');
            const context = canvas.getContext('2d');
            const currentPageSpan = document.getElementById('currentPage');
            const totalPagesSpan = document.getElementById('totalPages');
            const zoomLevelSpan = document.getElementById('zoomLevel');
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');

            // Reset state
            title.textContent = displayName || 'PDF Document';
            modal.style.display = 'block';
            loading.style.display = 'flex';
            errorDiv.style.display = 'none';
            canvas.style.display = 'none';

            currentPDF = null;
            currentPage = 1;
            currentScale = 1.2;

            try {
                // Encode filename and build URL
                const encodedFileName = encodeURIComponent(fileName);
                const url = '@Url.Action("ViewPDF", "Adminuser")?fileName=' + encodedFileName + '&fileType=' + fileType + '&t=' + Date.now();

                // Fetch PDF
                const response = await fetch(url);

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const pdfData = await response.arrayBuffer();

                if (!pdfData || pdfData.byteLength === 0) {
                    throw new Error('PDF data is empty');
                }

                // Load PDF using PDF.js
                const loadingTask = pdfjsLib.getDocument({ data: pdfData });
                currentPDF = await loadingTask.promise;

                totalPages = currentPDF.numPages;
                totalPagesSpan.textContent = totalPages;
                currentPageSpan.textContent = currentPage;

                // Update control buttons
                updateNavigationButtons();

                // Render first page
                await renderPage(currentPage);

                // Hide loading, show canvas
                loading.style.display = 'none';
                canvas.style.display = 'block';
                zoomLevelSpan.textContent = Math.round(currentScale * 100) + '%';

            } catch (error) {
                console.error('Error loading PDF:', error);
                loading.style.display = 'none';
                errorDiv.style.display = 'block';
                errorDiv.querySelector('p').textContent = `Error loading PDF: ${error.message}`;
            }
        }

        // Render specific page
        async function renderPage(pageNum) {
            if (!currentPDF) return;

            const canvas = document.getElementById('pdfCanvas');
            const context = canvas.getContext('2d');
            const currentPageSpan = document.getElementById('currentPage');

            try {
                const page = await currentPDF.getPage(pageNum);
                const viewport = page.getViewport({ scale: currentScale });

                // Set canvas dimensions
                canvas.height = viewport.height;
                canvas.width = viewport.width;

                // Render PDF page
                const renderContext = {
                    canvasContext: context,
                    viewport: viewport
                };

                await page.render(renderContext).promise;
                currentPageSpan.textContent = pageNum;

            } catch (error) {
                console.error('Error rendering page:', error);
            }
        }

        // Navigation functions
        function nextPage() {
            if (currentPage < totalPages) {
                currentPage++;
                renderPage(currentPage);
                updateNavigationButtons();
            }
        }

        function prevPage() {
            if (currentPage > 1) {
                currentPage--;
                renderPage(currentPage);
                updateNavigationButtons();
            }
        }

        function zoomIn() {
            currentScale += 0.2;
            renderPage(currentPage);
            document.getElementById('zoomLevel').textContent = Math.round(currentScale * 100) + '%';
        }

        function zoomOut() {
            if (currentScale > 0.5) {
                currentScale -= 0.2;
                renderPage(currentPage);
                document.getElementById('zoomLevel').textContent = Math.round(currentScale * 100) + '%';
            }
        }

        function updateNavigationButtons() {
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');

            prevBtn.disabled = currentPage <= 1;
            nextBtn.disabled = currentPage >= totalPages;
        }

        // Close PDF Viewer
        function closePDFViewer() {
            const modal = document.getElementById('pdfViewerModal');
            modal.style.display = 'none';

            // Clean up
            if (currentPDF) {
                currentPDF.destroy();
                currentPDF = null;
            }
        }

        // Edit Mode Toggle
        function toggleEditMode() {
            const receiptBody = document.querySelector('.receipt-body');
            const editFields = document.querySelectorAll('.edit-field');
            const viewMode = document.querySelector('.view-mode');
            if (receiptBody.classList.contains('edit-mode')) {
                receiptBody.classList.remove('edit-mode');
                editFields.forEach(field => field.style.display = 'none');
                viewMode.style.display = 'block';
            } else {
                receiptBody.classList.add('edit-mode');
                editFields.forEach(field => field.style.display = 'block');
                viewMode.style.display = 'none';
            }
        }

        // CMO Reflection Auto-generation
        document.addEventListener('DOMContentLoaded', function() {
            const cmoCheckboxes = document.querySelectorAll('.supporting-doc');
            cmoCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    if (this.checked) {
                        cmoCheckboxes.forEach(cb => {
                            if (cb !== this) cb.checked = false;
                        });
                    }
                    updateReflection();
                });
            });

            function updateReflection() {
                const billInput = document.getElementById('billAmountInput');
                const cmoNotes = document.getElementById('cmoNotesInput');
                const reflectionField = document.getElementById('cmoReflectionField');
                const docCheckboxes = document.querySelectorAll('.supporting-doc');

                let parts = [];
                if (billInput.value.trim()) {
                    parts.push(`Bill: ${billInput.value.trim()}`);
                }
                const checkedDocs = [];
                docCheckboxes.forEach(cb => {
                    if (cb.checked) checkedDocs.push(cb.value);
                });
                if (checkedDocs.length) {
                    parts.push(`Docs: ${checkedDocs.join(', ')}`);
                }
                if (cmoNotes.value.trim()) {
                    parts.push(`Others: ${cmoNotes.value.trim()}`);
                }
                reflectionField.value = parts.join(' , ');
            }

            const billInput = document.getElementById('billAmountInput');
            const cmoNotes = document.getElementById('cmoNotesInput');
            if (billInput) billInput.addEventListener('input', updateReflection);
            if (cmoNotes) cmoNotes.addEventListener('input', updateReflection);
            updateReflection();
        });

        // Keyboard shortcuts and navigation
        document.addEventListener('keydown', function(e) {
            // ESC key closes modals
            if (e.key === 'Escape') {
                document.getElementById("zoomModal").style.display = "none";
                closePDFViewer();
            }

            // PDF navigation when PDF viewer is open
            const pdfModal = document.getElementById('pdfViewerModal');
            if (pdfModal.style.display === 'block') {
                switch(e.key) {
                    case 'ArrowLeft':
                        e.preventDefault();
                        prevPage();
                        break;
                    case 'ArrowRight':
                        e.preventDefault();
                        nextPage();
                        break;
                    case '+':
                    case '=':
                        e.preventDefault();
                        zoomIn();
                        break;
                    case '-':
                        e.preventDefault();
                        zoomOut();
                        break;
                }
            }
        });

        // Close modal when clicking outside
        window.onclick = function(event) {
            const zoomModal = document.getElementById("zoomModal");
            const pdfModal = document.getElementById("pdfViewerModal");

            if (event.target == zoomModal) {
                zoomModal.style.display = "none";
            }
            if (event.target == pdfModal) {
                closePDFViewer();
            }
        }
    </script>
    <script>
        // Disable right-click context menu
        document.addEventListener('contextmenu', function(e) {
            e.preventDefault();
            return false;
        });

        // Disable text selection
        document.addEventListener('selectstart', function(e) {
            e.preventDefault();
            return false;
        });

        // Disable drag and drop for images
        document.addEventListener('dragstart', function(e) {
            if (e.target.tagName === 'IMG') {
                e.preventDefault();
                return false;
            }
        });

        // Disable keyboard shortcuts for saving, printing, etc.
        document.addEventListener('keydown', function(e) {
            // Disable F12 (Developer Tools)
            if (e.key === 'F12') {
                e.preventDefault();
                return false;
            }

            // Disable Ctrl+S (Save)
            if (e.ctrlKey && e.key === 's') {
                e.preventDefault();
                return false;
            }

            // Disable Ctrl+P (Print)
            if (e.ctrlKey && e.key === 'p') {
                e.preventDefault();
                return false;
            }
        });

        // Add CSS to prevent text selection
        const style = document.createElement('style');
        style.textContent = `
            body {
                -webkit-user-select: none;
                -moz-user-select: none;
                -ms-user-select: none;
                user-select: none;
            }

            /* Allow selection in form fields for editing */
            input, textarea, select {
                -webkit-user-select: text;
                -moz-user-select: text;
                -ms-user-select: text;
                user-select: text;
            }
        `;
        document.head.appendChild(style);
    </script>
</body>
</html>