        <div class="comments-modal-header" style="background: linear-gradient(135deg, #ff9800, #ff5722);">
            <h5 class="comments-modal-title"><i class="bi bi-arrow-clockwise me-2"></i>Retake Application Request</h5>
            <button class="comments-modal-close" onclick="closeRetakeModal()">&times;</button>
        </div>
        <div class="alert alert-warning mb-3" style="font-size: 0.9rem;">
            <i class="bi bi-info-circle me-2"></i>
