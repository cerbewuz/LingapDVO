                        <div class="invalid-feedback" id="supportingDocsError" style="display: none;">
                            Please select at least one supporting document.
                        </div>
                    </div>

                    <div class="row g-3 mt-3">
                        <div class="col-md-6">
                            <label class="form-label cmo-section-title">Amount Granted: <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" class="form-control" id="grantedAmountInput" required value="@(checkedCMO.ContainsKey("GrantedAmount") ? checkedCMO["GrantedAmount"] : "")">
                            <div class="invalid-feedback" id="grantedAmountError">
                                Please enter the amount granted.
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="cmo-processed-by">
                                <div>Processed by:</div>
                                <div>@(Context.Session.GetString("AdminFullname") ?? "Admin Name Not Found")</div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group" style="display: none">
                        <label class="form-label">CMO Reflection info:</label>
                        <input type="text" class="form-control" id="cmoReflectionField" placeholder="Auto-generated info..." value="@ViewData["ForCMOPERSONNEL"]">
                    </div>
                </div>
            </div>

            <!-- Valid ID and Submitted Documents Section -->
            <div class="receipt-section">
                <!-- Valid ID Section -->
                <div class="receipt-section">
                    <h5 class="section-header d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-shield-lock-fill me-2"></i>Valid ID (Encrypted)</span>
                        @* Button to decrypt/hide Valid ID with toggle functionality *@
                        @if (!string.IsNullOrEmpty(ViewData["Validfrontimage"]?.ToString()) || !string.IsNullOrEmpty(ViewData["ValidBackimage"]?.ToString()))
                        {
                            <button type="button" class="btn btn-sm btn-primary" id="viewValidIDBtn"
                                    onclick="toggleValidID('/Validimg/@ViewData["Validfrontimage"]', '/Validimg/@ViewData["ValidBackimage"]')"
                                    data-decrypted="false"
                                    title="Click to view/hide encrypted ID images">
                                <i class="bi bi-eye-fill me-1" id="validIDBtnIcon"></i>
                                <span id="validIDBtnText">View Valid ID</span>
                            </button>
                        }
                    </h5>

                    <!-- Encrypted ID Display (shown by default) -->
                    <div class="encrypted-info-section" id="validIDEncrypted">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <div class="info-label"><i class="bi bi-credit-card-2-front me-2"></i>Front ID (Encrypted):</div>
                                    <div class="encrypted-display">
                                        <i class="bi bi-file-earmark-lock me-2"></i>
                                        <span class="encrypted-text">@ViewData["Validfrontimage"]</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <div class="info-label"><i class="bi bi-credit-card-2-back me-2"></i>Back ID (Encrypted):</div>
                                    <div class="encrypted-display">
                                        <i class="bi bi-file-earmark-lock me-2"></i>
                                        <span class="encrypted-text">@ViewData["ValidBackimage"]</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Loading Container (shown while decrypting) -->
                    <div class="valid-id-loading" id="validIDLoading">
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-3">Decrypting ID images... Please wait</p>
                        </div>
                    </div>

                    <!-- Valid ID Container (hidden by default, shown after successful decryption) -->
                    <div class="valid-id-container" id="validIDContainer">
                        <div class="row">
                            <div class="col-md-6 mb-3" id="frontIDInlineContainer">
                                <h6><i class="bi bi-credit-card-2-front me-2"></i>Front ID</h6>
                                <img id="decryptedFrontIDInline" src="" alt="Front ID" class="id-image" style="display: none;" onclick="zoomImage(this.src)" />
                            </div>
                            <div class="col-md-6 mb-3" id="backIDInlineContainer">
                                <h6><i class="bi bi-credit-card-2-back me-2"></i>Back ID</h6>
                                <img id="decryptedBackIDInline" src="" alt="Back ID" class="id-image" style="display: none;" onclick="zoomImage(this.src)" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Doctor Prescription -->
                @if (ViewData["DoctorPrescriptionBase64"] != null)
                {
                    <div class="receipt-section">
                        <h5 class="section-header">Supporting Document</h5>
                        @if (ViewData["IsDoctorPrescriptionPdf"] != null && (bool)ViewData["IsDoctorPrescriptionPdf"])
                        {
                            <div class="pdf-preview-container" onclick="viewPDF('@ViewData["DoctorPrescription"]', 'doctorprescription', 'Doctor Prescription')">
                                <div class="pdf-preview">
                                    <div class="pdf-preview-icon">
                                        <i class="bi bi-file-earmark-pdf"></i>
                                    </div>
                                    <div class="pdf-preview-info">
                                        <span class="pdf-preview-filename">@ViewData["DoctorPrescription"]</span>
                                        <span class="pdf-preview-label">
                                            <i class="bi bi-eye"></i> Click to view full-screen PDF
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["DoctorPrescriptionBase64"]')">
                                <img src="data:image/jpeg;base64,@ViewData["DoctorPrescriptionBase64"]" alt="Doctor Prescription" class="id-image" />
                            </div>
                        }
                    </div>
                }

                <!-- Medical Certificate -->
                @if (ViewData["MedicalCertificateBase64"] != null)
                {
                    <div class="receipt-section">
                        <h5 class="section-header">Supporting Document</h5>
                        @if (ViewData["IsMedicalCertificatePdf"] != null && (bool)ViewData["IsMedicalCertificatePdf"])
                        {
                            <div class="pdf-preview-container" onclick="viewPDF('@ViewData["MedicalCertificate"]', 'medicalcertificate', 'Medical Certificate')">
                                <div class="pdf-preview">
                                    <div class="pdf-preview-icon">
                                        <i class="bi bi-file-earmark-pdf"></i>
                                    </div>
                                    <div class="pdf-preview-info">
                                        <span class="pdf-preview-filename">@ViewData["MedicalCertificate"]</span>
                                        <span class="pdf-preview-label">
                                            <i class="bi bi-eye"></i> Click to view full-screen PDF
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["MedicalCertificateBase64"]')">
                                <img src="data:image/jpeg;base64,@ViewData["MedicalCertificateBase64"]" alt="Medical Certificate" class="id-image" />
                            </div>
                        }
                    </div>
                }

                <!-- Death Certificate -->
                @if (ViewData["DeathCertificateBase64"] != null)
                {
                    <div class="receipt-section">
                        <h5 class="section-header">Supporting Document</h5>
                        @if (ViewData["IsDeathCertificatePdf"] != null && (bool)ViewData["IsDeathCertificatePdf"])
                        {
                            <div class="pdf-preview-container" onclick="viewPDF('@ViewData["DeathCertificate"]', 'deathcertificate', 'Death Certificate')">
                                <div class="pdf-preview">
                                    <div class="pdf-preview-icon">
                                        <i class="bi bi-file-earmark-pdf"></i>
                                    </div>
                                    <div class="pdf-preview-info">
                                        <span class="pdf-preview-filename">@ViewData["DeathCertificate"]</span>
                                        <span class="pdf-preview-label">
                                            <i class="bi bi-eye"></i> Click to view full-screen PDF
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["DeathCertificateBase64"]')">
                                <img src="data:image/jpeg;base64,@ViewData["DeathCertificateBase64"]" alt="Death Certificate" class="id-image" />
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Status Section -->
            <div class="receipt-section">
                <h5 class="section-header">Request Status</h5>
                <div class="info-row">
                    <div class="info-label">Current Status:</div>
                    <div class="info-value">
                        <span class="status-badge status-@(ViewData["Status"]?.ToString()?.ToLower())">
                            @ViewData["Status"]
                        </span>
                    </div>
                </div>

                <!-- Action Buttons - UPDATED to match first code (3 buttons) -->
                <div class="status-buttons">
                    <button type="button" class="btn btn-approved" onclick="submitApprove()">
                        <i class="bi bi-check-circle"></i> Approve
                    </button>
                    <button type="button" class="btn btn-warning" onclick="submitRetake()">
                        <i class="bi bi-arrow-clockwise"></i> Retake Application
                    </button>
                    <button type="button" class="btn btn-disapproved" onclick="showCommentsModal()">
                        <i class="bi bi-x-circle"></i> Disapprove
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        // PDF.js configuration
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

        // PDF Viewer variables (from first code)
        let pdfDocument = null;
        let currentPdfPage = 1;
        let totalPdfPages = 1;
        let pdfScale = 1.0;
        let currentFileName = '';
        let currentFileType = '';
        let currentDisplayName = '';

        // Image zoom function
        function zoomImage(src) {
            const modal = document.getElementById("zoomModal");
            const modalImg = document.getElementById("zoomedImage");
            if (modal && modalImg) {
                modal.style.display = "block";
                modalImg.src = src;
            }
        }

        // Close image zoom
        document.addEventListener('DOMContentLoaded', function() {
            const closeZoom = document.querySelector(".close-zoom");
            if (closeZoom) {
                closeZoom.onclick = function() {
                    const modal = document.getElementById("zoomModal");
                    if (modal) modal.style.display = "none";
                }
            }

            // Close on outside click
            window.onclick = function(event) {
                const modal = document.getElementById("zoomModal");
                if (event.target == modal && modal) {
                    modal.style.display = "none";
                }

                const pdfViewer = document.getElementById("pdfViewerOverlay");
                if (event.target == pdfViewer && pdfViewer) {
                    closePDFViewer();
                }
            }
        });

        // PDF Viewer functions (copied from first code)
        async function viewPDF(fileName, fileType, displayName) {
            currentFileName = fileName;
            currentFileType = fileType;
            currentDisplayName = displayName || fileName;

            // Show PDF viewer
            const overlay = document.getElementById("pdfViewerOverlay");
            const title = document.getElementById("pdfViewerTitle");
            const loadingOverlay = document.getElementById("pdfLoadingOverlay");
            const errorOverlay = document.getElementById("pdfErrorOverlay");

            if (!overlay || !title || !loadingOverlay || !errorOverlay) return;

            // Reset state
            pdfDocument = null;
            currentPdfPage = 1;
            totalPdfPages = 1;
            pdfScale = 1.0;

            // Update UI
            overlay.style.display = "block";
            document.body.style.overflow = "hidden"; // Prevent scrolling
            title.textContent = currentDisplayName;
            loadingOverlay.style.display = "flex";
            errorOverlay.style.display = "none";

            // Update controls
            updatePDFControls();

            try {
                // Build URL for PDF file
                const encodedFileName = encodeURIComponent(fileName);
                const url = '@Url.Action("ViewPDF", "Dashboard")?fileName=' + encodedFileName +
                           '&fileType=' + fileType + '&t=' + Date.now();

                // Load PDF document
                const loadingTask = pdfjsLib.getDocument(url);
                pdfDocument = await loadingTask.promise;
                totalPdfPages = pdfDocument.numPages;

                // Render first page
                await renderPDFPage(currentPdfPage);
                loadingOverlay.style.display = "none";

            } catch (error) {
                console.error("Error loading PDF:", error);
                loadingOverlay.style.display = "none";
                errorOverlay.style.display = "flex";
                document.getElementById("pdfErrorText").textContent =
                    `Error loading PDF: ${error.message || "Unknown error"}`;
            }
        }

        async function renderPDFPage(pageNum) {
            if (!pdfDocument || pageNum < 1 || pageNum > totalPdfPages) return;

            const canvas = document.getElementById("pdfCanvas");
            const ctx = canvas.getContext("2d");
            const container = document.getElementById("pdfCanvasContainer");

            if (!canvas || !ctx || !container) return;

            try {
                // Get page
                const page = await pdfDocument.getPage(pageNum);

                // Calculate viewport
                const viewport = page.getViewport({ scale: pdfScale });

                // Set canvas dimensions
                canvas.height = viewport.height;
                canvas.width = viewport.width;

                // Update container size
                container.style.width = viewport.width + "px";
                container.style.height = viewport.height + "px";

                // Render page
                const renderContext = {
                    canvasContext: ctx,
                    viewport: viewport
                };

                await page.render(renderContext).promise;

                // Update UI
                currentPdfPage = pageNum;
                updatePDFControls();

            } catch (error) {
                console.error("Error rendering PDF page:", error);
                showPDFError(`Error rendering page ${pageNum}: ${error.message}`);
            }
        }

        function updatePDFControls() {
            // Update page info
            const pageInfo = document.getElementById("pdfPageInfo");
            const zoomInfo = document.getElementById("pdfZoomInfo");
            const prevBtn = document.getElementById("pdfPrevBtn");
            const nextBtn = document.getElementById("pdfNextBtn");

            if (pageInfo) {
                pageInfo.textContent = `Page: ${currentPdfPage}/${totalPdfPages}`;
            }

            if (zoomInfo) {
                zoomInfo.textContent = `${Math.round(pdfScale * 100)}%`;
            }

            if (prevBtn) {
                prevBtn.disabled = currentPdfPage <= 1;
            }

            if (nextBtn) {
                nextBtn.disabled = currentPdfPage >= totalPdfPages;
            }
        }

        function pdfPrevPage() {
            if (currentPdfPage > 1) {
                currentPdfPage--;
                renderPDFPage(currentPdfPage);
            }
        }

        function pdfNextPage() {
            if (currentPdfPage < totalPdfPages) {
                currentPdfPage++;
                renderPDFPage(currentPdfPage);
            }
        }

        function pdfZoomIn() {
            pdfScale = Math.min(pdfScale + 0.1, 3.0); // Max zoom 300%
            renderPDFPage(currentPdfPage);
        }

        function pdfZoomOut() {
            pdfScale = Math.max(pdfScale - 0.1, 0.5); // Min zoom 50%
            renderPDFPage(currentPdfPage);
        }

        async function pdfFitWidth() {
            if (!pdfDocument) return;

            const canvas = document.getElementById("pdfCanvas");
            const container = document.getElementById("pdfCanvasContainer");
            if (!canvas || !container) return;

            try {
                const page = await pdfDocument.getPage(currentPdfPage);
                const viewport = page.getViewport({ scale: 1 });

                // Calculate scale to fit container width
                const containerWidth = container.parentElement.clientWidth - 40; // Account for padding
                pdfScale = containerWidth / viewport.width;

                // Clamp scale
                pdfScale = Math.max(0.5, Math.min(pdfScale, 3.0));

                renderPDFPage(currentPdfPage);

            } catch (error) {
                console.error("Error fitting to width:", error);
            }
        }

        async function pdfFitPage() {
            if (!pdfDocument) return;

            const canvas = document.getElementById("pdfCanvas");
            const container = document.getElementById("pdfCanvasContainer");
            if (!canvas || !container) return;

            try {
                const page = await pdfDocument.getPage(currentPdfPage);
                const viewport = page.getViewport({ scale: 1 });

                // Calculate scale to fit container
                const containerWidth = container.parentElement.clientWidth - 40;
                const containerHeight = container.parentElement.clientHeight - 40;

                const scaleX = containerWidth / viewport.width;
                const scaleY = containerHeight / viewport.height;

                pdfScale = Math.min(scaleX, scaleY);

                // Clamp scale
                pdfScale = Math.max(0.5, Math.min(pdfScale, 3.0));

                renderPDFPage(currentPdfPage);

            } catch (error) {
                console.error("Error fitting to page:", error);
            }
        }

        function showPDFError(message) {
            const errorOverlay = document.getElementById("pdfErrorOverlay");
            const errorText = document.getElementById("pdfErrorText");

            if (errorOverlay && errorText) {
                errorOverlay.style.display = "flex";
                errorText.textContent = message || "Error loading PDF";
            }
        }

        function retryPDFLoad() {
            if (currentFileName && currentFileType) {
                viewPDF(currentFileName, currentFileType, currentDisplayName);
            }
        }

        function closePDFViewer() {
            const overlay = document.getElementById("pdfViewerOverlay");
            if (overlay) {
                overlay.style.display = "none";
                document.body.style.overflow = ""; // Restore scrolling
            }

            // Clean up PDF document
            if (pdfDocument) {
                pdfDocument.destroy();
                pdfDocument = null;
            }
        }

        // Additional Information Functions
        function getOtherAssistanceFields() {
            const assistanceType = '@ViewData["Typeassistance"]';

            let fieldNames = [];
            let fieldLabels = [];
            let fieldValues = [];

            // Conditional fields based on assistance type
            if (assistanceType === 'Medicine Assistance') {
                fieldNames = ['MedicineName', 'MedicineQuantity', 'MedicineCost', 'PrescribingDoctor', 'DoctorContactDetail'];
                fieldLabels = ['Medicine Name', 'Medicine Quantity', 'Medicine Cost', 'Prescribing Doctor', 'Doctor Contact Detail'];
                fieldValues = [
                    '@ViewData["MedicineName"]',
                    '@ViewData["MedicineQuantity"]',
                    '@ViewData["MedicineCost"]',
                    '@ViewData["PrescribingDoctor"]',
                    '@ViewData["DoctorContactDetail"]'
                ];
            } else if (assistanceType === 'Laboratory/X-ray/ECG/2D Echo Assistance') {
                fieldNames = ['LaboratoryCenterName', 'LaboratoryCenterAddress', 'TestName', 'TestCost', 'TestOtherInfo'];
                fieldLabels = ['Laboratory Center Name', 'Laboratory Center Address', 'Test Name', 'Test Cost', 'Test Other Info'];
                fieldValues = [
                    '@ViewData["LaboratoryCenterName"]',
                    '@ViewData["LaboratoryCenterAddress"]',
                    '@ViewData["TestName"]',
                    '@ViewData["TestCost"]',
                    '@ViewData["TestOtherInfo"]'
                ];
            } else if (assistanceType === 'Therapy/Rehabilitation Assistance') {
                fieldNames = ['TherapyFacilityName', 'TherapyFacilityAddress', 'TherapyFacilityContact', 'TherapyType'];
                fieldLabels = ['Therapy Facility Name', 'Therapy Facility Address', 'Therapy Facility Contact', 'Therapy Type'];
                fieldValues = [
                    '@ViewData["TherapyFacilityName"]',
                    '@ViewData["TherapyFacilityAddress"]',
                    '@ViewData["TherapyFacilityContact"]',
                    '@ViewData["TherapyType"]'
                ];
            } else if (assistanceType === 'Medical Equipment/Apparatus Assistance') {
                fieldNames = ['EquipmentName', 'EquipmentBrand', 'EquipmentCategory', 'EquipmentQuantity', 'EquipmentCost'];
                fieldLabels = ['Equipment Name', 'Equipment Brand', 'Equipment Category', 'Equipment Quantity', 'Equipment Cost'];
                fieldValues = [
                    '@ViewData["EquipmentName"]',
                    '@ViewData["EquipmentBrand"]',
                    '@ViewData["EquipmentCategory"]',
                    '@ViewData["EquipmentQuantity"]',
                    '@ViewData["EquipmentCost"]'
                ];
            }

            return {
                names: fieldNames,
                labels: fieldLabels,
                values: fieldValues
            };
        }

        // Toggle function for Additional Information (View/Hide)
        function toggleAdditionalInfo() {
            const viewButton = document.getElementById('viewAdditionalInfoBtn');
            const isDecrypted = viewButton.getAttribute('data-decrypted') === 'true';

            if (isDecrypted) {
                // Currently showing decrypted data, hide it
                hideAdditionalInfo();
            } else {
                // Currently hidden, show the decrypt modal
                openViewAdditionalInfoModal('Other', '@ViewData["Id"]', getOtherAssistanceFields());
            }
        }

        // Function to hide additional information
        function hideAdditionalInfo() {
            const additionalInfoContainer = document.getElementById('additionalInfoContainer');
            const additionalInfoEncrypted = document.getElementById('additionalInfoEncrypted');
            const additionalInfoAlert = document.getElementById('additionalInfoAlert');
            const viewButton = document.getElementById('viewAdditionalInfoBtn');
            const btnIcon = document.getElementById('additionalBtnIcon');
            const btnText = document.getElementById('additionalBtnText');

            // Hide decrypted data container
            if (additionalInfoContainer) {
                additionalInfoContainer.classList.remove('additional-info-visible');
                additionalInfoContainer.style.display = 'none';
            }

            // Show encrypted data display
            if (additionalInfoEncrypted) {
                additionalInfoEncrypted.style.display = 'block';
            }

            // Show alert
            if (additionalInfoAlert) {
                additionalInfoAlert.style.display = 'flex';
            }

            // Update button to "View" state
            if (viewButton) {
                viewButton.setAttribute('data-decrypted', 'false');
                viewButton.classList.remove('btn-warning');
                viewButton.classList.add('btn-primary');
            }
            if (btnIcon) {
                btnIcon.classList.remove('bi-eye-slash-fill');
                btnIcon.classList.add('bi-eye-fill');
            }
            if (btnText) {
                btnText.textContent = 'View Additional Information';
            }

            // Clear decrypted data
            window.decryptedAdditionalData = {};
        }

        // Function to show additional information after successful decryption - REMOVED LOADING DELAY
        function showAdditionalInfoAfterDecryption() {
            console.log('Showing additional information after decryption...');

            // Hide the encrypted display section
            const additionalInfoEncrypted = document.getElementById('additionalInfoEncrypted');
            if (additionalInfoEncrypted) {
                additionalInfoEncrypted.style.display = 'none';
            }

            // Hide alert
            const additionalInfoAlert = document.getElementById('additionalInfoAlert');
            if (additionalInfoAlert) {
                additionalInfoAlert.style.display = 'none';
            }

            // Show the additional information container (decrypted) immediately
            const additionalInfoContainer = document.getElementById('additionalInfoContainer');
            if (additionalInfoContainer) {
                additionalInfoContainer.style.display = 'block';
                additionalInfoContainer.classList.add('additional-info-visible', 'decrypted-display');

                // Scroll to the additional information section
                setTimeout(() => {
                    additionalInfoContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 100);
            }

            // Update button to "Hide" state
            const viewButton = document.getElementById('viewAdditionalInfoBtn');
            const btnIcon = document.getElementById('additionalBtnIcon');
            const btnText = document.getElementById('additionalBtnText');

            if (viewButton) {
                viewButton.setAttribute('data-decrypted', 'true');
                viewButton.classList.remove('btn-primary');
                viewButton.classList.add('btn-warning');
            }
            if (btnIcon) {
                btnIcon.classList.remove('bi-eye-fill');
                btnIcon.classList.add('bi-eye-slash-fill');
            }
            if (btnText) {
                btnText.textContent = 'Hide Additional Information';
            }
        }

        // IMPORTANT: This function is called from the shared modal after successful decryption
        window.onAdditionalInfoDecrypted = function() {
            // Show decrypted data immediately - no loading delay
            showAdditionalInfoAfterDecryption();
        };

        // Initialize page
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize button state
            const viewButton = document.getElementById('viewAdditionalInfoBtn');
            if (viewButton) {
                viewButton.setAttribute('data-decrypted', 'false');
            }

            // Make sure the encrypted section is visible by default
            const additionalInfoEncrypted = document.getElementById('additionalInfoEncrypted');
            const additionalInfoContainer = document.getElementById('additionalInfoContainer');
            const additionalInfoAlert = document.getElementById('additionalInfoAlert');

            if (additionalInfoEncrypted) additionalInfoEncrypted.style.display = 'block';
            if (additionalInfoContainer) additionalInfoContainer.style.display = 'none';
            if (additionalInfoAlert) additionalInfoAlert.style.display = 'flex';

            // Initialize Valid ID visibility
            const validIDEncrypted = document.getElementById('validIDEncrypted');
            const validIDContainer = document.getElementById('validIDContainer');
            const validIDLoading = document.getElementById('validIDLoading');

            if (validIDEncrypted) validIDEncrypted.style.display = 'block';
            if (validIDContainer) validIDContainer.style.display = 'none';
            if (validIDLoading) validIDLoading.style.display = 'none';

            // Initialize CMO functionality
            initializeCMOFunctionality();
        });

        // Status Submission Functions (UPDATED to match first code)
        function submitApprove() {
            console.log('Submitting approve...');

            // Validate the CMO form first
            if (!validateCMOForm()) {
                return; // Stop if validation fails
            }

            // Update hidden fields
            updateHiddenFields();

            // Set the status and comments
            const statusInput = document.getElementById('statusInput');
            const commentsInput = document.getElementById('commentsInput');
            if (statusInput) statusInput.value = 'Approve';
            if (commentsInput) commentsInput.value = ''; // Empty comments for approval

            console.log('Status set to:', statusInput ? statusInput.value : 'N/A');
            console.log('Comments:', commentsInput ? commentsInput.value : 'N/A');
            console.log('CMO Reflection:', document.getElementById('forCMOPersonnelInput') ? document.getElementById('forCMOPersonnelInput').value : 'N/A');

            // Show loading modal
            showSuccessModal();

            // Submit the form after a short delay to show the modal
            setTimeout(() => {
                console.log('Final form submission - Approve');
                const form = document.getElementById('statusForm');
                if (form) {
                    console.log('Submitting form...');
                    form.submit();
                } else {
                    console.error('Form not found!');
                }
            }, 1500);
        }

        function showCommentsModal() {
            // No validation needed for Disapprove - just show the modal
            const modal = document.getElementById('commentsModal');
            const textarea = document.getElementById('commentsTextarea');
            if (modal) modal.style.display = 'block';
            if (textarea) textarea.focus();
        }

        function closeCommentsModal() {
            const modal = document.getElementById('commentsModal');
            const textarea = document.getElementById('commentsTextarea');
            if (modal) modal.style.display = 'none';
            if (textarea) {
                textarea.value = '';
                textarea.classList.remove('is-invalid');
            }
        }

        function submitDisapproveWithComments() {
            const commentsTextarea = document.getElementById('commentsTextarea');
            const comments = commentsTextarea ? commentsTextarea.value.trim() : '';

            if (comments === '') {
                if (commentsTextarea) {
                    commentsTextarea.classList.add('is-invalid');
                    commentsTextarea.focus();
                }
                return;
            }

            console.log('Submitting disapprove...');

            // Update hidden fields
            updateHiddenFields();

            const statusInput = document.getElementById('statusInput');
            const commentsInput = document.getElementById('commentsInput');
            if (statusInput) statusInput.value = 'Disapprove';
            if (commentsInput) commentsInput.value = comments;

            console.log('Status set to:', statusInput ? statusInput.value : 'N/A');
            console.log('Comments:', commentsInput ? commentsInput.value : 'N/A');

            // Close comments modal and show success modal
            closeCommentsModal();
            showSuccessModal();

            // Submit the form after a short delay
            setTimeout(() => {
                console.log('Final form submission - Disapprove');
                const form = document.getElementById('statusForm');
                if (form) {
                    console.log('Submitting form...');
                    form.submit();
                } else {
                    console.error('Form not found!');
                }
            }, 1500);
        }

        function submitRetake() {
            // No validation needed for Retake - just show the modal
            const modal = document.getElementById('retakeModal');
            const textarea = document.getElementById('retakeReasonTextarea');
            if (modal) modal.style.display = 'block';
            if (textarea) textarea.focus();
        }

        function closeRetakeModal() {
            const modal = document.getElementById('retakeModal');
            const textarea = document.getElementById('retakeReasonTextarea');
            const errorSpan = document.getElementById('retakeReasonError');
            if (modal) modal.style.display = 'none';
            if (textarea) {
                textarea.value = '';
                textarea.classList.remove('is-invalid');
            }
            if (errorSpan) errorSpan.style.display = 'none';
        }

        function confirmRetake() {
            const retakeReasonTextarea = document.getElementById('retakeReasonTextarea');
            const retakeReason = retakeReasonTextarea ? retakeReasonTextarea.value.trim() : '';
            const retakeReasonError = document.getElementById('retakeReasonError');

            // Validate that reason is provided and meets minimum length
            if (retakeReason === '' || retakeReason.length < 10) {
                if (retakeReasonTextarea) {
                    retakeReasonTextarea.classList.add('is-invalid');
                }
                if (retakeReasonError) {
                    retakeReasonError.style.display = 'block';
                }
                if (retakeReasonTextarea) retakeReasonTextarea.focus();
                return;
            }

            console.log('Submitting retake with reason...');

            // Update hidden fields
            updateHiddenFields();

            // Set status to Retake and add the reason to comments
            const statusInput = document.getElementById('statusInput');
            const commentsInput = document.getElementById('commentsInput');
            if (statusInput) statusInput.value = 'Retake';
            if (commentsInput) commentsInput.value = 'RETAKE REQUEST: ' + retakeReason;

            console.log('Status set to:', statusInput ? statusInput.value : 'N/A');
            console.log('Comments:', commentsInput ? commentsInput.value : 'N/A');

            // Close retake modal and show success modal
            closeRetakeModal();
            showSuccessModal();

            // Submit the form after a short delay
            setTimeout(() => {
                console.log('Final form submission - Retake');
                const form = document.getElementById('statusForm');
                if (form) {
                    console.log('Submitting form...');
                    form.submit();
                } else {
                    console.error('Form not found!');
                }
            }, 1500);
        }

        function showSuccessModal() {
            const modal = document.getElementById('successModal');
            if (modal) modal.style.display = 'block';

            // Auto-redirect after 3 seconds in case form submission fails
            setTimeout(() => {
                window.location.href = '/Admin';
            }, 3000);
        }

        // Function to toggle Valid ID view
        function toggleValidID(frontImagePath, backImagePath) {
            const viewButton = document.getElementById('viewValidIDBtn');
            const isDecrypted = viewButton.getAttribute('data-decrypted') === 'true';

            if (isDecrypted) {
                // Currently showing decrypted data, hide it
                hideValidID();
            } else {
                // Currently hidden, show the decrypt modal for ID
                openViewIDModal('@ViewData["Id"]', frontImagePath, backImagePath);
            }
        }

        // Function to hide Valid ID
        function hideValidID() {
            const validIDContainer = document.getElementById('validIDContainer');
            const validIDEncrypted = document.getElementById('validIDEncrypted');
            const viewButton = document.getElementById('viewValidIDBtn');
            const btnIcon = document.getElementById('validIDBtnIcon');
            const btnText = document.getElementById('validIDBtnText');

            // Hide decrypted ID container
            if (validIDContainer) {
                validIDContainer.style.display = 'none';
            }

            // Show encrypted ID display
            if (validIDEncrypted) {
                validIDEncrypted.style.display = 'block';
            }

            // Update button to "View" state
            if (viewButton) {
                viewButton.setAttribute('data-decrypted', 'false');
                viewButton.classList.remove('btn-warning');
                viewButton.classList.add('btn-primary');
            }
            if (btnIcon) {
                btnIcon.classList.remove('bi-eye-slash-fill');
                btnIcon.classList.add('bi-eye-fill');
            }
            if (btnText) {
                btnText.textContent = 'View Valid ID';
            }
        }

        // Function to show Valid ID after successful decryption
        window.onValidIDDecrypted = function(frontImageData, backImageData) {
            console.log('Showing Valid ID after decryption...');

            // Hide the loading container
            const loadingContainer = document.getElementById('validIDLoading');
            if (loadingContainer) {
                loadingContainer.style.display = 'none';
            }

            // Hide the encrypted display section
            const validIDEncrypted = document.getElementById('validIDEncrypted');
            if (validIDEncrypted) {
                validIDEncrypted.style.display = 'none';
            }

            // Show the Valid ID container (decrypted)
            const validIDContainer = document.getElementById('validIDContainer');
            const frontImage = document.getElementById('decryptedFrontIDInline');
            const backImage = document.getElementById('decryptedBackIDInline');
            const frontContainer = document.getElementById('frontIDInlineContainer');
            const backContainer = document.getElementById('backIDInlineContainer');

            if (validIDContainer && frontImage && backImage && frontContainer && backContainer) {
                // Set the image sources
                if (frontImageData) {
                    frontImage.src = 'data:image/jpeg;base64,' + frontImageData;
                    frontImage.style.display = 'block';
                    frontContainer.style.display = 'block';
                } else {
                    frontContainer.style.display = 'none';
                }

                if (backImageData) {
                    backImage.src = 'data:image/jpeg;base64,' + backImageData;
                    backImage.style.display = 'block';
                    backContainer.style.display = 'block';
                } else {
                    backContainer.style.display = 'none';
                }

                // Show the container
                validIDContainer.style.display = 'block';
                validIDContainer.classList.add('valid-id-container');

                // Scroll to the Valid ID section
                setTimeout(() => {
                    validIDContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 100);
            }

            // Update button to "Hide" state
            const viewButton = document.getElementById('viewValidIDBtn');
            const btnIcon = document.getElementById('validIDBtnIcon');
            const btnText = document.getElementById('validIDBtnText');

            if (viewButton) {
                viewButton.setAttribute('data-decrypted', 'true');
                viewButton.classList.remove('btn-primary');
                viewButton.classList.add('btn-warning');
            }
            if (btnIcon) {
                btnIcon.classList.remove('bi-eye-fill');
                btnIcon.classList.add('bi-eye-slash-fill');
            }
            if (btnText) {
                btnText.textContent = 'Hide Valid ID';
            }
        };

        // Function to show loading for Valid ID
        function startValidIDLoading() {
            console.log('Starting Valid ID loading...');

            // Show loading container
            const loadingContainer = document.getElementById('validIDLoading');
            if (loadingContainer) {
                loadingContainer.style.display = 'block';
            }

            // Hide encrypted display
            const validIDEncrypted = document.getElementById('validIDEncrypted');
            if (validIDEncrypted) {
                validIDEncrypted.style.display = 'none';
            }

            // Hide any existing Valid ID container
            const validIDContainer = document.getElementById('validIDContainer');
            if (validIDContainer) {
                validIDContainer.style.display = 'none';
            }
        }

        // CMO Functions
        function initializeCMOFunctionality() {
            // Initialize Others checkbox visibility
            toggleOthersInput();

            // Add change event listener to Others checkbox
            const othersCheckbox = document.getElementById('othersCheckbox');
            if (othersCheckbox) {
                othersCheckbox.addEventListener('change', function() {
                    toggleOthersInput();
                    updateReflection();
                });
            }

            // Add event listeners for inputs
            const grantedAmountInput = document.getElementById('grantedAmountInput');
            const cmoNotes = document.getElementById('cmoNotesInput');

            if (grantedAmountInput) grantedAmountInput.addEventListener('input', updateReflection);
            if (cmoNotes) cmoNotes.addEventListener('input', updateReflection);

            // Add event listeners to all supporting document checkboxes
            const supportingDocCheckboxes = document.querySelectorAll('.supporting-doc');
            supportingDocCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', updateReflection);
            });

            // Initialize reflection field on page load
            updateReflection();
        }

        // CMO Others input toggle
        function toggleOthersInput() {
            const othersCheckbox = document.getElementById('othersCheckbox');
            const othersRow = document.getElementById('cmoOthersRow');
            const cmoNotesInput = document.getElementById('cmoNotesInput');

            if (!othersCheckbox || !othersRow || !cmoNotesInput) return;

            if (othersCheckbox.checked) {
                othersRow.style.display = 'flex';
                cmoNotesInput.required = true;
            } else {
                othersRow.style.display = 'none';
                cmoNotesInput.required = false;
                cmoNotesInput.classList.remove('is-invalid');
            }
        }

        // Update CMO Reflection
        function updateReflection() {
            const grantedAmountInput = document.getElementById('grantedAmountInput');
            const cmoNotes = document.getElementById('cmoNotesInput');
            const reflectionField = document.getElementById('cmoReflectionField');
            const forCMOPersonnelInput = document.getElementById('forCMOPersonnelInput');
            const docCheckboxes = document.querySelectorAll('.supporting-doc:checked');

            let parts = [];

            // Add granted amount if exists
            if (grantedAmountInput && grantedAmountInput.value.trim()) {
                parts.push(`GrantedAmount: ${grantedAmountInput.value.trim()}`);
            }

            // Add checked documents
            const checkedDocs = Array.from(docCheckboxes).map(cb => {
                if (cb.value === 'Others' && cmoNotes && cmoNotes.value.trim()) {
                    return `Others: ${cmoNotes.value.trim()}`;
                }
                return cb.value;
            });

            if (checkedDocs.length > 0) {
                parts.push(`Docs: ${checkedDocs.join(', ')}`);
            }

            const reflectionValue = parts.join(' , ');
            if (reflectionField) reflectionField.value = reflectionValue;

            // Update the hidden field as well
            if (forCMOPersonnelInput) forCMOPersonnelInput.value = reflectionValue;

            console.log('CMO Reflection updated:', reflectionValue);
            return reflectionValue;
        }

        // Update hidden fields before submission
        function updateHiddenFields() {
            // Update CMO reflection
            updateReflection();

            // Update granted amount
            const grantedAmountInput = document.getElementById('grantedAmountInput');
            const grantedAmountField = document.getElementById('grantedAmountField');
            if (grantedAmountInput && grantedAmountField) {
                grantedAmountField.value = grantedAmountInput.value;
            }

            // Update supporting docs
            const supportingDocs = document.querySelectorAll('.supporting-doc:checked');
            const supportingDocsField = document.getElementById('supportingDocsField');
            if (supportingDocsField) {
                const docValues = Array.from(supportingDocs).map(cb => cb.value);
                supportingDocsField.value = docValues.join(',');
            }

            // Update CMO notes
            const cmoNotesInput = document.getElementById('cmoNotesInput');
            const cmoNotesField = document.getElementById('cmoNotesField');
            if (cmoNotesInput && cmoNotesField) {
                cmoNotesField.value = cmoNotesInput.value;
            }
        }

        // Get all selected supporting documents including "Others"
        function getSelectedSupportingDocs() {
            const supportingDocs = document.querySelectorAll('.supporting-doc:checked');
            const docValues = [];

            supportingDocs.forEach(checkbox => {
                if (checkbox.value === 'Others') {
                    const cmoNotesInput = document.getElementById('cmoNotesInput');
                    if (cmoNotesInput && cmoNotesInput.value.trim()) {
                        docValues.push(`Others: ${cmoNotesInput.value.trim()}`);
                    } else {
                        docValues.push('Others');
                    }
                } else {
                    docValues.push(checkbox.value);
                }
            });

            return docValues;
        }

        // Form Validation Function
        function validateCMOForm() {
            let isValid = true;
            let errorMessages = [];

            // Reset previous errors
            document.getElementById('supportingDocsError').style.display = 'none';
            document.getElementById('cmoNotesInput').classList.remove('is-invalid');
            document.getElementById('grantedAmountInput').classList.remove('is-invalid');
            document.getElementById('grantedAmountError').style.display = 'none';

            // Validate supporting documents - includes "Others" checkbox
            const supportingDocs = document.querySelectorAll('.supporting-doc:checked');
            if (supportingDocs.length === 0) {
                isValid = false;
                document.getElementById('supportingDocsError').style.display = 'block';
                errorMessages.push('Please select at least one supporting document.');
            }

            // Validate CMO Notes if Others checkbox is checked
            const othersCheckbox = document.getElementById('othersCheckbox');
            const cmoNotesInput = document.getElementById('cmoNotesInput');
            if (othersCheckbox && othersCheckbox.checked) {
                if (!cmoNotesInput || !cmoNotesInput.value.trim()) {
                    isValid = false;
                    cmoNotesInput.classList.add('is-invalid');
                    errorMessages.push('Please specify the other documents when "Others" is selected.');
                }
            }

            // Validate Amount Granted
            const grantedAmountInput = document.getElementById('grantedAmountInput');
            if (!grantedAmountInput.value || parseFloat(grantedAmountInput.value) <= 0) {
                isValid = false;
                grantedAmountInput.classList.add('is-invalid');
                document.getElementById('grantedAmountError').style.display = 'block';
                errorMessages.push('Please enter a valid amount granted (must be greater than 0).');
            }

            // Show errors if any
            if (!isValid) {
                const cmoSection = document.querySelector('.cmo-details');
                if (cmoSection) {
                    cmoSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
                alert('Please fix the following errors:\n\n' + errorMessages.join('\n'));
            }

            return isValid;
        }

        // Function to handle single checkbox selection
        function handleSingleCheckboxSelection(event) {
            const clickedCheckbox = event.target;

            // If the clicked checkbox is being checked
            if (clickedCheckbox.checked) {
                // Uncheck all other single-doc checkboxes
                const allCheckboxes = document.querySelectorAll('.single-doc');
                allCheckboxes.forEach(checkbox => {
                    if (checkbox !== clickedCheckbox) {
                        checkbox.checked = false;
                    }
                });

                // Hide any error message
                hideSingleDocError();

                // If "Others" is checked, show the input field
                if (clickedCheckbox.id === 'othersCheckbox') {
                    document.getElementById('cmoOthersRow').style.display = 'flex';
                    document.getElementById('cmoNotesInput').required = true;
                } else {
                    // If another checkbox is checked, hide the Others input field
                    document.getElementById('cmoOthersRow').style.display = 'none';
                    document.getElementById('cmoNotesInput').required = false;
                    document.getElementById('cmoNotesInput').classList.remove('is-invalid');
                }
            }
            // If the clicked checkbox is being unchecked, don't allow it if it's the only one checked
            else {
                const checkedCheckboxes = document.querySelectorAll('.single-doc:checked');
                if (checkedCheckboxes.length === 0) {
                    // Don't allow unchecking if it would leave none checked
                    clickedCheckbox.checked = true;
                    showSingleDocError("You must select at least one document.");
                }
            }

            // Update CMO reflection
            updateReflection();
        }

        // Function to show single document error
        function showSingleDocError(message = "Only one document can be selected at a time. Please choose only one supporting document.") {
            const errorDiv = document.getElementById('singleDocError');
            if (errorDiv) {
                errorDiv.innerHTML = `<i class="bi bi-exclamation-triangle me-2"></i>${message}`;
                errorDiv.style.display = 'block';
            }
        }

        // Function to hide single document error
        function hideSingleDocError() {
            const errorDiv = document.getElementById('singleDocError');
            if (errorDiv) {
                errorDiv.style.display = 'none';
            }
        }

        // Function to validate single document selection
        function validateSingleDocument() {
            const checkedCheckboxes = document.querySelectorAll('.single-doc:checked');

            if (checkedCheckboxes.length === 0) {
                showSingleDocError("Please select at least one supporting document.");
                return false;
            }

            if (checkedCheckboxes.length > 1) {
                showSingleDocError();
                return false;
            }

            // Validate "Others" field if "Others" is selected
            const othersCheckbox = document.getElementById('othersCheckbox');
            const cmoNotesInput = document.getElementById('cmoNotesInput');
            if (othersCheckbox && othersCheckbox.checked) {
                if (!cmoNotesInput.value.trim()) {
                    cmoNotesInput.classList.add('is-invalid');
                    showSingleDocError("Please specify the other documents when 'Others' is selected.");
                    return false;
                }
            }

            return true;
        }

        // Update the validation function to use single document validation
        document.addEventListener('DOMContentLoaded', function() {
            // Add event listeners to all single-doc checkboxes
            const singleDocCheckboxes = document.querySelectorAll('.single-doc');
            singleDocCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', handleSingleCheckboxSelection);
            });

            // Initialize Others field visibility
            const othersCheckbox = document.getElementById('othersCheckbox');
            if (othersCheckbox && othersCheckbox.checked) {
                document.getElementById('cmoOthersRow').style.display = 'flex';
            }

            // Update form validation to use single document validation
            window.validateCMOForm = function() {
                // Reset errors
                document.getElementById('supportingDocsError').style.display = 'none';
                document.getElementById('grantedAmountInput').classList.remove('is-invalid');
                document.getElementById('grantedAmountError').style.display = 'none';

                // Validate single document
                if (!validateSingleDocument()) {
                    const cmoSection = document.querySelector('.cmo-details');
                    if (cmoSection) {
                        cmoSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                    return false;
                }

                // Validate amount granted
                const grantedAmountInput = document.getElementById('grantedAmountInput');
                if (!grantedAmountInput.value || parseFloat(grantedAmountInput.value) <= 0) {
                    grantedAmountInput.classList.add('is-invalid');
                    document.getElementById('grantedAmountError').style.display = 'block';
                    const cmoSection = document.querySelector('.cmo-details');
                    if (cmoSection) {
                        cmoSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                    alert('Please enter a valid amount granted (must be greater than 0).');
                    return false;
                }

                return true;
            };
        });

        // Keyboard shortcuts for PDF viewer (from first code)
        document.addEventListener('keydown', function(e) {
            const pdfViewer = document.getElementById("pdfViewerOverlay");
            if (!pdfViewer || pdfViewer.style.display !== "block") return;

            switch(e.key) {
                case 'Escape':
                    closePDFViewer();
                    e.preventDefault();
                    break;
                case 'ArrowLeft':
                    pdfPrevPage();
                    e.preventDefault();
                    break;
                case 'ArrowRight':
                    pdfNextPage();
                    e.preventDefault();
                    break;
                case '+':
                case '=':
                    if (e.ctrlKey || e.metaKey) {
                        pdfZoomIn();
                        e.preventDefault();
                    }
                    break;
                case '-':
                    if (e.ctrlKey || e.metaKey) {
                        pdfZoomOut();
                        e.preventDefault();
                    }
                    break;
                case '0':
                    if (e.ctrlKey || e.metaKey) {
                        pdfScale = 1.0;
                        renderPDFPage(currentPdfPage);
                        e.preventDefault();
                    }
                    break;
                case 'Home':
                    currentPdfPage = 1;
                    renderPDFPage(currentPdfPage);
                    e.preventDefault();
                    break;
                case 'End':
                    currentPdfPage = totalPdfPages;
                    renderPDFPage(currentPdfPage);
                    e.preventDefault();
                    break;
            }
        });

        // Touch gestures for mobile (from first code)
        let touchStartX = 0;
        let touchStartY = 0;

        document.addEventListener('touchstart', function(e) {
            const pdfViewer = document.getElementById("pdfViewerOverlay");
            if (!pdfViewer || pdfViewer.style.display !== "block") return;

            touchStartX = e.touches[0].clientX;
            touchStartY = e.touches[0].clientY;
        });

        document.addEventListener('touchend', function(e) {
            const pdfViewer = document.getElementById("pdfViewerOverlay");
            if (!pdfViewer || pdfViewer.style.display !== "block") return;

            const touchEndX = e.changedTouches[0].clientX;
            const touchEndY = e.changedTouches[0].clientY;
            const diffX = touchStartX - touchEndX;
            const diffY = touchStartY - touchEndY;

            // Horizontal swipe for page navigation (min 50px swipe)
            if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 50) {
                if (diffX > 0) {
                    // Swipe left - next page
                    pdfNextPage();
                } else {
                    // Swipe right - previous page
                    pdfPrevPage();
                }
            }
        });

        // Add resize handler for responsive PDF viewer (from first code)
        window.addEventListener('resize', function() {
            const pdfViewer = document.getElementById("pdfViewerOverlay");
            if (pdfViewer && pdfViewer.style.display === "block" && pdfDocument) {
                // Re-render current page on resize
                renderPDFPage(currentPdfPage);
            }
        });

        // Close modals when clicking outside
        window.addEventListener('click', function(event) {
            const commentsModal = document.getElementById('commentsModal');
            const retakeModal = document.getElementById('retakeModal');
            const successModal = document.getElementById('successModal');

            if (event.target === commentsModal) {
                closeCommentsModal();
            }
            if (event.target === retakeModal) {
                closeRetakeModal();
            }
            if (event.target === successModal) {
                successModal.style.display = 'none';
            }
        });
    </script>

