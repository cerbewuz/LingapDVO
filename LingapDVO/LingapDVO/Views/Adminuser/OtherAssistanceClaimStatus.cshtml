            <!-- Status Section -->
            <div class="receipt-section">
                <h5 class="section-header">Request Status</h5>
                <div class="info-row">
                    <div class="info-label">Current Status:</div>
                    <div class="info-value">
                        <span class="status-badge status-@(ViewData["Status3"]?.ToString()?.ToLower())">
                            @ViewData["Status3"]
                        </span>
                    </div>
