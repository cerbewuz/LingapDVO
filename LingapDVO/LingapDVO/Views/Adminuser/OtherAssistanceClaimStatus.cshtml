    </form>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        // Configure PDF.js worker
        if (typeof pdfjsLib !== 'undefined') {
            pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
        }

        // PDF Viewer Variables
        let currentPDF = null;
        let currentPage = 1;
        let totalPages = 1;
        let currentScale = 1.2;

        // Requestor's Name Variables
        const requestorFirstname = '@ViewData["RFirstname"]';
        const requestorMiddlename = '@ViewData["RMiddlename"]';
        const requestorLastname = '@ViewData["RLastname"]';
        const requestorSuffix = '@ViewData["RSuffix"]';
        const requestorFullName = `${requestorFirstname} ${requestorMiddlename} ${requestorLastname}${requestorSuffix && requestorSuffix !== 'None' ? ' ' + requestorSuffix : ''}`.trim().replace(/\s+/g, ' ');

        // Assistance Type
        const assistanceType = '@ViewData["Typeassistance"]';

        // Image Zoom Functionality
        function zoomImage(src) {
            const modal = document.getElementById("zoomModal");
            const modalImg = document.getElementById("zoomedImage");
            if (modal && modalImg) {
                modal.style.display = "block";
                modalImg.src = src;
            }
        }

        // Close zoom modal
        document.addEventListener('DOMContentLoaded', function() {
            const closeZoom = document.querySelector(".close-zoom");
            if (closeZoom) {
                closeZoom.onclick = function() {
                    const modal = document.getElementById("zoomModal");
                    if (modal) modal.style.display = "none";
                }
            }
        });

        // PDF Viewer Function
        async function viewPDFInModal(fileName, fileType, displayName) {
            const modal = document.getElementById('pdfViewerModal');
            const title = document.getElementById('pdfViewerTitle');
            const loading = document.getElementById('pdfLoading');
            const errorDiv = document.getElementById('pdfError');
            const canvas = document.getElementById('pdfCanvas');
            const context = canvas ? canvas.getContext('2d') : null;
            const currentPageSpan = document.getElementById('currentPage');
            const totalPagesSpan = document.getElementById('totalPages');
            const zoomLevelSpan = document.getElementById('zoomLevel');
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');

            if (!modal || !title || !loading || !errorDiv || !canvas || !context) {
                console.error('PDF viewer elements not found');
                return;
            }

            title.textContent = displayName || 'PDF Document';
            modal.style.display = 'block';
            loading.style.display = 'flex';
            errorDiv.style.display = 'none';
            canvas.style.display = 'none';

            currentPDF = null;
            currentPage = 1;
            currentScale = 1.2;

            try {
                const encodedFileName = encodeURIComponent(fileName);
                const url = '@Url.Action("ViewPDF", "Dashboard")?fileName=' + encodedFileName + '&fileType=' + fileType + '&t=' + Date.now();

                const response = await fetch(url);
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const pdfData = await response.arrayBuffer();
                if (!pdfData || pdfData.byteLength === 0) {
                    throw new Error('PDF data is empty');
                }

                const loadingTask = pdfjsLib.getDocument({ data: pdfData });
                currentPDF = await loadingTask.promise;

                totalPages = currentPDF.numPages;
                if (totalPagesSpan) totalPagesSpan.textContent = totalPages;
                if (currentPageSpan) currentPageSpan.textContent = currentPage;

                updateNavigationButtons();
                await renderPage(currentPage);

                loading.style.display = 'none';
                canvas.style.display = 'block';
                if (zoomLevelSpan) zoomLevelSpan.textContent = Math.round(currentScale * 100) + '%';

            } catch (error) {
                console.error('Error loading PDF:', error);
                loading.style.display = 'none';
                errorDiv.style.display = 'block';
                if (errorDiv.querySelector('p')) {
                    errorDiv.querySelector('p').textContent = `Error loading PDF: ${error.message}`;
                }
            }
        }

        // Render specific page
        async function renderPage(pageNum) {
            if (!currentPDF) return;

            const canvas = document.getElementById('pdfCanvas');
            const context = canvas.getContext('2d');
            const currentPageSpan = document.getElementById('currentPage');

            if (!canvas || !context) return;

            try {
                const page = await currentPDF.getPage(pageNum);
                const viewport = page.getViewport({ scale: currentScale });

                canvas.height = viewport.height;
                canvas.width = viewport.width;

                const renderContext = {
                    canvasContext: context,
                    viewport: viewport
                };

                await page.render(renderContext).promise;
                if (currentPageSpan) currentPageSpan.textContent = pageNum;

            } catch (error) {
                console.error('Error rendering page:', error);
            }
        }

        // Navigation functions
        function nextPage() {
            if (currentPage < totalPages) {
                currentPage++;
                renderPage(currentPage);
                updateNavigationButtons();
            }
        }

        function prevPage() {
            if (currentPage > 1) {
                currentPage--;
                renderPage(currentPage);
                updateNavigationButtons();
            }
        }

        function zoomIn() {
            currentScale += 0.2;
            renderPage(currentPage);
            const zoomLevelSpan = document.getElementById('zoomLevel');
            if (zoomLevelSpan) zoomLevelSpan.textContent = Math.round(currentScale * 100) + '%';
        }

        function zoomOut() {
            if (currentScale > 0.5) {
                currentScale -= 0.2;
                renderPage(currentPage);
                const zoomLevelSpan = document.getElementById('zoomLevel');
                if (zoomLevelSpan) zoomLevelSpan.textContent = Math.round(currentScale * 100) + '%';
            }
        }

        function updateNavigationButtons() {
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');

            if (prevBtn) prevBtn.disabled = currentPage <= 1;
            if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
        }

        // Close PDF Viewer
        function closePDFViewer() {
            const modal = document.getElementById('pdfViewerModal');
            if (modal) {
                modal.style.display = 'none';
            }

            if (currentPDF) {
                currentPDF.destroy();
                currentPDF = null;
            }
        }

        // ==================== ADDITIONAL INFORMATION FUNCTIONS ====================
        function getOtherAssistanceFields() {
            const assistanceType = '@ViewData["Typeassistance"]';

            let fieldNames = [];
            let fieldLabels = [];
            let fieldValues = [];
            let fieldIcons = [];

            // Conditional fields based on assistance type
            if (assistanceType === 'Medicine Assistance') {
                fieldNames = ['MedicineName', 'MedicineQuantity', 'MedicineCost', 'PrescribingDoctor', 'DoctorContactDetail'];
                fieldLabels = ['Medicine Name', 'Quantity', 'Cost', 'Prescribing Doctor', 'Doctor Contact'];
                fieldValues = [
                    '@ViewData["MedicineName"]',
                    '@ViewData["MedicineQuantity"]',
                    '@ViewData["MedicineCost"]',
                    '@ViewData["PrescribingDoctor"]',
                    '@ViewData["DoctorContactDetail"]'
                ];
                fieldIcons = ['bi-capsule', 'bi-123', 'bi-cash-stack', 'bi-person-badge', 'bi-telephone'];
            } else if (assistanceType === 'Laboratory/X-ray/ECG/2D Echo Assistance') {
                fieldNames = ['LaboratoryCenterName', 'LaboratoryCenterAddress', 'TestName', 'TestCost', 'TestOtherInfo'];
                fieldLabels = ['Laboratory Center Name', 'Center Address', 'Test Name', 'Test Cost', 'Other Information'];
                fieldValues = [
                    '@ViewData["LaboratoryCenterName"]',
                    '@ViewData["LaboratoryCenterAddress"]',
                    '@ViewData["TestName"]',
                    '@ViewData["TestCost"]',
                    '@ViewData["TestOtherInfo"]'
                ];
                fieldIcons = ['bi-hospital', 'bi-geo-alt', 'bi-clipboard2-pulse', 'bi-cash-stack', 'bi-info-circle'];
            } else if (assistanceType === 'Therapy/Rehabilitation Assistance') {
                fieldNames = ['TherapyFacilityName', 'TherapyFacilityAddress', 'TherapyFacilityContact', 'TherapyType'];
                fieldLabels = ['Therapy Facility Name', 'Facility Address', 'Facility Contact', 'Therapy Type'];
                fieldValues = [
                    '@ViewData["TherapyFacilityName"]',
                    '@ViewData["TherapyFacilityAddress"]',
                    '@ViewData["TherapyFacilityContact"]',
                    '@ViewData["TherapyType"]'
                ];
                fieldIcons = ['bi-building', 'bi-geo-alt', 'bi-telephone', 'bi-heart-pulse'];
            } else if (assistanceType === 'Medical Equipment/Apparatus Assistance') {
                fieldNames = ['EquipmentName', 'EquipmentBrand', 'EquipmentCategory', 'EquipmentQuantity', 'EquipmentCost'];
                fieldLabels = ['Equipment Name', 'Equipment Brand', 'Equipment Category', 'Equipment Quantity', 'Equipment Cost'];
                fieldValues = [
                    '@ViewData["EquipmentName"]',
                    '@ViewData["EquipmentBrand"]',
                    '@ViewData["EquipmentCategory"]',
                    '@ViewData["EquipmentQuantity"]',
                    '@ViewData["EquipmentCost"]'
                ];
                fieldIcons = ['bi-tools', 'bi-tag', 'bi-grid', 'bi-123', 'bi-cash-stack'];
            }

            return {
                names: fieldNames,
                labels: fieldLabels,
                values: fieldValues,
                icons: fieldIcons
            };
        }

        // Toggle function for Additional Information (View/Hide)
        function toggleAdditionalInfo() {
            const viewButton = document.getElementById('viewAdditionalInfoBtn');
            const isDecrypted = viewButton.getAttribute('data-decrypted') === 'true';

            if (isDecrypted) {
                // Currently showing decrypted data, hide it
                hideAdditionalInfo();
            } else {
                // Currently hidden, show the decrypt modal
                const fields = getOtherAssistanceFields();
                openViewAdditionalInfoModal('Other', '@ViewData["Id"]', fields);
            }
        }

        // Function to hide additional information
        function hideAdditionalInfo() {
            const additionalInfoContainer = document.getElementById('additionalInfoContainer');
            const additionalInfoEncrypted = document.getElementById('additionalInfoEncrypted');
            const additionalInfoAlert = document.getElementById('additionalInfoAlert');
            const viewButton = document.getElementById('viewAdditionalInfoBtn');
            const btnIcon = document.getElementById('additionalBtnIcon');
            const btnText = document.getElementById('additionalBtnText');

            // Hide decrypted data container
            if (additionalInfoContainer) {
                additionalInfoContainer.classList.remove('additional-info-visible');
                additionalInfoContainer.style.display = 'none';
            }

            // Show encrypted data display
            if (additionalInfoEncrypted) {
                additionalInfoEncrypted.style.display = 'block';
            }

            // Show alert
            if (additionalInfoAlert) {
                additionalInfoAlert.style.display = 'flex';
            }

            // Update button to "View" state
            if (viewButton) {
                viewButton.setAttribute('data-decrypted', 'false');
                viewButton.classList.remove('btn-warning');
                viewButton.classList.add('btn-primary');
            }
            if (btnIcon) {
                btnIcon.classList.remove('bi-eye-slash-fill');
                btnIcon.classList.add('bi-eye-fill');
            }
            if (btnText) {
                btnText.textContent = 'View Additional Information';
            }
        }

        // Function to show additional information after successful decryption
        function showAdditionalInfoAfterDecryption() {
            console.log('Showing additional information after decryption...');

            // Hide the loading container
            const loadingContainer = document.getElementById('additionalLoadingContainer');
            if (loadingContainer) {
                loadingContainer.style.display = 'none';
            }

            // Hide the encrypted display section
            const additionalInfoEncrypted = document.getElementById('additionalInfoEncrypted');
            if (additionalInfoEncrypted) {
                additionalInfoEncrypted.style.display = 'none';
            }

            // Hide the alert
            const additionalInfoAlert = document.getElementById('additionalInfoAlert');
            if (additionalInfoAlert) {
                additionalInfoAlert.style.display = 'none';
            }

            // Show the additional information container (decrypted)
            const additionalInfoContainer = document.getElementById('additionalInfoContainer');
            if (additionalInfoContainer) {
                // Populate the content based on assistance type
                populateAdditionalInfoContent();

                additionalInfoContainer.style.display = 'block';
                additionalInfoContainer.classList.add('additional-info-visible', 'decrypted-display');

                // Scroll to the additional information section
                setTimeout(() => {
                    additionalInfoContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 100);
            }

            // Update button to "Hide" state
            const viewButton = document.getElementById('viewAdditionalInfoBtn');
            const btnIcon = document.getElementById('additionalBtnIcon');
            const btnText = document.getElementById('additionalBtnText');

            if (viewButton) {
                viewButton.setAttribute('data-decrypted', 'true');
                viewButton.classList.remove('btn-primary');
                viewButton.classList.add('btn-warning');
            }
            if (btnIcon) {
                btnIcon.classList.remove('bi-eye-fill');
                btnIcon.classList.add('bi-eye-slash-fill');
            }
            if (btnText) {
                btnText.textContent = 'Hide Additional Information';
            }
        }

        // Function to populate additional information content
        function populateAdditionalInfoContent() {
            const contentContainer = document.getElementById('additionalInfoContent');

            if (!contentContainer) return;

            let html = '';
            const fields = getOtherAssistanceFields();

            // Create two columns layout
            const leftColumnFields = [];
            const rightColumnFields = [];

            fields.names.forEach((fieldName, index) => {
                if (index < Math.ceil(fields.names.length / 2)) {
                    leftColumnFields.push({
                        name: fieldName,
                        label: fields.labels[index],
                        value: fields.values[index],
                        icon: fields.icons[index]
                    });
                } else {
                    rightColumnFields.push({
                        name: fieldName,
                        label: fields.labels[index],
                        value: fields.values[index],
                        icon: fields.icons[index]
                    });
                }
            });

            // Left column
            html += '<div class="col-md-6">';
            leftColumnFields.forEach(field => {
                html += `
                    <div class="decrypted-field">
                        <div class="info-label">
                            <i class="bi ${field.icon} me-1"></i>${field.label}:
                        </div>
                        <div class="info-value decrypted-value" id="${field.name}">
                            ${field.value}
                        </div>
                    </div>
                `;
            });
            html += '</div>';

            // Right column
            html += '<div class="col-md-6">';
            rightColumnFields.forEach(field => {
                html += `
                    <div class="decrypted-field">
                        <div class="info-label">
                            <i class="bi ${field.icon} me-1"></i>${field.label}:
                        </div>
                        <div class="info-value decrypted-value" id="${field.name}">
                            ${field.value}
                        </div>
                    </div>
                `;
            });
            html += '</div>';

            contentContainer.innerHTML = html;
        }

        // Function to start the 5-second loading animation
        function startAdditionalInfoLoading() {
            console.log('Starting additional information loading...');

            // Hide alert
            const additionalInfoAlert = document.getElementById('additionalInfoAlert');
            if (additionalInfoAlert) {
                additionalInfoAlert.style.display = 'none';
            }

            // Show loading container
            const loadingContainer = document.getElementById('additionalLoadingContainer');
            if (loadingContainer) {
                loadingContainer.style.display = 'block';
            }

            // Hide encrypted display
            const additionalInfoEncrypted = document.getElementById('additionalInfoEncrypted');
            if (additionalInfoEncrypted) {
                additionalInfoEncrypted.style.display = 'none';
            }

            // Hide any existing additional info container
            const additionalInfoContainer = document.getElementById('additionalInfoContainer');
            if (additionalInfoContainer) {
                additionalInfoContainer.style.display = 'none';
                additionalInfoContainer.classList.remove('additional-info-visible');
            }

            // Start 5-second progress bar
            const progressBar = document.getElementById('additionalLoadingProgress');
            if (progressBar) {
                let progress = 0;
                const totalTime = 5000; // 5 seconds
                const interval = 100; // Update every 100ms
                const increment = (interval / totalTime) * 100;

                const progressInterval = setInterval(() => {
                    progress += increment;
                    if (progress >= 100) {
                        progress = 100;
                        clearInterval(progressInterval);

                        // After 5 seconds, show the additional information
                        setTimeout(() => {
                            showAdditionalInfoAfterDecryption();
                        }, 300);
                    } else {
                        progressBar.style.width = progress + '%';
                    }
                }, interval);
            }
        }

        // IMPORTANT: This function is called from the shared modal after successful decryption
        window.onAdditionalInfoDecrypted = function() {
            startAdditionalInfoLoading();
        };

        // Initialize page
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize button state
            const viewButton = document.getElementById('viewAdditionalInfoBtn');
            if (viewButton) {
                viewButton.setAttribute('data-decrypted', 'false');
            }

            // Make sure the encrypted section is visible by default
            const additionalInfoEncrypted = document.getElementById('additionalInfoEncrypted');
            const additionalInfoContainer = document.getElementById('additionalInfoContainer');
            const additionalInfoAlert = document.getElementById('additionalInfoAlert');

            if (additionalInfoEncrypted) additionalInfoEncrypted.style.display = 'block';
            if (additionalInfoContainer) additionalInfoContainer.style.display = 'none';
            if (additionalInfoAlert) additionalInfoAlert.style.display = 'flex';
        });

        // Comments modal functions
        function showCommentsModal() {
            const modal = document.getElementById('commentsModal');
            const textarea = document.getElementById('commentsTextarea');
            if (modal) modal.style.display = 'block';
            if (textarea) textarea.focus();
        }

        function closeCommentsModal() {
            const modal = document.getElementById('commentsModal');
            const textarea = document.getElementById('commentsTextarea');
            if (modal) modal.style.display = 'none';
            if (textarea) {
                textarea.value = '';
                textarea.classList.remove('is-invalid');
            }
        }

        function submitDisapprove() {
            const commentsTextarea = document.getElementById('commentsTextarea');
            const comments = commentsTextarea ? commentsTextarea.value.trim() : '';

            if (comments === '') {
                if (commentsTextarea) {
                    commentsTextarea.classList.add('is-invalid');
                    commentsTextarea.focus();
                }
                return;
            }

            const statusInput = document.getElementById('statusInput');
            const commentsInput = document.getElementById('commentsInput');
            const processByInput = document.getElementById('processByInput');

            if (statusInput) statusInput.value = 'Disapprove';
            if (commentsInput) commentsInput.value = comments;
            if (processByInput) {
                const processedBy = document.getElementById('processedBy');
                if (processedBy) processByInput.value = processedBy.value;
            }

            // Show loading modal
            showSuccessModal();

            // Submit the form
            setTimeout(() => {
                document.getElementById('statusForm').submit();
            }, 500);
        }

        // Keyboard shortcuts and navigation
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                const zoomModal = document.getElementById("zoomModal");
                if (zoomModal) zoomModal.style.display = "none";
                closePDFViewer();
                closeCommentsModal();
            }

            const pdfModal = document.getElementById('pdfViewerModal');
            if (pdfModal && pdfModal.style.display === 'block') {
                switch(e.key) {
                    case 'ArrowLeft':
                        e.preventDefault();
                        prevPage();
                        break;
                    case 'ArrowRight':
                        e.preventDefault();
                        nextPage();
                        break;
                    case '+':
                    case '=':
                        e.preventDefault();
                        zoomIn();
                        break;
                    case '-':
                        e.preventDefault();
                        zoomOut();
                        break;
                }
            }
        });

        // Close modal when clicking outside
        window.onclick = function(event) {
            const zoomModal = document.getElementById("zoomModal");
            const pdfModal = document.getElementById("pdfViewerModal");
            const commentsModal = document.getElementById("commentsModal");
            const successModal = document.getElementById("successModal");

            if (event.target == zoomModal && zoomModal) {
                zoomModal.style.display = "none";
            }
            if (event.target == pdfModal && pdfModal) {
                closePDFViewer();
            }
            if (event.target == commentsModal && commentsModal) {
                closeCommentsModal();
            }
            if (event.target == successModal && successModal) {
                successModal.style.display = "none";
            }
        }
    </script>

    @Html.Partial("_ViewEncryptedDataModalForAdmin")
    @Html.Partial("_ViewEncryptedIDModal")
}