@model OtherAssistanceDto
@{
    Layout = "_ViewFormsLayout";
    ViewData["Title"] = "Other Assistance View";
    var selectedSex = ViewData["Sex"]?.ToString();
    var checkedAssistance = ViewData["CheckedAssistance"] as Dictionary<string, string> ?? new();
    var checkedCMO = ViewData["CheckedCMOPERSONNEL"] as Dictionary<string, string> ?? new Dictionary<string, string>();
}

<style>
    /* Remove borders since layout already has them */
    .receipt-container {
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
    }

    .receipt-header {
        border: none !important;
    }

    .receipt-body {
        padding: 1rem !important;
    }

    /* ====== ADDITIONAL INFORMATION STYLES (Matching Hospital Assistance) ====== */
    .additional-info-container {
        display: none;
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        border: 2px solid #1a252f;
        border-radius: 12px;
        padding: 1.5rem;
        margin-top: 1rem;
        animation: fadeInScale 0.4s ease-out;
        color: white;
    }

    .additional-info-visible {
        display: block;
    }

    .decrypted-display {
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        border: 2px solid #1a252f;
        border-radius: 12px;
        padding: 1.5rem;
        color: white !important;
    }

    .decrypted-header {
        color: #ffffff !important;
        font-size: 1.1rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid #3498db;
        margin-bottom: 1rem !important;
    }

    .decrypted-field {
        background-color: rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        padding: 0.75rem;
        border: 1px solid rgba(255, 255, 255, 0.2);
        transition: all 0.3s ease;
        margin-bottom: 0.75rem;
    }

        .decrypted-field:hover {
            border-color: #3498db;
            box-shadow: 0 2px 8px rgba(52, 152, 219, 0.3);
            transform: translateY(-1px);
            background-color: rgba(255, 255, 255, 0.15);
        }

        .decrypted-field .info-label {
            color: #d1d8e0 !important;
            font-weight: 500;
            margin-bottom: 0.25rem;
            font-size: 0.9rem;
        }

            .decrypted-field .info-label i {
                color: #ffffff !important;
                margin-right: 0.5rem;
            }

    .decrypted-value {
        color: #ffffff !important;
        font-weight: 500;
        font-size: 0.95rem;
        margin-top: 0.25rem;
        padding-left: 1.5rem;
    }

    /* Encrypted Display Styles */
    .encrypted-info-section {
        background-color: #f8f9fa;
        border-radius: 8px;
        padding: 1rem;
        border: 1px solid #dee2e6;
    }

    .encrypted-display {
        background-color: white;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        padding: 0.75rem;
        font-family: 'Courier New', monospace;
        font-size: 0.85rem;
        color: #6c757d;
        overflow-x: auto;
        white-space: nowrap;
    }

    .encrypted-text {
        letter-spacing: 0.5px;
    }

    /* Loading Container */
    .additional-loading-container {
        display: none;
        background-color: #2c3e50;
        border-radius: 8px;
        padding: 2rem;
        margin-top: 1rem;
        border: 1px solid #34495e;
        text-align: center;
        color: white;
    }

        .additional-loading-container .progress {
            background-color: rgba(255, 255, 255, 0.1);
        }

        .additional-loading-container .progress-bar {
            background-color: #3498db;
        }

    /* Alert styling */
    .alert-info {
        background-color: #e7f3ff;
        border-color: #b3d9ff;
        color: #004085;
    }

        .alert-info i {
            font-size: 1.25rem;
            color: #0066cc;
        }

    /* Animation for decrypted display */
    @@keyframes fadeInScale {
        from {
            opacity: 0;
            transform: scale(0.95);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    /* ====== EXISTING STYLES ====== */
    .zoom-modal {
        display: none;
        position: fixed;
        z-index: 1000;
        padding-top: 50px;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.9);
    }

    .zoom-modal-content {
        margin: auto;
        display: block;
        max-width: 90%;
        max-height: 90%;
    }

    .close-zoom {
        position: absolute;
        top: 15px;
        right: 35px;
        color: #fff;
        font-size: 40px;
        font-weight: bold;
        cursor: pointer;
    }

    .id-image-container {
        cursor: pointer;
        transition: transform 0.2s;
    }

        .id-image-container:hover {
            transform: scale(1.02);
        }

    .id-image {
        width: 100%;
        height: 200px;
        object-fit: contain;
        background-color: #f8f9fa;
        border: 1px solid var(--border-color);
        border-radius: 5px;
    }

    .pdf-container {
        cursor: pointer;
        transition: transform 0.2s;
    }

    .pdf-preview {
        display: flex;
        align-items: center;
        padding: 1rem;
        border: 2px dashed var(--border-color);
        border-radius: 8px;
        background-color: var(--light-gray);
        transition: all 0.3s ease;
    }

        .pdf-preview:hover {
            border-color: var(--primary-color);
            background-color: var(--primary-light);
            transform: translateY(-2px);
        }

    .pdf-icon {
        font-size: 3rem;
        color: #dc143c;
        margin-right: 1rem;
    }

    .pdf-info {
        display: flex;
        flex-direction: column;
    }

    .pdf-filename {
        font-weight: 600;
        color: var(--secondary-color);
        margin-bottom: 0.25rem;
    }

    .pdf-label {
        font-size: 0.9rem;
        color: #6c757d;
    }

    .pdf-viewer-modal {
        display: none;
        position: fixed;
        z-index: 2000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.95);
    }

    .pdf-viewer-content {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .pdf-viewer-header {
        background-color: #333;
        color: white;
        padding: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .pdf-viewer-title {
        font-size: 1.1rem;
        font-weight: 500;
    }

    .pdf-viewer-close {
        background: none;
        border: none;
        color: white;
        font-size: 2rem;
        cursor: pointer;
        padding: 0 0.5rem;
        line-height: 1;
    }

        .pdf-viewer-close:hover {
            color: var(--primary-color);
        }

    .pdf-viewer-body {
        flex: 1;
        background-color: #525659;
        position: relative;
        overflow: auto;
    }

    .pdf-container {
        display: flex;
        justify-content: center;
        padding: 20px;
        min-height: 100%;
    }

    #pdfCanvas {
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
        background-color: white;
    }

    .pdf-controls {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-left: auto;
        flex-wrap: wrap;
    }

    .page-info {
        color: white;
        font-size: 0.9rem;
        margin: 0 10px;
    }

    .zoom-level {
        color: white;
        font-size: 0.9rem;
        min-width: 40px;
        text-align: center;
    }

    .pdf-loading {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: white;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }

    .pdf-error {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        color: white;
        display: none;
    }

        .pdf-error i {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

    /* Status Badges */
    .status-badge {
        display: inline-block;
        padding: 0.35rem 0.75rem;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .status-pending {
        background-color: #fff3cd;
        color: #856404;
    }

    .status-approve {
        background-color: #d4edda;
        color: #155724;
    }

    .status-disapprove {
        background-color: #f8d7da;
        color: #721c24;
    }

    .status-processing {
        background-color: #cce5ff;
        color: #004085;
    }

    .status-claimed {
        background-color: #d1ecf1;
        color: #0c5460;
    }

    /* Receipt Sections */
    .receipt-section {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
    }

    .section-header {
        color: var(--primary-color);
        font-weight: 600;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--primary-light);
    }

    .info-row {
        display: flex;
        margin-bottom: 0.5rem;
        flex-wrap: wrap;
    }

    .info-label {
        flex: 0 0 30%;
        font-weight: 500;
        color: var(--secondary-color);
        min-width: 150px;
    }

    .info-value {
        flex: 1;
        color: #555;
        min-width: 200px;
    }

    /* Comments Modal */
    .comments-modal {
        display: none;
        position: fixed;
        z-index: 3000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.5);
    }

    .comments-modal-content {
        background-color: white;
        margin: 10% auto;
        padding: 2rem;
        border-radius: 8px;
        width: 90%;
        max-width: 500px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .comments-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
    }

    .comments-modal-title {
        color: var(--primary-color);
        font-weight: 600;
        margin: 0;
    }

    .comments-modal-close {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: #6c757d;
    }

        .comments-modal-close:hover {
            color: var(--primary-color);
        }

    .invalid-feedback {
        display: none;
        width: 100%;
        margin-top: 0.25rem;
        font-size: 0.875em;
        color: #dc3545;
    }

    .is-invalid {
        border-color: #dc3545;
        padding-right: calc(1.5em + 0.75rem);
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath d='m5.8 3.6.4.4.4-.4'/%3e%3cpath d='M6 7v1'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(0.375em + 0.1875rem) center;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
    }

        .is-invalid ~ .invalid-feedback {
            display: block;
        }

    /* Success Modal */
    .success-modal {
        display: none;
        position: fixed;
        z-index: 4000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.7);
    }

    .success-modal-content {
        background-color: white;
        margin: 15% auto;
        padding: 2rem;
        border-radius: 10px;
        width: 90%;
        max-width: 400px;
        text-align: center;
        box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    }

    .success-icon {
        font-size: 3rem;
        color: #28a745;
        margin-bottom: 1rem;
    }

    /* Valid ID Styles */
    .valid-id-container {
        display: none;
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        border: 2px solid #1a252f;
        border-radius: 12px;
        padding: 1.5rem;
        margin-top: 1rem;
        animation: fadeInScale 0.4s ease-out;
        color: white;
    }

    .valid-id-loading {
        display: none;
        background-color: #2c3e50;
        border-radius: 8px;
        padding: 2rem;
        margin-top: 1rem;
        border: 1px solid #34495e;
        text-align: center;
        color: white;
    }
</style>

<!-- Image Zoom Modal -->
<div id="zoomModal" class="zoom-modal">
    <span class="close-zoom">&times;</span>
    <img class="zoom-modal-content" id="zoomedImage">
</div>

<!-- PDF Viewer Modal -->
<div id="pdfViewerModal" class="pdf-viewer-modal">
    <div class="pdf-viewer-content">
        <div class="pdf-viewer-header">
            <span class="pdf-viewer-title" id="pdfViewerTitle">PDF Document</span>
            <div class="pdf-controls">
                <button class="btn btn-sm btn-light" onclick="prevPage()" id="prevBtn">
                    <i class="bi bi-chevron-left"></i> Previous
                </button>
                <span class="page-info" id="pageInfo">Page: <span id="currentPage">1</span> / <span id="totalPages">1</span></span>
                <button class="btn btn-sm btn-light" onclick="nextPage()" id="nextBtn">
                    Next <i class="bi bi-chevron-right"></i>
                </button>
                <button class="btn btn-sm btn-light" onclick="zoomOut()">
                    <i class="bi bi-zoom-out"></i>
                </button>
                <span class="zoom-level" id="zoomLevel">100%</span>
                <button class="btn btn-sm btn-light" onclick="zoomIn()">
                    <i class="bi bi-zoom-in"></i>
                </button>
            </div>
            <button class="pdf-viewer-close" onclick="closePDFViewer()">&times;</button>
        </div>
        <div class="pdf-viewer-body">
            <div id="pdfLoading" class="pdf-loading">
                <div class="spinner-border text-light" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p>Loading PDF document...</p>
            </div>
            <div id="pdfError" class="pdf-error">
                <i class="bi bi-exclamation-triangle"></i>
                <p>Error loading PDF. Please try again.</p>
            </div>
            <div class="pdf-container">
                <canvas id="pdfCanvas"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Comments Modal -->
<div id="commentsModal" class="comments-modal">
    <div class="comments-modal-content">
        <div class="comments-modal-header">
            <h5 class="comments-modal-title">Comments Required</h5>
            <button class="comments-modal-close" onclick="closeCommentsModal()">&times;</button>
        </div>
        <div class="mb-3">
            <label for="commentsTextarea" class="form-label">Please provide comments for disapproval:</label>
            <textarea class="form-control" id="commentsTextarea" rows="4" placeholder="Enter comments explaining why the application is disapproved..." required></textarea>
            <div class="invalid-feedback">Comments are required when disapproving an application.</div>
        </div>
        <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-secondary" onclick="closeCommentsModal()">Cancel</button>
            <button type="button" class="btn btn-disapproved" onclick="submitDisapprove()">Submit Disapproval</button>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div id="successModal" class="success-modal">
    <div class="success-modal-content">
        <div class="success-icon">
            <i class="bi bi-check-circle-fill"></i>
        </div>
        <h4>Status Updated Successfully!</h4>
        <p>Application marked as <strong>Claimed</strong></p>
        <p>Redirecting to Admin page...</p>
        <div class="mt-3">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </div>
</div>

<div class="receipt-container">
    <form asp-action="OtherAssistanceApproveStatus" asp-route-id="@ViewData["Id"]" method="post" id="statusForm">
        @Html.AntiForgeryToken()

        <!-- Hidden fields for form submission -->
        <input type="hidden" name="id" value="@ViewData["Id"]" />
        <input type="hidden" id="statusInput" name="status3" value="@ViewData["Status3"]">
        <input type="hidden" id="commentsInput" name="Comments" value="" />
        <input type="hidden" id="forCMOPersonnelInput" name="ForCMOPERSONNEL" value="@ViewData["ForCMOPERSONNEL"]" />
        <input type="hidden" id="processByInput" name="Processby" value="@Context.Session.GetString("AdminFullname")" />

        <div class="receipt-body">

            <!-- Patient Information -->
            <div class="receipt-section">
                <h5 class="section-header">Patient Information</h5>
                <div class="row">
                    <div class="col-md-6">
                        <div class="info-row">
                            <div class="info-label">Name:</div>
                            <div class="info-value">
                                @ViewData["Firstname"] @ViewData["Middlename"] @ViewData["Lastname"]
                                @(ViewData["Suffix"]?.ToString() == "None" ? "" : " " + ViewData["Suffix"])
                            </div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Address:</div>
                            <div class="info-value">@ViewData["BlkLotStreet"], @ViewData["SubVill"], @ViewData["Brgy"]</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Sex:</div>
                            <div class="info-value">@ViewData["Sex"]</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-row">
                            <div class="info-label">Date of Birth:</div>
                            <div class="info-value">@ViewData["Dateofbirth"]</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Age:</div>
                            <div class="info-value">@ViewData["Age"]</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">PhilHealth:</div>
                            <div class="info-value">@ViewData["PhilHealth"]</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">PhilHealth No:</div>
                            <div class="info-value">@ViewData["PhilHealthNo"]</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Requestor Details -->
            <div class="receipt-section">
                <h5 class="section-header">Requestor's Details</h5>
                <div class="info-row">
                    <div class="info-label">Full Name:</div>
                    <div class="info-value">@ViewData["RLastname"], @ViewData["RFirstname"] @ViewData["RMiddlename"] @ViewData["RSuffix"]</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Address:</div>
                    <div class="info-value">@ViewData["RBlkLotStreet"], @ViewData["RSubVill"], @ViewData["RBrgy"]</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Relationship to Patient:</div>
                    <div class="info-value">@ViewData["RelationshipPatient"]</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Contact No:</div>
                    <div class="info-value">@ViewData["ContactNo"]</div>
                </div>
            </div>

            <!-- Assistance Requested -->
            <div class="receipt-section">
                <h5 class="section-header">Assistance Requested</h5>
                <div class="info-value">@ViewData["Typeassistance"]</div>
            </div>

            <!-- Additional Information Section (Password-Protected) - FIXED -->
            <div class="receipt-section">
                <h5 class="section-header d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-shield-lock-fill me-2"></i>Additional Information (Encrypted)</span>
                    <button type="button" class="btn btn-sm btn-primary" id="viewAdditionalInfoBtn"
                            onclick="toggleAdditionalInfo()"
                            data-decrypted="false"
                            title="Click to view encrypted information">
                        <i class="bi bi-eye-fill me-2" id="additionalBtnIcon"></i>
                        <span id="additionalBtnText">View Additional Information</span>
                    </button>
                </h5>

                <!-- Alert shown when Additional Info is encrypted -->
                <div class="alert alert-info d-flex align-items-center mb-3" id="additionalInfoAlert">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    <div>
                        <strong>Additional Information is Encrypted</strong><br>
                        For security and privacy, additional information is encrypted. Click the "View Additional Information" button above and enter your password to view it.
                    </div>
                </div>

                <!-- Encrypted Additional Information Display (shown by default) -->
                <div class="encrypted-info-section" id="additionalInfoEncrypted">
                    @if (ViewData["Typeassistance"]?.ToString() == "Medicine Assistance")
                    {
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <div class="info-label">Medicine Name:</div>
                                    <div class="encrypted-display">
                                        <span class="encrypted-text">@ViewData["MedicineName"]</span>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <div class="info-label">Medicine Quantity:</div>
                                    <div class="encrypted-display">
                                        <span class="encrypted-text">@ViewData["MedicineQuantity"]</span>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <div class="info-label">Medicine Cost:</div>
                                    <div class="encrypted-display">
                                        <span class="encrypted-text">@ViewData["MedicineCost"]</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <div class="info-label">Prescribing Doctor:</div>
                                    <div class="encrypted-display">
                                        <span class="encrypted-text">@ViewData["PrescribingDoctor"]</span>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <div class="info-label">Doctor Contact Detail:</div>
                                    <div class="encrypted-display">
                                        <span class="encrypted-text">@ViewData["DoctorContactDetail"]</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (ViewData["Typeassistance"]?.ToString() == "Laboratory/X-ray/ECG/2D Echo Assistance")
                    {
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <div class="info-label">Laboratory/Center Name:</div>
                                    <div class="encrypted-display">
                                        <span class="encrypted-text">@ViewData["LaboratoryCenterName"]</span>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <div class="info-label">Laboratory/Center Address:</div>
                                    <div class="encrypted-display">
                                        <span class="encrypted-text">@ViewData["LaboratoryCenterAddress"]</span>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <div class="info-label">Test Name:</div>
                                    <div class="encrypted-display">
                                        <span class="encrypted-text">@ViewData["TestName"]</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <div class="info-label">Test Cost:</div>
                                    <div class="encrypted-display">
                                        <span class="encrypted-text">@ViewData["TestCost"]</span>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <div class="info-label">Other Information:</div>
