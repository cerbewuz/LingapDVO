        // Barangay Chart functions with percentages
        function updateBarangayChart() {
            if (!window.chartData) return;

            const chartType = document.getElementById('barangayChartType').value;
            const viewType = document.getElementById('barangayView').value;

            // Get data based on view type
            let labels, totals;
            let assistanceData = {};

            if (viewType === 'all') {
                labels = [...window.chartData.barangayLabels];
                totals = [...window.chartData.barangayTotals];
                window.chartData.assistanceTypes.forEach(type => {
                    assistanceData[type] = [...window.chartData.assistanceTypeData[type]];
                });
            } else {
                const limit = viewType === 'top10' ? 10 : 20;
                labels = window.chartData.barangayLabels.slice(0, limit);
                totals = window.chartData.barangayTotals.slice(0, limit);
                window.chartData.assistanceTypes.forEach(type => {
                    assistanceData[type] = window.chartData.assistanceTypeData[type].slice(0, limit);
                });
            }

            const ctx = document.getElementById('barangayChart');
            if (!ctx) return;

            const context = ctx.getContext('2d');
            if (barangayChart) barangayChart.destroy();

            // Show/hide barangay list
            const listContainer = document.getElementById('barangayListContainer');
            if (listContainer) {
                if (chartType === 'pie' || chartType === 'doughnut') {
                    listContainer.style.display = 'block';
                    updateBarangayList(labels, totals, assistanceData);
                } else {
                    listContainer.style.display = 'none';
                }
            }

            // Create chart based on type
            if (chartType === 'bar' || chartType === 'stackedBar') {
                createBarChart(context, labels, assistanceData, chartType);
            } else {
                createPieChart(context, labels, totals, chartType);
            }
        }

        function createBarChart(ctx, labels, assistanceData, chartType) {
            const isStacked = chartType === 'stackedBar';
            const assistanceTypes = Object.keys(assistanceData);
            const assistanceColors = generateAssistanceTypeColors(assistanceTypes.length);

            // Calculate total for each barangay for percentages
            const barangayTotals = labels.map((_, index) =>
                assistanceTypes.reduce((sum, type) => sum + (assistanceData[type][index] || 0), 0)
            );

            const datasets = assistanceTypes.map((type, index) => ({
                label: type,
                data: assistanceData[type],
                backgroundColor: assistanceColors[index],
                borderWidth: 0
            }));

            barangayChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: datasets
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: {
                                font: {
                                    size: 14 // Larger legend font
                                }
                            }
                        },
                        title: {
                            display: true,
                            text: 'Applications by Barangay and Specific Assistance Type',
                            font: {
                                size: 18, // Larger title
                                weight: 'bold'
                            }
                        },
                        tooltip: {
                            titleFont: {
                                size: 14 // Larger tooltip font
                            },
                            bodyFont: {
                                size: 14 // Larger tooltip font
                            },
                            callbacks: {
                                label: function(context) {
                                    const label = context.dataset.label || '';
                                    const value = context.raw || 0;
                                    const total = barangayTotals[context.dataIndex];
                                    const percentage = total > 0 ? Math.round((value / total) * 100) : 0;
                                    return `${label}: ${value} (${percentage}%)`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            stacked: isStacked,
                            ticks: {
                                font: {
                                    size: 12 // Larger x-axis font
                                }
                            }
                        },
                        y: {
                            stacked: isStacked,
                            beginAtZero: true,
                            ticks: {
                                precision: 0,
                                font: {
                                    size: 12 // Larger y-axis font
                                }
                            },
                            title: {
                                display: true,
                                text: 'Number of Applications',
                                font: {
                                    size: 14,
                                    weight: 'bold'
                                }
                            }
                        }
                    }
                }
            });
        }

        function createPieChart(ctx, labels, totals, chartType) {
            // Calculate percentages for pie/doughnut charts
            const total = totals.reduce((a, b) => a + b, 0);
            const percentages = totals.map(value =>
                total > 0 ? Math.round((value / total) * 100) : 0
            );

            // Create labels with percentages
            const labelsWithPercentages = labels.map((label, index) =>
                `${percentages[index]}% - ${label}`
            );

            barangayChart = new Chart(ctx, {
                type: chartType,
                data: {
                    labels: labelsWithPercentages,
                    datasets: [{
                        data: totals,
                        backgroundColor: generateAssistanceTypeColors(labels.length),
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        title: {
                            display: true,
                            text: 'Total Applications by Barangay',
                            font: {
                                size: 18, // Larger title
                                weight: 'bold'
                            }
                        },
                        tooltip: {
                            titleFont: {
                                size: 14 // Larger tooltip font
                            },
                            bodyFont: {
                                size: 14 // Larger tooltip font
                            },
                            callbacks: {
                                label: function(context) {
                                    const label = context.label.replace(/^\d+% - /, '');
                                    const value = context.raw || 0;
                                    const percentage = percentages[context.dataIndex];
                                    return `${label}: ${value} (${percentage}%)`;
                                }
                            }
                        }
                    }
                }
            });
        }

        function updateBarangayList(labels, totals, assistanceData) {
            const container = document.getElementById('barangayListContainer');
            if (!container) return;

            let html = '';
            labels.forEach((label, index) => {
                const barangayAssistance = [];
                Object.keys(assistanceData).forEach(type => {
                    const count = assistanceData[type][index];
                    if (count > 0) {
                        barangayAssistance.push(`${type}: ${count}`);
                    }
                });

                html += `
                    <div class="barangay-item">
                        <div class="barangay-name">
                            ${label}
                            <div class="assistance-details">
                                ${barangayAssistance.map(item =>
                                    `<span class="assistance-type-badge">${item}</span>`
                                ).join('')}
                            </div>
                        </div>
                        <span class="barangay-count">${totals[index]}</span>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

        // Helper functions
        function generateAssistanceTypeColors(count) {
            const colorPalette = [
                '#1e88e5', '#1565c0', '#42a5f5', '#64b5f6', '#90caf9',
                '#00acc1', '#0097a7', '#26c6da', '#4dd0e1', '#80deea',
                '#7e57c2', '#673ab7', '#9575cd', '#b39ddb', '#d1c4e9',
                '#43a047', '#388e3c', '#66bb6a', '#81c784', '#a5d6a7',
                '#fb8c00', '#f57c00', '#ffa726', '#ffb74d', '#ffcc80',
                '#e53935', '#d32f2f', '#ef5350', '#e57373', '#ef9a9a',
                '#00897b', '#00796b', '#26a69a', '#4db6ac', '#80cbc4',
                '#039be5', '#0288d1', '#29b6f6', '#4fc3f7', '#81d4fa'
            ];

            const generatedColors = [];
            for (let i = 0; i < count; i++) {
                generatedColors.push(colorPalette[i % colorPalette.length]);
            }
            return generatedColors;
