        function generateUniqueColor(assistanceType) {
            // Create a hash from the assistance type string to generate consistent colors
            let hash = 0;
            for (let i = 0; i < assistanceType.length; i++) {
                hash = assistanceType.charCodeAt(i) + ((hash << 5) - hash);
            }

            // Generate HSL color with distinct hue
            const hue = Math.abs(hash) % 360;

            // Adjust saturation and lightness based on assistance type category
            let saturation = 70;
            let lightness = 60;

            // Make funeral assistance more purple
            if (assistanceType.toLowerCase().includes('funeral') ||
                assistanceType.toLowerCase().includes('burial')) {
                return `hsl(280, ${saturation}%, ${lightness}%)`;
            }

            // Make government assistance more green
            if (assistanceType.toLowerCase().includes('government') ||
                assistanceType.toLowerCase().includes('financial') ||
                assistanceType.toLowerCase().includes('cash')) {
                return `hsl(120, ${saturation}%, ${lightness}%)`;
            }

            // Make medicine/medical assistance more blue
            if (assistanceType.toLowerCase().includes('medicine') ||
                assistanceType.toLowerCase().includes('medical') ||
                assistanceType.toLowerCase().includes('laboratory')) {
                return `hsl(210, ${saturation}%, ${lightness}%)`;
            }

            // Make hospital assistance dark blue
            if (assistanceType.toLowerCase().includes('hospital')) {
                return `hsl(220, ${saturation}%, 50%)`;
            }

            // Default: use golden angle for distinct colors
            return `hsl(${hue}, ${saturation}%, ${lightness}%)`;
        }

        function updateBarangayList(labels, totals, assistanceData) {
            const container = document.getElementById('barangayListContainer');
            if (!container) return;

            const total = totals.reduce((a, b) => a + b, 0);

            let html = '';
            labels.forEach((label, index) => {
                const barangayAssistance = [];
                Object.keys(assistanceData).forEach(type => {
                    const count = assistanceData[type][index];
                    if (count > 0) {
                        const percentage = total > 0 ? Math.round((count / total) * 100) : 0;
                        // Get color for this assistance type
                        const color = assistanceTypeColors[type] || generateUniqueColor(type);
                        barangayAssistance.push({
                            type,
                            count,
                            percentage,
                            color
                        });
                    }
                });

                const barangayPercentage = total > 0 ? Math.round((totals[index] / total) * 100) : 0;

                html += `
                    <div class="barangay-item">
                        <div class="barangay-name">
                            ${label} <span style="font-weight:700;color:${colors.primary};">(${barangayPercentage}%)</span>
                            <div class="assistance-details">
                                ${barangayAssistance.map(item =>
                                    `<span class="assistance-type-badge" style="background:${item.color};color:white;">${item.type}: ${item.count} (${item.percentage}%)</span>`
                                ).join('')}
                            </div>
                        </div>
                        <span class="barangay-count">${totals[index]}</span>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

