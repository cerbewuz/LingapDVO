        function processTrendsData(applications, timeframe) {
            const now = new Date();
            const dataMap = {
                hospital: {},
                medical: {},
                funeral: {}
            };
            const labels = [];

            if (timeframe === 'daily') {
                for (let i = 29; i >= 0; i--) {
                    const date = new Date(now);
                    date.setDate(date.getDate() - i);
                    const label = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                    labels.push(label);
                    const key = date.toISOString().split('T')[0];
                    dataMap.hospital[key] = 0;
                    dataMap.medical[key] = 0;
                    dataMap.funeral[key] = 0;
                }
            } else if (timeframe === 'weekly') {
                for (let i = 11; i >= 0; i--) {
                    const date = new Date(now);
                    date.setDate(date.getDate() - (i * 7));
                    const weekStart = new Date(date);
                    weekStart.setDate(date.getDate() - date.getDay());
                    const label = weekStart.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                    labels.push(`Week of ${label}`);
                    const key = `week-${i}`;
                    dataMap.hospital[key] = 0;
                    dataMap.medical[key] = 0;
                    dataMap.funeral[key] = 0;
                }
            } else {
                for (let i = 11; i >= 0; i--) {
                    const date = new Date(now);
                    date.setMonth(date.getMonth() - i);
                    const label = date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
                    labels.push(label);
                    const key = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
                    dataMap.hospital[key] = 0;
                    dataMap.medical[key] = 0;
                    dataMap.funeral[key] = 0;
                }
            }

            applications.forEach(app => {
                if (!app.createdAt) return;
                const date = new Date(app.createdAt);
                let key;

                if (timeframe === 'daily') {
                    key = date.toISOString().split('T')[0];
                } else if (timeframe === 'weekly') {
                    const diffDays = Math.floor((now - date) / (1000 * 60 * 60 * 24));
                    const weekIndex = Math.floor(diffDays / 7);
                    if (weekIndex <= 11) key = `week-${weekIndex}`;
                } else {
                    key = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
                }

                if (key) {
                    if (app.type === 'Hospital Assistance' && dataMap.hospital[key] !== undefined) {
                        dataMap.hospital[key]++;
                    } else if (app.type === 'Other Assistance' && dataMap.medical[key] !== undefined) {
                        dataMap.medical[key]++;
                    } else if (app.type === 'Funeral Assistance' && dataMap.funeral[key] !== undefined) {
                        dataMap.funeral[key]++;
                    }
                }
            });

            return {
                labels,
                hospital: Object.values(dataMap.hospital),
                medical: Object.values(dataMap.medical),
                funeral: Object.values(dataMap.funeral)
            };
        }

