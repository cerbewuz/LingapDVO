            let html = '';
            labels.forEach((label, index) => {
                const barangayAssistance = [];
                Object.keys(assistanceData).forEach(type => {
                    const count = assistanceData[type][index];
                    if (count > 0) {
                        barangayAssistance.push(`${type}: ${count}`);
                    }
                });

                html += `
                    <div class="barangay-item">
                        <div class="barangay-name">
                            ${label}
                            <div class="assistance-details">
                                ${barangayAssistance.map(item =>
                                    `<span class="assistance-type-badge">${item}</span>`
                                ).join('')}
                            </div>
                        </div>
                        <span class="barangay-count">${totals[index]}</span>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

        // Helper functions
        function generateAssistanceTypeColors(count) {
            const colorPalette = [
                '#4361ee', '#3a0ca3', '#4cc9f0', '#f72585', '#7209b7',
                '#3f37c9', '#560bad', '#b5179e', '#4895ef', '#480ca8',
                '#f15bb5', '#00bbf9', '#00f5d4', '#00bbf9', '#fee440',
                '#f96167', '#f9c74f', '#90be6d', '#43aa8b', '#577590',
                '#4d908e', '#277da1', '#577590', '#43aa8b', '#90be6d',
                '#ff6b6b', '#4ecdc4', '#45b7d1', '#96ceb4', '#feca57',
                '#ff9ff3', '#54a0ff', '#5f27cd', '#00d2d3', '#ff9f43'
            ];

            const generatedColors = [];
            for (let i = 0; i < count; i++) {
                generatedColors.push(colorPalette[i % colorPalette.length]);
            }
            return generatedColors;
        }

        function showLoading(show) {
            const overlay = document.getElementById('loadingOverlay');
            if (overlay) {
                overlay.style.display = show ? 'flex' : 'none';
            }
        }

        // Date filter functions
        function applyDateFilter() {
            const start = document.getElementById('startDate').value;
            const end = document.getElementById('endDate').value;

            if (!start || !end) {
                alert('Please select both start and end dates');
                return;
            }

            if (new Date(start) > new Date(end)) {
                alert('Start date cannot be after end date');
                return;
            }

            processDataAndUpdateCharts();
        }

        function resetDateFilter() {
            document.getElementById('startDate').value = '';
            document.getElementById('endDate').value = '';
            processDataAndUpdateCharts();
        }
    </script>
</body>
</html>