                                                       context.datasetIndex === 1 ? statusData.pending[index] :
                                                       context.datasetIndex === 2 ? statusData.processing[index] :
                                                       context.datasetIndex === 3 ? statusData.disapproved[index] :
                                                       statusData.claimed[index];

                                    return isPercentage ?
                                        `${label}: ${value.toFixed(1)}% (${actualCount} apps)` :
                                        `${label}: ${value} apps`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            stacked: chartType !== 'groupedBar',
                            ticks: { font: { size: 13 } }
                        },
                        y: {
                            stacked: chartType !== 'groupedBar',
                            beginAtZero: true,
                            max: isPercentage ? 100 : undefined,
                            ticks: {
                                callback: function(value) {
                                    return isPercentage ? value + '%' : value;
                                },
                                font: { size: 12 }
                            },
                            title: {
                                display: true,
                                text: isPercentage ? 'Percentage' : 'Number of Applications',
                                font: { size: 14, weight: 'bold' }
                            }
                        }
                    }
                }
            });
        }

        function calculateStatusByType(applications) {
            const stats = {
                hospital: { approved: 0, pending: 0, processing: 0, disapproved: 0, claimed: 0, total: 0 },
                medical: { approved: 0, pending: 0, processing: 0, disapproved: 0, claimed: 0, total: 0 },
                funeral: { approved: 0, pending: 0, processing: 0, disapproved: 0, claimed: 0, total: 0 }
            };

            applications.forEach(app => {
                let category;
                if (app.type === "Hospital Bill Assistance") category = 'hospital';
                else if (app.type === "Medical and Laboratory Procedure") category = 'medical';
                else if (app.type === "Funeral and Burial Assistance") category = 'funeral';
                else return;

                stats[category].total++;

                if (app.status3 && app.status3.toLowerCase() === 'claimed') {
                    stats[category].claimed++;
                } else if (app.status2 === 'approve') {
                    stats[category].approved++;
                } else if (app.status2 === 'disapprove') {
                    stats[category].disapproved++;
                } else if (app.status === 'processing') {
                    stats[category].processing++;
                } else if (app.status === 'pending') {
                    stats[category].pending++;
                }
            });

            return {
                approved: [stats.hospital.approved, stats.medical.approved, stats.funeral.approved],
                pending: [stats.hospital.pending, stats.medical.pending, stats.funeral.pending],
                processing: [stats.hospital.processing, stats.medical.processing, stats.funeral.processing],
                disapproved: [stats.hospital.disapproved, stats.medical.disapproved, stats.funeral.disapproved],
                claimed: [stats.hospital.claimed, stats.medical.claimed, stats.funeral.claimed],
                approvedPct: [
                    stats.hospital.total > 0 ? (stats.hospital.approved / stats.hospital.total) * 100 : 0,
                    stats.medical.total > 0 ? (stats.medical.approved / stats.medical.total) * 100 : 0,
                    stats.funeral.total > 0 ? (stats.funeral.approved / stats.funeral.total) * 100 : 0
                ],
                pendingPct: [
                    stats.hospital.total > 0 ? (stats.hospital.pending / stats.hospital.total) * 100 : 0,
                    stats.medical.total > 0 ? (stats.medical.pending / stats.medical.total) * 100 : 0,
                    stats.funeral.total > 0 ? (stats.funeral.pending / stats.funeral.total) * 100 : 0
                ],
                processingPct: [
                    stats.hospital.total > 0 ? (stats.hospital.processing / stats.hospital.total) * 100 : 0,
                    stats.medical.total > 0 ? (stats.medical.processing / stats.medical.total) * 100 : 0,
                    stats.funeral.total > 0 ? (stats.funeral.processing / stats.funeral.total) * 100 : 0
                ],
                disapprovedPct: [
                    stats.hospital.total > 0 ? (stats.hospital.disapproved / stats.hospital.total) * 100 : 0,
                    stats.medical.total > 0 ? (stats.medical.disapproved / stats.medical.total) * 100 : 0,
                    stats.funeral.total > 0 ? (stats.funeral.disapproved / stats.funeral.total) * 100 : 0
                ],
                claimedPct: [
                    stats.hospital.total > 0 ? (stats.hospital.claimed / stats.hospital.total) * 100 : 0,
                    stats.medical.total > 0 ? (stats.medical.claimed / stats.medical.total) * 100 : 0,
                    stats.funeral.total > 0 ? (stats.funeral.claimed / stats.funeral.total) * 100 : 0
                ]
            };
        }

        // Claim Rate Metrics
        function updateClaimRateMetrics() {
            const container = document.getElementById('claimRateMetrics');
            if (!container || !filteredData) return;

            const claimStats = calculateClaimStats(filteredData.allApplications);

            container.innerHTML = `
                <div class="col-md-3">
                    <div class="claim-metric-card">
                        <div class="claim-metric-label">Overall Claim Rate</div>
                        <div class="claim-metric-value" style="color: ${colors.info};">
                            ${claimStats.overallRate.toFixed(1)}%
                        </div>
                        <div class="claim-progress-bar">
                            <div class="claim-progress-fill" style="width: ${claimStats.overallRate}%;"></div>
                        </div>
                        <div class="metric-subtext">${claimStats.totalClaimed} of ${claimStats.totalApproved} approved</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="claim-metric-card">
                        <div class="claim-metric-label">Hospital Bill Claims</div>
                        <div class="claim-metric-value" style="color: ${colors.hospital};">
                            ${claimStats.hospitalRate.toFixed(1)}%
                        </div>
                        <div class="claim-progress-bar">
                            <div class="claim-progress-fill" style="width: ${claimStats.hospitalRate}%; background: linear-gradient(90deg, ${colors.hospital}, ${colors.hospital}90);"></div>
                        </div>
                        <div class="metric-subtext">${claimStats.hospitalClaimed} of ${claimStats.hospitalApproved} claimed</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="claim-metric-card">
                        <div class="claim-metric-label">Medical/Lab Claims</div>
                        <div class="claim-metric-value" style="color: ${colors.medical};">
                            ${claimStats.medicalRate.toFixed(1)}%
                        </div>
                        <div class="claim-progress-bar">
                            <div class="claim-progress-fill" style="width: ${claimStats.medicalRate}%; background: linear-gradient(90deg, ${colors.medical}, ${colors.medical}90);"></div>
                        </div>
                        <div class="metric-subtext">${claimStats.medicalClaimed} of ${claimStats.medicalApproved} claimed</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="claim-metric-card">
                        <div class="claim-metric-label">Funeral/Burial Claims</div>
                        <div class="claim-metric-value" style="color: ${colors.funeral};">
                            ${claimStats.funeralRate.toFixed(1)}%
                        </div>
                        <div class="claim-progress-bar">
                            <div class="claim-progress-fill" style="width: ${claimStats.funeralRate}%; background: linear-gradient(90deg, ${colors.funeral}, ${colors.funeral}90);"></div>
                        </div>
                        <div class="metric-subtext">${claimStats.funeralClaimed} of ${claimStats.funeralApproved} claimed</div>
                    </div>
                </div>
            `;
        }

        function calculateClaimStats(applications) {
            const stats = {
                hospital: { approved: 0, claimed: 0 },
                medical: { approved: 0, claimed: 0 },
                funeral: { approved: 0, claimed: 0 },
                overall: { approved: 0, claimed: 0 }
            };

            applications.forEach(app => {
                // Count approved applications (status2 = approve)
                const isApproved = app.status2 === 'approve';
                const isClaimed = app.status3 && app.status3.toLowerCase() === 'claimed';

                if (!isApproved && !isClaimed) return;

                let category;
                if (app.type === "Hospital Bill Assistance") category = 'hospital';
                else if (app.type === "Medical and Laboratory Procedure") category = 'medical';
                else if (app.type === "Funeral and Burial Assistance") category = 'funeral';
                else return;

                if (isApproved || isClaimed) {
                    stats[category].approved++;
                    stats.overall.approved++;
                }

                if (isClaimed) {
                    stats[category].claimed++;
                    stats.overall.claimed++;
                }
            });

            return {
                overallRate: stats.overall.approved > 0 ? (stats.overall.claimed / stats.overall.approved) * 100 : 0,
                hospitalRate: stats.hospital.approved > 0 ? (stats.hospital.claimed / stats.hospital.approved) * 100 : 0,
                medicalRate: stats.medical.approved > 0 ? (stats.medical.claimed / stats.medical.approved) * 100 : 0,
                funeralRate: stats.funeral.approved > 0 ? (stats.funeral.claimed / stats.funeral.approved) * 100 : 0,
                totalApproved: stats.overall.approved,
                totalClaimed: stats.overall.claimed,
                hospitalApproved: stats.hospital.approved,
                hospitalClaimed: stats.hospital.claimed,
                medicalApproved: stats.medical.approved,
                medicalClaimed: stats.medical.claimed,
                funeralApproved: stats.funeral.approved,
                funeralClaimed: stats.funeral.claimed
            };
        }
    </script>
</body>
</html>