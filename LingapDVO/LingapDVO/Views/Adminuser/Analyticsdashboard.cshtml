                <div class="col-md-2">
                    <div class="card-analytics summary-card summary-pending" onclick="redirectToApplicationDashboard('pending')">
                        <div class="summary-icon">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                        <div class="summary-number">${statusCounts.pending}</div>
                        <div class="summary-label">Pending</div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card-analytics summary-card summary-processing" onclick="redirectToApplicationDashboard('processing')">
                        <div class="summary-icon">
                            <i class="bi bi-gear"></i>
                        </div>
                        <div class="summary-number">${statusCounts.processing}</div>
                        <div class="summary-label">Processing</div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card-analytics summary-card summary-disapproved" onclick="redirectToApplicationDashboard('disapproved')">
                        <div class="summary-icon">
                            <i class="bi bi-x-circle"></i>
                        </div>
                        <div class="summary-number">${statusCounts.disapproved}</div>
                        <div class="summary-label">Disapproved</div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card-analytics summary-card summary-claimed" onclick="redirectToApplicationDashboard('claimed')">
                        <div class="summary-icon">
                            <i class="bi bi-box-seam"></i>
                        </div>
                        <div class="summary-number">${statusCounts.claimed}</div>
                        <div class="summary-label">Claimed</div>
                    </div>
                </div>
            `;

            // Update global chart data
            window.chartData = {
                statusData: [statusCounts.approved, statusCounts.pending, statusCounts.processing, statusCounts.disapproved, statusCounts.claimed],
                typeData: countApplicationTypes(applications),
                statusLabels: ['Approved', 'Pending', 'Processing', 'Disapproved', 'Claimed'],
                typeLabels: ['Hospital Bill', 'Medical/Lab', 'Funeral/Burial'],
                // Barangay data will be processed separately
                ...processBarangayData(applications)
            };
        }

        // Count application types
        function countApplicationTypes(applications) {
            const counts = {
                hospital: 0,
                medical: 0,
                funeral: 0
            };

            applications.forEach(app => {
                if (app.type === "Hospital Bill Assistance") counts.hospital++;
                else if (app.type === "Medical and Laboratory Procedure") counts.medical++;
                else if (app.type === "Funeral and Burial Assistance") counts.funeral++;
            });

            return [counts.hospital, counts.medical, counts.funeral];
        }

        // Process barangay data for charts - UPDATED TO USE COMBINED APPLICATIONS
        function processBarangayData(applications) {
            const barangayDetailedData = {};

            // Process all applications following the same pattern
            applications.forEach(app => {
                if (!app.brgy) return;

                const barangay = app.brgy;
                if (!barangayDetailedData[barangay]) {
                    barangayDetailedData[barangay] = {};
                }

                // Use typeassistance if available, otherwise use type
                const assistanceType = app.typeassistance ? app.typeassistance.trim() : app.type;
                barangayDetailedData[barangay][assistanceType] =
                    (barangayDetailedData[barangay][assistanceType] || 0) + 1;
            });

            // Sort barangays by total applications
            const allBarangaysDetailed = Object.entries(barangayDetailedData)
                .sort((a, b) => {
                    const totalA = Object.values(a[1]).reduce((sum, count) => sum + count, 0);
                    const totalB = Object.values(b[1]).reduce((sum, count) => sum + count, 0);
                    return totalB - totalA;
                });

            const barangayLabelsDetailed = allBarangaysDetailed.map(b => b[0]);
            const barangayTotalsDetailed = allBarangaysDetailed.map(b =>
                Object.values(b[1]).reduce((sum, count) => sum + count, 0));

            // Get all unique assistance types
            const allAssistanceTypes = [...new Set(
                allBarangaysDetailed.flatMap(b => Object.keys(b[1]))
            )].sort();

            // Prepare data for each assistance type
            const assistanceTypeData = {};
            allAssistanceTypes.forEach(type => {
                assistanceTypeData[type] = allBarangaysDetailed.map(b => b[1][type] || 0);
            });

            return {
                barangayLabels: barangayLabelsDetailed,
                barangayTotals: barangayTotalsDetailed,
                assistanceTypes: allAssistanceTypes,
                assistanceTypeData: assistanceTypeData
            };
        }

