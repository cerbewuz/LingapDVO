        function updateBarangayChart() {
            if (!window.chartData) return;

            const chartType = document.getElementById('barangayChartType').value;
            const viewType = document.getElementById('barangayView').value;

            let labels, totals;
            let assistanceData = {};

            if (viewType === 'all') {
                labels = [...window.chartData.barangayLabels];
                totals = [...window.chartData.barangayTotals];
                window.chartData.assistanceTypes.forEach(type => {
                    assistanceData[type] = [...window.chartData.assistanceTypeData[type]];
                });
            } else {
                const limit = viewType === 'top10' ? 10 : 20;
                labels = window.chartData.barangayLabels.slice(0, limit);
                totals = window.chartData.barangayTotals.slice(0, limit);
                window.chartData.assistanceTypes.forEach(type => {
                    assistanceData[type] = window.chartData.assistanceTypeData[type].slice(0, limit);
                });
            }

            const ctx = document.getElementById('barangayChart');
            if (!ctx) return;

            const context = ctx.getContext('2d');
