        function processTrendsData(applications, timeframe) {
            const data = { labels: [], hospital: [], medical: [], funeral: [] };
            const counts = {};

            applications.forEach(app => {
                if (!app.createdAt) return;

                const date = new Date(app.createdAt);
                let key;

                if (timeframe === 'daily') {
                    key = date.toISOString().split('T')[0];
                } else if (timeframe === 'weekly') {
                    const weekStart = new Date(date);
                    weekStart.setDate(date.getDate() - date.getDay());
                    key = weekStart.toISOString().split('T')[0];
                } else {
                    key = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
                }

                if (!counts[key]) {
                    counts[key] = { hospital: 0, medical: 0, funeral: 0 };
                }

                if (app.type === "Hospital Bill Assistance") counts[key].hospital++;
                else if (app.type === "Medical and Laboratory Procedure") counts[key].medical++;
                else if (app.type === "Funeral and Burial Assistance") counts[key].funeral++;
            });

            const sortedKeys = Object.keys(counts).sort();
            const limit = timeframe === 'daily' ? 30 : 12;
            const recentKeys = sortedKeys.slice(-limit);

            recentKeys.forEach(key => {
                let label;
                if (timeframe === 'daily') {
                    label = new Date(key).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
                } else if (timeframe === 'weekly') {
                    const weekStart = new Date(key);
                    label = `Week of ${weekStart.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}`;
                } else {
                    label = new Date(key + '-01').toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
                }

                data.labels.push(label);
                data.hospital.push(counts[key].hospital);
                data.medical.push(counts[key].medical);
                data.funeral.push(counts[key].funeral);
            });

            return data;
        }

