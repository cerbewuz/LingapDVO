        function calculateApprovalRates(applications) {
            const types = {
                hospital: { approved: 0, disapproved: 0, pending: 0, total: 0 },
                medical: { approved: 0, disapproved: 0, pending: 0, total: 0 },
                funeral: { approved: 0, disapproved: 0, pending: 0, total: 0 }
            };

            applications.forEach(app => {
                let typeKey;
                if (app.type === 'Hospital Assistance') typeKey = 'hospital';
                else if (app.type === 'Other Assistance') typeKey = 'medical';
                else if (app.type === 'Funeral Assistance') typeKey = 'funeral';
                else return;

                types[typeKey].total++;

                if (app.status3 && (app.status3.toLowerCase() === 'claims' || app.status3.toLowerCase() === 'claimed')) {
                    return;
                }

                if (app.status2 && app.status2.trim() !== '' && app.status2 === 'approve') {
                    types[typeKey].approved++;
                } else if (app.status2 && app.status2.trim() !== '' && app.status2 === 'disapprove') {
                    types[typeKey].disapproved++;
                } else {
                    types[typeKey].pending++;
                }
            });

            return {
                approved: [types.hospital.approved, types.medical.approved, types.funeral.approved],
                disapproved: [types.hospital.disapproved, types.medical.disapproved, types.funeral.disapproved],
                pending: [types.hospital.pending, types.medical.pending, types.funeral.pending],
                totals: [types.hospital.total, types.medical.total, types.funeral.total]
            };
        }

