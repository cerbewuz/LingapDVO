        function calculateProcessingTimes(applications) {
            const stats = {
                hospital: { total: 0, count: 0 },
                medical: { total: 0, count: 0 },
                funeral: { total: 0, count: 0 }
            };

            applications.forEach(app => {
                // Only calculate for approved/disapproved applications
                if (!app.status2 || (app.status2 !== 'approve' && app.status2 !== 'disapprove')) return;
                if (!app.createdAt) return;

                let category;
                if (app.type === "Hospital Bill Assistance") category = 'hospital';
                else if (app.type === "Medical and Laboratory Procedure") category = 'medical';
                else if (app.type === "Funeral and Burial Assistance") category = 'funeral';
                else return;

                // Calculate time in hours from submission to approval
                const submitted = new Date(app.createdAt);
                const now = new Date();
                const hours = (now - submitted) / (1000 * 60 * 60);

                stats[category].total += hours;
                stats[category].count++;
            });

            const avgHospital = stats.hospital.count > 0 ? stats.hospital.total / stats.hospital.count : 0;
            const avgMedical = stats.medical.count > 0 ? stats.medical.total / stats.medical.count : 0;
            const avgFuneral = stats.funeral.count > 0 ? stats.funeral.total / stats.funeral.count : 0;
            const overallAvg = (stats.hospital.count + stats.medical.count + stats.funeral.count) > 0 ?
                (stats.hospital.total + stats.medical.total + stats.funeral.total) /
                (stats.hospital.count + stats.medical.count + stats.funeral.count) : 0;

            return {
                averageTimes: [avgHospital, avgMedical, avgFuneral, overallAvg],
                counts: [stats.hospital.count, stats.medical.count, stats.funeral.count,
                        stats.hospital.count + stats.medical.count + stats.funeral.count]
            };
        }

