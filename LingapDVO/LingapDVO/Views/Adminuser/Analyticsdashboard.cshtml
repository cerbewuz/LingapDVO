                    </div>
                </div>
                <div class="col-md-2">
                    <div class="card-analytics summary-card summary-approved" onclick="redirectToApplicationDashboard('approved')">
                        <div class="summary-icon">
                            <i class="bi bi-check-circle"></i>
                        </div>
                        <div class="summary-number">${statusCounts.approved}</div>
                        <div class="summary-label">Approved</div>
                    </div>
