        function calculateStatusByType(applications) {
            const types = {
                hospital: { approved: 0, disapproved: 0, pending: 0, processing: 0, claims: 0, total: 0 },
                medical: { approved: 0, disapproved: 0, pending: 0, processing: 0, claims: 0, total: 0 },
                funeral: { approved: 0, disapproved: 0, pending: 0, processing: 0, claims: 0, total: 0 }
            };

            applications.forEach(app => {
                let typeKey;
                if (app.type === 'Hospital Assistance') typeKey = 'hospital';
                else if (app.type === 'Other Assistance') typeKey = 'medical';
                else if (app.type === 'Funeral Assistance') typeKey = 'funeral';
                else return;

                types[typeKey].total++;

                if (app.status3 && (app.status3.toLowerCase() === 'claims' || app.status3.toLowerCase() === 'claimed')) {
                    types[typeKey].claims++;
                    return;
                }

                if (app.status2 && app.status2.trim() !== '' && app.status2 === 'approve') {
                    types[typeKey].approved++;
                } else if (app.status2 && app.status2.trim() !== '' && app.status2 === 'disapprove') {
                    types[typeKey].disapproved++;
                } else {
                    if (app.status === 'pending') {
                        types[typeKey].pending++;
                    } else if (app.status === 'processing') {
                        types[typeKey].processing++;
                    }
                }
            });

            return {
                approved: [types.hospital.approved, types.medical.approved, types.funeral.approved],
                pending: [types.hospital.pending, types.medical.pending, types.funeral.pending],
                processing: [types.hospital.processing, types.medical.processing, types.funeral.processing],
                disapproved: [types.hospital.disapproved, types.medical.disapproved, types.funeral.disapproved],
                claims: [types.hospital.claims, types.medical.claims, types.funeral.claims],
                totals: [types.hospital.total, types.medical.total, types.funeral.total]
            };
        }

        function updateClaimRateMetrics() {
            if (!filteredData) return;

            const claimData = calculateClaimRates(filteredData.allApplications);
            const container = document.getElementById('claimRateMetrics');

            document.getElementById('totalApproved').textContent = claimData.overall.approved;
            document.getElementById('totalClaimed').textContent = claimData.overall.claims;
            document.getElementById('overallClaimRate').textContent = claimData.overall.rate + '%';

            container.innerHTML = `
                <div class="col-md-3">
                    <div class="claim-metric-card">
                        <div class="claim-metric-label">Overall Claim Rate</div>
                        <div class="claim-metric-value" style="color: ${colors.info};">${claimData.overall.rate}%</div>
                        <div class="claim-progress-bar">
                            <div class="claim-progress-fill" style="width: ${claimData.overall.rate}%;"></div>
                        </div>
                        <div class="metric-subtext">${claimData.overall.claims} of ${claimData.overall.approved} approved</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="claim-metric-card">
                        <div class="claim-metric-label">Hospital Assistance Claims</div>
                        <div class="claim-metric-value" style="color: ${colors.hospital};">${claimData.hospital.rate}%</div>
                        <div class="claim-progress-bar">
                            <div class="claim-progress-fill" style="width: ${claimData.hospital.rate}%; background: ${colors.hospital};"></div>
                        </div>
                        <div class="metric-subtext">${claimData.hospital.claims} of ${claimData.hospital.approved}</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="claim-metric-card">
                        <div class="claim-metric-label">Other Assistance Claims</div>
                        <div class="claim-metric-value" style="color: ${colors.medical};">${claimData.medical.rate}%</div>
                        <div class="claim-progress-bar">
                            <div class="claim-progress-fill" style="width: ${claimData.medical.rate}%; background: ${colors.medical};"></div>
                        </div>
                        <div class="metric-subtext">${claimData.medical.claims} of ${claimData.medical.approved}</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="claim-metric-card">
                        <div class="claim-metric-label">Funeral Assistance Claims</div>
                        <div class="claim-metric-value" style="color: ${colors.funeral};">${claimData.funeral.rate}%</div>
                        <div class="claim-progress-bar">
                            <div class="claim-progress-fill" style="width: ${claimData.funeral.rate}%; background: ${colors.funeral};"></div>
                        </div>
                        <div class="metric-subtext">${claimData.funeral.claims} of ${claimData.funeral.approved}</div>
                    </div>
                </div>
            `;
        }

        function calculateClaimRates(applications) {
            const data = {
                overall: { approved: 0, claims: 0, rate: 0 },
                hospital: { approved: 0, claims: 0, rate: 0 },
                medical: { approved: 0, claims: 0, rate: 0 },
                funeral: { approved: 0, claims: 0, rate: 0 }
            };

            applications.forEach(app => {
                let typeKey;
                if (app.type === 'Hospital Assistance') typeKey = 'hospital';
                else if (app.type === 'Other Assistance') typeKey = 'medical';
                else if (app.type === 'Funeral Assistance') typeKey = 'funeral';
                else return;

                if (app.status2 && app.status2.trim() !== '' && app.status2 === 'approve') {
                    data[typeKey].approved++;
                    data.overall.approved++;

                    if (app.status3 && (app.status3.toLowerCase() === 'claims' || app.status3.toLowerCase() === 'claimed')) {
                        data[typeKey].claims++;
                        data.overall.claims++;
                    }
                }
            });

            data.overall.rate = data.overall.approved > 0 ? Math.round((data.overall.claims / data.overall.approved) * 100) : 0;
            data.hospital.rate = data.hospital.approved > 0 ? Math.round((data.hospital.claims / data.hospital.approved) * 100) : 0;
            data.medical.rate = data.medical.approved > 0 ? Math.round((data.medical.claims / data.medical.approved) * 100) : 0;
            data.funeral.rate = data.funeral.approved > 0 ? Math.round((data.funeral.claims / data.funeral.approved) * 100) : 0;

            return data;
        }
    </script>
</body>
</html>