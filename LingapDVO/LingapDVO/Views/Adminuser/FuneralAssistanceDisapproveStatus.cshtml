</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        // Configure PDF.js worker
        if (typeof pdfjsLib !== 'undefined') {
            pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
        }

        // PDF Viewer Variables
        let currentPDF = null;
        let currentPage = 1;
        let totalPages = 1;
        let currentScale = 1.2;

        // Requestor's Name Variables
        const requestorFirstname = '@ViewData["RFirstname"]';
        const requestorMiddlename = '@ViewData["RMiddlename"]';
        const requestorLastname = '@ViewData["RLastname"]';
        const requestorSuffix = '@ViewData["RSuffix"]';
        const requestorFullName = `${requestorFirstname} ${requestorMiddlename} ${requestorLastname}${requestorSuffix && requestorSuffix !== 'None' ? ' ' + requestorSuffix : ''}`.trim().replace(/\s+/g, ' ');

        // Image Zoom Functionality
        function zoomImage(src) {
            const modal = document.getElementById("zoomModal");
            const modalImg = document.getElementById("zoomedImage");
            if (modal && modalImg) {
                modal.style.display = "block";
                modalImg.src = src;
            }
        }

        // Close zoom modal
        document.addEventListener('DOMContentLoaded', function() {
            const closeZoom = document.querySelector(".close-zoom");
            if (closeZoom) {
                closeZoom.onclick = function() {
                    const modal = document.getElementById("zoomModal");
                    if (modal) modal.style.display = "none";
                }
            }
        });

        // PDF Viewer Function
        async function viewPDFInModal(fileName, fileType, displayName) {
            const modal = document.getElementById('pdfViewerModal');
            const title = document.getElementById('pdfViewerTitle');
            const loading = document.getElementById('pdfLoading');
            const errorDiv = document.getElementById('pdfError');
            const canvas = document.getElementById('pdfCanvas');
            const context = canvas ? canvas.getContext('2d') : null;
            const currentPageSpan = document.getElementById('currentPage');
            const totalPagesSpan = document.getElementById('totalPages');
            const zoomLevelSpan = document.getElementById('zoomLevel');
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');

            if (!modal || !title || !loading || !errorDiv || !canvas || !context) {
                console.error('PDF viewer elements not found');
                return;
            }

            title.textContent = displayName || 'PDF Document';
            modal.style.display = 'block';
            loading.style.display = 'flex';
            errorDiv.style.display = 'none';
            canvas.style.display = 'none';

            currentPDF = null;
            currentPage = 1;
            currentScale = 1.2;

            try {
                const encodedFileName = encodeURIComponent(fileName);
                const url = '@Url.Action("ViewPDF", "Dashboard")?fileName=' + encodedFileName + '&fileType=' + fileType + '&t=' + Date.now();

                const response = await fetch(url);
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const pdfData = await response.arrayBuffer();
                if (!pdfData || pdfData.byteLength === 0) {
                    throw new Error('PDF data is empty');
                }

                const loadingTask = pdfjsLib.getDocument({ data: pdfData });
                currentPDF = await loadingTask.promise;

                totalPages = currentPDF.numPages;
                if (totalPagesSpan) totalPagesSpan.textContent = totalPages;
                if (currentPageSpan) currentPageSpan.textContent = currentPage;

                updateNavigationButtons();
                await renderPage(currentPage);

                loading.style.display = 'none';
                canvas.style.display = 'block';
                if (zoomLevelSpan) zoomLevelSpan.textContent = Math.round(currentScale * 100) + '%';

            } catch (error) {
                console.error('Error loading PDF:', error);
                loading.style.display = 'none';
                errorDiv.style.display = 'block';
                if (errorDiv.querySelector('p')) {
                    errorDiv.querySelector('p').textContent = `Error loading PDF: ${error.message}`;
                }
            }
        }

        // Render specific page
        async function renderPage(pageNum) {
            if (!currentPDF) return;

            const canvas = document.getElementById('pdfCanvas');
            const context = canvas.getContext('2d');
            const currentPageSpan = document.getElementById('currentPage');

            if (!canvas || !context) return;

            try {
                const page = await currentPDF.getPage(pageNum);
                const viewport = page.getViewport({ scale: currentScale });

                canvas.height = viewport.height;
                canvas.width = viewport.width;

                const renderContext = {
                    canvasContext: context,
                    viewport: viewport
                };

                await page.render(renderContext).promise;
                if (currentPageSpan) currentPageSpan.textContent = pageNum;

            } catch (error) {
                console.error('Error rendering page:', error);
            }
        }

        // Navigation functions
        function nextPage() {
            if (currentPage < totalPages) {
                currentPage++;
                renderPage(currentPage);
                updateNavigationButtons();
            }
        }

        function prevPage() {
            if (currentPage > 1) {
                currentPage--;
                renderPage(currentPage);
                updateNavigationButtons();
            }
        }

        function zoomIn() {
            currentScale += 0.2;
            renderPage(currentPage);
            const zoomLevelSpan = document.getElementById('zoomLevel');
            if (zoomLevelSpan) zoomLevelSpan.textContent = Math.round(currentScale * 100) + '%';
        }

        function zoomOut() {
            if (currentScale > 0.5) {
                currentScale -= 0.2;
                renderPage(currentPage);
                const zoomLevelSpan = document.getElementById('zoomLevel');
                if (zoomLevelSpan) zoomLevelSpan.textContent = Math.round(currentScale * 100) + '%';
            }
        }

        function updateNavigationButtons() {
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');

            if (prevBtn) prevBtn.disabled = currentPage <= 1;
            if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
        }

        // Close PDF Viewer
        function closePDFViewer() {
            const modal = document.getElementById('pdfViewerModal');
            if (modal) {
                modal.style.display = 'none';
            }

            if (currentPDF) {
                currentPDF.destroy();
                currentPDF = null;
            }
        }

        // Status Submission Functions
        function markAsClaimed() {
            // Set the status to "Claimed"
            const statusInput = document.getElementById('statusInput');
            const commentsInput = document.getElementById('commentsInput');
            const processByInput = document.getElementById('processByInput');

            if (statusInput) statusInput.value = 'Claimed';
            if (commentsInput) commentsInput.value = `Application marked as claimed by ${requestorFullName} (the requestor)`;
            if (processByInput) {
                const processedBy = document.getElementById('processedBy');
                if (processedBy) processByInput.value = processedBy.value;
            }

            // Show success modal
            showSuccessModal();

            // Submit the form after a short delay to show the modal
            setTimeout(() => {
                document.getElementById('statusForm').submit();
            }, 2000); // Show modal for 2 seconds before redirecting
        }

        function showSuccessModal() {
            const modal = document.getElementById('successModal');
            if (modal) modal.style.display = 'block';
        }

        // Funeral Information Functions - IMPORTED FROM FIRST CODE
        function getFuneralAssistanceFields() {
            return {
                names: [
                    'DeceasedPersonName',
                    'RelationshipToDeceased',
                    'DateOfDeath',
                    'TimeOfDeath',
                    'CauseOfDeath',
                    'FuneralHomeName',
                    'FuneralHomeAddress',
                    'BurialCremationDate',
                    'BurialCremationTime',
                    'BurialCremationType'
                ],
                labels: [
                    'Name of Deceased Person',
                    'Relationship to Deceased',
                    'Date of Death',
                    'Time of Death',
                    'Cause of Death',
                    'Funeral Home/Parlor Name',
                    'Funeral Home/Parlor Address',
                    'Date of Burial/Cremation',
                    'Time of Burial/Cremation',
                    'Type (Burial/Cremation)'
                ],
                values: [
                    '@ViewData["DeceasedPersonName"]',
                    '@ViewData["RelationshipToDeceased"]',
                    '@ViewData["DateOfDeath"]',
                    '@ViewData["TimeOfDeath"]',
                    '@ViewData["CauseOfDeath"]',
                    '@ViewData["FuneralHomeName"]',
                    '@ViewData["FuneralHomeAddress"]',
                    '@ViewData["BurialCremationDate"]',
                    '@ViewData["BurialCremationTime"]',
                    '@ViewData["BurialCremationType"]'
                ]
            };
        }

        // Toggle function for Funeral Information (View/Hide) - IMPORTED FROM FIRST CODE
        function toggleFuneralInfo() {
            const viewButton = document.getElementById('viewFuneralInfoBtn');
            const isDecrypted = viewButton.getAttribute('data-decrypted') === 'true';

            if (isDecrypted) {
                // Currently showing decrypted data, hide it
                hideFuneralInfo();
            } else {
                // Currently hidden, show the decrypt modal
                openViewAdditionalInfoModal('Funeral', '@ViewData["Id"]', getFuneralAssistanceFields());
            }
        }

        // Function to hide funeral information - IMPORTED FROM FIRST CODE
        function hideFuneralInfo() {
            const funeralInfoContainer = document.getElementById('funeralInfoContainer');
            const funeralInfoEncrypted = document.getElementById('funeralInfoEncrypted');
            const funeralInfoAlert = document.getElementById('funeralInfoAlert');
            const viewButton = document.getElementById('viewFuneralInfoBtn');
            const btnIcon = document.getElementById('funeralBtnIcon');
            const btnText = document.getElementById('funeralBtnText');

            // Hide decrypted data container
            if (funeralInfoContainer) {
                funeralInfoContainer.classList.remove('funeral-info-visible');
                funeralInfoContainer.style.display = 'none';
            }

            // Show encrypted data display
            if (funeralInfoEncrypted) {
                funeralInfoEncrypted.style.display = 'block';
            }

            // Show alert
            if (funeralInfoAlert) {
                funeralInfoAlert.style.display = 'flex';
            }

            // Update button to "View" state
            if (viewButton) {
                viewButton.setAttribute('data-decrypted', 'false');
                viewButton.classList.remove('btn-warning');
                viewButton.classList.add('btn-primary');
            }
            if (btnIcon) {
                btnIcon.classList.remove('bi-eye-slash-fill');
                btnIcon.classList.add('bi-eye-fill');
            }
            if (btnText) {
                btnText.textContent = 'View Funeral Information';
            }

            // Clear decrypted data
            window.decryptedFuneralData = {};
        }

        // Function to show funeral information after successful decryption - IMPORTED FROM FIRST CODE
        function showFuneralInfoAfterDecryption() {
            console.log('Showing funeral information after decryption...');

            // Hide the loading container
            const loadingContainer = document.getElementById('funeralLoadingContainer');
            if (loadingContainer) {
                loadingContainer.style.display = 'none';
            }

            // Hide the encrypted display section
            const funeralInfoEncrypted = document.getElementById('funeralInfoEncrypted');
            if (funeralInfoEncrypted) {
                funeralInfoEncrypted.style.display = 'none';
            }

            // Hide the alert
            const funeralInfoAlert = document.getElementById('funeralInfoAlert');
            if (funeralInfoAlert) {
                funeralInfoAlert.style.display = 'none';
            }

            // Show the funeral information container (decrypted)
            const funeralInfoContainer = document.getElementById('funeralInfoContainer');
            if (funeralInfoContainer) {
                funeralInfoContainer.style.display = 'block';
                funeralInfoContainer.classList.add('funeral-info-visible', 'decrypted-display');

                // Scroll to the funeral information section
                setTimeout(() => {
                    funeralInfoContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 100);
            }

            // Update button to "Hide" state
            const viewButton = document.getElementById('viewFuneralInfoBtn');
            const btnIcon = document.getElementById('funeralBtnIcon');
            const btnText = document.getElementById('funeralBtnText');

            if (viewButton) {
                viewButton.setAttribute('data-decrypted', 'true');
                viewButton.classList.remove('btn-primary');
                viewButton.classList.add('btn-warning');
            }
            if (btnIcon) {
                btnIcon.classList.remove('bi-eye-fill');
                btnIcon.classList.add('bi-eye-slash-fill');
            }
            if (btnText) {
                btnText.textContent = 'Hide Funeral Information';
            }
        }

        // Function to start the 5-second loading animation - IMPORTED FROM FIRST CODE
        function startFuneralInfoLoading() {
            console.log('Starting funeral information loading...');

            // Hide alert
            const funeralInfoAlert = document.getElementById('funeralInfoAlert');
            if (funeralInfoAlert) {
                funeralInfoAlert.style.display = 'none';
            }

            // Show loading container
            const loadingContainer = document.getElementById('funeralLoadingContainer');
            if (loadingContainer) {
                loadingContainer.style.display = 'block';
            }

            // Hide encrypted display
            const funeralInfoEncrypted = document.getElementById('funeralInfoEncrypted');
            if (funeralInfoEncrypted) {
                funeralInfoEncrypted.style.display = 'none';
            }

            // Hide any existing funeral info container
            const funeralInfoContainer = document.getElementById('funeralInfoContainer');
            if (funeralInfoContainer) {
                funeralInfoContainer.style.display = 'none';
                funeralInfoContainer.classList.remove('funeral-info-visible');
            }

            // Start 5-second progress bar
            const progressBar = document.getElementById('funeralLoadingProgress');
            if (progressBar) {
                let progress = 0;
                const totalTime = 5000; // 5 seconds
                const interval = 100; // Update every 100ms
                const increment = (interval / totalTime) * 100;

                const progressInterval = setInterval(() => {
                    progress += increment;
                    if (progress >= 100) {
                        progress = 100;
                        clearInterval(progressInterval);

                        // After 5 seconds, show the funeral information
                        setTimeout(() => {
                            showFuneralInfoAfterDecryption();
                        }, 300);
                    } else {
                        progressBar.style.width = progress + '%';
                    }
                }, interval);
            }
        }

        // Comments modal functions (if needed for other actions)
        function showCommentsModal() {
            const modal = document.getElementById('commentsModal');
            const textarea = document.getElementById('commentsTextarea');
            if (modal) modal.style.display = 'block';
            if (textarea) textarea.focus();
        }

        function closeCommentsModal() {
            const modal = document.getElementById('commentsModal');
            const textarea = document.getElementById('commentsTextarea');
            if (modal) modal.style.display = 'none';
            if (textarea) {
                textarea.value = '';
                textarea.classList.remove('is-invalid');
            }
        }

        function submitDisapprove() {
            const commentsTextarea = document.getElementById('commentsTextarea');
            const comments = commentsTextarea ? commentsTextarea.value.trim() : '';

            if (comments === '') {
                if (commentsTextarea) {
                    commentsTextarea.classList.add('is-invalid');
                    commentsTextarea.focus();
                }
                return;
            }

            const statusInput = document.getElementById('statusInput');
            const commentsInput = document.getElementById('commentsInput');
            const processByInput = document.getElementById('processByInput');

            if (statusInput) statusInput.value = 'Disapprove';
            if (commentsInput) commentsInput.value = comments;
            if (processByInput) {
                const processedBy = document.getElementById('processedBy');
                if (processedBy) processByInput.value = processedBy.value;
            }

            // Show loading modal
            showSuccessModal();

            // Submit the form
            setTimeout(() => {
                document.getElementById('statusForm').submit();
            }, 500);
        }

        // Function to view encrypted Funeral Information
        function viewFuneralAdditionalInfo() {
            const formId = parseInt('@ViewData["Id"]');
            const encryptedFields = getFuneralAssistanceFields();

            openViewAdditionalInfoModal('Funeral', formId, encryptedFields);
        }

        // Keyboard shortcuts and navigation
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                const zoomModal = document.getElementById("zoomModal");
                if (zoomModal) zoomModal.style.display = "none";
                closePDFViewer();
                closeCommentsModal();
            }

            const pdfModal = document.getElementById('pdfViewerModal');
            if (pdfModal && pdfModal.style.display === 'block') {
                switch(e.key) {
                    case 'ArrowLeft':
                        e.preventDefault();
                        prevPage();
                        break;
                    case 'ArrowRight':
                        e.preventDefault();
                        nextPage();
                        break;
                    case '+':
                    case '=':
                        e.preventDefault();
                        zoomIn();
                        break;
                    case '-':
                        e.preventDefault();
                        zoomOut();
                        break;
                }
            }
        });

        // Close modal when clicking outside
        window.onclick = function(event) {
            const zoomModal = document.getElementById("zoomModal");
            const pdfModal = document.getElementById("pdfViewerModal");
            const commentsModal = document.getElementById("commentsModal");
            const successModal = document.getElementById("successModal");

            if (event.target == zoomModal && zoomModal) {
                zoomModal.style.display = "none";
            }
            if (event.target == pdfModal && pdfModal) {
                closePDFViewer();
            }
            if (event.target == commentsModal && commentsModal) {
                closeCommentsModal();
            }
            if (event.target == successModal && successModal) {
                successModal.style.display = "none";
            }
        }

        // Add this function to handle the modal callback from _ViewEncryptedDataModalForAdmin
        window.openViewAdditionalInfoModal = function(assistanceType, formId, fields) {
            // This function is defined in _ViewEncryptedDataModalForAdmin partial view
            // It will be called when the user clicks the "View Funeral Information" button
            console.log('Opening modal for funeral info');

            // Start the loading animation immediately
            startFuneralInfoLoading();

            // The actual modal opening and password verification will be handled by the partial view
            // We need to trigger the modal from the partial view
            if (typeof window.showPasswordModal === 'function') {
                window.showPasswordModal(assistanceType, formId, fields, function() {
                    // This callback will be executed after successful decryption
                    console.log('Funeral info decrypted successfully');
                });
            }
        };
    </script>

    @Html.Partial("_ViewEncryptedDataModalForAdmin")
    @Html.Partial("_ViewEncryptedIDModal")
}