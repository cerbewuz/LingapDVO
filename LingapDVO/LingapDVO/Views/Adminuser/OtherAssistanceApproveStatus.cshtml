        // Keyboard shortcuts for PDF viewer
        document.addEventListener('keydown', function(e) {
            const pdfViewer = document.getElementById("pdfViewerOverlay");
            if (!pdfViewer || pdfViewer.style.display !== "block") return;

            switch(e.key) {
                case 'Escape':
                    closePDFViewer();
                    e.preventDefault();
                    break;
                case 'ArrowLeft':
                    pdfPrevPage();
                    e.preventDefault();
                    break;
                case 'ArrowRight':
                    pdfNextPage();
                    e.preventDefault();
                    break;
                case '+':
                case '=':
                    if (e.ctrlKey || e.metaKey) {
                        pdfZoomIn();
                        e.preventDefault();
                    }
                    break;
                case '-':
                    if (e.ctrlKey || e.metaKey) {
                        pdfZoomOut();
                        e.preventDefault();
                    }
                    break;
                case '0':
                    if (e.ctrlKey || e.metaKey) {
                        pdfScale = 1.0;
                        renderPDFPage(currentPdfPage);
                        e.preventDefault();
                    }
                    break;
                case 'Home':
                    currentPdfPage = 1;
                    renderPDFPage(currentPdfPage);
                    e.preventDefault();
                    break;
                case 'End':
                    currentPdfPage = totalPdfPages;
                    renderPDFPage(currentPdfPage);
                    e.preventDefault();
                    break;
            }
        });

        // Touch gestures for mobile
        let touchStartX = 0;
        let touchStartY = 0;

        document.addEventListener('touchstart', function(e) {
            const pdfViewer = document.getElementById("pdfViewerOverlay");
            if (!pdfViewer || pdfViewer.style.display !== "block") return;

            touchStartX = e.touches[0].clientX;
            touchStartY = e.touches[0].clientY;
        });

        document.addEventListener('touchend', function(e) {
            const pdfViewer = document.getElementById("pdfViewerOverlay");
            if (!pdfViewer || pdfViewer.style.display !== "block") return;

            const touchEndX = e.changedTouches[0].clientX;
            const touchEndY = e.changedTouches[0].clientY;
            const diffX = touchStartX - touchEndX;
            const diffY = touchStartY - touchEndY;

            // Horizontal swipe for page navigation (min 50px swipe)
            if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 50) {
                if (diffX > 0) {
                    // Swipe left - next page
                    pdfNextPage();
                } else {
                    // Swipe right - previous page
                    pdfPrevPage();
                }
            }
        });

        // Add resize handler for responsive PDF viewer
        window.addEventListener('resize', function() {
            const pdfViewer = document.getElementById("pdfViewerOverlay");
            if (pdfViewer && pdfViewer.style.display === "block" && pdfDocument) {
                // Re-render current page on resize
                renderPDFPage(currentPdfPage);
            }
        });

        // Close modals when clicking outside
        window.addEventListener('click', function(event) {
            const successModal = document.getElementById('successModal');

            if (event.target === successModal) {
                successModal.style.display = 'none';
            }
        });
    </script>

