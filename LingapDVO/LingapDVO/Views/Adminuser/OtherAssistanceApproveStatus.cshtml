                ];
            } else if (assistanceType === 'Laboratory/X-ray/ECG/2D Echo Assistance') {
                fieldNames = ['LaboratoryCenterName', 'LaboratoryCenterAddress', 'TestName', 'TestCost', 'TestOtherInfo'];
                fieldLabels = ['Laboratory Center Name', 'Laboratory Center Address', 'Test Name', 'Test Cost', 'Test Other Info'];
                fieldValues = [
