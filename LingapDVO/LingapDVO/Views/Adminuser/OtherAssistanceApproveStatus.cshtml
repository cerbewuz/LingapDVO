@model OtherAssistanceDto
@{
    Layout = "_ViewFormsLayout";
    ViewData["Title"] = "Other Assistance View";
    var selectedSex = ViewData["Sex"]?.ToString();
    var checkedAssistance = ViewData["CheckedAssistance"] as Dictionary<string, string> ?? new();
    var checkedCMO = ViewData["CheckedCMOPERSONNEL"] as Dictionary<string, string> ?? new Dictionary<string, string>();
}

<style>
    /* Remove borders since layout already has them */
    .receipt-container {
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
    }

    .receipt-header {
        border: none !important;
    }

    .receipt-body {
        padding: 1rem !important;
    }

    /* Additional Information Styles */
    .additional-info-container {
        display: none;
        background-color: transparent;
        border: none;
        border-radius: 0;
        padding: 0;
        margin-top: 0.5rem;
        animation: fadeInScale 0.4s ease-out;
    }

    .additional-info-visible {
        display: block;
    }

    /* Decrypted display - match encrypted section styling */
    .decrypted-display {
        background-color: transparent;
        border: none;
        border-radius: 0;
        padding: 0;
    }

    .decrypted-field {
        background-color: transparent;
        border-radius: 0;
        padding: 0;
        border: none;
        display: flex;
        margin-bottom: 0.5rem;
        flex-wrap: wrap;
    }

        .decrypted-field:hover {
            border-color: transparent;
            box-shadow: none;
            transform: none;
            background-color: transparent;
        }

    .decrypted-value {
        background-color: transparent;
        border: none;
        border-radius: 0;
        padding: 0;
        font-size: 0.95rem;
        color: #2d3748;
        flex: 1;
    }

    .decrypted-field .info-label {
        color: #6c757d !important;
        font-weight: 500;
    }

        .decrypted-field .info-label i {
            color: #2d3748 !important;
        }

    /* Animation for decrypted display */
    @@keyframes fadeInScale {
        from {
            opacity: 0;
            transform: scale(0.95);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    /* Encrypted Display Styles */
    .encrypted-info-section {
        background-color: transparent;
        border-radius: 0;
        padding: 0;
        border: none;
    }

    .encrypted-display {
        background-color: transparent;
        border: none;
        border-radius: 0;
        padding: 0;
        font-family: 'Courier New', monospace;
        font-size: 0.85rem;
        color: #6c757d;
        overflow-x: auto;
        white-space: nowrap;
    }

    .encrypted-text {
        letter-spacing: 0.5px;
    }

    /* Alert styling */
    .alert-info {
        background-color: #e7f3ff;
        border-color: #b3d9ff;
        color: #004085;
    }

        .alert-info i {
            font-size: 1.25rem;
            color: #0066cc;
        }

    /* Info label color for dark background */
    .info-label {
        color: #bdc3c7;
    }

    /* Valid ID Styles */
    .valid-id-loading {
        display: none;
        background-color: transparent;
        border-radius: 0;
        padding: 1rem 0;
        margin-top: 0.5rem;
        border: none;
        text-align: center;
    }

    .valid-id-container {
        display: none;
        background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
        border: 2px solid #1a252f;
        border-radius: 12px;
        padding: 1.5rem;
        margin-top: 1rem;
        animation: fadeInScale 0.4s ease-out;
        color: white;
    }

    .id-image-container {
        cursor: pointer;
        transition: transform 0.2s;
        margin-bottom: 15px;
    }

        .id-image-container:hover {
            transform: scale(1.02);
        }

    .id-image {
        width: 100%;
        height: 200px;
        object-fit: contain;
        background-color: #f8f9fa;
        border: 1px solid var(--border-color);
        border-radius: 5px;
        padding: 10px;
    }

    /* Zoom Modal */
    .zoom-modal {
        display: none;
        position: fixed;
        z-index: 1000;
        padding-top: 50px;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.9);
    }

    .zoom-modal-content {
        margin: auto;
        display: block;
        max-width: 90%;
        max-height: 90%;
        object-fit: contain;
    }

    .close-zoom {
        position: absolute;
        top: 15px;
        right: 35px;
        color: #fff;
        font-size: 40px;
        font-weight: bold;
        cursor: pointer;
        transition: color 0.2s ease;
    }

        .close-zoom:hover {
            color: #3498db;
        }

    /* PDF Preview Styles */
    .pdf-preview-container {
        cursor: pointer;
        transition: transform 0.2s ease;
        margin-bottom: 15px;
    }

        .pdf-preview-container:hover {
            transform: translateY(-2px);
        }

    .pdf-preview {
        display: flex;
        align-items: center;
        padding: 15px;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        background-color: #f8f9fa;
        transition: all 0.3s ease;
    }

        .pdf-preview:hover {
            border-color: #3498db;
            background-color: #e8f4fd;
        }

    .pdf-preview-icon {
        font-size: 3rem;
        color: #e74c3c;
        margin-right: 15px;
        flex-shrink: 0;
    }

    .pdf-preview-info {
        flex: 1;
        min-width: 0;
    }

    .pdf-preview-filename {
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 5px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: 1rem;
    }

    .pdf-preview-label {
        font-size: 0.85rem;
        color: #7f8c8d;
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .pdf-preview-label i {
            font-size: 0.9rem;
        }

    /* Status Buttons Styling */
    .status-buttons {
        display: flex;
        justify-content: center;
        gap: 1rem;
        margin-top: 1rem;
        flex-wrap: wrap;
    }

    .btn-claimed {
        background-color: #17a2b8;
        border-color: #17a2b8;
        color: white;
        padding: 0.75rem 2rem;
        font-weight: 600;
        border-radius: 5px;
        margin: 0 0.5rem;
        transition: all 0.3s ease;
        border: none;
        cursor: pointer;
    }

        .btn-claimed:hover {
            background-color: #138496;
            border-color: #117a8b;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .status-buttons {
            flex-direction: column;
            align-items: center;
        }

        .btn-claimed {
            width: 100%;
            max-width: 300px;
            margin: 5px 0;
            padding: 0.6rem 1.5rem;
            font-size: 0.85rem;
        }
    }

    @@media (max-width: 480px) {
        .btn-claimed {
            padding: 0.5rem 1rem;
            font-size: 0.8rem;
        }
    }

    /* Success Modal */
    .success-modal {
        display: none;
        position: fixed;
        z-index: 4000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.7);
    }

    .success-modal-content {
        background-color: white;
        margin: 15% auto;
        padding: 2rem;
        border-radius: 10px;
        width: 90%;
        max-width: 400px;
        text-align: center;
        box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    }

    .success-icon {
        font-size: 3rem;
        color: #28a745;
        margin-bottom: 1rem;
    }

    /* Receipt Sections */
    .receipt-section {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
    }

    .section-header {
        color: var(--primary-color);
        font-weight: 600;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--primary-light);
    }

    .info-row {
        display: flex;
        margin-bottom: 0.5rem;
        flex-wrap: wrap;
    }

    .info-label {
        flex: 0 0 30%;
        font-weight: 500;
        color: var(--secondary-color);
        min-width: 150px;
    }

    .info-value {
        flex: 1;
        color: #555;
        min-width: 200px;
    }

    /* Status Badges */
    .status-badge {
        display: inline-block;
        padding: 0.35rem 0.75rem;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .status-pending {
        background-color: #fff3cd;
        color: #856404;
    }

    .status-approve {
        background-color: #d4edda;
        color: #155724;
    }

    .status-disapprove {
        background-color: #f8d7da;
        color: #721c24;
    }

    .status-processing {
        background-color: #cce5ff;
        color: #004085;
    }

    .status-claimed {
        background-color: #d1ecf1;
        color: #0c5460;
    }

    .status-retake {
        background-color: #fff3e0;
        color: #ff6f00;
    }

    /* Full-screen PDF Viewer Styles (from first code) */
    .pdf-viewer-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.95);
        z-index: 9999;
        overflow: hidden;
    }

    .pdf-viewer-container {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .pdf-viewer-toolbar {
        background-color: #1a1a1a;
        color: white;
        padding: 15px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #333;
        flex-shrink: 0;
    }

    .pdf-viewer-title {
        font-size: 1.1rem;
        font-weight: 500;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 50%;
    }

    .pdf-viewer-controls {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .pdf-viewer-btn {
        background-color: #333;
        color: white;
        border: 1px solid #555;
        padding: 8px 15px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 5px;
        transition: all 0.2s ease;
    }

        .pdf-viewer-btn:hover {
            background-color: #444;
            border-color: #666;
        }

        .pdf-viewer-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .pdf-page-info {
        color: #ccc;
        font-size: 0.9rem;
        min-width: 100px;
        text-align: center;
    }

    .pdf-zoom-info {
        color: #ccc;
        font-size: 0.9rem;
        min-width: 60px;
        text-align: center;
    }

    .pdf-viewer-close {
        background: none;
        border: none;
        color: white;
        font-size: 2rem;
        cursor: pointer;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        transition: background-color 0.2s ease;
    }

        .pdf-viewer-close:hover {
            background-color: #333;
        }

    .pdf-viewer-content {
        flex: 1;
        overflow: auto;
        background-color: #525659;
        position: relative;
    }

    .pdf-viewer-inner {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        min-height: 100%;
        padding: 20px;
    }

    .pdf-canvas-container {
        position: relative;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
        background-color: white;
        margin: auto;
    }

    #pdfCanvas {
        display: block;
        max-width: 100%;
        height: auto;
    }

    .pdf-loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.8);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 100;
    }

    .pdf-loading-spinner {
        width: 50px;
        height: 50px;
        border: 4px solid #f3f3f3;
        border-top: 4px solid #3498db;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin-bottom: 15px;
    }

    .pdf-loading-text {
        color: white;
        font-size: 1.1rem;
    }

    .pdf-error-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.9);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 100;
        display: none;
    }

    .pdf-error-icon {
        font-size: 4rem;
        color: #e74c3c;
        margin-bottom: 20px;
    }

    .pdf-error-text {
        color: white;
        font-size: 1.2rem;
        text-align: center;
        max-width: 80%;
        margin-bottom: 20px;
    }

    .pdf-retry-btn {
        background-color: #3498db;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 4px;
        cursor: pointer;
        font-size: 1rem;
        transition: background-color 0.2s ease;
    }

        .pdf-retry-btn:hover {
            background-color: #2980b9;
        }

    @@keyframes spin {
        0%

    {
        transform: rotate(0deg);
    }

    100% {
        transform: rotate(360deg);
    }

    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .info-row

    {
        flex-direction: column;
    }

    .info-label {
        margin-bottom: 0.3rem;
    }

    .status-buttons {
        flex-direction: column;
        align-items: center;
    }

    .btn-claimed {
        width: 100%;
        max-width: 300px;
        margin: 5px 0;
    }

    .id-image {
        height: 150px;
    }

    }</style>

<!-- Full-screen PDF Viewer -->
<div id="pdfViewerOverlay" class="pdf-viewer-overlay">
    <div class="pdf-viewer-container">
        <div class="pdf-viewer-toolbar">
            <h2 class="pdf-viewer-title" id="pdfViewerTitle">PDF Document</h2>
            <div class="pdf-viewer-controls">
                <button class="pdf-viewer-btn" onclick="pdfPrevPage()" id="pdfPrevBtn" title="Previous Page">
                    <i class="bi bi-chevron-left"></i> Prev
                </button>
                <span class="pdf-page-info" id="pdfPageInfo">Page: 1/1</span>
                <button class="pdf-viewer-btn" onclick="pdfNextPage()" id="pdfNextBtn" title="Next Page">
                    Next <i class="bi bi-chevron-right"></i>
                </button>
                <button class="pdf-viewer-btn" onclick="pdfZoomOut()" title="Zoom Out">
                    <i class="bi bi-zoom-out"></i>
                </button>
                <span class="pdf-zoom-info" id="pdfZoomInfo">100%</span>
                <button class="pdf-viewer-btn" onclick="pdfZoomIn()" title="Zoom In">
                    <i class="bi bi-zoom-in"></i>
                </button>
                <button class="pdf-viewer-btn" onclick="pdfFitWidth()" title="Fit to Width">
                    <i class="bi bi-arrows-angle-expand"></i>
                </button>
                <button class="pdf-viewer-btn" onclick="pdfFitPage()" title="Fit to Page">
                    <i class="bi bi-aspect-ratio"></i>
                </button>
            </div>
            <button class="pdf-viewer-close" onclick="closePDFViewer()" title="Close PDF Viewer">
                &times;
            </button>
        </div>
        <div class="pdf-viewer-content">
            <div class="pdf-viewer-inner">
                <div class="pdf-canvas-container" id="pdfCanvasContainer">
                    <canvas id="pdfCanvas"></canvas>
                    <div class="pdf-loading-overlay" id="pdfLoadingOverlay">
                        <div class="pdf-loading-spinner"></div>
                        <div class="pdf-loading-text">Loading PDF document...</div>
                    </div>
                    <div class="pdf-error-overlay" id="pdfErrorOverlay">
                        <div class="pdf-error-icon">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>
                        <div class="pdf-error-text" id="pdfErrorText">Error loading PDF document</div>
                        <button class="pdf-retry-btn" onclick="retryPDFLoad()">Retry</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Image Zoom Modal -->
<div id="zoomModal" class="zoom-modal">
    <span class="close-zoom">&times;</span>
    <img class="zoom-modal-content" id="zoomedImage">
</div>

<!-- Success Modal -->
<div id="successModal" class="success-modal">
    <div class="success-modal-content">
        <div class="success-icon">
            <i class="bi bi-check-circle-fill"></i>
        </div>
        <h4>Status Updated Successfully!</h4>
        <p>Application marked as <strong>Claimed</strong></p>
        <p>Redirecting to Admin page...</p>
        <div class="mt-3">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </div>
</div>

<div class="receipt-container">
    <form asp-action="OtherAssistanceApproveStatus" asp-route-id="@ViewData["Id"]" method="post" id="statusForm">
        @Html.AntiForgeryToken()

        <!-- Hidden fields for form submission -->
        <input type="hidden" name="id" value="@ViewData["Id"]" />
        <input type="hidden" id="statusInput" name="status3" value="@ViewData["Status3"]">
        <input type="hidden" id="commentsInput" name="Comments" value="" />
        <input type="hidden" id="forCMOPersonnelInput" name="ForCMOPERSONNEL" value="@ViewData["ForCMOPERSONNEL"]" />
        <input type="hidden" id="processByInput" name="Processby" value="@Context.Session.GetString("AdminFullname")" />

        <div class="receipt-body">

            <!-- Patient Information -->
            <div class="receipt-section">
                <h5 class="section-header">Patient Information</h5>
                <div class="row">
                    <div class="col-md-6">
                        <div class="info-row">
                            <div class="info-label">Name:</div>
                            <div class="info-value">
                                @ViewData["Firstname"] @ViewData["Middlename"] @ViewData["Lastname"]
                                @(ViewData["Suffix"]?.ToString() == "None" ? "" : " " + ViewData["Suffix"])
                            </div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Address:</div>
                            <div class="info-value">@ViewData["BlkLotStreet"], @ViewData["SubVill"], @ViewData["Brgy"]</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Sex:</div>
                            <div class="info-value">@ViewData["Sex"]</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-row">
                            <div class="info-label">Date of Birth:</div>
                            <div class="info-value">@ViewData["Dateofbirth"]</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Age:</div>
                            <div class="info-value">@ViewData["Age"]</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">PhilHealth:</div>
                            <div class="info-value">@ViewData["PhilHealth"]</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">PhilHealth No:</div>
                            <div class="info-value">@ViewData["PhilHealthNo"]</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Requestor Details -->
            <div class="receipt-section">
                <h5 class="section-header">Requestor's Details</h5>
                <div class="info-row">
                    <div class="info-label">Full Name:</div>
                    <div class="info-value">@ViewData["RLastname"], @ViewData["RFirstname"] @ViewData["RMiddlename"] @ViewData["RSuffix"]</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Address:</div>
                    <div class="info-value">@ViewData["RBlkLotStreet"], @ViewData["RSubVill"], @ViewData["RBrgy"]</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Relationship to Patient:</div>
                    <div class="info-value">@ViewData["RelationshipPatient"]</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Contact No:</div>
                    <div class="info-value">@ViewData["ContactNo"]</div>
                </div>
            </div>

            <!-- Assistance Requested -->
            <div class="receipt-section">
                <h5 class="section-header">Assistance Requested</h5>
                <div class="info-value">@ViewData["Typeassistance"]</div>
            </div>

            <!-- Additional Information Section (Password-Protected) -->
            <div class="receipt-section">
                <h5 class="section-header d-flex align-items-center justify-content-between">
                    <span><i class="bi bi-shield-lock-fill me-2"></i>Additional Information (Encrypted)</span>
                    <button type="button" class="btn btn-sm btn-primary" id="viewAdditionalInfoBtn"
                            onclick="toggleAdditionalInfo()"
                            data-decrypted="false"
                            title="Click to view encrypted additional information">
                        <i class="bi bi-eye-fill me-2" id="additionalBtnIcon"></i><span id="additionalBtnText">View Additional Information</span>
                    </button>
                </h5>

                <!-- Alert shown when Additional Info is encrypted -->
                <div class="alert alert-info d-flex align-items-center mb-3" id="additionalInfoAlert">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    <div>
                        <strong>Additional Information is Encrypted</strong><br>
                        For security and privacy, additional information is encrypted. Click the "View Additional Information" button above and enter your password to view it.
                    </div>
                </div>

                <!-- Encrypted Additional Information Display (shown by default) -->
                <div class="encrypted-info-section" id="additionalInfoEncrypted">
                    @if (ViewData["Typeassistance"]?.ToString() == "Medicine Assistance")
                    {
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <div class="info-label">Medicine Name:</div>
                                    <div class="encrypted-display">
                                        <span class="encrypted-text">@ViewData["MedicineNameEncrypted"]</span>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <div class="info-label">Medicine Quantity:</div>
                                    <div class="encrypted-display">
                                        <span class="encrypted-text">@ViewData["MedicineQuantityEncrypted"]</span>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <div class="info-label">Medicine Cost:</div>
                                    <div class="encrypted-display">
                                        <span class="encrypted-text">@ViewData["MedicineCostEncrypted"]</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <div class="info-label">Prescribing Doctor:</div>
                                    <div class="encrypted-display">
                                        <span class="encrypted-text">@ViewData["PrescribingDoctorEncrypted"]</span>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <div class="info-label">Doctor Contact Detail:</div>
                                    <div class="encrypted-display">
                                        <span class="encrypted-text">@ViewData["DoctorContactDetailEncrypted"]</span>
                                    </div>
