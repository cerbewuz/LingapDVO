@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        // PDF.js configuration
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

        // PDF Viewer variables
        let pdfDocument = null;
        let currentPdfPage = 1;
        let totalPdfPages = 1;
        let pdfScale = 1.0;
        let currentFileName = '';
        let currentFileType = '';
        let currentDisplayName = '';

        // Image zoom function
        function zoomImage(src) {
            const modal = document.getElementById("zoomModal");
            const modalImg = document.getElementById("zoomedImage");
            if (modal && modalImg) {
                modal.style.display = "block";
                modalImg.src = src;
            }
        }

        // Close image zoom
        document.addEventListener('DOMContentLoaded', function() {
            const closeZoom = document.querySelector(".close-zoom");
            if (closeZoom) {
                closeZoom.onclick = function() {
                    const modal = document.getElementById("zoomModal");
                    if (modal) modal.style.display = "none";
                }
            }

            // Close on outside click
            window.onclick = function(event) {
                const modal = document.getElementById("zoomModal");
                if (event.target == modal && modal) {
                    modal.style.display = "none";
                }

                const pdfViewer = document.getElementById("pdfViewerOverlay");
                if (event.target == pdfViewer && pdfViewer) {
                    closePDFViewer();
                }
            }
        });

        // PDF Viewer functions
        async function viewPDF(fileName, fileType, displayName) {
            currentFileName = fileName;
            currentFileType = fileType;
            currentDisplayName = displayName || fileName;

            // Show PDF viewer
            const overlay = document.getElementById("pdfViewerOverlay");
            const title = document.getElementById("pdfViewerTitle");
            const loadingOverlay = document.getElementById("pdfLoadingOverlay");
            const errorOverlay = document.getElementById("pdfErrorOverlay");

            if (!overlay || !title || !loadingOverlay || !errorOverlay) return;

            // Reset state
            pdfDocument = null;
            currentPdfPage = 1;
            totalPdfPages = 1;
            pdfScale = 1.0;

            // Update UI
            overlay.style.display = "block";
            document.body.style.overflow = "hidden"; // Prevent scrolling
            title.textContent = currentDisplayName;
            loadingOverlay.style.display = "flex";
            errorOverlay.style.display = "none";

            // Update controls
            updatePDFControls();

            try {
                // Build URL for PDF file
                const encodedFileName = encodeURIComponent(fileName);
                const url = '@Url.Action("ViewPDF", "Dashboard")?fileName=' + encodedFileName +
                           '&fileType=' + fileType + '&t=' + Date.now();

                // Load PDF document
                const loadingTask = pdfjsLib.getDocument(url);
                pdfDocument = await loadingTask.promise;
                totalPdfPages = pdfDocument.numPages;

                // Render first page
                await renderPDFPage(currentPdfPage);
                loadingOverlay.style.display = "none";

            } catch (error) {
                console.error("Error loading PDF:", error);
                loadingOverlay.style.display = "none";
                errorOverlay.style.display = "flex";
                document.getElementById("pdfErrorText").textContent =
                    `Error loading PDF: ${error.message || "Unknown error"}`;
            }
        }

        async function renderPDFPage(pageNum) {
            if (!pdfDocument || pageNum < 1 || pageNum > totalPdfPages) return;

            const canvas = document.getElementById("pdfCanvas");
            const ctx = canvas.getContext("2d");
            const container = document.getElementById("pdfCanvasContainer");

            if (!canvas || !ctx || !container) return;

            try {
                // Get page
                const page = await pdfDocument.getPage(pageNum);

                // Calculate viewport
                const viewport = page.getViewport({ scale: pdfScale });

                // Set canvas dimensions
                canvas.height = viewport.height;
                canvas.width = viewport.width;

                // Update container size
                container.style.width = viewport.width + "px";
                container.style.height = viewport.height + "px";

                // Render page
                const renderContext = {
                    canvasContext: ctx,
                    viewport: viewport
                };

                await page.render(renderContext).promise;

                // Update UI
                currentPdfPage = pageNum;
                updatePDFControls();

            } catch (error) {
                console.error("Error rendering PDF page:", error);
                showPDFError(`Error rendering page ${pageNum}: ${error.message}`);
            }
        }

        function updatePDFControls() {
            // Update page info
            const pageInfo = document.getElementById("pdfPageInfo");
            const zoomInfo = document.getElementById("pdfZoomInfo");
            const prevBtn = document.getElementById("pdfPrevBtn");
            const nextBtn = document.getElementById("pdfNextBtn");

            if (pageInfo) {
                pageInfo.textContent = `Page: ${currentPdfPage}/${totalPdfPages}`;
            }

            if (zoomInfo) {
                zoomInfo.textContent = `${Math.round(pdfScale * 100)}%`;
            }

            if (prevBtn) {
                prevBtn.disabled = currentPdfPage <= 1;
            }

            if (nextBtn) {
                nextBtn.disabled = currentPdfPage >= totalPdfPages;
            }
        }

        function pdfPrevPage() {
            if (currentPdfPage > 1) {
                currentPdfPage--;
                renderPDFPage(currentPdfPage);
            }
        }

        function pdfNextPage() {
            if (currentPdfPage < totalPdfPages) {
                currentPdfPage++;
                renderPDFPage(currentPdfPage);
            }
        }

        function pdfZoomIn() {
            pdfScale = Math.min(pdfScale + 0.1, 3.0); // Max zoom 300%
            renderPDFPage(currentPdfPage);
        }

        function pdfZoomOut() {
            pdfScale = Math.max(pdfScale - 0.1, 0.5); // Min zoom 50%
            renderPDFPage(currentPdfPage);
        }

        async function pdfFitWidth() {
            if (!pdfDocument) return;

            const canvas = document.getElementById("pdfCanvas");
            const container = document.getElementById("pdfCanvasContainer");
            if (!canvas || !container) return;

            try {
                const page = await pdfDocument.getPage(currentPdfPage);
                const viewport = page.getViewport({ scale: 1 });

                // Calculate scale to fit container width
                const containerWidth = container.parentElement.clientWidth - 40; // Account for padding
                pdfScale = containerWidth / viewport.width;

                // Clamp scale
                pdfScale = Math.max(0.5, Math.min(pdfScale, 3.0));

                renderPDFPage(currentPdfPage);

            } catch (error) {
                console.error("Error fitting to width:", error);
            }
        }

        async function pdfFitPage() {
            if (!pdfDocument) return;

            const canvas = document.getElementById("pdfCanvas");
            const container = document.getElementById("pdfCanvasContainer");
            if (!canvas || !container) return;

            try {
                const page = await pdfDocument.getPage(currentPdfPage);
                const viewport = page.getViewport({ scale: 1 });

                // Calculate scale to fit container
                const containerWidth = container.parentElement.clientWidth - 40;
                const containerHeight = container.parentElement.clientHeight - 40;

                const scaleX = containerWidth / viewport.width;
                const scaleY = containerHeight / viewport.height;

                pdfScale = Math.min(scaleX, scaleY);

                // Clamp scale
                pdfScale = Math.max(0.5, Math.min(pdfScale, 3.0));

                renderPDFPage(currentPdfPage);

            } catch (error) {
                console.error("Error fitting to page:", error);
            }
        }

        function showPDFError(message) {
            const errorOverlay = document.getElementById("pdfErrorOverlay");
            const errorText = document.getElementById("pdfErrorText");

            if (errorOverlay && errorText) {
                errorOverlay.style.display = "flex";
                errorText.textContent = message || "Error loading PDF";
            }
        }

        function retryPDFLoad() {
            if (currentFileName && currentFileType) {
                viewPDF(currentFileName, currentFileType, currentDisplayName);
            }
        }

        function closePDFViewer() {
            const overlay = document.getElementById("pdfViewerOverlay");
            if (overlay) {
                overlay.style.display = "none";
                document.body.style.overflow = ""; // Restore scrolling
            }

            // Clean up PDF document
            if (pdfDocument) {
                pdfDocument.destroy();
                pdfDocument = null;
            }
        }

