<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>@ViewData["Title"] - LingapDVO</title>
    <link rel="icon" type="image/x-icon" href="~/lingaplogo.ico">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <!-- Google Fonts - Poppins & Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Go Back Button -->
    <link rel="stylesheet" href="~/css/go-back-button.css">

    <!-- PDF.js for PDF viewing -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>

    <!-- Session Timeout -->
    @await Html.PartialAsync("_SessionTimeout")

    <style>
        /* ═══════════════════════════════════════════════════════════════════════════════
           LINGAPDVO FORMS LAYOUT - PREMIUM DESIGN SYSTEM
           ═══════════════════════════════════════════════════════════════════════════════
           A modern, beautiful, and highly responsive form layout for all LingapDVO forms
           ═══════════════════════════════════════════════════════════════════════════════ */

        :root {
            /* Brand Colors - Crimson Red Theme */
            --primary: #DC143C;
            --primary-rgb: 220, 20, 60;
            --primary-light: #FFE6EA;
            --primary-lighter: #FFF5F7;
            --primary-dark: #B01030;
            --primary-darker: #8B0C26;

            /* Neutral Palette */
            --white: #ffffff;
            --black: #000000;
            --gray-50: #fafafa;
            --gray-100: #f5f5f5;
            --gray-200: #eeeeee;
            --gray-300: #e0e0e0;
            --gray-400: #bdbdbd;
            --gray-500: #9e9e9e;
            --gray-600: #757575;
            --gray-700: #616161;
            --gray-800: #424242;
            --gray-900: #212121;

            /* Semantic Colors */
            --success: #10b981;
            --success-light: #d1fae5;
            --success-dark: #059669;
            --warning: #f59e0b;
            --warning-light: #fef3c7;
            --warning-dark: #d97706;
            --error: #ef4444;
            --error-light: #fee2e2;
            --error-dark: #dc2626;
            --info: #3b82f6;
            --info-light: #dbeafe;
            --info-dark: #2563eb;

            /* Gradients */
            --gradient-primary: linear-gradient(135deg, #DC143C 0%, #B01030 50%, #8B0C26 100%);
            --gradient-subtle: linear-gradient(180deg, #ffffff 0%, #f8f9fa 100%);
            --gradient-overlay: linear-gradient(135deg, rgba(220, 20, 60, 0.05) 0%, rgba(220, 20, 60, 0.02) 100%);

            /* Shadows */
            --shadow-xs: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            --shadow-sm: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
            --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
            --shadow-2xl: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            --shadow-inner: inset 0 2px 4px 0 rgba(0, 0, 0, 0.05);
            --shadow-primary: 0 10px 40px -10px rgba(220, 20, 60, 0.3);

            /* Border Radius */
            --radius-sm: 0.375rem;
            --radius: 0.5rem;
            --radius-md: 0.75rem;
            --radius-lg: 1rem;
            --radius-xl: 1.25rem;
            --radius-2xl: 1.5rem;
            --radius-3xl: 2rem;
            --radius-full: 9999px;

            /* Spacing */
            --spacing-xs: 0.25rem;
            --spacing-sm: 0.5rem;
            --spacing-md: 1rem;
            --spacing-lg: 1.5rem;
            --spacing-xl: 2rem;
            --spacing-2xl: 3rem;

            /* Transitions */
            --transition-fast: all 0.15s cubic-bezier(0.4, 0, 0.2, 1);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            --transition-slow: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);

            /* Z-index layers */
            --z-base: 0;
            --z-dropdown: 1000;
            --z-sticky: 1020;
            --z-fixed: 1030;
            --z-modal-backdrop: 1040;
            --z-modal: 1050;
            --z-popover: 1060;
            --z-tooltip: 1070;
        }

        /* ═══════════════════════════════════════════════════════════════════════════════
           BASE STYLES & RESET
           ═══════════════════════════════════════════════════════════════════════════════ */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 50%, #e8ecf1 100%);
            color: var(--gray-800);
            line-height: 1.6;
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        /* Animated Background Pattern */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            opacity: 0.4;
            background-image:
                radial-gradient(circle at 20% 50%, rgba(220, 20, 60, 0.08) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(220, 20, 60, 0.06) 0%, transparent 50%),
                radial-gradient(circle at 40% 20%, rgba(220, 20, 60, 0.04) 0%, transparent 50%);
            pointer-events: none;
        }

        /* ═══════════════════════════════════════════════════════════════════════════════
           MAIN LAYOUT WRAPPER
           ═══════════════════════════════════════════════════════════════════════════════ */

        .forms-layout-wrapper {
            position: relative;
            z-index: 1;
            min-height: 100vh;
            padding: var(--spacing-2xl) var(--spacing-md);
        }

        /* ═══════════════════════════════════════════════════════════════════════════════
           FORM CONTAINER
           ═══════════════════════════════════════════════════════════════════════════════ */

        .form-container {
            position: relative;
            max-width: 1400px;
            margin: 0 auto;
        }

        .form-card {
            background: var(--white);
            border-radius: var(--radius-2xl);
            box-shadow: var(--shadow-2xl);
            overflow: hidden;
            margin-bottom: var(--spacing-2xl);
            border: 1px solid rgba(0, 0, 0, 0.06);
            transition: var(--transition);
            position: relative;
        }

        .form-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--gradient-primary);
            z-index: 2;
        }

        .form-card:hover {
            box-shadow: var(--shadow-primary), var(--shadow-xl);
            transform: translateY(-2px);
        }

        /* ═══════════════════════════════════════════════════════════════════════════════
           FORM HEADER - STUNNING GRADIENT DESIGN
           ═══════════════════════════════════════════════════════════════════════════════ */

        .form-header {
            background: var(--gradient-primary);
            color: var(--white);
            padding: var(--spacing-2xl) var(--spacing-xl);
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        /* Animated Shimmer Effect */
        .form-header::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: repeating-linear-gradient(
                60deg,
                transparent,
                transparent 30px,
                rgba(255, 255, 255, 0.08) 30px,
                rgba(255, 255, 255, 0.08) 60px
            );
            animation: shimmer 20s linear infinite;
            pointer-events: none;
        }

        /* Floating Particles */
        .form-header::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            background-image:
                radial-gradient(circle, rgba(255, 255, 255, 0.1) 1px, transparent 1px),
                radial-gradient(circle, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
            background-size: 50px 50px, 80px 80px;
            background-position: 0 0, 40px 40px;
            animation: float 30s linear infinite;
            pointer-events: none;
        }

        @keyframes shimmer {
            0% { transform: translate(-50%, -50%) rotate(0deg); }
            100% { transform: translate(-50%, -50%) rotate(360deg); }
        }

        @keyframes float {
            0% { background-position: 0 0, 40px 40px; }
            100% { background-position: 50px 50px, 90px 90px; }
        }

        .form-header-content {
            position: relative;
            z-index: 1;
        }

        .form-header-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 100px;
            height: 100px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: var(--radius-full);
            margin-bottom: var(--spacing-lg);
            backdrop-filter: blur(10px);
            border: 3px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        }

        .form-header-icon i {
            font-size: 3rem;
            color: var(--white);
        }

        .form-header h1,
        .form-header h2,
        .form-header h3 {
            font-family: 'Poppins', sans-serif;
            font-weight: 800;
            margin-bottom: var(--spacing-sm);
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
            letter-spacing: -0.5px;
        }

        .form-header h1 { font-size: 2.5rem; }
        .form-header h2 { font-size: 2rem; }
        .form-header h3 { font-size: 1.75rem; }

        .form-header p {
            opacity: 0.95;
            font-size: 1.1rem;
            margin: 0;
            font-weight: 400;
            max-width: 700px;
            margin: 0 auto;
        }

        .form-header-badge {
            display: inline-flex;
            align-items: center;
            gap: var(--spacing-sm);
            background: rgba(255, 255, 255, 0.2);
            padding: var(--spacing-sm) var(--spacing-md);
            border-radius: var(--radius-full);
            font-size: 0.875rem;
            font-weight: 600;
            margin-top: var(--spacing-md);
            backdrop-filter: blur(10px);
        }

        /* ═══════════════════════════════════════════════════════════════════════════════
           FORM BODY
           ═══════════════════════════════════════════════════════════════════════════════ */

        .form-body {
            padding: var(--spacing-2xl) var(--spacing-xl);
            background: var(--gradient-subtle);
        }

        /* ═══════════════════════════════════════════════════════════════════════════════
           SECTION HEADERS - PREMIUM DESIGN
           ═══════════════════════════════════════════════════════════════════════════════ */

        .section-header,
        h5.section-header,
        h4.section-header {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 1.4rem;
            color: var(--gray-900);
            margin-top: var(--spacing-2xl);
            margin-bottom: var(--spacing-lg);
            padding: var(--spacing-md) var(--spacing-lg);
            padding-left: var(--spacing-2xl);
            border-left: 5px solid var(--primary);
            background: linear-gradient(90deg, var(--primary-lighter) 0%, transparent 100%);
            border-radius: var(--radius);
            position: relative;
            display: flex;
            align-items: center;
            gap: var(--spacing-md);
            box-shadow: var(--shadow-sm);
        }

        .section-header:first-child {
            margin-top: 0;
        }

        .section-header i {
            color: var(--primary);
            font-size: 1.75rem;
            flex-shrink: 0;
        }

        .section-header::before {
            content: '';
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 5px;
            height: 60%;
            background: var(--gradient-primary);
            border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
        }

        /* ═══════════════════════════════════════════════════════════════════════════════
           FORM ELEMENTS - PREMIUM STYLING
           ═══════════════════════════════════════════════════════════════════════════════ */

        .form-label {
            font-weight: 600;
            color: var(--gray-700);
            margin-bottom: var(--spacing-sm);
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: var(--spacing-xs);
        }

        .form-label .text-danger,
        .form-label .required,
        .required-field::after {
            content: '*';
            color: var(--error);
            margin-left: var(--spacing-xs);
            font-weight: 700;
        }

        .form-control,
        .form-select,
        textarea.form-control {
            border: 2px solid var(--gray-300);
            border-radius: var(--radius-md);
            padding: 0.875rem 1.25rem;
            font-size: 1rem;
            transition: var(--transition);
            background-color: var(--white);
            font-family: 'Inter', sans-serif;
            box-shadow: var(--shadow-xs);
        }

        .form-control:hover,
        .form-select:hover {
            border-color: var(--gray-400);
        }

        .form-control:focus,
        .form-select:focus,
        textarea.form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(var(--primary-rgb), 0.1), var(--shadow-sm);
            background-color: var(--white);
            outline: none;
        }

        .form-control:disabled,
        .form-select:disabled {
            background-color: var(--gray-100);
            cursor: not-allowed;
            opacity: 0.7;
        }

        textarea.form-control {
            resize: vertical;
            min-height: 120px;
        }

        /* Input Group Enhancement */
        .input-group {
            box-shadow: var(--shadow-xs);
            border-radius: var(--radius-md);
        }

        .input-group-text {
            background: var(--gradient-subtle);
            border: 2px solid var(--gray-300);
            border-right: none;
            color: var(--gray-600);
            font-weight: 600;
            padding: 0.875rem 1.25rem;
        }

        .input-group .form-control,
        .input-group .form-select {
            border-left: none;
        }

        .input-group:focus-within .input-group-text {
            border-color: var(--primary);
            color: var(--primary);
        }

        /* Checkboxes & Radios */
        .form-check-input {
            width: 1.25rem;
            height: 1.25rem;
            border: 2px solid var(--gray-400);
            cursor: pointer;
            transition: var(--transition);
        }

        .form-check-input:checked {
            background-color: var(--primary);
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(var(--primary-rgb), 0.1);
        }

        .form-check-label {
            margin-left: var(--spacing-sm);
            cursor: pointer;
            user-select: none;
        }

        /* ═══════════════════════════════════════════════════════════════════════════════
           BUTTONS - PREMIUM DESIGN
           ═══════════════════════════════════════════════════════════════════════════════ */

        .btn {
            padding: 0.875rem 2rem;
            border-radius: var(--radius-md);
            font-weight: 700;
            font-size: 1rem;
            transition: var(--transition);
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: var(--spacing-sm);
            font-family: 'Poppins', sans-serif;
            letter-spacing: 0.3px;
            position: relative;
            overflow: hidden;
        }

        .btn::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            transform: translate(-50%, -50%);
            transition: width 0.6s, height 0.6s;
        }

        .btn:hover::before {
            width: 300px;
            height: 300px;
        }

        .btn-primary {
            background: var(--gradient-primary);
            color: var(--white);
            box-shadow: var(--shadow-md);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-primary), var(--shadow-lg);
        }

        .btn-primary:active {
            transform: translateY(0);
            box-shadow: var(--shadow-sm);
        }

        .btn-secondary {
            background: var(--gray-600);
            color: var(--white);
            box-shadow: var(--shadow-md);
        }

        .btn-secondary:hover {
            background: var(--gray-700);
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .btn-outline-primary {
            border: 2px solid var(--primary);
            color: var(--primary);
            background: transparent;
            font-weight: 600;
        }

        .btn-outline-primary:hover {
            background: var(--primary);
            color: var(--white);
            box-shadow: var(--shadow-md);
        }

        .btn-success {
            background: linear-gradient(135deg, var(--success) 0%, var(--success-dark) 100%);
            color: var(--white);
            box-shadow: var(--shadow-md);
        }

        .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 40px -10px rgba(16, 185, 129, 0.3), var(--shadow-lg);
        }

        .btn-warning {
            background: linear-gradient(135deg, var(--warning) 0%, var(--warning-dark) 100%);
            color: var(--white);
            box-shadow: var(--shadow-md);
        }

        .btn-danger {
            background: linear-gradient(135deg, var(--error) 0%, var(--error-dark) 100%);
            color: var(--white);
            box-shadow: var(--shadow-md);
        }

        /* ═══════════════════════════════════════════════════════════════════════════════
           ALERTS & VALIDATION - PREMIUM DESIGN
           ═══════════════════════════════════════════════════════════════════════════════ */

        .alert {
            border-radius: var(--radius-md);
            padding: var(--spacing-lg);
            border: none;
            box-shadow: var(--shadow-md);
            display: flex;
            align-items: start;
            gap: var(--spacing-md);
            margin-bottom: var(--spacing-lg);
        }

        .alert i {
            font-size: 1.5rem;
            flex-shrink: 0;
        }

        .alert-danger {
            background: var(--error-light);
            color: var(--error-dark);
            border-left: 5px solid var(--error);
        }

        .alert-success {
            background: var(--success-light);
            color: var(--success-dark);
            border-left: 5px solid var(--success);
        }

        .alert-warning {
            background: var(--warning-light);
            color: var(--warning-dark);
            border-left: 5px solid var(--warning);
        }

        .alert-info {
            background: var(--info-light);
            color: var(--info-dark);
            border-left: 5px solid var(--info);
        }

        .text-danger,
        .field-validation-error {
            color: var(--error) !important;
            font-size: 0.875rem;
            margin-top: var(--spacing-xs);
            display: flex;
            align-items: center;
            gap: var(--spacing-xs);
            font-weight: 500;
        }

        .text-danger::before,
        .field-validation-error::before {
            content: '⚠';
            font-size: 1rem;
        }

        .input-validation-error {
            border-color: var(--error) !important;
            background-color: var(--error-light) !important;
        }

        /* ═══════════════════════════════════════════════════════════════════════════════
           FORM FOOTER / ACTIONS
           ═══════════════════════════════════════════════════════════════════════════════ */

        .form-actions {
            background: var(--gray-50);
            padding: var(--spacing-xl);
            border-top: 1px solid var(--gray-200);
            display: flex;
            justify-content: flex-end;
            gap: var(--spacing-md);
            flex-wrap: wrap;
        }

        /* ═══════════════════════════════════════════════════════════════════════════════
           CARDS & CONTAINERS
           ═══════════════════════════════════════════════════════════════════════════════ */

        .card {
            border: none;
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-md);
            transition: var(--transition);
        }

        .card:hover {
            box-shadow: var(--shadow-lg);
            transform: translateY(-2px);
        }

        .card-header {
            background: var(--gradient-subtle);
            border-bottom: 2px solid var(--gray-200);
            font-weight: 700;
            color: var(--gray-900);
        }

        /* ═══════════════════════════════════════════════════════════════════════════════
           TABLES
           ═══════════════════════════════════════════════════════════════════════════════ */

        .table {
            border-radius: var(--radius-md);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
        }

        .table thead {
            background: var(--gradient-primary);
            color: var(--white);
        }

        .table thead th {
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.875rem;
            letter-spacing: 0.5px;
            padding: var(--spacing-md) var(--spacing-lg);
            border: none;
        }

        .table tbody tr {
            transition: var(--transition-fast);
        }

        .table tbody tr:hover {
            background-color: var(--primary-lighter);
        }

        .table tbody td {
            padding: var(--spacing-md) var(--spacing-lg);
            vertical-align: middle;
        }

        /* ═══════════════════════════════════════════════════════════════════════════════
           FILE UPLOAD ZONES
           ═══════════════════════════════════════════════════════════════════════════════ */

        .upload-box {
            border: 3px dashed var(--gray-300);
            border-radius: var(--radius-lg);
            padding: var(--spacing-2xl);
            text-align: center;
            background: var(--gradient-subtle);
            transition: var(--transition);
            cursor: pointer;
        }

        .upload-box:hover {
            border-color: var(--primary);
            background: var(--primary-lighter);
            box-shadow: var(--shadow-md);
        }

        .upload-icon {
            font-size: 3rem;
            color: var(--primary);
            margin-bottom: var(--spacing-md);
        }

        .img-preview {
            max-width: 100%;
            height: auto;
            max-height: 400px;
            margin-top: var(--spacing-md);
            border: 2px solid var(--gray-200);
            border-radius: var(--radius-md);
            object-fit: contain;
            box-shadow: var(--shadow-md);
        }

        /* ═══════════════════════════════════════════════════════════════════════════════
           RESPONSIVE DESIGN
           ═══════════════════════════════════════════════════════════════════════════════ */

        /* Large Tablets & Small Desktops (≤ 1200px) */
        @media (max-width: 1200px) {
            .forms-layout-wrapper {
                padding: var(--spacing-xl) var(--spacing-md);
            }
        }

        /* Tablets (≤ 992px) */
        @media (max-width: 992px) {
            .form-header {
                padding: var(--spacing-xl) var(--spacing-lg);
            }

            .form-body {
                padding: var(--spacing-xl) var(--spacing-lg);
            }

            .form-header h1 { font-size: 2rem; }
            .form-header h2 { font-size: 1.75rem; }
            .form-header h3 { font-size: 1.5rem; }

            .form-header-icon {
                width: 80px;
                height: 80px;
            }

            .form-header-icon i {
                font-size: 2.5rem;
            }
        }

        /* Mobile Devices (≤ 768px) */
        @media (max-width: 768px) {
            .forms-layout-wrapper {
                padding: var(--spacing-lg) var(--spacing-sm);
            }

            .form-card {
                border-radius: var(--radius-xl);
            }

            .form-header {
                padding: var(--spacing-lg) var(--spacing-md);
            }

            .form-body {
                padding: var(--spacing-lg) var(--spacing-md);
            }

            .form-header h1 { font-size: 1.75rem; }
            .form-header h2 { font-size: 1.5rem; }
            .form-header h3 { font-size: 1.25rem; }

            .form-header p {
                font-size: 1rem;
            }

            .form-header-icon {
                width: 70px;
                height: 70px;
            }

            .form-header-icon i {
                font-size: 2rem;
            }

            .section-header,
            h5.section-header,
            h4.section-header {
                font-size: 1.2rem;
                padding: var(--spacing-sm) var(--spacing-md);
                padding-left: var(--spacing-lg);
            }

            .form-actions {
                padding: var(--spacing-md);
                justify-content: stretch;
            }

            .form-actions .btn {
                flex: 1 1 100%;
                min-width: 100%;
            }

            .btn {
                padding: 0.75rem 1.5rem;
                font-size: 0.95rem;
            }
        }

        /* Small Mobile (≤ 480px) */
        @media (max-width: 480px) {
            .form-header h1 { font-size: 1.5rem; }
            .form-header h2 { font-size: 1.35rem; }
            .form-header h3 { font-size: 1.15rem; }

            .form-header p {
                font-size: 0.9rem;
            }

            .form-control,
            .form-select {
                padding: 0.75rem 1rem;
                font-size: 0.95rem;
            }

            .section-header,
            h5.section-header,
            h4.section-header {
                font-size: 1.1rem;
            }
        }

        /* ═══════════════════════════════════════════════════════════════════════════════
           UTILITIES
           ═══════════════════════════════════════════════════════════════════════════════ */

        .text-muted {
            color: var(--gray-500) !important;
        }

        .text-primary {
            color: var(--primary) !important;
        }

        .bg-light {
            background-color: var(--gray-50) !important;
        }

        .form-note {
            background: var(--info-light);
            border-left: 4px solid var(--info);
            padding: var(--spacing-md);
            border-radius: var(--radius);
            font-size: 0.9rem;
            color: var(--info-dark);
            margin-top: var(--spacing-md);
        }

        /* ═══════════════════════════════════════════════════════════════════════════════
           LOADING STATES
           ═══════════════════════════════════════════════════════════════════════════════ */

        .btn.loading {
            position: relative;
            color: transparent;
            pointer-events: none;
        }

        .btn.loading::after {
            content: '';
            position: absolute;
            width: 1.2rem;
            height: 1.2rem;
            top: 50%;
            left: 50%;
            margin-left: -0.6rem;
            margin-top: -0.6rem;
            border: 3px solid transparent;
            border-top-color: currentColor;
            border-radius: 50%;
            animation: spin 0.6s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* ═══════════════════════════════════════════════════════════════════════════════
           PRINT STYLES
           ═══════════════════════════════════════════════════════════════════════════════ */

        @media print {
            body::before {
                display: none;
            }

            .forms-layout-wrapper {
                padding: 0;
            }

            .form-card {
                box-shadow: none;
                border: 1px solid var(--gray-300);
            }

            .form-header {
                background: var(--gray-100) !important;
                color: var(--gray-900) !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .form-actions,
            #goBackBtn {
                display: none !important;
            }
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="forms-layout-wrapper">
        <!-- Go Back Button (Global) -->
        <button id="goBackBtn">
            <i class="fas fa-arrow-left"></i>
            <span>Go Back</span>
        </button>

        <div class="form-container">
            @RenderBody()
        </div>
    </div>

    <!-- Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- jQuery Validation -->
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>

    <!-- Go Back Button Behavior -->
    <script src="~/js/go-back-button.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
