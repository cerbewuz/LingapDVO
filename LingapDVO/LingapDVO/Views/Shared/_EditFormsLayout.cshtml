<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>@ViewData["Title"] - LingapDVO</title>
    <link rel="icon" type="image/x-icon" href="~/Icon/lingaplogo.ico">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <!-- Google Fonts - Times New Roman & Arial are system fonts, but adding as fallback -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Go Back Button -->
    <link rel="stylesheet" href="~/css/go-back-button.css">

    <!-- Forms Layout Styling -->
    <link rel="stylesheet" href="~/css/forms-layout.css">

    <!-- Forms Consistency (Alignment & Spacing) -->
    <link rel="stylesheet" href="~/css/forms-consistency.css">

    <!-- Session Timeout -->
    @await Html.PartialAsync("_SessionTimeout")

    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="forms-layout-wrapper">
        <!-- Go Back Button -->
        <a href="#" class="go-back-btn" data-url="/Homepage">
            <i class="fas fa-arrow-left"></i>
            <span>Back</span>
        </a>

        <div class="form-container">
            <!-- Official Form Header -->
            <div class="official-form-header">
                <div class="header-content-flex">
                    <div class="header-logo">
                        <img src="~/Icon/lingaplogo.png" alt="Lingap Logo" class="lingap-logo">
                    </div>
                    <div class="header-text">
                        <h1 class="header-title">Lingap Para sa Mahirap</h1>
                        <p class="header-subtitle">City of Davao</p>
                        <h2 class="header-form-title">Edit Assistance Form</h2>
                    </div>
                </div>
            </div>

            <!-- Form Content -->
            <div class="form-content-wrapper">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- jQuery Validation -->
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>

    <!-- Go Back Button Behavior -->
    <script src="~/js/go-back-button.js"></script>

    <!-- Form Utilities (Phone/PhilHealth formatting, assistance checkboxes, file preview) -->
    <script src="~/js/form-utilities.js"></script>

    <!-- Required Field Validation Warnings -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Add required field validation on form submit
            const forms = document.querySelectorAll('form');

            forms.forEach(form => {
                form.addEventListener('submit', function(e) {
                    const requiredFields = form.querySelectorAll('[required]');
                    let hasError = false;

                    requiredFields.forEach(field => {
                        if (!field.value || field.value.trim() === '') {
                            hasError = true;
                            const label = field.closest('.col-md-3, .col-md-4, .col-md-6, .col-md-12, .form-group')?.querySelector('.form-label');
                            const fieldName = label ? label.textContent.replace('*', '').trim() : 'This field';

                            // Highlight the field
                            field.classList.add('is-invalid');

                            // Show alert for first empty required field
                            if (hasError) {
                                alert(`Warning: ${fieldName} is required. Please fill in all required fields marked with (*)`);
                                field.focus();
                                e.preventDefault();
                                return false;
                            }
                        } else {
                            field.classList.remove('is-invalid');
                        }
                    });

                    if (hasError) {
                        e.preventDefault();
                        return false;
                    }
                });

                // Real-time validation feedback
                const requiredFields = form.querySelectorAll('[required]');
                requiredFields.forEach(field => {
                    field.addEventListener('blur', function() {
                        if (!this.value || this.value.trim() === '') {
                            this.classList.add('is-invalid');
                        } else {
                            this.classList.remove('is-invalid');
                        }
                    });

                    field.addEventListener('input', function() {
                        if (this.value && this.value.trim() !== '') {
                            this.classList.remove('is-invalid');
                        }
                    });
                });
            });
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
