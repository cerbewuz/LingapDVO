@*
    ═══════════════════════════════════════════════════════════════════════════════
    STANDARD MODALS - SHARED COMPONENT
    ═══════════════════════════════════════════════════════════════════════════════
    Consistent success and error modal design based on ID Verification Tab
    Include this partial in layouts or individual views that need modals
    ═══════════════════════════════════════════════════════════════════════════════
*@

<!-- Standard Success Modal -->
<div class="modal fade" id="standardSuccessModal" tabindex="-1" aria-labelledby="standardSuccessModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-3xl shadow-2xl overflow-hidden bg-gradient-to-br from-green-50 via-white to-emerald-50">
            <div class="modal-body p-8 text-center">
                <!-- Success Icon with Animation -->
                <div class="standard-modal-icon success-icon">
                    <i class="fas fa-check text-white text-3xl"></i>
                </div>

                <!-- Success Message -->
                <h4 id="standardSuccessModalLabel" class="font-bold text-gray-800 text-xl mb-2">Success!</h4>
                <p id="standardSuccessMessage" class="text-gray-600 text-sm mb-6">
                    Your action was completed successfully.
                </p>

                <!-- Action Button -->
                <button type="button" id="standardSuccessButton" class="w-full bg-gradient-to-r from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700 text-white px-6 py-3 rounded-xl font-semibold shadow-md hover:shadow-lg transition-all duration-200" data-bs-dismiss="modal">
                    Continue
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Standard Error Modal -->
<div class="modal fade" id="standardErrorModal" tabindex="-1" aria-labelledby="standardErrorModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-3xl shadow-2xl overflow-hidden">
            <div class="modal-header bg-gradient-to-r from-red-600 to-rose-600 text-white py-4 px-6 border-b-0">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center">
                        <i class="fas fa-exclamation-triangle text-white text-lg"></i>
                    </div>
                    <h5 class="modal-title font-bold text-lg" id="standardErrorModalLabel">Error</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-6 text-center">
                <div class="standard-modal-icon error-icon">
                    <i id="standardErrorIcon" class="fas fa-times text-red-600 text-3xl"></i>
                </div>
                <h4 id="standardErrorTitle" class="font-bold text-gray-800 text-xl mb-3">Something went wrong</h4>
                <p id="standardErrorMessage" class="text-gray-600 mb-4 text-sm">An error occurred. Please try again.</p>

                <!-- Optional Info Box -->
                <div id="standardErrorInfoBox" class="bg-red-50 border-l-4 border-red-600 rounded-lg p-4 text-left mb-4 hidden">
                    <div class="flex items-start gap-3">
                        <i class="fas fa-info-circle text-red-600 text-xl mt-0.5"></i>
                        <div class="flex-1">
                            <h6 class="text-sm font-semibold text-red-700 mb-2">Additional Information</h6>
                            <p id="standardErrorDetails" class="text-sm text-gray-700 leading-relaxed"></p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-gray-50 py-3 px-6 border-t-0">
                <button type="button" id="standardErrorButton" class="w-full bg-gradient-to-r from-red-600 to-rose-600 hover:from-red-700 hover:to-rose-700 text-white py-3 rounded-xl font-semibold transition-all duration-200" data-bs-dismiss="modal">
                    OK
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Standard Warning Modal -->
<div class="modal fade" id="standardWarningModal" tabindex="-1" aria-labelledby="standardWarningModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-3xl shadow-2xl overflow-hidden bg-gradient-to-br from-amber-50 via-white to-orange-50">
            <div class="modal-header bg-gradient-to-r from-amber-500 to-orange-500 text-white py-4 px-6 border-b-0">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center">
                        <i class="fas fa-exclamation-circle text-white text-lg"></i>
                    </div>
                    <h5 class="modal-title font-bold text-lg" id="standardWarningModalLabel">Warning</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-6 text-center">
                <div class="standard-modal-icon warning-icon">
                    <i id="standardWarningIcon" class="fas fa-exclamation text-amber-600 text-3xl"></i>
                </div>
                <h4 id="standardWarningTitle" class="font-bold text-gray-800 text-xl mb-3">Please Note</h4>
                <p id="standardWarningMessage" class="text-gray-600 mb-4 text-sm">This action requires your attention.</p>
            </div>
            <div class="modal-footer bg-gray-50 py-3 px-6 border-t-0">
                <button type="button" id="standardWarningButton" class="w-full bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white py-3 rounded-xl font-semibold transition-all duration-200" data-bs-dismiss="modal">
                    OK
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Standard Confirm Modal -->
<div class="modal fade" id="standardConfirmModal" tabindex="-1" aria-labelledby="standardConfirmModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-3xl shadow-2xl overflow-hidden bg-gradient-to-br from-blue-50 via-white to-indigo-50">
            <div class="modal-header bg-gradient-to-r from-blue-600 to-indigo-600 text-white py-4 px-6 border-b-0">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center">
                        <i class="fas fa-question-circle text-white text-lg"></i>
                    </div>
                    <h5 class="modal-title font-bold text-lg" id="standardConfirmModalLabel">Confirm Action</h5>
                </div>
            </div>
            <div class="modal-body p-6 text-center">
                <div class="standard-modal-icon confirm-icon">
                    <i id="standardConfirmIcon" class="fas fa-question text-blue-600 text-3xl"></i>
                </div>
                <h4 id="standardConfirmTitle" class="font-bold text-gray-800 text-xl mb-3">Are you sure?</h4>
                <p id="standardConfirmMessage" class="text-gray-600 mb-4 text-sm">Please confirm this action.</p>
            </div>
            <div class="modal-footer bg-gray-50 py-3 px-6 border-t-0 flex gap-3">
                <button type="button" id="standardConfirmCancelBtn" class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-700 py-3 rounded-xl font-semibold transition-all duration-200" data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" id="standardConfirmOkBtn" class="flex-1 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white py-3 rounded-xl font-semibold transition-all duration-200">
                    Confirm
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Standard Modal Styles -->
<style>
    /* Modal Icon Animation */
    .standard-modal-icon {
        width: 5rem;
        height: 5rem;
        border-radius: 9999px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem auto;
        animation: modalIconScaleIn 0.5s ease-out;
    }

    .standard-modal-icon.success-icon {
        background: linear-gradient(135deg, #22c55e 0%, #059669 100%);
        box-shadow: 0 10px 25px -5px rgba(34, 197, 94, 0.4);
    }

    .standard-modal-icon.error-icon {
        background: #fee2e2;
    }

    .standard-modal-icon.warning-icon {
        background: #fef3c7;
    }

    .standard-modal-icon.confirm-icon {
        background: #dbeafe;
    }

    @@keyframes modalIconScaleIn {
        0% {
            transform: scale(0);
            opacity: 0;
        }
        50% {
            transform: scale(1.1);
        }
        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    /* Modal Content Animation */
    .modal.fade .modal-dialog {
        transition: transform 0.3s ease-out, opacity 0.3s ease-out;
    }

    .modal.show .modal-dialog {
        animation: modalSlideIn 0.3s ease-out;
    }

    @@keyframes modalSlideIn {
        from {
            opacity: 0;
            transform: scale(0.95) translateY(-20px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    /* Rounded corners for modals */
    .rounded-3xl {
        border-radius: 1.5rem !important;
    }

    /* Shadow for modals */
    .shadow-2xl {
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25) !important;
    }

    /* Gradient backgrounds */
    .bg-gradient-to-br {
        background-image: linear-gradient(to bottom right, var(--tw-gradient-stops));
    }

    .bg-gradient-to-r {
        background-image: linear-gradient(to right, var(--tw-gradient-stops));
    }

    /* Green gradients for success */
    .from-green-50 { --tw-gradient-from: #f0fdf4; --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to, rgba(240, 253, 244, 0)); }
    .via-white { --tw-gradient-stops: var(--tw-gradient-from), #ffffff, var(--tw-gradient-to, rgba(255, 255, 255, 0)); }
    .to-emerald-50 { --tw-gradient-to: #ecfdf5; }
    .from-green-600 { --tw-gradient-from: #16a34a; --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to, rgba(22, 163, 74, 0)); }
    .to-emerald-600 { --tw-gradient-to: #059669; }
    .hover\:from-green-700:hover { --tw-gradient-from: #15803d; }
    .hover\:to-emerald-700:hover { --tw-gradient-to: #047857; }

    /* Red gradients for error */
    .from-red-600 { --tw-gradient-from: #dc2626; --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to, rgba(220, 38, 38, 0)); }
    .to-rose-600 { --tw-gradient-to: #e11d48; }
    .hover\:from-red-700:hover { --tw-gradient-from: #b91c1c; }
    .hover\:to-rose-700:hover { --tw-gradient-to: #be123c; }

    /* Amber gradients for warning */
    .from-amber-50 { --tw-gradient-from: #fffbeb; --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to, rgba(255, 251, 235, 0)); }
    .to-orange-50 { --tw-gradient-to: #fff7ed; }
    .from-amber-500 { --tw-gradient-from: #f59e0b; --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to, rgba(245, 158, 11, 0)); }
    .to-orange-500 { --tw-gradient-to: #f97316; }
    .hover\:from-amber-600:hover { --tw-gradient-from: #d97706; }
    .hover\:to-orange-600:hover { --tw-gradient-to: #ea580c; }

    /* Blue gradients for confirm */
    .from-blue-50 { --tw-gradient-from: #eff6ff; --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to, rgba(239, 246, 255, 0)); }
    .to-indigo-50 { --tw-gradient-to: #eef2ff; }
    .from-blue-600 { --tw-gradient-from: #2563eb; --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to, rgba(37, 99, 235, 0)); }
    .to-indigo-600 { --tw-gradient-to: #4f46e5; }
    .hover\:from-blue-700:hover { --tw-gradient-from: #1d4ed8; }
    .hover\:to-indigo-700:hover { --tw-gradient-to: #4338ca; }
</style>

<!-- Standard Modal JavaScript API -->
<script>
    /**
     * StandardModals - Unified modal system for LingapDVO
     * Based on ID Verification Tab design for consistency
     */
    window.StandardModals = {
        /**
         * Show success modal
         * @@param {string} title - Modal title
         * @@param {string} message - Modal message
         * @@param {Object} options - Optional settings
         * @@param {string} options.buttonText - Custom button text
         * @@param {Function} options.onClose - Callback when modal closes
         * @@param {string} options.redirectUrl - URL to redirect on button click
         */
        success: function(title, message, options = {}) {
            const modal = document.getElementById('standardSuccessModal');
            const titleEl = document.getElementById('standardSuccessModalLabel');
            const messageEl = document.getElementById('standardSuccessMessage');
            const buttonEl = document.getElementById('standardSuccessButton');

            if (!modal) {
                console.warn('Standard success modal not found. Make sure _StandardModals partial is included.');
                alert(title + '\n\n' + message);
                return;
            }

            titleEl.textContent = title || 'Success!';
            messageEl.textContent = message || 'Your action was completed successfully.';
            buttonEl.textContent = options.buttonText || 'Continue';

            // Handle redirect or callback
            buttonEl.onclick = function() {
                if (options.redirectUrl) {
                    window.location.href = options.redirectUrl;
                } else if (options.onClose) {
                    options.onClose();
                }
            };

            // Reset animation
            const icon = modal.querySelector('.standard-modal-icon');
            if (icon) {
                icon.style.animation = 'none';
                icon.offsetHeight; // Trigger reflow
                icon.style.animation = 'modalIconScaleIn 0.5s ease-out';
            }

            const bsModal = new bootstrap.Modal(modal);
            bsModal.show();

            // Handle onClose callback when modal is hidden
            if (options.onClose && !options.redirectUrl) {
                modal.addEventListener('hidden.bs.modal', options.onClose, { once: true });
            }
        },

        /**
         * Show error modal
         * @@param {string} title - Modal title
         * @@param {string} message - Modal message
         * @@param {Object} options - Optional settings
         * @@param {string} options.details - Additional details to show in info box
         * @@param {string} options.icon - Custom icon class (e.g., 'fa-user-times')
         * @@param {string} options.buttonText - Custom button text
         * @@param {Function} options.onClose - Callback when modal closes
         * @@param {string} options.redirectUrl - URL to redirect on button click
         */
        error: function(title, message, options = {}) {
            const modal = document.getElementById('standardErrorModal');
            const headerTitleEl = document.getElementById('standardErrorModalLabel');
            const titleEl = document.getElementById('standardErrorTitle');
            const messageEl = document.getElementById('standardErrorMessage');
            const buttonEl = document.getElementById('standardErrorButton');
            const iconEl = document.getElementById('standardErrorIcon');
            const infoBox = document.getElementById('standardErrorInfoBox');
            const detailsEl = document.getElementById('standardErrorDetails');

            if (!modal) {
                console.warn('Standard error modal not found. Make sure _StandardModals partial is included.');
                alert(title + '\n\n' + message);
                return;
            }

            headerTitleEl.textContent = options.headerTitle || 'Error';
            titleEl.textContent = title || 'Something went wrong';
            messageEl.textContent = message || 'An error occurred. Please try again.';
            buttonEl.textContent = options.buttonText || 'OK';

            // Set custom icon if provided
            if (options.icon) {
                iconEl.className = 'fas ' + options.icon + ' text-red-600 text-3xl';
            } else {
                iconEl.className = 'fas fa-times text-red-600 text-3xl';
            }

            // Show/hide details box
            if (options.details) {
                detailsEl.textContent = options.details;
                infoBox.classList.remove('hidden');
            } else {
                infoBox.classList.add('hidden');
            }

            // Handle redirect or callback
            buttonEl.onclick = function() {
                if (options.redirectUrl) {
                    window.location.href = options.redirectUrl;
                } else if (options.onClose) {
                    options.onClose();
                }
            };

            // Reset animation
            const icon = modal.querySelector('.standard-modal-icon');
            if (icon) {
                icon.style.animation = 'none';
                icon.offsetHeight;
                icon.style.animation = 'modalIconScaleIn 0.5s ease-out';
            }

            const bsModal = new bootstrap.Modal(modal);
            bsModal.show();

            if (options.onClose && !options.redirectUrl) {
                modal.addEventListener('hidden.bs.modal', options.onClose, { once: true });
            }
        },

        /**
         * Show warning modal
         * @@param {string} title - Modal title
         * @@param {string} message - Modal message
         * @@param {Object} options - Optional settings
         */
        warning: function(title, message, options = {}) {
            const modal = document.getElementById('standardWarningModal');
            const headerTitleEl = document.getElementById('standardWarningModalLabel');
            const titleEl = document.getElementById('standardWarningTitle');
            const messageEl = document.getElementById('standardWarningMessage');
            const buttonEl = document.getElementById('standardWarningButton');
            const iconEl = document.getElementById('standardWarningIcon');

            if (!modal) {
                console.warn('Standard warning modal not found.');
                alert(title + '\n\n' + message);
                return;
            }

            headerTitleEl.textContent = options.headerTitle || 'Warning';
            titleEl.textContent = title || 'Please Note';
            messageEl.textContent = message || 'This action requires your attention.';
            buttonEl.textContent = options.buttonText || 'OK';

            if (options.icon) {
                iconEl.className = 'fas ' + options.icon + ' text-amber-600 text-3xl';
            }

            buttonEl.onclick = function() {
                if (options.redirectUrl) {
                    window.location.href = options.redirectUrl;
                } else if (options.onClose) {
                    options.onClose();
                }
            };

            const bsModal = new bootstrap.Modal(modal);
            bsModal.show();
        },

        /**
         * Show confirmation modal
         * @@param {string} title - Modal title
         * @@param {string} message - Modal message
         * @@param {Object} options - Optional settings
         * @@param {Function} options.onConfirm - Callback when confirmed
         * @@param {Function} options.onCancel - Callback when cancelled
         */
        confirm: function(title, message, options = {}) {
            const modal = document.getElementById('standardConfirmModal');
            const headerTitleEl = document.getElementById('standardConfirmModalLabel');
            const titleEl = document.getElementById('standardConfirmTitle');
            const messageEl = document.getElementById('standardConfirmMessage');
            const confirmBtn = document.getElementById('standardConfirmOkBtn');
            const cancelBtn = document.getElementById('standardConfirmCancelBtn');

            if (!modal) {
                const result = confirm(title + '\n\n' + message);
                if (result && options.onConfirm) options.onConfirm();
                if (!result && options.onCancel) options.onCancel();
                return;
            }

            headerTitleEl.textContent = options.headerTitle || 'Confirm Action';
            titleEl.textContent = title || 'Are you sure?';
            messageEl.textContent = message || 'Please confirm this action.';
            confirmBtn.textContent = options.confirmText || 'Confirm';
            cancelBtn.textContent = options.cancelText || 'Cancel';

            const bsModal = new bootstrap.Modal(modal);

            confirmBtn.onclick = function() {
                bsModal.hide();
                if (options.onConfirm) options.onConfirm();
            };

            cancelBtn.onclick = function() {
                bsModal.hide();
                if (options.onCancel) options.onCancel();
            };

            bsModal.show();
        },

        /**
         * Close all standard modals
         */
        closeAll: function() {
            ['standardSuccessModal', 'standardErrorModal', 'standardWarningModal', 'standardConfirmModal'].forEach(function(id) {
                const modal = document.getElementById(id);
                if (modal) {
                    const bsModal = bootstrap.Modal.getInstance(modal);
                    if (bsModal) bsModal.hide();
                }
            });
        }
    };

    // Legacy function aliases for backward compatibility
    function showStandardSuccessModal(title, message, options) {
        StandardModals.success(title, message, options);
    }

    function showStandardErrorModal(title, message, options) {
        StandardModals.error(title, message, options);
    }

    function showStandardWarningModal(title, message, options) {
        StandardModals.warning(title, message, options);
    }

    function showStandardConfirmModal(title, message, options) {
        StandardModals.confirm(title, message, options);
    }
</script>
