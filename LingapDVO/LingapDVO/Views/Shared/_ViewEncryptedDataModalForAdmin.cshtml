@*
    Reusable Modal Component for Viewing Encrypted Additional Information
    Requires password verification before displaying decrypted data
*@

<!-- Additional Information View Modal -->
<div class="modal fade" id="viewAdditionalInfoModal" tabindex="-1" aria-labelledby="viewAdditionalInfoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="viewAdditionalInfoModalLabel">
                    <i class="bi bi-shield-lock-fill me-2"></i>Additional Information (Encrypted)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Password Verification Step -->
                <div id="passwordVerificationStep">
                    <div class="alert alert-info d-flex align-items-center" role="alert">
                        <i class="bi bi-info-circle-fill me-3 fs-4"></i>
                        <div>
                            <strong>Security Verification Required</strong><br>
                            Please enter your password to view the encrypted Additional Information.
                        </div>
                    </div>

                    <form id="passwordVerificationForm">
                        <div class="mb-3">
                            <label for="verificationPassword" class="form-label fw-bold">
                                <i class="bi bi-key-fill me-2"></i>Your Password
                            </label>
                            <div class="input-group">
                                <input type="password" class="form-control" id="verificationPassword"
                                       placeholder="Enter your password" required autocomplete="current-password">
                                <button class="btn btn-outline-secondary" type="button" id="togglePasswordVisibility">
                                    <i class="bi bi-eye" id="togglePasswordIcon"></i>
                                </button>
                            </div>
                            <div class="form-text">Enter the password you use to log into your account.</div>
                            <div id="passwordError" class="text-danger mt-2" style="display: none;"></div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="bi bi-x-circle me-2"></i>Cancel
                            </button>
                            <button type="submit" class="btn btn-primary" id="verifyPasswordBtn">
                                <i class="bi bi-unlock-fill me-2"></i>Verify & View Data
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Decrypted Data Display Step (Hidden Initially) -->
                <div id="decryptedDataStep" style="display: none;">
                    <div class="alert alert-success d-flex align-items-center mb-3" role="alert">
                        <i class="bi bi-check-circle-fill me-3 fs-4"></i>
                        <div>
                            <strong>Verification Successful!</strong><br>
                            The encrypted data has been decrypted and is displayed below.
                        </div>
                    </div>

                    <!-- Decrypted Data Container -->
                    <div id="decryptedDataContainer" class="mb-3">
                        <!-- Decrypted fields will be populated here by JavaScript -->
                    </div>

                    <div class="mt-3 d-grid gap-2">
                        <button type="button" class="btn btn-warning" id="reEncryptBtn" onclick="reEncryptFields()">
                            <i class="bi bi-lock-fill me-2"></i>Re-Encrypt & Hide Data
                        </button>
                        <button type="button" class="btn btn-success" data-bs-dismiss="modal">
                            <i class="bi bi-check-circle-fill me-2"></i>Continue to Processing
                        </button>
                    </div>
                </div>

                <!-- Loading Spinner -->
                <div id="loadingSpinner" style="display: none;" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-3">Processing your request...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Fix z-index to ensure modal appears above backdrop */
    #viewAdditionalInfoModal {
        z-index: 1060 !important;
    }

        #viewAdditionalInfoModal ~ .modal-backdrop {
            z-index: 1055 !important;
        }

    .modal-backdrop.show {
        z-index: 1055 !important;
    }

    #viewAdditionalInfoModal .modal-content {
        border: none;
        border-radius: 15px;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        z-index: 1060 !important;
        position: relative;
        overflow: hidden;
    }

    #viewAdditionalInfoModal .modal-dialog {
        z-index: 1060 !important;
    }

    #viewAdditionalInfoModal .modal-header {
        border-bottom: 3px solid #0056b3;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
    }

    #decryptedDataContainer .field-group {
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #dee2e6;
    }

        #decryptedDataContainer .field-group:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

    #decryptedDataContainer .field-label {
        font-weight: 600;
        color: #495057;
        font-size: 0.9rem;
        margin-bottom: 0.25rem;
    }

    #decryptedDataContainer .field-value {
        color: #212529;
        font-size: 1rem;
        word-wrap: break-word;
    }

    .encrypted-field-badge {
        background-color: #ffc107;
        color: #000;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        margin-left: 0.5rem;
    }
</style>

<script>
    // Detect which controller we're using based on current URL
    function getControllerRoute() {
        const currentPath = window.location.pathname.toLowerCase();
        if (currentPath.includes('/adminuser/')) {
            return '/Adminuser';
        }
        return '/Dashboard';  // Default to Dashboard for user side
    }

    // Global function to open the modal with specific form data
    function openViewAdditionalInfoModal(formType, formId, encryptedFields) {
        console.log('Opening modal for form type:', formType, 'ID:', formId);
        console.log('Encrypted fields:', encryptedFields);

        // Wait for jQuery to be loaded
        if (typeof jQuery === 'undefined') {
            console.error('jQuery is not loaded yet!');
            setTimeout(function() {
                openViewAdditionalInfoModal(formType, formId, encryptedFields);
            }, 100);
            return;
        }

        // Reset modal state - show password verification step
        $('#passwordVerificationStep').show();
        $('#decryptedDataStep').hide();
        $('#loadingSpinner').hide();
        $('#verificationPassword').val('');
        $('#passwordError').hide().text('');

        // Store data in modal for later use
        $('#viewAdditionalInfoModal').data('formType', formType);
        $('#viewAdditionalInfoModal').data('formId', formId);
        $('#viewAdditionalInfoModal').data('encryptedFields', encryptedFields);

        // Update modal title based on form type
        let modalTitle = 'Additional Information (Encrypted)';
        if (formType === 'Hospital') {
            modalTitle = 'Hospital Information (Encrypted)';
        } else if (formType === 'Other') {
            modalTitle = 'Additional Information (Encrypted)';
        } else if (formType === 'Funeral') {
            modalTitle = 'Funeral Information (Encrypted)';
        }
        $('#viewAdditionalInfoModalLabel').html('<i class="bi bi-shield-lock-fill me-2"></i>' + modalTitle);

        // Show modal using Bootstrap 5 syntax
        var modalElement = document.getElementById('viewAdditionalInfoModal');
        if (modalElement) {
            var modal = new bootstrap.Modal(modalElement, {
                backdrop: 'static',
                keyboard: true,
                focus: true
            });
            modal.show();
            console.log('Modal opened successfully');
        } else {
            console.error('Modal element not found!');
        }
    }

    // Wrap all jQuery code in document ready to ensure jQuery is loaded
    if (typeof jQuery !== 'undefined') {
        $(document).ready(function() {
            initializeModal();
        });
    } else {
        // If jQuery isn't loaded yet, wait for it
        document.addEventListener('DOMContentLoaded', function() {
            var checkJQuery = setInterval(function() {
                if (typeof jQuery !== 'undefined') {
                    clearInterval(checkJQuery);
                    $(document).ready(function() {
                        initializeModal();
                    });
                }
            }, 100);
        });
    }

    function initializeModal() {
        // Toggle password visibility
        $('#togglePasswordVisibility').on('click', function() {
            const passwordInput = $('#verificationPassword');
            const icon = $('#togglePasswordIcon');

            if (passwordInput.attr('type') === 'password') {
                passwordInput.attr('type', 'text');
                icon.removeClass('bi-eye').addClass('bi-eye-slash');
            } else {
                passwordInput.attr('type', 'password');
                icon.removeClass('bi-eye-slash').addClass('bi-eye');
            }
        });

        // Handle password verification form submission
        $('#passwordVerificationForm').on('submit', function(e) {
            e.preventDefault();
            e.stopPropagation();

            const password = $('#verificationPassword').val();
            const formType = $('#viewAdditionalInfoModal').data('formType');
            const formId = $('#viewAdditionalInfoModal').data('formId');
            const encryptedFields = $('#viewAdditionalInfoModal').data('encryptedFields');

            console.log('Password verification started');
            console.log('Form Type:', formType);
            console.log('Form ID:', formId);

            if (!password) {
                $('#passwordError').text('Please enter your password').show();
                return;
            }

            // Show loading, hide form
            $('#passwordVerificationStep').hide();
            $('#loadingSpinner').show();
            $('#passwordError').hide();

            // Get the appropriate controller route
            const controllerRoute = getControllerRoute();
            console.log('Using controller route:', controllerRoute);

            // Verify password
            $.ajax({
                url: controllerRoute + '/VerifyPasswordForDecryption',
                type: 'POST',
                data: { password: password },
                dataType: 'json',
                success: function(response) {
                    console.log('Password verification response:', response);
                    if (response.success) {
                        // Password verified, now decrypt all fields
                        console.log('Password verified successfully, decrypting fields...');
                        // NEW: Decrypt directly to page, close modal immediately
                        decryptAndDisplayOnPage(formType, formId, encryptedFields);
                    } else {
                        // Password incorrect
                        console.log('Password verification failed:', response.message);
                        $('#loadingSpinner').hide();
                        $('#passwordVerificationStep').show();
                        $('#passwordError').text(response.message || 'Invalid password. Please try again.').show();
                        $('#verificationPassword').val('').focus();
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Password verification error:', error);
                    console.error('XHR:', xhr);
                    console.error('Status:', status);
                    $('#loadingSpinner').hide();
                    $('#passwordVerificationStep').show();
                    $('#passwordError').text('An error occurred: ' + error + '. Please try again.').show();
                }
            });
        });

        // NEW: Function to decrypt and display directly on page (no modal display)
        function decryptAndDisplayOnPage(formType, formId, encryptedFields) {
            const controllerRoute = getControllerRoute();
            const decryptPromises = [];
            const fieldLabels = encryptedFields.labels;
            const fieldValues = encryptedFields.values;
            const fieldNames = encryptedFields.names;

            console.log('Starting decryption for', fieldNames.length, 'fields (direct to page)');

            // Create decrypt requests for all fields
            for (let i = 0; i < fieldNames.length; i++) {
                if (fieldValues[i] && fieldValues[i].trim() !== '') {
                    console.log('Decrypting field:', fieldNames[i]);
                    decryptPromises.push(
                        $.ajax({
                            url: controllerRoute + '/DecryptField',
                            type: 'POST',
                            data: {
                                fieldValue: fieldValues[i],
                                formType: formType,
                                formId: formId
                            },
                            dataType: 'json'
                        }).then(function(response) {
                            return {
                                name: fieldNames[i],
                                label: fieldLabels[i],
                                value: response.success ? response.data : ''
                            };
                        }).fail(function(xhr, status, error) {
                            console.error('Decryption failed for field ' + fieldNames[i] + ':', error);
                            return {
                                name: fieldNames[i],
                                label: fieldLabels[i],
                                value: 'Error: ' + error
                            };
                        })
                    );
                }
            }

            // Wait for all decryptions to complete
            Promise.all(decryptPromises).then(function(decryptedData) {
                console.log('All fields decrypted:', decryptedData);

                // Store decrypted data globally
                if (formType === 'Hospital') {
                    window.decryptedHospitalData = {};
                    decryptedData.forEach(function(field) {
                        window.decryptedHospitalData[field.name] = field.value;
                    });
                } else if (formType === 'Other') {
                    window.decryptedAdditionalData = {};
                    decryptedData.forEach(function(field) {
                        window.decryptedAdditionalData[field.name] = field.value;
                    });
                } else if (formType === 'Funeral') {
                    window.decryptedFuneralData = {};
                    decryptedData.forEach(function(field) {
                        window.decryptedFuneralData[field.name] = field.value;
                    });
                }

                // Close the modal immediately
                var modalElement = document.getElementById('viewAdditionalInfoModal');
                if (modalElement) {
                    var modal = bootstrap.Modal.getInstance(modalElement);
                    if (modal) {
                        modal.hide();
                    }
                }

                // Trigger the page display update (modal close event will handle this)
                // The modal close handler will populate the fields on the page
            }).catch(function(error) {
                console.error('Decryption failed:', error);
                $('#loadingSpinner').hide();
                $('#passwordVerificationStep').show();
                $('#passwordError').text('Failed to decrypt data: ' + error + '. Please try again.').show();
            });
        }

        // OLD: Function to decrypt all fields and display them (KEPT FOR COMPATIBILITY)
        function decryptAllFields(formType, formId, encryptedFields) {
            const controllerRoute = getControllerRoute();
            const decryptPromises = [];
            const fieldLabels = encryptedFields.labels;
            const fieldValues = encryptedFields.values;
            const fieldNames = encryptedFields.names;

            console.log('Starting decryption for', fieldNames.length, 'fields');
            console.log('Using controller route:', controllerRoute);

            // Create decrypt requests for all fields
            for (let i = 0; i < fieldNames.length; i++) {
                if (fieldValues[i] && fieldValues[i].trim() !== '') {
                    console.log('Decrypting field:', fieldNames[i], 'with value length:', fieldValues[i].length);
                    decryptPromises.push(
                        $.ajax({
                            url: controllerRoute + '/DecryptField',
                            type: 'POST',
                            data: {
                                fieldValue: fieldValues[i],
                                formType: formType,
                                formId: formId
                            },
                            dataType: 'json'
                        }).then(function(response) {
                            console.log('Decryption response for field ' + fieldNames[i] + ':', response);
                            return {
                                name: fieldNames[i],
                                label: fieldLabels[i],
                                value: response.success ? response.data : ''
                            };
                        }).fail(function(xhr, status, error) {
                            console.error('Decryption failed for field ' + fieldNames[i] + ':', error);
                            return {
                                name: fieldNames[i],
                                label: fieldLabels[i],
                                value: 'Error: ' + error
                            };
                        })
                    );
                }
            }

            // Wait for all decryptions to complete
            Promise.all(decryptPromises).then(function(decryptedData) {
                console.log('All fields decrypted:', decryptedData);

                // Store decrypted data globally for the page to access
                // We'll use different global variables for different form types
                if (formType === 'Hospital') {
                    window.decryptedHospitalData = {};
                    decryptedData.forEach(function(field) {
                        window.decryptedHospitalData[field.name] = field.value;
                    });
                } else if (formType === 'Other') {
                    window.decryptedAdditionalData = {};
                    decryptedData.forEach(function(field) {
                        window.decryptedAdditionalData[field.name] = field.value;
                    });
                } else if (formType === 'Funeral') {
                    window.decryptedFuneralData = {};
                    decryptedData.forEach(function(field) {
                        window.decryptedFuneralData[field.name] = field.value;
                    });
                }

                // Build the display HTML for the modal
                let html = '';
                decryptedData.forEach(function(field) {
                    html += '<div class="field-group">';
                    html += '  <div class="field-label">' + field.label + '</div>';
                    html += '  <div class="field-value">' + (field.value || '<em class="text-muted">Not provided</em>') + '</div>';
                    html += '</div>';
                });

                $('#decryptedDataContainer').html(html);

                // Show decrypted data in modal, hide loading
                $('#loadingSpinner').hide();
                $('#decryptedDataStep').show();
            }).catch(function(error) {
                console.error('Promise.all failed:', error);
                $('#loadingSpinner').hide();
                $('#passwordVerificationStep').show();
                $('#passwordError').text('Failed to decrypt data: ' + error + '. Please try again.').show();
            });
        }

        // Handle modal close event - populate the appropriate container on the page
        $('#viewAdditionalInfoModal').on('hidden.bs.modal', function() {
            console.log('Modal closed');

            const formType = $('#viewAdditionalInfoModal').data('formType');
            console.log('Form type on modal close:', formType);

            if (formType === 'Hospital') {
                // Check if we have decrypted hospital data
                if (window.decryptedHospitalData && Object.keys(window.decryptedHospitalData).length > 0) {
                    console.log('Populating hospital info container with decrypted data');

                    // Start the loading animation
                    if (typeof startHospitalInfoLoading === 'function') {
                        startHospitalInfoLoading();
                    }

                    // After a delay, populate the fields and show the container
                    setTimeout(function() {
                        // Populate the hospital info fields on the page
                        if (window.decryptedHospitalData['HospitalFacilityName']) {
                            $('#hospitalName').text(window.decryptedHospitalData['HospitalFacilityName']);
                        }
                        if (window.decryptedHospitalData['HospitalFacilityAddress']) {
                            $('#hospitalAddress').text(window.decryptedHospitalData['HospitalFacilityAddress']);
                        }
                        if (window.decryptedHospitalData['DiagnosisMedicalCondition']) {
                            $('#diagnosis').text(window.decryptedHospitalData['DiagnosisMedicalCondition']);
                        }
                        if (window.decryptedHospitalData['WardRoomType']) {
                            $('#wardRoomType').text(window.decryptedHospitalData['WardRoomType']);
                        }
                        if (window.decryptedHospitalData['HospitalBillCost']) {
                            $('#hospitalBill').text(window.decryptedHospitalData['HospitalBillCost']);
                        }
                        if (window.decryptedHospitalData['AdmissionDate']) {
                            $('#admissionDate').text(window.decryptedHospitalData['AdmissionDate']);
                        }
                        if (window.decryptedHospitalData['DischargeDate']) {
                            $('#dischargeDate').text(window.decryptedHospitalData['DischargeDate']);
                        }

                        // Show the hospital information container
                        if (typeof showHospitalInfoAfterDecryption === 'function') {
                            showHospitalInfoAfterDecryption();
                        }

                        // Update button to "Hide Information" state
                        updateViewButton('Hospital', true);
                    }, 100);
                }
            } else if (formType === 'Other') {
                // Check if we have decrypted additional data
                if (window.decryptedAdditionalData && Object.keys(window.decryptedAdditionalData).length > 0) {
                    console.log('Populating additional info container with decrypted data');

                    // Start the loading animation for additional info
                    if (typeof startAdditionalInfoLoading === 'function') {
                        startAdditionalInfoLoading();
                    }

                    // After a delay, populate the fields and show the container
                    setTimeout(function() {
                        // Populate the additional info fields on the page
                        const assistanceType = '@ViewData["Typeassistance"]';

                        if (assistanceType === 'Medicine Assistance') {
                            if (window.decryptedAdditionalData['MedicineName']) {
                                $('#medicineName').text(window.decryptedAdditionalData['MedicineName']);
                            }
                            if (window.decryptedAdditionalData['MedicineQuantity']) {
                                $('#medicineQuantity').text(window.decryptedAdditionalData['MedicineQuantity']);
                            }
                            if (window.decryptedAdditionalData['MedicineCost']) {
                                $('#medicineCost').text(window.decryptedAdditionalData['MedicineCost']);
                            }
                            if (window.decryptedAdditionalData['PrescribingDoctor']) {
                                $('#prescribingDoctor').text(window.decryptedAdditionalData['PrescribingDoctor']);
                            }
                            if (window.decryptedAdditionalData['DoctorContactDetail']) {
                                $('#doctorContact').text(window.decryptedAdditionalData['DoctorContactDetail']);
                            }
                        } else if (assistanceType === 'Laboratory') {
                            if (window.decryptedAdditionalData['LaboratoryCenterName']) {
                                $('#labCenterName').text(window.decryptedAdditionalData['LaboratoryCenterName']);
                            }
                            if (window.decryptedAdditionalData['LaboratoryCenterAddress']) {
                                $('#labCenterAddress').text(window.decryptedAdditionalData['LaboratoryCenterAddress']);
                            }
                            if (window.decryptedAdditionalData['TestName']) {
                                $('#testName').text(window.decryptedAdditionalData['TestName']);
                            }
                            if (window.decryptedAdditionalData['TestCost']) {
                                $('#testCost').text(window.decryptedAdditionalData['TestCost']);
                            }
                            if (window.decryptedAdditionalData['TestOtherInfo']) {
                                $('#testOtherInfo').text(window.decryptedAdditionalData['TestOtherInfo']);
                            }
                        } else if (assistanceType === 'Therapy') {
                            if (window.decryptedAdditionalData['TherapyFacilityName']) {
                                $('#therapyFacilityName').text(window.decryptedAdditionalData['TherapyFacilityName']);
                            }
                            if (window.decryptedAdditionalData['TherapyFacilityAddress']) {
                                $('#therapyFacilityAddress').text(window.decryptedAdditionalData['TherapyFacilityAddress']);
                            }
                            if (window.decryptedAdditionalData['TherapyFacilityContact']) {
                                $('#therapyFacilityContact').text(window.decryptedAdditionalData['TherapyFacilityContact']);
                            }
                            if (window.decryptedAdditionalData['TherapyType']) {
                                $('#therapyType').text(window.decryptedAdditionalData['TherapyType']);
                            }
                        } else if (assistanceType === 'Medical Equipment/ Apparatus') {
                            if (window.decryptedAdditionalData['EquipmentName']) {
                                $('#equipmentName').text(window.decryptedAdditionalData['EquipmentName']);
                            }
                            if (window.decryptedAdditionalData['EquipmentBrand']) {
                                $('#equipmentBrand').text(window.decryptedAdditionalData['EquipmentBrand']);
                            }
                            if (window.decryptedAdditionalData['EquipmentCategory']) {
                                $('#equipmentCategory').text(window.decryptedAdditionalData['EquipmentCategory']);
                            }
                            if (window.decryptedAdditionalData['EquipmentQuantity']) {
                                $('#equipmentQuantity').text(window.decryptedAdditionalData['EquipmentQuantity']);
                            }
                            if (window.decryptedAdditionalData['EquipmentCost']) {
                                $('#equipmentCost').text(window.decryptedAdditionalData['EquipmentCost']);
                            }
                        }

                        // Show the additional information container
                        if (typeof showAdditionalInfoAfterDecryption === 'function') {
                            showAdditionalInfoAfterDecryption();
                        }

                        // Update button to "Hide Information" state
                        updateViewButton('Other', true);
                    }, 100);
                }
            } else if (formType === 'Funeral') {
                // Check if we have decrypted funeral data
                if (window.decryptedFuneralData && Object.keys(window.decryptedFuneralData).length > 0) {
                    console.log('Populating funeral info container with decrypted data');

                    // Start the loading animation for funeral info
                    if (typeof startFuneralInfoLoading === 'function') {
                        startFuneralInfoLoading();
                    }

                    // After a delay, populate the fields and show the container
                    setTimeout(function() {
                        // Populate the funeral info fields on the page
                        if (window.decryptedFuneralData['DeceasedName']) {
                            $('#deceasedName').text(window.decryptedFuneralData['DeceasedName']);
                        }
                        if (window.decryptedFuneralData['DeceasedAge']) {
                            $('#deceasedAge').text(window.decryptedFuneralData['DeceasedAge']);
                        }
                        if (window.decryptedFuneralData['RelationshipToDeceased']) {
                            $('#relationshipToDeceased').text(window.decryptedFuneralData['RelationshipToDeceased']);
                        }
                        if (window.decryptedFuneralData['DateOfDeath']) {
                            $('#dateOfDeath').text(window.decryptedFuneralData['DateOfDeath']);
                        }
                        if (window.decryptedFuneralData['CauseOfDeath']) {
                            $('#causeOfDeath').text(window.decryptedFuneralData['CauseOfDeath']);
                        }
                        if (window.decryptedFuneralData['FuneralServiceProvider']) {
                            $('#funeralServiceProvider').text(window.decryptedFuneralData['FuneralServiceProvider']);
                        }
                        if (window.decryptedFuneralData['FuneralServiceAddress']) {
                            $('#funeralServiceAddress').text(window.decryptedFuneralData['FuneralServiceAddress']);
                        }
                        if (window.decryptedFuneralData['FuneralServiceContact']) {
                            $('#funeralServiceContact').text(window.decryptedFuneralData['FuneralServiceContact']);
                        }
                        if (window.decryptedFuneralData['FuneralCost']) {
                            $('#funeralCost').text(window.decryptedFuneralData['FuneralCost']);
                        }
                        if (window.decryptedFuneralData['AdditionalFuneralInfo']) {
                            $('#additionalFuneralInfo').text(window.decryptedFuneralData['AdditionalFuneralInfo']);
                        }

                        // Show the funeral information container
                        if (typeof showFuneralInfoAfterDecryption === 'function') {
                            showFuneralInfoAfterDecryption();
                        }

                        // Update button to "Hide Information" state
                        updateViewButton('Funeral', true);
                    }, 100);
                }
            }

            // Reset modal state for next use
            $('#passwordVerificationStep').show();
            $('#decryptedDataStep').hide();
            $('#loadingSpinner').hide();
            $('#verificationPassword').val('');
            $('#passwordError').hide().text('');
            $('#decryptedDataContainer').html('');
        });
    }

    // ========================================================
    // BUTTON STATE MANAGEMENT
    // ========================================================
    function updateViewButton(formType, isDecrypted) {
        // Find the view button and its child elements for this form type
        let buttonId = '';
        let iconId = '';
        let textId = '';
        let hideText = '';
        let viewText = '';
        
        if (formType === 'Hospital') {
            buttonId = 'viewHospitalInfoBtn';
            iconId = 'hospitalBtnIcon';
            textId = 'hospitalBtnText';
            hideText = 'Hide Hospital Information';
            viewText = 'View Hospital Information';
        } else if (formType === 'Other') {
            buttonId = 'viewAdditionalInfoBtn';
            iconId = 'additionalBtnIcon';
            textId = 'additionalBtnText';
            hideText = 'Hide Additional Information';
            viewText = 'View Additional Information';
        } else if (formType === 'Funeral') {
            buttonId = 'viewFuneralInfoBtn';
            iconId = 'funeralBtnIcon';
            textId = 'funeralBtnText';
            hideText = 'Hide Funeral Information';
            viewText = 'View Funeral Information';
        }

        const button = document.getElementById(buttonId);
        const btnIcon = document.getElementById(iconId);
        const btnText = document.getElementById(textId);
        
        if (!button) {
            console.warn('Button not found for form type:', formType);
            return;
        }

        if (isDecrypted) {
            // Change to "Hide Information" state
            button.setAttribute('data-decrypted', 'true');
            button.classList.remove('btn-primary');
            button.classList.add('btn-warning');
            if (btnIcon) {
                btnIcon.classList.remove('bi-eye-fill');
                btnIcon.classList.add('bi-eye-slash-fill');
            }
            if (btnText) {
                btnText.textContent = hideText;
            }
        } else {
            // Change to "View Information" state
            button.setAttribute('data-decrypted', 'false');
            button.classList.remove('btn-warning');
            button.classList.add('btn-primary');
            if (btnIcon) {
                btnIcon.classList.remove('bi-eye-slash-fill');
                btnIcon.classList.add('bi-eye-fill');
            }
            if (btnText) {
                btnText.textContent = viewText;
            }
        }
    }

    function hideInformation(formType) {
        console.log('Hiding information for:', formType);

        // Hide the decrypted containers and call the page-specific hide functions if available
        if (formType === 'Hospital') {
            if (typeof hideHospitalInfo === 'function') {
                hideHospitalInfo();
            } else {
                $('#hospitalInfoContainer').hide();
                window.decryptedHospitalData = {};
                updateViewButton('Hospital', false);
            }
        } else if (formType === 'Other') {
            if (typeof hideAdditionalInfo === 'function') {
                hideAdditionalInfo();
            } else {
                $('#additionalInfoContainer').hide();
                window.decryptedAdditionalData = {};
                updateViewButton('Other', false);
            }
        } else if (formType === 'Funeral') {
            if (typeof hideFuneralInfo === 'function') {
                hideFuneralInfo();
            } else {
                $('#funeralInfoContainer').hide();
                window.decryptedFuneralData = {};
                updateViewButton('Funeral', false);
            }
        }
    }

    // ========================================================
    // RE-ENCRYPTION FUNCTIONALITY
    // ========================================================
    function reEncryptFields() {
        const formType = $('#viewAdditionalInfoModal').data('formType');
        const formId = $('#viewAdditionalInfoModal').data('formId');
        const controllerRoute = getControllerRoute();

        console.log('Re-encrypting fields for form type:', formType, 'ID:', formId);

        // Show loading
        $('#loadingSpinner').show();
        $('#decryptedDataStep').hide();

        // Get the decrypted data based on form type
        let decryptedData = null;
        if (formType === 'Hospital' && window.decryptedHospitalData) {
            decryptedData = window.decryptedHospitalData;
        } else if (formType === 'Other' && window.decryptedAdditionalData) {
            decryptedData = window.decryptedAdditionalData;
        } else if (formType === 'Funeral' && window.decryptedFuneralData) {
            decryptedData = window.decryptedFuneralData;
        }

        if (!decryptedData || Object.keys(decryptedData).length === 0) {
            console.error('No decrypted data found to re-encrypt');
            alert('No decrypted data found to re-encrypt');
            $('#loadingSpinner').hide();
            $('#decryptedDataStep').show();
            return;
        }

        // Re-encrypt all fields
        const encryptPromises = [];
        const fieldNames = Object.keys(decryptedData);

        console.log('Re-encrypting', fieldNames.length, 'fields');

        fieldNames.forEach(function(fieldName) {
            const fieldValue = decryptedData[fieldName];
            if (fieldValue && fieldValue.trim() !== '') {
                encryptPromises.push(
                    $.ajax({
                        url: controllerRoute + '/EncryptField',
                        type: 'POST',
                        data: {
                            fieldValue: fieldValue,
                            formType: formType,
                            formId: formId
                        },
                        dataType: 'json'
                    }).then(function(response) {
                        console.log('Re-encryption response for field ' + fieldName + ':', response);
                        return {
                            name: fieldName,
                            encrypted: response.success ? response.data : null
                        };
                    }).fail(function(xhr, status, error) {
                        console.error('Re-encryption failed for field ' + fieldName + ':', error);
                        return {
                            name: fieldName,
                            encrypted: null,
                            error: error
                        };
                    })
                );
            }
        });

        // Wait for all re-encryptions to complete
        Promise.all(encryptPromises).then(function(encryptedFields) {
            console.log('All fields re-encrypted:', encryptedFields);

            // Hide the decrypted data containers on the page
            if (formType === 'Hospital') {
                $('#hospitalInfoContainer').hide();
                $('#hospitalInfoLoading').hide();
                $('#hospitalInfoAlert').show();

                // Clear the decrypted data
                window.decryptedHospitalData = {};
            } else if (formType === 'Other') {
                $('#additionalInfoContainer').hide();
                $('#additionalInfoLoading').hide();
                $('#additionalInfoAlert').show();

                // Clear the decrypted data
                window.decryptedAdditionalData = {};
            } else if (formType === 'Funeral') {
                $('#funeralInfoContainer').hide();
                $('#funeralInfoLoading').hide();
                $('#funeralInfoAlert').show();

                // Clear the decrypted data
                window.decryptedFuneralData = {};
            }

            // Show success message and close modal
            $('#loadingSpinner').hide();
            alert('Data has been re-encrypted successfully! The decrypted view has been hidden.');

            // Close the modal
            var modalElement = document.getElementById('viewAdditionalInfoModal');
            if (modalElement) {
                var modal = bootstrap.Modal.getInstance(modalElement);
                if (modal) {
                    modal.hide();
                }
            }
        }).catch(function(error) {
            console.error('Re-encryption failed:', error);
            $('#loadingSpinner').hide();
            $('#decryptedDataStep').show();
            alert('Failed to re-encrypt data: ' + error);
        });
    }
</script>