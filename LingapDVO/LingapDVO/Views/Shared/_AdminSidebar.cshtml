@* ═══════════════════════════════════════════════════════════════════════════════
   ADMIN SIDEBAR - SHARED COMPONENT
   ═══════════════════════════════════════════════════════════════════════════════
   Responsive admin navigation sidebar with burger menu toggle
   Used across Admin, Analytics Dashboard, and Priorities pages
   ═══════════════════════════════════════════════════════════════════════════════ *@

<!-- Mobile Burger Menu Button -->
<button id="burgerMenuBtn" class="burger-menu-btn" aria-label="Toggle menu">
    <span class="burger-line"></span>
    <span class="burger-line"></span>
    <span class="burger-line"></span>
</button>

<!-- Sidebar Overlay (for mobile) -->
<div id="sidebarOverlay" class="sidebar-overlay"></div>

<!-- Admin Sidebar -->
<aside id="adminSidebar" class="admin-sidebar">
    <!-- Sidebar Header -->
    <div class="sidebar-header">
        <div class="sidebar-logo">
            <i class="bi bi-heart-pulse"></i>
            <span class="sidebar-logo-text">LingapDVO</span>
        </div>
    </div>

    <!-- Sidebar Navigation -->
    <nav class="sidebar-nav">
        <ul class="nav-list">
            <!-- Dashboard -->
            <li class="nav-item">
                <a href="/Adminuser/Admin" class="nav-link" data-page="admin">
                    <i class="bi bi-house-door"></i>
                    <span class="nav-text">Application Dashboard</span>
                </a>
            </li>

            <!-- Analytics Dashboard -->
            <li class="nav-item">
                <a href="/Adminuser/Analyticsdashboard" class="nav-link" data-page="analytics">
                    <i class="bi bi-bar-chart"></i>
                    <span class="nav-text">Analytics Dashboard</span>
                </a>
            </li>

            <!-- Priorities -->
            <li class="nav-item">
                <a href="/Adminuser/Priorities" class="nav-link" data-page="priorities">
                    <i class="bi bi-exclamation-triangle"></i>
                    <span class="nav-text">Priorities</span>
                    <span class="nav-badge" id="priorityBadge" style="display: none;">0</span>
                </a>
            </li>

            <!-- Logout -->
            <li class="nav-item nav-item-logout">
                <a href="/Login/Logout" class="nav-link">
                    <i class="bi bi-box-arrow-right"></i>
                    <span class="nav-text">Logout</span>
                </a>
            </li>
        </ul>
    </nav>
</aside>
