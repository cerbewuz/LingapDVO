@* ═══════════════════════════════════════════════════════════════════════════════
   ADMIN SIDEBAR - SHARED COMPONENT
   ═══════════════════════════════════════════════════════════════════════════════
   Sliding sidebar with pull arrow toggle - Manual control
   Hidden by default, user can show/hide using the pull arrow
   ═══════════════════════════════════════════════════════════════════════════════ *@

<!-- Pull Arrow Button (Desktop) -->
<button id="sidebarPullArrow" class="sidebar-pull-arrow" aria-label="Toggle sidebar">
    <i class="bi bi-chevron-right"></i>
</button>

<!-- Mobile Burger Menu Button -->
<button id="burgerMenuBtn" class="burger-menu-btn" aria-label="Toggle menu">
    <span class="burger-line"></span>
    <span class="burger-line"></span>
    <span class="burger-line"></span>
</button>

<!-- Sidebar Overlay (for mobile) -->
<div id="sidebarOverlay" class="sidebar-overlay"></div>

<!-- Admin Sidebar -->
<aside id="adminSidebar" class="admin-sidebar">
    <!-- Sidebar Header -->
    <div class="sidebar-header">
        <div class="sidebar-logo">
            <i class="bi bi-heart-pulse"></i>
            <span class="sidebar-logo-text">LingapDVO</span>
        </div>
    </div>

    <!-- Sidebar Navigation -->
    <nav class="sidebar-nav">
        <ul class="nav-list">
            <!-- Dashboard -->
            <li class="nav-item">
                <a href="/Admin" class="nav-link" data-page="admin">
                    <i class="bi bi-house-door"></i>
                    <span class="nav-text">Application Dashboard</span>
                </a>
            </li>

            <!-- Analytics Dashboard -->
            <li class="nav-item">
                <a href="/Analyticsdashboard" class="nav-link" data-page="analytics">
                    <i class="bi bi-bar-chart"></i>
                    <span class="nav-text">Analytics Dashboard</span>
                </a>
            </li>

            <!-- Feedback Analytics -->
            <li class="nav-item">
                <a href="/Feedbacksreport" class="nav-link" data-page="feedback-analytics">
                    <i class="bi bi-chat-square-text"></i>
                    <span class="nav-text">Feedback Analytics</span>
                </a>
            </li>

            <!-- Delayed Applications -->
            <li class="nav-item">
                <a href="/DelayedApplications" class="nav-link" data-page="delayed-applications">
                    <i class="bi bi-exclamation-triangle"></i>
                    <span class="nav-text">Delayed Applications</span>
                    <span class="nav-badge" id="priorityBadge" style="display: none;">0</span>
                </a>
            </li>

            <!-- Logout -->
            <li class="nav-item nav-item-logout">
                <a href="/Logout" class="nav-link">
                    <i class="bi bi-box-arrow-right"></i>
                    <span class="nav-text">Logout</span>
                </a>
            </li>
        </ul>
    </nav>
</aside>
