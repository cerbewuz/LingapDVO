<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>@ViewData["Title"] - LingapDVO</title>
    <link rel="icon" type="image/x-icon" href="~/Icon/lingaplogo.ico">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <!-- Google Fonts - Inter & Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Go Back Button -->
    <link rel="stylesheet" href="~/css/go-back-button.css">

    <!-- Forms Layout Styling -->
    <link rel="stylesheet" href="~/css/forms-layout.css">

    <!-- Modal Styles -->
    <link rel="stylesheet" href="~/css/modal-styles.css">

    <!-- Shared Form Styles (Common styling for all forms) -->
    <link rel="stylesheet" href="~/css/forms-shared-styles.css">

    <!-- PDF.js for PDF viewing -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>

    <!-- Session Timeout -->
    @await Html.PartialAsync("_SessionTimeout")

    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="forms-layout-wrapper">
        <!-- Go Back Button -->
        <a href="#" class="go-back-btn" onclick="if (document.referrer && document.referrer !== '') { history.back(); } else { window.location.href = '/Adminuser/Admin'; } return false;">
            <i class="fas fa-arrow-left"></i>
            <span>Back</span>
        </a>

        <div class="form-container">
            <!-- Official Form Header -->
            <div class="official-form-header">
                <div class="header-content-flex">
                    <div class="header-logo">
                        <img src="~/Icon/lingaplogo.png" alt="Lingap Logo" class="lingap-logo">
                    </div>
                    <div class="header-text">
                        <h1 class="header-title">Lingap Para sa Mahirap</h1>
                        <p class="header-subtitle">City of Davao</p>
                        <h2 class="header-form-title">Approve Assistance Form</h2>
                    </div>
                </div>
            </div>

            <!-- Form Content -->
            <div class="form-content-wrapper">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- jQuery Validation -->
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>

    <!-- Go Back Button Behavior -->
    <script src="~/js/go-back-button.js" defer></script>

    <!-- Security Scripts -->
    <script src="~/js/security.js"></script>

    <!-- Image Zoom -->
    <script src="~/js/image-zoom.js"></script>

    <!-- Admin Status Functions -->
    <script src="~/js/admin-status-functions.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
