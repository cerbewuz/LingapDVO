@model LingapDVO.Models.CombinedFormsViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Application Tracking</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #4361ee;
            --primary-light: #eef2ff;
            --primary-dark: #3a56d4;
            --secondary-color: #6c757d;
            --light-gray: #f8f9fa;
            --dark-gray: #2d3748;
            --success-color: #10b981;
            --warning-color: #f59e0b;
            --danger-color: #ef4444;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background-color: #f8fafc;
            color: #2d3748;
            margin: 0;
            padding: 0;
            line-height: 1.5;
        }

        .go-back-top {
            position: fixed;
            left: 20px;
            top: 20px;
            z-index: 1000;
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            border-radius: 8px;
            background: white;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            transition: all 0.2s;
            cursor: pointer;
            border: 1px solid #e2e8f0;
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
        }

            .go-back-top:hover {
                background: var(--primary-color);
                color: white;
                border-color: var(--primary-color);
            }

        .container {
            padding: 1rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .header {
            text-align: center;
            margin-bottom: 1.5rem;
            padding: 1rem 0;
        }

            .header h2 {
                color: var(--dark-gray);
                font-weight: 700;
                font-size: 1.8rem;
                margin-bottom: 0.5rem;
            }

            .header p {
                color: var(--secondary-color);
                font-size: 1rem;
                margin: 0;
            }

        .tab-container {
            margin-bottom: 1.5rem;
        }

        .nav-tabs {
            border: none;
            background: white;
            border-radius: 12px;
            padding: 0.5rem;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
            display: inline-flex;
        }

            .nav-tabs .nav-link {
                border: none;
                color: var(--secondary-color);
                font-weight: 600;
                padding: 0.75rem 1.25rem;
                margin: 0 0.25rem;
                border-radius: 8px;
                transition: all 0.2s;
            }

                .nav-tabs .nav-link.active {
                    color: white;
                    background: var(--primary-color);
                }

                .nav-tabs .nav-link:hover:not(.active) {
                    color: var(--primary-color);
                    background: var(--primary-light);
                }

        .badge {
            font-size: 0.7rem;
            padding: 0.25rem 0.5rem;
            border-radius: 12px;
            font-weight: 600;
        }

        .tracking-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
            margin-bottom: 1.5rem;
            overflow: hidden;
            border: 1px solid #f1f5f9;
        }

        .tracking-header {
            background: linear-gradient(135deg, #f8fafc, #f1f5f9);
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid #e2e8f0;
        }

            .tracking-header h5 {
                margin: 0;
                font-weight: 600;
                font-size: 1.1rem;
                color: var(--dark-gray);
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

        .tracking-date {
            font-size: 0.85rem;
            color: var(--secondary-color);
            margin-top: 0.5rem;
        }

        .tracking-body {
            padding: 1.5rem;
        }

        .timeline {
            position: relative;
            padding-left: 2rem;
        }

            .timeline::before {
                content: '';
                position: absolute;
                left: 16px;
                top: 0;
                bottom: 0;
                width: 2px;
                background: #e2e8f0;
            }

        .timeline-item {
            position: relative;
            margin-bottom: 1.25rem;
        }

            .timeline-item:last-child {
                margin-bottom: 0;
            }

        .timeline-marker {
            position: absolute;
            left: -2rem;
            top: 0;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            z-index: 1;
            border: 3px solid white;
        }

        .timeline-content {
            background: #f8fafc;
            border-radius: 8px;
            padding: 1rem;
            border: 1px solid #f1f5f9;
        }

            .timeline-content h6 {
                font-weight: 600;
                margin-bottom: 0.5rem;
                color: var(--dark-gray);
                font-size: 0.95rem;
            }

        .timeline-date {
            font-size: 0.8rem;
            color: var(--secondary-color);
            margin-bottom: 0.5rem;
            display: block;
        }

        .timeline-description {
            font-size: 0.85rem;
            color: var(--secondary-color);
            margin-bottom: 0;
            line-height: 1.4;
        }

        .timeline-marker.submitted {
            background: var(--success-color);
        }

        .timeline-marker.processing {
            background: var(--warning-color);
        }

        .timeline-marker.approved {
            background: var(--success-color);
        }

        .timeline-marker.unapproved {
            background: var(--danger-color);
        }

        .timeline-marker.waiting {
            background: var(--secondary-color);
        }

        .waiting-text {
            color: var(--secondary-color);
            font-style: italic;
            margin-bottom: 0;
            font-size: 0.85rem;
        }

        .status-badge {
            padding: 0.4rem 0.8rem;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
        }

        .status-pending {
            background: #fef3c7;
            color: #92400e;
        }

        .status-processing {
            background: #dbeafe;
            color: #1e40af;
        }

        .status-approved {
            background: #d1fae5;
            color: #065f46;
        }

        .status-unapproved {
            background: #fee2e2;
            color: #991b1b;
        }

        .empty-state {
            padding: 2rem 1rem;
            text-align: center;
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        }

            .empty-state i {
                font-size: 2.5rem;
                color: var(--primary-color);
                margin-bottom: 1rem;
                opacity: 0.7;
            }

            .empty-state h5 {
                color: var(--dark-gray);
                margin-bottom: 0.5rem;
                font-weight: 600;
            }

            .empty-state p {
                color: var(--secondary-color);
                font-size: 0.9rem;
                margin: 0;
            }

        .application-actions {
            display: flex;
            gap: 0.5rem;
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px solid #f1f5f9;
        }

        .btn-action {
            padding: 0.5rem 1rem;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 500;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            transition: all 0.2s;
            border: 1px solid transparent;
        }

        .btn-edit {
            background: var(--primary-light);
            color: var(--primary-color);
            border-color: var(--primary-light);
        }

            .btn-edit:hover {
                background: var(--primary-color);
                color: white;
            }

        .btn-view {
            background: #f1f5f9;
            color: var(--secondary-color);
            border-color: #e2e8f0;
        }

            .btn-view:hover {
                background: var(--secondary-color);
                color: white;
            }

        .btn-remove {
            background: #fef2f2;
            color: var(--danger-color);
            border-color: #fecaca;
        }

            .btn-remove:hover {
                background: var(--danger-color);
                color: white;
            }

        /* Past Data Filter Styles */
        .filter-container {
            background: white;
            border-radius: 12px;
            padding: 1rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .filter-group {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .filter-label {
            font-weight: 600;
            color: var(--dark-gray);
            font-size: 0.9rem;
        }

        .filter-select {
            padding: 0.5rem 1rem;
            border-radius: 6px;
            border: 1px solid #e2e8f0;
            background: white;
            color: var(--dark-gray);
            font-size: 0.9rem;
            cursor: pointer;
        }

        .filter-btn {
            padding: 0.5rem 1rem;
            border-radius: 6px;
            background: var(--primary-color);
            color: white;
            border: none;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .filter-btn:hover {
                background: var(--primary-dark);
            }

        .date-range {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .date-input {
            padding: 0.5rem;
            border-radius: 6px;
            border: 1px solid #e2e8f0;
            font-size: 0.9rem;
        }

        .past-data-toggle {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
            padding: 0.5rem 1rem;
            border-radius: 6px;
            background: var(--primary-light);
            color: var(--primary-color);
            font-weight: 500;
            transition: all 0.2s;
        }

            .past-data-toggle:hover {
                background: var(--primary-color);
                color: white;
            }

            .past-data-toggle.active {
                background: var(--primary-color);
                color: white;
            }

        .past-data-section {
            display: none;
            margin-top: 1.5rem;
        }

            .past-data-section.active {
                display: block;
            }

        .past-data-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid #e2e8f0;
        }

            .past-data-header h4 {
                color: var(--dark-gray);
                font-weight: 600;
                font-size: 1.2rem;
                margin: 0;
            }

        .past-data-summary {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .summary-card {
            background: white;
            border-radius: 8px;
            padding: 1rem;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
            text-align: center;
        }

            .summary-card h5 {
                font-size: 0.9rem;
                color: var(--secondary-color);
                margin: 0 0 0.5rem 0;
                font-weight: 500;
            }

            .summary-card .count {
                font-size: 1.5rem;
                font-weight: 700;
                color: var(--primary-color);
            }

        .past-data-table {
            background: white;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
        }

        .table {
            width: 100%;
            border-collapse: collapse;
        }

            .table th {
                background: #f8fafc;
                padding: 0.75rem 1rem;
                text-align: left;
                font-weight: 600;
                color: var(--dark-gray);
                border-bottom: 1px solid #e2e8f0;
                font-size: 0.85rem;
            }

            .table td {
                padding: 0.75rem 1rem;
                border-bottom: 1px solid #f1f5f9;
                font-size: 0.85rem;
            }

            .table tr:last-child td {
                border-bottom: none;
            }

        .export-btn {
            padding: 0.5rem 1rem;
            border-radius: 6px;
            background: var(--success-color);
            color: white;
            border: none;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .export-btn:hover {
                background: #0da271;
            }
    </style>
</head>
<body>
    <a href="javascript:void(0)" class="go-back-top" id="goBackBtn">
        <i class="fas fa-arrow-left"></i> Back
    </a>

    <div class="container" style="margin-top: 60px;">
        <div class="header">
            <h2>Application Tracking</h2>
            <p>Track the status of all your assistance applications in one place</p>
        </div>

        <!-- Past Data Toggle -->
        <div class="filter-container">
            <div class="filter-group">
                <div class="past-data-toggle" id="pastDataToggle">
                    <i class="fas fa-history"></i>
                    <span>View Past Tracking Data</span>
                </div>
            </div>
            <div class="filter-group" id="dateFilterGroup" style="display: none;">
                <span class="filter-label">Date Range:</span>
                <div class="date-range">
                    <input type="date" class="date-input" id="startDate">
                    <span>to</span>
                    <input type="date" class="date-input" id="endDate">
                </div>
                <button class="filter-btn" id="applyFilter">
                    <i class="fas fa-filter"></i> Apply Filter
                </button>
                <button class="export-btn" id="exportData">
                    <i class="fas fa-download"></i> Export Data
                </button>
            </div>
        </div>

        <!-- Past Data Section -->
        <div class="past-data-section" id="pastDataSection">
            <div class="past-data-header">
                <h4>Past Application Data</h4>
                <div id="dateRangeDisplay">Showing all applications</div>
            </div>

            <div class="past-data-summary" id="pastDataSummary">
                <!-- Summary cards will be populated by JavaScript -->
            </div>

            <div class="past-data-table">
                <table class="table" id="pastDataTable">
                    <thead>
                        <tr>
                            <th>Application Type</th>
                            <th>Applicant Name</th>
                            <th>Status</th>
                            <th>Submitted Date</th>
                            <th>Processed Date</th>
                            <th>Result Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="pastDataTableBody">
                        <!-- Table rows will be populated by JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Current Tracking Data -->
        <div class="tab-container">
            <ul class="nav nav-tabs" id="trackingTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="hospital-tab" data-bs-toggle="tab" data-bs-target="#hospital" type="button">
                        <i class="fas fa-hospital me-1"></i>Hospital Bills
                        <span class="badge bg-primary ms-1">@Model.HospitalBills.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="medical-tab" data-bs-toggle="tab" data-bs-target="#medical" type="button">
                        <i class="fas fa-microscope me-1"></i>Medical/Lab
                        <span class="badge bg-primary ms-1">@Model.MedicalLabForms.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="funeral-tab" data-bs-toggle="tab" data-bs-target="#funeral" type="button">
                        <i class="fas fa-monument me-1"></i>Funeral
                        <span class="badge bg-primary ms-1">@Model.Funeralburialform.Count</span>
                    </button>
                </li>
            </ul>
        </div>

        <div class="tab-content" id="trackingTabsContent">
            <!-- Hospital Bills Tab -->
            <div class="tab-pane fade show active" id="hospital" role="tabpanel">
                @{
                    var hospitalBills = Model.HospitalBills.OrderByDescending(f => f.CreatedAt).ToList();
                }
                @if (hospitalBills.Any())
                {
                    @foreach (var doc in hospitalBills)
                    {
                        <div class="tracking-card">
                            <div class="tracking-header">
                                <h5><i class="fas fa-hospital"></i>@doc.Lastname, @doc.Firstname @doc.Middlename</h5>
                                <div class="tracking-date">
                                    <i class="fas fa-calendar me-1"></i>Submitted: @doc.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                                </div>
                            </div>
                            <div class="tracking-body">
                                <div class="timeline">
                                    <!-- Step 1: Document Submitted -->
                                    <div class="timeline-item">
                                        <div class="timeline-marker submitted">
                                            <i class="fas fa-file-alt"></i>
                                        </div>
                                        <div class="timeline-content">
                                            <h6>Document Submitted</h6>
                                            <span class="timeline-date">@doc.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                                            <p class="timeline-description">Hospital Bill Assistance form was successfully submitted.</p>
                                        </div>
                                    </div>

                                    <!-- Step 2: Processing -->
                                    @if (doc.ProcessAt > DateTime.MinValue && doc.ProcessAt.Year > 1 && !string.IsNullOrWhiteSpace(doc.Processby))
                                    {
                                        <div class="timeline-item">
                                            <div class="timeline-marker processing">
                                                <i class="fas fa-cog"></i>
                                            </div>
                                            <div class="timeline-content">
                                                <h6>Processing</h6>
                                                <span class="timeline-date">@doc.ProcessAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                                                <p class="timeline-description">Processed by: <strong>@doc.Processby</strong></p>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="timeline-item">
                                            <div class="timeline-marker waiting">
                                                <i class="fas fa-clock"></i>
                                            </div>
                                            <div class="timeline-content">
                                                <h6>Processing</h6>
                                                <p class="waiting-text">Waiting for staff to process your application...</p>
                                            </div>
                                        </div>
                                    }

                                    <!-- Step 3: Result -->
                                    @if (doc.Result > DateTime.MinValue && doc.Result.Year > 1)
                                    {
                                        <div class="timeline-item">
                                            <div class="timeline-marker @(doc.Status2 == "Approved" ? "approved" : "unapproved")">
                                                <i class="fas fa-check-circle"></i>
                                            </div>
                                            <div class="timeline-content">
                                                <h6>@doc.Status</h6>
                                                <span class="timeline-date">@doc.Result.ToString("dd MMM yyyy, hh:mm tt")</span>
                                                <p class="timeline-description">
                                                    Result: <span class="status-badge status-@(doc.Status2.ToLower())">@doc.Status2</span>
                                                </p>
                                                @if (!string.IsNullOrWhiteSpace(doc.Comments))
                                                {
                                                    <p class="timeline-description mt-2"><strong>Comments:</strong> @doc.Comments</p>
                                                }
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="timeline-item">
                                            <div class="timeline-marker waiting">
                                                <i class="fas fa-clock"></i>
                                            </div>
                                            <div class="timeline-content">
                                                <h6>Result</h6>
                                                <p class="waiting-text">Waiting for result...</p>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Action Buttons -->
                                <div class="application-actions">
                                    <a class="btn-action btn-view" asp-controller="Dashboard" asp-action="Fillupformhospitalbillview" asp-route-id="@doc.Id">
                                        <i class="fas fa-eye"></i> View Details
                                    </a>
                                    @if (doc.Status?.ToLower() != "processing" && doc.Status?.ToLower() != "unapproved")
                                    {
                                        <a class="btn-action btn-edit" asp-controller="Dashboard" asp-action="FillupformHospitalBilledit" asp-route-id="@doc.Id">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <a class="btn-action btn-remove" asp-controller="Dashboard" asp-action="FillupformHospitalBilldelete" asp-route-id="@doc.Id">
                                            <i class="fas fa-trash-alt"></i> Remove
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-folder-open"></i>
                        <h5>No Hospital Bill Applications</h5>
                        <p>You haven't submitted any hospital bill assistance applications yet.</p>
                    </div>
                }
            </div>

            <!-- Medical/Lab Tab -->
            <div class="tab-pane fade" id="medical" role="tabpanel">
                @{
                    var medicalForms = Model.MedicalLabForms.OrderByDescending(f => f.CreatedAt).ToList();
                }
                @if (medicalForms.Any())
                {
                    @foreach (var doc in medicalForms)
                    {
                        <div class="tracking-card">
                            <div class="tracking-header">
                                <h5><i class="fas fa-microscope"></i>@doc.Lastname, @doc.Firstname @doc.Middlename</h5>
                                <div class="tracking-date">
                                    <i class="fas fa-calendar me-1"></i>Submitted: @doc.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                                </div>
                            </div>
                            <div class="tracking-body">
                                <div class="timeline">
                                    <!-- Step 1: Document Submitted -->
                                    <div class="timeline-item">
                                        <div class="timeline-marker submitted">
                                            <i class="fas fa-file-alt"></i>
                                        </div>
                                        <div class="timeline-content">
                                            <h6>Document Submitted</h6>
                                            <span class="timeline-date">@doc.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                                            <p class="timeline-description">Medical and Laboratory Procedure form was successfully submitted.</p>
                                        </div>
                                    </div>

                                    <!-- Step 2: Processing -->
                                    @if (doc.ProcessAt > DateTime.MinValue && doc.ProcessAt.Year > 1 && !string.IsNullOrWhiteSpace(doc.Processby))
                                    {
                                        <div class="timeline-item">
                                            <div class="timeline-marker processing">
                                                <i class="fas fa-cog"></i>
                                            </div>
                                            <div class="timeline-content">
                                                <h6>Processing</h6>
                                                <span class="timeline-date">@doc.ProcessAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                                                <p class="timeline-description">Processed by: <strong>@doc.Processby</strong></p>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="timeline-item">
                                            <div class="timeline-marker waiting">
                                                <i class="fas fa-clock"></i>
                                            </div>
                                            <div class="timeline-content">
                                                <h6>Processing</h6>
                                                <p class="waiting-text">Waiting for staff to process your application...</p>
                                            </div>
                                        </div>
                                    }

                                    <!-- Step 3: Result -->
                                    @if (doc.Result > DateTime.MinValue && doc.Result.Year > 1)
                                    {
                                        <div class="timeline-item">
                                            <div class="timeline-marker @(doc.Status2 == "Approved" ? "approved" : "unapproved")">
                                                <i class="fas fa-check-circle"></i>
                                            </div>
                                            <div class="timeline-content">
                                                <h6>@doc.Status</h6>
                                                <span class="timeline-date">@doc.Result.ToString("dd MMM yyyy, hh:mm tt")</span>
                                                <p class="timeline-description">
                                                    Result: <span class="status-badge status-@(doc.Status2.ToLower())">@doc.Status2</span>
                                                </p>
                                                @if (!string.IsNullOrWhiteSpace(doc.Comments))
                                                {
                                                    <p class="timeline-description mt-2"><strong>Comments:</strong> @doc.Comments</p>
                                                }
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="timeline-item">
                                            <div class="timeline-marker waiting">
                                                <i class="fas fa-clock"></i>
                                            </div>
                                            <div class="timeline-content">
                                                <h6>Result</h6>
                                                <p class="waiting-text">Waiting for result...</p>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Action Buttons -->
                                <div class="application-actions">
                                    <a class="btn-action btn-view" asp-controller="Dashboard" asp-action="Medicalandlabformview" asp-route-id="@doc.Id">
                                        <i class="fas fa-eye"></i> View Details
                                    </a>
                                    @if (doc.Status?.ToLower() != "processing" && doc.Status?.ToLower() != "unapproved")
                                    {
                                        <a class="btn-action btn-edit" asp-controller="Dashboard" asp-action="Medicalandlabformedit" asp-route-id="@doc.Id">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <a class="btn-action btn-remove" asp-controller="Dashboard" asp-action="Medicalandlabformedelete" asp-route-id="@doc.Id">
                                            <i class="fas fa-trash-alt"></i> Remove
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-folder-open"></i>
                        <h5>No Medical/Lab Applications</h5>
                        <p>You haven't submitted any medical or laboratory procedure applications yet.</p>
                    </div>
                }
            </div>

            <!-- Funeral Tab -->
            <div class="tab-pane fade" id="funeral" role="tabpanel">
                @{
                    var funeralForms = Model.Funeralburialform.OrderByDescending(f => f.CreatedAt).ToList();
                }
                @if (funeralForms.Any())
                {
                    @foreach (var doc in funeralForms)
                    {
                        <div class="tracking-card">
                            <div class="tracking-header">
                                <h5><i class="fas fa-monument"></i>@doc.Lastname, @doc.Firstname @doc.Middlename</h5>
                                <div class="tracking-date">
                                    <i class="fas fa-calendar me-1"></i>Submitted: @doc.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                                </div>
                            </div>
                            <div class="tracking-body">
                                <div class="timeline">
                                    <!-- Step 1: Document Submitted -->
                                    <div class="timeline-item">
                                        <div class="timeline-marker submitted">
                                            <i class="fas fa-file-alt"></i>
                                        </div>
                                        <div class="timeline-content">
                                            <h6>Document Submitted</h6>
                                            <span class="timeline-date">@doc.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                                            <p class="timeline-description">Funeral and Burial Assistance form was successfully submitted.</p>
                                        </div>
                                    </div>

                                    <!-- Step 2: Processing -->
                                    @if (doc.ProcessAt > DateTime.MinValue && doc.ProcessAt.Year > 1 && !string.IsNullOrWhiteSpace(doc.Processby))
                                    {
                                        <div class="timeline-item">
                                            <div class="timeline-marker processing">
                                                <i class="fas fa-cog"></i>
                                            </div>
                                            <div class="timeline-content">
                                                <h6>Processing</h6>
                                                <span class="timeline-date">@doc.ProcessAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                                                <p class="timeline-description">Processed by: <strong>@doc.Processby</strong></p>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="timeline-item">
                                            <div class="timeline-marker waiting">
                                                <i class="fas fa-clock"></i>
                                            </div>
                                            <div class="timeline-content">
                                                <h6>Processing</h6>
                                                <p class="waiting-text">Waiting for staff to process your application...</p>
                                            </div>
                                        </div>
                                    }

                                    <!-- Step 3: Result -->
                                    @if (doc.Result > DateTime.MinValue && doc.Result.Year > 1)
                                    {
                                        <div class="timeline-item">
                                            <div class="timeline-marker @(doc.Status2 == "Approved" ? "approved" : "unapproved")">
                                                <i class="fas fa-check-circle"></i>
                                            </div>
                                            <div class="timeline-content">
                                                <h6>@doc.Status</h6>
                                                <span class="timeline-date">@doc.Result.ToString("dd MMM yyyy, hh:mm tt")</span>
                                                <p class="timeline-description">
                                                    Result: <span class="status-badge status-@(doc.Status2.ToLower())">@doc.Status2</span>
                                                </p>
                                                @if (!string.IsNullOrWhiteSpace(doc.Comments))
                                                {
                                                    <p class="timeline-description mt-2"><strong>Comments:</strong> @doc.Comments</p>
                                                }
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="timeline-item">
                                            <div class="timeline-marker waiting">
                                                <i class="fas fa-clock"></i>
                                            </div>
                                            <div class="timeline-content">
                                                <h6>Result</h6>
                                                <p class="waiting-text">Waiting for result...</p>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Action Buttons -->
                                <div class="application-actions">
                                    <a class="btn-action btn-view" asp-controller="Dashboard" asp-action="Funeralburialformview" asp-route-id="@doc.Id">
                                        <i class="fas fa-eye"></i> View Details
                                    </a>
                                    @if (doc.Status?.ToLower() != "processing" && doc.Status?.ToLower() != "unapproved")
                                    {
                                        <a class="btn-action btn-edit" asp-controller="Dashboard" asp-action="Funeralburialformedit" asp-route-id="@doc.Id">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <a class="btn-action btn-remove" asp-controller="Dashboard" asp-action="Funeralburialformedelete" asp-route-id="@doc.Id">
                                            <i class="fas fa-trash-alt"></i> Remove
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-folder-open"></i>
                        <h5>No Funeral Applications</h5>
                        <p>You haven't submitted any funeral and burial assistance applications yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('goBackBtn').addEventListener('click', function() {
            window.history.back();
        });

        // Past Data Feature
        const pastDataToggle = document.getElementById('pastDataToggle');
        const pastDataSection = document.getElementById('pastDataSection');
        const dateFilterGroup = document.getElementById('dateFilterGroup');
        const applyFilter = document.getElementById('applyFilter');
        const exportData = document.getElementById('exportData');
        const startDate = document.getElementById('startDate');
        const endDate = document.getElementById('endDate');
        const pastDataSummary = document.getElementById('pastDataSummary');
        const pastDataTableBody = document.getElementById('pastDataTableBody');
        const dateRangeDisplay = document.getElementById('dateRangeDisplay');

        // Set default dates (last 30 days)
        const today = new Date();
        const thirtyDaysAgo = new Date();
        thirtyDaysAgo.setDate(today.getDate() - 30);

        startDate.value = thirtyDaysAgo.toISOString().split('T')[0];
        endDate.value = today.toISOString().split('T')[0];

        // Toggle past data section
        pastDataToggle.addEventListener('click', function() {
            const isActive = pastDataToggle.classList.contains('active');

            if (!isActive) {
                pastDataToggle.classList.add('active');
                dateFilterGroup.style.display = 'flex';
                pastDataSection.classList.add('active');
                loadPastData();
            } else {
                pastDataToggle.classList.remove('active');
                dateFilterGroup.style.display = 'none';
                pastDataSection.classList.remove('active');
            }
        });

        // Load past data
        function loadPastData() {
            const start = new Date(startDate.value);
            const end = new Date(endDate.value);
            end.setHours(23, 59, 59, 999); // End of the day

            // Update date range display
            dateRangeDisplay.textContent = `Showing applications from ${formatDate(start)} to ${formatDate(end)}`;

            // Collect all applications from the page
            const allApplications = collectAllApplications();

            // Filter by date range
            const filteredApplications = allApplications.filter(app => {
                const appDate = new Date(app.submittedDate);
                return appDate >= start && appDate <= end;
            });

            // Update summary
            updateSummary(filteredApplications);

            // Update table
            updateTable(filteredApplications);
        }

        // Collect all applications from the current page with CORRECT status detection
        function collectAllApplications() {
            const applications = [];

            // Helper function to detect status for each card
            function detectStatus(card) {
                // Check if there's a final result (approved/unapproved)
                const resultMarker = card.querySelector('.timeline-item:nth-child(3) .timeline-marker.approved, .timeline-item:nth-child(3) .timeline-marker.unapproved');
                if (resultMarker) {
                    return resultMarker.classList.contains('approved') ? 'Approved' : 'Unapproved';
                }

                // Check if processing has started
                const processingMarker = card.querySelector('.timeline-item:nth-child(2) .timeline-marker.processing');
                if (processingMarker) {
                    return 'Processing';
                }

                // Default to pending
                return 'Pending';
            }

            // Hospital Bills
            document.querySelectorAll('#hospital .tracking-card').forEach(card => {
                const header = card.querySelector('.tracking-header h5');
                const dateText = card.querySelector('.tracking-date').textContent;

                applications.push({
                    type: 'Hospital Bill',
                    name: header.textContent.replace('Hospital', '').trim(),
                    status: detectStatus(card),
                    submittedDate: extractDate(dateText),
                    processedDate: extractProcessedDate(card),
                    resultDate: extractResultDate(card),
                    id: extractId(card)
                });
            });

            // Medical/Lab
            document.querySelectorAll('#medical .tracking-card').forEach(card => {
                const header = card.querySelector('.tracking-header h5');
                const dateText = card.querySelector('.tracking-date').textContent;

                applications.push({
                    type: 'Medical/Lab',
                    name: header.textContent.replace('Microscope', '').trim(),
                    status: detectStatus(card),
                    submittedDate: extractDate(dateText),
                    processedDate: extractProcessedDate(card),
                    resultDate: extractResultDate(card),
                    id: extractId(card)
                });
            });

            // Funeral
            document.querySelectorAll('#funeral .tracking-card').forEach(card => {
                const header = card.querySelector('.tracking-header h5');
                const dateText = card.querySelector('.tracking-date').textContent;

                applications.push({
                    type: 'Funeral',
                    name: header.textContent.replace('Monument', '').trim(),
                    status: detectStatus(card),
                    submittedDate: extractDate(dateText),
                    processedDate: extractProcessedDate(card),
                    resultDate: extractResultDate(card),
                    id: extractId(card)
                });
            });

            return applications;
        }

        // Helper functions to extract data from cards
        function extractDate(dateText) {
            const match = dateText.match(/Submitted: (.*)/);
            return match ? new Date(match[1]) : new Date();
        }

        function extractProcessedDate(card) {
            const processingItem = card.querySelector('.timeline-item:nth-child(2) .timeline-date');
            return processingItem ? new Date(processingItem.textContent) : null;
        }

        function extractResultDate(card) {
            const resultItem = card.querySelector('.timeline-item:nth-child(3) .timeline-date');
            return resultItem ? new Date(resultItem.textContent) : null;
        }

        function extractId(card) {
            const viewLink = card.querySelector('.btn-view');
            if (viewLink) {
                const href = viewLink.getAttribute('href');
                const match = href.match(/\/\d+$/);
                return match ? match[0].substring(1) : null;
            }
            return null;
        }

        // Update summary cards
        function updateSummary(applications) {
            const total = applications.length;
            const approved = applications.filter(app => app.status === 'Approved').length;
            const pending = applications.filter(app => app.status === 'Pending').length;
            const processing = applications.filter(app => app.status === 'Processing').length;
            const unapproved = applications.filter(app => app.status === 'Unapproved').length;

            pastDataSummary.innerHTML = `
                <div class="summary-card">
                    <h5>Total Applications</h5>
                    <div class="count">${total}</div>
                </div>
                <div class="summary-card">
                    <h5>Approved</h5>
                    <div class="count" style="color: var(--success-color);">${approved}</div>
                </div>
                <div class="summary-card">
                    <h5>Pending</h5>
                    <div class="count" style="color: var(--warning-color);">${pending}</div>
                </div>
                <div class="summary-card">
                    <h5>Processing</h5>
                    <div class="count" style="color: var(--primary-color);">${processing}</div>
                </div>
                <div class="summary-card">
                    <h5>Unapproved</h5>
                    <div class="count" style="color: var(--danger-color);">${unapproved}</div>
                </div>
            `;
        }

        // Update table with applications
        function updateTable(applications) {
            pastDataTableBody.innerHTML = '';

            if (applications.length === 0) {
                pastDataTableBody.innerHTML = `
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 2rem;">
                            <i class="fas fa-folder-open" style="font-size: 2rem; color: var(--secondary-color); margin-bottom: 1rem; display: block;"></i>
                            <p style="color: var(--secondary-color); margin: 0;">No applications found in the selected date range.</p>
                        </td>
                    </tr>
                `;
                return;
            }

            applications.forEach(app => {
                const row = document.createElement('tr');

                // Determine status badge class
                let statusClass = 'status-pending';
                if (app.status === 'Approved') statusClass = 'status-approved';
                else if (app.status === 'Processing') statusClass = 'status-processing';
                else if (app.status === 'Unapproved') statusClass = 'status-unapproved';

                row.innerHTML = `
                    <td>${app.type}</td>
                    <td>${app.name}</td>
                    <td><span class="status-badge ${statusClass}">${app.status}</span></td>
                    <td>${formatDate(new Date(app.submittedDate))}</td>
                    <td>${app.processedDate ? formatDate(app.processedDate) : '-'}</td>
                    <td>${app.resultDate ? formatDate(app.resultDate) : '-'}</td>
                    <td>
                        ${app.id ? `<a href="/Dashboard/Fillupformhospitalbillview/${app.id}" class="btn-action btn-view" style="padding: 0.25rem 0.5rem; font-size: 0.7rem;">
                            <i class="fas fa-eye"></i> View
                        </a>` : ''}
                    </td>
                `;

                pastDataTableBody.appendChild(row);
            });
        }

        // Format date for display
        function formatDate(date) {
            return date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric'
            });
        }

        // Event listeners
        applyFilter.addEventListener('click', loadPastData);

        exportData.addEventListener('click', function() {
            alert('Export functionality would be implemented here. This would typically generate a CSV or PDF report of the filtered data.');
        });

        // Load initial data if past data section is active on page load
        if (pastDataToggle.classList.contains('active')) {
            loadPastData();
        }
    </script>
</body>
</html>