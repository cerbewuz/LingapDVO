                                        {
                                            <div class="timeline-item">
                                                <div class="timeline-marker waiting">
                                                    <i class="fas fa-gift"></i>
                                                </div>
                                                <div class="timeline-content">
                                                    <h6>Ready for Release</h6>
                                                    <p class="waiting-text">Your assistance is ready. Please visit our office to collect it.</p>
                                                </div>
                                            </div>
                                        }
                                    }

                                    <!-- Step 3.5: Retake Request (Show if Status2 is "Retake") -->
                                    @if (doc.Status2 == "Retake")
                                    {
                                        <div class="timeline-item">
                                            <div class="timeline-marker retake">
                                                <i class="fas fa-arrow-rotate-left"></i>
                                            </div>
                                            <div class="timeline-content">
                                                <h6>📝 Action Required - Retake Application</h6>
                                                <span class="timeline-date">@doc.Result.ToString("dd MMM yyyy, hh:mm tt")</span>
                                                <p class="timeline-description">
                                                    We need additional documents or corrections for your application. Please review the comments below and resubmit your application with the required updates.
                                                </p>
                                                @if (!string.IsNullOrWhiteSpace(doc.RetakeReason))
                                                {
                                                    <div style="background-color: #fff3cd; border-left: 4px solid #ff9800; padding: 12px; border-radius: 6px; margin-top: 12px;">
                                                        <p class="mb-2" style="font-weight: 600; color: #9a3412;"><i class="fas fa-info-circle me-1"></i> What needs to be updated:</p>
                                                        <p class="mb-0" style="color: #666;">@doc.RetakeReason</p>
                                                    </div>
                                                }
                                                <div style="margin-top: 16px;">
                                                    <a href="@Url.Action("FuneralAssistanceEdit", "Dashboard", new { id = doc.Id })"
                                                       class="btn btn-warning"
                                                       style="background-color: #ff9800; border-color: #ff9800; color: white; padding: 10px 20px; text-decoration: none; border-radius: 6px; display: inline-flex; align-items: center; gap: 8px; font-weight: 600;">
                                                        <i class="fas fa-edit"></i>
                                                        Update & Resubmit Application
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <!-- Step 3: Result (EXCLUDE Retake) -->
                                    @if (doc.Result > DateTime.MinValue && doc.Result.Year > 1 && doc.Status2 != "Retake")
                                    {
                                        <div class="timeline-item">
                                            <div class="timeline-marker @(doc.Status2 == "Approve" ? "approved" : "unapproved")">
                                                <i class="fas @(doc.Status2 == "Approve" ? "fa-check-circle" : "fa-times-circle")"></i>
                                            </div>
                                            <div class="timeline-content">
                                                <h6>Application @(doc.Status2 == "Approve" ? "Approved" : doc.Status2)</h6>
                                                <span class="timeline-date">@doc.Result.ToString("dd MMM yyyy, hh:mm tt")</span>
                                                <p class="timeline-description text-gray-700 leading-relaxed">
                                                    @if (doc.Status2 == "Approve")
                                                    {
                                                        <text>Your application has been approved. You can now claim your assistance.</text>
                                                    }
                                                    else
                                                    {
                                                        <text>Your application was not approved at this time.</text>
                                                    }
                                                </p>

                                                @if (!string.IsNullOrWhiteSpace(doc.Comments))
                                                {
                                                    <p class="timeline-description mt-2"><strong>Comments:</strong> @doc.Comments</p>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <!-- Step 2: Processing -->
                                    @if (doc.ProcessAt > DateTime.MinValue && doc.ProcessAt.Year > 1 && !string.IsNullOrWhiteSpace(doc.Processby))
                                    {
                                        <div class="timeline-item">
                                            <div class="timeline-marker processing">
                                                <i class="fas fa-user-check"></i>
                                            </div>
                                            <div class="timeline-content">
                                                <h6>Being Reviewed</h6>
                                                <span class="timeline-date">@doc.ProcessAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                                                <p class="timeline-description">Your application is being reviewed by <strong>@doc.Processby</strong></p>
                                            </div>
                                        </div>
                                    }
                                    else if (doc.Result <= DateTime.MinValue || doc.Result.Year <= 1)
                                    {
                                        <div class="timeline-item">
                                            <div class="timeline-marker waiting">
                                                <i class="fas fa-hourglass-half"></i>
                                            </div>
                                            <div class="timeline-content">
                                                <h6>Waiting for Review</h6>
                                                <p class="waiting-text">Your application is waiting to be reviewed. We will review it within 1-2 hours.</p>
                                            </div>
                                        </div>
                                    }

                                    <!-- Step 1: Document Submitted - BOTTOM -->
                                    <div class="timeline-item">
                                        <div class="timeline-marker submitted">
                                            <i class="fas fa-paper-plane"></i>
                                        </div>
                                        <div class="timeline-content">
                                            <h6>Application Submitted</h6>
                                            <span class="timeline-date">@doc.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                                            <p class="timeline-description">We have received your application for Funeral assistance.</p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="application-actions">
                                    <a class="btn-action btn-view" asp-controller="Dashboard" asp-action="FuneralAssistanceView" asp-route-id="@doc.Id">
                                        <i class="fas fa-eye"></i> View Details
                                    </a>
                                    @if (doc.Status?.ToLower() != "processing" && doc.Status?.ToLower() != "unapproved")
                                    {
                                        <a class="btn-action btn-edit" asp-controller="Dashboard" asp-action="FuneralAssistanceEdit" asp-route-id="@doc.Id">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <a class="btn-action btn-remove" asp-controller="Dashboard" asp-action="FuneralAssistanceeDelete" asp-route-id="@doc.Id">
                                            <i class="fas fa-trash-alt"></i> Remove
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-folder-open"></i>
                        <h5>No Funeral Applications</h5>
                        <p>You haven't submitted any funeral and burial assistance applications yet.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script>
        // Handle tab activation from URL parameter
        (function() {
            const urlParams = new URLSearchParams(window.location.search);
            const tabParam = urlParams.get('tab');

            if (tabParam) {
                const tabMap = {
                    'hospital': 'hospital-tab',
                    'medical': 'medical-tab',
                    'funeral': 'funeral-tab'
                };

                const tabId = tabMap[tabParam.toLowerCase()];
                if (tabId) {
                    const tabButton = document.getElementById(tabId);
                    if (tabButton) {
                        // Use Bootstrap's tab API to activate the tab
                        const tab = new bootstrap.Tab(tabButton);
                        tab.show();
                    }
                }
            }
        })();
    </script>
    <script>
        // Past Data Feature - Initialize after DOM is ready
        (function() {
            const pastDataToggle = document.getElementById('pastDataToggle');
            const pastDataSection = document.getElementById('pastDataSection');
            const dateFilterGroup = document.getElementById('dateFilterGroup');
            const applyFilter = document.getElementById('applyFilter');
            const startDate = document.getElementById('startDate');
            const endDate = document.getElementById('endDate');
            const pastDataSummary = document.getElementById('pastDataSummary');
            const pastDataTableBody = document.getElementById('pastDataTableBody');
            const dateRangeDisplay = document.getElementById('dateRangeDisplay');
            const tabContainer = document.querySelector('.tab-container');
            const tabContent = document.getElementById('trackingTabsContent');

            // Verify all required elements exist
            if (!pastDataToggle || !pastDataSection || !startDate || !endDate) {
                return;
            }

            // Set default dates (last 30 days)
            const today = new Date();
            const thirtyDaysAgo = new Date();
            thirtyDaysAgo.setDate(today.getDate() - 30);

            startDate.value = thirtyDaysAgo.toISOString().split('T')[0];
            endDate.value = today.toISOString().split('T')[0];

            // Toggle past data section
            pastDataToggle.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();

                const isActive = pastDataToggle.classList.contains('active');
                const toggleText = pastDataToggle.querySelector('span');
                const dateFilterContent = document.getElementById('dateFilterContent');

                if (!isActive) {
                    pastDataToggle.classList.add('active');
                    if (dateFilterContent) dateFilterContent.style.display = 'block';
                    if (dateFilterGroup) dateFilterGroup.style.display = 'flex';
                    pastDataSection.classList.add('active');

                    if (tabContainer) tabContainer.style.display = 'none';
                    if (tabContent) tabContent.style.display = 'none';

                    if (toggleText) toggleText.textContent = 'View Current Tracking Data';

                    loadPastData();
                } else {
                    pastDataToggle.classList.remove('active');
                    if (dateFilterContent) dateFilterContent.style.display = 'none';
                    if (dateFilterGroup) dateFilterGroup.style.display = 'none';
                    pastDataSection.classList.remove('active');

                    if (tabContainer) tabContainer.style.display = 'block';
                    if (tabContent) tabContent.style.display = 'block';

                    if (toggleText) toggleText.textContent = 'View Past Tracking Data';
                }
            });

            // Auto-expand Past Data section if URL contains #past-data anchor (from notifications)
            function checkAndExpandPastData() {
                if (window.location.hash === '#past-data') {
                    if (!pastDataToggle.classList.contains('active')) {
                        const toggleText = pastDataToggle.querySelector('span');
                        const dateFilterContent = document.getElementById('dateFilterContent');

                        pastDataToggle.classList.add('active');
                        if (dateFilterContent) dateFilterContent.style.display = 'block';
                        if (dateFilterGroup) dateFilterGroup.style.display = 'flex';
                        pastDataSection.classList.add('active');

                        if (tabContainer) tabContainer.style.display = 'none';
                        if (tabContent) tabContent.style.display = 'none';

                        if (toggleText) toggleText.textContent = 'View Current Tracking Data';

                        loadPastData();

                        setTimeout(() => {
                            pastDataSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        }, 300);

                        history.replaceState(null, null, ' ');
                    }
                }
            }

            // Check on page load
            checkAndExpandPastData();

            window.addEventListener('hashchange', checkAndExpandPastData);

            // Load past data
            function loadPastData() {
                const start = new Date(startDate.value);
                const end = new Date(endDate.value);
                end.setHours(23, 59, 59, 999);

                if (dateRangeDisplay) {
                    dateRangeDisplay.textContent = `Showing applications from ${formatDate(start)} to ${formatDate(end)}`;
                }

                const allApplications = collectAllApplications();

                const filteredApplications = allApplications.filter(app => {
                    const appDate = new Date(app.submittedDate);
                    return appDate >= start && appDate <= end;
                });

                updateSummary(filteredApplications);
                updateTable(filteredApplications);
            }

            // Collect all applications from the current page
            function collectAllApplications() {
                const applications = [];

                // Add archived applications
                if (window.archivedApplications && window.archivedApplications.length > 0) {
                    window.archivedApplications.forEach(app => {
                        applications.push({
                            type: app.type,
                            name: app.name,
                            status: app.status,
                            claimStatus: app.claimStatus,
                            submittedDate: new Date(app.submittedDate),
                            processedDate: app.processedDate ? new Date(app.processedDate) : null,
                            resultDate: app.resultDate ? new Date(app.resultDate) : null,
                            claimedDate: app.claimedDate ? new Date(app.claimedDate) : null,
                            id: app.id
                        });
                    });
                }

                // Helper function to detect status for each card
                function detectStatus(card) {
                    // Check for claimed status first
                    const claimMarker = card.querySelector('.timeline-item:first-child .timeline-marker.claimed');
                    if (claimMarker) {
                        return 'Claimed';
                    }

                    // Check for approved status
                    const approvedMarker = card.querySelector('.timeline-item:nth-child(1) .timeline-marker.approved, .timeline-item:nth-child(2) .timeline-marker.approved');
                    if (approvedMarker) {
                        return 'Approve';
                    }

                    // Check for unapproved status
                    const unapprovedMarker = card.querySelector('.timeline-item:nth-child(1) .timeline-marker.unapproved, .timeline-item:nth-child(2) .timeline-marker.unapproved');
                    if (unapprovedMarker) {
                        return 'Unapproved';
                    }

                    // Check for retake status
                    const retakeMarker = card.querySelector('.timeline-marker.retake');
                    if (retakeMarker) {
                        return 'Retake';
                    }

                    // Check if processing has started
                    const processingMarker = card.querySelector('.timeline-marker.processing');
                    if (processingMarker) {
                        return 'Processing';
                    }

                    // Default to pending
                    return 'Pending';
                }

                // Helper function to detect claim status
                function detectClaimStatus(card) {
                    const claimMarker = card.querySelector('.timeline-item:first-child .timeline-marker.claimed');
                    return claimMarker ? 'Claimed' : null;
                }

                // Helper function to extract claimed date
                function extractClaimedDate(card) {
                    const claimDateElement = card.querySelector('.timeline-item:first-child .timeline-date');
                    return claimDateElement ? parseDateFromText(claimDateElement.textContent) : null;
                }

                // Helper function to extract processing date
                function extractProcessingDate(card) {
                    const processingDateElement = card.querySelector('.timeline-marker.processing').closest('.timeline-item').querySelector('.timeline-date');
                    return processingDateElement ? parseDateFromText(processingDateElement.textContent) : null;
                }

                // Helper function to extract result date
                function extractResultDate(card) {
                    const resultMarker = card.querySelector('.timeline-marker.approved, .timeline-marker.unapproved, .timeline-marker.retake');
                    if (resultMarker) {
                        const resultDateElement = resultMarker.closest('.timeline-item').querySelector('.timeline-date');
                        return resultDateElement ? parseDateFromText(resultDateElement.textContent) : null;
                    }
                    return null;
                }

                // Helper function to parse date from text
                function parseDateFromText(text) {
                    try {
                        return new Date(text);
                    } catch {
                        return null;
                    }
                }

                // Helper function to get application type from icon
                function getApplicationType(header) {
                    if (header.innerHTML.includes('fa-hospital')) return 'Hospital';
                    if (header.innerHTML.includes('fa-microscope')) return 'Medical Procedure';
                    if (header.innerHTML.includes('fa-monument')) return 'Funeral Assistance';
                    return 'Application';
                }

                // Collect applications from each tab
                ['#hospital', '#medical', '#funeral'].forEach(tabSelector => {
                    document.querySelectorAll(`${tabSelector} .tracking-card`).forEach(card => {
                        const header = card.querySelector('.tracking-header h5');
                        const dateText = card.querySelector('.tracking-date').textContent;
                        const appType = getApplicationType(header);

                        applications.push({
                            type: appType,
                            name: header.textContent.replace('Hospital', '').replace('Microscope', '').replace('Monument', '').trim(),
                            status: detectStatus(card),
                            claimStatus: detectClaimStatus(card),
                            submittedDate: extractDate(dateText),
                            processedDate: extractProcessingDate(card),
                            resultDate: extractResultDate(card),
                            claimedDate: extractClaimedDate(card),
                            id: extractId(card)
                        });
                    });
                });

                return applications;
            }

            // Helper functions to extract data from cards
            function extractDate(dateText) {
                const match = dateText.match(/Submitted: (.*)/);
                return match ? new Date(match[1]) : new Date();
            }

            function extractId(card) {
                const viewLink = card.querySelector('.btn-view');
                if (viewLink) {
                    const href = viewLink.getAttribute('href');
                    const match = href.match(/\/\d+$/);
                    return match ? match[0].substring(1) : null;
                }
                return null;
            }

            // Update summary cards
            function updateSummary(applications) {
                const total = applications.length;
                const approved = applications.filter(app => app.status === 'Approve').length;
                const pending = applications.filter(app => app.status === 'Pending').length;
                const processing = applications.filter(app => app.status === 'Processing').length;
                const unapproved = applications.filter(app => app.status === 'Unapproved').length;
                const claimed = applications.filter(app => app.status === 'Claimed').length;

                if (pastDataSummary) {
                    pastDataSummary.innerHTML = `
                        <div class="summary-card">
                            <h5>Total Applications</h5>
                            <div class="count">${total}</div>
                        </div>
                        <div class="summary-card">
                            <h5>Approved</h5>
                            <div class="count" style="color: var(--success-color);">${approved}</div>
                        </div>
                        <div class="summary-card">
                            <h5>Pending</h5>
                            <div class="count" style="color: var(--warning-color);">${pending}</div>
                        </div>
                        <div class="summary-card">
                            <h5>Processing</h5>
                            <div class="count" style="color: var(--primary-color);">${processing}</div>
                        </div>
                        <div class="summary-card">
                            <h5>Unapproved</h5>
                            <div class="count" style="color: var(--danger-color);">${unapproved}</div>
                        </div>
                        <div class="summary-card">
                            <h5>Claimed</h5>
                            <div class="count" style="color: var(--claimed-color);">${claimed}</div>
                        </div>
                    `;
                }
            }

            // Update table with applications
        // Update table with applications
        function updateTable(applications) {
            if (!pastDataTableBody) return;

            pastDataTableBody.innerHTML = '';

            if (applications.length === 0) {
                pastDataTableBody.innerHTML = `
                    <tr>
                        <td colspan="8" style="text-align: center; padding: 2rem;">
                            <i class="fas fa-folder-open" style="font-size: 2rem; color: var(--secondary-color); margin-bottom: 1rem; display: block;"></i>
                            <p style="color: var(--secondary-color); margin: 0;">No applications found in the selected date range.</p>
                        </td>
                    </tr>
                `;
                return;
            }

            applications.forEach(app => {
                const row = document.createElement('tr');

                // Determine status badge class
                let statusClass = 'status-pending';
                let statusDisplay = app.status;

                if (app.status === 'Retake') {
                    statusClass = 'status-retake';
                    statusDisplay = 'Retake';
                } else if (app.status === 'Approve') {
                    statusClass = 'status-approved';
                    statusDisplay = 'Approved';
                } else if (app.status === 'Processing') {
                    statusClass = 'status-processing';
                    statusDisplay = 'Processing';
                } else if (app.status === 'Unapproved' || app.status === 'Disapprove') {
                    statusClass = 'status-unapproved';
                    statusDisplay = 'Disapproved';
                } else if (app.status === 'Claimed') {
                    statusClass = 'status-claimed';
                    statusDisplay = 'Claimed';
                } else {
                    statusDisplay = 'Pending';
                }

                // Determine the correct view URL based on application type
                let viewUrl = '';
                if (app.id) {
                    if (app.type.includes('Hospital') || app.type === 'Hospital Assistance') {
                        viewUrl = `/HospitalAssistanceview/${app.id}`;
                    } else if (app.type.includes('Medical') || app.type === 'Medical Procedure') {
                        viewUrl = `/OtherAssistanceView/${app.id}`;
                    } else if (app.type.includes('Funeral') || app.type === 'Funeral Assistance') {
                        viewUrl = `/FuneralAssistanceView/${app.id}`;
                    }
                }

                row.innerHTML = `
                    <td>${app.type}</td>
                    <td>${app.name}</td>
                    <td><span class="status-badge ${statusClass}">${statusDisplay}</span></td>
                    <td>${formatDate(new Date(app.submittedDate))}</td>
                    <td>${app.processedDate ? formatDate(app.processedDate) : '-'}</td>
                    <td>${app.resultDate ? formatDate(app.resultDate) : '-'}</td>
                    <td>${app.claimedDate ? formatDate(app.claimedDate) : '-'}</td>
                    <td>
                        ${viewUrl ? `<a href="${viewUrl}" class="btn-action btn-view" style="padding: 0.25rem 0.5rem; font-size: 0.7rem;">
                            <i class="fas fa-eye"></i> View
                        </a>` : ''}
                    </td>
                `;

                pastDataTableBody.appendChild(row);
            });
        }
            // Format date for display
            function formatDate(date) {
                return date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric'
                });
            }

            // Show toast notification
            function showToastNotification(title, message) {
                let toast = document.getElementById('processingToast');
                if (!toast) {
                    toast = document.createElement('div');
                    toast.id = 'processingToast';
                    toast.className = 'toast-notification';
                    toast.innerHTML = `
                        <div class="toast-header">
                            <i class="fas fa-bell text-primary"></i>
                            <h6 class="toast-title">${title}</h6>
                        </div>
                        <p class="toast-message">${message}</p>
                    `;
                    document.body.appendChild(toast);
                } else {
                    toast.querySelector('.toast-title').textContent = title;
                    toast.querySelector('.toast-message').textContent = message;
                }

                toast.classList.add('show');

                setTimeout(() => {
                    toast.classList.remove('show');
                }, 5000);
            }

            // Event listeners
            if (applyFilter) {
                applyFilter.addEventListener('click', loadPastData);
            }

            // Load initial data if past data section is active on page load
            if (pastDataToggle && pastDataToggle.classList.contains('active')) {
                loadPastData();
            }
        })();
    </script>

    <!-- Go Back Button Script -->
    <script src="~/js/go-back-button.js"></script>

    <!-- Session Timeout -->
    @await Html.PartialAsync("_SessionTimeout")

    <script>
        // Set user applications for tracking
        window.userApplications = [
            @foreach (var f in Model.HospitalAssistance)
            {
                    <text>
                    {
                        formId: @f.Id,
                        type: "Hospital Assistance",
                        status: "@f.Status?.ToLower()",
                        createdAt: "@f.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss")",
                        userId: '@ViewBag.UserId'
                    },
                    </text>
            }
            @foreach (var f in Model.OtherAssistance)
            {
                    <text>
                    {
                        formId: @f.Id,
                        type: "Medical and Laboratory Procedure",
                        status: "@f.Status?.ToLower()",
                        createdAt: "@f.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss")",
                        userId: '@ViewBag.UserId'
                    },
                    </text>
            }
            @foreach (var f in Model.FuneralAssistance)
            {
                    <text>
                    {
                        formId: @f.Id,
                        type: "Funeral and Burial Assistance",
                        status: "@f.Status?.ToLower()",
                        createdAt: "@f.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss")",
                        userId: '@ViewBag.UserId'
                    },
                    </text>
            }
        ];

        // Archived applications data (older than 1 month)
        window.archivedApplications = [
            @foreach (var f in Model.ArchivedHospitalAssistance)
            {
                    <text>
                    {
                        id: @f.Id,
                        type: "Hospital Assistance",
                        name: "@f.Firstname @f.Middlename @f.Lastname",
                        status: "@(string.IsNullOrEmpty(f.Status2) ? "Pending" : f.Status2)",
                        claimStatus: "@(string.IsNullOrEmpty(f.Status3) ? "" : f.Status3)",
                        submittedDate: "@f.CreatedAt.ToString("yyyy-MM-dd")",
                        processedDate: "@(f.ProcessAt != DateTime.MinValue ? f.ProcessAt.ToString("yyyy-MM-dd") : "")",
                        resultDate: "@(f.Result != DateTime.MinValue ? f.Result.ToString("yyyy-MM-dd") : "")",
                        claimedDate: "@(f.ClaimedAt != DateTime.MinValue ? f.ClaimedAt.ToString("yyyy-MM-dd") : "")"
                    },
                    </text>
            }
            @foreach (var f in Model.ArchivedOtherAssistance)
            {
                    <text>
                    {
                        id: @f.Id,
                        type: "Medical Procedure",
                        name: "@f.Firstname @f.Middlename @f.Lastname",
                        status: "@(string.IsNullOrEmpty(f.Status2) ? "Pending" : f.Status2)",
                        claimStatus: "@(string.IsNullOrEmpty(f.Status3) ? "" : f.Status3)",
                        submittedDate: "@f.CreatedAt.ToString("yyyy-MM-dd")",
                        processedDate: "@(f.ProcessAt != DateTime.MinValue ? f.ProcessAt.ToString("yyyy-MM-dd") : "")",
                        resultDate: "@(f.Result != DateTime.MinValue ? f.Result.ToString("yyyy-MM-dd") : "")",
                        claimedDate: "@(f.ClaimedAt != DateTime.MinValue ? f.ClaimedAt.ToString("yyyy-MM-dd") : "")"
                    },
                    </text>
            }
            @foreach (var f in Model.ArchivedFuneralAssistance)
            {
                    <text>
                    {
                        id: @f.Id,
                        type: "Funeral Assistance",
                        name: "@f.Firstname @f.Middlename @f.Lastname",
                        status: "@(string.IsNullOrEmpty(f.Status2) ? "Pending" : f.Status2)",
                        claimStatus: "@(string.IsNullOrEmpty(f.Status3) ? "" : f.Status3)",
                        submittedDate: "@f.CreatedAt.ToString("yyyy-MM-dd")",
                        processedDate: "@(f.ProcessAt != DateTime.MinValue ? f.ProcessAt.ToString("yyyy-MM-dd") : "")",
                        resultDate: "@(f.Result != DateTime.MinValue ? f.Result.ToString("yyyy-MM-dd") : "")",
                        claimedDate: "@(f.ClaimedAt != DateTime.MinValue ? f.ClaimedAt.ToString("yyyy-MM-dd") : "")"
                    },
                    </text>
            }
        ];
    </script>
</body>
</html>