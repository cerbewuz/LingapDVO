<body>
    <a href="/Home" class="go-back-top go-back-btn" id="goBackBtn" data-url="/Home">
        <i class="fas fa-arrow-left"></i> Back
    </a>

    <!-- Application Tracking Header Hero Section -->
    <div class="tracking-hero" style="background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%); color: white; padding: 2rem 0 1.5rem; box-shadow: 0 2px 15px rgba(0,0,0,0.1);">
        <div class="container">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <h1 style="font-size: 1.75rem; font-weight: 700; margin: 0; text-shadow: 0 2px 8px rgba(0,0,0,0.2);">
                            Application Tracking
                        </h1>
                    </div>
                    <p style="font-size: 0.95rem; opacity: 0.9; margin: 0;">
                        Monitor the status of all your assistance applications
                    </p>
                </div>
                <div class="d-flex gap-4 flex-wrap">
                    <div class="text-center" style="min-width: 90px;">
                        <div style="font-size: 1.75rem; font-weight: 700; line-height: 1;">@(Model.HospitalAssistance.Count + Model.OtherAssistance.Count + Model.FuneralAssistance.Count)</div>
                        <div style="font-size: 0.8rem; opacity: 0.85; margin-top: 0.25rem;">Total</div>
                    </div>
                    <div class="text-center" style="min-width: 90px;">
                        <div style="font-size: 1.75rem; font-weight: 700; line-height: 1;">
                            @(Model.HospitalAssistance.Count(a => a.Status2 == "Approve") + Model.OtherAssistance.Count(a => a.Status2 == "Approve") + Model.FuneralAssistance.Count(a => a.Status2 == "Approve"))
                        </div>
                        <div style="font-size: 0.8rem; opacity: 0.85; margin-top: 0.25rem;">Approved</div>
                    </div>
                    <div class="text-center" style="min-width: 90px;">
                        <div style="font-size: 1.75rem; font-weight: 700; line-height: 1;">
                            @(Model.HospitalAssistance.Count(a => string.IsNullOrEmpty(a.Status2) || a.Status2.ToLower() == "pending") +
                                                        Model.OtherAssistance.Count(a => string.IsNullOrEmpty(a.Status2) || a.Status2.ToLower() == "pending") +
                                                        Model.FuneralAssistance.Count(a => string.IsNullOrEmpty(a.Status2) || a.Status2.ToLower() == "pending"))
                        </div>
                        <div style="font-size: 0.8rem; opacity: 0.85; margin-top: 0.25rem;">Pending</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container" style="margin-top: 2rem; max-width: 1200px;">

        <!-- Past Data Toggle -->
        <div class="filter-container">
            <div class="filter-group">
                <div class="past-data-toggle" id="pastDataToggle">
                    <i class="fas fa-history"></i>
                    <span>View Past Tracking Data</span>
                </div>
            </div>
            <div class="date-filter-content" id="dateFilterContent" style="display: none;">
                <div class="filter-group" id="dateFilterGroup">
                    <span class="filter-label">Date Range:</span>
                    <div class="date-range">
                        <input type="date" class="date-input" id="startDate">
                        <span>to</span>
                        <input type="date" class="date-input" id="endDate">
                    </div>
                    <button class="filter-btn" id="applyFilter">
                        <i class="fas fa-filter"></i> Apply Filter
                    </button>
                </div>
            </div>
        </div>

        <!-- Past Data Section -->
        <div class="past-data-section" id="pastDataSection">
            <div class="past-data-header">
                <h4>Past Application Data</h4>
                <div id="dateRangeDisplay">Showing all applications</div>
            </div>

            <div class="past-data-summary" id="pastDataSummary">
                <!-- Summary cards will be populated by JavaScript -->
            </div>

            <div class="past-data-table">
                <table class="table" id="pastDataTable">
                    <thead>
                        <tr>
                            <th>Application Type</th>
                            <th>Applicant Name</th>
                            <th>Status</th>
                            <th>Submitted Date</th>
                            <th>Processed Date</th>
                            <th>Result Date</th>
                            <th>Claimed Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="pastDataTableBody">
                        <!-- Table rows will be populated by JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Current Tracking Data -->
        <div class="tab-container">
            <ul class="nav nav-tabs" id="trackingTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="hospital-tab" data-bs-toggle="tab" data-bs-target="#hospital" type="button">
                        <i class="fas fa-hospital me-1"></i>Hospitals
                        <span class="badge bg-primary ms-1">@Model.HospitalAssistance.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="medical-tab" data-bs-toggle="tab" data-bs-target="#medical" type="button">
                        <i class="fas fa-microscope me-1"></i>Other
                        <span class="badge bg-primary ms-1">@Model.OtherAssistance.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="funeral-tab" data-bs-toggle="tab" data-bs-target="#funeral" type="button">
                        <i class="fas fa-monument me-1"></i>Funeral
                        <span class="badge bg-primary ms-1">@Model.FuneralAssistance.Count</span>
                    </button>
                </li>
            </ul>
        </div>

        <div class="tab-content" id="trackingTabsContent">
            <!-- Hospitals Tab -->
            <div class="tab-pane fade show active" id="hospital" role="tabpanel">
                @{
                    var hospitalBills = Model.HospitalAssistance.OrderByDescending(f => f.CreatedAt).ToList();
                }
                @if (hospitalBills.Any())
                {
                    @foreach (var doc in hospitalBills)
                    {
                        <div class="tracking-card">
                            <div class="tracking-header">
                                <h5><i class="fas fa-hospital"></i>@doc.Lastname, @doc.Firstname @doc.Middlename</h5>
                                <div class="tracking-date">
                                    <i class="fas fa-calendar me-1"></i>Submitted: @doc.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                                </div>
                            </div>
                            <div class="tracking-body">
                                <div class="timeline">
                                    <!-- REVERSED ORDER: Latest updates at the top -->
                                    <!-- Step 4: Claim Status (Only show if approved) - TOP -->
                                    @if (doc.Status2 == "Approve")
                                    {
                                        @if (doc.ClaimedAt > DateTime.MinValue && doc.ClaimedAt.Year > 1 && !string.IsNullOrWhiteSpace(doc.Status3))
                                        {
                                            <div class="timeline-item">
                                                <div class="timeline-marker claimed">
                                                    <i class="fas fa-hands-helping"></i>
                                                </div>
                                                <div class="timeline-content">
                                                    <h6>Assistance Released</h6>
                                                    <span class="timeline-date">@doc.ClaimedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                                                    <p class="timeline-description">
                                                        Your assistance has been released and completed.
                                                    </p>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="timeline-item">
                                                <div class="timeline-marker waiting">
                                                    <i class="fas fa-gift"></i>
                                                </div>
                                                <div class="timeline-content">
                                                    <h6>Ready for Release</h6>
                                                    <p class="waiting-text">Your assistance is ready. Please visit our office to collect it.</p>
                                                </div>
                                            </div>
                                        }
                                    }

                                    <!-- Step 3.9: Result if NOT approve and NOT retake -->
                                    @if (doc.Result > DateTime.MinValue && doc.Result.Year > 1 && doc.Status2 != "Approve" && doc.Status2 != "Retake")
                                    {
                                        <div class="timeline-item">
                                            <div class="timeline-marker unapproved">
                                                <i class="fas fa-times-circle"></i>
                                            </div>
                                            <div class="timeline-content">
                                                <h6>Decision Made</h6>
                                                <span class="timeline-date">@doc.Result.ToString("dd MMM yyyy, hh:mm tt")</span>
                                                <p class="timeline-description">We have made a decision on your application.</p>
                                                @if (!string.IsNullOrWhiteSpace(doc.Comments))
                                                {
                                                    <p class="timeline-description mt-2"><strong>Comments:</strong> @doc.Comments</p>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <!-- Step 3.5: Retake Request (Show if Status2 is "Retake") -->
                                    @if (doc.Status2 == "Retake")
                                    {
                                        <div class="timeline-item">
                                            <div class="timeline-marker retake">
                                                <i class="fas fa-arrow-rotate-left"></i>
                                            </div>
                                            <div class="timeline-content">
                                                <h6>📝 Action Required - Retake Application</h6>
                                                <span class="timeline-date">@doc.Result.ToString("dd MMM yyyy, hh:mm tt")</span>
                                                <p class="timeline-description">
                                                    We need additional documents or corrections for your application. Please review the comments below and resubmit your application with the required updates.
                                                </p>
                                                @if (!string.IsNullOrWhiteSpace(doc.RetakeReason))
                                                {
                                                    <div style="background-color: #fff3cd; border-left: 4px solid #ff9800; padding: 12px; border-radius: 6px; margin-top: 12px;">
                                                        <p class="mb-2" style="font-weight: 600; color: #9a3412;"><i class="fas fa-info-circle me-1"></i> What needs to be updated:</p>
                                                        <p class="mb-0" style="color: #666;">@doc.RetakeReason</p>
                                                    </div>
                                                }
                                                <div style="margin-top: 16px;">
                                                    <a href="@Url.Action("HospitalAssistanceEdit", "Dashboard", new { id = doc.Id })"
                                                       class="btn btn-warning"
                                                       style="background-color: #ff9800; border-color: #ff9800; color: white; padding: 10px 20px; text-decoration: none; border-radius: 6px; display: inline-flex; align-items: center; gap: 8px; font-weight: 600;">
                                                        <i class="fas fa-edit"></i>
                                                        Update & Resubmit Application
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <!-- Step 3: Result (EXCLUDE Retake) -->
                                    @if (doc.Result > DateTime.MinValue && doc.Result.Year > 1 && doc.Status2 != "Retake")
                                    {
                                        <div class="timeline-item">
                                            <div class="timeline-marker @(doc.Status2 == "Approve" ? "approved" : "unapproved")">
                                                <i class="fas @(doc.Status2 == "Approve" ? "fa-check-circle" : "fa-times-circle")"></i>
                                            </div>
                                            <div class="timeline-content">
                                                <h6>Application @(doc.Status2 == "Approve" ? "Approved" : doc.Status2)</h6>
                                                <span class="timeline-date">@doc.Result.ToString("dd MMM yyyy, hh:mm tt")</span>
                                                <p class="timeline-description text-gray-700 leading-relaxed">
                                                    @if (doc.Status2 == "Approve")
                                                    {
                                                        <text>Your application has been approved. You can now claim your assistance.</text>
                                                    }
                                                    else
                                                    {
                                                        <text>Your application was not approved at this time.</text>
                                                    }
                                                </p>

                                                @if (!string.IsNullOrWhiteSpace(doc.Comments))
                                                {
                                                    <p class="timeline-description mt-2"><strong>Comments:</strong> @doc.Comments</p>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <!-- Step 2: Processing -->
                                    @if (doc.ProcessAt > DateTime.MinValue && doc.ProcessAt.Year > 1 && !string.IsNullOrWhiteSpace(doc.Processby))
                                    {
                                        <div class="timeline-item">
                                            <div class="timeline-marker processing">
                                                <i class="fas fa-user-check"></i>
                                            </div>
                                            <div class="timeline-content">
                                                <h6>Being Reviewed</h6>
                                                <span class="timeline-date">@doc.ProcessAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                                                <p class="timeline-description">Your application is being reviewed by <strong>@doc.Processby</strong></p>
                                            </div>
                                        </div>
                                    }
                                    else if (doc.Result <= DateTime.MinValue || doc.Result.Year <= 1)
                                    {
                                        <div class="timeline-item">
                                            <div class="timeline-marker waiting">
                                                <i class="fas fa-hourglass-half"></i>
                                            </div>
                                            <div class="timeline-content">
                                                <h6>Waiting for Review</h6>
                                                <p class="waiting-text">Your application is waiting to be reviewed. We will review it within 1-2 hours.</p>
                                            </div>
                                        </div>
                                    }

                                    <!-- Step 1: Document Submitted - BOTTOM -->
                                    <div class="timeline-item">
                                        <div class="timeline-marker submitted">
                                            <i class="fas fa-paper-plane"></i>
                                        </div>
                                        <div class="timeline-content">
                                            <h6>Application Submitted</h6>
                                            <span class="timeline-date">@doc.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                                            <p class="timeline-description">We have received your application for Hospital assistance.</p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="application-actions">
                                    <a class="btn-action btn-view" asp-controller="Dashboard" asp-action="HospitalAssistanceView" asp-route-id="@doc.Id">
                                        <i class="fas fa-eye"></i> View Details
                                    </a>
                                    @if (doc.Status?.ToLower() != "processing" && doc.Status?.ToLower() != "unapproved")
                                    {
                                        <a class="btn-action btn-edit" asp-controller="Dashboard" asp-action="HospitalAssistanceEdit" asp-route-id="@doc.Id">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <a class="btn-action btn-remove" asp-controller="Dashboard" asp-action="HospitalAssistanceDelete" asp-route-id="@doc.Id">
                                            <i class="fas fa-trash-alt"></i> Remove
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-folder-open"></i>
                        <h5>No Hospital Applications</h5>
                        <p>You haven't submitted any hospital bill assistance applications yet.</p>
                    </div>
                }
            </div>

            <!-- Other Tab -->
            <div class="tab-pane fade" id="medical" role="tabpanel">
