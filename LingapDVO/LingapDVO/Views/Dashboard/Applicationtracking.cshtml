    <script>
        // Handle tab activation from URL parameter
        (function() {
            const urlParams = new URLSearchParams(window.location.search);
            const tabParam = urlParams.get('tab');

            if (tabParam) {
                const tabMap = {
                    'hospital': 'hospital-tab',
                    'medical': 'medical-tab',
                    'funeral': 'funeral-tab'
                };

                const tabId = tabMap[tabParam.toLowerCase()];
                if (tabId) {
                    const tabButton = document.getElementById(tabId);
                    if (tabButton) {
                        // Use Bootstrap's tab API to activate the tab
                        const tab = new bootstrap.Tab(tabButton);
                        tab.show();
                    }
                }
            }
        })();
    </script>
    <script>
        // Past Data Feature - Enhanced with server-side rendering
        (function() {
            const pastDataToggle = document.getElementById('pastDataToggle');
            const pastDataSection = document.getElementById('pastDataSection');
            const dateFilterGroup = document.getElementById('dateFilterGroup');
            const applyFilter = document.getElementById('applyFilter');
            const clearFilter = document.getElementById('clearFilter');
            const startDate = document.getElementById('startDate');
            const endDate = document.getElementById('endDate');
            const filterType = document.getElementById('filterType');
            const filterStatus = document.getElementById('filterStatus');
            const dateRangeDisplay = document.getElementById('dateRangeDisplay');
            const tabContainer = document.querySelector('.tab-container');
            const tabContent = document.getElementById('trackingTabsContent');
            const pastDataTableBody = document.getElementById('pastDataTableBody');

            // Pagination elements
            const prevPage = document.getElementById('prevPage');
            const nextPage = document.getElementById('nextPage');
            const pageInfo = document.getElementById('pageInfo');
            const rowsPerPage = document.getElementById('rowsPerPage');

            // Pagination state
            let currentPage = 1;
            let itemsPerPage = 10;

            // Verify required elements exist
            if (!pastDataToggle || !pastDataSection) {
                return;
            }

            // Set default dates
            const today = new Date();
            const oneYearAgo = new Date();
            oneYearAgo.setFullYear(today.getFullYear() - 1);

            if (startDate) startDate.value = oneYearAgo.toISOString().split('T')[0];
            if (endDate) endDate.value = today.toISOString().split('T')[0];

            // Toggle past data section
            pastDataToggle.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();

                const isActive = pastDataToggle.classList.contains('active');
                const toggleText = pastDataToggle.querySelector('span');
                const dateFilterContent = document.getElementById('dateFilterContent');

                if (!isActive) {
                    pastDataToggle.classList.add('active');
                    if (dateFilterContent) dateFilterContent.style.display = 'block';
                    if (dateFilterGroup) dateFilterGroup.style.display = 'flex';
                    pastDataSection.classList.add('active');

                    if (tabContainer) tabContainer.style.display = 'none';
                    if (tabContent) tabContent.style.display = 'none';

                    if (toggleText) toggleText.textContent = 'View Current Applications';

                    applyFilters();
                } else {
                    pastDataToggle.classList.remove('active');
                    if (dateFilterContent) dateFilterContent.style.display = 'none';
                    if (dateFilterGroup) dateFilterGroup.style.display = 'none';
                    pastDataSection.classList.remove('active');

                    if (tabContainer) tabContainer.style.display = 'block';
                    if (tabContent) tabContent.style.display = 'block';

                    if (toggleText) toggleText.textContent = 'View Applications History';
                }
            });

            // Auto-expand Past Data section if URL contains #past-data anchor
            function checkAndExpandPastData() {
                if (window.location.hash === '#past-data') {
                    if (!pastDataToggle.classList.contains('active')) {
                        pastDataToggle.click();
                        setTimeout(() => {
                            pastDataSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        }, 300);
                        history.replaceState(null, null, ' ');
                    }
                }
            }

            checkAndExpandPastData();
            window.addEventListener('hashchange', checkAndExpandPastData);

            // Apply filters function
            function applyFilters() {
                const rows = pastDataTableBody.querySelectorAll('.data-row');
                const noDataRow = pastDataTableBody.querySelector('.no-data-row');
                
                const typeFilter = filterType ? filterType.value.toLowerCase() : 'all';
                const statusFilter = filterStatus ? filterStatus.value.toLowerCase() : 'all';
                const startDateVal = startDate ? new Date(startDate.value) : null;
                const endDateVal = endDate ? new Date(endDate.value) : null;
                
                if (endDateVal) {
                    endDateVal.setHours(23, 59, 59, 999);
                }

                let visibleCount = 0;
                let matchingRows = [];

                rows.forEach(row => {
                    const rowType = row.dataset.type;
                    const rowStatus = row.dataset.status;
                    const rowClaimed = row.dataset.claimed === 'true';
                    const rowDate = new Date(row.dataset.date);

                    let showRow = true;

                    // Type filter
                    if (typeFilter !== 'all') {
                        if (typeFilter === 'hospital' && rowType !== 'hospital') showRow = false;
                        if (typeFilter === 'medical' && rowType !== 'medical') showRow = false;
                        if (typeFilter === 'funeral' && rowType !== 'funeral') showRow = false;
                    }

                    // Status filter
                    if (statusFilter !== 'all' && showRow) {
                        if (statusFilter === 'claimed') {
                            if (!rowClaimed) showRow = false;
                        } else if (statusFilter === 'approve' || statusFilter === 'approved') {
                            if (rowStatus !== 'approve' && rowStatus !== 'approved') showRow = false;
                        } else if (statusFilter === 'unapproved') {
                            if (rowStatus !== 'unapproved' && rowStatus !== 'disapprove') showRow = false;
                        } else {
                            if (rowStatus !== statusFilter) showRow = false;
                        }
                    }

                    // Date filter
                    if (showRow && startDateVal && endDateVal) {
                        if (rowDate < startDateVal || rowDate > endDateVal) {
                            showRow = false;
                        }
                    }

                    if (showRow) {
                        matchingRows.push(row);
                        visibleCount++;
                    }
                    
                    row.classList.add('hidden');
                });

                // Apply pagination
                const totalPages = Math.ceil(matchingRows.length / itemsPerPage);
                if (currentPage > totalPages) currentPage = 1;
                
                const startIndex = (currentPage - 1) * itemsPerPage;
                const endIndex = startIndex + itemsPerPage;

                matchingRows.forEach((row, index) => {
                    if (index >= startIndex && index < endIndex) {
                        row.classList.remove('hidden');
                    }
                });

                // Update pagination info
                if (pageInfo) {
                    pageInfo.textContent = `Page ${currentPage} of ${totalPages || 1}`;
                }
                if (prevPage) {
                    prevPage.disabled = currentPage <= 1;
                }
                if (nextPage) {
                    nextPage.disabled = currentPage >= totalPages;
                }

                // Update display text
                if (dateRangeDisplay) {
                    let displayText = `Showing ${visibleCount} application${visibleCount !== 1 ? 's' : ''}`;
                    if (startDateVal && endDateVal) {
                        displayText += ` from ${formatDate(startDateVal)} to ${formatDate(endDateVal)}`;
                    }
                    dateRangeDisplay.textContent = displayText;
                }

                // Show no data message if no results
                if (visibleCount === 0) {
                    // Remove any existing no-results row first
                    const existingNoResults = pastDataTableBody.querySelector('.no-results-row');
                    if (existingNoResults) {
                        existingNoResults.remove();
                    }
                    
                    const emptyRow = document.createElement('tr');
                    emptyRow.className = 'no-results-row';
                    emptyRow.innerHTML = `
                        <td colspan="8" style="text-align: center; padding: 2rem;">
                            <i class="fas fa-search" style="font-size: 2rem; color: var(--secondary-color); margin-bottom: 1rem; display: block;"></i>
                            <p style="color: var(--secondary-color); margin: 0;">No applications match your filter criteria.</p>
                        </td>
                    `;
                    pastDataTableBody.appendChild(emptyRow);
                } else {
                    const existingNoResults = pastDataTableBody.querySelector('.no-results-row');
                    if (existingNoResults) {
                        existingNoResults.remove();
                    }
                }

                updateSummaryCards(matchingRows);
            }

            // Update summary cards based on filtered data
            function updateSummaryCards(matchingRows) {
                const summaryContainer = document.getElementById('pastDataSummary');
                if (!summaryContainer) return;

                let total = matchingRows.length;
                let approved = 0, pending = 0, processing = 0, unapproved = 0, retake = 0, claimed = 0;

                matchingRows.forEach(row => {
                    const status = row.dataset.status;
                    const isClaimed = row.dataset.claimed === 'true';

                    if (isClaimed) claimed++;
                    if (status === 'approve' || status === 'approved') approved++;
                    else if (status === 'pending') pending++;
                    else if (status === 'processing') processing++;
                    else if (status === 'unapproved' || status === 'disapprove') unapproved++;
                    else if (status === 'retake') retake++;
                });

                summaryContainer.innerHTML = `
                    <div class="summary-card">
                        <h5>Total Applications</h5>
                        <div class="count">${total}</div>
                    </div>
                    <div class="summary-card">
                        <h5>Approve</h5>
                        <div class="count" style="color: var(--success-color);">${approved}</div>
                    </div>
                    <div class="summary-card">
                        <h5>Pending</h5>
                        <div class="count" style="color: var(--warning-color);">${pending}</div>
                    </div>
                    <div class="summary-card">
                        <h5>Processing</h5>
                        <div class="count" style="color: var(--primary-color);">${processing}</div>
                    </div>
                    <div class="summary-card">
                        <h5>Unapprove</h5>
                        <div class="count" style="color: var(--danger-color);">${unapproved}</div>
                    </div>
                    <div class="summary-card">
                        <h5>Claims</h5>
                        <div class="count" style="color: var(--claimed-color);">${claimed}</div>
                    </div>
                `;
            }

            // Format date for display
            function formatDate(date) {
                return date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric'
                });
            }

            // Clear filters
            function clearFilters() {
                if (filterType) filterType.value = 'all';
                if (filterStatus) filterStatus.value = 'all';
                
                const today = new Date();
                const oneYearAgo = new Date();
                oneYearAgo.setFullYear(today.getFullYear() - 1);
                
                if (startDate) startDate.value = oneYearAgo.toISOString().split('T')[0];
                if (endDate) endDate.value = today.toISOString().split('T')[0];
                
                currentPage = 1;
                applyFilters();
            }

            // Event listeners
            if (applyFilter) {
                applyFilter.addEventListener('click', function() {
                    currentPage = 1;
                    applyFilters();
                });
            }

            if (clearFilter) {
                clearFilter.addEventListener('click', clearFilters);
            }

            if (prevPage) {
                prevPage.addEventListener('click', function() {
                    if (currentPage > 1) {
                        currentPage--;
                        applyFilters();
                    }
                });
            }

            if (nextPage) {
                nextPage.addEventListener('click', function() {
                    currentPage++;
                    applyFilters();
                });
            }

            if (rowsPerPage) {
                rowsPerPage.addEventListener('change', function() {
                    itemsPerPage = parseInt(this.value);
                    currentPage = 1;
                    applyFilters();
                });
            }
        })();

        // Table sorting function
        let sortDirection = {};
        function sortTable(columnIndex) {
            const table = document.getElementById('pastDataTable');
            const tbody = document.getElementById('pastDataTableBody');
            const rows = Array.from(tbody.querySelectorAll('.data-row'));

            // Toggle sort direction
            sortDirection[columnIndex] = !sortDirection[columnIndex];
            const ascending = sortDirection[columnIndex];

            rows.sort((a, b) => {
                let aValue = a.cells[columnIndex].textContent.trim();
                let bValue = b.cells[columnIndex].textContent.trim();

                // For date column (index 3), use data-sort attribute
                if (columnIndex === 3) {
                    aValue = parseInt(a.cells[columnIndex].dataset.sort) || 0;
                    bValue = parseInt(b.cells[columnIndex].dataset.sort) || 0;
                    return ascending ? aValue - bValue : bValue - aValue;
                }

                // String comparison for other columns
                if (ascending) {
                    return aValue.localeCompare(bValue);
                } else {
                    return bValue.localeCompare(aValue);
                }
            });

            // Re-append sorted rows
            rows.forEach(row => tbody.appendChild(row));
        }
    </script>

    <!-- Go Back Button Script -->
    <script src="~/js/go-back-button.js"></script>

    <!-- Session Timeout -->
    @await Html.PartialAsync("_SessionTimeout")

