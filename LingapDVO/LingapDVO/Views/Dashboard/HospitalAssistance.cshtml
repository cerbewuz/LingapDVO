    <!-- Type of Assistance Requested Section -->
    <h5 class="section-header">Type of Assistance Requested</h5>
    <div class="row g-3">
        <div class="col-12 col-sm-12 col-md-6 col-lg-6">
            <!-- Column 1 -->
            <div class="form-check mt-2">
                <input class="form-check-input assistance-type" type="checkbox"
                       id="governmentAssistance" name="TypeassistanceOptions" value="Government">
                <label class="form-check-label ms-1" for="governmentAssistance">Government</label>
                <input type="text" class="form-control mt-1 assistance-spec"
                       name="GovernmentDetails" placeholder="Specify" style="display: none;">
            </div>

            <div class="form-check mt-2">
                <input class="form-check-input assistance-type" type="checkbox"
                       id="privateAssistance" name="TypeassistanceOptions" value="Private">
                <label class="form-check-label ms-1" for="privateAssistance">Private</label>
                <input type="text" class="form-control mt-1 assistance-spec"
                       name="PrivateDetails" placeholder="Specify" style="display: none;">
            </div>

            <div class="form-check mt-2">
                <input class="form-check-input assistance-type" type="checkbox"
                       id="caseAssistance" name="TypeassistanceOptions" value="Case">
                <label class="form-check-label ms-1" for="caseAssistance">Case</label>
                <input type="text" class="form-control mt-1 assistance-spec"
                       name="CaseDetails" placeholder="Specify" style="display: none;">
            </div>
        </div>
    </div>

    <div class="form-group mt-3" style="display: none">
        <input asp-for="Typeassistance" type="text" class="form-control" id="assistanceReflection"
               name="Typeassistance" placeholder="Auto-generated info..." readonly>
        <span asp-validation-for="Typeassistance" class="text-danger"></span>
    </div>

    <!-- Upload Section -->
    <h5 class="section-header">Upload Required Documents</h5>

    <div class="mb-3">
        <label class="">Hospital Assistance Document</label>
        <div class="upload-box" onclick="document.getElementById('hospitalDocument').click()">
            <div class="upload-icon">
                <i class="bi bi-card-image"></i>
            </div>
            <p>Click to upload document</p>
            <p>Accepted formats: JPG, PNG, PDF (Max 10MB)</p>
        </div>
        <input asp-for="HospitalAssistanceDocument" type="file" id="hospitalDocument" class="d-none"
               accept=".png,.jpg,.jpeg,.pdf" onchange="previewImage(this, 'hospitalDocumentPreview')">
        <span asp-validation-for="HospitalAssistanceDocument" class="text-danger"></span>

        <img id="hospitalDocumentPreview" class="img-preview mt-2" alt="Hospital Assistance Document Preview">
        <p class="form-note">* Only images will be shown in preview. PDF files will be accepted but not previewed.</p>
    </div>

    <!-- Terms and Conditions -->
    <div class="mb-4">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="termsCheck" required>
            <label class="form-check-label ms-1" for="termsCheck">I certify that all information provided is true and accurate</label>
        </div>
    </div>

    <!-- Submit Button -->
    <div class="text-center mt-4">
        <button type="submit" class="btn-submit" style="display: inline-block; padding: 10px 30px;">Submit Request</button>
    </div>
    <br />
    <br />
</form>

@section Modals {
    <!-- Enhanced Success Modal -->
    <div class="modal fade" id="successModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
                <!-- Success Animation Header -->
                <div class="text-center pt-5 pb-3" style="background: linear-gradient(135deg, #28a745 0%, #20c997 100%);">
                    <div class="success-checkmark-animated mb-2">
                        <i class="fas fa-check-circle text-white" style="font-size: 4.5rem; animation: scaleIn 0.5s ease-out;"></i>
                    </div>
                </div>
                
                <!-- Modal Body -->
                <div class="modal-body text-center px-4 py-4">
                    <h4 class="fw-bold text-dark mb-3" style="font-size: 1.5rem;">Application Submitted!</h4>
                    <p class="text-muted mb-2" style="font-size: 0.95rem; line-height: 1.6;">
                        Your hospital assistance application has been successfully submitted and is now being processed.
                    </p>
                    <div class="alert alert-light border-0 mt-3 mb-0" style="background-color: #f8f9fa; border-radius: 10px;">
                        <small class="text-secondary">
                            <i class="fas fa-info-circle me-1"></i>
