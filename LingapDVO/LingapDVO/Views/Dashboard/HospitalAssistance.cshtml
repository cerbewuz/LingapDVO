                <div class="col-md-3 col-sm-12">
                    <label class="form-label">PhilHealth No. (if any)</label>
                    <input asp-for="PhilHealthNo" type="text" class="form-control" id="philHealthInput" placeholder="XXXX-XXXX-XXXX">
                    <span asp-validation-for="PhilHealthNo"></span>
                </div>

                <script>
                    const philHealthInput = document.getElementById('philHealthInput');
                    const philHealthSelect = document.getElementById('philHealthSelect');

                    // Format PhilHealth number with hyphens
                    philHealthInput.addEventListener('input', function(e) {
                        // Remove all non-digit characters
                        let value = this.value.replace(/\D/g, '');

                        // Add hyphens after every 4 digits
                        if (value.length > 4) {
                            value = value.substring(0, 4) + '-' + value.substring(4);
                        }
                        if (value.length > 9) {
                            value = value.substring(0, 9) + '-' + value.substring(9);
                        }

                        // Limit to 12 digits (14 characters with hyphens)
                        if (value.length > 14) {
                            value = value.substring(0, 14);
                        }

                        this.value = value;
                    });

                    // Handle conditional PhilHealth No. validation
                    philHealthSelect.addEventListener('change', function() {
                        if (this.value === 'Without PhilHealth') {
                            // Remove required attribute and clear the field
                            philHealthInput.removeAttribute('required');
                            philHealthInput.value = '';
                            philHealthInput.disabled = true; // Disable the input field
                            philHealthInput.classList.remove('is-invalid'); // Remove validation error
                        } else if (this.value === 'With PhilHealth') {
                            // Add required attribute when "With PhilHealth" is selected
                            philHealthInput.setAttribute('required', 'required');
                            philHealthInput.disabled = false; // Enable the input field
                        } else {
                            // Default: remove required for empty selection
                            philHealthInput.removeAttribute('required');
                            philHealthInput.disabled = false;
                        }
                    });

                    // Initialize on page load
                    if (philHealthSelect.value === 'Without PhilHealth') {
                        philHealthInput.removeAttribute('required');
                        philHealthInput.disabled = true;
                    } else if (philHealthSelect.value === 'With PhilHealth') {
                        philHealthInput.setAttribute('required', 'required');
                        philHealthInput.disabled = false;
                    }
                </script>

                <div class="col-md-2 col-sm-6">
