                    <div class="progress" style="height: 4px; border-radius: 10px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: 100%; animation: progressFill 2s ease-out;"></div>
                    </div>
                    <p class="text-center text-muted mt-2 mb-0" style="font-size: 0.75rem;">
                        Redirecting to homepage...
                    </p>
                </div>
            </div>
        </div>
    </div>

    <style>
        @@keyframes scaleIn {
            0% { transform: scale(0); opacity: 0; }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); opacity: 1; }
        }
        
        @@keyframes progressFill {
            0% { width: 0%; }
            100% { width: 100%; }
        }
    </style>

    <!-- For zooming photo -->
    <div class="modal fade" id="imageModal" tabindex="-1" aria-labelledby="imageModalLabel" aria-hidden="false">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="imageModalLabel">Image Preview</h5>
                    <div class="zoom-controls">
                        <button type="button" class="btn btn-sm btn-outline-secondary me-2" id="zoomOut">
                            <i class="bi bi-zoom-out"></i>
                        </button>
                        <span id="zoomPercentage">100%</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary ms-2" id="zoomIn">
                            <i class="bi bi-zoom-in"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary ms-2" id="zoomReset">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </button>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center p-0">
                    <div id="imageContainer">
                        <img id="modalImage" src="" class="img-fluid" alt="Enlarged Image">
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Main initialization function
        document.addEventListener('DOMContentLoaded', function() {
            initializeContactNumber();
            initializePhilHealth();
            initializeDateOfBirth();
            initializeAssistanceCheckboxes();
            initializeFormValidation();
            initializeImageModal();
            initializeAutoFill();
            initializePatientToggle();

            // Check for successful form submission
            checkFormSubmission();
        });

        // Contact Number Validation
        function initializeContactNumber() {
            const contactNoInput = document.getElementById('contactNoInput');
            if (!contactNoInput) return;

            contactNoInput.addEventListener('input', function(e) {
                let value = this.value;
                value = value.replace(/\D/g, '');
                if (value.length > 11) {
                    value = value.substring(0, 11);
                }
                this.value = value;
            });

            contactNoInput.addEventListener('blur', function() {
                const value = this.value.trim();
                if (!value) return;
                const validFormat = /^09\d{9}$/;
                if (!validFormat.test(value)) {
                    alert("Please enter a valid Philippine mobile number in format: 09123456789 (11 digits)");
                    this.focus();
                }
            });
        }

        // PhilHealth Number Handling
        function initializePhilHealth() {
            const philHealthInput = document.getElementById('philHealthInput');
            const philHealthSelect = document.getElementById('philHealthSelect');
            if (!philHealthInput || !philHealthSelect) return;

            philHealthInput.addEventListener('input', function(e) {
                let value = this.value.replace(/\D/g, '');
                if (value.length > 4) {
                    value = value.substring(0, 4) + '-' + value.substring(4);
                }
                if (value.length > 9) {
                    value = value.substring(0, 9) + '-' + value.substring(9);
                }
                if (value.length > 14) {
                    value = value.substring(0, 14);
                }
                this.value = value;
            });

            philHealthSelect.addEventListener('change', function() {
                if (this.value === 'Without PhilHealth') {
                    philHealthInput.removeAttribute('required');
                    philHealthInput.value = '';
                    philHealthInput.disabled = true;
                    philHealthInput.readOnly = true;
                    philHealthInput.classList.add('readonly-field');
                    philHealthInput.classList.remove('is-invalid');
                } else if (this.value === 'With PhilHealth') {
                    philHealthInput.setAttribute('required', 'required');
                    philHealthInput.disabled = false;
                    philHealthInput.readOnly = false;
                    philHealthInput.classList.remove('readonly-field');
                } else {
                    philHealthInput.removeAttribute('required');
                    philHealthInput.disabled = false;
                    philHealthInput.readOnly = false;
                    philHealthInput.classList.remove('readonly-field');
                }
            });

            // Initialize on page load
            if (philHealthSelect.value === 'Without PhilHealth') {
                philHealthInput.removeAttribute('required');
                philHealthInput.disabled = true;
                philHealthInput.readOnly = true;
                philHealthInput.classList.add('readonly-field');
            } else if (philHealthSelect.value === 'With PhilHealth') {
                philHealthInput.setAttribute('required', 'required');
                philHealthInput.disabled = false;
                philHealthInput.readOnly = false;
                philHealthInput.classList.remove('readonly-field');
            }
        }

        // Date of Birth and Age Calculation
        function initializeDateOfBirth() {
            const dateOfBirth = document.getElementById('dateOfBirth');
            const ageInput = document.getElementById('ageInput');
            if (!dateOfBirth || !ageInput) return;

            function calculateAge(dob) {
                if (!dob) return "";
                const birthDate = new Date(dob);
                const today = new Date();
                let age = today.getFullYear() - birthDate.getFullYear();
                const monthDiff = today.getMonth() - birthDate.getMonth();
                if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthDate.getDate())) {
                    age--;
                }
                return age;
            }

            if (dateOfBirth.value) {
                ageInput.value = calculateAge(dateOfBirth.value);
            }

            dateOfBirth.addEventListener('change', function () {
                ageInput.value = calculateAge(this.value);
            });
        }

        // Assistance Checkboxes - SINGLE SELECTION FIXED
        function initializeAssistanceCheckboxes() {
            const assistanceCheckboxes = document.querySelectorAll('.assistance-type');
            const assistanceSpecs = document.querySelectorAll('.assistance-spec');
            const assistanceReflection = document.getElementById('assistanceReflection');

            // Initialize - hide all specification fields and ensure no checkboxes are checked
            assistanceSpecs.forEach(field => field.style.display = 'none');
            assistanceCheckboxes.forEach(checkbox => checkbox.checked = false);

            // Single selection function
            assistanceCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    if (this.checked) {
                        // Uncheck all other checkboxes
                        assistanceCheckboxes.forEach(cb => {
                            if (cb !== this) {
                                cb.checked = false;
                                const specField = cb.closest('.form-check').querySelector('.assistance-spec');
                                if (specField) specField.style.display = 'none';
                            }
                        });

                        // Show specification field for checked box
                        const specField = this.closest('.form-check').querySelector('.assistance-spec');
                        if (specField) {
                            specField.style.display = 'block';
                        }
                    } else {
                        // Hide specification field when unchecked
                        const specField = this.closest('.form-check').querySelector('.assistance-spec');
                        if (specField) {
                            specField.style.display = 'none';
                        }
                    }
                    updateAssistanceReflection();
                });
            });

            // Update reflection function
            function updateAssistanceReflection() {
                let selectedOptions = [];
                assistanceCheckboxes.forEach(checkbox => {
                    if (checkbox.checked) {
                        const label = checkbox.nextElementSibling.textContent.trim();
                        const specField = checkbox.closest('.form-check').querySelector('.assistance-spec');
                        if (specField && specField.value.trim() !== '') {
                            selectedOptions.push(`${label}: ${specField.value.trim()}`);
                        } else {
                            selectedOptions.push(label);
                        }
                    }
                });
                if (assistanceReflection) {
                    assistanceReflection.value = selectedOptions.join(', ');
                }
            }

            // Add input listeners to specification fields
            assistanceSpecs.forEach(field => {
                field.addEventListener('input', updateAssistanceReflection);
            });

            // Initial update
            updateAssistanceReflection();
        }

        // Form Validation
        function initializeFormValidation() {
            const form = document.querySelector('form');
            if (!form) return;

            function initializeRequiredLabels() {
                const requiredInputs = form.querySelectorAll('input[required], select[required], textarea[required]');
                requiredInputs.forEach(input => {
                    const label = input.closest('.col-md-1, .col-md-2, .col-md-3, .col-md-4, .col-md-6, .col-md-12, .mb-3, .mb-4')?.querySelector('label');
                    if (label && !label.classList.contains('form-check-label')) {
                        label.classList.add('required');
                    }
                });
            }

            function updateRequiredIndicator(input) {
                const label = input.closest('.col-md-1, .col-md-2, .col-md-3, .col-md-4, .col-md-6, .col-md-12, .mb-3, .mb-4')?.querySelector('label.required');
                if (label) {
                    if (input.value.trim() !== '' || input.checked) {
                        label.classList.add('filled');
                    } else {
                        label.classList.remove('filled');
                    }
                }
            }

            function attachInputListeners() {
                const allInputs = form.querySelectorAll('input, select, textarea');
                allInputs.forEach(input => {
                    ['input', 'change', 'blur'].forEach(event => {
                        input.addEventListener(event, () => updateRequiredIndicator(input));
                    });
                });
            }

            function validateAssistanceCheckboxes() {
                const assistanceCheckboxes = document.querySelectorAll('.assistance-type');
                const checked = Array.from(assistanceCheckboxes).some(cb => cb.checked);
                const assistanceSection = document.querySelector('.assistance-type')?.closest('.row');
                const existingError = assistanceSection?.querySelector('.error-message');
                if (existingError) existingError.remove();

                if (!checked) {
                    if (assistanceSection) {
                        assistanceSection.classList.add('checkbox-group-error');
                        const errorMsg = document.createElement('div');
                        errorMsg.className = 'error-message show';
                        errorMsg.textContent = 'Please select at least one type of assistance';
                        assistanceSection.appendChild(errorMsg);
                    }
                    return false;
                } else {
                    assistanceSection?.classList.remove('checkbox-group-error');
                    return true;
                }
            }

            function validateSexRadio() {
                const sexRadios = document.querySelectorAll('input[name="Sex"]');
                const checked = Array.from(sexRadios).some(radio => radio.checked);
                const sexSection = document.querySelector('input[name="Sex"]')?.closest('.col-md-2');
                const existingError = sexSection?.querySelector('.error-message');
                if (existingError) existingError.remove();

                if (!checked) {
                    if (sexSection) {
                        sexSection.classList.add('radio-group-error');
                        const errorMsg = document.createElement('div');
                        errorMsg.className = 'error-message show';
                        errorMsg.textContent = 'Please select sex';
                        sexSection.appendChild(errorMsg);
                    }
                    return false;
                } else {
                    sexSection?.classList.remove('radio-group-error');
                    return true;
                }
            }

            function attachCheckboxRadioListeners() {
                const assistanceCheckboxes = document.querySelectorAll('.assistance-type');
                assistanceCheckboxes.forEach(checkbox => {
                    checkbox.addEventListener('change', () => {
                        if (checkbox.checked) {
                            const assistanceSection = checkbox.closest('.row');
                            assistanceSection?.classList.remove('checkbox-group-error');
                            const errorMsg = assistanceSection?.querySelector('.error-message');
                            if (errorMsg) errorMsg.remove();
                        }
                    });
                });

                const sexRadios = document.querySelectorAll('input[name="Sex"]');
                sexRadios.forEach(radio => {
                    radio.addEventListener('change', () => {
                        if (radio.checked) {
                            const sexSection = radio.closest('.col-md-2');
                            sexSection?.classList.remove('radio-group-error');
                            const errorMsg = sexSection?.querySelector('.error-message');
                            if (errorMsg) errorMsg.remove();
                        }
                    });
                });
            }

            form.addEventListener('submit', function(e) {
                let isValid = true;
                const missingFields = [];
                const requiredInputs = form.querySelectorAll('input[required], select[required], textarea[required]');
                const patientSection = document.getElementById('patientDetailsSection');
                const isPatientSectionHidden = patientSection && window.getComputedStyle(patientSection).display === 'none';

                // Clear previous validation states
                form.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
                form.querySelectorAll('.checkbox-group-error, .radio-group-error').forEach(el => {
                    el.classList.remove('checkbox-group-error', 'radio-group-error');
                });

                // Helper function to get field label
                function getFieldLabel(input) {
                    const container = input.closest('.col-lg-1, .col-lg-2, .col-lg-3, .col-lg-4, .col-lg-5, .col-lg-6, .col-md-1, .col-md-2, .col-md-3, .col-md-4, .col-md-5, .col-md-6, .col-md-12, .col-sm-6, .col-sm-12, .mb-3, .mb-4');
                    const label = container?.querySelector('label:not(.form-check-label)');
                    return label?.textContent?.replace('*', '').trim() || input.name || 'Unknown field';
                }

                requiredInputs.forEach(input => {
                    // Skip validation for fields inside hidden patient details section
                    if (isPatientSectionHidden && patientSection && patientSection.contains(input)) {
                        return; // Skip this field
                    }

                    if (input.type !== 'checkbox' && input.type !== 'radio') {
                        if (!input.value.trim()) {
                            input.classList.add('is-invalid');
                            missingFields.push(getFieldLabel(input));
                            isValid = false;
                        }
                    }
                });

                // Validate assistance checkboxes
                const assistanceCheckboxes = document.querySelectorAll('.assistance-type');
                const isAnyAssistanceChecked = Array.from(assistanceCheckboxes).some(cb => cb.checked);
                if (!isAnyAssistanceChecked) {
                    const assistanceSection = document.querySelector('.assistance-type')?.closest('.row');
                    if (assistanceSection) {
                        assistanceSection.classList.add('checkbox-group-error');
                    }
                    missingFields.push('Type of Assistance Requested');
                    isValid = false;
                }

                // Only validate sex radio if patient section is visible
                if (!isPatientSectionHidden) {
                    const sexRadios = document.querySelectorAll('input[name="Sex"]');
                    const isSexSelected = Array.from(sexRadios).some(radio => radio.checked);
                    if (!isSexSelected) {
                        const sexSection = document.querySelector('input[name="Sex"]')?.closest('.col-lg-2, .col-md-2, .col-md-3');
                        if (sexSection) {
                            sexSection.classList.add('radio-group-error');
                        }
                        missingFields.push('Sex');
                        isValid = false;
                    }
                }

                // Validate file upload (Upload Required Documents)
                const fileInput = document.getElementById('hospitalDocument');
                if (fileInput && fileInput.files.length === 0) {
                    missingFields.push('Upload Required Documents');
                    isValid = false;
                    // Highlight the upload box
                    const uploadBox = fileInput.closest('.mb-3')?.querySelector('.upload-box');
                    if (uploadBox) {
                        uploadBox.style.borderColor = '#dc3545';
                        uploadBox.style.backgroundColor = 'rgba(220, 53, 69, 0.05)';
                    }
                }

                // Validate terms checkbox
                const termsCheck = document.getElementById('termsCheck');
                if (termsCheck && !termsCheck.checked) {
                    missingFields.push('Terms and Conditions acceptance');
                    isValid = false;
                }

                if (!isValid) {
                    e.preventDefault();
                    
                    // Show unified warning message with bullet points
                    let message = 'Please complete the following required fields:\n\n';
                    missingFields.forEach(field => {
                        message += '• ' + field + '\n';
                    });
                    alert(message);

                    // Scroll to first error
                    const firstError = form.querySelector('.is-invalid, .checkbox-group-error, .radio-group-error');
                    if (firstError) {
                        firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                }
            });

            initializeRequiredLabels();
            attachInputListeners();
            attachCheckboxRadioListeners();
            const allInputs = form.querySelectorAll('input, select, textarea');
            allInputs.forEach(input => updateRequiredIndicator(input));
        }

        // Image Modal and Zoom Functionality
        function initializeImageModal() {
            const previewImages = document.querySelectorAll('.img-preview');
            const modalImage = document.getElementById('modalImage');
            const imageModal = new bootstrap.Modal(document.getElementById('imageModal'));
            const modalTitle = document.getElementById('imageModalLabel');
            const imageContainer = document.getElementById('imageContainer');
            const zoomPercentage = document.getElementById('zoomPercentage');
            const zoomInBtn = document.getElementById('zoomIn');
            const zoomOutBtn = document.getElementById('zoomOut');
            const zoomResetBtn = document.getElementById('zoomReset');

            let currentZoom = 1;
            const zoomFactor = 0.1;
            const maxZoom = 3;
            const minZoom = 0.5;

            function resetZoom() {
                currentZoom = 1;
                updateZoom();
            }

            function updateZoom() {
                if (modalImage) {
                    modalImage.style.transform = `scale(${currentZoom})`;
                    zoomPercentage.textContent = `${Math.round(currentZoom * 100)}%`;
                }
            }

            function zoomIn() {
                if (currentZoom < maxZoom) {
                    currentZoom += zoomFactor;
                    updateZoom();
                }
            }

            function zoomOut() {
                if (currentZoom > minZoom) {
                    currentZoom -= zoomFactor;
                    updateZoom();
                }
            }

            previewImages.forEach(img => {
                img.style.cursor = 'pointer';
                img.addEventListener('click', function() {
                    if (modalImage) modalImage.src = this.src;
                    if (modalTitle) modalTitle.textContent = this.alt || 'Image Preview';
                    resetZoom();
                    imageModal.show();
                });
            });

            if (zoomInBtn) zoomInBtn.addEventListener('click', zoomIn);
            if (zoomOutBtn) zoomOutBtn.addEventListener('click', zoomOut);
            if (zoomResetBtn) zoomResetBtn.addEventListener('click', resetZoom);

            if (imageContainer) {
                imageContainer.addEventListener('wheel', function(e) {
                    e.preventDefault();
                    if (e.deltaY < 0) {
                        zoomIn();
                    } else {
                        zoomOut();
                    }
                });
            }

            document.getElementById('imageModal')?.addEventListener('hidden.bs.modal', function() {
                resetZoom();
                modalImage.style.transform = 'scale(1) translate(0, 0)';
            });
        }

        // Auto-fill functionality
        function initializeAutoFill() {
            const sameAsPatientBtn = document.getElementById('sameAsPatientBtn');
            const clearAutoFillBtn = document.getElementById('clearAutoFillBtn');
            if (!sameAsPatientBtn || !clearAutoFillBtn) return;

            const patientLastname = document.getElementById('Lastname');
            const patientFirstname = document.getElementById('Firstname');
            const patientMiddlename = document.getElementById('Middlename');
            const patientSuffix = document.getElementById('Suffix');
            const patientBlkLotStreet = document.getElementById('BlkLotStreet');
            const patientSubVill = document.getElementById('SubVill');
            const patientBrgy = document.getElementById('Brgy');
            const patientDistrict = document.getElementById('District');

            const requestorLastname = document.getElementById('RLastname');
            const requestorFirstname = document.getElementById('RFirstname');
            const requestorMiddlename = document.getElementById('RMiddlename');
            const requestorSuffix = document.getElementById('RSuffix');
            const requestorBlkLotStreet = document.getElementById('RBlkLotStreet');
            const requestorSubVill = document.getElementById('RSubVill');
            const requestorBrgy = document.getElementById('RBrgy');
            const requestorDistrict = document.getElementById('RDistrict');
            const relationshipPatient = document.getElementById('RelationshipPatient');

            let originalPatientValues = {};
            let autoFillUsed = false;

            function storeOriginalValues() {
                const fields = ['Lastname', 'Firstname', 'Middlename', 'Suffix', 'BlkLotStreet', 'SubVill', 'Brgy', 'District'];
                originalPatientValues = {};
                fields.forEach(field => {
                    const element = document.getElementById(field);
                    if (element) {
                        originalPatientValues[field] = element.value;
                    }
                });
            }

            function restoreOriginalValues() {
                Object.keys(originalPatientValues).forEach(field => {
                    const element = document.getElementById(field);
                    if (element) {
                        element.value = originalPatientValues[field];
                    }
                });

                const maleRadio = document.getElementById('male');
                const femaleRadio = document.getElementById('female');
                if (maleRadio) maleRadio.checked = false;
                if (femaleRadio) femaleRadio.checked = false;

                const dateOfBirthField = document.getElementById('dateOfBirth');
                const ageField = document.getElementById('ageInput');
                if (dateOfBirthField) dateOfBirthField.value = '';
                if (ageField) ageField.value = '';
            }

            function checkIfAllPatientFieldsEmpty() {
                const patientFieldsList = [
                    patientLastname, patientFirstname, patientMiddlename,
                    patientSuffix, patientBlkLotStreet, patientSubVill,
                    patientBrgy, patientDistrict
                ];
                return patientFieldsList.every(field => !field || !field.value.trim());
            }

            sameAsPatientBtn.addEventListener('click', function() {
                if (!autoFillUsed) {
                    storeOriginalValues();
                }
                autoFillUsed = true;

                if (requestorLastname && requestorLastname.value) patientLastname.value = requestorLastname.value;
                if (requestorFirstname && requestorFirstname.value) patientFirstname.value = requestorFirstname.value;
                if (requestorMiddlename && requestorMiddlename.value) patientMiddlename.value = requestorMiddlename.value;
                if (requestorSuffix) {
                    patientSuffix.value = (requestorSuffix.value && requestorSuffix.value.trim()) ? requestorSuffix.value : "None";
                }
                if (requestorBlkLotStreet && requestorBlkLotStreet.value) patientBlkLotStreet.value = requestorBlkLotStreet.value;
                if (requestorSubVill && requestorSubVill.value) patientSubVill.value = requestorSubVill.value;
                if (requestorBrgy && requestorBrgy.value) patientBrgy.value = requestorBrgy.value;
                if (requestorDistrict && requestorDistrict.value) patientDistrict.value = requestorDistrict.value;

                if (relationshipPatient) relationshipPatient.value = "Self";

                const userGender = '@ViewBag.Gender';
                if (userGender) {
                    const maleRadio = document.getElementById('male');
                    const femaleRadio = document.getElementById('female');
                    if (userGender.toLowerCase() === 'male' && maleRadio) {
                        maleRadio.checked = true;
                    } else if (userGender.toLowerCase() === 'female' && femaleRadio) {
                        femaleRadio.checked = true;
                    }
                }

                const userDateOfBirth = '@ViewBag.Dateofbirth';
                const dateOfBirthField = document.getElementById('dateOfBirth');
                if (userDateOfBirth && dateOfBirthField) {
                    dateOfBirthField.value = userDateOfBirth;
                    const ageField = document.getElementById('ageInput');
                    if (ageField) {
                        ageField.value = calculateAge(userDateOfBirth);
                    }
                }

                sameAsPatientBtn.innerHTML = '<i class="bi bi-check-circle"></i> Details Copied!';
                sameAsPatientBtn.classList.remove('btn-outline-success', 'animate-pulse');
                sameAsPatientBtn.classList.add('btn-success', 'ring-2', 'ring-green-500');

                clearAutoFillBtn.style.display = 'block';
                clearAutoFillBtn.innerHTML = '<i class="bi bi-eraser"></i> Clear Auto-Fill';
                clearAutoFillBtn.classList.remove('btn-warning', 'ring-2', 'ring-yellow-500');
                clearAutoFillBtn.classList.add('btn-outline-warning');

                const patientSection = document.getElementById('patientDetailsSection');
                const toggleBtn = document.getElementById('togglePatientBtn');
                if (patientSection) {
                    patientSection.style.display = 'block';
                    if (toggleBtn) {
                        toggleBtn.textContent = 'Hide Patient Details';
                        toggleBtn.classList.remove('btn-outline-primary');
                        toggleBtn.classList.add('btn-primary');
                    }
                }

                setTimeout(() => {
                    sameAsPatientBtn.innerHTML = '<i class="bi bi-person-check"></i> APPLY FOR MYSELF';
                    sameAsPatientBtn.classList.remove('btn-success', 'ring-2', 'ring-green-500');
                    sameAsPatientBtn.classList.add('btn-outline-success');
                }, 2000);
            });

            clearAutoFillBtn.addEventListener('click', function() {
                restoreOriginalValues();
                autoFillUsed = false;
                clearAutoFillBtn.innerHTML = '<i class="bi bi-check-circle"></i> Cleared!';
                clearAutoFillBtn.classList.remove('btn-outline-warning');
                clearAutoFillBtn.classList.add('btn-warning', 'ring-2', 'ring-yellow-500');

                setTimeout(() => {
                    clearAutoFillBtn.innerHTML = '<i class="bi bi-eraser"></i> Clear Auto-Fill';
                    clearAutoFillBtn.classList.remove('btn-warning', 'ring-2', 'ring-yellow-500');
                    clearAutoFillBtn.classList.add('btn-outline-warning');
                    if (checkIfAllPatientFieldsEmpty()) {
                        clearAutoFillBtn.style.display = 'none';
                    }
                }, 1500);
            });

            function checkInitialState() {
                const anyFieldHasContent = !checkIfAllPatientFieldsEmpty();
                if (anyFieldHasContent) {
                    storeOriginalValues();
                    autoFillUsed = true;
                    clearAutoFillBtn.style.display = 'block';
                }
            }

            checkInitialState();
        }

        // Patient Details Toggle
        function initializePatientToggle() {
            const toggleBtn = document.getElementById('togglePatientBtn');
            const patientSection = document.getElementById('patientDetailsSection');
            if (!toggleBtn || !patientSection) return;

            toggleBtn.addEventListener('click', function() {
                const isHidden = window.getComputedStyle(patientSection).display === 'none';
                if (isHidden) {
                    patientSection.style.display = 'block';
                    toggleBtn.textContent = 'Hide Patient Details';
                    toggleBtn.classList.remove('btn-outline-primary');
                    toggleBtn.classList.add('btn-primary');
                } else {
                    patientSection.style.display = 'none';
                    toggleBtn.textContent = 'Show Patient Details';
                    toggleBtn.classList.remove('btn-primary');
                    toggleBtn.classList.add('btn-outline-primary');
                }
            });
        }

        // File Upload and Preview
        function previewImage(input, previewId) {
            const file = input.files[0];
            const preview = document.getElementById(previewId);
            const uploadBox = input.previousElementSibling;

            if (file) {
                if (file.type.startsWith("image/")) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        preview.src = e.target.result;
                        preview.style.display = "block";
                    };
                    reader.readAsDataURL(file);
                } else if (file.type === "application/pdf") {
                    preview.style.display = "none";
                }

                if (uploadBox) {
                    uploadBox.querySelector('p:first-of-type').textContent = file.name;
                    uploadBox.style.borderColor = "var(--primary-color)";
                    uploadBox.style.backgroundColor = "var(--primary-light)";
                }
            }
        }

        // Form Submission Success
        function checkFormSubmission() {
            @if (ViewBag.Success != null && ViewBag.Success == true)
            {
                    <text>
                    const successModal = new bootstrap.Modal(document.getElementById('successModal'));
                    successModal.show();
                    setTimeout(() => {
                        window.location.href = '/Home';
                    }, 2000);
                    </text>
            }
        }

        // Age calculation helper function
        function calculateAge(dob) {
            if (!dob) return "";
            const birthDate = new Date(dob);
            const today = new Date();
            let age = today.getFullYear() - birthDate.getFullYear();
            const monthDiff = today.getMonth() - birthDate.getMonth();
            if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < birthDate.getDate())) {
                age--;
            }
            return age;
        }
    </script>
}