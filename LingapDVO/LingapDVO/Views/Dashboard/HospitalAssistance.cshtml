@model HospitalAssistanceDto
@{
    Layout = "_InputFormsLayout";
    ViewData["Title"] = "Hospital Billing Assistance";
}

@section Styles {
    <style>
        .btn-submit {
            background-color: #28a745; 
            color: white;
            font-weight: 600;
            padding: 10px 25px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.3s ease, transform 0.2s ease;
        }

            .btn-submit:hover {
                background-color: #20c997; /* Green-blue hover */
                transform: scale(1.05);
            }

        /* Readonly field styling - indicates pre-populated non-editable fields */
        .readonly-field,
        .readonly-field:focus {
            background-color: #e9ecef !important;
            cursor: not-allowed !important;
            border-color: #ced4da !important;
            color: #495057 !important;
        }

            .readonly-field::placeholder {
                color: #6c757d !important;
            }

        /* Compact checkbox and radio button styling */
        .form-check-input {
            width: 1.1rem;
            height: 1.1rem;
            border: 1.5px solid #adb5bd;
            cursor: pointer;
            transition: all 0.15s ease;
            margin-top: 0.15rem;
            margin-right: 0.4rem;
            flex-shrink: 0;
            appearance: auto;
            -webkit-appearance: auto;
        }

            .form-check-input:checked {
                background-color: #dc143c;
                border-color: #dc143c;
            }

            .form-check-input:focus {
                border-color: #dc143c;
                box-shadow: 0 0 0 0.2rem rgba(220, 20, 60, 0.15);
                outline: none;
            }

            .form-check-input:hover {
                border-color: #dc143c;
            }

        /* Compact label alignment */
        .form-check-label {
            margin-left: 0;
            cursor: pointer;
            user-select: none;
            font-size: 0.95rem;
            line-height: 1.4;
        }

        /* Compact form-check container */
        .form-check {
            display: flex;
            align-items: center;
            padding-left: 0;
            margin-bottom: 0.5rem;
            min-height: 1.4rem;
        }

        /* Inline checkboxes/radios with tighter spacing */
        .form-check-inline {
            display: inline-flex;
            align-items: center;
            margin-right: 1rem;
            margin-bottom: 0.25rem;
        }

        /* Reduce spacing for checkbox groups */
        .form-check.mt-2 {
            margin-top: 0.5rem !important;
        }

        /* Required field indicator */
        label.required::after {
            content: " *";
            color: var(--primary-color);
            font-weight: bold;
            transition: opacity 0.3s ease;
        }

        label.required.filled::after {
            opacity: 0;
        }

        /* Validation error styles for checkbox/radio groups */
        .checkbox-group-error,
        .radio-group-error {
            border: 2px solid #dc3545 !important;
            border-radius: 8px;
            padding: 1rem;
            animation: shake 0.3s ease;
        }

        @@keyframes shake {
            0%, 100% {
                transform: translateX(0);
            }

            25% {
                transform: translateX(-5px);
            }

            75% {
                transform: translateX(5px);
            }
        }

        .error-message {
            color: #dc3545;
            font-size: 0.875rem;
            margin-top: 0.25rem;
            display: none;
            animation: fadeIn 0.3s ease;
        }

            .error-message.show {
                display: block;
            }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-5px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .img-preview {
            width: 100%;
            max-width: 100%;
            height: auto;
            max-height: 300px;
            margin-top: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            object-fit: contain;
            display: none;
        }

        .upload-box {
            border: 2px dashed #ddd;
            border-radius: 8px;
            padding: 1.5rem;
            text-align: center;
            background-color: #fafafa;
            transition: all 0.3s;
            cursor: pointer;
        }

            .upload-box:hover {
                border-color: var(--primary-color);
                background-color: var(--primary-light);
            }

        .upload-icon {
            font-size: 2rem;
            color: var(--primary-color);
            margin-bottom: 0.5rem;
        }

        .form-note {
            font-size: 0.85rem;
            color: #666;
            margin-top: 0.25rem;
        }

        .alert-danger i {
            margin-right: 0.5rem;
        }
    </style>
}

<form asp-action="HospitalAssistance" enctype="multipart/form-data" method="post">

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <!-- Requestor Details -->
    <h5 class="section-header">Requestor's Details</h5>
    @{
        var isLastnameReadonly = ViewBag.Lastname != null && !string.IsNullOrEmpty(ViewBag.Lastname.ToString());
        var isFirstnameReadonly = ViewBag.Firstname != null && !string.IsNullOrEmpty(ViewBag.Firstname.ToString());
        var isMiddlenameReadonly = ViewBag.Middlename != null && !string.IsNullOrEmpty(ViewBag.Middlename.ToString());
        var isSuffixReadonly = ViewBag.Suffix != null && !string.IsNullOrEmpty(ViewBag.Suffix.ToString());
        var isBlkLotStreetReadonly = ViewBag.BlkLotStreet != null && !string.IsNullOrEmpty(ViewBag.BlkLotStreet.ToString());
        var isSubVillReadonly = ViewBag.SubVill != null && !string.IsNullOrEmpty(ViewBag.SubVill.ToString());
        var isBarangayReadonly = ViewBag.Barangay != null && !string.IsNullOrEmpty(ViewBag.Barangay.ToString());
        var isDistrictReadonly = ViewBag.District != null && !string.IsNullOrEmpty(ViewBag.District.ToString());
        var isPhonenumberReadonly = ViewBag.Phonenumber != null && !string.IsNullOrEmpty(ViewBag.Phonenumber.ToString());
    }
    <div class="row g-3">
        <div class="col-lg-3 col-md-6 col-sm-12">
            <label class="form-label">Last Name</label>
            @if (isLastnameReadonly)
            {
                <input asp-for="RLastname" type="text" value="@ViewBag.Lastname"
                       oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')"
                       class="form-control readonly-field" readonly>
            }
            else
            {
                <input asp-for="RLastname" type="text" value="@ViewBag.Lastname"
                       oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')"
                       class="form-control">
            }
            <span asp-validation-for="RLastname" class="text-danger"></span>
        </div>

        <div class="col-lg-3 col-md-6 col-sm-12">
            <label class="form-label">First Name</label>
            @if (isFirstnameReadonly)
            {
                <input asp-for="RFirstname" type="text" value="@ViewBag.Firstname"
                       oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')"
                       class="form-control readonly-field" readonly>
            }
            else
            {
                <input asp-for="RFirstname" type="text" value="@ViewBag.Firstname"
                       oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')"
                       class="form-control">
            }
            <span asp-validation-for="RFirstname" class="text-danger"></span>
        </div>

        <div class="col-lg-3 col-md-6 col-sm-12">
            <label class="form-label">Middle Name</label>
            @if (isMiddlenameReadonly)
            {
                <input asp-for="RMiddlename" type="text" value="@ViewBag.Middlename"
                       oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')"
                       class="form-control readonly-field" readonly>
            }
            else
            {
                <input asp-for="RMiddlename" type="text" value="@ViewBag.Middlename"
                       oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')"
                       class="form-control">
            }
            <span asp-validation-for="RMiddlename"></span>
        </div>

        <div class="col-lg-2 col-md-3 col-sm-12">
            <label class="form-label">Suffix</label>
            <input type="text" asp-for="RSuffix" readonly
                   class="form-control readonly-field"
                   value="@(string.IsNullOrWhiteSpace(ViewBag.Suffix) || ViewBag.Suffix == "None" ? " " : ViewBag.Suffix)"
                   placeholder=" ">
            <span asp-validation-for="RSuffix"></span>
        </div>
    </div>

    <!-- Requestor Address -->
    <div class="row g-3 mt-2">
        <div class="col-lg-4 col-md-6 col-sm-12">
            <label class="form-label">Blk / Lot / Street</label>
            @if (isBlkLotStreetReadonly)
            {
                <input asp-for="RBlkLotStreet" type="text" value="@ViewBag.BlkLotStreet"
                       class="form-control readonly-field" readonly>
            }
            else
            {
                <input asp-for="RBlkLotStreet" type="text" value="@ViewBag.BlkLotStreet"
                       class="form-control">
            }
            <span asp-validation-for="RBlkLotStreet" class="text-danger"></span>
        </div>

        <div class="col-lg-4 col-md-6 col-sm-12">
            <label class="form-label">Sub / Vill.</label>
            @if (isSubVillReadonly)
            {
                <input asp-for="RSubVill" type="text" value="@ViewBag.SubVill"
                       class="form-control readonly-field" readonly>
            }
            else
            {
                <input asp-for="RSubVill" type="text" value="@ViewBag.SubVill"
                       class="form-control">
            }
            <span asp-validation-for="RSubVill" class="text-danger"></span>
        </div>

        <div class="col-lg-3 col-md-6 col-sm-12">
            <label class="form-label">Brgy.</label>
            @if (isBarangayReadonly)
            {
                <input asp-for="RBrgy" type="text" value="@ViewBag.Barangay"
                       class="form-control readonly-field" readonly>
            }
            else
            {
                <input asp-for="RBrgy" type="text" value="@ViewBag.Barangay"
                       class="form-control">
            }
            <span asp-validation-for="RBrgy" class="text-danger"></span>
        </div>

        <div class="col-lg-3 col-md-6 col-sm-12">
            <label class="form-label">District</label>
            @if (isDistrictReadonly)
            {
                <input asp-for="RDistrict" type="text" value="@ViewBag.District"
                       class="form-control readonly-field" readonly>
            }
            else
            {
                <input asp-for="RDistrict" type="text" value="@ViewBag.District"
                       class="form-control">
            }
            <span asp-validation-for="RDistrict" class="text-danger"></span>
        </div>
    </div>

    <div class="row g-3 mt-2">
        <div class="col-lg-4 col-md-6 col-sm-12">
            <label class="form-label">Relationship to Patient</label>
            <input asp-for="RelationshipPatient" type="text" class="form-control">
            <span asp-validation-for="RelationshipPatient" class="text-danger"></span>
        </div>

        <div class="col-lg-3 col-md-6 col-sm-12">
            <label class="form-label">Contact No.</label>
            @if (isPhonenumberReadonly)
            {
                <input asp-for="ContactNo" type="text" class="form-control readonly-field" id="contactNoInput"
                       value="@ViewBag.Phonenumber"
                       placeholder="09123456789"
                       pattern="[0-9]{11}"
                       maxlength="11"
                       inputmode="numeric"
                       readonly>
            }
            else
            {
                <input asp-for="ContactNo" type="text" class="form-control" id="contactNoInput"
                       value="@ViewBag.Phonenumber"
                       placeholder="09123456789"
                       pattern="[0-9]{11}"
                       maxlength="11"
                       inputmode="numeric">
            }
            <span asp-validation-for="ContactNo"></span>
            <small class="text-muted">Format: 09123456789 (11 digits)</small>
        </div>
    </div>

    <!-- Applying for self button -->
    <div class="mb-3 mt-3">
        <div class="d-flex align-items-center gap-2">
            <button type="button"
                    class="btn btn-outline-success transition-all duration-300 ease-in-out font-medium
                       hover:-translate-y-0.5 hover:shadow-lg hover:shadow-green-500/30
                       focus:ring-2 focus:ring-green-500 focus:ring-opacity-50
                       active:scale-95"
                    id="sameAsPatientBtn">
                <i class="bi bi-person-check"></i> APPLY FOR MYSELF
            </button>

            <button type="button"
                    class="btn btn-outline-warning transition-all duration-300 ease-in-out font-medium
                       hover:-translate-y-0.5 hover:shadow-lg hover:shadow-yellow-500/30
                       focus:ring-2 focus:ring-yellow-500 focus:ring-opacity-50
                       active:scale-95"
                    id="clearAutoFillBtn"
                    style="display: none;">
                <i class="bi bi-eraser"></i> Clear Auto-Fill
            </button>

            <small class="text-muted ms-2">
                Click "APPLY FOR MYSELF" if you are applying for yourself.
                Click "Clear auto-fill" if you clicked the button by accident.
            </small>
        </div>
    </div>

    <!-- Show Patient details toggle -->
    <button type="button" class="btn btn-outline-primary mb-3" id="togglePatientBtn">
        Show Patient Details
    </button>

    <!-- Wrap the Patient Details section in a div with a unique ID -->
    <div id="patientDetailsSection" style="display: none;">
        <!-- Patient Details -->
        <h5 class="section-header">Patient's Details</h5>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Last Name</label>
                <input asp-for="Lastname" type="text" class="form-control"
                       oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')" required>
                <span asp-validation-for="Lastname" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label class="form-label">First Name</label>
                <input asp-for="Firstname" type="text" class="form-control" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')" required>
                <span asp-validation-for="Firstname" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label class="form-label">Middle Name</label>
                <input asp-for="Middlename" type="text" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')" class="form-control">
                <span asp-validation-for="Middlename" class="text-danger"></span>
            </div>

            <div class="col-lg-2 col-md-3">
                <label class="form-label">Suffix</label>
                <select class="form-select" asp-for="Suffix">
                    <option value="None" selected>None</option>
                    <option value="Jr.">Jr.</option>
                    <option value="Sr.">Sr.</option>
                    <option value="II">II</option>
                    <option value="III">III</option>
                    <option value="IV">IV</option>
                    <option value="V">V</option>
                </select>
                <span asp-validation-for="Suffix" class="text-danger"></span>
            </div>
        </div>

        <!-- Address -->
        <div class="row g-3 mt-2">
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Blk / Lot / Street</label>
                <input asp-for="BlkLotStreet" type="text" class="form-control" required>
