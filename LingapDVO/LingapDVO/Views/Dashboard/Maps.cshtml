@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nearby Branches</title>
    <link rel="icon" type="image/x-icon" href="~/Icon/lingaplogo.ico">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/go-back-button.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    @await Html.PartialAsync("_SessionTimeout")

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background: #f0f4ff;
        }

        .container {
            max-width: 1000px;
            margin: 30px auto;
            padding: 20px;
        }

        h2 {
            text-align: center;
            margin-bottom: 25px;
            font-size: 28px;
            color: #0b2e63;
            font-weight: 700;
        }

        .section-title {
            background: #0b2e63;
            color: white;
            padding: 12px 15px;
            border-radius: 6px;
            margin-top: 30px;
            font-size: 20px;
            font-weight: bold;
        }

        .table-wrapper {
            overflow-x: auto;
            margin-top: 10px;
            border-radius: 6px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: #ffffff;
        }

        th {
            background: #0b2e63;
            color: white;
            padding: 12px;
            text-align: left;
            font-size: 14px;
        }

        td {
            padding: 12px;
            border-bottom: 1px solid #dcdcdc;
            font-size: 14px;
            vertical-align: top;
        }

        .office-name {
            font-weight: bold;
            font-size: 15px;
            color: #0b2e63;
        }

        /* Fix media query typo */
        @@media (max-width: 600px) {
            h2

        {
            font-size: 22px;
        }

        .section-title {
            font-size: 18px;
        }

        th, td {
            font-size: 13px;
            padding: 10px;
        }

        }

        :root {
            --primary-color: #DC143C;
            --secondary-color: #858796;
            --success-color: #1cc88a;
            --info-color: #36b9cc;
            --warning-color: #f6c23e;
            --danger-color: #e74a3b;
            --dark-color: #5a5c69;
        }

        body {
            background-color: #f8f9fc;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
            transition: transform 0.2s;
        }

            .card:hover {
                transform: translateY(-5px);
            }

        .btn-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .category-title {
            position: relative;
            margin: 2rem 0 1.5rem;
            color: var(--dark-color);
        }

            .category-title:after {
                content: "";
                position: absolute;
                left: 50%;
                bottom: -10px;
                transform: translateX(-50%);
                width: 80px;
                height: 3px;
                background: var(--primary-color);
                border-radius: 3px;
            }

        .location-card .card-body {
            padding: 1.5rem;
        }

        .location-icon {
            font-size: 1.75rem;
            margin-bottom: 1rem;
        }
    </style>
</head>

<body>

