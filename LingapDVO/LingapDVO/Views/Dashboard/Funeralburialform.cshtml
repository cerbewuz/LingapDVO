@model FuneralburialformDto
@{
    Layout = "_InputFormsLayout";
    ViewData["Title"] = "Hospital Billing Assistance";
}

@section Styles {
    <style>
.form-control:focus, 

        .btn-submit {
            background-color: #28a745; /* Green */
            color: white;
            font-weight: 600;
            padding: 10px 25px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.3s ease, transform 0.2s ease;
        }

            .btn-submit:hover {
                background-color: #20c997; /* Green-blue hover */
                transform: scale(1.05);
            }

        /* Enhanced checkbox and radio visibility */
        .form-check-input {
            width: 1.25rem;
            height: 1.25rem;
            border: 2px solid #dee2e6;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .form-check-input:checked {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            transform: scale(1.1);
        }

        .form-check-input:checked::after {
            content: '✓';
            display: block;
            text-align: center;
            color: white;
            font-weight: bold;
            font-size: 1rem;
            line-height: 1.25rem;
        }

        .form-check-input[type="radio"]:checked::after {
            content: '●';
            font-size: 0.8rem;
        }

        .form-check-input:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.2rem rgba(220, 20, 60, 0.25);
        }

        /* Required field indicator */
        label.required::after {
            content: " *";
            color: var(--primary-color);
            font-weight: bold;
            transition: opacity 0.3s ease;
        }

        label.required.filled::after {
            opacity: 0;
        }

        /* Validation error styles for checkbox/radio groups */
        .checkbox-group-error,
        .radio-group-error {
            border: 2px solid #dc3545 !important;
            border-radius: 8px;
            padding: 1rem;
            animation: shake 0.3s ease;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            75% { transform: translateX(5px); }
        }

        .error-message {
            color: #dc3545;
            font-size: 0.875rem;
            margin-top: 0.25rem;
            display: none;
            animation: fadeIn 0.3s ease;
        }

        .error-message.show {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-5px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .img-preview {
            width: 100%;
            max-width: 100%;
            height: auto;
            max-height: 300px;
            margin-top: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            object-fit: contain;
            display: none;
        }

        .upload-box {
            border: 2px dashed #ddd;
            border-radius: 8px;
            padding: 1.5rem;
            text-align: center;
            background-color: #fafafa;
            transition: all 0.3s;
            cursor: pointer;
        }

            .upload-box:hover {
                border-color: var(--primary-color);
                background-color: var(--primary-light);
            }

        .upload-icon {
            font-size: 2rem;
            color: var(--primary-color);
            margin-bottom: 0.5rem;
        }

        .form-note {
            font-size: 0.85rem;
            color: #666;
            margin-top: 0.25rem;
        }

            .alert-danger i {
                margin-right: 0.5rem;
            }
    </style>



