                if (patientLastname && patientLastname.value) requestorLastname.value = patientLastname.value;
                if (patientFirstname && patientFirstname.value) requestorFirstname.value = patientFirstname.value;
                if (patientMiddlename && patientMiddlename.value) requestorMiddlename.value = patientMiddlename.value;
                if (patientSuffix && patientSuffix.value) requestorSuffix.value = patientSuffix.value;
                if (patientBlkLotStreet && patientBlkLotStreet.value) requestorBlkLotStreet.value = patientBlkLotStreet.value;
                if (patientSubVill && patientSubVill.value) requestorSubVill.value = patientSubVill.value;
                if (patientBrgy && patientBrgy.value) requestorBrgy.value = patientBrgy.value;
                if (patientDistrict && patientDistrict.value) requestorDistrict.value = patientDistrict.value;

                // Set relationship to "Self"
                if (relationshipPatient) relationshipPatient.value = "Self";

                // Visual feedback with Tailwind
                sameAsPatientBtn.innerHTML = '<i class="bi bi-check-circle"></i> Details Copied!';
                sameAsPatientBtn.classList.remove('btn-outline-success', 'animate-pulse');
                sameAsPatientBtn.classList.add('btn-success', 'ring-2', 'ring-green-500');

                // Show clear button PERMANENTLY (never auto-hides)
                if (clearAutoFillBtn) {
                    clearAutoFillBtn.style.display = 'block';
                    clearAutoFillBtn.innerHTML = '<i class="bi bi-eraser"></i> Clear Auto-Fill';
                    clearAutoFillBtn.classList.remove('btn-warning', 'ring-2', 'ring-yellow-500');
                    clearAutoFillBtn.classList.add('btn-outline-warning');
                }

                // Auto-show requestor section
                if (requestorSection) {
                    requestorSection.style.display = 'block';
                    if (toggleBtn) {
                        toggleBtn.textContent = 'Hide Requestor Details';
                        toggleBtn.classList.remove('btn-outline-primary');
                        toggleBtn.classList.add('btn-primary');
                    }
                }

                // Reset main button after 2 seconds
                setTimeout(() => {
                    sameAsPatientBtn.innerHTML = '<i class="bi bi-person-check"></i> I am the patient';
                    sameAsPatientBtn.classList.remove('btn-success', 'ring-2', 'ring-green-500');
                    sameAsPatientBtn.classList.add('btn-outline-success');
                }, 2000);
            });

            // Clear button functionality - PERMANENT until manually clicked
            clearAutoFillBtn.addEventListener('click', function() {
                // Restore original values (clear all auto-filled data)
                restoreOriginalValues();

                // Reset the auto-fill flag
                autoFillUsed = false;

                // Visual feedback for clear
                clearAutoFillBtn.innerHTML = '<i class="bi bi-check-circle"></i> Cleared!';
                clearAutoFillBtn.classList.remove('btn-outline-warning');
                clearAutoFillBtn.classList.add('btn-warning', 'ring-2', 'ring-yellow-500');

                // Reset clear button after 1.5 seconds (but keep it visible)
                setTimeout(() => {
                    clearAutoFillBtn.innerHTML = '<i class="bi bi-eraser"></i> Clear Auto-Fill';
                    clearAutoFillBtn.classList.remove('btn-warning', 'ring-2', 'ring-yellow-500');
                    clearAutoFillBtn.classList.add('btn-outline-warning');

                    // Only hide if ALL fields are empty after clearing
                    const allFieldsEmpty = checkIfAllRequestorFieldsEmpty();
                    if (allFieldsEmpty) {
                        clearAutoFillBtn.style.display = 'none';
                    }
                    // Otherwise, keep it visible so user can clear again if needed
                }, 1500);
            });

            // Store original values function
            function storeOriginalValues() {
                const fields = [
                    'RLastname', 'RFirstname', 'RMiddlename', 'RSuffix',
                    'RBlkLotStreet', 'RSubVill', 'RBrgy', 'RDistrict', 'RelationshipPatient'
                ];

                originalRequestorValues = {}; // Reset storage
                fields.forEach(field => {
                    const element = document.getElementById(field);
                    if (element) {
                        originalRequestorValues[field] = element.value;
                    }
                });
            }

            // Restore original values function
            function restoreOriginalValues() {
                Object.keys(originalRequestorValues).forEach(field => {
                    const element = document.getElementById(field);
                    if (element) {
                        element.value = originalRequestorValues[field];
                    }
                });
            }

            // Check if all requestor fields are empty
            function checkIfAllRequestorFieldsEmpty() {
                const requestorFields = [
                    requestorLastname, requestorFirstname, requestorMiddlename,
                    requestorSuffix, requestorBlkLotStreet, requestorSubVill,
                    requestorBrgy, requestorDistrict, relationshipPatient
                ];

                return requestorFields.every(field => !field || !field.value.trim());
            }

            // Smart hint with Tailwind (optional - can remove if not needed)
            const patientFields = [patientLastname, patientFirstname, patientMiddlename];
            patientFields.forEach(field => {
                if (field) {
                    field.addEventListener('input', function() {
                        if (this.value &&
                            requestorLastname && !requestorLastname.value &&
                            requestorFirstname && !requestorFirstname.value &&
                            !autoFillUsed) {
                            sameAsPatientBtn.classList.add('ring-2', 'ring-green-500', 'animate-bounce');

                            setTimeout(() => {
                                sameAsPatientBtn.classList.remove('animate-bounce', 'ring-2', 'ring-green-500');
                            }, 3000);
                        }
                    });
                }
            });

            // Show clear button if page loads with pre-filled data
            function checkInitialState() {
                const anyFieldHasContent = !checkIfAllRequestorFieldsEmpty();
                if (anyFieldHasContent) {
                    storeOriginalValues();
                    autoFillUsed = true;
                    clearAutoFillBtn.style.display = 'block';
                }
            }

            // Run initial state check
            checkInitialState();
        });

function previewImage(input, previewId) {
            const file = input.files[0];
            const preview = document.getElementById(previewId);
            const uploadBox = input.previousElementSibling;

            if (file) {
                if (file.type.startsWith("image/")) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        preview.src = e.target.result;
                        preview.style.display = "block";
                    };
                    reader.readAsDataURL(file);
                }

                // Update upload box text
                uploadBox.querySelector('p:first-of-type').textContent = file.name;
                uploadBox.style.borderColor = "var(--primary-color)";
                uploadBox.style.backgroundColor = "var(--primary-light)";
            }

        }

const assistanceCheckboxes = document.querySelectorAll('.assistance-type');

        assistanceCheckboxes.forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                if (this.checked) {
                    // Uncheck all other checkboxes
                    assistanceCheckboxes.forEach(cb => {
                        if (cb !== this) {
                            cb.checked = false;
                            // Hide any specification fields for unchecked boxes
                            const specField = cb.closest('.form-check').querySelector('.assistance-spec');
                            if (specField) specField.style.display = 'none';
                        }
                    });

                    // Show specification field for checked box if it exists
                    const specField = this.closest('.form-check').querySelector('.assistance-spec');
                    if (specField) {
                        specField.style.display = this.checked ? 'block' : 'none';
                    }
                }
                updateAssistanceReflection();
            });
        });
        //1box only

         document.addEventListener('DOMContentLoaded', function() {
            // Type of Assistance Reflection
            const assistanceCheckboxes = document.querySelectorAll('.assistance-type');
            const assistanceSpecs = document.querySelectorAll('.assistance-spec');
            const assistanceReflection = document.getElementById('assistanceReflection');

            // Initialize - hide all specification fields
            assistanceSpecs.forEach(field => field.style.display = 'none');

            // Update reflection function
            function updateAssistanceReflection() {
                let selectedOptions = [];

                assistanceCheckboxes.forEach(checkbox => {
                    if (checkbox.checked) {
                        const label = checkbox.nextElementSibling.textContent.trim();
                        const specField = checkbox.closest('.form-check').querySelector('.assistance-spec');

                        if (specField && specField.value.trim() !== '') {
                            selectedOptions.push(`${label}: ${specField.value.trim()}`);
                        } else {
                            selectedOptions.push(label);
                        }
                    }
                });

                assistanceReflection.value = selectedOptions.join(', ');
            }

            // Add event listeners
            assistanceCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    const specField = this.closest('.form-check').querySelector('.assistance-spec');
                    if (specField) {
                        specField.style.display = this.checked ? 'block' : 'none';
                    }
                    updateAssistanceReflection();
                });
            });

            assistanceSpecs.forEach(field => {
                field.addEventListener('input', updateAssistanceReflection);
            });

            // Initial update
            updateAssistanceReflection();
        });

document.addEventListener('DOMContentLoaded', function() {
            // CMO Single Checkbox Selection
            const cmoCheckboxes = document.querySelectorAll('.supporting-doc');

            cmoCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    if (this.checked) {
                        // Uncheck all other checkboxes
                        cmoCheckboxes.forEach(cb => {
                            if (cb !== this) cb.checked = false;
                        });
                    }
                    updateReflection(); // Update the reflection field
                });
            });
        });
        //1 box only

        document.addEventListener('DOMContentLoaded', function() {
            // Get all elements
            const billInput = document.getElementById('billAmountInput');
            const cmoNotes = document.getElementById('cmoNotesInput');
            const reflectionField = document.getElementById('cmoReflectionField');
            const docCheckboxes = document.querySelectorAll('.supporting-doc');

            // Update reflection function
            function updateReflection() {
                let parts = [];

                // Add bill amount if exists
                if (billInput.value.trim()) {
                    parts.push(`Bill: ${billInput.value.trim()}`);
                }

                // Add checked documents
                const checkedDocs = [];
                docCheckboxes.forEach(cb => {
                    if (cb.checked) checkedDocs.push(cb.value);
                });
                if (checkedDocs.length) {
                    parts.push(`Docs: ${checkedDocs.join(', ')}`);
                }

                // Add CMO notes if exists
                if (cmoNotes.value.trim()) {
                    parts.push(`Others: ${cmoNotes.value.trim()}`);
                }

                // Update reflection field
                reflectionField.value = parts.join(' , ');
            }

            // Set up event listeners
            billInput.addEventListener('input', updateReflection);
            cmoNotes.addEventListener('input', updateReflection);
            docCheckboxes.forEach(cb => {
                cb.addEventListener('change', updateReflection);
            });

            // Initial update
            updateReflection();
        });

document.addEventListener('DOMContentLoaded', function() {
            // File validation for all file inputs
            const fileInputs = document.querySelectorAll('input[type="file"]');

            fileInputs.forEach(input => {
                input.addEventListener('change', function(e) {
                    validateFile(this);
                });
            });

            function validateFile(input) {
                const file = input.files[0];
                const previewId = input.id === 'receipt' ? 'receiptPreview' : '';
                const uploadBox = input.previousElementSibling;

                if (!file) return;

                // File type validation
                const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'application/pdf'];
                const maxSize = 10 * 1024 * 1024; // 10MB in bytes

                // Check file type
                if (!allowedTypes.includes(file.type)) {
                    showFileError(input, 'Invalid file type. Please upload only JPG, PNG, or PDF files.');
                    return;
                }

                // Check file size
                if (file.size > maxSize) {
                    showFileError(input, 'File size exceeds 10MB limit. Please choose a smaller file.');
                    return;
                }

                // If validation passes, proceed with preview
                clearFileError(input);

                if (file.type.startsWith("image/") && previewId) {
                    const preview = document.getElementById(previewId);
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        preview.src = e.target.result;
                        preview.style.display = "block";
                    };
                    reader.readAsDataURL(file);
                } else if (previewId) {
                    // For PDF files, hide the image preview
                    const preview = document.getElementById(previewId);
                    preview.style.display = "none";
                }

                // Update upload box text
                if (uploadBox) {
                    uploadBox.querySelector('p:first-of-type').textContent = file.name;
                    uploadBox.style.borderColor = "var(--primary-color)";
                    uploadBox.style.backgroundColor = "var(--primary-light)";
                }
            }

            function showFileError(input, message) {
                // Clear the file input
                input.value = '';

                // Remove any existing error message
                clearFileError(input);

                // Create error message element
                const errorDiv = document.createElement('div');
                errorDiv.className = 'alert alert-danger mt-2';
                errorDiv.innerHTML = `
                    <i class="fas fa-exclamation-triangle"></i>
                    ${message}
                `;

                // Insert after the upload box
                const uploadBox = input.previousElementSibling;
                uploadBox.parentNode.insertBefore(errorDiv, uploadBox.nextSibling);

                // Reset upload box styling
                uploadBox.querySelector('p:first-of-type').textContent = 'Click to upload document';
                uploadBox.style.borderColor = "#ddd";
                uploadBox.style.backgroundColor = "#fafafa";

                // Hide any preview
                const previewId = input.id === 'receipt' ? 'receiptPreview' : '';
                if (previewId) {
                    const preview = document.getElementById(previewId);
                    preview.style.display = "none";
                }
            }

            function clearFileError(input) {
                // Remove any existing error messages
                const existingError = input.parentNode.querySelector('.alert-danger');
                if (existingError) {
                    existingError.remove();
                }
            }

            // Enhance the existing previewImage function to include validation
            const originalPreviewImage = window.previewImage;
            window.previewImage = function(input, previewId) {
                const file = input.files[0];
                if (!file) return;

                // Validate before preview
                const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'application/pdf'];
                const maxSize = 10 * 1024 * 1024;

                if (!allowedTypes.includes(file.type)) {
                    showFileError(input, 'Invalid file type. Please upload only JPG, PNG, or PDF files.');
                    return;
                }

                if (file.size > maxSize) {
                    showFileError(input, 'File size exceeds 10MB limit. Please choose a smaller file.');
                    return;
                }

                // If validation passes, call original function
                if (originalPreviewImage) {
                    originalPreviewImage(input, previewId);
                }
            }
        });
    </script>
}