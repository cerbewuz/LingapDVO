    <!-- JS Scripts -->
    <script>
        // Function to show success modal and redirect
        function showSuccessModal() {
            const successModal = new bootstrap.Modal(document.getElementById('successModal'));
            successModal.show();

            let countdown = 2;
            const countdownElement = document.getElementById('countdown');
            const countdownInterval = setInterval(() => {
                countdown--;
                countdownElement.textContent = countdown;

                if (countdown <= 0) {
                    clearInterval(countdownInterval);
                    redirectToHomepage();
                }
            }, 1000);
        }

        // Function to redirect to homepage
        function redirectToHomepage() {
            window.location.href = '/Homepage';
        }

        // Function to check if form was submitted successfully and show modal
        function checkFormSubmission() {

            const urlParams = new URLSearchParams(window.location.search);
            const success = urlParams.get('success');

            @if (ViewBag.Success != null && ViewBag.Success == true)
            {
                            <text>
                            setTimeout(() => {
                                showSuccessModal();
                            }, 500); // Small delay to ensure page is fully loaded
                            </text>
            }

            // Alternative: Check for hidden field in form (if form posts to same page)
            const formSubmitted = document.querySelector('input[name="FormSubmitted"]');
            if (formSubmitted && formSubmitted.value === 'true') {
                setTimeout(() => {
                    showSuccessModal();
                }, 500);
            }
        }

        // Initialize when DOM is loaded
        document.addEventListener('DOMContentLoaded', function() {
            checkFormSubmission();
        });
    </script>
    <script>

        document.addEventListener('DOMContentLoaded', function() {
            // Make all preview images clickable to open modal
            const previewImages = document.querySelectorAll('.img-preview');
            const modalImage = document.getElementById('modalImage');
            const imageModal = new bootstrap.Modal(document.getElementById('imageModal'));
            const modalTitle = document.getElementById('imageModalLabel');
            const imageContainer = document.getElementById('imageContainer');
            const zoomPercentage = document.getElementById('zoomPercentage');
            const zoomInBtn = document.getElementById('zoomIn');
            const zoomOutBtn = document.getElementById('zoomOut');
            const zoomResetBtn = document.getElementById('zoomReset');

            // Zoom variables
            let currentZoom = 1;
            const zoomFactor = 0.1;
            const maxZoom = 3;
            const minZoom = 0.5;

            // Reset zoom on modal open
            function resetZoom() {
                currentZoom = 1;
                updateZoom();
            }

            // Apply zoom level
            function updateZoom() {
                modalImage.style.transform = `scale(${currentZoom})`;
                zoomPercentage.textContent = `${Math.round(currentZoom * 100)}%`;
            }

            // Zoom in function
            function zoomIn() {
                if (currentZoom < maxZoom) {
                    currentZoom += zoomFactor;
                    updateZoom();
                }
            }

            // Zoom out function
            function zoomOut() {
                if (currentZoom > minZoom) {
                    currentZoom -= zoomFactor;
                    updateZoom();
                }
            }

            // Make images clickable
            previewImages.forEach(img => {
                img.style.cursor = 'pointer';
                img.addEventListener('click', function() {
                    modalImage.src = this.src;
                    modalTitle.textContent = this.alt || 'Image Preview';
                    resetZoom();
                    imageModal.show();
                });
            });

            // Add zoom event listeners
            zoomInBtn.addEventListener('click', zoomIn);
            zoomOutBtn.addEventListener('click', zoomOut);
            zoomResetBtn.addEventListener('click', resetZoom);

            // Mouse wheel zoom
            imageContainer.addEventListener('wheel', function(e) {
                e.preventDefault();
                if (e.deltaY < 0) {
                    zoomIn();
                } else {
                    zoomOut();
                }
            });

            // Pan image when dragging
            let isDragging = false;
            let startX, startY, translateX = 0, translateY = 0;

            imageContainer.addEventListener('mousedown', function(e) {
                isDragging = true;
                startX = e.clientX - translateX;
                startY = e.clientY - translateY;
                imageContainer.style.cursor = 'grabbing';
            });

            window.addEventListener('mousemove', function(e) {
                if (!isDragging) return;

                translateX = e.clientX - startX;
                translateY = e.clientY - startY;

                // Only allow panning when zoomed in
                if (currentZoom > 1) {
                    modalImage.style.transform = `scale(${currentZoom}) translate(${translateX/currentZoom}px, ${translateY/currentZoom}px)`;
                }
            });

            window.addEventListener('mouseup', function() {
                isDragging = false;
                imageContainer.style.cursor = 'grab';
            });

            // Allow closing modal with ESC key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    imageModal.hide();
                }
            });

            // Reset zoom and position when modal is closed
            document.getElementById('imageModal').addEventListener('hidden.bs.modal', function() {
                resetZoom();
                translateX = 0;
                translateY = 0;
                modalImage.style.transform = 'scale(1) translate(0, 0)';
            });
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const sameAsPatientBtn = document.getElementById('sameAsPatientBtn');
            const clearAutoFillBtn = document.getElementById('clearAutoFillBtn');
            const toggleBtn = document.getElementById('toggleRequestorBtn');
            const requestorSection = document.getElementById('requestorDetailsSection');

            // Patient form fields
            const patientLastname = document.getElementById('Lastname');
            const patientFirstname = document.getElementById('Firstname');
            const patientMiddlename = document.getElementById('Middlename');
            const patientSuffix = document.getElementById('Suffix');
            const patientBlkLotStreet = document.getElementById('BlkLotStreet');
            const patientSubVill = document.getElementById('SubVill');
            const patientBrgy = document.getElementById('Brgy');
            const patientDistrict = document.getElementById('District');

            // Requestor form fields
            const requestorLastname = document.getElementById('RLastname');
            const requestorFirstname = document.getElementById('RFirstname');
            const requestorMiddlename = document.getElementById('RMiddlename');
            const requestorSuffix = document.getElementById('RSuffix');
            const requestorBlkLotStreet = document.getElementById('RBlkLotStreet');
            const requestorSubVill = document.getElementById('RSubVill');
            const requestorBrgy = document.getElementById('RBrgy');
            const requestorDistrict = document.getElementById('RDistrict');
            const relationshipPatient = document.getElementById('RelationshipPatient');

            // Store original values to restore on clear
            let originalRequestorValues = {};
            let autoFillUsed = false;

            // IMPROVED SHOW/HIDE TOGGLE FUNCTIONALITY
            if (toggleBtn && requestorSection) {
                toggleBtn.addEventListener('click', function() {
                    // Use getComputedStyle for reliable display detection
                    const isHidden = window.getComputedStyle(requestorSection).display === 'none';

                    if (isHidden) {
                        requestorSection.style.display = 'block';
                        toggleBtn.textContent = 'Hide Requestor Details';
                        toggleBtn.classList.remove('btn-outline-primary');
                        toggleBtn.classList.add('btn-primary');
                    } else {
                        requestorSection.style.display = 'none';
                        toggleBtn.textContent = 'Show Requestor Details';
                        toggleBtn.classList.remove('btn-primary');
                        toggleBtn.classList.add('btn-outline-primary');
                    }
                });
            }

            // "I am the patient" button functionality
            sameAsPatientBtn.addEventListener('click', function() {
                // Store original values before auto-filling
                storeOriginalValues();
                autoFillUsed = true;

                // Auto-fill requestor details with patient information
                if (patientLastname && patientLastname.value) requestorLastname.value = patientLastname.value;
                if (patientFirstname && patientFirstname.value) requestorFirstname.value = patientFirstname.value;
                if (patientMiddlename && patientMiddlename.value) requestorMiddlename.value = patientMiddlename.value;
                if (patientSuffix && patientSuffix.value) requestorSuffix.value = patientSuffix.value;
                if (patientBlkLotStreet && patientBlkLotStreet.value) requestorBlkLotStreet.value = patientBlkLotStreet.value;
                if (patientSubVill && patientSubVill.value) requestorSubVill.value = patientSubVill.value;
                if (patientBrgy && patientBrgy.value) requestorBrgy.value = patientBrgy.value;
                if (patientDistrict && patientDistrict.value) requestorDistrict.value = patientDistrict.value;

                // Set relationship to "Self"
                if (relationshipPatient) relationshipPatient.value = "Self";

                // Visual feedback with Tailwind
                sameAsPatientBtn.innerHTML = '<i class="bi bi-check-circle"></i> Details Copied!';
                sameAsPatientBtn.classList.remove('btn-outline-success', 'animate-pulse');
                sameAsPatientBtn.classList.add('btn-success', 'ring-2', 'ring-green-500');

                // Show clear button PERMANENTLY (never auto-hides)
                if (clearAutoFillBtn) {
                    clearAutoFillBtn.style.display = 'block';
                    clearAutoFillBtn.innerHTML = '<i class="bi bi-eraser"></i> Clear Auto-Fill';
                    clearAutoFillBtn.classList.remove('btn-warning', 'ring-2', 'ring-yellow-500');
                    clearAutoFillBtn.classList.add('btn-outline-warning');
                }

                // Auto-show requestor section
                if (requestorSection) {
                    requestorSection.style.display = 'block';
                    if (toggleBtn) {
                        toggleBtn.textContent = 'Hide Requestor Details';
                        toggleBtn.classList.remove('btn-outline-primary');
                        toggleBtn.classList.add('btn-primary');
                    }
                }

                // Reset main button after 2 seconds
                setTimeout(() => {
                    sameAsPatientBtn.innerHTML = '<i class="bi bi-person-check"></i> I am the patient';
                    sameAsPatientBtn.classList.remove('btn-success', 'ring-2', 'ring-green-500');
                    sameAsPatientBtn.classList.add('btn-outline-success');
                }, 2000);
            });

            // Clear button functionality - PERMANENT until manually clicked
            clearAutoFillBtn.addEventListener('click', function() {
                // Restore original values (clear all auto-filled data)
                restoreOriginalValues();

                // Reset the auto-fill flag
                autoFillUsed = false;

                // Visual feedback for clear
                clearAutoFillBtn.innerHTML = '<i class="bi bi-check-circle"></i> Cleared!';
                clearAutoFillBtn.classList.remove('btn-outline-warning');
                clearAutoFillBtn.classList.add('btn-warning', 'ring-2', 'ring-yellow-500');

                // Reset clear button after 1.5 seconds (but keep it visible)
                setTimeout(() => {
                    clearAutoFillBtn.innerHTML = '<i class="bi bi-eraser"></i> Clear Auto-Fill';
                    clearAutoFillBtn.classList.remove('btn-warning', 'ring-2', 'ring-yellow-500');
                    clearAutoFillBtn.classList.add('btn-outline-warning');

                    // Only hide if ALL fields are empty after clearing
                    const allFieldsEmpty = checkIfAllRequestorFieldsEmpty();
                    if (allFieldsEmpty) {
                        clearAutoFillBtn.style.display = 'none';
                    }
                    // Otherwise, keep it visible so user can clear again if needed
                }, 1500);
            });

            // Store original values function
            function storeOriginalValues() {
                const fields = [
                    'RLastname', 'RFirstname', 'RMiddlename', 'RSuffix',
                    'RBlkLotStreet', 'RSubVill', 'RBrgy', 'RDistrict', 'RelationshipPatient'
                ];

                originalRequestorValues = {}; // Reset storage
                fields.forEach(field => {
                    const element = document.getElementById(field);
                    if (element) {
                        originalRequestorValues[field] = element.value;
                    }
                });
            }

            // Restore original values function
            function restoreOriginalValues() {
                Object.keys(originalRequestorValues).forEach(field => {
                    const element = document.getElementById(field);
                    if (element) {
                        element.value = originalRequestorValues[field];
                    }
                });
            }

            // Check if all requestor fields are empty
            function checkIfAllRequestorFieldsEmpty() {
                const requestorFields = [
                    requestorLastname, requestorFirstname, requestorMiddlename,
                    requestorSuffix, requestorBlkLotStreet, requestorSubVill,
                    requestorBrgy, requestorDistrict, relationshipPatient
                ];

                return requestorFields.every(field => !field || !field.value.trim());
            }

            // Smart hint with Tailwind (optional - can remove if not needed)
            const patientFields = [patientLastname, patientFirstname, patientMiddlename];
            patientFields.forEach(field => {
                if (field) {
                    field.addEventListener('input', function() {
                        if (this.value &&
                            requestorLastname && !requestorLastname.value &&
                            requestorFirstname && !requestorFirstname.value &&
                            !autoFillUsed) {
                            sameAsPatientBtn.classList.add('ring-2', 'ring-green-500', 'animate-bounce');

                            setTimeout(() => {
                                sameAsPatientBtn.classList.remove('animate-bounce', 'ring-2', 'ring-green-500');
                            }, 3000);
                        }
                    });
                }
            });

            // Show clear button if page loads with pre-filled data
            function checkInitialState() {
                const anyFieldHasContent = !checkIfAllRequestorFieldsEmpty();
                if (anyFieldHasContent) {
                    storeOriginalValues();
                    autoFillUsed = true;
                    clearAutoFillBtn.style.display = 'block';
                }
            }

            // Run initial state check
            checkInitialState();
        });
    </script>

