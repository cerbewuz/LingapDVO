@model UseraccountDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>My Profile</title>
    <link rel="icon" type="image/x-icon" href="~/lingaplogo.ico">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        :root {
            --cobalt: #DC143C;
            --cobalt-dark: #b01030;
            --cobalt-light: #ffe6ea;
        }

        body {
            background-color: #f8f9fa;
            font-size: 0.95rem;
        }

        /* Go Back button styling for upper left */
        .go-back-top {
            position: fixed;
            left: 30px;
            top: 30px;
            z-index: 1000;
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 8px 16px;
            border-radius: 30px;
            background: rgba(255, 255, 255, 0.9);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            transition: all 0.2s;
            cursor: pointer;
            border: 1px solid #DC143C;
            color: #DC143C;
            text-decoration: none;
            font-weight: bold;
        }

            .go-back-top:hover, .go-back-top:focus {
                background: #DC143C;
                color: #fff !important;
                box-shadow: 0 4px 16px rgba(220, 20, 60, 0.15);
                transform: translateY(-2px);
                text-decoration: none;
            }

        .profile-container {
            background: white;
            border-radius: 10px;
            padding: clamp(1rem, calc(1rem + (100vw - 768px) * 0.01), 1.5rem);
            box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.1);
            max-width: 1000px;
            margin: 1rem auto;
        }

        .cobalt-text {
            color: var(--cobalt) !important;
        }

        .btn-cobalt {
            background-color: var(--cobalt);
            color: white;
            border: none;
        }

            .btn-cobalt:hover {
                background-color: var(--cobalt-dark);
                color: white;
            }

        .btn-outline-cobalt {
            border-color: var(--cobalt);
            color: var(--cobalt);
        }

            .btn-outline-cobalt:hover {
                background-color: var(--cobalt);
                color: white;
            }

        .profile-header {
            border-bottom: 2px solid var(--cobalt);
            padding-bottom: 1.25rem;
            margin-bottom: 1.5rem;
            position: relative;
        }

        .profile-icon {
            width: clamp(60px, calc(60px + (100vw - 768px) * 0.05), 80px);
            height: clamp(60px, calc(60px + (100vw - 768px) * 0.05), 80px);
            font-size: clamp(2rem, calc(2rem + (100vw - 768px) * 0.005), 2.5rem);
            background-color: var(--cobalt-light);
            color: var(--cobalt);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
        }

        .profile-section {
            margin-bottom: 1.5rem;
        }

        .profile-section-title {
            color: var(--cobalt);
            border-bottom: 1px solid #dee2e6;
            padding-bottom: 0.5rem;
            margin-bottom: 1rem;
            font-size: clamp(1rem, calc(1rem + (100vw - 576px) * 0.0005), 1.1rem);
        }

        .info-label {
            font-weight: bold;
            color: #495057;
            padding: clamp(0.25rem, calc(0.25rem + (100vw - 768px) * 0.001), 0.5rem) 0;
        }

        .info-value {
            color: #212529;
            word-break: break-word;
            padding: clamp(0.25rem, calc(0.25rem + (100vw - 768px) * 0.001), 0.5rem) 0;
        }

        .nav-tabs .nav-link.active {
            color: var(--cobalt);
            border-color: var(--cobalt);
            font-weight: bold;
        }

        .nav-tabs .nav-link {
            color: #495057;
            padding: 0.5rem 1rem;
            font-size: 0.9rem;
        }

            .nav-tabs .nav-link:hover {
                color: var(--cobalt);
                border-color: transparent;
            }

        /* Profile image upload styles */
        .profile-image-container {
            position: relative;
            display: inline-block;
        }

        .profile-image-edit {
            position: absolute;
            bottom: 0;
            right: 0;
            background-color: var(--cobalt);
            color: white;
            border-radius: 50%;
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            opacity: 0;
            transition: opacity 0.3s;
        }

        .profile-image-wrapper:hover .profile-image-edit {
            opacity: 1;
        }

        .profile-image-input {
            display: none;
        }

        /* Responsive styles using clamp() instead of @media queries */
        .profile-header h2 {
            font-size: clamp(1.5rem, calc(1.5rem + (100vw - 576px) * 0.005), 2rem);
        }

        .nav-tabs .nav-link {
            padding: clamp(0.5rem, calc(0.5rem + (100vw - 768px) * 0.001), 0.75rem);
            font-size: clamp(0.8rem, calc(0.8rem + (100vw - 768px) * 0.0005), 1rem);
        }

        .btn {
            padding: clamp(0.375rem, calc(0.375rem + (100vw - 768px) * 0.001), 0.5rem) clamp(0.75rem, calc(0.75rem + (100vw - 768px) * 0.002), 1rem);
            font-size: clamp(0.85rem, calc(0.85rem + (100vw - 768px) * 0.0003), 1rem);
        }
    </style>
</head>

<body>
    <div class="container py-3">
        <div class="profile-container">
            <div class="profile-header">
                <div class="row align-items-center text-center text-md-start">
                    <div class="col-12 col-md-3 text-center mb-3 mb-md-0">
                        <div class="profile-image-wrapper position-relative d-inline-block">
                            @if (!string.IsNullOrEmpty(ViewBag.Profilepicture))
                            {
                                <img src="~/UsersImg/@ViewBag.Profilepicture"
                                     class="profile-icon rounded-circle"
                                     id="profileImage"
                                     style="width: 80px; height: 80px; object-fit: cover;"
                                     alt="Profile Image">
                            }
                            else
                            {
                                <div class="profile-icon" id="profileImage">
                                    <i class="fas fa-user"></i>
                                </div>
                            }
                            <div class="profile-image-edit" id="editProfileImageBtn">
                                <i class="fas fa-camera"></i>
                            </div>
                        </div>
                        <h5 class="mb-1" id="profileName">@($"{ViewBag.Firstname} {ViewBag.Lastname}")</h5>
                        <p class="text-muted mb-2">Lingap user</p>
                    </div>

                    <div class="col-12 col-md-9">
                        <h2 class="cobalt-text mb-2">My Profile</h2>

                        <div class="row">
                            <div class="col-12 col-sm-6 mb-2 mb-sm-0">
                                <p class="mb-1">
                                    <i class="fas fa-envelope me-2 cobalt-text"></i>@ViewBag.Email
                                </p>

                                <p class="mb-1">
                                    <i class="fas fa-phone me-2 cobalt-text"></i>@ViewBag.Phonenumber
                                </p>
                            </div>
                            <div class="col-12 col-sm-6">
                                <p class="mb-1">
                                    <i class="fas fa-map-marker-alt me-2 cobalt-text"></i>
                                    <span id="locationField">
                                        @{
                                            var addressParts = new List<string>();

                                            if (!string.IsNullOrEmpty(ViewBag.BlkLotStreet))
                                            {
                                                addressParts.Add(ViewBag.BlkLotStreet);
                                            }

                                            if (!string.IsNullOrEmpty(ViewBag.SubVill))
                                            {
                                                addressParts.Add(ViewBag.SubVill);
                                            }

                                            if (!string.IsNullOrEmpty(ViewBag.Barangay))
                                            {
                                                addressParts.Add(ViewBag.Barangay);
                                            }

                                            if (!string.IsNullOrEmpty(ViewBag.District))
                                            {
                                                addressParts.Add($"District {ViewBag.District}");
                                            }

                                            // Join all non-empty parts with comma separation
                                            @string.Join(", ", addressParts)

                                            // Show a message if no address info is available
                                            if (addressParts.Count == 0)
                                            {
                                                <text>No address information available</text>
                                            }
                                        }
                                    </span>
                                </p>
                                <p class="mb-1">
                                    <i class="fas fa-birthday-cake me-2 cobalt-text"></i> <span id="birthdayField">@ViewBag.Dateofbirth</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <ul class="nav nav-tabs mb-3 flex-nowrap overflow-auto" id="profileTabs" role="tablist">
                <li class="nav-item flex-shrink-0" role="presentation">
                    <button class="nav-link active" id="personal-tab" data-bs-toggle="tab" data-bs-target="#personal"
                            type="button" role="tab">
                        <i class="fas fa-user me-1 d-md-none"></i>
                        <span class="d-none d-md-inline">Personal Info</span>
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="profileTabsContent">
                <div class="tab-pane fade show active" id="personal" role="tabpanel">
                    <form asp-action="Userprofile" asp-route-id="@ViewBag.Id" method="post" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="profile-section">
                                    <h4 class="profile-section-title">Basic Information</h4>

                                    <div class="row mb-2">
                                        <div class="form-group">
                                            <label class="form-label">Last Name</label>
                                            <input value="@ViewBag.Lastname" class="form-control mb-1" disabled />
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="form-group">
                                            <label class="form-label">First Name</label>
                                            <input value="@ViewBag.Firstname" class="form-control mb-1" disabled />
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="form-group">
                                            <label class="form-label">Middle Name</label>
                                            <input value="@ViewBag.Middlename" class="form-control mb-1" disabled />
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="form-group">
                                            <label class="form-label">Suffix</label>
                                            <input value="@ViewBag.Suffix" class="form-control mb-1" disabled />
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="form-group">
                                            <label class="form-label">Date of Birth</label>
                                            <input value="@ViewBag.Dateofbirth" type="date" class="form-control mb-1" disabled />
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="form-group">
                                            <label class="form-label">Gender</label>
                                            <input value="@ViewBag.Gender" class="form-control mb-1" disabled />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="profile-section">
                                    <h4 class="profile-section-title">Contact Information</h4>
                                    <div class="row mb-2">
                                        <div class="form-group">
                                            <label class="form-label">Email</label>
                                            <input value="@ViewBag.Email" class="form-control mb-1" disabled />
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="form-group">
                                            <label class="form-label">Phone Number</label>
                                            <input value="@ViewBag.Phonenumber" class="form-control mb-1" disabled />
                                        </div>
                                    </div>

                                    <div class="profile-section">
                                        <h4 class="profile-section-title">Address Information</h4>
                                        <div class="row mb-2">
                                            <div class="form-group">
                                                <label class="form-label">Blk / Lot / Street</label>
                                                <input value="@ViewBag.BlkLotStreet" class="form-control mb-1" disabled />
                                            </div>
                                        </div>

                                        <div class="row mb-2">
                                            <div class="form-group">
                                                <label class="form-label">Subdivision/Village</label>
                                                <input value="@ViewBag.SubVill" class="form-control mb-1" disabled />
                                            </div>
                                        </div>

                                        <div class="row mb-2">
                                            <div class="form-group">
                                                <label class="form-label">Barangay</label>
                                                <input value="@ViewBag.Barangay" class="form-control mb-1" disabled />
                                            </div>
                                        </div>

                                        <div class="row mb-2">
                                            <div class="form-group">
                                                <label class="form-label">District</label>
                                                <input value="@ViewBag.District" class="form-control mb-1" disabled />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="profile-section">
                            <h4 class="profile-section-title">Account Information</h4>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">Username</label>
                                        <input value="@ViewBag.Username" class="form-control mb-1" disabled />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">ID Type</label>
                                        <input value="@ViewBag.IDtype" class="form-control mb-1" disabled />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">ID Number</label>
                                        <input value="@ViewBag.IDnumber" class="form-control mb-1" disabled />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label class="form-label">Security Question</label>
                                        <input value="@ViewBag.SecurityQuestions" class="form-control mb-1" disabled />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <a asp-controller="Login" asp-action="Registeredit" class="btn btn-outline-secondary order-sm-1">
                                <i class="fas fa-save me-1"></i>Update info
                            </a>
                        </div>

                    </form>
                </div>

            </div>

            <div class="d-flex flex-column flex-sm-row justify-content-between mt-4 gap-2">
                <a href="javascript:void(0)" class="go-back-top" id="goBackBtn">
                    <i class="fas"></i> Go Back
                </a>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
                // Go Back button functionality
        goBackBtn.addEventListener('click', function() {
            window.history.back();
        });

        document.addEventListener('DOMContentLoaded', function () {
            // Initialize Bootstrap tabs
            var tabElms = document.querySelectorAll('button[data-bs-toggle="tab"]');
            tabElms.forEach(function (tabEl) {
                tabEl.addEventListener('click', function (event) {
                    event.preventDefault();
                    var tab = new bootstrap.Tab(tabEl);
                    tab.show();
                });
            });

            // Profile image upload functionality
            const profileImageInput = document.getElementById('profileImageInput');
            const editProfileImageBtn = document.getElementById('editProfileImageBtn');

            // Make the camera icon trigger the file input
            if (editProfileImageBtn) {
                editProfileImageBtn.addEventListener('click', function() {
                    if (profileImageInput) {
                        profileImageInput.click();
                    }
                });
            }

            // Handle image preview when a new image is selected
            if (profileImageInput) {
                profileImageInput.addEventListener('change', function(event) {
                    const file = event.target.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            const profileImage = document.getElementById('profileImage');
                            if (profileImage.tagName === 'IMG') {
                                profileImage.src = e.target.result;
                            } else {
                                // Replace the div with an img element
                                const newImg = document.createElement('img');
                                newImg.id = 'profileImage';
                                newImg.src = e.target.result;
                                newImg.className = 'profile-icon rounded-circle';
                                newImg.style.width = '80px';
                                newImg.style.height = '80px';
                                newImg.style.objectFit = 'cover';
                                newImg.alt = 'Profile Image';
                                profileImage.parentNode.replaceChild(newImg, profileImage);
                            }
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }
        });
    </script>
</body>
</html>