@model UseraccountDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>My Profile - LingapDVO</title>
    <link rel="icon" type="image/x-icon" href="~/Icon/lingaplogo.ico">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- Go Back Button CSS -->
    <link rel="stylesheet" href="~/css/go-back-button.css">

    <style>
        :root {
            --primary-color: #5B9BD5;
            --primary-light: #E7F3FF;
            --primary-dark: #2E75B6;
            --secondary-color: #78909C;
            --light-gray: #F5F7FA;
            --dark-gray: #37474F;
            --success-color: #66BB6A;
            --border-color: #E0E7ED;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: var(--light-gray);
            min-height: 100vh;
            padding: 20px;
        }

        .profile-container {
            max-width: 1000px;
            margin: 80px auto 40px;
        }

        .profile-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            border: 1px solid var(--border-color);
        }

        .profile-header {
            background: white;
            padding: 2rem;
            text-align: center;
            color: var(--dark-gray);
            border-bottom: 1px solid var(--border-color);
        }

        .profile-picture-container {
            position: relative;
            width: 100px;
            height: 100px;
            margin: 0 auto 1rem;
        }

        .profile-picture {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            border: 3px solid var(--primary-color);
            object-fit: cover;
            background: white;
        }

        .profile-picture-placeholder {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            border: 3px solid var(--primary-color);
            background: var(--primary-light);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            color: var(--primary-color);
        }

        .upload-picture-btn {
            position: absolute;
            bottom: 0;
            right: 0;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: var(--primary-color);
            color: white;
            border: 2px solid white;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
        }

            .upload-picture-btn:hover {
                background: var(--primary-dark);
                transform: scale(1.1);
            }

            .upload-picture-btn i {
                font-size: 0.75rem;
            }

        .remove-picture-btn {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #dc3545;
            color: white;
            border: 2px solid white;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
        }

            .remove-picture-btn:hover {
                background: #c82333;
                transform: scale(1.1);
            }

            .remove-picture-btn i {
                font-size: 0.7rem;
            }

        .profile-name {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 0.25rem;
            color: var(--dark-gray);
        }

        .profile-username {
            font-size: 0.95rem;
            color: var(--secondary-color);
        }

        .profile-body {
            padding: 2rem;
        }

        .section-title {
            font-size: 1rem;
            font-weight: 600;
            color: var(--dark-gray);
            margin-bottom: 1rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid var(--primary-light);
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .section-title i {
                color: var(--primary-color);
                font-size: 1.1rem;
            }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .info-item {
            background: var(--light-gray);
            padding: 1rem;
            border-radius: 8px;
            border-left: 3px solid var(--primary-color);
            transition: all 0.2s;
        }

            .info-item:hover {
                background: var(--primary-light);
            }

        .info-label {
            font-size: 0.75rem;
            font-weight: 500;
            color: var(--secondary-color);
            text-transform: uppercase;
            letter-spacing: 0.3px;
            margin-bottom: 0.25rem;
        }

        .info-value {
            font-size: 0.95rem;
            font-weight: 500;
            color: var(--dark-gray);
            word-break: break-word;
        }

        .verification-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 4px 10px;
            background: var(--success-color);
            color: white;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 500;
            margin-top: 6px;
        }

        .section-divider {
            height: 1px;
            background: var(--border-color);
            margin: 1.5rem 0;
        }

        @@media (max-width: 768px) {
            .profile-container {
                margin-top: 90px;
            }

            .profile-header {
                padding: 1.5rem;
            }

            .profile-name {
                font-size: 1.25rem;
            }

            .profile-body {
                padding: 1.5rem;
            }

            .info-grid {
                grid-template-columns: 1fr;
                gap: 0.75rem;
            }

            .section-title {
                font-size: 0.95rem;
            }
        }
    </style>
</head>

<body>
    <!-- Go Back Button -->
    <a href="#" class="go-back-btn" data-url="/Home">
        <i class="fas fa-arrow-left"></i>
        <span>Back</span>
    </a>

    <!-- Upload Confirmation Modal -->
    <div class="modal fade" id="confirmPictureModal" tabindex="-1" aria-labelledby="confirmPictureModalLabel" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 rounded-3 shadow-lg">
                <div class="modal-body p-4 text-center">
                    <div class="mb-3">
                        <img id="previewImage" src="" alt="Preview" style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 3px solid var(--primary-color);">
                    </div>
                    <h6 class="fw-semibold text-dark mb-2">Change Profile Picture?</h6>
                    <p class="text-muted small mb-4">This will replace your current profile picture.</p>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-secondary flex-fill" data-bs-dismiss="modal">
                            <i class="fas fa-times me-1"></i>Cancel
                        </button>
                        <button type="button" class="btn btn-primary flex-fill" id="confirmUploadBtn">
                            <i class="fas fa-check me-1"></i>Confirm
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Remove Confirmation Modal -->
    <div class="modal fade" id="confirmRemoveModal" tabindex="-1" aria-labelledby="confirmRemoveModalLabel" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 rounded-3 shadow-lg">
                <div class="modal-body p-4 text-center">
                    <div class="mb-3">
                        <i class="fas fa-exclamation-triangle text-danger" style="font-size: 3rem;"></i>
                    </div>
                    <h6 class="fw-semibold text-dark mb-2">Remove Profile Picture?</h6>
                    <p class="text-muted small mb-4">This will remove your profile picture and restore the default avatar.</p>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-secondary flex-fill" data-bs-dismiss="modal">
                            <i class="fas fa-times me-1"></i>Cancel
                        </button>
                        <button type="button" class="btn btn-danger flex-fill" id="confirmRemoveBtn">
                            <i class="fas fa-trash me-1"></i>Remove
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="profile-container">
        <div class="profile-card">
            <!-- Profile Header -->
            <div class="profile-header">
                <div class="profile-picture-container">
                    @if (!string.IsNullOrEmpty(ViewBag.Profilepicture))
                    {
                        <img src="@ViewBag.Profilepicture" alt="Profile Picture" class="profile-picture" id="profileImage">
                    }
                    else
                    {
                        <div class="profile-picture-placeholder" id="profileImage">
                            <i class="fas fa-user"></i>
                        </div>
                    }
                    <!-- Upload Button -->
                    <button type="button" class="upload-picture-btn" id="uploadBtn" title="Change profile picture">
                        <i class="fas fa-camera"></i>
                    </button>
                    <!-- Remove Button (only show if profile picture exists) -->
                    @if (!string.IsNullOrEmpty(ViewBag.Profilepicture))
                    {
                        <button type="button" class="remove-picture-btn" id="removeBtn" title="Remove profile picture">
                            <i class="fas fa-trash"></i>
                        </button>
                    }
                    <input type="file" id="profilePictureInput" accept="image/*" style="display: none;">
                </div>
                <h1 class="profile-name">
                    @ViewBag.Firstname @ViewBag.Middlename @ViewBag.Lastname
                    @if (!string.IsNullOrEmpty(ViewBag.Suffix))
                    {
                        <span>@ViewBag.Suffix</span>
                    }
                </h1>
                <p class="profile-username">@ViewBag.Email</p>
            </div>

            <!-- Profile Body -->
            <div class="profile-body">
                <!-- Personal Information -->
                <div class="section-title">
                    <i class="fas fa-user-circle"></i>
                    Personal Information
                </div>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">First Name</div>
                        <div class="info-value">@ViewBag.Firstname</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Middle Name</div>
                        <div class="info-value">@ViewBag.Middlename</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Last Name</div>
                        <div class="info-value">@ViewBag.Lastname</div>
                    </div>
                    @if (!string.IsNullOrEmpty(ViewBag.Suffix))
                    {
                        <div class="info-item">
                            <div class="info-label">Suffix</div>
                            <div class="info-value">@ViewBag.Suffix</div>
                        </div>
                    }
                    <div class="info-item">
                        <div class="info-label">Gender</div>
                        <div class="info-value">@ViewBag.Gender</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Date of Birth</div>
                        <div class="info-value">@ViewBag.Dateofbirth</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Civil Status</div>
                        <div class="info-value">@ViewBag.CivilStatus</div>
                    </div>
                </div>

                <div class="section-divider"></div>

                <!-- ID Information -->
                <div class="section-title">
                    <i class="fas fa-id-badge"></i>
                    Identification Information
                </div>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">ID Type</div>
                        <div class="info-value">@ViewBag.IDtype</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">ID Number</div>
                        <div class="info-value">@ViewBag.IDnumber</div>
                        <span class="verification-badge">
                            <i class="fas fa-check-circle"></i>
                            Verified
                        </span>
                    </div>
                </div>

                <div class="section-divider"></div>

                <!-- Address Information -->
                <div class="section-title">
                    <i class="fas fa-map-marker-alt"></i>
                    Address Information
                </div>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Block/Lot/Street</div>
                        <div class="info-value">@ViewBag.BlkLotStreet</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Subdivision/Village</div>
                        <div class="info-value">@ViewBag.SubVill</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Barangay</div>
                        <div class="info-value">@ViewBag.Barangay</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">District</div>
                        <div class="info-value">@ViewBag.District</div>
                    </div>
                </div>

                <div class="section-divider"></div>

                <!-- Contact Information -->
                <div class="section-title">
                    <i class="fas fa-address-book"></i>
                    Contact Information
                </div>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Email Address</div>
                        <div class="info-value">@ViewBag.Email</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Phone Number</div>
                        <div class="info-value">@ViewBag.Phonenumber</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Go Back Button Behavior -->
    <script src="~/js/go-back-button.js"></script>

    <!-- Profile Picture Upload Script -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const uploadBtn = document.getElementById('uploadBtn');
            const fileInput = document.getElementById('profilePictureInput');
            const profileImage = document.getElementById('profileImage');
            const confirmModal = new bootstrap.Modal(document.getElementById('confirmPictureModal'));
            const previewImage = document.getElementById('previewImage');
            const confirmUploadBtn = document.getElementById('confirmUploadBtn');
            let selectedFile = null;
            let previewDataUrl = null;

            // Click upload button to trigger file input
            uploadBtn.addEventListener('click', function() {
                fileInput.click();
            });

            // Handle file selection
            fileInput.addEventListener('change', function(e) {
                const file = e.target.files[0];
                if (!file) return;

                // Validate file type
                if (!file.type.startsWith('image/')) {
                    alert('Please select an image file.');
                    fileInput.value = '';
                    return;
                }

                // Validate file size (max 5MB)
                if (file.size > 5 * 1024 * 1024) {
                    alert('File size must be less than 5MB.');
                    fileInput.value = '';
                    return;
                }

                // Store the file
                selectedFile = file;

                // Read and show preview in modal
                const reader = new FileReader();
                reader.onload = function(event) {
                    previewDataUrl = event.target.result;
                    previewImage.src = previewDataUrl;
                    confirmModal.show();
                };
                reader.readAsDataURL(file);
            });

            // Handle confirm button
            confirmUploadBtn.addEventListener('click', function() {
                if (!selectedFile) return;

                // Close modal
                confirmModal.hide();

                // Update profile image preview
                if (profileImage.tagName === 'IMG') {
                    profileImage.src = previewDataUrl;
                } else {
                    // Replace placeholder with image
                    const img = document.createElement('img');
                    img.src = previewDataUrl;
                    img.alt = 'Profile Picture';
                    img.className = 'profile-picture';
                    img.id = 'profileImage';
                    profileImage.parentNode.replaceChild(img, profileImage);
                }

                // Upload the image
                uploadProfilePicture(selectedFile);

                // Reset
                selectedFile = null;
                previewDataUrl = null;
                fileInput.value = '';
            });

            // Reset on modal close
            document.getElementById('confirmPictureModal').addEventListener('hidden.bs.modal', function() {
                if (selectedFile) {
                    fileInput.value = '';
                    selectedFile = null;
                    previewDataUrl = null;
                }
            });

            function uploadProfilePicture(file) {
                const formData = new FormData();
                formData.append('profilePicture', file);

                // Show loading state
                uploadBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                uploadBtn.disabled = true;

                fetch('/Dashboard/UploadProfilePicture', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        console.log('? Profile picture uploaded successfully');
                        // Reload page to update all instances
                        setTimeout(() => {
                            location.reload();
                        }, 500);
                    } else {
                        alert('Failed to upload profile picture: ' + (data.message || 'Unknown error'));
                        console.error('? Upload failed:', data.message);
                    }
                })
                .catch(error => {
                    alert('Error uploading profile picture. Please try again.');
                    console.error('? Upload error:', error);
                })
                .finally(() => {
                    // Restore button state
                    uploadBtn.innerHTML = '<i class="fas fa-camera"></i>';
                    uploadBtn.disabled = false;
                });
            }

            // Handle remove profile picture
            const removeBtn = document.getElementById('removeBtn');
            if (removeBtn) {
                const removeModal = new bootstrap.Modal(document.getElementById('confirmRemoveModal'));
                const confirmRemoveBtn = document.getElementById('confirmRemoveBtn');

                // Show confirmation modal when remove button is clicked
                removeBtn.addEventListener('click', function() {
                    removeModal.show();
                });

                // Handle confirm remove
                confirmRemoveBtn.addEventListener('click', function() {
                    removeModal.hide();

                    // Show loading state on remove button
                    removeBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                    removeBtn.disabled = true;

                    // Call remove endpoint
                    fetch('/Dashboard/RemoveProfilePicture', {
                        method: 'POST'
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            console.log('? Profile picture removed successfully');
                            // Reload page to update all instances
                            setTimeout(() => {
                                location.reload();
                            }, 500);
                        } else {
                            alert('Failed to remove profile picture: ' + (data.message || 'Unknown error'));
                            console.error('? Remove failed:', data.message);
                        }
                    })
                    .catch(error => {
                        alert('Error removing profile picture. Please try again.');
                        console.error('? Remove error:', error);
                    })
                    .finally(() => {
                        // Restore button state
                        removeBtn.innerHTML = '<i class="fas fa-trash"></i>';
                        removeBtn.disabled = false;
                    });
                });
            }
        });
    </script>

    @* Session Timeout *@
    @await Html.PartialAsync("_SessionTimeout")
</body>

</html>