@model HospitalAssistanceDto
@{
    Layout = "_ViewFormsLayout";
    ViewData["Title"] = "Hospital Assistance View";
    var selectedSex = ViewData["Sex"]?.ToString();
    var checkedAssistance = ViewData["CheckedAssistance"] as Dictionary<string, string> ?? new();
    var checkedCMO = ViewData["CheckedCMOPERSONNEL"] as Dictionary<string, string> ?? new Dictionary<string, string>();
}

<div class="receipt-container">
    <form asp-action="HospitalAssistanceView" enctype="multipart/form-data" method="post" id="statusForm">
        <input type="hidden" id="statusInput" name="status2" value="@ViewData["Status"]">
        <input type="hidden" id="commentsInput" name="Comments" value="@ViewData["Comments"]">

        <div class="receipt-body">
            <!-- Patient Information -->
            <div class="receipt-section">
                <h5 class="section-title">Patient Information</h5>
                <div class="row">
                    <div class="col-md-6">
                        <div class="info-row">
                            <div class="info-label">Name:</div>
                            <div class="info-value">
                                @ViewData["Firstname"] @ViewData["Middlename"] @ViewData["Lastname"]
                                @(ViewData["Suffix"]?.ToString() == "None" ? "" : " " + ViewData["Suffix"])
                            </div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Address:</div>
                            <div class="info-value">@ViewData["BlkLotStreet"], @ViewData["SubVill"], @ViewData["Brgy"], @ViewData["District"]</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Sex:</div>
                            <div class="info-value">@ViewData["Sex"]</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="info-row">
                            <div class="info-label">Date of Birth:</div>
                            <div class="info-value">@ViewData["Dateofbirth"]</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Age:</div>
                            <div class="info-value">@ViewData["Age"]</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">PhilHealth:</div>
                            <div class="info-value">@ViewData["PhilHealth"]</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">PhilHealth No:</div>
                            <div class="info-value">@ViewData["PhilHealthNo"]</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Requestor Details -->
            <div class="receipt-section">
                <h5 class="section-title">Requestor's Details</h5>
                <div class="info-row">
                    <div class="info-label">Full Name:</div>
                    <div class="info-value">@ViewData["RLastname"], @ViewData["RFirstname"] @ViewData["RMiddlename"] @ViewData["RSuffix"]</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Address:</div>
                    <div class="info-value">@ViewData["RBlkLotStreet"], @ViewData["RSubVill"], @ViewData["RBrgy"], @ViewData["RDistrict"]</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Relationship to Patient:</div>
                    <div class="info-value">@ViewData["RelationshipPatient"]</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Contact No:</div>
                    <div class="info-value">@ViewData["ContactNo"]</div>
                </div>
            </div>

            <!-- Assistance Requested -->
            <div class="receipt-section">
                <h5 class="section-title">Assistance Requested</h5>
                <div class="info-value">@ViewData["Typeassistance"]</div>
            </div>

            <!-- Valid ID Section -->
            <div class="receipt-section">
                <h5 class="section-title">Valid ID</h5>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <h6>Front ID</h6>
                        @if (ViewData["ValidfrontimageBase64"] != null)
                        {
                            <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["ValidfrontimageBase64"]')">
                                <img src="data:image/jpeg;base64,@ViewData["ValidfrontimageBase64"]" alt="Front ID" class="id-image" />
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No front ID image available</p>
                        }
                    </div>
                    <div class="col-md-6 mb-3">
                        <h6>Back ID</h6>
                        @if (ViewData["ValidBackimageBase64"] != null)
                        {
                            <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["ValidBackimageBase64"]')">
                                <img src="data:image/jpeg;base64,@ViewData["ValidBackimageBase64"]" alt="Back ID" class="id-image" />
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No back ID image available</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Doctor Prescription -->
            @if (ViewData["DoctorPrescriptionBase64"] != null)
            {
                <div class="receipt-section">
                    <h5 class="section-title">Doctor Prescription</h5>
                    @if (ViewData["IsDoctorPrescriptionPdf"] != null && (bool)ViewData["IsDoctorPrescriptionPdf"])
                    {
                        <div class="pdf-container">
                            <div class="pdf-preview" onclick="viewPDFInModal('@ViewData["DoctorPrescription"]', 'doctorprescription', 'Doctor Prescription')">
                                <div class="pdf-icon"><i class="bi bi-file-earmark-pdf"></i></div>
                                <div class="pdf-info">
                                    <span class="pdf-filename">@ViewData["DoctorPrescription"]</span>
                                    <span class="pdf-label">Click to view PDF</span>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["DoctorPrescriptionBase64"]')">
                            <img src="data:image/jpeg;base64,@ViewData["DoctorPrescriptionBase64"]" alt="Doctor Prescription" class="id-image" />
                        </div>
                    }
                </div>
            }

            <!-- Medical Certificate -->
            @if (ViewData["MedicalCertificateBase64"] != null)
            {
                <div class="receipt-section">
                    <h5 class="section-title">Medical Certificate</h5>
                    @if (ViewData["IsMedicalCertificatePdf"] != null && (bool)ViewData["IsMedicalCertificatePdf"])
                    {
                        <div class="pdf-container">
                            <div class="pdf-preview" onclick="viewPDFInModal('@ViewData["MedicalCertificate"]', 'medicalcertificate', 'Medical Certificate')">
                                <div class="pdf-icon"><i class="bi bi-file-earmark-pdf"></i></div>
                                <div class="pdf-info">
                                    <span class="pdf-filename">@ViewData["MedicalCertificate"]</span>
                                    <span class="pdf-label">Click to view PDF</span>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["MedicalCertificateBase64"]')">
                            <img src="data:image/jpeg;base64,@ViewData["MedicalCertificateBase64"]" alt="Medical Certificate" class="id-image" />
                        </div>
                    }
                </div>
            }

            <!-- Death Certificate -->
            @if (ViewData["DeathCertificateBase64"] != null)
            {
                <div class="receipt-section">
                    <h5 class="section-title">Death Certificate</h5>
                    @if (ViewData["IsDeathCertificatePdf"] != null && (bool)ViewData["IsDeathCertificatePdf"])
                    {
                        <div class="pdf-container">
                            <div class="pdf-preview" onclick="viewPDFInModal('@ViewData["DeathCertificate"]', 'deathcertificate', 'Death Certificate')">
                                <div class="pdf-icon"><i class="bi bi-file-earmark-pdf"></i></div>
                                <div class="pdf-info">
                                    <span class="pdf-filename">@ViewData["DeathCertificate"]</span>
                                    <span class="pdf-label">Click to view PDF</span>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["DeathCertificateBase64"]')">
                            <img src="data:image/jpeg;base64,@ViewData["DeathCertificateBase64"]" alt="Death Certificate" class="id-image" />
                        </div>
                    }
                </div>
            }

        </div>

    </form>
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        // Configure PDF.js worker
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

        // PDF Viewer Variables
        let currentPDF = null;
        let currentPage = 1;
        let totalPages = 1;
        let currentScale = 1.2;

        // Image Zoom Functionality
        function zoomImage(src) {
            const modal = document.getElementById("zoomModal");
            const modalImg = document.getElementById("zoomedImage");
            modal.style.display = "block";
            modalImg.src = src;
        }

        // Close zoom modal
        document.querySelector(".close-zoom").onclick = function() {
            document.getElementById("zoomModal").style.display = "none";
        }

        // PDF Viewer Function
        async function viewPDFInModal(fileName, fileType, displayName) {
            const modal = document.getElementById('pdfViewerModal');
            const title = document.getElementById('pdfViewerTitle');
            const loading = document.getElementById('pdfLoading');
            const errorDiv = document.getElementById('pdfError');
            const canvas = document.getElementById('pdfCanvas');
            const context = canvas.getContext('2d');
            const currentPageSpan = document.getElementById('currentPage');
            const totalPagesSpan = document.getElementById('totalPages');
            const zoomLevelSpan = document.getElementById('zoomLevel');
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');

            title.textContent = displayName || 'PDF Document';
            modal.style.display = 'block';
            loading.style.display = 'flex';
            errorDiv.style.display = 'none';
            canvas.style.display = 'none';

            currentPDF = null;
            currentPage = 1;
            currentScale = 1.2;

            try {
                const encodedFileName = encodeURIComponent(fileName);
                const url = '@Url.Action("ViewPDF", "Adminuser")?fileName=' + encodedFileName + '&fileType=' + fileType + '&t=' + Date.now();

                const response = await fetch(url);
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const pdfData = await response.arrayBuffer();
                if (!pdfData || pdfData.byteLength === 0) {
                    throw new Error('PDF data is empty');
                }

                const loadingTask = pdfjsLib.getDocument({ data: pdfData });
                currentPDF = await loadingTask.promise;

                totalPages = currentPDF.numPages;
                totalPagesSpan.textContent = totalPages;
                currentPageSpan.textContent = currentPage;

                updateNavigationButtons();
                await renderPage(currentPage);

                loading.style.display = 'none';
                canvas.style.display = 'block';
                zoomLevelSpan.textContent = Math.round(currentScale * 100) + '%';

            } catch (error) {
                console.error('Error loading PDF:', error);
                loading.style.display = 'none';
                errorDiv.style.display = 'block';
                errorDiv.querySelector('p').textContent = `Error loading PDF: ${error.message}`;
            }
        }

        // Render specific page
        async function renderPage(pageNum) {
            if (!currentPDF) return;

            const canvas = document.getElementById('pdfCanvas');
            const context = canvas.getContext('2d');
            const currentPageSpan = document.getElementById('currentPage');

            try {
                const page = await currentPDF.getPage(pageNum);
                const viewport = page.getViewport({ scale: currentScale });

                canvas.height = viewport.height;
                canvas.width = viewport.width;

                const renderContext = {
                    canvasContext: context,
                    viewport: viewport
                };

                await page.render(renderContext).promise;
                currentPageSpan.textContent = pageNum;

            } catch (error) {
                console.error('Error rendering page:', error);
            }
        }

        // Navigation functions
        function nextPage() {
            if (currentPage < totalPages) {
                currentPage++;
                renderPage(currentPage);
                updateNavigationButtons();
            }
        }

        function prevPage() {
            if (currentPage > 1) {
                currentPage--;
                renderPage(currentPage);
                updateNavigationButtons();
            }
        }

        function zoomIn() {
            currentScale += 0.2;
            renderPage(currentPage);
            document.getElementById('zoomLevel').textContent = Math.round(currentScale * 100) + '%';
        }

        function zoomOut() {
            if (currentScale > 0.5) {
                currentScale -= 0.2;
                renderPage(currentPage);
                document.getElementById('zoomLevel').textContent = Math.round(currentScale * 100) + '%';
            }
        }

        function updateNavigationButtons() {
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');

            prevBtn.disabled = currentPage <= 1;
            nextBtn.disabled = currentPage >= totalPages;
        }

        // Close PDF Viewer
        function closePDFViewer() {
            const modal = document.getElementById('pdfViewerModal');
            modal.style.display = 'none';

            if (currentPDF) {
                currentPDF.destroy();
                currentPDF = null;
            }
        }

        // Status Submission Functions
        function submitApproved() {
            document.getElementById('statusInput').value = 'Approved';
            document.getElementById('commentsInput').value = document.getElementById('idFrontDescription').value;
            document.getElementById('statusForm').submit();
        }

        function showCommentsModal() {
            document.getElementById('commentsModal').style.display = 'block';
            document.getElementById('commentsTextarea').focus();
        }

        function closeCommentsModal() {
            document.getElementById('commentsModal').style.display = 'none';
            document.getElementById('commentsTextarea').value = '';
            document.getElementById('commentsTextarea').classList.remove('is-invalid');
        }

        function submitDisapproved() {
            const commentsTextarea = document.getElementById('commentsTextarea');
            const comments = commentsTextarea.value.trim();

            if (comments === '') {
                commentsTextarea.classList.add('is-invalid');
                commentsTextarea.focus();
                return;
            }

            document.getElementById('statusInput').value = 'Disapproved';
            document.getElementById('commentsInput').value = comments;
            document.getElementById('statusForm').submit();
        }

        // CMO Reflection Auto-generation
        document.addEventListener('DOMContentLoaded', function() {
            const cmoCheckboxes = document.querySelectorAll('.supporting-doc');
            cmoCheckboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    if (this.checked) {
                        cmoCheckboxes.forEach(cb => {
                            if (cb !== this) cb.checked = false;
                        });
                    }
                    updateReflection();
                });
            });

            function updateReflection() {
                const billInput = document.getElementById('billAmountInput');
                const cmoNotes = document.getElementById('cmoNotesInput');
                const reflectionField = document.getElementById('cmoReflectionField');
                const docCheckboxes = document.querySelectorAll('.supporting-doc');

                let parts = [];
                if (billInput.value.trim()) {
                    parts.push(`Bill: ${billInput.value.trim()}`);
                }
                const checkedDocs = [];
                docCheckboxes.forEach(cb => {
                    if (cb.checked) checkedDocs.push(cb.value);
                });
                if (checkedDocs.length) {
                    parts.push(`Docs: ${checkedDocs.join(', ')}`);
                }
                if (cmoNotes.value.trim()) {
                    parts.push(`Others: ${cmoNotes.value.trim()}`);
                }
                reflectionField.value = parts.join(' , ');
            }

            const billInput = document.getElementById('billAmountInput');
            const cmoNotes = document.getElementById('cmoNotesInput');
            if (billInput) billInput.addEventListener('input', updateReflection);
            if (cmoNotes) cmoNotes.addEventListener('input', updateReflection);
            updateReflection();
        });

        // Keyboard shortcuts and navigation
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.getElementById("zoomModal").style.display = "none";
                closePDFViewer();
                closeCommentsModal();
            }

            const pdfModal = document.getElementById('pdfViewerModal');
            if (pdfModal.style.display === 'block') {
                switch(e.key) {
                    case 'ArrowLeft':
                        e.preventDefault();
                        prevPage();
                        break;
                    case 'ArrowRight':
                        e.preventDefault();
                        nextPage();
                        break;
                    case '+':
                    case '=':
                        e.preventDefault();
                        zoomIn();
                        break;
                    case '-':
                        e.preventDefault();
                        zoomOut();
                        break;
                }
            }
        });

        // Close modal when clicking outside
        window.onclick = function(event) {
            const zoomModal = document.getElementById("zoomModal");
            const pdfModal = document.getElementById("pdfViewerModal");
            const commentsModal = document.getElementById("commentsModal");

            if (event.target == zoomModal) {
                zoomModal.style.display = "none";
            }
            if (event.target == pdfModal) {
                closePDFViewer();
            }
            if (event.target == commentsModal) {
                closeCommentsModal();
            }
        }
    </script>
}