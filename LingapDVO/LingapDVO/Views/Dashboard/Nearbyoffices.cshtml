@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nearby Branches</title>
    <link rel="icon" type="image/x-icon" href="~/Icon/lingaplogo.ico">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/go-back-button.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    @await Html.PartialAsync("_SessionTimeout")

    <style>
        :root {
            --primary-color: #16496B;
            --secondary-color: #858796;
            --success-color: #1cc88a;
            --info-color: #36b9cc;
            --warning-color: #f6c23e;
            --danger-color: #e74a3b;
            --dark-color: #5a5c69;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f8f9fc;
        }

        .container {
            max-width: 1200px;
            margin: 30px auto;
            padding: 20px;
        }

        /* Navigation Menu Styles */
        .nav-menu-wrapper {
            background: white;
            border-radius: 15px;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

        .nav-menu {
            display: flex;
            justify-content: center;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .nav-menu-item {
            padding: 0.75rem 2rem;
            background: #f8f9fc;
            border: 2px solid transparent;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 600;
            font-size: 1rem;
            color: var(--dark-color);
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .nav-menu-item:hover {
            background: #e3f2fd;
            border-color: var(--primary-color);
        }

        .nav-menu-item.active {
            background: var(--primary-color);
            color: white;
            border-color: var(--primary-color);
        }

        .nav-menu-item i {
            font-size: 1.2rem;
        }

        /* Content Section Styles */
        .content-section {
            display: none;
        }

        .content-section.active {
            display: block;
            animation: fadeIn 0.4s ease-in;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        h2 {
            text-align: center;
            margin-bottom: 25px;
            font-size: 28px;
            color: var(--dark-color);
            font-weight: 700;
        }

        .section-title {
            background: var(--primary-color);
            color: white;
            padding: 12px 15px;
            border-radius: 6px;
            margin-top: 30px;
            margin-bottom: 15px;
            font-size: 20px;
            font-weight: bold;
        }

        .table-wrapper {
            overflow-x: auto;
            margin-top: 10px;
            border-radius: 10px;
            background: white;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: #ffffff;
        }

        th {
            background: var(--primary-color);
            color: white;
            padding: 12px;
            text-align: left;
            font-size: 14px;
        }

        td {
            padding: 12px;
            border-bottom: 1px solid #dcdcdc;
            font-size: 14px;
            vertical-align: top;
        }

        tr:last-child td {
            border-bottom: none;
        }

        .office-name {
            font-weight: bold;
            font-size: 15px;
            color: var(--primary-color);
        }

        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
            transition: transform 0.2s;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .btn-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .category-title {
            position: relative;
            margin: 2rem 0 1.5rem;
            color: var(--dark-color);
        }

        .category-title:after {
            content: "";
            position: absolute;
            left: 50%;
            bottom: -10px;
            transform: translateX(-50%);
            width: 80px;
            height: 3px;
            background: var(--primary-color);
            border-radius: 3px;
        }

        .location-card .card-body {
            padding: 1.5rem;
        }

        .location-icon {
            font-size: 1.75rem;
            margin-bottom: 1rem;
        }

        /* Responsive Styles */
        @@media (max-width: 768px) {
            .nav-menu {
                flex-direction: column;
                gap: 0.5rem;
            }

            .nav-menu-item {
                padding: 0.75rem 1rem;
                font-size: 0.95rem;
                justify-content: center;
            }

            h2 {
                font-size: 22px;
            }

            .section-title {
                font-size: 18px;
            }

            th, td {
                font-size: 13px;
                padding: 10px;
            }
        }

        @@media (max-width: 480px) {
            .nav-menu-item {
                padding: 0.6rem 0.8rem;
                font-size: 0.9rem;
            }

            .container {
                padding: 15px;
            }
        }
    </style>
</head>

<body>

    <!-- Go Back Button -->
    <a href="#" class="go-back-btn" data-url="/Home">
