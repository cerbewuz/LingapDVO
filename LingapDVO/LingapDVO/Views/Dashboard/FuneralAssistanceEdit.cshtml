@model FuneralAssistanceDto
@{
    Layout = "_EditFormsLayout";
    ViewData["Title"] = "Edit Funeral Assistance";
    var checkedAssistance = ViewData["CheckedAssistance"] as Dictionary<string, string> ?? new();
    var selectedSex = ViewData["Sex"]?.ToString();
}

<style>
    /* Edit Form Specific Styles */
    .form-section {
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #dee2e6;
    }

    .section-header {
        color: var(--primary-color);
        font-weight: 600;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--primary-light);
    }

    .form-label {
        font-weight: 500;
        margin-bottom: 0.5rem;
        color: #333;
    }

    .required-field:after {
        content: " *";
        color: #dc3545;
    }

    .upload-box {
        border: 2px dashed #ddd;
        border-radius: 8px;
        padding: 2rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        background-color: #fafafa;
    }

        .upload-box:hover {
            border-color: var(--primary-color);
            background-color: var(--primary-light);
        }

    /* Current Uploaded Document Box */
    .current-document-box {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        background-color: #fff;
    }

    .current-document-header {
        background-color: #f8f9fa;
        padding: 0.75rem 1rem;
        font-weight: 600;
        color: #495057;
        border-bottom: 1px solid #dee2e6;
    }

        .current-document-header i {
            margin-right: 0.5rem;
            color: var(--primary-color);
        }

    .current-document-body {
        padding: 1rem;
    }

    .current-document-name {
        margin-bottom: 0.75rem;
        color: #333;
    }

    .document-preview-container {
        position: relative;
        cursor: pointer;
        transition: transform 0.2s;
        display: inline-block;
        width: 100%;
    }

        .document-preview-container:hover {
            transform: scale(1.02);
        }

        .document-preview-container:hover .preview-overlay {
            opacity: 1;
        }

    .preview-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(0, 0, 0, 0.7);
        color: white;
        padding: 0.5rem;
        text-align: center;
        opacity: 0;
        transition: opacity 0.3s;
        border-radius: 0 0 5px 5px;
    }

    /* Reupload Document Box */
    .reupload-document-box {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow: hidden;
        background-color: #fff;
    }

    .reupload-document-header {
        background-color: #e3f2fd;
        padding: 0.75rem 1rem;
        font-weight: 600;
        color: #1565c0;
        border-bottom: 1px solid #bbdefb;
    }

        .reupload-document-header i {
            margin-right: 0.5rem;
        }

    .reupload-document-body {
        padding: 1rem;
    }

    .upload-area {
        border: 2px dashed #90caf9;
        border-radius: 8px;
        padding: 2rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        background-color: #f5f9ff;
    }

        .upload-area:hover {
            border-color: #1565c0;
            background-color: #e3f2fd;
        }

        .upload-area .upload-icon {
            font-size: 3rem;
            color: #1565c0;
            margin-bottom: 1rem;
        }

        .upload-area .upload-text {
            color: #1565c0;
            font-weight: 500;
            margin-bottom: 0.5rem;
        }

    /* Reupload Preview Section - Merged with Upload Area */
    .reupload-preview-section {
        border: 2px solid #4caf50;
        border-radius: 8px;
        overflow: hidden;
        background-color: #f1f8e9;
    }

    .reupload-preview-header {
        background-color: #e8f5e9;
        padding: 0.75rem 1rem;
        font-weight: 600;
        color: #2e7d32;
        border-bottom: 1px solid #c8e6c9;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .reupload-preview-body {
        padding: 1rem;
        background-color: #fff;
    }

    .reupload-file-name {
        font-weight: 600;
        color: #333;
        margin-bottom: 0.75rem;
        word-break: break-all;
    }

    .reupload-change-btn {
        background-color: #1565c0;
        color: white;
        border: none;
        padding: 0.4rem 0.8rem;
        border-radius: 4px;
        font-size: 0.85rem;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .reupload-change-btn:hover {
        background-color: #0d47a1;
    }

    .pdf-preview-container .pdf-preview {
        cursor: pointer;
    }

    .upload-icon {
        font-size: 3rem;
        color: #6c757d;
        margin-bottom: 1rem;
    }

    .form-note {
        font-size: 0.85rem;
        color: #6c757d;
        margin-top: 0.5rem;
    }

    .btn-submit {
        background-color: #0DDE0B;
        color: white;
        padding: 0.75rem 2rem;
        font-weight: 600;
        border-radius: 5px;
        border: none;
        transition: all 0.3s ease;
    }

        .btn-submit:hover {
            background-color: #0BC50A;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        }

    .current-file {
        background-color: var(--primary-light);
        padding: 8px 12px;
        border-radius: 5px;
        margin-bottom: 10px;
        border-left: 4px solid var(--primary-color);
    }

    .img-preview {
        width: 100%;
        max-width: 100%;
        height: auto;
        max-height: 300px;
        margin-top: 10px;
        border: 1px solid #ddd;
        border-radius: 5px;
        object-fit: contain;
        display: none;
    }

    .file-status {
        margin-top: 5px;
        font-size: 0.85rem;
    }

    .file-success {
        color: #28a745;
    }

    .file-error {
        color: #dc3545;
    }

    /* Success Modal Styles */
    #successModal .modal-content {
        border-radius: 12px;
        border: none;
    }

    #successModal .modal-body {
        padding: 2rem;
    }

    .modal.fade .modal-dialog {
        transform: scale(0.8);
        transition: transform 0.3s ease-out;
    }

    .modal.show .modal-dialog {
        transform: scale(1);
    }

    /* Image Zoom Modal */
    .zoom-modal {
        display: none;
        position: fixed;
        z-index: 1000;
        padding-top: 50px;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.9);
    }

    .zoom-modal-content {
        margin: auto;
        display: block;
        max-width: 90%;
        max-height: 90%;
    }

    .close-zoom {
        position: absolute;
        top: 15px;
        right: 35px;
        color: #fff;
        font-size: 40px;
        font-weight: bold;
        cursor: pointer;
    }

    .document-preview-container {
        cursor: pointer;
        transition: transform 0.2s;
        margin-top: 10px;
    }

        .document-preview-container:hover {
            transform: scale(1.02);
        }

    .document-preview {
        width: 100%;
        height: 200px;
        object-fit: contain;
        background-color: #f8f9fa;
        border: 1px solid #ddd;
        border-radius: 5px;
    }

    /* PDF Viewer Modal - COPIED FROM FIRST CODE */
    .pdf-viewer-modal {
        display: none;
        position: fixed;
        z-index: 2000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.95);
    }

    .pdf-viewer-content {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .pdf-viewer-header {
        background-color: #333;
        color: white;
        padding: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .pdf-viewer-title {
        font-size: 1.1rem;
        font-weight: 500;
    }

    .pdf-viewer-close {
        background: none;
        border: none;
        color: white;
        font-size: 2rem;
        cursor: pointer;
        padding: 0 0.5rem;
        line-height: 1;
    }

        .pdf-viewer-close:hover {
            color: #dc143c;
        }

    .pdf-viewer-body {
        flex: 1;
        background-color: #525659;
        position: relative;
        overflow: auto;
    }

    .pdf-container {
        display: flex;
        justify-content: center;
        padding: 20px;
        min-height: 100%;
    }

    #pdfCanvas {
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
        background-color: white;
    }

    .pdf-controls {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-left: auto;
        flex-wrap: wrap;
    }

    .page-info {
        color: white;
        font-size: 0.9rem;
        margin: 0 10px;
    }

    .zoom-level {
        color: white;
        font-size: 0.9rem;
        min-width: 40px;
        text-align: center;
    }

    .pdf-loading {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: white;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }

    .pdf-error {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
        color: white;
        display: none;
    }

        .pdf-error i {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

    /* PDF Preview Styles - COPIED FROM FIRST CODE */
    .pdf-preview {
        display: flex;
        align-items: center;
        padding: 1rem;
        border: 2px dashed #ddd;
        border-radius: 8px;
        background-color: #fafafa;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .pdf-preview:hover {
            border-color: var(--primary-color);
            background-color: var(--primary-light);
            transform: translateY(-2px);
        }

    .pdf-icon {
        font-size: 3rem;
        color: #dc143c;
        margin-right: 1rem;
    }

    .pdf-info {
        display: flex;
        flex-direction: column;
    }

    .pdf-filename {
        font-weight: 600;
        color: #333;
        margin-bottom: 0.25rem;
    }

    .pdf-label {
        font-size: 0.9rem;
        color: #6c757d;
    }

    /* Type of Assistance Checkbox Styles */
    .form-check-input {
        width: 1.1rem;
        height: 1.1rem;
        border: 1.5px solid #adb5bd;
        cursor: pointer;
        transition: all 0.15s ease;
        margin-top: 0.15rem;
        margin-right: 0.4rem;
        flex-shrink: 0;
        appearance: auto;
        -webkit-appearance: auto;
    }

        .form-check-input:checked {
            background-color: #dc143c;
            border-color: #dc143c;
        }

        .form-check-input:focus {
            border-color: #dc143c;
            box-shadow: 0 0 0 0.2rem rgba(220, 20, 60, 0.15);
            outline: none;
        }

        .form-check-input:hover {
            border-color: #dc143c;
        }

    .form-check-label {
        margin-left: 0;
        cursor: pointer;
        user-select: none;
        font-size: 0.95rem;
        line-height: 1.4;
    }

    .form-check {
        display: flex;
        align-items: center;
        padding-left: 0;
        margin-bottom: 0.5rem;
        min-height: 1.4rem;
    }

    /* Terms and Conditions */
    .checkbox-group-error {
        border: 2px solid #dc3545 !important;
        border-radius: 8px;
        padding: 1rem;
        animation: shake 0.3s ease;
    }

    @@keyframes shake {
        0%, 100% {
            transform: translateX(0);
        }

        25% {
            transform: translateX(-5px);
        }

        75% {
            transform: translateX(5px);
        }
    }

    .error-message {
        color: #dc3545;
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: none;
        animation: fadeIn 0.3s ease;
    }

        .error-message.show {
            display: block;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<!-- Success Modal -->
<div class="modal fade" id="successModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-body text-center p-4">
                <!-- Success Icon -->
                <div class="mb-3">
                    <i class="fas fa-check-circle text-success" style="font-size: 3rem;"></i>
                </div>

                <!-- Success Message -->
                <h5 class="modal-title text-success mb-2" id="successModalLabel">Changes Saved Successfully!</h5>
                <p class="text-muted mb-3">Your updates have been saved. You will be redirected shortly.</p>

                <!-- Countdown Timer -->
                <div class="d-flex justify-content-center align-items-center mb-3">
                    <div class="spinner-border spinner-border-sm text-success me-2" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <small class="text-muted">Redirecting in <span id="countdown">2</span> seconds...</small>
                </div>

                <!-- Manual Redirect Button -->
                <button type="button" class="btn btn-success btn-sm" onclick="redirectToList()">
                    Go Back Now
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Image Zoom Modal -->
<div id="zoomModal" class="zoom-modal">
    <span class="close-zoom">&times;</span>
    <img class="zoom-modal-content" id="zoomedImage">
</div>

<!-- PDF Viewer Modal - COPIED FROM FIRST CODE -->
<div id="pdfViewerModal" class="pdf-viewer-modal">
    <div class="pdf-viewer-content">
        <div class="pdf-viewer-header">
            <span class="pdf-viewer-title" id="pdfViewerTitle">PDF Document</span>
            <div class="pdf-controls">
                <button class="btn btn-sm btn-light" onclick="prevPage()" id="prevBtn">
                    <i class="fas fa-chevron-left"></i> Previous
                </button>
                <span class="page-info" id="pageInfo">Page: <span id="currentPage">1</span> / <span id="totalPages">1</span></span>
                <button class="btn btn-sm btn-light" onclick="nextPage()" id="nextBtn">
                    Next <i class="fas fa-chevron-right"></i>
                </button>
                <button class="btn btn-sm btn-light" onclick="zoomOut()">
                    <i class="fas fa-search-minus"></i>
                </button>
                <span class="zoom-level" id="zoomLevel">100%</span>
                <button class="btn btn-sm btn-light" onclick="zoomIn()">
                    <i class="fas fa-search-plus"></i>
                </button>
            </div>
            <button class="pdf-viewer-close" onclick="closePDFViewer()">&times;</button>
        </div>
        <div class="pdf-viewer-body">
            <div id="pdfLoading" class="pdf-loading">
                <div class="spinner-border text-light" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p>Loading PDF document...</p>
            </div>
            <div id="pdfError" class="pdf-error">
                <i class="fas fa-exclamation-triangle"></i>
                <p>Error loading PDF. Please try again.</p>
            </div>
            <div class="pdf-container">
                <canvas id="pdfCanvas"></canvas>
            </div>
        </div>
    </div>
</div>

<form asp-action="FuneralAssistanceEdit" enctype="multipart/form-data" method="post" id="editForm">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <!-- Hidden field to track successful submission -->
    <input type="hidden" id="formSubmitted" name="FormSubmitted" value="false">

    @if (ViewData["IsRetakeMode"] != null && (bool)ViewData["IsRetakeMode"])
    {
        <div class="alert alert-warning" role="alert">
            <i class="fas fa-info-circle"></i> <strong>Retake Mode:</strong> Please review and update your information and attachments as needed.
        </div>
    }

    <!-- Patient Information -->
    <div class="form-section">
        <h5 class="section-header">Patient Information</h5>
        <div class="row g-3">
            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Last Name</label>
                <input value="@ViewData["Lastname"]" asp-for="Lastname" type="text" class="form-control" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')" required>
                <span asp-validation-for="Lastname" class="text-danger"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">First Name</label>
                <input value="@ViewData["Firstname"]" asp-for="Firstname" type="text" class="form-control" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')" required>
                <span asp-validation-for="Firstname" class="text-danger"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Middle Name</label>
                <input value="@ViewData["Middlename"]" asp-for="Middlename" type="text" class="form-control" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')">
                <span asp-validation-for="Middlename" class="text-danger"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Suffix</label>
                <select class="form-select" asp-for="Suffix">
                    <option value="None" selected="@(ViewData["Suffix"]?.ToString() == "None")">None</option>
                    <option value="Jr." selected="@(ViewData["Suffix"]?.ToString() == "Jr.")">Jr.</option>
                    <option value="Sr." selected="@(ViewData["Suffix"]?.ToString() == "Sr.")">Sr.</option>
                    <option value="II" selected="@(ViewData["Suffix"]?.ToString() == "II")">II</option>
                    <option value="III" selected="@(ViewData["Suffix"]?.ToString() == "III")">III</option>
                    <option value="IV" selected="@(ViewData["Suffix"]?.ToString() == "IV")">IV</option>
                    <option value="V" selected="@(ViewData["Suffix"]?.ToString() == "V")">V</option>
                </select>
                <span asp-validation-for="Suffix" class="text-danger"></span>
            </div>
        </div>

        <div class="row g-3 mt-2">
            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Blk / Lot / Street</label>
                <input value="@ViewData["BlkLotStreet"]" asp-for="BlkLotStreet" type="text" class="form-control" required>
                <span asp-validation-for="BlkLotStreet" class="text-danger"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Sub / Vill.</label>
                <input value="@ViewData["SubVill"]" asp-for="SubVill" type="text" class="form-control">
                <span asp-validation-for="SubVill" class="text-danger"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Barangay</label>
                <input value="@ViewData["Brgy"]" asp-for="Brgy" type="text" class="form-control" required>
                <span asp-validation-for="Brgy" class="text-danger"></span>
            </div>
        </div>

        <div class="row g-3 mt-2">
            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Date of Birth</label>
                <input value="@ViewData["Dateofbirth"]" asp-for="Dateofbirth" type="date" class="form-control" required>
                <span asp-validation-for="Dateofbirth" class="text-danger"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Age</label>
                <input value="@ViewData["Age"]" asp-for="Age" type="number" class="form-control">
                <span asp-validation-for="Age" class="text-danger"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label required-field">Sex</label>
                <select asp-for="Sex" class="form-select" required>
                    <option value="">Select Sex</option>
                    <option value="Male" selected="@(ViewData["Sex"]?.ToString() == "Male")">Male</option>
                    <option value="Female" selected="@(ViewData["Sex"]?.ToString() == "Female")">Female</option>
                </select>
                <span asp-validation-for="Sex" class="text-danger"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">PhilHealth</label>
                <select class="form-select" asp-for="PhilHealth" id="philHealthSelect">
                    <option value="">Select option</option>
                    <option value="Without PhilHealth" selected="@(ViewData["PhilHealth"]?.ToString() == "Without PhilHealth")">Without PhilHealth</option>
                    <option value="With PhilHealth" selected="@(ViewData["PhilHealth"]?.ToString() == "With PhilHealth")">With PhilHealth</option>
                </select>
                <span asp-validation-for="PhilHealth" class="text-danger"></span>
            </div>
        </div>

        <div class="row g-3 mt-2">
            <div class="col-12 col-sm-12 col-md-6 col-lg-6">
                <label class="form-label">PhilHealth Number (if applicable)</label>
                <input asp-for="PhilHealthNo" type="text" class="form-control" id="philHealthNo">
                <span asp-validation-for="PhilHealthNo" class="text-danger"></span>
            </div>
        </div>

        <script>
            const select = document.getElementById("philHealthSelect");
            const phNo = document.getElementById("philHealthNo");

            function togglePhilHealthNo() {
                if (select.value === "Without PhilHealth") {
                    phNo.value = "";
                    phNo.disabled = true;
                } else {
                    phNo.disabled = false;
                }
            }

            // Execute on page load (for edit forms)
            togglePhilHealthNo();

            // Execute on change
            select.addEventListener("change", togglePhilHealthNo);
        </script>
    </div>

    <!-- Requestor Information -->
    <div class="form-section">
        <h5 class="section-header">Requestor's Details</h5>
        <div class="row g-3">
            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Last Name</label>
                <input value="@ViewData["RLastname"]" asp-for="RLastname" type="text" class="form-control" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')">
                <span asp-validation-for="RLastname"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">First Name</label>
                <input value="@ViewData["RFirstname"]" asp-for="RFirstname" type="text" class="form-control" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')">
                <span asp-validation-for="RFirstname"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Middle Name</label>
                <input value="@ViewData["RMiddlename"]" asp-for="RMiddlename" type="text" class="form-control" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')">
                <span asp-validation-for="RMiddlename"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Suffix</label>
                <select class="form-select" asp-for="RSuffix">
                    <option value="None" selected="@(ViewData["RSuffix"]?.ToString() == "None")">None</option>
                    <option value="Jr." selected="@(ViewData["RSuffix"]?.ToString() == "Jr.")">Jr.</option>
                    <option value="Sr." selected="@(ViewData["RSuffix"]?.ToString() == "Sr.")">Sr.</option>
                    <option value="II" selected="@(ViewData["RSuffix"]?.ToString() == "II")">II</option>
                    <option value="III" selected="@(ViewData["RSuffix"]?.ToString() == "III")">III</option>
                    <option value="IV" selected="@(ViewData["RSuffix"]?.ToString() == "IV")">IV</option>
                    <option value="V" selected="@(ViewData["RSuffix"]?.ToString() == "V")">V</option>
                </select>
                <span asp-validation-for="RSuffix"></span>
            </div>
        </div>

        <div class="row g-3 mt-2">
            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Blk / Lot / Street</label>
                <input value="@ViewData["RBlkLotStreet"]" asp-for="RBlkLotStreet" type="text" class="form-control">
                <span asp-validation-for="RBlkLotStreet"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Sub / Vill.</label>
                <input value="@ViewData["RSubVill"]" asp-for="RSubVill" type="text" class="form-control">
                <span asp-validation-for="RSubVill"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Barangay</label>
                <input value="@ViewData["RBrgy"]" asp-for="RBrgy" type="text" class="form-control">
                <span asp-validation-for="RBrgy"></span>
            </div>
        </div>

        <div class="row g-3 mt-2">
            <div class="col-12 col-sm-12 col-md-6 col-lg-6">
                <label>Contact No.</label>
                <input value="@ViewData["ContactNo"]" asp-for="ContactNo" type="text" class="form-control" id="contactNoInput"
                       placeholder="0912-345-6789 or 02-123-4567"
                       onkeypress="return event.charCode >= 48 && event.charCode <= 57">
                <span asp-validation-for="ContactNo"></span>
                <small class="text-muted">Format: 0912-345-6789 (mobile) or 02-123-4567 (landline)</small>
            </div>
        </div>
    </div>

    <!-- Type of Assistance Requested Section -->
    <div class="form-section">
        <h5 class="section-header">Type of Assistance Requested</h5>
        <div class="row g-3">
            <div class="col-12 col-sm-12 col-md-6 col-lg-6">
                <div class="form-check">
                    <input class="form-check-input assistance-type" type="checkbox"
                           id="funeralAssistance" name="TypeassistanceOptions" value="Funeral Assistance"
                           @(checkedAssistance.ContainsKey("Funeral Assistance") ? "checked" : "") checked>
                    <label class="form-check-label" for="funeralAssistance">Funeral Assistance</label>
                </div>
            </div>
        </div>

        <div class="form-group mt-3">
            <input asp-for="Typeassistance" type="text" class="form-control" id="assistanceReflection"
                   name="Typeassistance"
                   value="@(Model?.Typeassistance ?? "Funeral Assistance")"
                   placeholder="Auto-generated info..." readonly>
            <span asp-validation-for="Typeassistance"></span>
        </div>
    </div>

    <!-- Additional Information Section -->
    <div class="form-section">
        <h5 class="section-header">Additional Information</h5>
        <div class="row g-3">
            <div class="col-lg-6 col-md-12">
                <label class="form-label">Name of the Deceased Person</label>
                <input value="@ViewData["DeceasedPersonName"]" asp-for="DeceasedPersonName" type="text" class="form-control"
                       placeholder="Enter full name of the deceased">
                <span asp-validation-for="DeceasedPersonName" class="text-danger"></span>
            </div>
            <div class="col-lg-6 col-md-12">
                <label class="form-label">Relationship of Claimant to the Deceased</label>
                <input value="@ViewData["RelationshipToDeceased"]" asp-for="RelationshipToDeceased" type="text" class="form-control"
                       placeholder="Enter relationship (e.g., Spouse, Child, Sibling)">
                <span asp-validation-for="RelationshipToDeceased" class="text-danger"></span>
            </div>
        </div>
        <div class="row g-3 mt-2">
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Date of Death</label>
                <input value="@ViewData["DateOfDeath"]" asp-for="DateOfDeath" type="date" class="form-control">
                <span asp-validation-for="DateOfDeath" class="text-danger"></span>
            </div>
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Time of Death</label>
                <input value="@ViewData["TimeOfDeath"]" asp-for="TimeOfDeath" type="time" class="form-control">
                <span asp-validation-for="TimeOfDeath" class="text-danger"></span>
            </div>
            <div class="col-lg-4 col-md-12">
                <label class="form-label">Cause of Death</label>
                <input value="@ViewData["CauseOfDeath"]" asp-for="CauseOfDeath" type="text" class="form-control"
                       placeholder="Enter cause of death">
                <span asp-validation-for="CauseOfDeath" class="text-danger"></span>
            </div>
        </div>
        <div class="row g-3 mt-2">
            <div class="col-lg-6 col-md-12">
                <label class="form-label">Funeral Home/ Parlor Name</label>
                <input value="@ViewData["FuneralHomeName"]" asp-for="FuneralHomeName" type="text" class="form-control"
                       placeholder="Enter funeral home or parlor name">
                <span asp-validation-for="FuneralHomeName" class="text-danger"></span>
            </div>
            <div class="col-lg-6 col-md-12">
                <label class="form-label">Funeral Home/ Parlor Address</label>
                <input value="@ViewData["FuneralHomeAddress"]" asp-for="FuneralHomeAddress" type="text" class="form-control"
                       placeholder="Enter funeral home or parlor address">
                <span asp-validation-for="FuneralHomeAddress" class="text-danger"></span>
            </div>
        </div>
        <div class="row g-3 mt-2">
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Date of Burial or Cremation</label>
                <input value="@ViewData["BurialCremationDate"]" asp-for="BurialCremationDate" type="date" class="form-control">
                <span asp-validation-for="BurialCremationDate" class="text-danger"></span>
            </div>
            <div class="col-lg-4 col-md-6">
                <label class="form-label">Time of Burial or Cremation</label>
                <input value="@ViewData["BurialCremationTime"]" asp-for="BurialCremationTime" type="time" class="form-control">
                <span asp-validation-for="BurialCremationTime" class="text-danger"></span>
            </div>
            <div class="col-lg-4 col-md-12">
                <label class="form-label">Type</label>
                <select asp-for="BurialCremationType" class="form-select">
                    <option value="">Select Type</option>
                    <option value="Burial" selected="@(ViewData["BurialCremationType"]?.ToString() == "Burial")">Burial</option>
                    <option value="Cremation" selected="@(ViewData["BurialCremationType"]?.ToString() == "Cremation")">Cremation</option>
                </select>
                <span asp-validation-for="BurialCremationType" class="text-danger"></span>
            </div>
        </div>
    </div>

    <!-- Upload Section - Simplified for PDF only -->
    <div class="form-section">
        <h5 class="section-header">Death Certificate Document</h5>

        <!-- Current Uploaded Document Box -->
        @if (ViewData["DoctorPrescription"] != null && ViewData["DoctorPrescriptionBase64"] != null)
        {
            <div class="current-document-box mb-3">
                <div class="current-document-header">
                    <i class="fas fa-file-alt"></i> Current Uploaded Document
                </div>
                <div class="current-document-body">
                    <p class="current-document-name"><strong>@ViewData["DoctorPrescription"]</strong></p>
                    @if (ViewData["IsDoctorPrescriptionPdf"] != null && (bool)ViewData["IsDoctorPrescriptionPdf"])
                    {
                        <div class="pdf-preview" onclick="viewPDFInModal('@ViewData["DoctorPrescription"]', 'doctorprescription', 'Death Certificate')">
                            <div class="pdf-icon"><i class="fas fa-file-pdf"></i></div>
                            <div class="pdf-info">
                                <span class="pdf-filename">@ViewData["DoctorPrescription"]</span>
                                <span class="pdf-label">Click to view PDF</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="document-preview-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["DoctorPrescriptionBase64"]')">
                            <img src="data:image/jpeg;base64,@ViewData["DoctorPrescriptionBase64"]" alt="Death Certificate" class="document-preview" />
                            <div class="preview-overlay"><i class="fas fa-search-plus"></i> Click to zoom</div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Reupload Document Box -->
        <div class="reupload-document-box">
            <div class="reupload-document-header">
                <i class="fas fa-upload"></i> Reupload Document
            </div>
            <div class="reupload-document-body">
                <!-- Upload Area (shown when no file selected) -->
                <div id="uploadAreaContainer" class="upload-area" onclick="document.getElementById('deathCertificate').click()">
                    <div class="upload-icon">
                        <i class="fas fa-cloud-upload-alt"></i>
                    </div>
                    <p class="upload-text">Click to select a new document</p>
                    <p class="form-note">Accepted format: PDF only (Max 10MB)</p>
                </div>

                <!-- Reupload Preview Section (shown when file is selected, replaces upload area) -->
                <div id="reuploadPreviewSection" class="reupload-preview-section" style="display: none;">
                    <div class="reupload-preview-header">
                        <span><i class="fas fa-check-circle text-success"></i> New Document Selected</span>
                        <button type="button" class="reupload-change-btn" onclick="document.getElementById('deathCertificate').click()">
                            <i class="fas fa-sync-alt"></i> Change
                        </button>
                    </div>
                    <div class="reupload-preview-body">
                        <p id="fileNameDeath" class="reupload-file-name"></p>
                        <!-- PDF Preview -->
                        <div id="pdfPreviewContainer" class="pdf-preview-container">
                            <div class="pdf-preview" onclick="previewReuploadedPDF()">
                                <div class="pdf-icon"><i class="fas fa-file-pdf"></i></div>
                                <div class="pdf-info">
                                    <span class="pdf-filename" id="pdfFileName"></span>
                                    <span class="pdf-label">Click to view PDF</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <input asp-for="FuneralAssistanceDocument"
                       type="file"
                       id="deathCertificate"
                       class="d-none"
                       accept=".pdf"
                       onchange="handleFileSelect(this)">
                <span asp-validation-for="FuneralAssistanceDocument"></span>
            </div>
        </div>
        <div id="fileStatus" class="file-status mt-2"></div>
    </div>

    <!-- Terms and Conditions -->
    <div class="mb-4">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="termsCheck" required>
            <label class="form-check-label ms-1" for="termsCheck">I certify that all information provided is true and accurate</label>
        </div>
    </div>

    <!-- Submit Button -->
    <div class="text-center mt-4 mb-4">
        <button type="submit" class="btn btn-submit" id="submitButton">
            Submit
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        // PDF.js worker configuration
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

        // PDF Viewer Variables
        let currentPDF = null;
        let currentPage = 1;
        let totalPages = 1;
        let currentScale = 1.2;
        let uploadedPDFFile = null;

        // Main initialization function
        document.addEventListener('DOMContentLoaded', function() {
            initializeFormValidation();
            initializeImageModal();
            checkFormSubmission();
        });

        // Form Validation - ENHANCED
        function initializeFormValidation() {
            const form = document.getElementById('editForm');
            if (!form) return;

            function validateAssistanceCheckboxes() {
                const assistanceCheckboxes = document.querySelectorAll('.assistance-type');
                const checked = Array.from(assistanceCheckboxes).some(cb => cb.checked);
                const assistanceSection = document.querySelector('.assistance-type')?.closest('.row');
                const existingError = assistanceSection?.querySelector('.error-message');
                if (existingError) existingError.remove();

                if (!checked) {
                    if (assistanceSection) {
                        assistanceSection.classList.add('checkbox-group-error');
                        const errorMsg = document.createElement('div');
                        errorMsg.className = 'error-message show';
                        errorMsg.textContent = 'Please select at least one type of assistance';
                        assistanceSection.appendChild(errorMsg);
                    }
                    return false;
                } else {
                    assistanceSection?.classList.remove('checkbox-group-error');
                    return true;
                }
            }

            function attachCheckboxListeners() {
                const assistanceCheckboxes = document.querySelectorAll('.assistance-type');
                assistanceCheckboxes.forEach(checkbox => {
                    checkbox.addEventListener('change', () => {
                        if (checkbox.checked) {
                            const assistanceSection = checkbox.closest('.row');
                            assistanceSection?.classList.remove('checkbox-group-error');
                            const errorMsg = assistanceSection?.querySelector('.error-message');
                            if (errorMsg) errorMsg.remove();
                        }
                    });
                });
            }

            form.addEventListener('submit', function(e) {
                let isValid = true;
                const missingFields = [];
                const requiredInputs = form.querySelectorAll('input[required], select[required], textarea[required]');

                // Clear previous validation states
                form.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
                form.querySelectorAll('.checkbox-group-error').forEach(el => {
                    el.classList.remove('checkbox-group-error');
                });

                // Helper function to get field label
                function getFieldLabel(input) {
                    const container = input.closest('.col-lg-1, .col-lg-2, .col-lg-3, .col-lg-4, .col-lg-5, .col-lg-6, .col-md-1, .col-md-2, .col-md-3, .col-md-4, .col-md-5, .col-md-6, .col-md-12, .col-sm-6, .col-sm-12, .mb-3, .mb-4');
                    const label = container?.querySelector('label:not(.form-check-label)');
                    return label?.textContent?.replace('*', '').trim() || input.name || 'Unknown field';
                }

                requiredInputs.forEach(input => {
                    if (input.type !== 'checkbox' && input.type !== 'radio') {
                        if (!input.value.trim()) {
                            input.classList.add('is-invalid');
                            missingFields.push(getFieldLabel(input));
                            isValid = false;
                        }
                    }
                });

                // Validate assistance checkboxes
                if (!validateAssistanceCheckboxes()) {
                    missingFields.push('Type of Assistance Requested');
                    isValid = false;
                }

                // Validate terms checkbox
                const termsCheck = document.getElementById('termsCheck');
                if (termsCheck && !termsCheck.checked) {
                    missingFields.push('Terms and Conditions acceptance');
                    isValid = false;
                }

                if (!isValid) {
                    e.preventDefault();

                    // Show unified warning message with bullet points
                    let message = 'Please complete the following required fields:\n\n';
                    missingFields.forEach(field => {
                        message += '� ' + field + '\n';
                    });
                    alert(message);

                    // Scroll to first error
                    const firstError = form.querySelector('.is-invalid, .checkbox-group-error');
                    if (firstError) {
                        firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                }
            });

            attachCheckboxListeners();
        }

        // Image Modal and Zoom Functionality
        function initializeImageModal() {
            const previewImages = document.querySelectorAll('.document-preview');
            const modalImage = document.getElementById('zoomedImage');
            const zoomModal = document.getElementById('zoomModal');
            const closeZoom = document.querySelector('.close-zoom');

            if (!modalImage || !zoomModal || !closeZoom) return;

            previewImages.forEach(img => {
                img.style.cursor = 'pointer';
                img.addEventListener('click', function() {
                    modalImage.src = this.src;
                    zoomModal.style.display = 'block';
                });
            });

            // Add click handlers to document preview containers
            const docContainers = document.querySelectorAll('.document-preview-container');
            docContainers.forEach(container => {
                container.addEventListener('click', function() {
                    const img = this.querySelector('img');
                    if (img) {
                        modalImage.src = img.src;
                        zoomModal.style.display = 'block';
                    }
                });
            });

            closeZoom.addEventListener('click', function() {
                zoomModal.style.display = 'none';
            });

            window.addEventListener('click', function(event) {
                if (event.target == zoomModal) {
                    zoomModal.style.display = 'none';
                }
            });
        }

        // Image zoom function (for use in onclick handlers)
        function zoomImage(src) {
            const modal = document.getElementById("zoomModal");
            const modalImg = document.getElementById("zoomedImage");
            if (modal && modalImg) {
                modal.style.display = "block";
                modalImg.src = src;
            }
        }

        // Success Modal Functions
        function showSuccessModal() {
            const successModal = new bootstrap.Modal(document.getElementById('successModal'));
            successModal.show();

            let countdown = 2;
            const countdownElement = document.getElementById('countdown');
            const countdownInterval = setInterval(() => {
                countdown--;
                countdownElement.textContent = countdown;

                if (countdown <= 0) {
                    clearInterval(countdownInterval);
                    redirectToList();
                }
            }, 1000);
        }

        function redirectToList() {
            window.location.href = '/Home';
        }

        // Check for successful form submission on page load
        function checkFormSubmission() {
            const urlParams = new URLSearchParams(window.location.search);
            const success = urlParams.get('success');
            const serverSuccess = @Json.Serialize(ViewBag.Success ?? false);
            const tempDataSuccess = @Json.Serialize(TempData["Success"] ?? false);

            if (success === 'true' || serverSuccess === true || tempDataSuccess === true) {
                setTimeout(() => {
                    showSuccessModal();
                }, 500);
            }
        }

        // Enhanced form submission handler
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('editForm');
            const submitButton = document.getElementById('submitButton');
            const formSubmittedField = document.getElementById('formSubmitted');

            if (form) {
                form.addEventListener('submit', function(e) {
                    if (formSubmittedField) {
                        formSubmittedField.value = 'true';
                    }

                    if (submitButton) {
                        submitButton.innerHTML = '<i class="bi bi-hourglass-split"></i> Saving...';
                        submitButton.disabled = true;
                    }
                });
            }

            const hasValidationErrors = document.querySelector('.alert-danger, .field-validation-error');
            if (hasValidationErrors && submitButton) {
                submitButton.innerHTML = 'Submit';
                submitButton.disabled = false;
            }
        });

        // PDF Viewer Functions - COPIED FROM FIRST CODE
        async function viewPDFInModal(fileName, fileType, displayName) {
            const modal = document.getElementById('pdfViewerModal');
            const title = document.getElementById('pdfViewerTitle');
            const loading = document.getElementById('pdfLoading');
            const errorDiv = document.getElementById('pdfError');
            const canvas = document.getElementById('pdfCanvas');
            const context = canvas ? canvas.getContext('2d') : null;
            const currentPageSpan = document.getElementById('currentPage');
            const totalPagesSpan = document.getElementById('totalPages');
            const zoomLevelSpan = document.getElementById('zoomLevel');

            if (!modal || !title || !loading || !errorDiv || !canvas || !context) {
                console.error('PDF viewer elements not found');
                return;
            }

            title.textContent = displayName || 'PDF Document';
            modal.style.display = 'block';
            loading.style.display = 'flex';
            errorDiv.style.display = 'none';
            canvas.style.display = 'none';

            currentPDF = null;
            currentPage = 1;
            currentScale = 1.2;

            try {
                const encodedFileName = encodeURIComponent(fileName);
                const url = '@Url.Action("ViewPDF", "Dashboard")?fileName=' + encodedFileName + '&fileType=' + fileType + '&t=' + Date.now();

                const response = await fetch(url);
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const pdfData = await response.arrayBuffer();
                if (!pdfData || pdfData.byteLength === 0) {
                    throw new Error('PDF data is empty');
                }

                const loadingTask = pdfjsLib.getDocument({ data: pdfData });
                currentPDF = await loadingTask.promise;

                totalPages = currentPDF.numPages;
                if (totalPagesSpan) totalPagesSpan.textContent = totalPages;
                if (currentPageSpan) currentPageSpan.textContent = currentPage;

                updateNavigationButtons();
                await renderPage(currentPage);

                loading.style.display = 'none';
                canvas.style.display = 'block';
                if (zoomLevelSpan) zoomLevelSpan.textContent = Math.round(currentScale * 100) + '%';

            } catch (error) {
                console.error('Error loading PDF:', error);
                loading.style.display = 'none';
                errorDiv.style.display = 'block';
                if (errorDiv.querySelector('p')) {
                    errorDiv.querySelector('p').textContent = `Error loading PDF: ${error.message}`;
                }
            }
        }

        // Preview uploaded PDF
        function previewUploadedPDF() {
            if (!uploadedPDFFile) {
                alert('No PDF file uploaded');
                return;
            }

            const modal = document.getElementById('pdfViewerModal');
            const title = document.getElementById('pdfViewerTitle');
            const loading = document.getElementById('pdfLoading');
            const errorDiv = document.getElementById('pdfError');
            const canvas = document.getElementById('pdfCanvas');
            const context = canvas ? canvas.getContext('2d') : null;

            if (!modal || !title || !loading || !errorDiv || !canvas || !context) {
                console.error('PDF viewer elements not found');
                return;
            }

            title.textContent = uploadedPDFFile.name || 'Uploaded PDF Document';
            modal.style.display = 'block';
            loading.style.display = 'flex';
            errorDiv.style.display = 'none';
            canvas.style.display = 'none';

            currentPDF = null;
            currentPage = 1;
            currentScale = 1.2;

            const reader = new FileReader();
            reader.onload = async function(e) {
                try {
                    const pdfData = e.target.result;
                    const loadingTask = pdfjsLib.getDocument({ data: pdfData });
                    currentPDF = await loadingTask.promise;

                    totalPages = currentPDF.numPages;
                    document.getElementById('totalPages').textContent = totalPages;
                    document.getElementById('currentPage').textContent = currentPage;

                    updateNavigationButtons();
                    await renderPage(currentPage);

                    loading.style.display = 'none';
                    canvas.style.display = 'block';
                    document.getElementById('zoomLevel').textContent = Math.round(currentScale * 100) + '%';
                } catch (error) {
                    console.error('Error loading PDF:', error);
                    loading.style.display = 'none';
                    errorDiv.style.display = 'block';
                    if (errorDiv.querySelector('p')) {
                        errorDiv.querySelector('p').textContent = `Error loading PDF: ${error.message}`;
                    }
                }
            };

            reader.readAsArrayBuffer(uploadedPDFFile);
        }

        async function renderPage(pageNum) {
            if (!currentPDF) return;

            const canvas = document.getElementById('pdfCanvas');
            const context = canvas.getContext('2d');
            const currentPageSpan = document.getElementById('currentPage');

            if (!canvas || !context) return;

            try {
                const page = await currentPDF.getPage(pageNum);
                const viewport = page.getViewport({ scale: currentScale });

                canvas.height = viewport.height;
                canvas.width = viewport.width;

                const renderContext = {
                    canvasContext: context,
                    viewport: viewport
                };

                await page.render(renderContext).promise;
                if (currentPageSpan) currentPageSpan.textContent = pageNum;

            } catch (error) {
                console.error('Error rendering page:', error);
            }
        }

        function nextPage() {
            if (currentPage < totalPages) {
                currentPage++;
                renderPage(currentPage);
                updateNavigationButtons();
            }
        }

        function prevPage() {
            if (currentPage > 1) {
                currentPage--;
                renderPage(currentPage);
                updateNavigationButtons();
            }
        }

        function zoomIn() {
            currentScale += 0.2;
            renderPage(currentPage);
            const zoomLevelSpan = document.getElementById('zoomLevel');
            if (zoomLevelSpan) zoomLevelSpan.textContent = Math.round(currentScale * 100) + '%';
        }

        function zoomOut() {
            if (currentScale > 0.5) {
                currentScale -= 0.2;
                renderPage(currentPage);
                const zoomLevelSpan = document.getElementById('zoomLevel');
                if (zoomLevelSpan) zoomLevelSpan.textContent = Math.round(currentScale * 100) + '%';
            }
        }

        function updateNavigationButtons() {
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');

            if (prevBtn) prevBtn.disabled = currentPage <= 1;
            if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
        }

        function closePDFViewer() {
            const modal = document.getElementById('pdfViewerModal');
            if (modal) {
                modal.style.display = 'none';
            }

            if (currentPDF) {
                currentPDF.destroy();
                currentPDF = null;
            }
        }

        // File selection handler - Updated for PDF only
        function handleFileSelect(input) {
            const file = input.files[0];
            const fileNameDisplay = document.getElementById('fileNameDeath');
            const fileStatus = document.getElementById('fileStatus');
            const reuploadPreviewSection = document.getElementById('reuploadPreviewSection');
            const pdfPreviewContainer = document.getElementById('pdfPreviewContainer');
            const pdfFileName = document.getElementById('pdfFileName');
            const uploadAreaContainer = document.getElementById('uploadAreaContainer');

            if (file) {
                const validTypes = ['application/pdf'];
                const maxSize = 10 * 1024 * 1024;

                if (!validTypes.includes(file.type)) {
                    if (fileStatus) fileStatus.innerHTML = '<span class="file-error">Invalid file type. Please upload PDF files only.</span>';
                    input.value = '';
                    if (reuploadPreviewSection) reuploadPreviewSection.style.display = 'none';
                    if (uploadAreaContainer) uploadAreaContainer.style.display = 'block';
                    return;
                }

                if (file.size > maxSize) {
                    if (fileStatus) fileStatus.innerHTML = '<span class="file-error">File size too large. Maximum size is 10MB.</span>';
                    input.value = '';
                    if (reuploadPreviewSection) reuploadPreviewSection.style.display = 'none';
                    if (uploadAreaContainer) uploadAreaContainer.style.display = 'block';
                    return;
                }

                if (fileNameDisplay) fileNameDisplay.textContent = file.name;
                if (pdfFileName) pdfFileName.textContent = file.name;
                if (fileStatus) fileStatus.innerHTML = '<span class="file-success">File ready for upload: ' + file.name + '</span>';

                // Hide upload area and show preview section
                if (uploadAreaContainer) uploadAreaContainer.style.display = 'none';
                if (reuploadPreviewSection) reuploadPreviewSection.style.display = 'block';
                if (pdfPreviewContainer) pdfPreviewContainer.style.display = 'block';

                // Store the uploaded file for preview
                uploadedPDFFile = file;

            } else {
                // Show upload area and hide preview section
                if (uploadAreaContainer) uploadAreaContainer.style.display = 'block';
                if (reuploadPreviewSection) reuploadPreviewSection.style.display = 'none';
                if (pdfPreviewContainer) pdfPreviewContainer.style.display = 'none';
                if (fileNameDisplay) fileNameDisplay.textContent = '';
                if (fileStatus) fileStatus.innerHTML = '';
                uploadedPDFFile = null;
            }
        }

        // Preview reuploaded PDF
        function previewReuploadedPDF() {
            if (uploadedPDFFile) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const pdfData = new Uint8Array(e.target.result);
                    openPDFViewerWithData(pdfData, uploadedPDFFile.name);
                };
                reader.readAsArrayBuffer(uploadedPDFFile);
            }
        }

        // Open PDF viewer with data
        async function openPDFViewerWithData(pdfData, filename) {
            const modal = document.getElementById('pdfViewerModal');
            const title = document.getElementById('pdfViewerTitle');
            const canvas = document.getElementById('pdfCanvas');
            const loading = document.getElementById('pdfLoading');
            const errorDiv = document.getElementById('pdfError');

            if (!modal) return;

            modal.style.display = 'block';
            if (loading) loading.style.display = 'flex';
            if (canvas) canvas.style.display = 'none';
            if (errorDiv) errorDiv.style.display = 'none';
            if (title) title.textContent = filename || 'PDF Viewer';

            currentPage = 1;
            currentScale = 1.2;

            try {
                const loadingTask = pdfjsLib.getDocument({ data: pdfData });
                currentPDF = await loadingTask.promise;

                totalPages = currentPDF.numPages;
                const totalPagesSpan = document.getElementById('totalPages');
                const currentPageSpan = document.getElementById('currentPage');
                if (totalPagesSpan) totalPagesSpan.textContent = totalPages;
                if (currentPageSpan) currentPageSpan.textContent = currentPage;

                updateNavigationButtons();
                await renderPage(currentPage);

                if (loading) loading.style.display = 'none';
                if (canvas) canvas.style.display = 'block';
                const zoomLevelSpan = document.getElementById('zoomLevel');
                if (zoomLevelSpan) zoomLevelSpan.textContent = Math.round(currentScale * 100) + '%';
            } catch (error) {
                if (loading) loading.style.display = 'none';
                if (errorDiv) {
                    errorDiv.style.display = 'block';
                    const errorText = errorDiv.querySelector('p');
                    if (errorText) errorText.textContent = `Error loading PDF: ${error.message}`;
                }
            }
        }

        // Keyboard shortcuts and navigation
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                const zoomModal = document.getElementById("zoomModal");
                if (zoomModal) zoomModal.style.display = "none";
                closePDFViewer();
            }

            const pdfModal = document.getElementById('pdfViewerModal');
            if (pdfModal && pdfModal.style.display === 'block') {
                switch(e.key) {
                    case 'ArrowLeft':
                        e.preventDefault();
                        prevPage();
                        break;
                    case 'ArrowRight':
                        e.preventDefault();
                        nextPage();
                        break;
                    case '+':
                    case '=':
                        e.preventDefault();
                        zoomIn();
                        break;
                    case '-':
                        e.preventDefault();
                        zoomOut();
                        break;
                }
            }
        });

        window.onclick = function(event) {
            const zoomModal = document.getElementById("zoomModal");
            const pdfModal = document.getElementById("pdfViewerModal");

            if (event.target == zoomModal && zoomModal) {
                zoomModal.style.display = "none";
            }
            if (event.target == pdfModal && pdfModal) {
                closePDFViewer();
            }
        }
    </script>
}