                                        <div class="pdf-info">
                                            <span class="pdf-filename">@ViewData["DeathCertificate"]</span>
                                            <span class="pdf-label">Click to view PDF</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="document-preview-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["DeathCertificateBase64"]')">
                                        <img src="data:image/jpeg;base64,@ViewData["DeathCertificateBase64"]" alt="Death Certificate" class="document-preview" />
                                        <div class="preview-overlay"><i class="fas fa-search-plus"></i> Click to zoom</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Reupload Document Box -->
            <div class="reupload-document-box">
                <div class="reupload-document-header">
                    <i class="fas fa-upload"></i> Reupload Document
