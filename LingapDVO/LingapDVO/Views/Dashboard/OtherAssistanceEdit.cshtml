@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        // Success Modal Functions
        function showSuccessModal() {
            const successModal = new bootstrap.Modal(document.getElementById('successModal'));
            successModal.show();

            let countdown = 2;
            const countdownElement = document.getElementById('countdown');
            const countdownInterval = setInterval(() => {
                countdown--;
                countdownElement.textContent = countdown;

                if (countdown <= 0) {
                    clearInterval(countdownInterval);
                    redirectToList();
                }
            }, 1000);
        }

        function redirectToList() {
            window.location.href = '/Home';
        }

        // Main initialization function
        document.addEventListener('DOMContentLoaded', function() {
            initializeConditionalSections();
            initializeContactNumber();
            initializePhilHealth();
            initializeFileValidation();

            // Check for successful form submission
            checkFormSubmission();
        });

        // Initialize conditional sections
        function initializeConditionalSections() {
            const assistanceRadios = document.querySelectorAll('.assistance-type');
            const assistanceReflection = document.getElementById('assistanceReflection');

            // Get conditional sections
            const medicinesSection = document.getElementById('medicinesSection');
            const laboratorySection = document.getElementById('laboratorySection');
            const therapySection = document.getElementById('therapySection');
            const apparatusSection = document.getElementById('apparatusSection');

            // Function to toggle sections based on selection
            function toggleSections() {
                const selectedValue = document.querySelector('input[name="AssistanceType"]:checked')?.value || '';

                // Hide all sections first
                if (medicinesSection) medicinesSection.style.display = 'none';
                if (laboratorySection) laboratorySection.style.display = 'none';
                if (therapySection) therapySection.style.display = 'none';
                if (apparatusSection) apparatusSection.style.display = 'none';

                // Show the appropriate section
                if (selectedValue.includes('Medicine')) {
                    if (medicinesSection) medicinesSection.style.display = 'block';
                } else if (selectedValue.includes('Laboratory')) {
                    if (laboratorySection) laboratorySection.style.display = 'block';
                } else if (selectedValue.includes('Therapy')) {
                    if (therapySection) therapySection.style.display = 'block';
                } else if (selectedValue.includes('Equipment') || selectedValue.includes('Apparatus')) {
                    if (apparatusSection) apparatusSection.style.display = 'block';
                }

                // Update reflection field
                if (assistanceReflection) {
                    assistanceReflection.value = selectedValue;
                }
            }

            // Add event listeners to all radio buttons
            assistanceRadios.forEach(radio => {
                radio.addEventListener('change', toggleSections);
            });

            // Initialize based on current selection
            const currentSelection = document.querySelector('input[name="AssistanceType"]:checked');
            if (currentSelection) {
                toggleSections();
            } else {
                // If no selection, check the reflection field for existing value
                const currentValue = assistanceReflection?.value;
                if (currentValue) {
                    // Find and check the appropriate radio button
                    assistanceRadios.forEach(radio => {
                        if (currentValue.includes(radio.value) ||
                            (radio.value.includes(currentValue))) {
                            radio.checked = true;
                        }
                    });
                    toggleSections();
                }
            }
        }

        // Contact Number Validation
        function initializeContactNumber() {
            const contactNoInput = document.getElementById('contactNoInput');
            if (!contactNoInput) return;

            contactNoInput.addEventListener('input', function(e) {
                let value = this.value.replace(/\D/g, '');
                if (value.length > 11) {
                    value = value.substring(0, 11);
                }
                // Format for display
                if (value.length > 0) {
                    if (value.startsWith('0') && value.length <= 11) {
                        // Mobile format: 0912-345-6789
                        if (value.length > 3) {
                            value = value.substring(0, 4) + '-' + value.substring(4);
                        }
                        if (value.length > 8) {
                            value = value.substring(0, 8) + '-' + value.substring(8);
                        }
                    } else if (value.startsWith('02') && value.length <= 10) {
                        // Landline format: 02-123-4567
                        if (value.length > 2) {
                            value = value.substring(0, 2) + '-' + value.substring(2);
                        }
                        if (value.length > 6) {
                            value = value.substring(0, 6) + '-' + value.substring(6);
                        }
                    }
                }
                this.value = value;
            });
        }

        // PhilHealth Number Handling
        function initializePhilHealth() {
            const philHealthSelect = document.getElementById('philHealthSelect');
            const philHealthNo = document.getElementById('philHealthNo');

            function togglePhilHealthNo() {
                if (philHealthSelect.value === "Without PhilHealth") {
                    if (philHealthNo) {
                        philHealthNo.value = "";
                        philHealthNo.disabled = true;
                        philHealthNo.classList.add('readonly-field');
                    }
                } else {
                    if (philHealthNo) {
                        philHealthNo.disabled = false;
                        philHealthNo.classList.remove('readonly-field');
                    }
                }
            }

            if (philHealthSelect) {
                // Execute on page load
                togglePhilHealthNo();

                // Execute on change
                philHealthSelect.addEventListener('change', togglePhilHealthNo);
            }
        }

        // File Validation
        function initializeFileValidation() {
            const fileInputs = document.querySelectorAll('input[type="file"]');

            fileInputs.forEach(input => {
                input.addEventListener('change', function(e) {
                    validateFile(this);
                });
            });

            function validateFile(input) {
                const file = input.files[0];
                const fileNameDisplay = input.id === 'otherDocument' ?
                    document.getElementById('fileNameOther') :
                    document.getElementById('fileNameMedical');
                const uploadText = input.id === 'otherDocument' ?
                    document.getElementById('uploadTextOther') :
                    document.getElementById('uploadTextMedical');
                const preview = input.id === 'otherDocument' ?
                    document.getElementById('otherDocumentPreview') :
                    document.getElementById('receiptPreview');
                const uploadBox = input.previousElementSibling;

                if (file) {
                    const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'application/pdf'];
                    const maxSize = 10 * 1024 * 1024;

                    if (!validTypes.includes(file.type)) {
                        alert('Invalid file type. Please upload only JPG, PNG, or PDF files.');
                        input.value = '';
                        return;
                    }

                    if (file.size > maxSize) {
                        alert('File size exceeds 10MB limit. Please choose a smaller file.');
                        input.value = '';
                        return;
                    }

                    if (fileNameDisplay) {
                        fileNameDisplay.textContent = file.name;
                    }

                    if (uploadText) {
                        uploadText.textContent = 'Click to change document';
                    }

                    if (uploadBox) {
                        uploadBox.style.borderColor = "var(--success-color)";
                        uploadBox.style.backgroundColor = "rgba(40, 167, 69, 0.1)";
                    }

                    if (file.type.startsWith("image/") && preview) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            preview.src = e.target.result;
                            preview.style.display = "block";
                        };
                        reader.readAsDataURL(file);
                    } else if (preview) {
                        preview.style.display = "none";
                    }
                } else {
                    if (preview) {
                        preview.style.display = "none";
                    }
                    if (fileNameDisplay) {
                        fileNameDisplay.textContent = '';
                    }
                    if (uploadText) {
                        uploadText.textContent = input.id === 'otherDocument' ?
                            'Click to upload new document' :
                            'Click to upload new document';
                    }
                    if (uploadBox) {
                        uploadBox.style.borderColor = "#ddd";
                        uploadBox.style.backgroundColor = "#fafafa";
                    }
                }
            }
        }

        // File Select Handler
        function handleFileSelect(input) {
            const file = input.files[0];
            const fileNameDisplay = input.id === 'otherDocument' ?
                document.getElementById('fileNameOther') :
                document.getElementById('fileNameMedical');
            const uploadText = input.id === 'otherDocument' ?
                document.getElementById('uploadTextOther') :
                document.getElementById('uploadTextMedical');
            const preview = input.id === 'otherDocument' ?
                document.getElementById('otherDocumentPreview') :
                document.getElementById('receiptPreview');
            const uploadBox = input.previousElementSibling;

            if (file) {
                if (fileNameDisplay) {
                    fileNameDisplay.textContent = file.name;
                }

                if (uploadText) {
                    uploadText.textContent = 'Click to change document';
                }

                if (uploadBox) {
                    uploadBox.style.borderColor = "var(--success-color)";
                    uploadBox.style.backgroundColor = "rgba(40, 167, 69, 0.1)";
                }

                if (file.type.startsWith("image/") && preview) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        preview.src = e.target.result;
                        preview.style.display = "block";
                    };
                    reader.readAsDataURL(file);
                } else if (preview) {
                    preview.style.display = "none";
                }
            }
        }

        // Form Submission Success
        function checkFormSubmission() {
            @if (ViewBag.Success != null && ViewBag.Success == true)
            {
                    <text>
                    setTimeout(() => {
                        showSuccessModal();
                    }, 500);
                    </text>
            }
        }

        // PDF Viewer Variables and Functions
        let currentPDF = null;
        let currentPage = 1;
        let totalPages = 1;
        let currentScale = 1.2;

        function ensurePDFJSLoaded() {
            return new Promise((resolve, reject) => {
                if (typeof pdfjsLib !== 'undefined') {
                    resolve();
                } else {
                    const script = document.createElement('script');
                    script.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
                    script.onload = resolve;
                    script.onerror = reject;
                    document.head.appendChild(script);
                }
            });
        }

        function zoomImage(src) {
            const modal = document.getElementById("zoomModal");
            const modalImg = document.getElementById("zoomedImage");
            modal.style.display = "block";
            modalImg.src = src;
        }

        document.querySelector(".close-zoom").onclick = function() {
            document.getElementById("zoomModal").style.display = "none";
        }

        async function viewPDFInModal(fileName, fileType, displayName) {
            try {
                await ensurePDFJSLoaded();

                const modal = document.getElementById('pdfViewerModal');
                const title = document.getElementById('pdfViewerTitle');
                const loading = document.getElementById('pdfLoading');
                const errorDiv = document.getElementById('pdfError');
                const canvas = document.getElementById('pdfCanvas');
                const context = canvas.getContext('2d');
                const currentPageSpan = document.getElementById('currentPage');
                const totalPagesSpan = document.getElementById('totalPages');
                const zoomLevelSpan = document.getElementById('zoomLevel');

                title.textContent = displayName || 'PDF Document';
                modal.style.display = 'block';
                loading.style.display = 'flex';
                errorDiv.style.display = 'none';
                canvas.style.display = 'none';

                currentPDF = null;
                currentPage = 1;
                currentScale = 1.2;

                const encodedFileName = encodeURIComponent(fileName);
                const url = '@Url.Action("ViewPDF", "Dashboard")?fileName=' + encodedFileName + '&fileType=' + fileType + '&t=' + Date.now();

                const response = await fetch(url);

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const pdfData = await response.arrayBuffer();

                if (!pdfData || pdfData.byteLength === 0) {
                    throw new Error('PDF data is empty');
                }

                const loadingTask = pdfjsLib.getDocument({ data: pdfData });
                currentPDF = await loadingTask.promise;

                totalPages = currentPDF.numPages;
                totalPagesSpan.textContent = totalPages;
                currentPageSpan.textContent = currentPage;

                updateNavigationButtons();

                await renderPage(currentPage);

                loading.style.display = 'none';
                canvas.style.display = 'block';
                zoomLevelSpan.textContent = Math.round(currentScale * 100) + '%';

            } catch (error) {
                const loading = document.getElementById('pdfLoading');
                const errorDiv = document.getElementById('pdfError');
                loading.style.display = 'none';
                errorDiv.style.display = 'block';
                errorDiv.querySelector('p').textContent = `Error loading PDF: ${error.message}`;
            }
        }

        async function renderPage(pageNum) {
            if (!currentPDF) return;

            const canvas = document.getElementById('pdfCanvas');
            const context = canvas.getContext('2d');
            const currentPageSpan = document.getElementById('currentPage');

            try {
                const page = await currentPDF.getPage(pageNum);
                const viewport = page.getViewport({ scale: currentScale });

                canvas.height = viewport.height;
                canvas.width = viewport.width;

                const renderContext = {
                    canvasContext: context,
                    viewport: viewport
                };

                await page.render(renderContext).promise;
                currentPageSpan.textContent = pageNum;

            } catch (error) {
                console.error('Error rendering PDF page:', error);
            }
        }

        function nextPage() {
            if (currentPage < totalPages) {
                currentPage++;
                renderPage(currentPage);
                updateNavigationButtons();
            }
        }

        function prevPage() {
            if (currentPage > 1) {
                currentPage--;
                renderPage(currentPage);
                updateNavigationButtons();
            }
        }

        function zoomIn() {
            currentScale += 0.2;
            renderPage(currentPage);
            document.getElementById('zoomLevel').textContent = Math.round(currentScale * 100) + '%';
        }

        function zoomOut() {
            if (currentScale > 0.5) {
                currentScale -= 0.2;
                renderPage(currentPage);
                document.getElementById('zoomLevel').textContent = Math.round(currentScale * 100) + '%';
            }
        }

        function updateNavigationButtons() {
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');

            prevBtn.disabled = currentPage <= 1;
            nextBtn.disabled = currentPage >= totalPages;
        }

        function closePDFViewer() {
            const modal = document.getElementById('pdfViewerModal');
            modal.style.display = 'none';

            if (currentPDF) {
                currentPDF.destroy();
                currentPDF = null;
            }
        }

        // REMOVED: View Additional Information (Password-Protected) function
        // Since we removed the encrypted feature, this function is no longer needed

        // Keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.getElementById("zoomModal").style.display = "none";
                closePDFViewer();
            }

            const pdfModal = document.getElementById('pdfViewerModal');
            if (pdfModal.style.display === 'block') {
                switch(e.key) {
                    case 'ArrowLeft':
                        e.preventDefault();
                        prevPage();
                        break;
                    case 'ArrowRight':
                        e.preventDefault();
                        nextPage();
                        break;
                    case '+':
                    case '=':
                        e.preventDefault();
                        zoomIn();
                        break;
                    case '-':
                        e.preventDefault();
                        zoomOut();
                        break;
                }
            }
        });

        window.onclick = function(event) {
            const zoomModal = document.getElementById("zoomModal");
            const pdfModal = document.getElementById("pdfViewerModal");

            if (event.target == zoomModal) {
                zoomModal.style.display = "none";
            }
            if (event.target == pdfModal) {
                closePDFViewer();
            }
        }
    </script>
}

