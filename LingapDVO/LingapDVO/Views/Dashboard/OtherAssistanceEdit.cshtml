                            <i class="fas fa-cloud-upload-alt"></i>
                        </div>
                        <p class="upload-text">Click to select a new document</p>
                        <p class="form-note">Accepted formats: JPG, PNG, PDF (Max 10MB)</p>
                    </div>

                    <!-- Reupload Preview Section (shown when file is selected, replaces upload area) -->
                    <div id="reuploadPreviewSection" class="reupload-preview-section" style="display: none;">
                        <div class="reupload-preview-header">
                            <span><i class="fas fa-check-circle text-success"></i> New Document Selected</span>
                            <button type="button" class="reupload-change-btn" onclick="document.getElementById('otherDocument').click()">
                                <i class="fas fa-sync-alt"></i> Change
                            </button>
                        </div>
                        <div class="reupload-preview-body">
                            <p id="fileNameOther" class="reupload-file-name"></p>
                            <!-- Image Preview -->
                            <div id="imagePreviewContainer" class="image-preview-container" style="display: none;">
                                <img id="receiptPreview" class="reupload-preview-image" alt="New Document Preview" onclick="zoomReuploadImage(this.src)">
