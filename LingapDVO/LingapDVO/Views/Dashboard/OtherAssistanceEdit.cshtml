                                        <img src="data:image/jpeg;base64,@ViewData["DoctorPrescriptionBase64"]" alt="Doctor Prescription" class="document-preview" />
                                        <div class="preview-overlay"><i class="fas fa-search-plus"></i> Click to zoom</div>
                                    </div>
                                }
                            </div>
                        }

                        @if (ViewData["MedicalCertificate"] != null && ViewData["MedicalCertificateBase64"] != null)
                        {
                            <div class="document-item mb-3">
                                <p class="current-document-name"><strong>Medical Certificate:</strong> @ViewData["MedicalCertificate"]</p>
                                @if (ViewData["IsMedicalCertificatePdf"] is bool isPdfMed && isPdfMed)
                                {
                                    <div class="pdf-preview" onclick="viewPDFInModal('@ViewData["MedicalCertificate"]', 'medicalcertificate', 'Medical Certificate')">
                                        <div class="pdf-icon"><i class="fas fa-file-pdf"></i></div>
                                        <div class="pdf-info">
                                            <span class="pdf-filename">@ViewData["MedicalCertificate"]</span>
                                            <span class="pdf-label">Click to view PDF</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
