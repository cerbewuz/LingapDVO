@model OtherAssistanceDto
@{
    Layout = "_EditFormsLayout";
    ViewData["Title"] = "Edit Other Assistance";
    var checkedAssistance = ViewData["CheckedAssistance"] as Dictionary<string, string> ?? new();
    var selectedSex = ViewData["Sex"]?.ToString();
}

<!-- Success Modal -->
<div class="modal fade" id="successModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-body text-center p-4">
                <!-- Success Icon -->
                <div class="mb-3">
                    <i class="fas fa-check-circle text-success" style="font-size: 3rem;"></i>
                </div>

                <!-- Success Message -->
                <h5 class="modal-title text-success mb-2" id="successModalLabel">Changes Saved Successfully!</h5>
                <p class="text-muted mb-3">Your updates have been saved. You will be redirected shortly.</p>

                <!-- Countdown Timer -->
                <div class="d-flex justify-content-center align-items-center mb-3">
                    <div class="spinner-border spinner-border-sm text-success me-2" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <small class="text-muted">Redirecting in <span id="countdown">2</span> seconds...</small>
                </div>

                <!-- Manual Redirect Button -->
                <button type="button" class="btn btn-success btn-sm" onclick="redirectToList()">
                    Go Back Now
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Image Zoom Modal -->
<div id="zoomModal" class="zoom-modal">
    <span class="close-zoom">&times;</span>
    <img class="zoom-modal-content" id="zoomedImage">
</div>

<!-- PDF Viewer Modal -->
<div id="pdfViewerModal" class="pdf-viewer-modal">
    <div class="pdf-viewer-content">
        <div class="pdf-viewer-header">
            <span class="pdf-viewer-title" id="pdfViewerTitle">PDF Document</span>
            <div class="pdf-controls">
                <button class="btn btn-sm btn-light" onclick="prevPage()" id="prevBtn">
                    <i class="fas fa-chevron-left"></i> Previous
                </button>
                <span class="page-info" id="pageInfo">Page: <span id="currentPage">1</span> / <span id="totalPages">1</span></span>
                <button class="btn btn-sm btn-light" onclick="nextPage()" id="nextBtn">
                    Next <i class="fas fa-chevron-right"></i>
                </button>
                <button class="btn btn-sm btn-light" onclick="zoomOut()">
                    <i class="fas fa-search-minus"></i>
                </button>
                <span class="zoom-level" id="zoomLevel">100%</span>
                <button class="btn btn-sm btn-light" onclick="zoomIn()">
                    <i class="fas fa-search-plus"></i>
                </button>
            </div>
            <button class="pdf-viewer-close" onclick="closePDFViewer()">&times;</button>
        </div>
        <div class="pdf-viewer-body">
            <div id="pdfLoading" class="pdf-loading">
                <div class="spinner-border text-light" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p>Loading PDF document...</p>
            </div>
            <div id="pdfError" class="pdf-error">
                <i class="fas fa-exclamation-triangle"></i>
                <p>Error loading PDF. Please try again.</p>
            </div>
            <div class="pdf-container">
                <canvas id="pdfCanvas"></canvas>
            </div>
        </div>
    </div>
</div>

<form asp-action="OtherAssistanceEdit" enctype="multipart/form-data" method="post" id="editForm">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    @if (ViewData["IsRetakeMode"] != null && (bool)ViewData["IsRetakeMode"])
    {
        <div class="alert alert-warning" role="alert">
            <i class="fas fa-info-circle"></i> <strong>Retake Mode:</strong> Please review and update your information and attachments as needed.
        </div>
    }

    <!-- Patient Information -->
    <div class="form-section">
        <h5 class="section-header">Patient Information</h5>
        <div class="row g-3">
            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Last Name</label>
                <input value="@ViewData["Lastname"]" asp-for="Lastname" type="text" class="form-control" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')" required>
                <span asp-validation-for="Lastname" class="text-danger"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">First Name</label>
                <input value="@ViewData["Firstname"]" asp-for="Firstname" type="text" class="form-control" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')" required>
                <span asp-validation-for="Firstname" class="text-danger"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Middle Name</label>
                <input value="@ViewData["Middlename"]" asp-for="Middlename" type="text" class="form-control" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')">
                <span asp-validation-for="Middlename" class="text-danger"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Suffix</label>
                <select class="form-select" asp-for="Suffix">
                    <option value="None" selected="@(ViewData["Suffix"]?.ToString() == "None")">None</option>
                    <option value="Jr." selected="@(ViewData["Suffix"]?.ToString() == "Jr.")">Jr.</option>
                    <option value="Sr." selected="@(ViewData["Suffix"]?.ToString() == "Sr.")">Sr.</option>
                    <option value="II" selected="@(ViewData["Suffix"]?.ToString() == "II")">II</option>
                    <option value="III" selected="@(ViewData["Suffix"]?.ToString() == "III")">III</option>
                    <option value="IV" selected="@(ViewData["Suffix"]?.ToString() == "IV")">IV</option>
                    <option value="V" selected="@(ViewData["Suffix"]?.ToString() == "V")">V</option>
                </select>
                <span asp-validation-for="Suffix" class="text-danger"></span>
            </div>
        </div>

        <div class="row g-3 mt-2">
            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Blk / Lot / Street</label>
                <input value="@ViewData["BlkLotStreet"]" asp-for="BlkLotStreet" type="text" class="form-control" required>
                <span asp-validation-for="BlkLotStreet" class="text-danger"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Sub / Vill.</label>
                <input value="@ViewData["SubVill"]" asp-for="SubVill" type="text" class="form-control">
                <span asp-validation-for="SubVill" class="text-danger"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Barangay</label>
                <input value="@ViewData["Brgy"]" asp-for="Brgy" type="text" class="form-control" required>
                <span asp-validation-for="Brgy" class="text-danger"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">District</label>
                <input value="@ViewData["District"]" asp-for="District" type="text" class="form-control" required>
                <span asp-validation-for="District"></span>
            </div>
        </div>

        <div class="row g-3 mt-2">
            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Date of Birth</label>
                <input value="@ViewData["Dateofbirth"]" asp-for="Dateofbirth" type="date" class="form-control" required>
                <span asp-validation-for="Dateofbirth" class="text-danger"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Age</label>
                <input value="@ViewData["Age"]" asp-for="Age" type="number" class="form-control">
                <span asp-validation-for="Age" class="text-danger"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label required-field">Sex</label>
                <select asp-for="Sex" class="form-select" required>
                    <option value="">Select Sex</option>
                    <option value="Male" selected="@(ViewData["Sex"]?.ToString() == "Male")">Male</option>
                    <option value="Female" selected="@(ViewData["Sex"]?.ToString() == "Female")">Female</option>
                </select>
                <span asp-validation-for="Sex" class="text-danger"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">PhilHealth</label>
                <select class="form-select" asp-for="PhilHealth" id="philHealthSelect">
                    <option value="">Select option</option>
                    <option value="Without PhilHealth" selected="@(ViewData["PhilHealth"]?.ToString() == "Without PhilHealth")">Without PhilHealth</option>
                    <option value="With PhilHealth" selected="@(ViewData["PhilHealth"]?.ToString() == "With PhilHealth")">With PhilHealth</option>
                </select>
                <span asp-validation-for="PhilHealth" class="text-danger"></span>
            </div>
        </div>

        <div class="row g-3 mt-2">
            <div class="col-12 col-sm-12 col-md-6 col-lg-6">
                <label class="form-label">PhilHealth Number (if applicable)</label>
                <input asp-for="PhilHealthNo" type="text" class="form-control" id="philHealthNo">
                <span asp-validation-for="PhilHealthNo" class="text-danger"></span>
            </div>
        </div>
    </div>

    <!-- Requestor Information -->
    <div class="form-section">
        <h5 class="section-header">Requestor's Details</h5>
        <div class="row g-3">
            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Last Name</label>
                <input value="@ViewData["RLastname"]" asp-for="RLastname" type="text" class="form-control" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')">
                <span asp-validation-for="RLastname"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">First Name</label>
                <input value="@ViewData["RFirstname"]" asp-for="RFirstname" type="text" class="form-control" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')">
                <span asp-validation-for="RFirstname"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Middle Name</label>
                <input value="@ViewData["RMiddlename"]" asp-for="RMiddlename" type="text" class="form-control" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')">
                <span asp-validation-for="RMiddlename"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Suffix</label>
                <select class="form-select" asp-for="RSuffix">
                    <option value="None" selected="@(ViewData["RSuffix"]?.ToString() == "None")">None</option>
                    <option value="Jr." selected="@(ViewData["RSuffix"]?.ToString() == "Jr.")">Jr.</option>
                    <option value="Sr." selected="@(ViewData["RSuffix"]?.ToString() == "Sr.")">Sr.</option>
                    <option value="II" selected="@(ViewData["RSuffix"]?.ToString() == "II")">II</option>
                    <option value="III" selected="@(ViewData["RSuffix"]?.ToString() == "III")">III</option>
                    <option value="IV" selected="@(ViewData["RSuffix"]?.ToString() == "IV")">IV</option>
                    <option value="V" selected="@(ViewData["RSuffix"]?.ToString() == "V")">V</option>
                </select>
                <span asp-validation-for="RSuffix"></span>
            </div>
        </div>

        <div class="row g-3 mt-2">
            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Blk / Lot / Street</label>
                <input value="@ViewData["RBlkLotStreet"]" asp-for="RBlkLotStreet" type="text" class="form-control">
                <span asp-validation-for="RBlkLotStreet"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Sub / Vill.</label>
                <input value="@ViewData["RSubVill"]" asp-for="RSubVill" type="text" class="form-control">
                <span asp-validation-for="RSubVill"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">Barangay</label>
                <input value="@ViewData["RBrgy"]" asp-for="RBrgy" type="text" class="form-control">
                <span asp-validation-for="RBrgy"></span>
            </div>

            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <label class="form-label">District</label>
                <input value="@ViewData["RDistrict"]" asp-for="RDistrict" type="text" class="form-control">
                <span asp-validation-for="RDistrict"></span>
            </div>
        </div>

        <div class="row g-3 mt-2">
            <div class="col-12 col-sm-12 col-md-6 col-lg-6">
                <label class="form-label">Relationship to Patient</label>
                <input value="@ViewData["RelationshipPatient"]" asp-for="RelationshipPatient" type="text" class="form-control">
                <span asp-validation-for="RelationshipPatient"></span>
            </div>

            <div class="col-12 col-sm-12 col-md-6 col-lg-6">
                <label>Contact No.</label>
                <input value="@ViewData["ContactNo"]" asp-for="ContactNo" type="text" class="form-control" id="contactNoInput"
                       placeholder="0912-345-6789 or 02-123-4567"
                       onkeypress="return event.charCode >= 48 && event.charCode <= 57">
                <span asp-validation-for="ContactNo"></span>
                <small class="text-muted">Format: 0912-345-6789 (mobile) or 02-123-4567 (landline)</small>
            </div>
        </div>
    </div>

    <!-- Type of Assistance Requested Section - UPDATED WITH RADIO BUTTONS INSIDE THE CARD -->
    <div class="card mt-4">
        <div class="card-header">Type of Assistance Requested</div>
        <div class="card-body">
            <!-- Radio buttons now inside the card body -->
            <div class="row g-3 mb-4">
                <div class="col-12 col-sm-6 col-md-6 col-lg-6">
                    <!-- Column 1 -->
                    <div class="form-check mt-2">
                        <input class="form-check-input assistance-type" type="radio"
                               id="medicineAssistance" name="AssistanceType" value="Medicine Assistance"
                               @(checkedAssistance.ContainsKey("Medicine Assistance") || Model?.Typeassistance?.Contains("Medicine") == true ? "checked" : "")>
                        <label class="form-check-label ms-1" for="medicineAssistance">Medicine Assistance</label>
                    </div>

                    <div class="form-check mt-2">
                        <input class="form-check-input assistance-type" type="radio"
                               id="laboratoryAssistance" name="AssistanceType" value="Laboratory"
                               @(checkedAssistance.ContainsKey("Laboratory") || Model?.Typeassistance?.Contains("Laboratory") == true ? "checked" : "")>
                        <label class="form-check-label ms-1" for="laboratoryAssistance">Laboratory</label>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-md-6 col-lg-6">
                    <!-- Column 2 -->
                    <div class="form-check mt-2">
                        <input class="form-check-input assistance-type" type="radio"
                               id="therapyAssistance" name="AssistanceType" value="Therapy"
                               @(checkedAssistance.ContainsKey("Therapy") || Model?.Typeassistance?.Contains("Therapy") == true ? "checked" : "")>
                        <label class="form-check-label ms-1" for="therapyAssistance">Therapy</label>
                    </div>

                    <div class="form-check mt-2">
                        <input class="form-check-input assistance-type" type="radio"
                               id="apparatusAssistance" name="AssistanceType" value="Medical Equipment/ Apparatus"
                               @(checkedAssistance.ContainsKey("Apparatus") || Model?.Typeassistance?.Contains("Equipment") == true || Model?.Typeassistance?.Contains("Apparatus") == true ? "checked" : "")>
                        <label class="form-check-label ms-1" for="apparatusAssistance">Medical Equipment/ Apparatus</label>
                    </div>
                </div>
            </div>

            <!-- Selected Assistance Type field -->
            <div class="form-group mt-3">
                <label for="assistanceReflection" class="form-label">Selected Assistance Type:</label>
                <input asp-for="Typeassistance" type="text" class="form-control" id="assistanceReflection"
                       name="Typeassistance" placeholder="Auto-generated info..." readonly>
                <span asp-validation-for="Typeassistance" class="text-danger"></span>
            </div>
        </div>
    </div>

    <!-- Conditional Sections -->
    <!-- Medicines Section (Conditional) - SIMPLIFIED LIKE ORIGINAL FORM -->
    <div id="medicinesSection" class="card mt-4" style="display: none;">
        <div class="card-header">Medicine Details</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-lg-4 col-md-6">
                    <label class="form-label">Name of the Medicine</label>
                    <input asp-for="MedicineName" type="text" class="form-control" placeholder="Enter medicine name" value="@ViewData["MedicineName"]">
                    <span asp-validation-for="MedicineName" class="text-danger"></span>
                </div>
                <div class="col-lg-4 col-md-6">
                    <label class="form-label">Quantity</label>
                    <input asp-for="MedicineQuantity" type="text" class="form-control" placeholder="Enter quantity" value="@ViewData["MedicineQuantity"]">
                    <span asp-validation-for="MedicineQuantity" class="text-danger"></span>
                </div>
                <div class="col-lg-4 col-md-12">
                    <label class="form-label">Cost</label>
                    <input asp-for="MedicineCost" type="text" class="form-control" placeholder="Enter cost (e.g., ₱500.00)" value="@ViewData["MedicineCost"]">
                    <span asp-validation-for="MedicineCost" class="text-danger"></span>
                </div>
            </div>
            <div class="row g-3 mt-2">
                <div class="col-lg-6 col-md-12">
                    <label class="form-label">Prescribing Doctor/ Medical Practitioner</label>
                    <input asp-for="PrescribingDoctor" type="text" class="form-control" placeholder="Enter doctor's name" value="@ViewData["PrescribingDoctor"]">
                    <span asp-validation-for="PrescribingDoctor" class="text-danger"></span>
                </div>
                <div class="col-lg-6 col-md-12">
                    <label class="form-label">Contact Detail of the Prescribing Doctor</label>
                    <input asp-for="DoctorContactDetail" type="text" class="form-control" placeholder="Enter contact number" value="@ViewData["DoctorContactDetail"]">
                    <span asp-validation-for="DoctorContactDetail" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Laboratory Tests Section (Conditional) - SIMPLIFIED LIKE ORIGINAL FORM -->
    <div id="laboratorySection" class="card mt-4" style="display: none;">
        <div class="card-header">Laboratory Test Details</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-lg-6 col-md-12">
                    <label class="form-label">Laboratory or Diagnostic Center Name</label>
                    <input asp-for="LaboratoryCenterName" type="text" class="form-control" placeholder="Enter laboratory name" value="@ViewData["LaboratoryCenterName"]">
                    <span asp-validation-for="LaboratoryCenterName" class="text-danger"></span>
                </div>
                <div class="col-lg-6 col-md-12">
                    <label class="form-label">Laboratory or Diagnostic Center Address</label>
                    <input asp-for="LaboratoryCenterAddress" type="text" class="form-control" placeholder="Enter address" value="@ViewData["LaboratoryCenterAddress"]">
                    <span asp-validation-for="LaboratoryCenterAddress" class="text-danger"></span>
                </div>
            </div>
            <div class="row g-3 mt-2">
                <div class="col-lg-4 col-md-6">
                    <label class="form-label">Name of the Test</label>
                    <input asp-for="TestName" type="text" class="form-control" placeholder="Enter test name" value="@ViewData["TestName"]">
                    <span asp-validation-for="TestName" class="text-danger"></span>
                </div>
                <div class="col-lg-4 col-md-6">
                    <label class="form-label">Cost</label>
                    <input asp-for="TestCost" type="text" class="form-control" placeholder="Enter cost (e.g., ₱1,500.00)" value="@ViewData["TestCost"]">
                    <span asp-validation-for="TestCost" class="text-danger"></span>
                </div>
                <div class="col-lg-4 col-md-12">
                    <label class="form-label">Other Information</label>
                    <input asp-for="TestOtherInfo" type="text" class="form-control" placeholder="Enter other information" value="@ViewData["TestOtherInfo"]">
                    <span asp-validation-for="TestOtherInfo" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Therapy Section (Conditional) - SIMPLIFIED LIKE ORIGINAL FORM -->
    <div id="therapySection" class="card mt-4" style="display: none;">
        <div class="card-header">Therapy/Rehabilitation Details</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-lg-6 col-md-12">
                    <label class="form-label">Therapy or Rehabilitation Facility Name</label>
                    <input asp-for="TherapyFacilityName" type="text" class="form-control" placeholder="Enter facility name" value="@ViewData["TherapyFacilityName"]">
                    <span asp-validation-for="TherapyFacilityName" class="text-danger"></span>
                </div>
                <div class="col-lg-6 col-md-12">
                    <label class="form-label">Facility Address</label>
                    <input asp-for="TherapyFacilityAddress" type="text" class="form-control" placeholder="Enter facility address" value="@ViewData["TherapyFacilityAddress"]">
                    <span asp-validation-for="TherapyFacilityAddress" class="text-danger"></span>
                </div>
            </div>
            <div class="row g-3 mt-2">
                <div class="col-lg-4 col-md-6">
                    <label class="form-label">Facility Contact Detail</label>
                    <input asp-for="TherapyFacilityContact" type="text" class="form-control" placeholder="Enter contact number" value="@ViewData["TherapyFacilityContact"]">
                    <span asp-validation-for="TherapyFacilityContact" class="text-danger"></span>
                </div>
                <div class="col-lg-8 col-md-12">
                    <label class="form-label">Type or Name of Therapy or Rehabilitation Done</label>
                    <input asp-for="TherapyType" type="text" class="form-control" placeholder="Enter therapy type" value="@ViewData["TherapyType"]">
                    <span asp-validation-for="TherapyType" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Medical Equipment/Apparatus Section (Conditional) - SIMPLIFIED LIKE ORIGINAL FORM -->
    <div id="apparatusSection" class="card mt-4" style="display: none;">
        <div class="card-header">Medical Equipment/Apparatus Details</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-lg-6 col-md-12">
                    <label class="form-label">Equipment Name</label>
                    <input asp-for="EquipmentName" type="text" class="form-control" placeholder="Enter equipment name" value="@ViewData["EquipmentName"]">
                    <span asp-validation-for="EquipmentName" class="text-danger"></span>
                </div>
                <div class="col-lg-6 col-md-12">
                    <label class="form-label">Brand (if applicable)</label>
                    <input asp-for="EquipmentBrand" type="text" class="form-control" placeholder="Enter brand name" value="@ViewData["EquipmentBrand"]">
                    <span asp-validation-for="EquipmentBrand" class="text-danger"></span>
                </div>
            </div>
            <div class="row g-3 mt-2">
                <div class="col-lg-4 col-md-6">
                    <label class="form-label">Category/ Type</label>
                    <input asp-for="EquipmentCategory" type="text" class="form-control" placeholder="Enter category or type" value="@ViewData["EquipmentCategory"]">
                    <span asp-validation-for="EquipmentCategory" class="text-danger"></span>
                </div>
                <div class="col-lg-4 col-md-6">
                    <label class="form-label">Quantity Needed</label>
                    <input asp-for="EquipmentQuantity" type="number" class="form-control" placeholder="Enter quantity" min="1" value="@ViewData["EquipmentQuantity"]">
                    <span asp-validation-for="EquipmentQuantity" class="text-danger"></span>
                </div>
                <div class="col-lg-4 col-md-12">
                    <label class="form-label">Cost</label>
                    <input asp-for="EquipmentCost" type="text" class="form-control" placeholder="Enter cost (e.g., ₱5,000.00)" value="@ViewData["EquipmentCost"]">
                    <span asp-validation-for="EquipmentCost" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Upload Section -->
    <div class="card mt-4">
        <div class="card-header">Upload Required Documents</div>
        <div class="card-body">
            <div class="mb-3">
                <label>Other Assistance Document</label>

                @if (ViewData["OtherAssistanceDocument"] != null)
                {
                    <div class="current-file">
                        <strong>Current Document:</strong> @ViewData["OtherAssistanceDocument"]
                        @if (ViewData["OtherAssistanceDocumentBase64"] != null)
                        {
                            <div class="mt-2">
                                @if (ViewData["IsOtherAssistanceDocumentPdf"] != null && (bool)ViewData["IsOtherAssistanceDocumentPdf"])
                                {
                                    <div class="pdf-preview" onclick="viewPDFInModal('@ViewData["OtherAssistanceDocument"]', 'otherassistance', 'Other Assistance Document')">
                                        <div class="pdf-icon"><i class="fas fa-file-pdf"></i></div>
                                        <div class="pdf-info">
                                            <span class="pdf-filename">@ViewData["OtherAssistanceDocument"]</span>
                                            <span class="pdf-label">Click to view PDF</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="document-preview-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["OtherAssistanceDocumentBase64"]')">
                                        <img src="data:image/jpeg;base64,@ViewData["OtherAssistanceDocumentBase64"]" alt="Other Assistance Document" class="document-preview" />
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                <div class="upload-box" onclick="document.getElementById('otherDocument').click()">
                    <div class="upload-icon">
                        <i class="fas fa-file-medical"></i>
                    </div>
                    <p id="uploadTextOther">Click to upload new document</p>
                    <p id="fileNameOther" class="text-success fw-bold mt-2"></p>
                    <p class="form-note">Accepted formats: JPG, PNG, PDF (Max 10MB)</p>
                </div>

                <input asp-for="OtherAssistanceDocument"
                       type="file"
                       id="otherDocument"
                       class="d-none"
                       accept=".png,.jpg,.jpeg,.pdf"
                       onchange="handleFileSelect(this)">
                <span asp-validation-for="OtherAssistanceDocument"></span>

                <img id="otherDocumentPreview" class="img-preview mt-2" alt="Other Assistance Document Preview">
                <div id="fileStatus" class="file-status"></div>
                <p class="form-note">* Only images will be shown in preview. PDF files will be accepted but not previewed.</p>
            </div>
        </div>
    </div>

    <!-- Submit Button -->
    <div class="text-center mt-4 mb-4">
        <button type="submit" class="btn btn-submit">
            <i class="bi bi-save"></i> Save Changes
        </button>
    </div>
</form>

