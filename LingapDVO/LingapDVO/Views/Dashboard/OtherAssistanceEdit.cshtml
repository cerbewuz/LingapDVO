    <!-- Type of Assistance Requested Section -->
    <div class="card mt-4">
        <div class="card-header">Type of Assistance Requested</div>
        <div class="card-body">
            <!-- Radio buttons now inside the card body -->
            <div class="row g-3 mb-4">
