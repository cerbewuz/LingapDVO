                                        <img src="data:image/jpeg;base64,@ViewData["MedicalCertificateBase64"]" alt="Medical Certificate" class="document-preview" />
                                        <div class="preview-overlay"><i class="fas fa-search-plus"></i> Click to zoom</div>
                                    </div>
                                }
                            </div>
                        }

                        @if (ViewData["DeathCertificate"] != null && ViewData["DeathCertificateBase64"] != null)
                        {
                            <div class="document-item">
                                <p class="current-document-name"><strong>Death Certificate:</strong> @ViewData["DeathCertificate"]</p>
                                @if (ViewData["IsDeathCertificatePdf"] is bool isPdfDeath && isPdfDeath)
                                {
                                    <div class="pdf-preview" onclick="viewPDFInModal('@ViewData["DeathCertificate"]', 'deathcertificate', 'Death Certificate')">
