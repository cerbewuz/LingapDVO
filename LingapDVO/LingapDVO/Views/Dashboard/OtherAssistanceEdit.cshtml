    <!-- Upload Section -->
    <div class="card mt-4">
        <div class="card-header">Upload Required Documents</div>
        <div class="card-body">
            @{
                var hasExistingDocument = ViewData["DoctorPrescription"] != null || ViewData["MedicalCertificate"] != null || ViewData["DeathCertificate"] != null;
            }

            <!-- Current Uploaded Document Box -->
            @if (hasExistingDocument)
            {
                <div class="current-document-box mb-3">
                    <div class="current-document-header">
                        <i class="fas fa-file-alt"></i> Current Uploaded Documents
                    </div>
                    <div class="current-document-body">
                        @if (ViewData["DoctorPrescription"] != null && ViewData["DoctorPrescriptionBase64"] != null)
                        {
                            <div class="document-item mb-3">
                                <p class="current-document-name"><strong>Doctor's Prescription:</strong> @ViewData["DoctorPrescription"]</p>
                                @if (ViewData["IsDoctorPrescriptionPdf"] is bool isPdfDoc && isPdfDoc)
                                {
                                    <div class="pdf-preview" onclick="viewPDFInModal('@ViewData["DoctorPrescription"]', 'doctorprescription', 'Doctor Prescription')">
