                gap: 1rem;
                margin-top: 1rem;
            }

            .updates-grid-collage {
                grid-template-rows: repeat(3, 130px);
                gap: 0.35rem;
            }

            .updates-info-section {
                position: relative;
                top: auto;
                padding: 1rem;
            }

            .info-title {
                font-size: 1.25rem;
            }

            .info-description {
                font-size: 0.825rem;
            }

            .highlight-item {
                font-size: 0.8rem;
            }

            .info-cta-button {
                font-size: 0.85rem;
                padding: 0.7rem 1.35rem;
            }
        }

        @@media (max-width: 767px) {
            .features-section,
            .process-section,
            .updates-section {
                padding: 2rem 0;
            }

            .section-header {
                margin-bottom: 1.5rem;
            }

            .section-title {
                font-size: 1.75rem;
            }

            .section-description {
                font-size: 0.95rem;
            }

            .hero-buttons {
                flex-direction: column;
                gap: 0.875rem;
            }

            .btn-primary-custom,
            .btn-secondary-custom {
                width: 100%;
                justify-content: center;
                padding: 0.7rem 1.35rem;
                font-size: 0.875rem;
            }

            .feature-card {
                margin-bottom: 1.35rem;
                padding: 1.35rem 1.15rem;
            }

            .feature-icon {
                width: 50px;
                height: 50px;
                font-size: 1.25rem;
            }

            .process-section {
                padding: 1.75rem 0;
            }

            .process-step {
                gap: 0.875rem;
                margin-bottom: 1.25rem;
            }

            .process-number {
                width: 45px;
                height: 45px;
                font-size: 1.1rem;
            }

            .process-timeline::before {
                left: 22.5px;
                top: 50px;
                bottom: 50px;
                width: 2px;
            }

            .process-content {
                padding: 0.875rem 1rem;
            }

            .process-title {
                font-size: 1rem;
            }

            .process-description {
                font-size: 0.875rem;
            }

            .updates-section {
                padding: 1.6rem 0;
            }

            .updates-grid-wrapper {
