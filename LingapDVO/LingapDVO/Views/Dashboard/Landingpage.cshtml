            <!-- Zoom Controls -->
            <div class="zoom-controls" role="toolbar" aria-label="Image zoom controls">
                <button class="zoom-btn" id="zoomOutBtn" title="Zoom Out" aria-label="Zoom out">
                    <i class="fas fa-minus" aria-hidden="true"></i>
                </button>
                <div class="zoom-indicator" id="zoomIndicator" aria-live="polite">100%</div>
                <button class="zoom-btn" id="zoomInBtn" title="Zoom In" aria-label="Zoom in">
                    <i class="fas fa-plus" aria-hidden="true"></i>
                </button>
                <button class="zoom-btn" id="resetZoomBtn" title="Reset Zoom" aria-label="Reset zoom">
                    <i class="fas fa-undo" aria-hidden="true"></i>
                </button>
            </div>
            <div class="modal-caption" id="modalCaption"></div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="modern-footer" role="contentinfo">
        <div class="container">
            <div class="footer-content">
                <p class="footer-copyright">&copy; 2025 LingapDVO. All rights for Dabawenyos</p>
                <div class="footer-contacts">
                    <span>(082) 298-1234</span>
                    <span>mclingapdesk@gmail.com</span>
                    <a href="https://www.facebook.com/lingapparasamahirap" class="footer-social-link" target="_blank" rel="noopener noreferrer" aria-label="Visit our Facebook page">
                        <i class="fab fa-facebook-f" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </div>
