    <style>
        /* ===========================
           ADAPTIVE NAVBAR SYSTEM
           Automatically adjusts to section background colors
        =========================== */

        h1 {
            color: antiquewhite;
            transition: color 0.6s cubic-bezier(0.4, 0, 0.2, 1), text-shadow 0.6s cubic-bezier(0.4, 0, 0.2, 1), transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
            transform: translateY(0);
        }

        .site-navbar {
            background: transparent;
            height: clamp(70px, 12vw, 100px);
            padding-top: clamp(10px, 2vw, 14px);
            padding-bottom: clamp(14px, 3vw, 20px);
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
            transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        /* When on LIGHT background sections - Use DARK navbar for visibility */
        .site-navbar.on-light-bg {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
            border-bottom: 1px solid rgba(220, 20, 60, 0.1);
        }

        .site-navbar.on-light-bg h1 {
            color: #DC143C;
            text-shadow: 0 6px 12px rgba(220, 20, 60, 0.4);
            transform: translateY(-2px) scale(1.02);
        }

        .site-navbar.on-light-bg .nav-btn {
            color: #DC143C;
        }

        /* When on DARK background sections - Use LIGHT navbar for visibility */
        .site-navbar.on-dark-bg {
            background: rgba(52, 58, 64, 0.95);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.2);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .site-navbar.on-dark-bg h1 {
            color: #ffffff;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        }

        .site-navbar.on-dark-bg .nav-btn {
            color: #ffffff;
        }

        /* Top of page - Transparent navbar */
        .site-navbar.at-top {
            background: transparent;
        }

        .site-navbar.at-top h1 {
            color: antiquewhite;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
        }

        .site-navbar.at-top .nav-btn {
            color: #ffffff;
        }

        /* Nav Button Base Styles */
        .nav-btn {
            background: none;
            border: none;
            font-weight: 700;
            font-size: clamp(14px, 3vw, 20px);
            padding: clamp(10px, 2vw, 14px) clamp(18px, 3vw, 28px);
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            border-radius: clamp(6px, 1.5vw, 8px);
            position: relative;
            overflow: hidden;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        /* Hover states based on navbar background */
        .site-navbar.on-light-bg .nav-btn:hover {
            color: #ffffff;
            background: #DC143C;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(220, 20, 60, 0.4);
        }

        .site-navbar.on-dark-bg .nav-btn:hover {
            color: #343a40;
            background: rgba(255, 255, 255, 0.9);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(255, 255, 255, 0.4);
        }

        .site-navbar.at-top .nav-btn:hover {
            color: #DC143C;
            transform: translateY(-2px);
            background: rgba(220, 20, 60, 0.1);
            box-shadow: 0 4px 15px rgba(220, 20, 60, 0.2);
        }

        .site-navbar,
        .nav-btn {
            isolation: isolate;
        }

        /* Navbar Brand */
        .navbar-brand {
            transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        .site-navbar.on-light-bg .navbar-brand,
        .site-navbar.on-dark-bg .navbar-brand {
            transform: scale(clamp(0.85, 1.5vw, 0.95));
        }

        /* Mobile Menu Toggle Icon */
        .site-menu-toggle {
            transition: all 0.3s ease;
        }

        .site-menu-toggle .icon-menu {
            color: #ffffff;
            transition: color 0.3s ease;
        }

        .site-navbar.on-light-bg .site-menu-toggle .icon-menu {
            color: #DC143C;
        }

        .site-navbar.on-dark-bg .site-menu-toggle .icon-menu {
            color: #ffffff;
        }

        .site-navbar.at-top .site-menu-toggle .icon-menu {
            color: #ffffff;
        }

        /* Mobile Menu Adaptive Colors */
        .site-mobile-menu {
            background-color: rgba(0, 0, 0, 0.95);
            backdrop-filter: blur(20px);
            color: white;
            position: fixed;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: 2000;
        }

        .site-mobile-menu a,
        .site-mobile-menu .nav-btn {
            color: white;
            font-weight: 700;
            font-size: clamp(16px, 3.5vw, 18px);
            transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            padding: clamp(12px, 2.5vw, 14px) clamp(20px, 4vw, 24px);
            border-radius: clamp(4px, 1vw, 6px);
            display: block;
        }

        .site-mobile-menu a:hover,
        .site-mobile-menu .nav-btn:hover {
            color: #DC143C;
            background: rgba(255, 255, 255, 0.1);
            transform: translateX(clamp(3px, 1vw, 5px));
        }

        
        .application-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #DC143C 0%, #B22222 100%);
            color: white;
            font-weight: 700;
            font-size: 1.25rem;
            padding: 16px 32px;
            border-radius: 50px;
            text-decoration: none;
            transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            box-shadow: 0 8px 25px rgba(220, 20, 60, 0.4);
            margin-top: 20px;
            position: relative;
            overflow: hidden;
            letter-spacing: 0.5px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            text-transform: uppercase;
        }

        .application-btn i {
            margin-right: 12px;
            font-size: 1.5rem;
            transition: transform 0.3s ease;
        }

        .application-btn:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 35px rgba(220, 20, 60, 0.6);
            color: white;
            text-decoration: none;
        }

            .application-btn:hover i {
                transform: scale(1.2);
            }

        .application-btn:active {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(220, 20, 60, 0.5);
        }

        .application-btn {
            animation: none; 
        }

        
        .application-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            border-radius: 50px;
            box-shadow: 0 8px 25px rgba(220, 20, 60, 0.4);
            opacity: 0;
            transition: opacity 0.4s ease, box-shadow 0.4s ease;
        }

        .application-btn:hover::before {
            opacity: 1;
            box-shadow: 0 8px 35px rgba(220, 20, 60, 0.7);
        }

        
        .application-btn {
            box-shadow: 0 8px 25px rgba(220, 20, 60, 0.4), 0 0 0 0 rgba(220, 20, 60, 0.7);
            transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

            .application-btn:hover {
                box-shadow: 0 12px 35px rgba(220, 20, 60, 0.6), 0 0 0 10px rgba(220, 20, 60, 0);
            }

        
        .application-btn {
            font-size: clamp(1.1rem, 2.5vw, 1.25rem);
            padding: clamp(14px, 3vw, 16px) clamp(28px, 4vw, 32px);
        }
    </style>
</head>

