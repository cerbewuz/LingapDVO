            .process-step {
                gap: 1.5rem;
            }

            .process-number {
                width: 60px;
                height: 60px;
                font-size: 1.5rem;
            }

            .process-timeline::before {
                left: 30px;
            }

            .contact-card {
                margin-bottom: 2rem;
            }

            .about-image {
                margin-bottom: 2rem;
            }
        }

        @@media (max-width: 575px) {
            .hero-stats {
                flex-direction: column;
                gap: 1rem;
            }

            .modern-navbar {
                padding: 1rem 0;
            }

            .process-content:hover {
                transform: translateX(0);
            }
        }

        /* ===========================
           SCROLL ANIMATIONS
        =========================== */
        .fade-in-up {
            opacity: 0;
            transform: translateY(50px);
            transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .fade-in-up.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .fade-in {
            opacity: 0;
            transition: opacity 0.8s ease;
        }

        .fade-in.visible {
            opacity: 1;
        }

        /* Loading Screen */
        .loading-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background: var(--white);
            display: flex;
            align-items: center;
