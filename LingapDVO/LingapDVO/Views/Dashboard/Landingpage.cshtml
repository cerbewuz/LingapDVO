@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <!-- Primary Meta Tags -->
    <title>Lingap Online - Free Medical & Financial Assistance for Dabawenyos | Davao City Government</title>
    <meta name="title" content="Lingap Online - Free Medical & Financial Assistance for Dabawenyos">
    <meta name="description" content="Apply for free medical assistance, hospital bills, funeral aid, and financial support online. Lingap Program provides fast, accessible help to Davao City residents in need.">
    <meta name="keywords" content="Lingap, Davao City, medical assistance, financial aid, hospital bills, funeral assistance, government help, Dabawenyo, free healthcare">
    <meta name="author" content="Davao City Government">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://lingap.online/">

    <!-- Open Graph / Facebook -->
