            align-items: center;
            justify-content: center;
            color: var(--white);
            font-size: 1.25rem;
            text-decoration: none;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .social-link:hover {
            background: var(--gradient-primary);
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(220, 20, 60, 0.4);
        }

        .footer-bottom {
            margin-top: 4rem;
            padding-top: 2rem;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            text-align: center;
            font-size: 0.95rem;
        }

        /* ===========================
           RESPONSIVE
        =========================== */
        @@media (max-width: 991px) {
            .modern-nav-links {
                display: none;
            }

            .about-content {
                padding-left: 0;
                margin-top: 3rem;
            }

            .process-timeline::before {
                left: 40px;
            }

            .hero-title {
                font-size: 2.5rem;
            }

            .hero-subtitle {
                font-size: 1.1rem;
            }

            .features-section,
            .about-section,
            .process-section,
            .contact-section {
                padding: 5rem 0;
            }

            .section-header {
                margin-bottom: 3rem;
            }
        }

        @@media (max-width: 767px) {
            .hero-buttons {
                flex-direction: column;
                gap: 1rem;
            }

            .btn-primary-custom,
            .btn-secondary-custom {
                width: 100%;
                justify-content: center;
            }

            .hero-stats {
                gap: 1.5rem;
            }

            .stat-number {
                font-size: 2rem;
