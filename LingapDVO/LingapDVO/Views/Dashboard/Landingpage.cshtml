    <script>
        // Application Modal Functionality
        document.addEventListener('DOMContentLoaded', function() {
            const applicationModal = document.getElementById('applicationModal');
            const closeModal = document.getElementById('closeModal');
            const applicationBtns = document.querySelectorAll('.application-btn');

            // Function to open modal
            function openApplicationModal() {
                applicationModal.classList.add('active');
                document.documentElement.classList.add('modal-open');
                document.body.classList.add('modal-open');
            }

            // Function to close modal
            function closeApplicationModal() {
                applicationModal.classList.remove('active');
                document.documentElement.classList.remove('modal-open');
                document.body.classList.remove('modal-open');
            }

            // Add click event to application buttons
            applicationBtns.forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    openApplicationModal();
                });
            });

            // Close modal when close button is clicked
            closeModal.addEventListener('click', closeApplicationModal);

            // Close modal when clicking outside the content
            applicationModal.addEventListener('click', function(e) {
                if (e.target === applicationModal) {
                    closeApplicationModal();
                }
            });

            // Close modal with Escape key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && applicationModal.classList.contains('active')) {
                    closeApplicationModal();
                }
            });

            // Prevent modal content click from closing modal
            document.querySelector('.modal-content').addEventListener('click', function(e) {
                e.stopPropagation();
            });

            // Mobile menu toggle functionality
            const mobileMenuToggle = document.querySelector('.js-menu-toggle');
            const mobileMenu = document.querySelector('.site-mobile-menu');

            if (mobileMenuToggle && mobileMenu) {
                mobileMenuToggle.addEventListener('click', function(e) {
                    e.preventDefault();
                    mobileMenu.classList.toggle('active');
                });
            }

            // ===========================
            // ADAPTIVE NAVBAR COLOR SYSTEM
            // Automatically changes navbar colors based on section backgrounds
            // ===========================

            const navbar = document.querySelector('.site-navbar');

            // Define sections and their background types
            // 'light' = light/white background section (needs dark text navbar)
            // 'dark' = dark background section (needs light text navbar)
            const sections = [
                { id: 'home-section', bg: 'dark' },          // Dark background image - needs light navbar
                { id: 'about-section', bg: 'light' },        // White background - needs dark navbar
                { id: 'next', bg: 'light' },                 // White background - needs dark navbar
                { id: 'contact-section', bg: 'light' }       // Light gray background - needs dark navbar
            ];

            function updateNavbarColor() {
                const scrollPosition = window.scrollY;
                const navbarHeight = navbar.offsetHeight;

                // At the very top of the page
                if (scrollPosition < 50) {
                    navbar.classList.remove('on-dark-bg', 'on-light-bg');
                    navbar.classList.add('at-top');
                    return;
                }

                navbar.classList.remove('at-top');

                // Check which section is currently in view
                let currentSection = null;

                sections.forEach(section => {
                    const element = document.getElementById(section.id);
                    if (element) {
                        const rect = element.getBoundingClientRect();
                        const sectionTop = rect.top + window.scrollY;
                        const sectionBottom = sectionTop + element.offsetHeight;

                        // Check if navbar overlaps with this section
                        if (scrollPosition >= sectionTop - navbarHeight &&
                            scrollPosition < sectionBottom - navbarHeight) {
                            currentSection = section;
                        }
                    }
                });

                // Apply appropriate navbar style
                if (currentSection) {
                    if (currentSection.bg === 'dark') {
                        // Dark section background = light navbar text
                        navbar.classList.remove('on-light-bg');
                        navbar.classList.add('on-dark-bg');
                    } else {
                        // Light section background = dark navbar text
                        navbar.classList.remove('on-dark-bg');
                        navbar.classList.add('on-light-bg');
                    }
                }
            }

            // Update navbar on scroll
            window.addEventListener('scroll', updateNavbarColor);

            // Update navbar on page load
            updateNavbarColor();

            // Update navbar on window resize (for responsive behavior)
            window.addEventListener('resize', updateNavbarColor);
        });
    </script>
