    <meta property="og:url" content="https://lingap.online/">
    <meta property="og:title" content="Lingap Online - Free Medical & Financial Assistance for Dabawenyos">
    <meta property="og:description" content="Apply for free medical assistance, hospital bills, funeral aid, and financial support online. Fast, accessible help for Davao City residents.">
    <meta property="og:image" content="https://lingap.online/images/lingap-og-image.jpg">
    <meta property="og:site_name" content="Lingap Online">
    <meta property="og:locale" content="en_PH">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://lingap.online/">
    <meta property="twitter:title" content="Lingap Online - Free Medical & Financial Assistance">
    <meta property="twitter:description" content="Apply for free medical assistance, hospital bills, funeral aid, and financial support online.">
    <meta property="twitter:image" content="https://lingap.online/images/lingap-og-image.jpg">

    <!-- Favicon & PWA -->
    <link rel="icon" type="image/x-icon" href="/Icon/lingaplogo.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/Icon/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#DC143C">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="LingapDVO">

    <!-- DNS Prefetch & Preconnect for performance -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://fonts.gstatic.com">
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com">

    <!-- Preload Critical Resources with fetchpriority -->
    <link rel="preload" href="/css/landingpage.css?v=20251201" as="style" fetchpriority="high">
    <link rel="preload" href="/images/helping.webp" as="image" type="image/webp" fetchpriority="high">
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&display=swap" as="style">
    <link rel="preload" href="/js/landingpage.js?v=20251201" as="script">

    <!-- Critical CSS - Inline for fastest initial render -->
    <style>
        :root{--primary:#DC143C;--primary-dark:#B22222;--dark:#1a1a1a;--light:#f8f9fa;--white:#fff;--shadow-md:0 4px 16px rgba(0,0,0,.12)}*{margin:0;padding:0;box-sizing:border-box}html{scroll-behavior:smooth;overflow-x:hidden}body{font-family:'Poppins',sans-serif;line-height:1.6;color:var(--dark);overflow-x:hidden;background:var(--white)}.modern-navbar{position:fixed;top:0;left:0;width:100%;z-index:1000;padding:1.5rem 0;transition:all .4s cubic-bezier(.4,0,.2,1);background:transparent}.modern-navbar.scrolled{background:rgba(255,255,255,.98);backdrop-filter:blur(20px);box-shadow:0 4px 30px rgba(0,0,0,.08);padding:1rem 0}.navbar-brand-modern{font-size:1.75rem;font-weight:800;background:linear-gradient(135deg,#DC143C 0%,#B22222 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;letter-spacing:-.5px}.hero-section{position:relative;min-height:100vh;padding:8rem 0 3rem;display:flex;align-items:center;justify-content:center;overflow:hidden}.hero-background{position:absolute;top:0;left:0;width:100%;height:100%;overflow:hidden;z-index:1}.hero-background::before{content:"";position:absolute;inset:0;background-image:url('/images/helping.webp');background-size:cover;background-position:center;background-attachment:scroll;filter:blur(10px);transform:scale(1.1);z-index:-1}@@media(min-width:768px){.hero-background::before{background-attachment:fixed}}.hero-overlay{position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.5);z-index:2}.hero-content{position:relative;z-index:10;text-align:center;padding:0 1rem;max-width:1200px;margin:0 auto}.hero-title{font-size:clamp(1.75rem,5vw,3rem);font-weight:800;color:var(--white);line-height:1.1;margin-bottom:.875rem;text-shadow:0 4px 20px rgba(0,0,0,.3);letter-spacing:-1px}.hero-subtitle{font-size:clamp(.95rem,2vw,1.1rem);color:rgba(255,255,255,.95);max-width:650px;margin:0 auto 1.25rem;line-height:1.5;font-weight:400}.loading-screen{position:fixed;top:0;left:0;width:100%;height:100vh;background:var(--white);display:flex;align-items:center;justify-content:center;z-index:9999;transition:opacity .5s ease,visibility .5s ease}.loading-screen.hide{opacity:0;visibility:hidden}.loader{width:50px;height:50px;border:5px solid var(--light);border-top-color:var(--primary);border-radius:50%;animation:spin 1s linear infinite}@@keyframes spin{to{transform:rotate(360deg)}}
    </style>

    <!-- Async load non-critical CSS -->
    <link rel="stylesheet" href="/css/landingpage.css?v=20251201" media="print" onload="this.media='all'; this.onload=null;">
    <noscript><link rel="stylesheet" href="/css/landingpage.css?v=20251201"></noscript>

    <!-- Fonts with font-display: swap - only weights we use -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">

    <!-- Async load Font Awesome with font-display -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" media="print" onload="this.media='all'">

    <!-- Bootstrap CSS - Minified -->
    <link rel="stylesheet" href="/css/bootstrap.min.css" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="/css/bootstrap.min.css"></noscript>

    <!-- Async load Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" media="print" onload="this.media='all'">

    <!-- Structured Data for SEO -->
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "GovernmentOrganization",
        "name": "Lingap Para sa Mahirap - Davao City",
        "description": "",
        "url": "https://lingap.online/",
        "logo": "https://lingap.online/Icon/lingaplogo.ico",
        "contactPoint": {
            "@@type": "ContactPoint",
            "telephone": "+63-82-298-1234",
            "contactType": "Customer Service",
            "email": "mclingapdesk@gmail.com",
            "areaServed": "PH",
            "availableLanguage": ["English", "Filipino", "Cebuano"]
        },
        "sameAs": [
            "https://www.facebook.com/lingapparasamahirap"
        ],
        "address": {
            "@@type": "PostalAddress",
            "addressLocality": "Davao City",
            "addressRegion": "Davao del Sur",
            "addressCountry": "PH"
        }
    }
    </script>
</head>

<body>
    <!-- Loading Screen -->
    <div class="loading-screen" id="loadingScreen" role="status" aria-label="Loading">
        <div class="loader" aria-hidden="true"></div>
    </div>

    <!-- Modern Navbar -->
    <nav class="modern-navbar" id="navbar" role="navigation" aria-label="Main navigation">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-auto col-lg-3">
                    <div class="navbar-brand-modern" aria-label="LingapDVO Home">LingapDVO</div>
                </div>
                <div class="col-lg-9 d-none d-lg-block">
                    <div class="modern-nav-links d-flex justify-content-end align-items-center gap-1">
                        <a href="#home" class="modern-nav-link" aria-label="Go to home section">Home</a>
                        <a href="#features" class="modern-nav-link" aria-label="Go to services section">Services</a>
                        <a href="#process" class="modern-nav-link" aria-label="Go to application process section">Process</a>
                        <a href="#updates" class="modern-nav-link" aria-label="Go to updates section">Updates</a>
                        <a href="/Login" class="modern-nav-link" aria-label="Go to login page">Login</a>
                    </div>
                </div>
                <div class="col d-lg-none text-end">
                    <button class="menu-toggle" id="menuToggle" aria-label="Open mobile menu" aria-expanded="false">
                        <span aria-hidden="true"></span>
                        <span aria-hidden="true"></span>
                        <span aria-hidden="true"></span>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Mobile Menu -->
    <div class="mobile-overlay" id="mobileOverlay" aria-hidden="true"></div>
    <div class="mobile-menu" id="mobileMenu" role="dialog" aria-modal="true" aria-label="Mobile navigation menu">
        <button class="mobile-menu-close" id="mobileMenuClose" aria-label="Close mobile menu">
            <i class="fas fa-times" aria-hidden="true"></i>
        </button>
        <div class="mobile-nav-links">
            <a href="#home" class="mobile-nav-link" aria-label="Go to home section">Home</a>
            <a href="#features" class="mobile-nav-link" aria-label="Go to services section">Services</a>
            <a href="#process" class="mobile-nav-link" aria-label="Go to application process section">Process</a>
            <a href="#updates" class="mobile-nav-link" aria-label="Go to updates section">Updates</a>
            <a href="/Login" class="mobile-nav-link" aria-label="Go to login page">Login</a>
        </div>
    </div>

    <!-- Hero Section -->
    <section class="hero-section" id="home" aria-label="Hero section">
        <div class="hero-background" aria-hidden="true"></div>
        <div class="hero-overlay" aria-hidden="true"></div>

        <div class="hero-content">
            <h1 class="hero-title">
                Lingap Para sa<br>Mahirap
            </h1>

            <p class="hero-subtitle">
                Libreng tabang medikal ug pinansyal para sa mga nanginahanglang Dabawenyo.
                The Lingap Program is an initiative of the Davao City Government to provide medical assistance.
            </p>
            <div class="hero-buttons">
                <a href="/Login" class="btn-primary-custom" id="startApplicationBtn" aria-label="Start application for assistance">
                    <span>Apply Now</span>
                </a>
                <a href="#process" class="btn-secondary-custom" aria-label="Learn how to apply for assistance">
                    <i class="fas fa-list-check" aria-hidden="true"></i>
                    <span>Learn How to Apply</span>
                </a>
            </div>
        </div>

        <div class="scroll-indicator" aria-hidden="true">
            <i class="fas fa-chevron-down"></i>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features-section" id="features" aria-labelledby="features-title">
        <div class="container">
            <div class="section-header">
                <div class="section-badge" aria-hidden="true">Serbisyo Alang sa Dabawenyo</div>
                <h2 class="section-title" id="features-title">Services Offered</h2>
                <p class="section-description">
                    LingapDVO offers various medical financial services to support every Davaoeños healthcare needs.
                </p>
            </div>

            <div class="row">
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="feature-card fade-in-up" role="article" aria-label="Hospital assistance service">
                        <div class="feature-icon" aria-hidden="true">
                            <i class="fas fa-hospital"></i>
                        </div>
                        <h3 class="feature-title">Hospital Assistance</h3>
                        <p class="feature-description">
                            Libreng tulong sa bayad sa ospital para sa mga pribadong medikal na gastusin.
                            Sumasaklaw sa iba't ibang medikal na pangangailangan at emergency cases.
                        </p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="feature-card fade-in-up" style="transition-delay: 0.1s;" role="article" aria-label="Medical assistance service">
                        <div class="feature-icon" aria-hidden="true">
                            <i class="fas fa-pills"></i>
                        </div>
                        <h3 class="feature-title">Medical Assistance</h3>
                        <p class="feature-description">
                            Suporta sa laboratory tests, dialysis treatments, at iba pang medikal na
                            prosedura. Siguradong makakatanggap ng de-kalidad na serbisyo.
                        </p>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="feature-card fade-in-up" style="transition-delay: 0.2s;" role="article" aria-label="Funeral assistance service">
                        <div class="feature-icon" aria-hidden="true">
                            <i class="fas fa-praying-hands"></i>
                        </div>
                        <h3 class="feature-title">Funeral Assistance</h3>
                        <p class="feature-description">
                            Pinansyal na tulong para sa libing at funeral expenses. Nandito kami para
                            suportahan kayo sa mahirap na panahon ng pagkawala ng mahal sa buhay.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Process Section -->
    <section class="process-section" id="process" aria-labelledby="process-title">
        <div class="container">
            <div class="section-header">
                <div class="section-badge" aria-hidden="true">Steps sa Pag-apply</div>
                <h2 class="section-title" id="process-title">Madaling Proseso ng Aplikasyon</h2>
                <p class="section-description">
                    Sundin ang apat na simpleng hakbang upang makatanggap ng libreng tulong mula sa Lingap Program
                </p>
            </div>

            <div class="process-timeline" role="list">
                <div class="process-step fade-in-up" role="listitem">
                    <div class="process-number" aria-hidden="true">1</div>
                    <div class="process-content">
                        <h3 class="process-title">Lumikha ng Account</h3>
                        <p class="process-description">
                            Magsimula sa pag-gawa ng account sa aming online platform. Simple at mabilis lang
                            ang proseso - kailangan mo lang ng basic information.
                        </p>
                    </div>
                </div>

                <div class="process-step fade-in-up" style="transition-delay: 0.1s;" role="listitem">
                    <div class="process-number" aria-hidden="true">2</div>
                    <div class="process-content">
                        <h3 class="process-title">Mag-login at I-verify</h3>
                        <p class="process-description">
                            Pagkatapos ng successful registration, mag-login at i-verify ang inyong account.
                            Mag-upload ng valid ID para sa security at verification purposes.
                        </p>
                    </div>
                </div>

                <div class="process-step fade-in-up" style="transition-delay: 0.2s;" role="listitem">
                    <div class="process-number" aria-hidden="true">3</div>
                    <div class="process-content">
                        <h3 class="process-title">Kumpletuhin ang Application</h3>
                        <p class="process-description">
                            Pumili ng uri ng tulong na kailangan ninyo at kumpletuhin ang application form.
                            I-attach ang lahat ng kinakailanganng dokumento.
                        </p>
                    </div>
                </div>

                <div class="process-step fade-in-up" style="transition-delay: 0.3s;" role="listitem">
                    <div class="process-number" aria-hidden="true">4</div>
                    <div class="process-content">
                        <h3 class="process-title">Makatanggap ng Tulong</h3>
                        <p class="process-description">
                            Maghintay ng mabilis na aprubahan at makatanggap ng libreng serbisyo. Mayroon
                            kaming tracking system para masubaybayan ninyo ang inyong application.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Updates Section -->
    <section class="updates-section" id="updates" aria-labelledby="updates-title">
        <div class="container">
            <div class="section-header">
                <div class="section-badge" aria-hidden="true">Mga Balita ug Update</div>
                <h2 class="section-title" id="updates-title">Latest Update on Lingap Para sa Mahirap</h2>
            </div>

            <div class="updates-grid-wrapper">
                <!-- Grid Collage (Left Side) - Facebook Post Style -->
                <div class="updates-grid-collage fb-style-grid" role="list">
                    <!-- First Image - Large -->
                    <div class="grid-item grid-item-1 fb-grid-main" role="listitem" data-index="0">
                        <img src="/LingapUpdate/webp/dcitizen_update1.webp" alt="DCitizen ID program announcement for Davao City residents" class="update-image" width="600" height="400" loading="lazy" decoding="async">
                        <div class="grid-overlay"></div>
                    </div>

                    <!-- Second Image - Top Right -->
                    <div class="grid-item grid-item-2 fb-grid-top-right" role="listitem" data-index="1">
                        <img src="/LingapUpdate/webp/dcitizen_update2.webp" alt="DCitizen ID registration information" class="update-image" width="300" height="400" loading="lazy" decoding="async">
                        <div class="grid-overlay"></div>
                    </div>

                    <!-- Third Image - Bottom Left -->
                    <div class="grid-item grid-item-3 fb-grid-bottom-left" role="listitem" data-index="2">
                        <img src="/LingapUpdate/webp/dcitizen_update3.webp" alt="DCitizen ID benefits and features" class="update-image" width="300" height="400" loading="lazy" decoding="async">
                        <div class="grid-overlay"></div>
                    </div>

                    <!-- Fourth Image - Bottom Right with +6 Overlay -->
                    <div class="grid-item grid-item-4 fb-grid-more" role="listitem" data-index="3">
                        <img src="/LingapUpdate/webp/dcitizen_update4.webp" alt="DCitizen ID eligibility requirements" class="update-image" width="300" height="400" loading="lazy" decoding="async">
                        <div class="grid-overlay"></div>
                        <div class="more-images-overlay" id="moreImagesOverlay">
                            <span class="more-count">+6</span>
                        </div>
                    </div>

                    <!-- Hidden Images (5-10) - Will show in modal -->
                    <div class="grid-item hidden-image" role="listitem" data-index="4" style="display: none;">
                        <img src="/LingapUpdate/webp/dcitizen_update5.webp" alt="DCitizen ID application process" class="update-image" width="300" height="400" loading="lazy" decoding="async">
                    </div>
                    <div class="grid-item hidden-image" role="listitem" data-index="5" style="display: none;">
                        <img src="/LingapUpdate/webp/dcitizen_update6.webp" alt="DCitizen ID categories and types" class="update-image" width="300" height="400" loading="lazy" decoding="async">
                    </div>
                    <div class="grid-item hidden-image" role="listitem" data-index="6" style="display: none;">
                        <img src="/LingapUpdate/webp/dcitizen_update7.webp" alt="DCitizen ID for senior citizens" class="update-image" width="300" height="400" loading="lazy" decoding="async">
                    </div>
                    <div class="grid-item hidden-image" role="listitem" data-index="7" style="display: none;">
                        <img src="/LingapUpdate/webp/dcitizen_update8.webp" alt="DCitizen ID for persons with disability" class="update-image" width="300" height="400" loading="lazy" decoding="async">
                    </div>
                    <div class="grid-item hidden-image" role="listitem" data-index="8" style="display: none;">
                        <img src="/LingapUpdate/webp/dcitizen_update9.webp" alt="DCitizen ID enrollment schedule" class="update-image" width="300" height="400" loading="lazy" decoding="async">
                    </div>
                    <div class="grid-item hidden-image" role="listitem" data-index="9" style="display: none;">
                        <img src="/LingapUpdate/webp/dcitizen_update10.webp" alt="DCitizen ID contact information" class="update-image" width="300" height="400" loading="lazy" decoding="async">
                    </div>
                </div>

                <!-- Info Section (Right Side) -->
                <div class="updates-info-section">
                    <div class="info-content">
                        <h3 class="info-title">DCitizen ID</h3>
                        <p class="info-description">
                            Davao City is launching a unified identification card for all residents of Davao City.
                        </p>
                        <div class="info-highlights">
                            <div class="highlight-item">
                                <i class="fas fa-check-circle" aria-hidden="true"></i>
                                <span>Davao City Residents</span>
                            </div>
                            <div class="highlight-item">
                                <i class="fas fa-check-circle" aria-hidden="true"></i>
                                <span>Transients</span>
                            </div>
                            <div class="highlight-item">
                                <i class="fas fa-check-circle" aria-hidden="true"></i>
                                <span>Persons with Disability</span>
                            </div>
                            <div class="highlight-item">
                                <i class="fas fa-check-circle" aria-hidden="true"></i>
                                <span>Senior Citizen</span>
                            </div>
                            <div class="highlight-item">
                                <i class="fas fa-check-circle" aria-hidden="true"></i>
                                <span>Senior Citizens with Disability</span>
                            </div>
                        </div>
                        <a href="https://www.facebook.com/DCitizenID/posts/pfbid0HN3qDNzqwcToxtpeTY2d5oM8SWC8ZR7RQ8mkH9cFgrYmdhVg23jbs5owamaCcKJtl" class="info-cta-button" aria-label="Learn more about DCitizen ID on Facebook" target="_blank" rel="noopener noreferrer">
                            <i class="fas fa-right-arrow" aria-hidden="true"></i>
                            <span>Know More</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Image Modal -->
    <div class="image-modal" id="imageModal" role="dialog" aria-modal="true" aria-label="Image viewer">
        <div class="modal-content-wrapper">
            <button class="modal-close" id="modalClose" aria-label="Close image viewer">
                <i class="fas fa-times" aria-hidden="true"></i>
            </button>
