            }

            .process-section {
                padding: 2rem 0;
            }

            .process-number {
                width: 50px;
                height: 50px;
                font-size: 1.2rem;
            }

            .hero-section {
                padding: 5.5rem 0 2rem;
            }

            .hero-title {
                font-size: 1.85rem;
            }

            .hero-subtitle {
                font-size: 0.95rem;
            }

            .btn-primary-custom,
            .btn-secondary-custom {
                padding: 0.75rem 1.5rem;
                font-size: 0.9rem;
            }

            .features-section,
