@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Our Valued Partners</title>
    <link rel="icon" type="image/x-icon" href="~/lingaplogo.ico">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <div class="partners-container">
        <!-- Go Back Button -->
        <a href="#" class="go-back-btn" id="goBackBtn" role="button" aria-label="Go back to previous page" title="Go back">
            <i class="fas fa-arrow-left" aria-hidden="true"></i>
            <span>Back</span>
        </a>


        <!-- Header -->
        <div class="partners-header">
            <h1>Our Valued Partners</h1>
        </div>

        <!-- Partners Grid -->
        <div class="partners-grid">
            <!-- PCSO -->
            <div class="partner-card">
                <div class="partner-logo-container">
                    <img src="/listofpartners/pcso.png" alt="PCSO Logo" class="partner-logo" />
                </div>
                <h3>Philippine Charity Sweepstakes Office</h3>
                <p>Providing medical assistance and charity programs</p>
            </div>

            <!-- DSWD -->
            <div class="partner-card">
                <div class="partner-logo-container">
                    <img src="/listofpartners/dswd.png" alt="DSWD Logo" class="partner-logo" />
                </div>
                <h3>Department of Social Welfare and Development</h3>
                <p>Social protection and poverty reduction programs</p>
            </div>

            <!-- Malasakit Center -->
            <div class="partner-card">
                <div class="partner-logo-container">
                    <img src="/listofpartners/malasakit.png" alt="Malasakit Center Logo" class="partner-logo" />
                </div>
                <h3>Malasakit Center</h3>
                <p>One-stop shop for medical and financial assistance</p>
            </div>
        </div>
    </div>

    <style>
        :root {
            --primary-color: #2c3e50;
            --secondary-color: #3498db;
            --light-color: #ecf0f1;
            --dark-color: #2c3e50;
            --text-color: #7f8c8d;
        }

        /* Global reset and responsive base */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 16px;
            line-height: 1.5;
            color: var(--text-color);
            background-color: var(--light-color);
        }

        /* Go Back Button */
        .go-back-btn {
            position: fixed;
            left: 16px;
            top: 16px;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 8px 14px;
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            border: 1px solid rgba(220, 20, 60, 0.15);
            color: #333333;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            white-space: nowrap;
            min-height: 36px;
            min-width: 36px;
            transform: scale(var(--btn-scale, 1));
            transform-origin: left top;
            -webkit-tap-highlight-color: transparent;
            touch-action: manipulation;
            user-select: none;
        }

            .go-back-btn:hover,
            .go-back-btn:focus {
                background: #DC143C;
                color: #ffffff;
                box-shadow: 0 4px 20px rgba(220, 20, 60, 0.3);
                transform: translateY(-1px) scale(calc(var(--btn-scale, 1) * 1.02));
                border-color: #DC143C;
            }

            .go-back-btn i {
                font-size: 13px;
                transition: transform 0.3s ease;
                width: 14px;
                text-align: center;
            }

            .go-back-btn:hover i {
                transform: translateX(-2px);
            }

            .go-back-btn:active {
                transform: scale(calc(var(--btn-scale, 1) * 0.96));
                background: #b01030;
                transition: transform 0.1s ease;
            }

            .go-back-btn:focus-visible {
                outline: 2px solid #DC143C;
                outline-offset: 2px;
            }

            .go-back-btn.compact span {
                display: none;
            }

            .go-back-btn.compact {
                padding: 8px;
                border-radius: 50%;
            }

        .partners-container {
            width: 100%;
            max-width: 1200px;
            padding: min(5vw, 2rem);
            margin: 0 auto;
        }

        /* Back Button Styles */
        .back-button-container {
            margin-bottom: min(4vw, 1.5rem);
        }

        .back-button {
            display: inline-flex;
            align-items: center;
            padding: min(2vw, 0.6rem) min(3vw, 1rem);
            background-color: var(--secondary-color);
            color: white;
            text-decoration: none;
            border-radius: 6px;
            font-size: clamp(0.8rem, 2vw, 0.9rem);
            transition: all 0.3s ease;
        }

            .back-button i {
                margin-right: 0.5em;
            }

            .back-button:hover {
                background-color: var(--primary-color);
                transform: translateX(-3px);
            }

        /* Header Styles */
        .partners-header {
            text-align: center;
            margin-bottom: 2rem;
            padding: 0 1rem;
        }

            .partners-header h1 {
                font-size: clamp(1.5rem, 5vw, 2.5rem);
                color: var(--primary-color);
                margin-bottom: 0.5rem;
            }

            .partners-header p {
                font-size: clamp(0.9rem, 3vw, 1.2rem);
                color: var(--text-color);
            }

        /* Partners Grid Styles */
        .partners-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
            gap: min(4vw, 1.5rem);
            padding: min(2vw, 0.5rem);
        }

        .partner-card {
            background: white;
            border-radius: 10px;
            padding: min(5vw, 1.5rem);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            text-align: center;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

            .partner-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
            }

        .partner-logo-container {
            height: min(25vw, 100px);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: min(3vw, 1rem);
        }

        .partner-logo {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
            filter: grayscale(20%);
            transition: filter 0.3s ease;
        }

        .partner-card:hover .partner-logo {
            filter: grayscale(0%);
        }

        .partner-card h3 {
            font-size: clamp(1rem, 4vw, 1.3rem);
            color: var(--primary-color);
            margin-bottom: 0.5rem;
        }

        .partner-card p {
            font-size: clamp(0.85rem, 3vw, 1rem);
            color: var(--text-color);
            line-height: 1.6;
        }
    </style>

    <script>
                // Go Back Button Script
        document.addEventListener('DOMContentLoaded', function() {
            const goBackBtn = document.getElementById('goBackBtn');

            if (goBackBtn) {
                // Responsive compact mode
                function updateButton() {
                    const viewportWidth = window.innerWidth;

                    // Switch to compact mode on smaller screens
                    if (viewportWidth < 480) {
                        goBackBtn.classList.add('compact');
                    } else {
                        goBackBtn.classList.remove('compact');
                    }
                }

                // Update on viewport changes
                function handleViewportChange() {
                    updateButton();
                }

                // Initial setup
                updateButton();

                // Listen to viewport changes
                window.addEventListener('resize', handleViewportChange);
                window.addEventListener('orientationchange', handleViewportChange);

                // Click functionality
                goBackBtn.addEventListener('click', function(e) {
                    e.preventDefault();

                    // Add press animation
                    this.style.transition = 'transform 0.1s ease';
                    this.style.transform = 'scale(0.95)';

                    setTimeout(() => {
                        this.style.transition = 'all 0.3s cubic-bezier(0.4, 0, 0.2, 1)';
                        this.style.transform = '';

                        // Navigate back or to home page
                        if (window.history.length > 1) {
                            window.history.back();
                        } else {
                            window.location.href = '/';
                        }
                    }, 100);
                });
            }
        });


    </script>

    <!-- Font Awesome for the back button icon -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
</body>
</html>