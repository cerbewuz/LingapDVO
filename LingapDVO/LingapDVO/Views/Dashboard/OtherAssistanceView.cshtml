@model OtherAssistanceDto
@{
    Layout = "_ViewFormsLayout";
    ViewData["Title"] = "Other Assistance View";
    var selectedSex = ViewData["Sex"]?.ToString();
    var checkedAssistance = ViewData["CheckedAssistance"] as Dictionary<string, string> ?? new();
    var checkedCMO = ViewData["CheckedCMOPERSONNEL"] as Dictionary<string, string> ?? new Dictionary<string, string>();

    // Get tracking data for this specific application (ADDED FROM FIRST CODE)
    var applicationId = ViewData["Id"]?.ToString();
    var createdDate = ViewData["CreatedAt"] != null ? Convert.ToDateTime(ViewData["CreatedAt"]) : DateTime.Now;
    var processAt = ViewData["ProcessAt"] != null && ViewData["ProcessAt"].ToString() != "" ? Convert.ToDateTime(ViewData["ProcessAt"]) : DateTime.MinValue;
    var resultDate = ViewData["Result"] != null && ViewData["Result"].ToString() != "" ? Convert.ToDateTime(ViewData["Result"]) : DateTime.MinValue;
    var claimedDate = ViewData["ClaimedAt"] != null && ViewData["ClaimedAt"].ToString() != "" ? Convert.ToDateTime(ViewData["ClaimedAt"]) : DateTime.MinValue;
    var status = ViewData["Status"]?.ToString() ?? "";
    var status2 = ViewData["Status2"]?.ToString() ?? "";
    var status3 = ViewData["Status3"]?.ToString() ?? "";
    var processBy = ViewData["Processby"]?.ToString() ?? "";
    var comments = ViewData["Comments"]?.ToString() ?? "";
    var retakeReason = ViewData["RetakeReason"]?.ToString() ?? "";
}

