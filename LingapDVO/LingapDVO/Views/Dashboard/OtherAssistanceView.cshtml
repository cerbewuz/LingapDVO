        // Keyboard shortcuts and navigation
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                const zoomModal = document.getElementById("zoomModal");
                if (zoomModal) zoomModal.style.display = "none";
                closePDFViewer();
                closeCommentsModal();
                closeRetakeModal();
            }

            const pdfModal = document.getElementById('pdfViewerModal');
            if (pdfModal && pdfModal.style.display === 'block') {
                switch(e.key) {
                    case 'ArrowLeft':
                        e.preventDefault();
                        prevPage();
                        break;
                    case 'ArrowRight':
                        e.preventDefault();
                        nextPage();
                        break;
                    case '+':
                    case '=':
                        e.preventDefault();
                        zoomIn();
                        break;
                    case '-':
                        e.preventDefault();
                        zoomOut();
                        break;
                }
            }
        });

        // Close modal when clicking outside
        window.onclick = function(event) {
            const zoomModal = document.getElementById("zoomModal");
            const pdfModal = document.getElementById("pdfViewerModal");
            const commentsModal = document.getElementById("commentsModal");
            const retakeModal = document.getElementById("retakeModal");
            const successModal = document.getElementById("successModal");

            if (event.target == zoomModal && zoomModal) {
                zoomModal.style.display = "none";
            }
            if (event.target == pdfModal && pdfModal) {
                closePDFViewer();
            }
            if (event.target == commentsModal && commentsModal) {
                closeCommentsModal();
            }
            if (event.target == retakeModal && retakeModal) {
                closeRetakeModal();
            }
            if (event.target == successModal && successModal) {
                successModal.style.display = "none";
            }
        }

        // Function to view encrypted Additional Information
        function viewOtherAdditionalInfo() {
            const formId = parseInt('@ViewData["Id"]');
            const encryptedFields = getOtherAssistanceFields();

            openViewAdditionalInfoModal('Other', formId, encryptedFields);
        }
