            let fieldValues = [];

            // Conditional fields based on assistance type
            if (assistanceType === 'Medicine Assistance') {
                fieldNames = ['MedicineName', 'MedicineQuantity', 'MedicineCost', 'PrescribingDoctor', 'DoctorContactDetail'];
                fieldLabels = ['Medicine Name', 'Quantity', 'Cost', 'Prescribing Doctor', 'Doctor Contact'];
                fieldValues = [
