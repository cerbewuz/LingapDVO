        </div>
        <div class="mb-3">
            <label for="retakeCommentsTextarea" class="form-label">Please specify what needs to be retaken or corrected:</label>
            <textarea class="form-control" id="retakeCommentsTextarea" rows="4" placeholder="Enter details about what documents or information need to be retaken (e.g., 'Need clearer ID photo', 'Missing medical certificate', etc.)..." required></textarea>
            <div class="invalid-feedback">Comments are required when marking as retake.</div>
        </div>
        <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-secondary" onclick="closeRetakeModal()">Cancel</button>
            <button type="button" class="btn btn-retake" onclick="submitRetake()">Mark as Retake</button>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div id="successModal" class="success-modal">
    <div class="success-modal-content">
        <div class="success-icon">
            <i class="bi bi-check-circle-fill"></i>
        </div>
        <h4>Status Updated Successfully!</h4>
        <p>Application marked as <strong id="successStatusText"></strong></p>
        <p>Redirecting to Admin page...</p>
        <div class="mt-3">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </div>
</div>

<!-- TWO-COLUMN LAYOUT CONTAINER (ADDED FROM FIRST CODE) -->
<div class="container" style="margin-top: 1rem; max-width: 1400px;">
    <!-- Two-Column Layout Container -->
    <div class="application-container">
        <!-- Left Column: Application Details -->
        <div class="application-details">
            <div class="receipt-container">
                <form asp-action="OtherAssistanceApproveStatus" asp-route-id="@ViewData["Id"]" method="post" id="statusForm">
                    @Html.AntiForgeryToken()

                    <!-- Hidden fields for form submission -->
                    <input type="hidden" name="id" value="@ViewData["Id"]" />
                    <input type="hidden" id="statusInput" name="status3" value="@ViewData["Status3"]">
                    <input type="hidden" id="commentsInput" name="Comments" value="" />
                    <input type="hidden" id="forCMOPersonnelInput" name="ForCMOPERSONNEL" value="@ViewData["ForCMOPERSONNEL"]" />
                    <input type="hidden" id="processByInput" name="Processby" value="@Context.Session.GetString("AdminFullname")" />

                    <div class="receipt-body">

                        <!-- Patient Information -->
                        <div class="receipt-section">
                            <h5 class="section-header">Patient Information</h5>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="info-row">
                                        <div class="info-label">Name:</div>
                                        <div class="info-value">
                                            @ViewData["Firstname"] @ViewData["Middlename"] @ViewData["Lastname"]
                                            @(ViewData["Suffix"]?.ToString() == "None" ? "" : " " + ViewData["Suffix"])
                                        </div>
                                    </div>
                                    <div class="info-row">
                                        <div class="info-label">Address:</div>
                                        <div class="info-value">@ViewData["BlkLotStreet"], @ViewData["SubVill"], @ViewData["Brgy"]</div>
                                    </div>
                                    <div class="info-row">
                                        <div class="info-label">Sex:</div>
                                        <div class="info-value">@ViewData["Sex"]</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="info-row">
                                        <div class="info-label">Date of Birth:</div>
                                        <div class="info-value">@ViewData["Dateofbirth"]</div>
                                    </div>
                                    <div class="info-row">
                                        <div class="info-label">Age:</div>
                                        <div class="info-value">@ViewData["Age"]</div>
                                    </div>
                                    <div class="info-row">
                                        <div class="info-label">PhilHealth:</div>
                                        <div class="info-value">@ViewData["PhilHealth"]</div>
                                    </div>
                                    <div class="info-row">
                                        <div class="info-label">PhilHealth No:</div>
                                        <div class="info-value">@ViewData["PhilHealthNo"]</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Requestor Details -->
                        <div class="receipt-section">
                            <h5 class="section-header">Requestor's Details</h5>
                            <div class="info-row">
                                <div class="info-label">Full Name:</div>
                                <div class="info-value">@ViewData["RLastname"], @ViewData["RFirstname"] @ViewData["RMiddlename"] @ViewData["RSuffix"]</div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">Address:</div>
                                <div class="info-value">@ViewData["RBlkLotStreet"], @ViewData["RSubVill"], @ViewData["RBrgy"]</div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">Relationship to Patient:</div>
                                <div class="info-value">@ViewData["RelationshipPatient"]</div>
                            </div>
                            <div class="info-row">
                                <div class="info-label">Contact No:</div>
                                <div class="info-value">@ViewData["ContactNo"]</div>
                            </div>
                        </div>

                        <!-- Assistance Requested -->
                        <div class="receipt-section">
                            <h5 class="section-header">Assistance Requested</h5>
                            <div class="info-value">@ViewData["Typeassistance"]</div>
                        </div>

                        <!-- Additional Information Section (Password-Protected) -->
                        <div class="receipt-section">
                            <h5 class="section-header d-flex align-items-center justify-content-between">
                                <span><i class="bi bi-shield-lock-fill me-2"></i>Additional Information (Encrypted)</span>
                                <button type="button" class="btn btn-sm btn-primary" id="viewAdditionalInfoBtn"
                                        onclick="toggleAdditionalInfo()"
                                        data-decrypted="false"
                                        title="Click to view encrypted information">
                                    <i class="bi bi-eye-fill me-2" id="additionalBtnIcon"></i><span id="additionalBtnText">View Additional Information</span>
                                </button>
                            </h5>
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="alert alert-info d-flex align-items-center" role="alert">
                                        <i class="bi bi-shield-lock-fill me-3 fs-5"></i>
                                        <div>
                                            <strong>This additional information is encrypted for security.</strong><br>
                                            Click the "View Additional Information" button above and enter your password to view the details.
                                            The fields shown will depend on the type of assistance requested.
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Additional Information Loading Container (shown while decrypting) -->
                            <div class="additional-loading-container" id="additionalLoadingContainer">
                                <div class="text-center py-4">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                    <p class="mt-3">Decrypting additional information... Please wait 5 seconds</p>
                                    <div class="progress mt-2" style="height: 8px;">
                                        <div class="progress-bar progress-bar-striped progress-bar-animated"
                                             role="progressbar" id="additionalLoadingProgress" style="width: 0%"></div>
                                    </div>
                                </div>
                            </div>

                            <!-- Additional Information Container (hidden by default, shown after successful decryption) -->
                            <div class="additional-info-container" id="additionalInfoContainer">
                                <div class="row">
                                    <!-- Fields will be dynamically populated here based on assistance type -->
                                </div>
                            </div>
                        </div>

                        <!-- CMO Section -->
                        <div class="receipt-section">
                            <h5 class="section-header">CMO Details</h5>
                            <div class="info-value">@ViewData["ForCMOPERSONNEL"]</div>
                        </div>

                        <!-- Valid ID and Submitted Documents Section -->
                        <div class="receipt-section">
                            <!-- Valid ID Section -->
                            <div class="receipt-section">
                                <h5 class="section-header d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-shield-lock-fill me-2"></i>Valid ID (Encrypted)</span>
                                    @* Button to decrypt/hide Valid ID with toggle functionality *@
                                    @if (!string.IsNullOrEmpty(ViewData["Validfrontimage"]?.ToString()) || !string.IsNullOrEmpty(ViewData["ValidBackimage"]?.ToString()))
                                    {
                                        <button type="button" class="btn btn-sm btn-primary" id="viewValidIDBtn"
                                                onclick="toggleValidID('/Validimg/@ViewData["Validfrontimage"]', '/Validimg/@ViewData["ValidBackimage"]')"
                                                data-decrypted="false"
                                                title="Click to view/hide encrypted ID images">
                                            <i class="bi bi-eye-fill me-1" id="validIDBtnIcon"></i>
                                            <span id="validIDBtnText">View Valid ID</span>
                                        </button>
                                    }
                                </h5>

                                <!-- Alert shown when IDs are encrypted -->
                                <div class="alert alert-info d-flex align-items-center mb-3" id="validIDAlert">
                                    <i class="bi bi-info-circle-fill me-2"></i>
                                    <div>
                                        <strong>ID Images are Encrypted</strong><br>
                                        For security, ID images are encrypted. Click the "View Valid ID" button above and enter your password to view them.
                                    </div>
                                </div>

                                <!-- Loading Container (shown while decrypting) -->
                                <div class="valid-id-loading" id="validIDLoading">
                                    <div class="text-center py-4">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                        <p class="mt-3">Decrypting ID images... Please wait</p>
                                    </div>
                                </div>

                                <!-- Valid ID Container (hidden by default, shown after successful decryption) -->
                                <div class="valid-id-container" id="validIDContainer">
                                    <div class="row">
                                        <div class="col-md-6 mb-3" id="frontIDInlineContainer">
                                            <h6><i class="bi bi-credit-card-2-front me-2"></i>Front ID</h6>
                                            <img id="decryptedFrontIDInline" src="" alt="Front ID" class="id-image" style="display: none;" onclick="zoomImage(this.src)" />
                                        </div>
                                        <div class="col-md-6 mb-3" id="backIDInlineContainer">
                                            <h6><i class="bi bi-credit-card-2-back me-2"></i>Back ID</h6>
                                            <img id="decryptedBackIDInline" src="" alt="Back ID" class="id-image" style="display: none;" onclick="zoomImage(this.src)" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Doctor Prescription -->
                            @if (ViewData["DoctorPrescriptionBase64"] != null)
                            {
                                <div class="receipt-section">
                                    <h5 class="section-header">Supporting Document</h5>
                                    @if (ViewData["IsDoctorPrescriptionPdf"] != null && (bool)ViewData["IsDoctorPrescriptionPdf"])
                                    {
                                        <div class="pdf-container">
                                            <div class="pdf-preview" onclick="viewPDFInModal('@ViewData["DoctorPrescription"]', 'doctorprescription', 'Doctor Prescription')">
                                                <div class="pdf-icon"><i class="bi bi-file-earmark-pdf"></i></div>
                                                <div class="pdf-info">
                                                    <span class="pdf-filename">@ViewData["DoctorPrescription"]</span>
                                                    <span class="pdf-label">Click to view PDF</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["DoctorPrescriptionBase64"]')">
                                            <img src="data:image/jpeg;base64,@ViewData["DoctorPrescriptionBase64"]" alt="Doctor Prescription" class="id-image" />
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Medical Certificate -->
                            @if (ViewData["MedicalCertificateBase64"] != null)
                            {
                                <div class="receipt-section">
                                    <h5 class="section-header">Supporting Document</h5>
                                    @if (ViewData["IsMedicalCertificatePdf"] != null && (bool)ViewData["IsMedicalCertificatePdf"])
                                    {
                                        <div class="pdf-container">
                                            <div class="pdf-preview" onclick="viewPDFInModal('@ViewData["MedicalCertificate"]', 'medicalcertificate', 'Medical Certificate')">
                                                <div class="pdf-icon"><i class="bi bi-file-earmark-pdf"></i></div>
                                                <div class="pdf-info">
                                                    <span class="pdf-filename">@ViewData["MedicalCertificate"]</span>
                                                    <span class="pdf-label">Click to view PDF</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["MedicalCertificateBase64"]')">
                                            <img src="data:image/jpeg;base64,@ViewData["MedicalCertificateBase64"]" alt="Medical Certificate" class="id-image" />
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Death Certificate -->
                            @if (ViewData["DeathCertificateBase64"] != null)
                            {
                                <div class="receipt-section">
                                    <h5 class="section-header">Supporting Document</h5>
                                    @if (ViewData["IsDeathCertificatePdf"] != null && (bool)ViewData["IsDeathCertificatePdf"])
                                    {
                                        <div class="pdf-container">
                                            <div class="pdf-preview" onclick="viewPDFInModal('@ViewData["DeathCertificate"]', 'deathcertificate', 'Death Certificate')">
                                                <div class="pdf-icon"><i class="bi bi-file-earmark-pdf"></i></div>
                                                <div class="pdf-info">
                                                    <span class="pdf-filename">@ViewData["DeathCertificate"]</span>
                                                    <span class="pdf-label">Click to view PDF</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="id-image-container" onclick="zoomImage('data:image/jpeg;base64,@ViewData["DeathCertificateBase64"]')">
                                            <img src="data:image/jpeg;base64,@ViewData["DeathCertificateBase64"]" alt="Death Certificate" class="id-image" />
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <!-- Status Action Buttons (Only show if user has admin rights) - ADDED FROM FIRST CODE -->
                        @if (Context.Session.GetString("UserRole") == "Admin")
                        {
                            <div class="receipt-section">
                                <h5 class="section-header">Update Application Status</h5>
                                <div class="status-buttons">
                                    <button type="button" class="btn-approved" onclick="markAsApprove()">
                                        <i class="fas fa-check-circle me-2"></i>Approve
                                    </button>
                                    <button type="button" class="btn-disapproved" onclick="showCommentsModal()">
                                        <i class="fas fa-times-circle me-2"></i>Disapprove
                                    </button>
                                    <button type="button" class="btn-retake" onclick="markAsRetake()">
                                        <i class="fas fa-arrow-rotate-left me-2"></i>Mark as Retake
                                    </button>
                                    @if (status2 == "Approve" && status3 != "Claimed")
                                    {
                                        <button type="button" class="btn-claimed" onclick="markAsClaimed()">
                                            <i class="fas fa-hands-helping me-2"></i>Mark as Claimed
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </form>
            </div>
        </div>

        <!-- Right Column: Application Tracking (ADDED FROM FIRST CODE) -->
        <div class="application-tracking">
            <div class="tracking-header">
                <h5>
                    <i class="fas fa-file-medical"></i> Application Tracking
                    @{
                        var currentStatusBadge = "";
                        if (status2 == "Approve")
                        {
                            if (status3 == "Claimed")
                            {
                                currentStatusBadge = "status-claimed-badge";
                            }
                            else
                            {
                                currentStatusBadge = "status-approved-badge";
                            }
                        }
                        else if (status2 == "Disapprove" || status2 == "Unapproved")
                        {
                            currentStatusBadge = "status-disapproved-badge";
                        }
                        else if (status2 == "Retake")
                        {
                            currentStatusBadge = "status-retake-badge";
                        }
                        else
                        {
                            currentStatusBadge = "status-pending-badge";
                        }
                    }
                    <span class="current-status-badge @currentStatusBadge">
                        @if (status2 == "Approve" && status3 == "Claimed")
                        {
                            <text>CLAIMED</text>
                        }
                        else if (!string.IsNullOrEmpty(status2))
                        {
                            <text>@status2.ToUpper()</text>
                        }
                        else
                        {
                            <text>PENDING</text>
                        }
                    </span>
                </h5>
                <div class="tracking-date">
                    <span class="date-info">
                        <i class="fas fa-hashtag me-1"></i>
                        <span class="application-id">@applicationId</span>
                    </span>
                    <span class="date-info">
                        <i class="fas fa-calendar me-1"></i>
                        @createdDate.ToString("dd MMM yyyy")
                    </span>
                </div>
            </div>
            <div class="tracking-body">
                <div class="timeline">
                    <!-- Standard timeline order: Top to bottom, oldest to newest -->
                    <!-- Step 1: Document Submitted - TOP (oldest) -->
                    <div class="timeline-item">
                        <div class="timeline-marker submitted">
                            <i class="fas fa-paper-plane"></i>
                        </div>
                        <div class="timeline-content">
                            <h6>Application Submitted</h6>
                            <span class="timeline-date">@createdDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                            <p class="timeline-description">We have received your application for @ViewData["Typeassistance"].</p>
                        </div>
                    </div>

                    <!-- Step 2: Processing -->
                    @if (processAt > DateTime.MinValue && processAt.Year > 1 && !string.IsNullOrWhiteSpace(processBy))
                    {
                        <div class="timeline-item">
                            <div class="timeline-marker processing">
                                <i class="fas fa-user-check"></i>
                            </div>
                            <div class="timeline-content">
                                <h6>Being Reviewed</h6>
                                <span class="timeline-date">@processAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                                <p class="timeline-description">Your application is being reviewed by <strong>@processBy</strong></p>
                            </div>
                        </div>
                    }
                    else if (resultDate <= DateTime.MinValue || resultDate.Year <= 1)
                    {
                        <div class="timeline-item">
                            <div class="timeline-marker waiting">
                                <i class="fas fa-hourglass-half"></i>
                            </div>
                            <div class="timeline-content">
                                <h6>Waiting for Review</h6>
                                <p class="waiting-text">Your application is waiting to be reviewed. We will review it within 1-2 hours.</p>
                            </div>
                        </div>
                    }

                    <!-- Step 3: Result -->
                    @if (resultDate > DateTime.MinValue && resultDate.Year > 1)
                    {
                        @if (status2 == "Retake")
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker retake">
                                    <i class="fas fa-arrow-rotate-left"></i>
                                </div>
                                <div class="timeline-content">
                                    <h6>Action Required - Retake Application</h6>
                                    <span class="timeline-date">@resultDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                                    <p class="timeline-description">
                                        We need additional documents or corrections for your application. Please review the comments below and resubmit your application with the required updates.
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(retakeReason))
                                    {
                                        <div style="background-color: #fff3cd; border-left: 4px solid #ff9800; padding: 12px; border-radius: 6px; margin-top: 12px;">
                                            <p class="mb-2" style="font-weight: 600; color: #9a3412;"><i class="fas fa-info-circle me-1"></i> What needs to be updated:</p>
                                            <p class="mb-0" style="color: #666;">@retakeReason</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker @(status2 == "Approve" ? "approved" : "unapproved")">
                                    <i class="fas @(status2 == "Approve" ? "fa-check-circle" : "fa-times-circle")"></i>
                                </div>
                                <div class="timeline-content">
                                    <h6>Application @(status2 == "Approve" ? "Approved" : status2)</h6>
                                    <span class="timeline-date">@resultDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                                    <p class="timeline-description text-gray-700 leading-relaxed">
                                        @if (status2 == "Approve")
                                        {
                                            <text>Your application has been approved. You can now claim your assistance.</text>
                                        }
                                        else
                                        {
                                            <text>Your application was not approved at this time.</text>
                                        }
                                    </p>

                                    @if (!string.IsNullOrWhiteSpace(comments))
                                    {
                                        <p class="timeline-description mt-2"><strong>Comments:</strong> @comments</p>
                                    }
                                </div>
                            </div>
                        }
                    }

                    <!-- Step 4: Claim Status (Only show if approved) - BOTTOM (newest) -->
                    @if (status2 == "Approve")
                    {
                        @if (claimedDate > DateTime.MinValue && claimedDate.Year > 1 && status3 == "Claimed")
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker claimed">
                                    <i class="fas fa-hands-helping"></i>
                                </div>
                                <div class="timeline-content">
                                    <h6>Assistance Released</h6>
                                    <span class="timeline-date">@claimedDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                                    <p class="timeline-description">
                                        Your assistance has been released and completed.
                                    </p>
                                </div>
                            </div>
                        }
                        else if (status2 == "Approve")
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker waiting">
                                    <i class="fas fa-gift"></i>
                                </div>
                                <div class="timeline-content">
                                    <h6>Ready for Release</h6>
                                    <p class="waiting-text">Your assistance is ready. Please visit our office to collect it.</p>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>
        // Configure PDF.js worker
        if (typeof pdfjsLib !== 'undefined') {
            pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
        }

        // PDF Viewer Variables
        let currentPDF = null;
        let currentPage = 1;
        let totalPages = 1;
        let currentScale = 1.2;

        // Requestor's Name Variables
        const requestorFirstname = '@ViewData["RFirstname"]';
        const requestorMiddlename = '@ViewData["RMiddlename"]';
        const requestorLastname = '@ViewData["RLastname"]';
        const requestorSuffix = '@ViewData["RSuffix"]';
        const requestorFullName = `${requestorFirstname} ${requestorMiddlename} ${requestorLastname}${requestorSuffix && requestorSuffix !== 'None' ? ' ' + requestorSuffix : ''}`.trim().replace(/\s+/g, ' ');

        // Assistance Type
        const assistanceType = '@ViewData["Typeassistance"]';

        // Image Zoom Functionality
        function zoomImage(src) {
            const modal = document.getElementById("zoomModal");
            const modalImg = document.getElementById("zoomedImage");
            if (modal && modalImg) {
                modal.style.display = "block";
                modalImg.src = src;
            }
        }

        // Close zoom modal
        document.addEventListener('DOMContentLoaded', function() {
            const closeZoom = document.querySelector(".close-zoom");
            if (closeZoom) {
                closeZoom.onclick = function() {
                    const modal = document.getElementById("zoomModal");
                    if (modal) modal.style.display = "none";
                }
            }
        });

        // PDF Viewer Function
        async function viewPDFInModal(fileName, fileType, displayName) {
            const modal = document.getElementById('pdfViewerModal');
            const title = document.getElementById('pdfViewerTitle');
            const loading = document.getElementById('pdfLoading');
            const errorDiv = document.getElementById('pdfError');
            const canvas = document.getElementById('pdfCanvas');
            const context = canvas ? canvas.getContext('2d') : null;
            const currentPageSpan = document.getElementById('currentPage');
            const totalPagesSpan = document.getElementById('totalPages');
            const zoomLevelSpan = document.getElementById('zoomLevel');
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');

            if (!modal || !title || !loading || !errorDiv || !canvas || !context) {
                console.error('PDF viewer elements not found');
                return;
            }

            title.textContent = displayName || 'PDF Document';
            modal.style.display = 'block';
            loading.style.display = 'flex';
            errorDiv.style.display = 'none';
            canvas.style.display = 'none';

            currentPDF = null;
            currentPage = 1;
            currentScale = 1.2;

            try {
                const encodedFileName = encodeURIComponent(fileName);
                const url = '@Url.Action("ViewPDF", "Dashboard")?fileName=' + encodedFileName + '&fileType=' + fileType + '&t=' + Date.now();

                const response = await fetch(url);
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const pdfData = await response.arrayBuffer();
                if (!pdfData || pdfData.byteLength === 0) {
                    throw new Error('PDF data is empty');
                }

                const loadingTask = pdfjsLib.getDocument({ data: pdfData });
                currentPDF = await loadingTask.promise;

                totalPages = currentPDF.numPages;
                if (totalPagesSpan) totalPagesSpan.textContent = totalPages;
                if (currentPageSpan) currentPageSpan.textContent = currentPage;

                updateNavigationButtons();
                await renderPage(currentPage);

                loading.style.display = 'none';
                canvas.style.display = 'block';
                if (zoomLevelSpan) zoomLevelSpan.textContent = Math.round(currentScale * 100) + '%';

            } catch (error) {
                console.error('Error loading PDF:', error);
                loading.style.display = 'none';
                errorDiv.style.display = 'block';
                if (errorDiv.querySelector('p')) {
                    errorDiv.querySelector('p').textContent = `Error loading PDF: ${error.message}`;
                }
            }
        }

        // Render specific page
        async function renderPage(pageNum) {
            if (!currentPDF) return;

            const canvas = document.getElementById('pdfCanvas');
            const context = canvas.getContext('2d');
            const currentPageSpan = document.getElementById('currentPage');

            if (!canvas || !context) return;

            try {
                const page = await currentPDF.getPage(pageNum);
                const viewport = page.getViewport({ scale: currentScale });

                canvas.height = viewport.height;
                canvas.width = viewport.width;

                const renderContext = {
                    canvasContext: context,
                    viewport: viewport
                };

                await page.render(renderContext).promise;
                if (currentPageSpan) currentPageSpan.textContent = pageNum;

            } catch (error) {
                console.error('Error rendering page:', error);
            }
        }

        // Navigation functions
        function nextPage() {
            if (currentPage < totalPages) {
                currentPage++;
                renderPage(currentPage);
                updateNavigationButtons();
            }
        }

        function prevPage() {
            if (currentPage > 1) {
                currentPage--;
                renderPage(currentPage);
                updateNavigationButtons();
            }
        }

        function zoomIn() {
            currentScale += 0.2;
            renderPage(currentPage);
            const zoomLevelSpan = document.getElementById('zoomLevel');
            if (zoomLevelSpan) zoomLevelSpan.textContent = Math.round(currentScale * 100) + '%';
        }

        function zoomOut() {
            if (currentScale > 0.5) {
                currentScale -= 0.2;
                renderPage(currentPage);
                const zoomLevelSpan = document.getElementById('zoomLevel');
                if (zoomLevelSpan) zoomLevelSpan.textContent = Math.round(currentScale * 100) + '%';
            }
        }

        function updateNavigationButtons() {
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');

            if (prevBtn) prevBtn.disabled = currentPage <= 1;
            if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
        }

        // Close PDF Viewer
        function closePDFViewer() {
            const modal = document.getElementById('pdfViewerModal');
            if (modal) {
                modal.style.display = 'none';
            }

            if (currentPDF) {
                currentPDF.destroy();
                currentPDF = null;
            }
        }

