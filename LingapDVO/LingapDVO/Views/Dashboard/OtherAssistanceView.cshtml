        // Function to start the 5-second loading animation
        function startAdditionalInfoLoading() {
            console.log('Starting additional information loading...');

            // Show loading container
            const loadingContainer = document.getElementById('additionalLoadingContainer');
            if (loadingContainer) {
                loadingContainer.style.display = 'block';
            }

            // Hide any existing additional info container
            const additionalInfoContainer = document.getElementById('additionalInfoContainer');
            if (additionalInfoContainer) {
                additionalInfoContainer.style.display = 'none';
                additionalInfoContainer.classList.remove('additional-info-visible');
            }

            // Start 5-second progress bar
            const progressBar = document.getElementById('additionalLoadingProgress');
            if (progressBar) {
                let progress = 0;
                const totalTime = 5000; // 5 seconds
                const interval = 100; // Update every 100ms
                const increment = (interval / totalTime) * 100;

                const progressInterval = setInterval(() => {
                    progress += increment;
                    if (progress >= 100) {
                        progress = 100;
                        clearInterval(progressInterval);

                        // After 5 seconds, show the additional information
                        setTimeout(() => {
                            showAdditionalInfoAfterDecryption();
                        }, 300);
                    } else {
                        progressBar.style.width = progress + '%';
                    }
                }, interval);
            }
        }

