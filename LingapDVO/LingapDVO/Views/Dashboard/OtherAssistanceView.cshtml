            } else if (assistanceType === 'Laboratory') {
                fieldNames = ['LaboratoryCenterName', 'LaboratoryCenterAddress', 'TestName', 'TestCost', 'TestOtherInfo'];
                fieldLabels = ['Laboratory Center Name', 'Center Address', 'Test Name', 'Test Cost', 'Other Information'];
                fieldValues = [
                    '@ViewData["LaboratoryCenterName"]',
                    '@ViewData["LaboratoryCenterAddress"]',
                    '@ViewData["TestName"]',
                    '@ViewData["TestCost"]',
                    '@ViewData["TestOtherInfo"]'
                ];
            } else if (assistanceType === 'Therapy') {
                fieldNames = ['TherapyFacilityName', 'TherapyFacilityAddress', 'TherapyFacilityContact', 'TherapyType'];
                fieldLabels = ['Therapy Facility Name', 'Facility Address', 'Facility Contact', 'Therapy Type'];
                fieldValues = [
                    '@ViewData["TherapyFacilityName"]',
                    '@ViewData["TherapyFacilityAddress"]',
                    '@ViewData["TherapyFacilityContact"]',
                    '@ViewData["TherapyType"]'
                ];
            } else if (assistanceType === 'Medical Equipment/ Apparatus') {
                fieldNames = ['EquipmentName', 'EquipmentBrand', 'EquipmentCategory', 'EquipmentQuantity', 'EquipmentCost'];
                fieldLabels = ['Equipment Name', 'Brand', 'Category', 'Quantity', 'Cost'];
                fieldValues = [
