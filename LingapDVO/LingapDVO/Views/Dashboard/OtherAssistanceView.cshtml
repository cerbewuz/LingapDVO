        // Function to hide additional information
        function hideAdditionalInfo() {
            const additionalInfoContainer = document.getElementById('additionalInfoContainer');
            const viewButton = document.getElementById('viewAdditionalInfoBtn');
            const btnIcon = document.getElementById('additionalBtnIcon');
            const btnText = document.getElementById('additionalBtnText');

            if (additionalInfoContainer) {
                additionalInfoContainer.classList.remove('additional-info-visible');
                additionalInfoContainer.style.display = 'none';
            }

            // Update button to "View" state
            if (viewButton) {
                viewButton.setAttribute('data-decrypted', 'false');
                viewButton.classList.remove('btn-warning');
                viewButton.classList.add('btn-primary');
            }
            if (btnIcon) {
                btnIcon.classList.remove('bi-eye-slash-fill');
                btnIcon.classList.add('bi-eye-fill');
            }
            if (btnText) {
                btnText.textContent = 'View Additional Information';
            }

            // Clear decrypted data
            window.decryptedAdditionalData = {};
        }

        // Function to show additional information after successful decryption
        function showAdditionalInfoAfterDecryption() {
            console.log('Showing additional information after decryption...');

            // Hide the loading container
            const loadingContainer = document.getElementById('additionalLoadingContainer');
            if (loadingContainer) {
                loadingContainer.style.display = 'none';
            }

            // Show the additional information container
            const additionalInfoContainer = document.getElementById('additionalInfoContainer');
            if (additionalInfoContainer) {
                additionalInfoContainer.style.display = 'block';
                additionalInfoContainer.classList.add('additional-info-visible');

                // Populate the fields based on assistance type
                populateAdditionalInfoFields();

                // Scroll to the additional information section
                setTimeout(() => {
                    additionalInfoContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 100);
            }

            // Update button to "Hide" state
            const viewButton = document.getElementById('viewAdditionalInfoBtn');
            const btnIcon = document.getElementById('additionalBtnIcon');
            const btnText = document.getElementById('additionalBtnText');

            if (viewButton) {
                viewButton.setAttribute('data-decrypted', 'true');
                viewButton.classList.remove('btn-primary');
                viewButton.classList.add('btn-warning');
            }
            if (btnIcon) {
                btnIcon.classList.remove('bi-eye-fill');
                btnIcon.classList.add('bi-eye-slash-fill');
            }
            if (btnText) {
                btnText.textContent = 'Hide Additional Information';
            }
        }

