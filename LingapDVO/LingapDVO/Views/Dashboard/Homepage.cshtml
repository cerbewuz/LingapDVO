            function generateNotificationsFromRealData(applications) {
                const notifications = [];
                const now = new Date();
                const readIds = getStoredReadNotifications();

                const hasApplications = (applications.hospitalBills && applications.hospitalBills.length > 0) ||
                                      (applications.medicalForms && applications.medicalForms.length > 0) ||
                                      (applications.funeralForms && applications.funeralForms.length > 0);

                if (!hasApplications) {
                    notifications.push({
                        id: 'no_applications',
                        title: "Welcome to LingapDVO",
                        message: "You haven't submitted any applications yet. Get started by applying for assistance.",
                        isRead: true,
                        createdAt: new Date().toISOString(),
                        type: "submitted",
                        link: "#"
                    });
                    return notifications;
                }

                if (applications.hospitalBills && applications.hospitalBills.length > 0) {
                    applications.hospitalBills.forEach(app => {
                        notifications.push(...getApplicationStatusNotifications(app, 'Hospital Assistance'));
                    });
                }

                if (applications.medicalForms && applications.medicalForms.length > 0) {
                    applications.medicalForms.forEach(app => {
                        notifications.push(...getApplicationStatusNotifications(app, 'Other Assistance'));
                    });
                }

                if (applications.funeralForms && applications.funeralForms.length > 0) {
                    applications.funeralForms.forEach(app => {
                        notifications.push(...getApplicationStatusNotifications(app, 'Funeral Assistance'));
                    });
                }

                notifications.forEach(notification => {
                    if (readIds.includes(notification.id)) {
                        notification.isRead = true;
                    }
                });

                return notifications.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
            }

            function getApplicationStatusNotifications(application, type) {
                const notifications = [];
                const now = new Date();
                const appId = application.id || application.Id;
                const readIds = getStoredReadNotifications();

                function getHoursElapsed(dateString) {
                    if (!dateString || !isValidDate(dateString)) return 0;
                    const date = new Date(dateString);
                    const diffTime = now - date;
                    return Math.floor(diffTime / (1000 * 60 * 60));
                }

                function calculatePriority(status, status2, createdAt) {
                    // Only calculate priority for pending or processing applications
                    // If already approved/disapproved/claimed, no priority needed
                    if (status2 && (status2.toLowerCase() === 'approve' || status2.toLowerCase() === 'unapproved')) {
                        return 'normal';
                    }

                    // Check if still in pending or processing state
                    if (!status || (status.toLowerCase() !== 'pending' && status.toLowerCase() !== 'processing')) {
                        return 'normal';
                    }

                    // Calculate hours elapsed since submission
                    const hoursElapsed = getHoursElapsed(createdAt);

                    if (hoursElapsed >= 2) {
                        return 'high';
                    } else if (hoursElapsed >= 1) {
                        return 'medium';
                    } else {
                        return 'normal';
                    }
                }

                let notificationId, title, message, notificationType, createdDate;

                if (application.status2 === 'Approve' &&
                    application.claimedAt && isValidDate(application.claimedAt) &&
                    application.status3 && application.status3.trim() !== '') {

                    notificationId = `status_${appId}`;
                    title = `${type} Assistance Completed`;
                    message = `Your ${type} assistance has been released. Thank you for using LingapDVO.`;
                    notificationType = "claimed";
                    createdDate = application.claimedAt;
                }
                else if (application.status2 === 'Approve') {
                    const hoursApproved = getHoursElapsed(application.result);
                    const daysSinceApproval = Math.floor(hoursApproved / 24);

                    notificationId = `status_${appId}`;
                    title = `${type} Assistance Approved`;

                    if (daysSinceApproval >= 7) {
                        message = `Your assistance is ready to claim (approved ${daysSinceApproval} days ago). Please visit our office soon.`;
                        notificationType = "delayed";
                    } else {
                        message = `Your application has been approved. Visit our office to claim your assistance.`;
                        notificationType = "approved";
                    }
                    createdDate = application.result;
                }
                else if (application.result && isValidDate(application.result) && application.status2 === 'Unapproved') {
                    notificationId = `status_${appId}`;
                    title = `${type} Application Not Approved`;
                    message = `Your application was not approved. Check Application History for details.`;
                    notificationType = "unapproved";
                    createdDate = application.result;
                }
                else if (application.processAt && isValidDate(application.processAt) &&
                         application.processby && application.processby.trim() !== '') {

                    const hoursInReview = getHoursElapsed(application.processAt);

                    notificationId = `status_${appId}`;

                    if (hoursInReview >= 2) {
                        title = `${type} Application - Review Delayed`;
                        message = `Your application has been under review for ${hoursInReview} hours. We're working on it.`;
                        notificationType = "delayed";
                    } else {
                        title = `${type} Application Under Review`;
                        message = `${application.processby} is reviewing your application. Decision expected within 1-2 hours.`;
                        notificationType = "processing";
                    }
                    createdDate = application.processAt;
                }
                else if (application.createdAt && isValidDate(application.createdAt)) {
                    const hoursWaiting = getHoursElapsed(application.createdAt);

                    notificationId = `status_${appId}`;

                    if (hoursWaiting >= 2) {
                        title = `${type} Application - Pending`;
                        message = `Your application has been waiting ${hoursWaiting} hours for review. We'll assign a reviewer soon.`;
                        notificationType = "delayed";
                    } else {
                        title = `${type} Application Submitted`;
                        message = `Your application is in queue. Expected review time: 1-2 hours.`;
                        notificationType = "submitted";
                    }
                    createdDate = application.createdAt;
                }

                if (notificationId) {
                    // Calculate priority based on application status and created date
                    const priority = calculatePriority(application.status, application.status2, application.createdAt);

                    notifications.push({
                        id: notificationId,
                        title: title,
                        message: message,
                        isRead: readIds.includes(notificationId),
                        createdAt: createdDate,
                        type: notificationType,
                        link: "/Applicationtracking",
                        priority: priority
                    });
                }

                return notifications;
            }

            function hideNotificationBadge() {
                if (notificationBadge) {
