                                                <i class="fas fa-monument"></i>
                                            </div>
                                            <h5 class="service-title">Funeral Assistance</h5>
                                            <p class="service-description">Burial and funeral support services</p>
                                        </div>
                                    </a>
                                }
                                else
                                {
                                    <div class="service-card disabled" data-bs-toggle="tooltip" title="Complete account verification to access this service">
                                        <div class="service-icon">
                                            <i class="fas fa-monument"></i>
                                        </div>
                                        <h5 class="service-title">Funeral Assistance</h5>
                                        <p class="service-description">Burial and funeral support services</p>
                                    </div>
                                }
                            </div>

                            <!-- Service 3 - Other Assistance -->
                            <div class="col-md-6 col-lg-4">
                                @if (isVerified)
                                {
                                    <a href="/OtherAssistance" class="text-decoration-none">
                                        <div class="service-card">
                                            <div class="service-icon">
                                                <i class="fas fa-microscope"></i>
                                            </div>
                                            <h5 class="service-title">Other Assistance</h5>
                                            <p class="service-description">Other assistance</p>
                                        </div>
