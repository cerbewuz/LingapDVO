                                }
                                else
                                {
                                    <div class="service-card disabled" data-bs-toggle="tooltip" title="Complete account verification to access this service">
                                        <div class="service-icon">
                                            <i class="fas fa-history"></i>
                                        </div>
                                        <h5 class="service-title">Application History</h5>
                                        <p class="service-description">View your previous applications and status</p>
                                    </div>
                                }
                            </div>

                            <!-- Service 5 - Locate Facilities -->
                            <div class="col-md-6 col-lg-4">
                                <a href="/Nearbyoffices" class="text-decoration-none">
                                    <div class="service-card">
                                        <div class="service-icon">
                                            <i class="fas fa-map-marker-alt"></i>
                                        </div>
                                        <h5 class="service-title">Branches Nearby</h5>
                                        <p class="service-description">Find nearby offices near you</p>
                                    </div>
                                </a>
                            </div>

                            <!-- Service 6 - Partner Directory -->
                            <div class="col-md-6 col-lg-4">
                                <a href="/Listofpartners" class="text-decoration-none">
                                    <div class="service-card">
                                        <div class="service-icon">
                                            <i class="fas fa-hands-helping"></i>
                                        </div>
                                        <h5 class="service-title">Partner Directory</h5>
                                        <p class="service-description">List of partner organizations</p>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- SignalR for Real-time Notifications -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>

    <script>
        // Initialize tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        });

        // Fallback data from server (used when API fails)
        const fallbackHospitalBills = @Html.Raw(Json.Serialize(Model.HospitalAssistance));
        const fallbackMedicalForms = @Html.Raw(Json.Serialize(Model.OtherAssistance));
        const fallbackFuneralForms = @Html.Raw(Json.Serialize(Model.FuneralAssistance));

        // Mobile Burger Menu functionality
        document.addEventListener('DOMContentLoaded', function() {
            const burgerMenuBtn = document.getElementById('burgerMenuBtn');
            const mobileUserActions = document.getElementById('mobileUserActions');
            const mobileMenuOverlay = document.getElementById('mobileMenuOverlay');
            const mobileNotificationBtn = document.getElementById('mobileNotificationBtn');
            const mobileNotificationBadge = document.getElementById('mobileNotificationBadge');

            // Toggle mobile menu
            if (burgerMenuBtn) {
                burgerMenuBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    mobileUserActions.classList.toggle('active');
                    mobileMenuOverlay.classList.toggle('active');
                    document.body.style.overflow = mobileUserActions.classList.contains('active') ? 'hidden' : '';
                    // Hide burger button when sidebar is open
                    if (mobileUserActions.classList.contains('active')) {
                        burgerMenuBtn.classList.add('hidden');
                    }
                });
            }

            // Close mobile menu with close button
            const mobileMenuCloseBtn = document.getElementById('mobileMenuCloseBtn');
            if (mobileMenuCloseBtn) {
                mobileMenuCloseBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    mobileUserActions.classList.remove('active');
                    mobileMenuOverlay.classList.remove('active');
                    document.body.style.overflow = '';
                    // Show burger button again when sidebar closes
                    if (burgerMenuBtn) {
                        burgerMenuBtn.classList.remove('hidden');
                    }
                });
            }

            // Close mobile menu when clicking overlay (tap outside)
            if (mobileMenuOverlay) {
                mobileMenuOverlay.addEventListener('click', function() {
                    mobileUserActions.classList.remove('active');
                    mobileMenuOverlay.classList.remove('active');
                    document.body.style.overflow = '';
                    // Show burger button again when sidebar closes
                    if (burgerMenuBtn) {
                        burgerMenuBtn.classList.remove('hidden');
                    }
                });
            }

            // Sync notification badge between desktop and mobile
            function syncNotificationBadge() {
                const desktopBadge = document.getElementById('notificationBadge');
                if (desktopBadge && mobileNotificationBadge) {
                    if (desktopBadge.style.display !== 'none') {
                        mobileNotificationBadge.textContent = desktopBadge.textContent;
                        mobileNotificationBadge.style.display = 'inline-block';
                    } else {
                        mobileNotificationBadge.style.display = 'none';
                    }
                }
            }

            // Sync badges periodically
            setInterval(syncNotificationBadge, 1000);
        });

        // REAL Notification functionality
        document.addEventListener('DOMContentLoaded', function() {
            const notificationButton = document.getElementById('notificationButton');
            const notificationDropdown = document.getElementById('notificationDropdown');
            const notificationBadge = document.getElementById('notificationBadge');
            const notificationList = document.getElementById('notificationList');
            const markAllRead = document.getElementById('markAllRead');
            const refreshNotifications = document.getElementById('refreshNotifications');
            const realTimeIndicator = document.getElementById('realTimeIndicator');

            let currentNotifications = [];
            let lastApplicationState = null;

            // Pulse animation
            const pulseElements = document.querySelectorAll('.pulse');
            pulseElements.forEach(element => {
                let opacity = 1;
                let decreasing = true;
                setInterval(() => {
                    if (decreasing) {
                        opacity -= 0.025;
                        if (opacity <= 0.5) decreasing = false;
                    } else {
                        opacity += 0.025;
                        if (opacity >= 1) decreasing = true;
                    }
                    element.style.opacity = opacity;
                }, 50);
            });

            // Helper function to check if a date is valid
            function isValidDate(dateString) {
                if (!dateString) return false;
                const date = new Date(dateString);
                return !isNaN(date.getTime()) && date > new Date(0);
            }

            // Storage functions for persistent notification state
            function getStoredReadNotifications() {
                try {
                    const stored = localStorage.getItem('lingap_read_notifications');
                    return stored ? JSON.parse(stored) : [];
                } catch (error) {
                    console.error('Error reading stored notifications:', error);
                    return [];
                }
            }

            function setStoredReadNotifications(readIds) {
                try {
                    localStorage.setItem('lingap_read_notifications', JSON.stringify(readIds));
                } catch (error) {
                    console.error('Error storing notifications:', error);
                }
            }

            function addToStoredReadNotifications(notificationId) {
                const readIds = getStoredReadNotifications();
                if (!readIds.includes(notificationId)) {
                    readIds.push(notificationId);
                    setStoredReadNotifications(readIds);
                }
            }

            function markAllStoredAsRead(notificationIds) {
                const readIds = getStoredReadNotifications();
                notificationIds.forEach(id => {
                    if (!readIds.includes(id)) {
                        readIds.push(id);
                    }
                });
                setStoredReadNotifications(readIds);
            }

            // Initialize real-time connection
            initRealTimeConnection();

            // Toggle dropdown
            notificationButton.addEventListener('click', function(e) {
                e.stopPropagation();
                const isVisible = notificationDropdown.style.display === 'block';
                const notificationOverlay = document.getElementById('notificationOverlay');
                const burgerMenuBtn = document.getElementById('burgerMenuBtn');

                if (isVisible) {
                    notificationDropdown.style.display = 'none';
                    notificationOverlay.classList.remove('active');
                    document.body.style.overflow = '';
                    // Show burger icon again on mobile
                    if (burgerMenuBtn && window.innerWidth < 992) {
                        burgerMenuBtn.classList.remove('hidden');
                    }
                } else {
                    notificationDropdown.style.display = 'block';
                    // Show overlay on mobile/tablet only
                    if (window.innerWidth < 992) {
                        notificationOverlay.classList.add('active');
                        document.body.style.overflow = 'hidden';
                        // Hide burger icon on mobile when notification dropdown is showing
                        if (burgerMenuBtn) {
                            burgerMenuBtn.classList.add('hidden');
                        }
                    }
                    loadRealNotifications();
                }
            });

            // Close notification dropdown with close button
            const notificationCloseBtn = document.getElementById('notificationCloseBtn');
            if (notificationCloseBtn) {
                notificationCloseBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    notificationDropdown.style.display = 'none';
                    const notificationOverlay = document.getElementById('notificationOverlay');
                    notificationOverlay.classList.remove('active');
                    document.body.style.overflow = '';
                    // Show burger icon again on mobile
                    const burgerMenuBtn = document.getElementById('burgerMenuBtn');
                    if (burgerMenuBtn && window.innerWidth < 992) {
                        burgerMenuBtn.classList.remove('hidden');
                    }
                });
            }

            // Close notification dropdown when clicking overlay
            const notificationOverlay = document.getElementById('notificationOverlay');
            if (notificationOverlay) {
                notificationOverlay.addEventListener('click', function() {
                    notificationDropdown.style.display = 'none';
                    notificationOverlay.classList.remove('active');
                    document.body.style.overflow = '';
                    // Show burger icon again on mobile
                    const burgerMenuBtn = document.getElementById('burgerMenuBtn');
                    if (burgerMenuBtn && window.innerWidth < 992) {
                        burgerMenuBtn.classList.remove('hidden');
                    }
                });
            }

            // Close dropdown when clicking outside (desktop only)
            document.addEventListener('click', function(e) {
                if (!notificationDropdown.contains(e.target) && e.target !== notificationButton) {
                    notificationDropdown.style.display = 'none';
                    const notificationOverlay = document.getElementById('notificationOverlay');
                    notificationOverlay.classList.remove('active');
                    document.body.style.overflow = '';
                    // Show burger icon again on mobile
                    const burgerMenuBtn = document.getElementById('burgerMenuBtn');
                    if (burgerMenuBtn && window.innerWidth < 992) {
                        burgerMenuBtn.classList.remove('hidden');
                    }
                }
            });

            // Mark all as read
            markAllRead.addEventListener('click', function(e) {
                e.stopPropagation();
                markAllNotificationsAsRead();
            });

            // Refresh notifications
            refreshNotifications.addEventListener('click', function(e) {
                e.stopPropagation();
                loadRealNotifications(true);
            });

            // Notification Settings functionality
            const notificationSettings = document.getElementById('notificationSettings');
            const notificationSettingsModal = new bootstrap.Modal(document.getElementById('notificationSettingsModal'));

            notificationSettings.addEventListener('click', function(e) {
                e.stopPropagation();
                loadNotificationPreferences();
                notificationSettingsModal.show();
                notificationDropdown.style.display = 'none';
            });

            async function loadNotificationPreferences() {
                try {
                    const response = await fetch('/Dashboard/GetNotificationPreferences');
                    const data = await response.json();

                    if (data.success) {
                        document.getElementById('preferInAppNotification').checked = data.preferences.preferInApp;
                        document.getElementById('preferEmailNotification').checked = data.preferences.preferEmail;
                        document.getElementById('preferSmsNotification').checked = data.preferences.preferSms;
                    } else {
                        console.error('Failed to load notification preferences');
                    }
                } catch (error) {
                    console.error('Error loading notification preferences:', error);
                }
            }

            document.getElementById('saveNotificationSettings').addEventListener('click', async function() {
                const preferInApp = document.getElementById('preferInAppNotification').checked;
                const preferEmail = document.getElementById('preferEmailNotification').checked;
                const preferSms = document.getElementById('preferSmsNotification').checked;

                try {
                    const response = await fetch('/Dashboard/UpdateNotificationPreferences', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: new URLSearchParams({
                            preferEmail: preferEmail,
                            preferSms: preferSms,
                            preferInApp: preferInApp
                        })
                    });

                    const data = await response.json();

                    if (data.success) {
                        showToast('Notification preferences saved successfully!', 'success');
                        notificationSettingsModal.hide();
                    } else {
                        showToast('Failed to save preferences. Please try again.', 'error');
                    }
                } catch (error) {
                    console.error('Error saving notification preferences:', error);
                    showToast('An error occurred. Please try again.', 'error');
                }
            });

            function showToast(message, type = 'info') {
                const bgClass = type === 'success' ? 'bg-success' : type === 'error' ? 'bg-danger' : 'bg-info';
                const toastHtml = `
                    <div class="toast align-items-center text-white ${bgClass} border-0 position-fixed top-0 end-0 m-3" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="3000" style="z-index: 9999;">
                        <div class="d-flex">
                            <div class="toast-body">
                                <i class="fas ${type === 'success' ? 'fa-check-circle' : type === 'error' ? 'fa-exclamation-circle' : 'fa-info-circle'} me-2"></i>
                                ${message}
                            </div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                        </div>
                    </div>
                `;

                document.body.insertAdjacentHTML('beforeend', toastHtml);
                const toastElement = document.body.lastElementChild;
                const toast = new bootstrap.Toast(toastElement);
                toast.show();

                toastElement.addEventListener('hidden.bs.toast', function() {
                    this.remove();
                });
            }

            function initRealTimeConnection() {
                initSignalRConnection();
                setInterval(() => {
                    checkForStatusChanges();
                }, 10000);
                loadRealNotifications();
                // Start real-time update for notification times and status/priority
                startRealtimeTimeUpdates();
            }

            // Update all notification times in real-time without page refresh
            function updateAllNotificationTimes() {
                // Update all notification time displays
                const timeElements = document.querySelectorAll('.notification-time-text[data-timestamp]');
                timeElements.forEach(element => {
                    const timestamp = element.getAttribute('data-timestamp');
                    if (timestamp) {
                        element.textContent = formatTime(timestamp);
                    }
                });
            }

            // Start periodic updates of notification times and reload notifications for status/priority updates
            function startRealtimeTimeUpdates() {
                // Update immediately
                updateAllNotificationTimes();

                // Update time display every 10 seconds for responsive and accurate time tracking
                // This ensures times like "Just now" -> "1m ago" -> "2m ago" transition quickly
                setInterval(() => {
                    updateAllNotificationTimes();
                }, 10000);

                // Reload notifications every 15 seconds to update status and priority badges in real-time
                // This ensures status changes (Pending -> Processing -> Approved) and priority changes are reflected quickly
                // Works both when dropdown is open (updating visible notifications) and closed (updating badge count)
                setInterval(async () => {
                    try {
                        const dropdownVisible = notificationDropdown && notificationDropdown.style.display === 'block';
                        if (dropdownVisible) {
                            // Dropdown is open: silently reload notifications to update status/priority badges
                            console.log('[Real-time Update] Reloading notifications (dropdown open)...');
                            await loadRealNotifications(false);
                        } else {
                            // Dropdown is closed: still reload to update badge count but don't render yet
                            // This keeps the badge count accurate in real-time
                            console.log('[Real-time Update] Updating badge count (dropdown closed)...');
                            const response = await fetch('/Notifications/GetUserNotifications');
                            if (response.ok) {
                                const notifications = await response.json();
                                if (!notifications.error) {
                                    const oldCount = currentNotifications.filter(n => !n.isRead).length;
                                    currentNotifications = notifications;
                                    const newCount = notifications.filter(n => !n.isRead).length;

                                    if (oldCount !== newCount) {
                                        console.log(`[Real-time Update] Unread count changed: ${oldCount} -> ${newCount}`);
                                    }

                                    // Update badge count only
                                    if (newCount > 0) {
                                        notificationBadge.textContent = newCount > 99 ? '99+' : newCount;
                                        notificationBadge.style.display = 'block';
                                        // Update mobile badge
                                        const mobileNotificationBadge = document.getElementById('mobileNotificationBadge');
                                        if (mobileNotificationBadge) {
                                            mobileNotificationBadge.textContent = newCount > 99 ? '99+' : newCount;
                                            mobileNotificationBadge.style.display = 'inline-block';
                                        }
                                    } else {
                                        hideNotificationBadge();
                                    }
                                }
                            }
                        }
                    } catch (error) {
                        console.error('[Real-time Update] Failed:', error);
                    }
                }, 15000); // Update every 15 seconds for responsive status changes
            }

            function initSignalRConnection() {
                try {
                    const connection = new signalR.HubConnectionBuilder()
                        .withUrl("/notificationHub")
                        .withAutomaticReconnect()
                        .configureLogging(signalR.LogLevel.Information)
                        .build();

                    connection.on("ReceiveStatusUpdate", function (message) {
                        console.log("SignalR: Received status update:", message);
                        loadRealNotifications(false);
                        showToast(message, 'info');
                    });

                    connection.on("ReceiveNotification", function (title, message, type) {
                        console.log("SignalR: Received notification:", title, message, type);
                        loadRealNotifications(false);
                        showToast(`${title}: ${message}`, type || 'info');
                    });

                    connection.start()
                        .then(function () {
                            console.log("SignalR: Connected successfully to notification hub");
                            if (realTimeIndicator) {
                                realTimeIndicator.style.backgroundColor = 'var(--success)';
                            }
                        })
                        .catch(function (err) {
                            console.error("SignalR: Connection error:", err.toString());
                        });

                    connection.onreconnected((connectionId) => {
                        console.log("SignalR: Reconnected with connection ID:", connectionId);
                        loadRealNotifications(false);
                    });

                    connection.onclose((error) => {
                        console.log("SignalR: Connection closed", error);
                        if (realTimeIndicator) {
                            realTimeIndicator.style.backgroundColor = 'var(--warning)';
                        }
                    });

                } catch (error) {
                    console.error("SignalR: Initialization error:", error);
                }
            }

            async function checkForStatusChanges() {
                try {
                    const applications = await getRealApplicationData();
                    const currentState = JSON.stringify(applications);

                    if (lastApplicationState !== currentState) {
                        const newNotifications = detectStatusChanges(applications);
                        if (newNotifications.length > 0) {
                            newNotifications.forEach(notification => {
                                if (!currentNotifications.some(n => n.id === notification.id)) {
                                    currentNotifications.unshift(notification);
                                }
                            });
                            updateNotificationUI(currentNotifications);
                        }
                        lastApplicationState = currentState;
                    }
                } catch (error) {
                    console.error('Failed to check status changes:', error);
                }
            }

            function detectStatusChanges(applications) {
                const newNotifications = [];
                const now = new Date();
                const readIds = getStoredReadNotifications();

                const allApplications = [
                    ...(applications.hospitalBills || []).map(app => ({ ...app, type: 'Hospital' })),
                    ...(applications.medicalForms || []).map(app => ({ ...app, type: 'Medical Procedure' })),
                    ...(applications.funeralForms || []).map(app => ({ ...app, type: 'Funeral Assistance' }))
                ];

                allApplications.forEach(app => {
                    const appId = app.id || app.Id;

                    if (app.processAt && isValidDate(app.processAt) &&
                        app.processby && app.processby.trim() !== '') {
                        const processingDate = new Date(app.processAt);
                        if ((now - processingDate) < 10 * 60 * 1000) {
                            const notificationId = `change_processing_${appId}`;
                            if (!currentNotifications.some(n => n.id === notificationId) && !readIds.includes(notificationId)) {
                                newNotifications.push({
                                    id: notificationId,
                                    title: `${app.type} Application Update`,
                                    message: `Your application is now being reviewed by ${app.processby}.`,
                                    isRead: false,
                                    createdAt: app.processAt,
                                    type: "processing",
                                    link: "/Applicationtracking"
                                });
                            }
                        }
                    }

                    if (app.result && isValidDate(app.result) && app.status2 === 'Approve') {
                        const resultDate = new Date(app.result);
                        if ((now - resultDate) < 10 * 60 * 1000) {
                            const notificationId = `change_approved_${appId}`;
                            if (!currentNotifications.some(n => n.id === notificationId) && !readIds.includes(notificationId)) {
                                newNotifications.push({
                                    id: notificationId,
                                    title: `${app.type} Application Approved!`,
                                    message: `Good news! Your application has been approved. Visit our office to claim.`,
                                    isRead: false,
                                    createdAt: app.result,
                                    type: "approved",
                                    link: "/Applicationtracking"
                                });
                            }
                        }
                    }

                    if (app.result && isValidDate(app.result) && app.status2 === 'Unapproved') {
                        const resultDate = new Date(app.result);
                        if ((now - resultDate) < 10 * 60 * 1000) {
                            const notificationId = `change_unapproved_${appId}`;
                            if (!currentNotifications.some(n => n.id === notificationId) && !readIds.includes(notificationId)) {
                                newNotifications.push({
                                    id: notificationId,
                                    title: `${app.type} Application Update`,
                                    message: `Your application was not approved. Check details in Application History.`,
                                    isRead: false,
                                    createdAt: app.result,
                                    type: "unapproved",
                                    link: "/Applicationtracking"
                                });
                            }
                        }
                    }

                    if (app.status2 === 'Approve' &&
                        app.claimedAt && isValidDate(app.claimedAt) &&
                        app.status3 && app.status3.trim() !== '') {
                        const claimedDate = new Date(app.claimedAt);
                        if ((now - claimedDate) < 10 * 60 * 1000) {
                            const notificationId = `change_claimed_${appId}`;
                            if (!currentNotifications.some(n => n.id === notificationId) && !readIds.includes(notificationId)) {
                                newNotifications.push({
                                    id: notificationId,
                                    title: `${app.type} Assistance Completed`,
                                    message: `Your assistance has been released. Thank you for using LingapDVO.`,
                                    isRead: false,
                                    createdAt: app.claimedAt,
                                    type: "claimed",
                                    link: "/Applicationtracking"
                                });
                            }
                        }
                    }
                });

                return newNotifications;
            }

