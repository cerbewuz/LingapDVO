                                {
                                    <div class="service-card disabled" data-bs-toggle="tooltip" title="Complete account verification to access this service">
                                        <div class="service-icon">
                                            <i class="fas fa-hospital"></i>
                                        </div>
                                        <h5 class="service-title">Hospital Assistance</h5>
                                        <p class="service-description">Private hospital bill support and financial aid</p>
                                    </div>
                                }
                            </div>

                            <!-- Service 2 - Funeral Assistance -->
                            <div class="col-md-6 col-lg-4">
                                @if (isVerified)
                                {
                                    <a href="/FuneralAssistance" class="text-decoration-none">
