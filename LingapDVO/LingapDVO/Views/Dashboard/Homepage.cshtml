            // Unify delay notifications: Critical Delay replaces Standard Delay for the same application
            function unifyDelayNotifications(notifications) {
                const delayTypes = ['delay', 'delay_alert', 'delayed', 'standard_delay', 'critical_delay'];
                
                // Group delay notifications by applicationId and applicationType
                const delayGroups = {};
                const nonDelayNotifications = [];
                
                notifications.forEach(n => {
                    const isDelay = delayTypes.includes(n.type) || 
                                   (n.priority && ['high', 'medium', 'Critical Delay', 'Standard Delay'].includes(n.priority));
                    
                    if (isDelay && n.applicationId) {
                        const key = `${n.applicationType}_${n.applicationId}`;
                        if (!delayGroups[key]) {
                            delayGroups[key] = [];
                        }
                        delayGroups[key].push(n);
                    } else {
                        nonDelayNotifications.push(n);
                    }
                });
                
                // For each group, keep only the highest priority delay (Critical > Standard)
                const unifiedDelays = [];
                Object.values(delayGroups).forEach(group => {
                    // Sort by priority: high/Critical Delay first, then medium/Standard Delay
                    group.sort((a, b) => {
                        const getPriorityValue = (n) => {
                            const p = (n.priority || '').toLowerCase();
                            if (p === 'high' || p === 'critical delay') return 2;
                            if (p === 'medium' || p === 'standard delay') return 1;
                            return 0;
                        };
                        return getPriorityValue(b) - getPriorityValue(a);
                    });
                    
                    // Keep only the highest priority notification (Critical replaces Standard)
                    if (group.length > 0) {
                        unifiedDelays.push(group[0]);
                    }
                });
                
                // Combine non-delay notifications with unified delays
                return [...nonDelayNotifications, ...unifiedDelays];
            }

            function getNotificationTypeIcon(notification) {
                // Check if notification has priority and prioritize priority icons for delay notifications
                const priority = notification.priority ? notification.priority.toLowerCase() : 'normal';
                const type = notification.type;

                // Handle delay notifications with unique icons based on priority level
                // Critical Delay (high priority) replaces Standard Delay (medium priority)
                if (type === 'delay_alert' || type === 'delayed' || type === 'standard_delay' || type === 'critical_delay') {
                    if (priority === 'high') {
                        // Critical Delay - Red urgent icon with exclamation
                        return { class: 'notification-type-critical-delay', icon: 'fas fa-exclamation-circle' };
                    } else if (priority === 'medium') {
                        // Standard Delay - Yellow warning icon with clock
                        return { class: 'notification-type-standard-delay', icon: 'fas fa-clock' };
                    }
                    // Default delay icon
                    return { class: 'notification-type-delayed', icon: 'fas fa-clock' };
                }

                // For non-delay notifications, show status-specific icons
                const types = {
                    // Application status icons
                    submitted: { class: 'notification-type-submitted', icon: 'fas fa-paper-plane' },
                    processing: { class: 'notification-type-processing', icon: 'fas fa-spinner fa-pulse' },
                    approved: { class: 'notification-type-approved', icon: 'fas fa-check-double' },
                    unapproved: { class: 'notification-type-unapproved', icon: 'fas fa-ban' },
                    retake: { class: 'notification-type-retake', icon: 'fas fa-redo-alt' },
                    claimed: { class: 'notification-type-claimed', icon: 'fas fa-gift' },
                    waiting: { class: 'notification-type-waiting', icon: 'fas fa-hourglass-half' },
                    welcome: { class: 'notification-type-welcome', icon: 'fas fa-hand-holding-heart' },
                    // Application-prefixed types
                    application_submitted: { class: 'notification-type-submitted', icon: 'fas fa-paper-plane' },
                    application_processing: { class: 'notification-type-processing', icon: 'fas fa-spinner fa-pulse' },
                    application_approved: { class: 'notification-type-approved', icon: 'fas fa-check-double' },
                    application_disapproved: { class: 'notification-type-unapproved', icon: 'fas fa-ban' },
                    application_retake: { class: 'notification-type-retake', icon: 'fas fa-redo-alt' },
                    application_claimed: { class: 'notification-type-claimed', icon: 'fas fa-gift' },
                    // System notifications
                    status_change: { class: 'notification-type-processing', icon: 'fas fa-sync-alt' },
                    system: { class: 'notification-type-system', icon: 'fas fa-cog' },
                    reminder: { class: 'notification-type-reminder', icon: 'fas fa-bell' }
                };
                return types[type] || { class: 'notification-type-submitted', icon: 'fas fa-bell' };
            }

            function getStatusBadge(type) {
                const statusMap = {
                    submitted: { label: 'Submitted', class: 'submitted' },
                    processing: { label: 'Processing', class: 'processing' },
                    approved: { label: 'Approved', class: 'approved' },
                    unapproved: { label: 'Not Approved', class: 'unapproved' },
                    retake: { label: 'Retake Required', class: 'retake' },
                    claimed: { label: 'Claimed', class: 'claimed' },
                    delayed: { label: 'Standard Delay', class: 'delayed' },
                    delay_alert: { label: 'Critical Delay', class: 'delay-critical' },
                    standard_delay: { label: 'Standard Delay', class: 'delayed' },
                    critical_delay: { label: 'Critical Delay', class: 'delay-critical' },
                    waiting: { label: 'Waiting', class: 'waiting' },
