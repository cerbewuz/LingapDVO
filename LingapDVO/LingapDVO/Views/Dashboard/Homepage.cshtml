                            classNames += ' priority-medium';
                        }
                        notificationItem.className = classNames;

                        // Add data-type attribute for delay alert styling
                        if (notification.type) {
                            notificationItem.setAttribute('data-type', notification.type);
                        }

                        // Add data-permanent attribute for permanent notifications (welcome)
                        if (notification.isPermanent) {
                            notificationItem.setAttribute('data-permanent', 'true');
                        }

                        // Store timestamp for real-time updates
                        notificationItem.setAttribute('data-created-at', notification.createdAt);

                        // Build badges HTML for bottom row
                        let badgesHtml = '';
                        
                        // Add assistance type badge first (to distinguish notification type)
                        const assistanceTypeBadge = getAssistanceTypeBadge(notification.applicationType);
                        if (assistanceTypeBadge) {
                            badgesHtml += `<span class="assistance-type-badge ${assistanceTypeBadge.class}"><i class="${assistanceTypeBadge.icon}"></i> ${assistanceTypeBadge.label}</span>`;
                        }
                        
                        const statusBadge = getStatusBadge(notification.type);

                        if (statusBadge) {
                            badgesHtml += `<span class="status-badge ${statusBadge.class}">${statusBadge.label}</span>`;
                        }

                        // Add priority badge
                        if (notification.priority === 'high') {
                            badgesHtml += '<span class="priority-badge high">High</span>';
                        } else if (notification.priority === 'medium') {
                            badgesHtml += '<span class="priority-badge medium">Medium</span>';
                        }

                        notificationItem.innerHTML = `
                            <div class="notification-title">
                                <div class="notification-type-icon ${typeIcon.class}">
                                    <i class="${typeIcon.icon}"></i>
                                </div>
                                <span class="notification-title-text">${escapeHtml(notification.title)}</span>
                            </div>
                            <div class="notification-message">${escapeHtml(notification.message)}</div>
                            <div class="notification-time">
                                <span class="notification-time-text" data-timestamp="${notification.createdAt}">${formatTime(notification.createdAt)}</span>
                                ${badgesHtml}
                            </div>
                        `;

                        // Don't add click listener for Welcome notifications (permanent/no_applications)
                        const isWelcomeNotification = notification.isPermanent ||
                                                     notification.id === 'no_applications' ||
                                                     notification.type === 'welcome';

                        if (!isWelcomeNotification) {
                            notificationItem.addEventListener('click', function() {
                                handleNotificationClick(notification);
                            });
                            // Add cursor pointer style for clickable notifications
                            notificationItem.style.cursor = 'pointer';
                        } else {
                            // Make welcome notifications non-clickable
                            notificationItem.style.cursor = 'default';
                        }

                        mobileNotificationList.appendChild(notificationItem);
                    });

                } catch (error) {
                    console.error('Failed to load mobile notifications:', error);
