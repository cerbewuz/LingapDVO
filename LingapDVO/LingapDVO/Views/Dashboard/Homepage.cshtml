                        const statusBadge = getStatusBadge(notification.type);

                        if (statusBadge) {
                            badgesHtml += `<span class="status-badge ${statusBadge.class}">${statusBadge.label}</span>`;
                        }

                        // Add priority badge
                        if (notification.priority === 'high') {
                            badgesHtml += '<span class="priority-badge high">High</span>';
                        } else if (notification.priority === 'medium') {
                            badgesHtml += '<span class="priority-badge medium">Medium</span>';
                        }

                        notificationItem.innerHTML = `
                            <div class="notification-title">
                                <div class="notification-type-icon ${typeIcon.class}">
                                    <i class="${typeIcon.icon}"></i>
                                </div>
                                <span class="notification-title-text">${escapeHtml(notification.title)}</span>
                            </div>
                            <div class="notification-message">${escapeHtml(notification.message)}</div>
                            <div class="notification-time">
                                <span class="notification-time-text" data-timestamp="${notification.createdAt}">${formatTime(notification.createdAt)}</span>
                                ${badgesHtml}
                            </div>
                        `;

                        notificationItem.addEventListener('click', function() {
                            handleNotificationClick(notification);
                        });

                        mobileNotificationList.appendChild(notificationItem);
                    });

                } catch (error) {
                    console.error('Failed to load mobile notifications:', error);
                    mobileNotificationList.innerHTML = `
                        <div class="notification-empty">
                            <i class="fas fa-exclamation-triangle fa-2x mb-2 text-warning"></i>
                            <p>Unable to load notifications</p>
                            <small class="text-muted">Please try again later</small>
                        </div>
                    `;
                }
            }

            // Mobile notification button handlers
            const mobileNotificationBtn = document.getElementById('mobileNotificationBtn');
            if (mobileNotificationBtn) {
                const mobileNotificationDropdown = document.getElementById('mobileNotificationDropdown');
                const mobileNotificationChevron = document.getElementById('mobileNotificationChevron');

                mobileNotificationBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();

                    // Toggle dropdown visibility
                    mobileNotificationDropdown.classList.toggle('active');
                    mobileNotificationChevron.classList.toggle('rotate');

                    // Load notifications if dropdown is opened
                    if (mobileNotificationDropdown.classList.contains('active')) {
                        loadMobileNotifications();
                    }
                });
            }

            // Mobile mark all as read button
            const mobileMarkAllRead = document.getElementById('mobileMarkAllRead');
            if (mobileMarkAllRead) {
                mobileMarkAllRead.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    markAllNotificationsAsRead();
                });
            }

            // Mobile refresh notifications button
            const mobileRefreshNotifications = document.getElementById('mobileRefreshNotifications');
            if (mobileRefreshNotifications) {
                mobileRefreshNotifications.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    loadMobileNotifications();
                });
            }

            // Mobile notification settings button (opens toast)
            const mobileNotificationSettings = document.getElementById('mobileNotificationSettings');
            const mobileNotificationSettingsToast = document.getElementById('mobileNotificationSettingsToast');
            const mobileToastOverlay = document.getElementById('mobileToastOverlay');
            const mobileToastClose = document.getElementById('mobileToastClose');
            const mobileCancelNotificationSettings = document.getElementById('mobileCancelNotificationSettings');
            const mobileSaveNotificationSettings = document.getElementById('mobileSaveNotificationSettings');

            if (mobileNotificationSettings) {
                mobileNotificationSettings.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();

                    // Sync settings from desktop to mobile
                    const desktopInApp = document.getElementById('preferInAppNotification');
                    const desktopEmail = document.getElementById('preferEmailNotification');
                    const desktopSms = document.getElementById('preferSmsNotification');
                    const mobileInApp = document.getElementById('mobilePreferInAppNotification');
                    const mobileEmail = document.getElementById('mobilePreferEmailNotification');
                    const mobileSms = document.getElementById('mobilePreferSmsNotification');

                    if (desktopInApp && mobileInApp) mobileInApp.checked = desktopInApp.checked;
                    if (desktopEmail && mobileEmail) mobileEmail.checked = desktopEmail.checked;
                    if (desktopSms && mobileSms) mobileSms.checked = desktopSms.checked;

                    // Show toast
                    mobileNotificationSettingsToast.classList.add('active');
                    document.body.style.overflow = 'hidden';
                });
            }

            // Close mobile toast with close button
            if (mobileToastClose) {
                mobileToastClose.addEventListener('click', function(e) {
                    e.preventDefault();
                    mobileNotificationSettingsToast.classList.remove('active');
                    document.body.style.overflow = '';
                });
            }

            // Close mobile toast with overlay
            if (mobileToastOverlay) {
                mobileToastOverlay.addEventListener('click', function() {
                    mobileNotificationSettingsToast.classList.remove('active');
                    document.body.style.overflow = '';
                });
            }

            // Cancel button in mobile toast
            if (mobileCancelNotificationSettings) {
                mobileCancelNotificationSettings.addEventListener('click', function(e) {
                    e.preventDefault();
                    mobileNotificationSettingsToast.classList.remove('active');
                    document.body.style.overflow = '';
                });
            }

            // Save button in mobile toast
            if (mobileSaveNotificationSettings) {
                mobileSaveNotificationSettings.addEventListener('click', function(e) {
                    e.preventDefault();

                    // Sync settings from mobile to desktop
                    const desktopInApp = document.getElementById('preferInAppNotification');
                    const desktopEmail = document.getElementById('preferEmailNotification');
                    const desktopSms = document.getElementById('preferSmsNotification');
                    const mobileInApp = document.getElementById('mobilePreferInAppNotification');
                    const mobileEmail = document.getElementById('mobilePreferEmailNotification');
                    const mobileSms = document.getElementById('mobilePreferSmsNotification');

                    if (desktopInApp && mobileInApp) desktopInApp.checked = mobileInApp.checked;
                    if (desktopEmail && mobileEmail) desktopEmail.checked = mobileEmail.checked;
                    if (desktopSms && mobileSms) desktopSms.checked = mobileSms.checked;

                    // Save settings (trigger desktop save logic)
                    const saveBtn = document.getElementById('saveNotificationSettings');
                    if (saveBtn) {
                        saveBtn.click();
                    }

                    // Close toast
                    mobileNotificationSettingsToast.classList.remove('active');
                    document.body.style.overflow = '';
                });
            }

            // Initialize notifications
            loadRealNotifications();
        });
    </script>
</body>
</html>