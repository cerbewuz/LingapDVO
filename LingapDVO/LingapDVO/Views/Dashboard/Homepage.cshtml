            // Close mobile toast with overlay
            if (mobileToastOverlay) {
                mobileToastOverlay.addEventListener('click', function() {
                    mobileNotificationSettingsToast.classList.remove('active');
                    document.body.style.overflow = '';
                });
            }

            // Cancel button in mobile toast
            if (mobileCancelNotificationSettings) {
                mobileCancelNotificationSettings.addEventListener('click', function(e) {
                    e.preventDefault();
                    mobileNotificationSettingsToast.classList.remove('active');
                    document.body.style.overflow = '';
                });
            }

            // Save button in mobile toast
            if (mobileSaveNotificationSettings) {
                mobileSaveNotificationSettings.addEventListener('click', function(e) {
                    e.preventDefault();

                    // Sync settings from mobile to desktop
                    const desktopInApp = document.getElementById('preferInAppNotification');
                    const desktopEmail = document.getElementById('preferEmailNotification');
                    const desktopSms = document.getElementById('preferSmsNotification');
                    const mobileInApp = document.getElementById('mobilePreferInAppNotification');
                    const mobileEmail = document.getElementById('mobilePreferEmailNotification');
                    const mobileSms = document.getElementById('mobilePreferSmsNotification');

                    if (desktopInApp && mobileInApp) desktopInApp.checked = mobileInApp.checked;
                    if (desktopEmail && mobileEmail) desktopEmail.checked = mobileEmail.checked;
                    if (desktopSms && mobileSms) desktopSms.checked = mobileSms.checked;

                    // Save settings (trigger desktop save logic)
                    const saveBtn = document.getElementById('saveNotificationSettings');
                    if (saveBtn) {
                        saveBtn.click();
                    }

                    // Close toast
                    mobileNotificationSettingsToast.classList.remove('active');
                    document.body.style.overflow = '';
                });
            }

            // Initialize notifications
            loadRealNotifications();
        });
