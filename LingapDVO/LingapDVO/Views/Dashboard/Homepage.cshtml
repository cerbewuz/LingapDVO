                }
            }

            async function markAllNotificationsAsRead() {
                try {
                    const markAllBtn = document.getElementById('markAllRead');
                    markAllBtn.classList.add('reading');

                    // FORCE mark ALL notifications as read in the backend - no exceptions for priority
                    const unreadNotifications = currentNotifications.filter(n => !n.isRead);

                    console.log(`Marking ${unreadNotifications.length} notifications as read...`);

                    // Mark each notification as read in the backend
                    const markPromises = unreadNotifications.map(notification =>
                        fetch('/Notifications/MarkNotificationAsRead', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ notificationId: notification.id })
                        }).catch(error => {
                            console.error(`Failed to mark notification ${notification.id} as read:`, error);
                            return null; // Continue even if one fails
                        })
                    );

                    // Wait for all mark operations to complete
                    await Promise.all(markPromises);

                    // FORCE all current notifications to be marked as read - including high/medium priority
                    currentNotifications.forEach(n => {
                        n.isRead = true;
                    });

                    // Update local storage
                    const allNotificationIds = currentNotifications.map(n => n.id);
                    markAllStoredAsRead(allNotificationIds);

                    // Immediately update the UI to show all notifications as read
                    updateNotificationUI(currentNotifications);
                    hideNotificationBadge();

                    console.log('All notifications marked as read successfully');

                    setTimeout(() => {
                        markAllBtn.classList.remove('reading');
                    }, 600);
                } catch (error) {
                    console.error('Failed to mark notifications as read:', error);
                    const markAllBtn = document.getElementById('markAllRead');
                    markAllBtn.classList.remove('reading');
                }
            }

            function updateNotificationUI(notifications) {
                if (!notificationList) return;

                currentNotifications = notifications;
                notificationList.innerHTML = '';

                if (notifications.length === 0) {
                    notificationList.innerHTML = `
                        <div class="notification-empty">
                            <i class="fas fa-bell-slash fa-2x mb-2"></i>
                            <p>No notifications</p>
                            <small class="text-muted">Check your application status for updates</small>
                        </div>
                    `;
                    hideNotificationBadge();
                    return;
                }

                const unreadCount = notifications.filter(n => !n.isRead).length;

                if (unreadCount > 0) {
                    notificationBadge.textContent = unreadCount > 99 ? '99+' : unreadCount;
                    notificationBadge.style.display = 'block';
                    // Update mobile notification badge
                    const mobileNotificationBadge = document.getElementById('mobileNotificationBadge');
                    if (mobileNotificationBadge) {
                        mobileNotificationBadge.textContent = unreadCount > 99 ? '99+' : unreadCount;
                        mobileNotificationBadge.style.display = 'inline-block';
                    }
                } else {
                    hideNotificationBadge();
                    // Hide mobile notification badge
                    const mobileNotificationBadge = document.getElementById('mobileNotificationBadge');
                    if (mobileNotificationBadge) {
                        mobileNotificationBadge.style.display = 'none';
                        mobileNotificationBadge.textContent = '0';
                    }
                }

                notifications.forEach(notification => {
                    const notificationItem = document.createElement('div');
                    const typeIcon = getNotificationTypeIcon(notification);

                    // Build class list with priority
                    let classNames = 'notification-item';
                    if (!notification.isRead) {
                        classNames += ' unread';
                    }
                    if (notification.priority === 'high') {
                        classNames += ' priority-high';
                    } else if (notification.priority === 'medium') {
                        classNames += ' priority-medium';
                    }
                    notificationItem.className = classNames;

                    // Add data-type attribute for delay alert styling
                    if (notification.type) {
                        notificationItem.setAttribute('data-type', notification.type);
                    }

                    // Add data-permanent attribute for permanent notifications (welcome)
                    if (notification.isPermanent) {
                        notificationItem.setAttribute('data-permanent', 'true');
                    }

                    // Store timestamp for real-time updates
                    notificationItem.setAttribute('data-created-at', notification.createdAt);

                    // Build badges HTML for bottom row
                    let badgesHtml = '';
                    const statusBadge = getStatusBadge(notification.type);

                    if (statusBadge) {
                        badgesHtml += `<span class="status-badge ${statusBadge.class}">${statusBadge.label}</span>`;
                    }

                    // Add priority badge
                    if (notification.priority === 'high') {
                        badgesHtml += '<span class="priority-badge high">High</span>';
                    } else if (notification.priority === 'medium') {
                        badgesHtml += '<span class="priority-badge medium">Medium</span>';
                    }

                    notificationItem.innerHTML = `
                        <div class="notification-title">
                            <div class="notification-type-icon ${typeIcon.class}">
                                <i class="${typeIcon.icon}"></i>
                            </div>
                            <span class="notification-title-text">${escapeHtml(notification.title)}</span>
                        </div>
                        <div class="notification-message">${escapeHtml(notification.message)}</div>
                        <div class="notification-time">
                            <span class="notification-time-text" data-timestamp="${notification.createdAt}">${formatTime(notification.createdAt)}</span>
                            ${badgesHtml}
                        </div>
                    `;

                    notificationItem.addEventListener('click', function() {
                        handleNotificationClick(notification);
                    });

                    notificationList.appendChild(notificationItem);
                });
            }

            function getNotificationTypeIcon(notification) {
                // Check if notification has priority and prioritize priority icons
                const priority = notification.priority ? notification.priority.toLowerCase() : 'normal';

                // If high or medium priority, always show priority icon regardless of status
                if (priority === 'high') {
                    return { class: 'notification-type-priority-high', icon: 'fas fa-exclamation-circle' };
                } else if (priority === 'medium') {
                    return { class: 'notification-type-priority-medium', icon: 'fas fa-exclamation-triangle' };
                }

                // Otherwise, show status icon
                const type = notification.type;
                const types = {
                    submitted: { class: 'notification-type-submitted', icon: 'fas fa-file-upload' },
                    processing: { class: 'notification-type-processing', icon: 'fas fa-cog' },
                    approved: { class: 'notification-type-approved', icon: 'fas fa-check-circle' },
                    unapproved: { class: 'notification-type-unapproved', icon: 'fas fa-times-circle' },
                    claimed: { class: 'notification-type-claimed', icon: 'fas fa-hand-holding-usd' },
                    delayed: { class: 'notification-type-delayed', icon: 'fas fa-clock' },
                    delay_alert: { class: 'notification-type-delay-alert', icon: 'fas fa-exclamation-triangle' },
                    waiting: { class: 'notification-type-waiting', icon: 'fas fa-hourglass-half' },
                    welcome: { class: 'notification-type-welcome', icon: 'fas fa-hand-holding-heart' },
                    application_submitted: { class: 'notification-type-submitted', icon: 'fas fa-file-upload' },
                    application_processing: { class: 'notification-type-processing', icon: 'fas fa-cog' },
                    application_approved: { class: 'notification-type-approved', icon: 'fas fa-check-circle' },
                    application_disapproved: { class: 'notification-type-unapproved', icon: 'fas fa-times-circle' },
                    application_claimed: { class: 'notification-type-claimed', icon: 'fas fa-hand-holding-usd' },
                    status_change: { class: 'notification-type-submitted', icon: 'fas fa-sync-alt' }
                };
                return types[type] || { class: 'notification-type-submitted', icon: 'fas fa-bell' };
            }

            function getStatusBadge(type) {
                const statusMap = {
                    submitted: { label: 'Submitted', class: 'submitted' },
                    processing: { label: 'Processing', class: 'processing' },
                    approved: { label: 'Approved', class: 'approved' },
                    unapproved: { label: 'Not Approved', class: 'unapproved' },
                    claimed: { label: 'Claimed', class: 'claimed' },
                    delayed: { label: 'Pending', class: 'delayed' },
                    delay_alert: { label: 'Delayed', class: 'delayed' },
                    waiting: { label: 'Waiting', class: 'waiting' },
                    application_submitted: { label: 'Submitted', class: 'submitted' },
                    application_processing: { label: 'Processing', class: 'processing' },
                    application_approved: { label: 'Approved', class: 'approved' },
                    application_disapproved: { label: 'Not Approved', class: 'unapproved' },
                    application_claimed: { label: 'Claimed', class: 'claimed' }
                };
                return statusMap[type] || null;
            }

            async function handleNotificationClick(notification) {
                if (!notification.isRead) {
                    // Mark as read in the backend session
                    try {
                        const response = await fetch('/Notifications/MarkNotificationAsRead', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ notificationId: notification.id })
                        });

                        if (response.ok) {
                            const result = await response.json();
                            if (result.success) {
                                // Also update local state
                                addToStoredReadNotifications(notification.id);
                                notification.isRead = true;
                                updateNotificationUI(currentNotifications);
                            }
                        }
                    } catch (error) {
                        console.error('Failed to mark notification as read:', error);
                        // Still update locally even if backend fails
                        addToStoredReadNotifications(notification.id);
                        notification.isRead = true;
                        updateNotificationUI(currentNotifications);
                    }
                }

                if (notification.link && notification.link !== '#') {
                    setTimeout(() => {
                        window.location.href = notification.link;
                    }, 200);
                }
            }

            function formatTime(dateString) {
                if (!dateString || !isValidDate(dateString)) {
                    return 'Just now';
                }

                const date = new Date(dateString);
                const now = new Date();

                if (date > now) {
                    return 'Just now';
                }

                const twoYearsAgo = new Date();
                twoYearsAgo.setFullYear(twoYearsAgo.getFullYear() - 2);
                if (date < twoYearsAgo) {
                    return date.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                    });
                }

                const diffInSeconds = Math.floor((now - date) / 1000);
                const diffInMinutes = Math.floor(diffInSeconds / 60);

                // Show "Just now" only for the first 30 seconds
                if (diffInSeconds < 30) return 'Just now';

                // Show "1m ago" starting from 30 seconds to ensure responsive updates
                if (diffInMinutes < 1) return '1m ago';
                if (diffInMinutes < 60) return `${diffInMinutes}m ago`;
                if (diffInMinutes < 1440) return `${Math.floor(diffInMinutes / 60)}h ago`;

                const days = Math.floor(diffInMinutes / 1440);
                if (days < 30) return `${days}d ago`;

                if (days < 365) {
                    const months = Math.floor(days / 30);
                    return `${months} month${months > 1 ? 's' : ''} ago`;
                }

                const years = Math.floor(days / 365);
                return `${years} year${years > 1 ? 's' : ''} ago`;
            }

            function escapeHtml(unsafe) {
                return unsafe
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

