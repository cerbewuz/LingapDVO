                    // Sync settings from desktop to mobile
                    const desktopInApp = document.getElementById('preferInAppNotification');
                    const desktopEmail = document.getElementById('preferEmailNotification');
                    const desktopSms = document.getElementById('preferSmsNotification');
                    const mobileInApp = document.getElementById('mobilePreferInAppNotification');
                    const mobileEmail = document.getElementById('mobilePreferEmailNotification');
                    const mobileSms = document.getElementById('mobilePreferSmsNotification');

                    if (desktopInApp && mobileInApp) mobileInApp.checked = desktopInApp.checked;
                    if (desktopEmail && mobileEmail) mobileEmail.checked = desktopEmail.checked;
                    if (desktopSms && mobileSms) mobileSms.checked = desktopSms.checked;

