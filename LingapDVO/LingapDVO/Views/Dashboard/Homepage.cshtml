                                }

                                <!-- Logout -->
                                <form asp-controller="Login" asp-action="Logout" method="post" style="display:inline;">
                                    <button type="submit" class="btn btn-link text-danger">
                                        <i class="fas fa-sign-out-alt" title="Logout"></i>
                                    </button>
                                </form>
                            </div>

                            <!-- Mobile Burger Menu Button -->
                            <button class="burger-menu-btn" id="burgerMenuBtn" aria-label="Menu" title="Menu">
                                <i class="fas fa-bars"></i>
                            </button>
                        </div>
                    </div>

                    @if (!isVerified)
                    {
                        <!-- Verification Alert -->
                        <div class="verification-alert">
                            <div class="d-flex align-items-center justify-content-between flex-column flex-md-row">
                                <div class="d-flex align-items-center mb-2 mb-md-0">
                                    <i class="fas fa-info-circle text-warning me-3" style="font-size: 1.5rem;"></i>
                                    <div>
                                        <strong class="d-block">Account Verification Required</strong>
                                        <small class="text-muted">Complete verification to access Hospital, Other, and Funeral Assistance services.</small>
                                    </div>
                                </div>
                                <a href="/Verifyaccount" class="btn btn-sm btn-warning">
                                    <i class="fas fa-user-check me-1"></i>Verify Now
                                </a>
                            </div>
                        </div>
                    }

                    <!-- Services Section -->
                    <div class="mb-5">
                        <h3 class="section-title">SERVICES OFFERED</h3>
                        <div class="row g-4">
                            <!-- Service 1 - Hospital Assistance -->
                            <div class="col-md-6 col-lg-4">
