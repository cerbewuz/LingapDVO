                                <p>No funeral applications found</p>
                            </div>
                        }
                    </div>

                    <!-- Services Section -->
                    <div class="mb-5">
                        <h3 class="section-title">SERVICES OFFERED</h3>
                        <div class="row g-4">
                            <!-- Service 1 -->
                            <div class="col-md-6 col-lg-4">
                                <a asp-route="FillupformHospitalBill" class="col-md-6 col-lg-4 text-decoration-none">
                                    <div class="service-card">
                                        <div class="service-icon">
                                            <i class="fas fa-hospital"></i>
                                        </div>
                                        <h5 class="service-title">Hospital Bill Assistance</h5>
                                        <p class="service-description">Private hospital bill support and financial aid</p>
                                    </div>
                                </a>
                            </div>

                            <!-- Service 2 -->
                            <div class="col-md-6 col-lg-4">
                                <a asp-route="Medicalandlabform" class="col-md-6 col-lg-4 text-decoration-none">
                                    <div class="service-card">
                                        <div class="service-icon">
                                            <i class="fas fa-microscope"></i>
                                        </div>
                                        <h5 class="service-title">Medical Procedures</h5>
                                        <p class="service-description">Private hospital laboratory procedures</p>
                                    </div>
                                </a>
                            </div>

                            <!-- Service 3 -->
                            <div class="col-md-6 col-lg-4">
                                <a asp-route="Funeralburialform" class="col-md-6 col-lg-4 text-decoration-none">
