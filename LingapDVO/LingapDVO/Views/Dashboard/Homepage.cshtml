                                        <h5 class="service-title">Funeral Assistance</h5>
                                        <p class="service-description">Burial and funeral support services</p>
                                    </div>
                                </a>
                            </div>

                            <!-- Service 4 -->
                            <div class="col-md-6 col-lg-4">
                                <a asp-route="Eligibilitychecking" class="col-md-6 col-lg-4 text-decoration-none">
                                    <div class="service-card">
                                        <div class="service-icon">
                                            <i class="fas fa-check-circle"></i>
                                        </div>
                                        <h5 class="service-title">Eligibility Checking</h5>
                                        <p class="service-description">Verify your eligibility for assistance programs</p>
                                    </div>
                                </a>
                            </div>

                            <!-- Service 5 -->
                            <div class="col-md-6 col-lg-4">
                                <a asp-route="Maps" class="col-md-6 col-lg-4 text-decoration-none">
                                    <div class="service-card">
                                        <div class="service-icon">
                                            <i class="fas fa-map-marker-alt"></i>
                                        </div>
                                        <h5 class="service-title">Locate Facilities</h5>
                                        <p class="service-description">Find offices, hospitals, and pharmacies</p>
                                    </div>
                                </a>
                            </div>

                            <!-- Service 6 -->
                            <div class="col-md-6 col-lg-4">
                                <a asp-route="Listofpartners" class="col-md-6 col-lg-4 text-decoration-none">
                                    <div class="service-card">
                                        <div class="service-icon">
                                            <i class="fas fa-hands-helping"></i>
                                        </div>
                                        <h5 class="service-title">Partner Directory</h5>
                                        <p class="service-description">List of partner organizations</p>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column - Latest Document -->
                <div class="col-lg-4">
                    @if (ViewBag.LatestDoc != null)
                    {
                        <div class="status-card"
                             style="height: 625px;
                                overflow-y: auto;
                                padding: 20px;
                                border: none;
                                border-radius: 12px;
                                box-shadow: 0 6px 15px rgba(0,0,0,0.1);
                                font-weight: 600;">

                            <div class="status-header">
                                <h3><i class="fas fa-file-alt me-2"></i>Track your most recent application</h3>
                            </div>

                            <div class="status-body">
                                @{
                                    var doc = ViewBag.LatestDoc;
                                }

                                <!-- Step A: Document Submitted - GREEN -->
                                <div class="timeline-item">
                                    <div class="timeline-marker submitted">
                                        <i class="fas fa-file-alt"></i>
                                    </div>
                                    <div class="timeline-content">
                                        <h6>Document Submitted</h6>
                                        <span class="small text-muted">
                                            @doc.Data.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                                        </span>
                                        <p>Your @doc.Type was successfully submitted.</p>
                                    </div>
                                </div>
                                <!-- Step B: Processing - YELLOW or Waiting -->
                                @if (doc.Data.ProcessAt > DateTime.MinValue && doc.Data.ProcessAt.Year > 1 && !string.IsNullOrWhiteSpace(doc.Data.Processby))
                                {
                                    <div class="timeline-item">
                                        <div class="timeline-marker processing">
                                            <i class="fas fa-cog"></i>
                                        </div>
                                        <div class="timeline-content">
                                            <h6>Processing</h6>
                                            <span class="small text-muted">
                                                @doc.Data.ProcessAt?.ToString("dd MMM yyyy, hh:mm tt")
                                            </span>
                                            <p>Processed by: <strong>@doc.Data.Processby</strong></p>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="timeline-item">
                                        <div class="timeline-marker" style="background: #6c757d; color: white;">
                                            <i class="fas fa-clock"></i>
                                        </div>
                                        <div class="timeline-content">
                                            <h6>Processing</h6>
                                            <p class="waiting-text">Waiting for staff to process...</p>
                                        </div>
                                    </div>
                                }

                                <!-- Step C: Result - Show Status (Approved/Unapproved) and DateTime from Result field -->
                                @if (doc.Data.Result > DateTime.MinValue && doc.Data.Result.Year > 1)
                                {
                                    <div class="timeline-item">
                                        <div class="timeline-marker @(doc.Data.Status2 == "Approved" ? "approved" : "unapproved")">
                                            <i class="fas fa-check-circle"></i>
                                        </div>
                                        <div class="timeline-content">
                                            <h6>@doc.Data.Status</h6>
                                            <span class="small text-muted">
                                                @doc.Data.Result.ToString("dd MMM yyyy, hh:mm tt")
                                            </span>
                                            <p>Result: <strong>@doc.Data.Status2</strong></p>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="timeline-item">
                                        <div class="timeline-marker" style="background: #6c757d; color: white;">
                                            <i class="fas fa-clock"></i>
                                        </div>
                                        <div class="timeline-content">
                                            <h6>Result</h6>
                                            <p class="waiting-text">Waiting for result...</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Empty state when no documents -->
                        <div class="status-card" style="height: 625px; display: flex; align-items: center; justify-content: center;">
                            <div class="text-center text-muted">
                                <i class="fas fa-file-alt fa-3x mb-3"></i>
                                <h5>No Recent Documents</h5>
                                <p class="mb-0">You haven't submitted any applications yet.</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </main>

    <!-- Chatbot -->
    <script src="https://www.gstatic.com/dialogflow-console/fast/messenger/bootstrap.js?v=1"></script>
    <df-messenger intent="WELCOME"
                  chat-title="Lingap_Chatbot"
                  agent-id="@agentId"
                  language-code="en"></df-messenger>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>