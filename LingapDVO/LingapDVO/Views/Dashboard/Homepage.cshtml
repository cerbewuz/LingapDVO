    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- SignalR for Real-time Notifications -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>

    <script>
        // Initialize tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        });

        // Fallback data from server (used when API fails)
        const fallbackHospitalBills = @Html.Raw(Json.Serialize(Model.HospitalAssistance));
        const fallbackMedicalForms = @Html.Raw(Json.Serialize(Model.OtherAssistance));
        const fallbackFuneralForms = @Html.Raw(Json.Serialize(Model.FuneralAssistance));

        // Mobile Burger Menu functionality
        document.addEventListener('DOMContentLoaded', function() {
            const burgerMenuBtn = document.getElementById('burgerMenuBtn');
            const mobileUserActions = document.getElementById('mobileUserActions');
            const mobileMenuOverlay = document.getElementById('mobileMenuOverlay');
            const mobileNotificationBtn = document.getElementById('mobileNotificationBtn');
            const mobileNotificationBadge = document.getElementById('mobileNotificationBadge');

            // Toggle mobile menu
            if (burgerMenuBtn) {
                burgerMenuBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    mobileUserActions.classList.toggle('active');
                    mobileMenuOverlay.classList.toggle('active');
                    document.body.style.overflow = mobileUserActions.classList.contains('active') ? 'hidden' : '';
                    // Hide burger button when sidebar is open
                    if (mobileUserActions.classList.contains('active')) {
                        burgerMenuBtn.classList.add('hidden');
                    }
                });
            }

            // Close mobile menu with close button
            const mobileMenuCloseBtn = document.getElementById('mobileMenuCloseBtn');
            if (mobileMenuCloseBtn) {
                mobileMenuCloseBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    mobileUserActions.classList.remove('active');
                    mobileMenuOverlay.classList.remove('active');
                    document.body.style.overflow = '';
                    // Show burger button again when sidebar closes
                    if (burgerMenuBtn) {
                        burgerMenuBtn.classList.remove('hidden');
                    }
                });
            }

            // Close mobile menu when clicking overlay (tap outside)
            if (mobileMenuOverlay) {
                mobileMenuOverlay.addEventListener('click', function() {
                    mobileUserActions.classList.remove('active');
                    mobileMenuOverlay.classList.remove('active');
                    document.body.style.overflow = '';
                    // Show burger button again when sidebar closes
                    if (burgerMenuBtn) {
                        burgerMenuBtn.classList.remove('hidden');
                    }
                });
            }

            // Sync notification badge between desktop and mobile
            function syncNotificationBadge() {
                const desktopBadge = document.getElementById('notificationBadge');
                if (desktopBadge && mobileNotificationBadge) {
                    if (desktopBadge.style.display !== 'none') {
                        mobileNotificationBadge.textContent = desktopBadge.textContent;
                        mobileNotificationBadge.style.display = 'inline-block';
                    } else {
                        mobileNotificationBadge.style.display = 'none';
                    }
                }
            }

            // Sync badges periodically
            setInterval(syncNotificationBadge, 1000);
        });

        // REAL Notification functionality
        document.addEventListener('DOMContentLoaded', function() {
            const notificationButton = document.getElementById('notificationButton');
            const notificationDropdown = document.getElementById('notificationDropdown');
            const notificationBadge = document.getElementById('notificationBadge');
            const notificationList = document.getElementById('notificationList');
            const markAllRead = document.getElementById('markAllRead');
            const refreshNotifications = document.getElementById('refreshNotifications');
            const realTimeIndicator = document.getElementById('realTimeIndicator');

            let currentNotifications = [];
            let lastApplicationState = null;

            // Pulse animation
            const pulseElements = document.querySelectorAll('.pulse');
            pulseElements.forEach(element => {
                let opacity = 1;
                let decreasing = true;
                setInterval(() => {
                    if (decreasing) {
                        opacity -= 0.025;
                        if (opacity <= 0.5) decreasing = false;
                    } else {
                        opacity += 0.025;
                        if (opacity >= 1) decreasing = true;
                    }
                    element.style.opacity = opacity;
                }, 50);
            });

            // Helper function to check if a date is valid
            function isValidDate(dateString) {
                if (!dateString) return false;
                const date = new Date(dateString);
                return !isNaN(date.getTime()) && date > new Date(0);
            }

            // localStorage functions removed - database now handles all read status tracking

            // Initialize real-time connection
            initRealTimeConnection();

            // Toggle dropdown
            notificationButton.addEventListener('click', function(e) {
                e.stopPropagation();
                const isVisible = notificationDropdown.style.display === 'block';
                const notificationOverlay = document.getElementById('notificationOverlay');
                const burgerMenuBtn = document.getElementById('burgerMenuBtn');

                if (isVisible) {
                    notificationDropdown.style.display = 'none';
                    notificationOverlay.classList.remove('active');
                    document.body.style.overflow = '';
                    // Show burger icon again on mobile
                    if (burgerMenuBtn && window.innerWidth < 992) {
                        burgerMenuBtn.classList.remove('hidden');
                    }
                } else {
                    notificationDropdown.style.display = 'block';
                    // Show overlay on mobile/tablet only
                    if (window.innerWidth < 992) {
                        notificationOverlay.classList.add('active');
                        document.body.style.overflow = 'hidden';
                        // Hide burger icon on mobile when notification dropdown is showing
                        if (burgerMenuBtn) {
                            burgerMenuBtn.classList.add('hidden');
                        }
                    }
                    loadRealNotifications();
                }
            });

            // Close notification dropdown with close button
            const notificationCloseBtn = document.getElementById('notificationCloseBtn');
            if (notificationCloseBtn) {
                notificationCloseBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    notificationDropdown.style.display = 'none';
                    const notificationOverlay = document.getElementById('notificationOverlay');
                    notificationOverlay.classList.remove('active');
                    document.body.style.overflow = '';
                    // Show burger icon again on mobile
                    const burgerMenuBtn = document.getElementById('burgerMenuBtn');
                    if (burgerMenuBtn && window.innerWidth < 992) {
                        burgerMenuBtn.classList.remove('hidden');
                    }
                });
            }

            // Close notification dropdown when clicking overlay
            const notificationOverlay = document.getElementById('notificationOverlay');
            if (notificationOverlay) {
                notificationOverlay.addEventListener('click', function() {
                    notificationDropdown.style.display = 'none';
                    notificationOverlay.classList.remove('active');
                    document.body.style.overflow = '';
                    // Show burger icon again on mobile
                    const burgerMenuBtn = document.getElementById('burgerMenuBtn');
                    if (burgerMenuBtn && window.innerWidth < 992) {
                        burgerMenuBtn.classList.remove('hidden');
                    }
                });
            }

            // Close dropdown when clicking outside (desktop only)
            document.addEventListener('click', function(e) {
                if (!notificationDropdown.contains(e.target) && e.target !== notificationButton) {
                    notificationDropdown.style.display = 'none';
                    const notificationOverlay = document.getElementById('notificationOverlay');
                    notificationOverlay.classList.remove('active');
                    document.body.style.overflow = '';
                    // Show burger icon again on mobile
                    const burgerMenuBtn = document.getElementById('burgerMenuBtn');
                    if (burgerMenuBtn && window.innerWidth < 992) {
                        burgerMenuBtn.classList.remove('hidden');
                    }
                }
            });

            // Mark all as read
            markAllRead.addEventListener('click', function(e) {
                e.stopPropagation();
                markAllNotificationsAsRead();
            });

            // Refresh notifications
            refreshNotifications.addEventListener('click', function(e) {
                e.stopPropagation();
                loadRealNotifications(true);
            });

            // Notification Settings functionality
            const notificationSettings = document.getElementById('notificationSettings');
            const notificationSettingsModal = new bootstrap.Modal(document.getElementById('notificationSettingsModal'));

            notificationSettings.addEventListener('click', function(e) {
                e.stopPropagation();
                loadNotificationPreferences();
                notificationSettingsModal.show();
                notificationDropdown.style.display = 'none';
            });

            async function loadNotificationPreferences() {
                try {
                    const response = await fetch('/Dashboard/GetNotificationPreferences');
                    const data = await response.json();

                    if (data.success) {
                        document.getElementById('preferInAppNotification').checked = data.preferences.preferInApp;
                        document.getElementById('preferEmailNotification').checked = data.preferences.preferEmail;
                        document.getElementById('preferSmsNotification').checked = data.preferences.preferSms;
                    } else {
                        console.error('Failed to load notification preferences');
                    }
                } catch (error) {
                    console.error('Error loading notification preferences:', error);
                }
            }

            document.getElementById('saveNotificationSettings').addEventListener('click', async function() {
                const preferInApp = document.getElementById('preferInAppNotification').checked;
                const preferEmail = document.getElementById('preferEmailNotification').checked;
                const preferSms = document.getElementById('preferSmsNotification').checked;

                try {
                    const response = await fetch('/Dashboard/UpdateNotificationPreferences', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                        },
                        body: new URLSearchParams({
                            preferEmail: preferEmail,
                            preferSms: preferSms,
                            preferInApp: preferInApp
                        })
                    });

                    const data = await response.json();

                    if (data.success) {
                        showToast('Notification preferences saved successfully!', 'success');
                        notificationSettingsModal.hide();
                    } else {
                        showToast('Failed to save preferences. Please try again.', 'error');
                    }
                } catch (error) {
                    console.error('Error saving notification preferences:', error);
                    showToast('An error occurred. Please try again.', 'error');
                }
            });

            function showToast(message, type = 'info') {
                const bgClass = type === 'success' ? 'bg-success' : type === 'error' ? 'bg-danger' : 'bg-info';
                const toastHtml = `
                    <div class="toast align-items-center text-white ${bgClass} border-0 position-fixed top-0 end-0 m-3" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="3000" style="z-index: 9999;">
                        <div class="d-flex">
                            <div class="toast-body">
                                <i class="fas ${type === 'success' ? 'fa-check-circle' : type === 'error' ? 'fa-exclamation-circle' : 'fa-info-circle'} me-2"></i>
                                ${message}
                            </div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                        </div>
                    </div>
                `;

                document.body.insertAdjacentHTML('beforeend', toastHtml);
                const toastElement = document.body.lastElementChild;
                const toast = new bootstrap.Toast(toastElement);
                toast.show();

                toastElement.addEventListener('hidden.bs.toast', function() {
                    this.remove();
                });
            }

            function initRealTimeConnection() {
                initSignalRConnection();
                // Auto-polling disabled - notifications now only load on page refresh or manual refresh button click
                // setInterval(() => {
                //     checkForStatusChanges();
                // }, 10000);
                loadRealNotifications();
                // Start real-time update for notification times only (no auto-reload)
                startRealtimeTimeUpdates();
            }

            // Update all notification times in real-time without page refresh
            function updateAllNotificationTimes() {
                // Update all notification time displays
                const timeElements = document.querySelectorAll('.notification-time-text[data-timestamp]');
                timeElements.forEach(element => {
                    const timestamp = element.getAttribute('data-timestamp');
                    if (timestamp) {
                        element.textContent = formatTime(timestamp);
                    }
                });
            }

            // Start periodic updates of notification times only (auto-reload disabled)
            function startRealtimeTimeUpdates() {
                // Update immediately
                updateAllNotificationTimes();

                // Update time display every 10 seconds for responsive and accurate time tracking
                // This ensures times like "Just now" -> "1m ago" -> "2m ago" transition quickly
                setInterval(() => {
                    updateAllNotificationTimes();
                }, 10000);

                // Auto-reload disabled - notifications now only fetch when user refreshes page or clicks refresh button
                // The previous auto-reload interval has been removed to give users full control over when notifications are fetched
                // Users can manually refresh notifications using the refresh button in the notification header
            }

            function initSignalRConnection() {
                try {
                    const connection = new signalR.HubConnectionBuilder()
                        .withUrl("/notificationHub")
                        .withAutomaticReconnect()
                        .configureLogging(signalR.LogLevel.Information)
                        .build();

                    connection.on("ReceiveStatusUpdate", function (message) {
                        // Reload notifications from database to get the saved notification
                        loadRealNotifications(false);
                        showToast(message, 'info');
                    });

                    connection.on("ReceiveNotification", function (notification) {
                        // Reload notifications from database to get the saved notification
                        loadRealNotifications(true).then(() => {
                            // Flash title for new notification (after badge is updated)
                            const currentBadge = document.getElementById('notificationBadge');
                            if (currentBadge && currentBadge.textContent) {
                                const count = parseInt(currentBadge.textContent.replace('+', ''));
                                if (!isNaN(count) && count > 0) {
                                    flashTitleForNewNotification(count);
                                }
                            }
                        });

                        // Show browser notification if supported and permitted
                        if ("Notification" in window && Notification.permission === "granted") {
                            new Notification(notification.title, {
                                body: notification.message,
                                icon: "/Icon/lingaplogo.ico"
                            });
                        }
                    });

                    connection.start()
                        .then(function () {
                            if (realTimeIndicator) {
                                realTimeIndicator.style.backgroundColor = 'var(--success)';
                            }
                        })
                        .catch(function (err) {
                        });

                    connection.onreconnected((connectionId) => {
                        loadRealNotifications(false);
                    });

                    connection.onclose((error) => {
                        if (realTimeIndicator) {
                            realTimeIndicator.style.backgroundColor = 'var(--warning)';
                        }
                    });

                } catch (error) {
                }
            }

            async function checkForStatusChanges() {
                try {
                    const applications = await getRealApplicationData();
                    const currentState = JSON.stringify(applications);

                    if (lastApplicationState !== currentState) {
                        const newNotifications = detectStatusChanges(applications);
                        if (newNotifications.length > 0) {
                            newNotifications.forEach(notification => {
                                if (!currentNotifications.some(n => n.id === notification.id)) {
                                    currentNotifications.unshift(notification);
                                }
                            });
                            updateNotificationUI(currentNotifications);
                        }
                        lastApplicationState = currentState;
                    }
                } catch (error) {
                    console.error('Failed to check status changes:', error);
                }
            }

            function detectStatusChanges(applications) {
                const newNotifications = [];
                const now = new Date();

                const allApplications = [
                    ...(applications.hospitalBills || []).map(app => ({ ...app, type: 'Hospital' })),
                    ...(applications.medicalForms || []).map(app => ({ ...app, type: 'Medical Procedure' })),
                    ...(applications.funeralForms || []).map(app => ({ ...app, type: 'Funeral Assistance' }))
                ];

                allApplications.forEach(app => {
                    const appId = app.id || app.Id;

                    if (app.processAt && isValidDate(app.processAt) &&
                        app.processby && app.processby.trim() !== '') {
                        const processingDate = new Date(app.processAt);
                        if ((now - processingDate) < 10 * 60 * 1000) {
                            const notificationId = `change_processing_${appId}`;
                            if (!currentNotifications.some(n => n.id === notificationId)) {
                                newNotifications.push({
                                    id: notificationId,
                                    title: `${app.type} Application Update`,
                                    message: `Your application is now being reviewed by ${app.processby}.`,
                                    isRead: false,
                                    createdAt: app.processAt,
                                    type: "processing",
                                    link: "/Applicationtracking"
                                });
                            }
                        }
                    }

                    if (app.result && isValidDate(app.result) && app.status2 === 'Approve') {
                        const resultDate = new Date(app.result);
                        if ((now - resultDate) < 10 * 60 * 1000) {
                            const notificationId = `change_approved_${appId}`;
                            if (!currentNotifications.some(n => n.id === notificationId)) {
                                newNotifications.push({
                                    id: notificationId,
                                    title: `${app.type} Application Approved!`,
                                    message: `Good news! Your application has been approved. Visit our office to claim.`,
                                    isRead: false,
                                    createdAt: app.result,
                                    type: "approved",
                                    link: "/Applicationtracking"
                                });
                            }
                        }
                    }

                    if (app.result && isValidDate(app.result) && app.status2 === 'Unapproved') {
                        const resultDate = new Date(app.result);
                        if ((now - resultDate) < 10 * 60 * 1000) {
                            const notificationId = `change_unapproved_${appId}`;
                            if (!currentNotifications.some(n => n.id === notificationId)) {
                                newNotifications.push({
                                    id: notificationId,
                                    title: `${app.type} Application Update`,
                                    message: `Your application was not approved. Check details in Application History.`,
                                    isRead: false,
                                    createdAt: app.result,
                                    type: "unapproved",
                                    link: "/Applicationtracking"
                                });
                            }
                        }
                    }

                    if (app.result && isValidDate(app.result) && app.status2 === 'Retake') {
                        const resultDate = new Date(app.result);
                        if ((now - resultDate) < 10 * 60 * 1000) {
                            const notificationId = `change_retake_${appId}`;
                            if (!currentNotifications.some(n => n.id === notificationId)) {
                                newNotifications.push({
                                    id: notificationId,
                                    title: `Action Required - Retake Application`,
                                    message: `Your ${app.type} application requires document resubmission. Please update your attachments to continue processing.`,
                                    isRead: false,
                                    createdAt: app.result,
                                    type: "retake",
                                    link: "/Applicationtracking"
                                });
                            }
                        }
                    }

                    if (app.status2 === 'Approve' &&
                        app.claimedAt && isValidDate(app.claimedAt) &&
                        app.status3 && app.status3.trim() !== '') {
                        const claimedDate = new Date(app.claimedAt);
                        if ((now - claimedDate) < 10 * 60 * 1000) {
                            const notificationId = `change_claimed_${appId}`;
                            if (!currentNotifications.some(n => n.id === notificationId)) {
                                newNotifications.push({
                                    id: notificationId,
                                    title: `${app.type} Assistance Completed`,
                                    message: `Your assistance has been released. Thank you for using LingapDVO.`,
                                    isRead: false,
                                    createdAt: app.claimedAt,
                                    type: "claimed",
                                    link: "/Applicationtracking"
                                });
                            }
                        }
                    }
                });

                return newNotifications;
            }

            async function loadRealNotifications(showLoading = false) {
                try {
                    if (showLoading) {
                        notificationList.innerHTML = `
                            <div class="notification-empty">
                                <i class="fas fa-spinner fa-spin"></i>
                                <p>Loading notifications...</p>
                            </div>
                        `;
                    }

                    // Fetch unified notifications from database
                    const response = await fetch('/Notifications/GetUnifiedNotifications');
                    const data = await response.json();

                    if (!response.ok || data.error) {
                        throw new Error(data.error || 'Failed to load notifications');
                    }

                    let notifications = data.notifications || [];
                    
                    // Unify delay notifications: Critical Delay replaces Standard Delay for the same application
                    notifications = unifyDelayNotifications(notifications);
                    
                    // Sort notifications: strictly chronological - most recent first
                    notifications.sort((a, b) => {
                        return new Date(b.createdAt) - new Date(a.createdAt);
                    });
                    
                    currentNotifications = notifications;

                    // Update badge count (unread notifications)
                    const unreadCount = notifications.filter(n => !n.isRead && !n.isPermanent).length;
                    updateNotificationBadge(unreadCount);

                    // Render notifications
                    updateNotificationUI(notifications);

                } catch (error) {
                    notificationList.innerHTML = '<div class="text-center py-3 text-danger"><i class="fas fa-exclamation-triangle"></i> Failed to load notifications</div>';
                }
            }

            async function getRealApplicationData() {
                try {
                    const response = await fetch('/Dashboard/GetUserApplications');
                    if (response.ok) {
                        const data = await response.json();
                        if (data.success) {
                            return {
                                hospitalBills: data.hospitalBills,
                                medicalForms: data.medicalForms,
                                funeralForms: data.funeralForms
                            };
                        } else {
                            console.error('API returned error:', data.error);
                            return {
                                hospitalBills: fallbackHospitalBills,
                                medicalForms: fallbackMedicalForms,
                                funeralForms: fallbackFuneralForms
                            };
                        }
                    } else {
                        console.error('HTTP error:', response.status);
                        return {
                            hospitalBills: fallbackHospitalBills,
                            medicalForms: fallbackMedicalForms,
                            funeralForms: fallbackFuneralForms
                        };
                    }
                } catch (error) {
                    console.error('Error fetching applications:', error);
                    return {
                        hospitalBills: fallbackHospitalBills,
                        medicalForms: fallbackMedicalForms,
                        funeralForms: fallbackFuneralForms
                    };
                }
            }

            function generateNotificationsFromRealData(applications) {
                const notifications = [];
                const now = new Date();
                const readIds = getStoredReadNotifications();

                const hasApplications = (applications.hospitalBills && applications.hospitalBills.length > 0) ||
                                      (applications.medicalForms && applications.medicalForms.length > 0) ||
                                      (applications.funeralForms && applications.funeralForms.length > 0);

                if (!hasApplications) {
                    notifications.push({
                        id: 'no_applications',
                        title: "Welcome to LingapDVO",
                        message: "You haven't submitted any applications yet. Get started by applying for assistance.",
                        isRead: true,
                        createdAt: new Date().toISOString(),
                        type: "submitted",
                        link: "#"
                    });
                    return notifications;
                }

                if (applications.hospitalBills && applications.hospitalBills.length > 0) {
                    applications.hospitalBills.forEach(app => {
                        notifications.push(...getApplicationStatusNotifications(app, 'Hospital Assistance'));
                    });
                }

                if (applications.medicalForms && applications.medicalForms.length > 0) {
                    applications.medicalForms.forEach(app => {
                        notifications.push(...getApplicationStatusNotifications(app, 'Other Assistance'));
                    });
                }

                if (applications.funeralForms && applications.funeralForms.length > 0) {
                    applications.funeralForms.forEach(app => {
                        notifications.push(...getApplicationStatusNotifications(app, 'Funeral Assistance'));
                    });
                }

                return notifications.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
            }

            function getApplicationStatusNotifications(application, type) {
                const notifications = [];
                const now = new Date();
                const appId = application.id || application.Id;

                function getHoursElapsed(dateString) {
                    if (!dateString || !isValidDate(dateString)) return 0;
                    const date = new Date(dateString);
                    const diffTime = now - date;
                    return Math.floor(diffTime / (1000 * 60 * 60));
                }

                function calculatePriority(status, status2, createdAt) {
                    // Only calculate priority for pending or processing applications
                    // If already approved/disapproved/claimed, no priority needed
                    if (status2 && (status2.toLowerCase() === 'approve' || status2.toLowerCase() === 'unapproved')) {
                        return 'normal';
                    }

                    // Check if still in pending or processing state
                    if (!status || (status.toLowerCase() !== 'pending' && status.toLowerCase() !== 'processing')) {
                        return 'normal';
                    }

                    // Calculate hours elapsed since submission
                    const hoursElapsed = getHoursElapsed(createdAt);

                    if (hoursElapsed >= 2) {
                        return 'high';
                    } else if (hoursElapsed >= 1) {
                        return 'medium';
                    } else {
                        return 'normal';
                    }
                }

                let notificationId, title, message, notificationType, createdDate;

                if (application.status2 === 'Approve' &&
                    application.claimedAt && isValidDate(application.claimedAt) &&
                    application.status3 && application.status3.trim() !== '') {

                    notificationId = `status_${appId}`;
                    title = `${type} Assistance Completed`;
                    message = `Your ${type} assistance has been released. Thank you for using LingapDVO.`;
                    notificationType = "claimed";
                    createdDate = application.claimedAt;
                }
                else if (application.status2 === 'Approve') {
                    const hoursApproved = getHoursElapsed(application.result);
                    const daysSinceApproval = Math.floor(hoursApproved / 24);

                    notificationId = `status_${appId}`;
                    title = `${type} Assistance Approved`;

                    if (daysSinceApproval >= 7) {
                        message = `Your assistance is ready to claim (approved ${daysSinceApproval} days ago). Please visit our office soon.`;
                        notificationType = "delayed";
                    } else {
                        message = `Your application has been approved. Visit our office to claim your assistance.`;
                        notificationType = "approved";
                    }
                    createdDate = application.result;
                }
                else if (application.result && isValidDate(application.result) && application.status2 === 'Unapproved') {
                    notificationId = `status_${appId}`;
                    title = `${type} Application Not Approved`;
                    message = `Your application was not approved. Check Application History for details.`;
                    notificationType = "unapproved";
                    createdDate = application.result;
                }
                else if (application.result && isValidDate(application.result) && application.status2 === 'Retake') {
                    notificationId = `status_${appId}`;
                    title = `Action Required - Retake Application`;
                    message = `Your ${type} application requires document resubmission. Please update your attachments to continue processing.`;
                    notificationType = "retake";
                    createdDate = application.result;
                }
                else if (application.processAt && isValidDate(application.processAt) &&
                         application.processby && application.processby.trim() !== '') {

                    const hoursInReview = getHoursElapsed(application.processAt);

                    notificationId = `status_${appId}`;

                    if (hoursInReview >= 2) {
                        title = `${type} Application - Review Delayed`;
                        message = `Your application has been under review for ${hoursInReview} hours. We're working on it.`;
                        notificationType = "delayed";
                    } else {
                        title = `${type} Application Under Review`;
                        message = `${application.processby} is reviewing your application. Decision expected within 1-2 hours.`;
                        notificationType = "processing";
                    }
                    createdDate = application.processAt;
                }
                else if (application.createdAt && isValidDate(application.createdAt)) {
                    const hoursWaiting = getHoursElapsed(application.createdAt);

                    notificationId = `status_${appId}`;

                    if (hoursWaiting >= 2) {
                        title = `${type} Application - Pending`;
                        message = `Your application has been waiting ${hoursWaiting} hours for review. We'll assign a reviewer soon.`;
                        notificationType = "delayed";
                    } else {
                        title = `${type} Application Submitted`;
                        message = `Your application is in queue. Expected review time: 1-2 hours.`;
                        notificationType = "submitted";
                    }
                    createdDate = application.createdAt;
                }

                if (notificationId) {
                    // Calculate priority based on application status and created date
                    const priority = calculatePriority(application.status, application.status2, application.createdAt);

                    notifications.push({
                        id: notificationId,
                        title: title,
                        message: message,
                        isRead: false,  // Will be managed by database
                        createdAt: createdDate,
                        type: notificationType,
                        link: "/Applicationtracking",
                        priority: priority
                    });
                }

                return notifications;
            }

            function updateNotificationBadge(count) {
                if (notificationBadge) {
                    if (count > 0) {
                        notificationBadge.textContent = count > 99 ? '99+' : count;
                        notificationBadge.style.display = 'block';
                    } else {
                        notificationBadge.style.display = 'none';
                        notificationBadge.textContent = '0';
                    }
                }
                // Update mobile notification badge
                const mobileNotificationBadge = document.getElementById('mobileNotificationBadge');
                if (mobileNotificationBadge) {
                    if (count > 0) {
                        mobileNotificationBadge.textContent = count > 99 ? '99+' : count;
                        mobileNotificationBadge.style.display = 'inline-block';
                    } else {
                        mobileNotificationBadge.style.display = 'none';
                        mobileNotificationBadge.textContent = '0';
                    }
                }

                // ═══════════════════════════════════════════════════════════════
                // REAL-TIME NOTIFICATION COUNTER IN DOCUMENT TITLE (<head>)
                // ═══════════════════════════════════════════════════════════════
                // Update page title with unread notification count
                updateDocumentTitle(count);

                // Update favicon badge with notification count
                updateFaviconBadge(count);
            }

            // Store original title for restoration
            const originalTitle = document.title;

            /**
             * Updates document title with notification count
             * Shows count in format: "(count) Home" or restores "Home" when count is 0
             */
            function updateDocumentTitle(count) {
                // Stop any existing title flash
                stopTitleFlash();

                if (count > 0) {
                    const displayCount = count > 99 ? '99+' : count;
                    document.title = `(${displayCount}) Home`;
                } else {
                    document.title = originalTitle;
                }
            }

            // ═══════════════════════════════════════════════════════════════
            // TITLE FLASH FEATURE - Visual Alert for New Notifications
            // ═══════════════════════════════════════════════════════════════
            let titleFlashInterval = null;
            let titleFlashState = false;

            /**
             * Flashes the document title to alert user of new notifications
             * Especially useful when user is on a different tab
             */
            function flashTitleForNewNotification(count) {
                // Don't flash if tab is already visible
                if (!document.hidden) {
                    return;
                }

                // Stop any existing flash
                stopTitleFlash();

                const displayCount = count > 99 ? '99+' : count;
                const flashTitle = `🔔 (${displayCount}) New Notification!`;
                const normalTitle = `(${displayCount}) Home`;

                titleFlashState = false;
                titleFlashInterval = setInterval(() => {
                    document.title = titleFlashState ? flashTitle : normalTitle;
                    titleFlashState = !titleFlashState;
                }, 1000); // Flash every 1 second

                // Auto-stop flashing after 30 seconds
                setTimeout(() => {
                    stopTitleFlash();
                    updateDocumentTitle(count);
                }, 30000);
            }

            /**
             * Stops the title flashing animation
             */
            function stopTitleFlash() {
                if (titleFlashInterval) {
                    clearInterval(titleFlashInterval);
                    titleFlashInterval = null;
                    titleFlashState = false;
                }
            }

            // ═══════════════════════════════════════════════════════════════
            // PAGE VISIBILITY API - Stop flash when user returns to tab
            // ═══════════════════════════════════════════════════════════════
            document.addEventListener('visibilitychange', function() {
                if (!document.hidden) {
                    // User returned to tab - stop flashing
                    stopTitleFlash();

                    // Update title with current notification count
                    const currentCount = parseInt(document.getElementById('notificationBadge')?.textContent || '0');
                    if (!isNaN(currentCount)) {
                        updateDocumentTitle(currentCount);
                    }
                }
            });

            // ═══════════════════════════════════════════════════════════════
            // DYNAMIC FAVICON BADGE - Shows notification count on favicon
            // ═══════════════════════════════════════════════════════════════
            let originalFavicon = null;
            let faviconCanvas = null;
            let faviconContext = null;

            /**
             * Initialize favicon badge system
             */
            function initFaviconBadge() {
                // Get original favicon
                const faviconLink = document.querySelector("link[rel*='icon']");
                if (faviconLink) {
                    originalFavicon = faviconLink.href;
                }

                // Create canvas for drawing favicon with badge
                faviconCanvas = document.createElement('canvas');
                faviconCanvas.width = 32;
                faviconCanvas.height = 32;
                faviconContext = faviconCanvas.getContext('2d');
            }

            /**
             * Update favicon with notification badge
             * Draws a red badge circle with count on the favicon
             */
            function updateFaviconBadge(count) {
                if (!faviconCanvas || !faviconContext) {
                    initFaviconBadge();
                }

                const faviconLink = document.querySelector("link[rel*='icon']") || createFaviconLink();

                if (count > 0) {
                    // Load original favicon image
                    const img = new Image();
                    img.onload = function() {
                        // Clear canvas
                        faviconContext.clearRect(0, 0, 32, 32);

                        // Draw original favicon
                        faviconContext.drawImage(img, 0, 0, 32, 32);

                        // Draw red badge circle
                        faviconContext.fillStyle = '#DC143C'; // Crimson red
                        faviconContext.beginPath();
                        faviconContext.arc(24, 8, 9, 0, 2 * Math.PI);
                        faviconContext.fill();

                        // Draw white border
                        faviconContext.strokeStyle = '#FFFFFF';
                        faviconContext.lineWidth = 2;
                        faviconContext.beginPath();
                        faviconContext.arc(24, 8, 9, 0, 2 * Math.PI);
                        faviconContext.stroke();

                        // Draw count text
                        const displayCount = count > 9 ? '9+' : count.toString();
                        faviconContext.fillStyle = '#FFFFFF';
                        faviconContext.font = 'bold 14px Arial';
                        faviconContext.textAlign = 'center';
                        faviconContext.textBaseline = 'middle';
                        faviconContext.fillText(displayCount, 24, 8);

                        // Update favicon
                        faviconLink.href = faviconCanvas.toDataURL('image/png');
                    };
                    img.src = originalFavicon || '/Icon/lingaplogo.ico';
                } else {
                    // Restore original favicon
                    faviconLink.href = originalFavicon || '/Icon/lingaplogo.ico';
                }
            }

            /**
             * Create favicon link element if it doesn't exist
             */
            function createFaviconLink() {
                const link = document.createElement('link');
                link.rel = 'icon';
                link.type = 'image/x-icon';
                document.head.appendChild(link);
                return link;
            }

            // Initialize favicon badge system on page load
            initFaviconBadge();

            function hideNotificationBadge() {
                updateNotificationBadge(0);
            }

            async function markAllNotificationsAsRead() {
                try {
                    const markAllBtn = document.getElementById('markAllRead');
                    markAllBtn.classList.add('reading');

                    const response = await fetch('/Notifications/MarkAllNotificationsAsRead', {
                        method: 'POST',
