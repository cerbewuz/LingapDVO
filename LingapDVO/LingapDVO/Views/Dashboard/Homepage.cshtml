                    console.error('Error getting unread count:', error);
                }
            }

            function formatTime(dateString) {
                if (!dateString || !isValidDate(dateString)) {
                    return 'Just now';
                }

                const date = new Date(dateString);
                const now = new Date();

                if (date > now) {
                    return 'Just now';
                }

                const twoYearsAgo = new Date();
                twoYearsAgo.setFullYear(twoYearsAgo.getFullYear() - 2);
                if (date < twoYearsAgo) {
                    return date.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                    });
                }

                const diffInSeconds = Math.floor((now - date) / 1000);
                const diffInMinutes = Math.floor(diffInSeconds / 60);

                // Show "Just now" only for the first 30 seconds
                if (diffInSeconds < 30) return 'Just now';

                // Show "1m ago" starting from 30 seconds to ensure responsive updates
                if (diffInMinutes < 1) return '1m ago';
                if (diffInMinutes < 60) return `${diffInMinutes}m ago`;
                if (diffInMinutes < 1440) return `${Math.floor(diffInMinutes / 60)}h ago`;

                const days = Math.floor(diffInMinutes / 1440);
                if (days < 30) return `${days}d ago`;

                if (days < 365) {
                    const months = Math.floor(days / 30);
                    return `${months} month${months > 1 ? 's' : ''} ago`;
                }

                const years = Math.floor(days / 365);
                return `${years} year${years > 1 ? 's' : ''} ago`;
            }

            function escapeHtml(unsafe) {
                return unsafe
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            // Load notifications for mobile dropdown (inside mobile menu)
            async function loadMobileNotifications() {
                const mobileNotificationList = document.getElementById('mobileNotificationList');
                if (!mobileNotificationList) return;

                try {
                    // Show loading state
                    mobileNotificationList.innerHTML = `
                        <div class="notification-empty">
                            <i class="fas fa-spinner fa-spin"></i>
                            <p>Loading notifications...</p>
                        </div>
                    `;

                    // Fetch unified notifications from database (same as desktop)
                    const response = await fetch('/Notifications/GetUnifiedNotifications');

                    const data = await response.json();

                    if (!response.ok || data.error) {
                        throw new Error(data.error || 'Failed to load notifications');
                    }

                    let notifications = data.notifications || [];
                    
                    // Unify delay notifications: Critical Delay replaces Standard Delay for the same application
                    notifications = unifyDelayNotifications(notifications);

                    // Sort notifications: strictly chronological - most recent first
                    notifications.sort((a, b) => {
                        return new Date(b.createdAt) - new Date(a.createdAt);
                    });

                    // Store current notifications for mark all as read functionality
                    currentNotifications = notifications;

                    // Clear loading state
                    mobileNotificationList.innerHTML = '';

                    if (notifications.length === 0) {
                        mobileNotificationList.innerHTML = `
                            <div class="notification-empty">
                                <i class="fas fa-bell-slash fa-2x mb-2"></i>
                                <p>No notifications</p>
                                <small class="text-muted">Check your application status for updates</small>
                            </div>
